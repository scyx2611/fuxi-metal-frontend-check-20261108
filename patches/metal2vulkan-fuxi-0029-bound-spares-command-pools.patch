+/// A pool at [`MAX_POOL_CBS`] (across primary + secondary) is kept and reusable; a pool past
+/// [`MAX_POOL_CBS`] is returned directly for release without entering or evicting spares.
+#[test]
+fn spare_command_pool_enforces_max_pool_cbs_boundary() {
+    let mut pools = Vec::new();
+    for n in 1..=2u64 {
+        assert!(keep_command_pool(&mut pools, CommandPool::new(vk::CommandPool::from_raw(n), 0))
+            .is_empty());
+    }
+
+    let half = MAX_POOL_CBS / 2;
+    let rem = MAX_POOL_CBS - half;
+    let mut at_limit = command_pool_with_cbs(100, 0, half, rem);
+    assert_eq!(at_limit.total_made(), MAX_POOL_CBS);
+    at_limit.reset_handed();
+    assert_eq!(at_limit.total_made(), MAX_POOL_CBS);
+    assert!(keep_command_pool(&mut pools, at_limit).is_empty());
+    assert_eq!(pools.len(), 3);
+
+    // Total primary + secondary = MAX_POOL_CBS + 1: rejected without evicting existing spares.
+    let over_mixed = command_pool_with_cbs(101, 0, half, rem + 1);
+    assert_eq!(over_mixed.total_made(), MAX_POOL_CBS + 1);
+    assert_eq!(
+        keep_command_pool(&mut pools, over_mixed),
+        vec![vk::CommandPool::from_raw(101)]
+    );
+    assert_eq!(pools.len(), 3);
+
+    // Primary-only past MAX_POOL_CBS: rejected too.
+    let over_primary = command_pool_with_cbs(102, 0, MAX_POOL_CBS + 1, 0);
+    assert_eq!(over_primary.total_made(), MAX_POOL_CBS + 1);
+    assert_eq!(
+        keep_command_pool(&mut pools, over_primary),
+        vec![vk::CommandPool::from_raw(102)]
+    );
+    assert_eq!(pools.len(), 3);
+
+    // The MAX_POOL_CBS pool was kept at the tail and hands out its primary and secondary CBs.
+    let mut kept = take_command_pool(&mut pools, 0).expect("at-limit pool kept");
+    assert_eq!(kept.raw, vk::CommandPool::from_raw(100));
+    assert_eq!(
+        kept.reuse(vk::CommandBufferLevel::PRIMARY),
+        Some(vk::CommandBuffer::from_raw(1))
+    );
+    assert_eq!(
+        kept.reuse(vk::CommandBufferLevel::SECONDARY),
+        Some(vk::CommandBuffer::from_raw(half as u64 + 1))
+    );
+}
