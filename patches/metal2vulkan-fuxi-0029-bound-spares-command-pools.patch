+/// Keep `pool` among the spare command pools `pools`, newest last: the pools to release, the
+/// oldest while `pools` holds more than [`MAX_COMMAND_POOLS`], or `pool` itself when it made more
+/// than [`MAX_POOL_CBS`] command buffers.
+pub(super) fn keep_command_pool(
+    pools: &mut Vec<CommandPool>,
+    pool: CommandPool,
+) -> Vec<vk::CommandPool> {
+    if pool.total_made() > MAX_POOL_CBS {
+        return vec![pool.raw];
+    }
     pools.push(pool);
+    let mut past = Vec::new();
+    while pools.len() > MAX_COMMAND_POOLS {
+        past.push(pools.remove(0).raw);
+    }
+    past
 }
 
