+/// [`should_reset_command_pool`] skips resetting pools past [`MAX_POOL_CBS`] and obeys lane /
+/// exit-guard section flags.
+#[test]
+fn give_command_pool_reset_skips_oversized_pool() {
+    let empty = CommandPool::new(vk::CommandPool::from_raw(1), 0);
+    assert!(should_reset_command_pool(&empty, true, false));
+    assert!(!should_reset_command_pool(&empty, false, false));
+    assert!(!should_reset_command_pool(&empty, true, true));
+
+    let half = MAX_POOL_CBS / 2;
+    let at_limit = command_pool_with_cbs(2, 0, half, MAX_POOL_CBS - half);
+    assert_eq!(at_limit.total_made(), MAX_POOL_CBS);
+    assert!(should_reset_command_pool(&at_limit, true, false));
+
+    let over_limit = command_pool_with_cbs(3, 0, half, MAX_POOL_CBS - half + 1);
+    assert_eq!(over_limit.total_made(), MAX_POOL_CBS + 1);
+    assert!(!should_reset_command_pool(&over_limit, true, false));
 }
 
