 /// Everything one draw records into the secondary command buffer.
+static SKIPPED_NULL_PIPELINE_DRAWS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+/// Number of draws skipped during recording because their pipeline was `vk::Pipeline::null()`
+/// (patch 0006).
+pub fn skipped_null_pipeline_draws() -> u64 {
+    SKIPPED_NULL_PIPELINE_DRAWS.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+fn skip_null_pipeline(pipeline: vk::Pipeline) -> bool {
+    if pipeline == vk::Pipeline::null() {
+        SKIPPED_NULL_PIPELINE_DRAWS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        return true;
+    }
+    false
+}
