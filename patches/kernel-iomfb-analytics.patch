diff --git a/xnu/fuxi-unixnu/SweetFramebuffer.cpp b/xnu/fuxi-unixnu/SweetFramebuffer.cpp
index 8b38ece..cb44733 100644
--- a/xnu/fuxi-unixnu/SweetFramebuffer.cpp
+++ b/xnu/fuxi-unixnu/SweetFramebuffer.cpp
@@ -637,7 +637,7 @@ AppleCLCD::start(IOService *provider)
 	PE_parse_boot_argn("fuxibacklight", &backlight, sizeof(backlight));
 	fBacklightPowerNotifications = backlight == 2 || backlight == 3;
 	fuxi_backlight_publish(this);
-	sweet_fb_refresh_publish(this);
+	sweet_fb_refresh_publish(this); setProperty("underrun", 0ULL, 32); setProperty("decomp_fail", 0ULL, 32); setProperty("downscale_fail", 0ULL, 32); /* IOMobileFramebuffer kern_SwapEnd sends display analytics from the 62nd swap on and restarts its count only when one of these reads back: without them every later swap made 3 failed CopyProperty calls */
  fSwapHist = sweet_fb_adt_u32(provider, "fuxi,swap-hist") == 1;
  nanoseconds_to_absolutetime(100000000ULL, &fSwapIdle);
  if (fSwapHist) IOLog("SWEET FB: swap interval histogram on (fuxi,swap-hist)\n");
@@ -1879,15 +1879,15 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
 		bzero(args->structureOutput, args->structureOutputSize);
 	}
-	if (selector >= 64 || !(sweet_fb_logged & (1ULL << selector))) {
-		if (selector < 64) {
-			sweet_fb_logged |= 1ULL << selector;
+	static uint64_t sweet_fb_logged_hi; static uint32_t sweet_fb_n68; /* 64..127 once each too; SetParameter (68) also at its call 1, 2, 4, 8, ...: kern_SwapEnd makes it twice per display analytics send (every 62 swaps), so the count shows whether that path runs */ uint64_t &seen = selector < 64 ? sweet_fb_logged : sweet_fb_logged_hi; uint32_t n68 = selector == 68 ? ++sweet_fb_n68 : 0; if (selector >= 128 || !(seen & (1ULL << (selector & 63))) || (n68 != 0 && (n68 & (n68 - 1)) == 0)) {
+		if (selector < 128) {
+			seen |= 1ULL << (selector & 63);
 		}
 		char name[32];
 		proc_selfname(name, sizeof(name));
-		IOLog("SWEET FB: %s sel %u in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		IOLog("SWEET FB: %s sel %u in %u/%u out %u/%u -> 0x%x n68 %u p0 0x%llx\n", name, selector,
 		    args->scalarInputCount, args->structureInputSize,
-		    args->scalarOutputCount, args->structureOutputSize, ret);
+		    args->scalarOutputCount, args->structureOutputSize, ret, n68, args->scalarInputCount ? (unsigned long long)args->scalarInput[0] : 0ULL);
 	}
 	return ret;
 }
