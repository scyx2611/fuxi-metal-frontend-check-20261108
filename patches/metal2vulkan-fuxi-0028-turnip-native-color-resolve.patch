+#[cfg(test)]
+mod tests {
+    use super::{
+        resolve_pass_dependency, samples_attachment_store_op, turnip_native_resolve_enabled, Source,
+    };
+    use ash::vk;
+    use metal2vulkan::vk::DriverId;
+
+    #[test]
+    fn turnip_native_resolve_applies_to_2_and_4_samples_only() {
+        assert!(turnip_native_resolve_enabled(
+            Some(DriverId::MESA_TURNIP),
+            2,
+            false
+        ));
+        assert!(turnip_native_resolve_enabled(
+            Some(DriverId::MESA_TURNIP),
+            4,
+            false
+        ));
+        assert!(!turnip_native_resolve_enabled(
+            Some(DriverId::MESA_TURNIP),
+            1,
+            false
+        ));
+        assert!(!turnip_native_resolve_enabled(
+            Some(DriverId::MESA_TURNIP),
+            8,
+            false
+        ));
+        assert!(!turnip_native_resolve_enabled(
+            Some(DriverId::MESA_TURNIP),
+            4,
+            true
+        ));
+        assert!(!turnip_native_resolve_enabled(
+            Some(DriverId::MESA_LLVMPIPE),
+            4,
+            false
+        ));
+        assert!(!turnip_native_resolve_enabled(
+            Some(DriverId::MOLTENVK),
+            4,
+            false
+        ));
+        assert!(!turnip_native_resolve_enabled(None, 4, false));
+    }
+
+    #[test]
+    fn resolve_pass_defense_store_op_and_dependency() {
+        assert_eq!(
+            samples_attachment_store_op(true).as_raw(),
+            vk::AttachmentStoreOp::DONT_CARE.as_raw()
+        );
+        assert_eq!(
+            samples_attachment_store_op(false).as_raw(),
+            vk::AttachmentStoreOp::STORE.as_raw()
+        );
+        let dep = resolve_pass_dependency(Source::Attachment);
+        assert_eq!(dep.src_subpass, vk::SUBPASS_EXTERNAL);
+        assert_eq!(dep.dst_subpass, 0);
+        assert!(dep
+            .dst_access_mask
+            .contains(vk::AccessFlags::INPUT_ATTACHMENT_READ | vk::AccessFlags::COLOR_ATTACHMENT_WRITE));
+    }
+}
