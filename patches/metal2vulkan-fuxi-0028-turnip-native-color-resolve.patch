+fn samples_attachment_store_op(discard_samples: bool) -> vk::AttachmentStoreOp {
+    if discard_samples {
+        vk::AttachmentStoreOp::DONT_CARE
+    } else {
+        vk::AttachmentStoreOp::STORE
+    }
