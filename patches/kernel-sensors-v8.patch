+
+static void
+update_zupt_gyro_bias(SnsCompass *state, const int32_t gyro_q16[3])
+{
+    int32_t up_vec[3];
+    uint64_t accel_norm_q16 = 0;
+    if (!state->accel_valid || accel_up_and_norm(state, up_vec, &accel_norm_q16) != 0 ||
+        accel_norm_q16 < (uint64_t)kZuptAccelMinQ16 || accel_norm_q16 > (uint64_t)kZuptAccelMaxQ16) {
+        state->zupt_still_cnt = 0u;
+        state->zupt_has_ref = 0;
+        return;
+    }
+    if (!state->zupt_has_ref) {
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            state->zupt_gyro_ref[idx] = gyro_q16[idx];
+            state->zupt_accel_ref[idx] = state->accel_ios[idx];
+        }
+        state->zupt_has_ref = 1;
+        state->zupt_still_cnt = 0u;
+        return;
+    }
+    int still = 1;
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        if (abs_i32_to_u32(gyro_q16[idx]) > (uint32_t)kZuptMaxBiasQ16) {
+            still = 0;
+            break;
+        }
+        const int64_t dg = (int64_t)gyro_q16[idx] - (int64_t)state->zupt_gyro_ref[idx];
+        const uint64_t adg = (dg < 0) ? (uint64_t)(-dg) : (uint64_t)dg;
+        if (adg > (uint64_t)kZuptJitterQ16) {
+            still = 0;
+            break;
+        }
+        if (state->zupt_learn_cnt > 0u) {
+            const int64_t db = (int64_t)gyro_q16[idx] - (int64_t)state->gyro_bias[idx];
+            const uint64_t adb = (db < 0) ? (uint64_t)(-db) : (uint64_t)db;
+            if (adb > (uint64_t)kZuptJitterQ16) {
+                still = 0;
+                break;
+            }
+        }
+        const int64_t da = (int64_t)state->accel_ios[idx] - (int64_t)state->zupt_accel_ref[idx];
+        const uint64_t ada = (da < 0) ? (uint64_t)(-da) : (uint64_t)da;
+        if (ada > (uint64_t)kZuptAccelTolQ16) {
+            still = 0;
+            break;
+        }
+    }
+    if (!still) {
+        state->zupt_still_cnt = 0u;
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            state->zupt_gyro_ref[idx] = gyro_q16[idx];
+            state->zupt_accel_ref[idx] = state->accel_ios[idx];
+        }
+        return;
+    }
+    if (state->zupt_still_cnt < 0xffffffffu) {
+        state->zupt_still_cnt++;
+    }
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        state->zupt_gyro_ref[idx] = (int32_t)((int64_t)state->zupt_gyro_ref[idx] +
+            (((int64_t)gyro_q16[idx] - (int64_t)state->zupt_gyro_ref[idx]) / 16ll));
+        state->zupt_accel_ref[idx] = (int32_t)((int64_t)state->zupt_accel_ref[idx] +
+            (((int64_t)state->accel_ios[idx] - (int64_t)state->zupt_accel_ref[idx]) / 16ll));
+    }
+    if (state->zupt_still_cnt >= (uint32_t)kZuptStillSamples) {
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            int64_t next;
+            if (state->zupt_learn_cnt == 0u) {
+                next = (int64_t)state->zupt_gyro_ref[idx];
+            } else {
+                const int64_t div = (state->zupt_learn_cnt < (uint32_t)kZuptFastLearnSamples) ? 8ll : 64ll;
+                next = (int64_t)state->gyro_bias[idx] +
+                    (((int64_t)gyro_q16[idx] - (int64_t)state->gyro_bias[idx]) / div);
+            }
+            if (next > (int64_t)kZuptMaxBiasQ16) {
+                next = (int64_t)kZuptMaxBiasQ16;
+            } else if (next < -(int64_t)kZuptMaxBiasQ16) {
+                next = -(int64_t)kZuptMaxBiasQ16;
+            }
+            state->gyro_bias[idx] = (int32_t)next;
+        }
+        if (state->zupt_learn_cnt < 0xffffffffu) {
+            state->zupt_learn_cnt++;
+        }
+    }
+}
+
+void
+sns_compass_set_gyro_ts(SnsCompass *state, const int32_t gyro_q16[3], uint64_t timestamp_ticks)
+{
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        state->gyro[idx] = gyro_q16[idx];
+    }
+    state->gyro_valid = 1;
+    update_zupt_gyro_bias(state, gyro_q16);
+    int32_t gyro_corr[3];
+    gyro_corrected_q16(state, gyro_q16, gyro_corr);
+    int32_t gyro_eff[3];
+    int in_deadband = (state->zupt_still_cnt >= (uint32_t)kZuptStillSamples);
+    if (in_deadband) {
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            if (abs_i32_to_u32(gyro_corr[idx]) >= (uint32_t)kZuptDeadbandQ16) {
+                in_deadband = 0;
+                break;
+            }
+        }
+    }
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        gyro_eff[idx] = in_deadband ? 0 : gyro_corr[idx];
+    }
+    const int integrate = (state->compass_mode == SNS_COMPASS_MODE_FUSION) || !state->rotv_valid;
+    if (state->compass_mode == SNS_COMPASS_MODE_FUSION && state->fallback_valid &&
+        timestamp_ticks != 0 && state->last_gyro_ts != 0 &&
+        timestamp_ticks > state->last_gyro_ts &&
+        (timestamp_ticks - state->last_gyro_ts) > (uint64_t)kGyroGapResetTicks) {
+        sns_compass_reset_session(state);
+    }
+    if (integrate && state->fallback_valid && timestamp_ticks != 0 &&
+        state->last_gyro_ts != 0 && timestamp_ticks > state->last_gyro_ts) {
+        const uint64_t dt_ticks = timestamp_ticks - state->last_gyro_ts;
+        if (dt_ticks <= (uint64_t)kGyroDtMaxUs * 20ull) {
+            const uint64_t dt_us = (dt_ticks * 10ull) / (uint64_t)kQTimerTicksPer10Us;
+            if (dt_us >= (uint64_t)kGyroDtMinUs && dt_us <= (uint64_t)kGyroDtMaxUs) {
+                if (!in_deadband) {
+                    integrate_quat_gyro(state->fallback_q, gyro_eff, dt_us);
+                }
+                state->fallback_gyro_steps++;
+                if ((state->relock_steady_cnt > 0u ||
+                     (state->mag_cal_cand_valid && state->mag_cal_cand_good > 0u)) &&
+                    !gyro_is_still(state)) {
+                    uint64_t l1 = gyro_l1_rate_q16(state);
+                    const uint64_t cap = (uint64_t)kGyroMaxQ16 * 3ull;
+                    if (l1 > cap) {
+                        l1 = cap;
+                    }
+                    const uint64_t dmdeg = (l1 * dt_us * 57296ull) / 65536000000ull;
+                    if (state->relock_steady_cnt > 0u && state->gyro_turn_acc_mdeg < 3600000u) {
+                        const uint64_t next = (uint64_t)state->gyro_turn_acc_mdeg + dmdeg;
+                        state->gyro_turn_acc_mdeg = (next > 3600000ull) ? 3600000u : (uint32_t)next;
+                    }
+                    if (state->mag_cal_cand_valid && state->mag_cal_cand_good > 0u &&
+                        state->mag_cal_cand_turn_mdeg < 3600000u) {
+                        const uint64_t next = (uint64_t)state->mag_cal_cand_turn_mdeg + dmdeg;
+                        state->mag_cal_cand_turn_mdeg = (next > 3600000ull) ? 3600000u : (uint32_t)next;
+                    }
+                }
+            }
+        }
+    }
+    if (timestamp_ticks != 0) {
+        state->last_gyro_ts = timestamp_ticks;
+    }
+}
+
+void
+sns_compass_set_gyro(SnsCompass *state, const int32_t gyro_q16[3])
+{
+    sns_compass_set_gyro_ts(state, gyro_q16, 0ull);
+}
+
+static void
+mag_hist_reset(SnsCompass *state)
+{
+    state->mag_hist_count = 0u;
+    state->mag_hist_pos = 0u;
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        state->mag_sum[idx] = 0ll;
+    }
+}
+
+static void
+mag_hist_push(SnsCompass *state, const int32_t mag_q16[3])
+{
+    const uint32_t slot = state->mag_hist_pos;
+    if (state->mag_hist_count < SNS_COMPASS_MAG_AVG_WIN) {
+        state->mag_hist_count++;
+    } else {
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            state->mag_sum[idx] -= (int64_t)state->mag_hist[slot][idx];
+        }
+    }
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        state->mag_hist[slot][idx] = mag_q16[idx];
+        state->mag_sum[idx] += (int64_t)mag_q16[idx];
+        state->mag_raw[idx] = (int32_t)(state->mag_sum[idx] / (int64_t)state->mag_hist_count);
+    }
+    state->mag_hist_pos = (slot + 1u) % SNS_COMPASS_MAG_AVG_WIN;
+}
+
+static void
+promote_trusted_mag_cal(SnsCompass *state, const int32_t bias_q16[3], int32_t accuracy, int full_reset)
+{
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        state->trusted_mag_cal_bias[idx] = bias_q16[idx];
+    }
+    state->trusted_mag_cal_acc = accuracy;
+    state->has_trusted_mag_cal = 1;
+    state->mag_cal_polluted = 0;
+    state->mag_cal_cand_valid = 0;
+    state->mag_cal_cand_from_disturb = 0;
+    state->mag_cal_cand_good = 0u;
+    state->mag_cal_cand_turn_mdeg = 0u;
+    state->mag_cal_cand_has_up = 0;
+    state->mag_cal_cand_has_world = 0;
+    if (full_reset) {
+        state->mag_disturbed = 0;
+        state->mag_disturb_hold = 0u;
+        state->mag_disturb_reason = 0u;
+        state->mag_cal_quarantine = 0u;
+        state->vec_anom_cnt = 0u;
+        state->earth_anom_cnt = 0u;
+        state->mag_innov_reject_cnt = 0u;
+        state->mag_innov_confirm_cnt = 0u;
+        state->earth_ref_count = 0u;
+        state->earth_ref_horiz_mut = 0u;
+        state->earth_ref_has_up = 0;
+        state->earth_reanchor_count = 0u;
+        state->relock_steady_cnt = 0u;
+        state->gyro_turn_acc_mdeg = 0u;
+        if (state->fallback_valid && state->fallback_used_mag) {
+            state->bias_handoff_steps = (uint32_t)kBiasHandoffSteps;
+        }
+        mag_hist_reset(state);
+    }
+}
+
+static uint32_t
+quat_abs_dot_q30(const int32_t lhs[4], const int32_t rhs[4])
+{
+    int64_t dot = 0;
+    for (unsigned idx = 0; idx < 4u; ++idx) {
+        dot += ((int64_t)lhs[idx] >> 15) * ((int64_t)rhs[idx] >> 15);
+    }
+    if (dot < 0) {
+        dot = -dot;
+    }
+    return (dot > (int64_t)kQ30One) ? (uint32_t)kQ30One : (uint32_t)dot;
+}
+
+static void
+pose_hist_record(SnsCompass *state, const int32_t mag_q16[3])
+{
+    if (!state->fallback_valid) {
+        return;
+    }
+    if (state->pose_hist_count > 0u) {
+        const uint32_t prev_slot = (state->pose_hist_pos + SNS_COMPASS_POSE_HIST_WIN - 1u) % SNS_COMPASS_POSE_HIST_WIN;
+        if (quat_abs_dot_q30(state->fallback_q, state->pose_hist[prev_slot].q) > (uint32_t)kQuatCos7p5Q30) {
+            return;
+        }
+    }
+    SnsCompassPoseSnap *snap = &state->pose_hist[state->pose_hist_pos];
+    for (unsigned idx = 0; idx < 4u; ++idx) {
+        snap->q[idx] = state->fallback_q[idx];
+    }
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        snap->mag[idx] = mag_q16[idx];
+    }
+    snap->seq = state->mag_sample_seq;
+    state->pose_hist_pos = (state->pose_hist_pos + 1u) % SNS_COMPASS_POSE_HIST_WIN;
+    if (state->pose_hist_count < SNS_COMPASS_POSE_HIST_WIN) {
+        state->pose_hist_count++;
+    }
+}
+
+static int
+pose_hist_proves_candidate(const SnsCompass *state, const int32_t live_cw[3])
+{
+    if (state->pose_hist_count < (uint32_t)kPoseHistMinSnaps) {
+        return 0;
+    }
+    uint32_t matched_idx[SNS_COMPASS_POSE_HIST_WIN];
+    uint32_t matched = 0u;
+    for (uint32_t back = 0u; back < state->pose_hist_count; ++back) {
+        const uint32_t slot = (state->pose_hist_pos + SNS_COMPASS_POSE_HIST_WIN - 1u - back) % SNS_COMPASS_POSE_HIST_WIN;
+        const SnsCompassPoseSnap *snap = &state->pose_hist[slot];
+        if ((state->mag_sample_seq - snap->seq) > (uint32_t)kPoseHistMaxAgeSamples) {
+            break;
+        }
+        uint32_t snorm = 0u;
+        int32_t scal[3] = {0, 0, 0};
+        (void)bias_eval_earth(snap->mag, state->mag_cal_cand_bias, NULL, &snorm, NULL, NULL, scal);
+        if (snorm < (uint32_t)kMagCalCandNormMinMut || snorm > (uint32_t)kMagCalCandNormMaxMut) {
+            break;
+        }
+        int32_t nq[3], wq[3], uq[3];
+        quat_to_axes_q15(snap->q, nq, wq, uq);
+        const int32_t sw[3] = {
+            (int32_t)(((int64_t)nq[0] * (int64_t)scal[0] + (int64_t)nq[1] * (int64_t)scal[1] + (int64_t)nq[2] * (int64_t)scal[2]) >> 15),
+            (int32_t)(((int64_t)wq[0] * (int64_t)scal[0] + (int64_t)wq[1] * (int64_t)scal[1] + (int64_t)wq[2] * (int64_t)scal[2]) >> 15),
+            (int32_t)(((int64_t)uq[0] * (int64_t)scal[0] + (int64_t)uq[1] * (int64_t)scal[1] + (int64_t)uq[2] * (int64_t)scal[2]) >> 15),
+        };
+        uint64_t dsq = 0ull;
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            const int64_t d = (int64_t)sw[idx] - (int64_t)live_cw[idx];
+            const uint64_t ad = (d < 0) ? (uint64_t)(-d) : (uint64_t)d;
+            dsq += ad * ad;
+        }
+        if (isqrt64(dsq) > (uint64_t)kPoseHistTolWorldMut) {
+            break;
+        }
+        matched_idx[matched++] = slot;
+    }
+    if (matched < (uint32_t)kPoseHistMinSnaps) {
+        return 0;
+    }
+    for (uint32_t i = 0u; i < matched; ++i) {
+        for (uint32_t j = i + 1u; j < matched; ++j) {
+            if (quat_abs_dot_q30(state->pose_hist[matched_idx[i]].q,
+                                 state->pose_hist[matched_idx[j]].q) <= (uint32_t)kQuatCos30Q30) {
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+
+static int
+pose_hist_proves_cold_boot(const SnsCompass *state, const int32_t live_cw[3], const int32_t live_mag_q16[3])
+{
+    if (state->has_trusted_mag_cal || !state->has_default_mag_bias || !state->fallback_valid ||
+        state->pose_hist_count < (uint32_t)kPoseHistColdMinSnaps) {
+        return 0;
+    }
+    int32_t live_old_cal[3] = {0, 0, 0};
+    (void)bias_eval_earth(live_mag_q16, state->default_mag_bias, NULL, NULL, NULL, NULL, live_old_cal);
+    int32_t lnq[3], lwq[3], luq[3];
+    quat_to_axes_q15(state->fallback_q, lnq, lwq, luq);
+    const int32_t live_old_w[3] = {
+        (int32_t)(((int64_t)lnq[0] * (int64_t)live_old_cal[0] + (int64_t)lnq[1] * (int64_t)live_old_cal[1] + (int64_t)lnq[2] * (int64_t)live_old_cal[2]) >> 15),
+        (int32_t)(((int64_t)lwq[0] * (int64_t)live_old_cal[0] + (int64_t)lwq[1] * (int64_t)live_old_cal[1] + (int64_t)lwq[2] * (int64_t)live_old_cal[2]) >> 15),
+        (int32_t)(((int64_t)luq[0] * (int64_t)live_old_cal[0] + (int64_t)luq[1] * (int64_t)live_old_cal[1] + (int64_t)luq[2] * (int64_t)live_old_cal[2]) >> 15),
+    };
+
+    uint32_t matched_idx[SNS_COMPASS_POSE_HIST_WIN];
+    int32_t matched_up[SNS_COMPASS_POSE_HIST_WIN][3];
+    uint32_t matched = 0u;
+    uint32_t max_old_err = 0u;
+    for (uint32_t back = 0u; back < state->pose_hist_count; ++back) {
+        const uint32_t slot = (state->pose_hist_pos + SNS_COMPASS_POSE_HIST_WIN - 1u - back) % SNS_COMPASS_POSE_HIST_WIN;
+        const SnsCompassPoseSnap *snap = &state->pose_hist[slot];
+        if ((state->mag_sample_seq - snap->seq) > (uint32_t)kPoseHistMaxAgeSamples) {
+            break;
+        }
+        uint32_t snorm = 0u;
+        int32_t scal[3] = {0, 0, 0};
+        (void)bias_eval_earth(snap->mag, state->mag_cal_cand_bias, NULL, &snorm, NULL, NULL, scal);
+        if (snorm < (uint32_t)kMagCalCandNormMinMut || snorm > (uint32_t)kMagCalCandNormMaxMut) {
+            break;
+        }
+        int32_t nq[3], wq[3], uq[3];
+        quat_to_axes_q15(snap->q, nq, wq, uq);
+        const int32_t sw[3] = {
+            (int32_t)(((int64_t)nq[0] * (int64_t)scal[0] + (int64_t)nq[1] * (int64_t)scal[1] + (int64_t)nq[2] * (int64_t)scal[2]) >> 15),
+            (int32_t)(((int64_t)wq[0] * (int64_t)scal[0] + (int64_t)wq[1] * (int64_t)scal[1] + (int64_t)wq[2] * (int64_t)scal[2]) >> 15),
+            (int32_t)(((int64_t)uq[0] * (int64_t)scal[0] + (int64_t)uq[1] * (int64_t)scal[1] + (int64_t)uq[2] * (int64_t)scal[2]) >> 15),
+        };
+        uint64_t dsq = 0ull;
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            const int64_t d = (int64_t)sw[idx] - (int64_t)live_cw[idx];
+            const uint64_t ad = (d < 0) ? (uint64_t)(-d) : (uint64_t)d;
+            dsq += ad * ad;
+        }
+        if (isqrt64(dsq) > (uint64_t)kPoseHistColdTolWorldMut) {
+            break;
+        }
+        int32_t old_cal[3] = {0, 0, 0};
+        (void)bias_eval_earth(snap->mag, state->default_mag_bias, NULL, NULL, NULL, NULL, old_cal);
+        const int32_t old_w[3] = {
+            (int32_t)(((int64_t)nq[0] * (int64_t)old_cal[0] + (int64_t)nq[1] * (int64_t)old_cal[1] + (int64_t)nq[2] * (int64_t)old_cal[2]) >> 15),
+            (int32_t)(((int64_t)wq[0] * (int64_t)old_cal[0] + (int64_t)wq[1] * (int64_t)old_cal[1] + (int64_t)wq[2] * (int64_t)old_cal[2]) >> 15),
+            (int32_t)(((int64_t)uq[0] * (int64_t)old_cal[0] + (int64_t)uq[1] * (int64_t)old_cal[1] + (int64_t)uq[2] * (int64_t)old_cal[2]) >> 15),
+        };
+        uint64_t old_dsq = 0ull;
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            const int64_t d = (int64_t)old_w[idx] - (int64_t)live_old_w[idx];
+            const uint64_t ad = (d < 0) ? (uint64_t)(-d) : (uint64_t)d;
+            old_dsq += ad * ad;
+        }
+        const uint32_t old_err = (uint32_t)isqrt64(old_dsq);
+        if (old_err > max_old_err) {
+            max_old_err = old_err;
+        }
+        matched_up[matched][0] = uq[0];
+        matched_up[matched][1] = uq[1];
+        matched_up[matched][2] = uq[2];
+        matched_idx[matched++] = slot;
+    }
+    if (matched < (uint32_t)kPoseHistColdMinSnaps) {
+        return 0;
+    }
+    if (!state->mag_disturbed && max_old_err < (uint32_t)kPoseHistColdOldSpreadMut) {
+        return 0;
+    }
+    /* Require both >=35 deg total rotation AND >=25 deg 3D gravity-axis tilt diversity:
+     * pure yaw around Z cannot constrain b_z and would promote Z-shifted biases (boot #342). */
+    int have_rot_spread = 0;
+    int have_tilt_spread = 0;
+    for (uint32_t i = 0u; i < matched; ++i) {
+        if (quat_abs_dot_q30(state->pose_hist[matched_idx[i]].q,
+                             state->fallback_q) <= (uint32_t)kQuatCos17p5Q30) {
+            have_rot_spread = 1;
+        }
+        const int64_t live_up_dot =
+            ((int64_t)matched_up[i][0] * (int64_t)luq[0] +
+             (int64_t)matched_up[i][1] * (int64_t)luq[1] +
+             (int64_t)matched_up[i][2] * (int64_t)luq[2]) >> 15;
+        if (live_up_dot <= (int64_t)kPoseHistTiltCosMinQ15) {
+            have_tilt_spread = 1;
+        }
+        for (uint32_t j = i + 1u; j < matched; ++j) {
+            if (quat_abs_dot_q30(state->pose_hist[matched_idx[i]].q,
+                                 state->pose_hist[matched_idx[j]].q) <= (uint32_t)kQuatCos17p5Q30) {
+                have_rot_spread = 1;
+            }
+            const int64_t pair_up_dot =
+                ((int64_t)matched_up[i][0] * (int64_t)matched_up[j][0] +
+                 (int64_t)matched_up[i][1] * (int64_t)matched_up[j][1] +
+                 (int64_t)matched_up[i][2] * (int64_t)matched_up[j][2]) >> 15;
+            if (pair_up_dot <= (int64_t)kPoseHistTiltCosMinQ15) {
+                have_tilt_spread = 1;
+            }
+        }
+        if (have_rot_spread && have_tilt_spread) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int
+eval_mag_cal_candidate(SnsCompass *state, const int32_t mag_q16[3], const int32_t *up_ptr, int accel_steady)
+{
+    if (!state->mag_cal_cand_valid || state->mag_cal_cand_acc < 3) {
+        return 0;
+    }
+    uint32_t c_norm = 0u;
+    uint32_t c_horiz = 0u;
+    int32_t c_up = 0;
+    int32_t c_cal[3] = {0, 0, 0};
+    (void)bias_eval_earth(mag_q16, state->mag_cal_cand_bias, up_ptr, &c_norm, &c_horiz, &c_up, c_cal);
+    const int strict_earth =
+        c_norm >= (uint32_t)kMagCalCandNormMinMut && c_norm <= (uint32_t)kMagCalCandNormMaxMut &&
+        (!up_ptr || (c_horiz >= (uint32_t)kMagCalCandHorizMinMut && c_horiz <= (uint32_t)kMagCalCandHorizMaxMut));
+    if (!strict_earth) {
+        state->mag_cal_cand_good = 0u;
+        state->mag_cal_cand_turn_mdeg = 0u;
+        state->mag_cal_cand_has_up = 0;
+        state->mag_cal_cand_has_world = 0;
+        return 0;
+    }
+
+    int have_cw = 0;
+    int32_t cw[3] = {0, 0, 0};
+    if (state->fallback_valid) {
+        int32_t north_q15[3];
+        int32_t west_q15[3];
+        int32_t up_q15[3];
+        quat_to_axes_q15(state->fallback_q, north_q15, west_q15, up_q15);
+        cw[0] = (int32_t)(((int64_t)north_q15[0] * (int64_t)c_cal[0] +
+                           (int64_t)north_q15[1] * (int64_t)c_cal[1] +
+                           (int64_t)north_q15[2] * (int64_t)c_cal[2]) >> 15);
+        cw[1] = (int32_t)(((int64_t)west_q15[0] * (int64_t)c_cal[0] +
+                           (int64_t)west_q15[1] * (int64_t)c_cal[1] +
+                           (int64_t)west_q15[2] * (int64_t)c_cal[2]) >> 15);
+        cw[2] = (int32_t)(((int64_t)up_q15[0] * (int64_t)c_cal[0] +
+                           (int64_t)up_q15[1] * (int64_t)c_cal[1] +
+                           (int64_t)up_q15[2] * (int64_t)c_cal[2]) >> 15);
+        have_cw = 1;
+    }
+
+    int steady_ok = 1;
+    if (state->mag_cal_cand_good > 0u) {
+        const uint32_t dn = (c_norm >= state->mag_cal_cand_norm_mut)
+            ? (c_norm - state->mag_cal_cand_norm_mut)
+            : (state->mag_cal_cand_norm_mut - c_norm);
+        if (dn > (uint32_t)kMagCalCandTolNormMut) {
+            steady_ok = 0;
+        }
+        if (steady_ok && accel_steady && state->mag_cal_cand_has_up) {
+            const int64_t du = (int64_t)c_up - (int64_t)state->mag_cal_cand_up_mut;
+            const uint32_t adu = (du < 0) ? (uint32_t)(-du) : (uint32_t)du;
+            if (adu > (uint32_t)kMagCalCandTolUpMut) {
+                steady_ok = 0;
+            }
+        }
+        if (steady_ok && have_cw && state->mag_cal_cand_has_world) {
+            uint64_t dsq = 0ull;
+            for (unsigned idx = 0; idx < 3u; ++idx) {
+                const int64_t d = (int64_t)cw[idx] - (int64_t)state->mag_cal_cand_world_mut[idx];
+                const uint64_t ad = (d < 0) ? (uint64_t)(-d) : (uint64_t)d;
+                dsq += ad * ad;
+            }
+            if (isqrt64(dsq) > (uint64_t)kMagCalCandTolWorldMut) {
+                steady_ok = 0;
+            }
+        }
+    }
+
+    if (!steady_ok || state->mag_cal_cand_good == 0u) {
+        state->mag_cal_cand_norm_mut = c_norm;
+        state->mag_cal_cand_up_mut = c_up;
+        state->mag_cal_cand_has_up = accel_steady ? 1 : 0;
+        if (have_cw) {
+            for (unsigned idx = 0; idx < 3u; ++idx) {
+                state->mag_cal_cand_world_mut[idx] = cw[idx];
+            }
+            state->mag_cal_cand_has_world = 1;
+        } else {
+            state->mag_cal_cand_has_world = 0;
+        }
+        state->mag_cal_cand_good = 1u;
+        state->mag_cal_cand_turn_mdeg = 0u;
+        return 0;
+    }
+
+    if (state->mag_cal_cand_good < 0xffffffffu) {
+        state->mag_cal_cand_good++;
+    }
+    if (accel_steady && !state->mag_cal_cand_has_up) {
+        state->mag_cal_cand_up_mut = c_up;
+        state->mag_cal_cand_has_up = 1;
+    }
+    if (have_cw && !state->mag_cal_cand_has_world) {
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            state->mag_cal_cand_world_mut[idx] = cw[idx];
+        }
+        state->mag_cal_cand_has_world = 1;
+    }
+
+    const int boot_escape = !state->has_trusted_mag_cal &&
+        state->earth_ref_count < (uint32_t)kEarthRefMinSamples &&
+        state->mag_cal_cand_good >= (uint32_t)kMagCalCandBootSamples;
+    const int clean_ok = !state->mag_cal_cand_from_disturb &&
+        !state->mag_disturbed && state->mag_disturb_hold == 0u &&
+        state->mag_cal_quarantine == 0u &&
+        state->mag_cal_cand_good >= (uint32_t)kMagCalCandCleanSamples;
+    const int rot_proof = state->mag_cal_cand_has_world &&
+        state->mag_cal_cand_good >= (uint32_t)kMagCalCandRotSamples &&
+        state->mag_cal_cand_turn_mdeg >= (uint32_t)kMagCalCandRotTurnMdeg;
+    const int retro_proof = have_cw &&
+        state->mag_cal_cand_good >= (uint32_t)kMagCalCandRetroSamples &&
+        pose_hist_proves_candidate(state, cw);
+    const int cold_boot_proof = !state->has_trusted_mag_cal && have_cw &&
+        state->mag_cal_cand_good >= (uint32_t)kMagCalCandRetroSamples &&
+        pose_hist_proves_cold_boot(state, cw, mag_q16);
+
+    if (boot_escape || clean_ok || rot_proof || retro_proof || cold_boot_proof) {
+        int32_t promoted[3];
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            promoted[idx] = state->mag_cal_cand_bias[idx];
+        }
+        promote_trusted_mag_cal(state, promoted, state->mag_cal_cand_acc, 1);
+        return 1;
+    }
+    return 0;
+}
+
+void
+sns_compass_set_mag(SnsCompass *state, const int32_t mag_q16[3], int32_t accuracy)
+{
+    state->mag_sample_seq++;
+    int still_jump = 0;
+    if (state->has_mag_prev_inst && state->gyro_valid && !gyro_is_rotating(state)) {
+        if (bias_drift_mut(mag_q16, state->mag_prev_inst) > (uint32_t)kMagStillJumpMut) {
+            still_jump = 1;
+        }
+    }
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        state->mag_prev_inst[idx] = mag_q16[idx];
+    }
+    state->has_mag_prev_inst = 1;
+
+    if (!still_jump) {
+        pose_hist_record(state, mag_q16);
+    }
+
+    int32_t up_vec[3];
+    uint64_t accel_norm_q16 = 0;
+    const int have_up = (accel_up_and_norm(state, up_vec, &accel_norm_q16) == 0);
+    const int accel_steady = have_up &&
+        accel_norm_q16 >= (uint64_t)kFusionAccelMinQ16 &&
+        accel_norm_q16 <= (uint64_t)kFusionAccelMaxQ16;
+    const int32_t *up_ptr = have_up ? up_vec : NULL;
+
+    if (state->mag_cal_cand_valid && !still_jump) {
+        (void)eval_mag_cal_candidate(state, mag_q16, up_ptr, accel_steady);
+    }
+
+    const int32_t *ref_bias = select_instant_ref_bias(state);
+    if (!ref_bias) {
+        mag_hist_push(state, mag_q16);
+        state->mag_acc = accuracy;
+        state->mag_valid = 1;
+        refresh_active_bias(state);
+        return;
+    }
+
+    uint32_t norm_mut = 0u;
+    uint32_t horiz_mut = 0u;
+    int32_t up_mut = 0;
+    int32_t cal_mut[3] = {0, 0, 0};
+    const int in_earth = bias_eval_earth(mag_q16, ref_bias, up_ptr, &norm_mut, &horiz_mut, &up_mut, cal_mut);
+
+    uint32_t reason = 0u;
+    int earth_anomaly = 0;
+    int earth_soft_skip = 0;
+    if (!in_earth) {
+        const int hard_out =
+            norm_mut < (uint32_t)kEarthHardNormMinMut || norm_mut > (uint32_t)kEarthHardNormMaxMut ||
+            (up_ptr && (horiz_mut < (uint32_t)kEarthHardHorizMinMut || horiz_mut > (uint32_t)kEarthHardHorizMaxMut));
+        if (hard_out) {
+            state->earth_anom_cnt = (uint32_t)kEarthRangeDebounce;
+            earth_anomaly = 1;
+            reason |= kMagDistReasonEarth;
+        } else {
+            if (state->earth_anom_cnt < (uint32_t)kEarthRangeDebounce) {
+                state->earth_anom_cnt++;
+            }
+            if (state->earth_anom_cnt >= (uint32_t)kEarthRangeDebounce) {
+                earth_anomaly = 1;
+                reason |= kMagDistReasonEarth;
+            } else {
+                earth_soft_skip = 1;
+            }
+        }
+    } else {
+        state->earth_anom_cnt = 0u;
+    }
+    if (still_jump) {
+        reason |= kMagDistReasonJump;
+    }
+
+    int ref_anomaly = 0;
+    int vec_anomaly = 0;
+    int vec_soft_skip = 0;
+    int have_world = 0;
+    int64_t b_north = 0;
+    int64_t b_west = 0;
+    int64_t b_up_q = 0;
+    uint32_t vec_err_mut = 0u;
+
+    if (in_earth && state->earth_ref_count >= (uint32_t)kEarthRefMinSamples && state->bias_handoff_steps == 0u) {
+        const uint32_t norm_diff = (norm_mut >= state->earth_ref_norm_mut)
+            ? (norm_mut - state->earth_ref_norm_mut)
+            : (state->earth_ref_norm_mut - norm_mut);
+        uint32_t up_diff = 0u;
+        if (accel_steady && state->earth_ref_has_up) {
+            const int64_t du = (int64_t)up_mut - (int64_t)state->earth_ref_up_mut;
+            up_diff = (du < 0) ? (uint32_t)(-du) : (uint32_t)du;
+        }
+        if (norm_diff > (uint32_t)kEarthNormDevMut) {
+            ref_anomaly = 1;
+            reason |= kMagDistReasonNorm;
+        }
+        if (up_diff > (uint32_t)kEarthUpDevMut) {
+            ref_anomaly = 1;
+            reason |= kMagDistReasonUp;
+        }
+
+        /* 3D inertial world-frame vector consistency check (inspired by Apple CLAttitudeDependentKFCalibrator
+         * dAngle/magDiff/incDiff): trips immediately on >9.5 uT spikes and debounces moderate 5.5-9.5 uT
+         * deviations across 3 samples (60 ms) to ignore isolated raw AK0991x noise without leaking heading. */
+        if (state->compass_mode == SNS_COMPASS_MODE_FUSION &&
+            state->fallback_valid && state->fallback_used_mag &&
+            state->earth_ref_horiz_mut >= (uint32_t)kEarthHorizMinMut) {
+            int32_t north_q15[3];
+            int32_t west_q15[3];
+            int32_t up_q15[3];
+            quat_to_axes_q15(state->fallback_q, north_q15, west_q15, up_q15);
+            b_north = ((int64_t)north_q15[0] * (int64_t)cal_mut[0] +
+                       (int64_t)north_q15[1] * (int64_t)cal_mut[1] +
+                       (int64_t)north_q15[2] * (int64_t)cal_mut[2]) >> 15;
+            b_west = ((int64_t)west_q15[0] * (int64_t)cal_mut[0] +
+                      (int64_t)west_q15[1] * (int64_t)cal_mut[1] +
+                      (int64_t)west_q15[2] * (int64_t)cal_mut[2]) >> 15;
+            b_up_q = ((int64_t)up_q15[0] * (int64_t)cal_mut[0] +
+                      (int64_t)up_q15[1] * (int64_t)cal_mut[1] +
+                      (int64_t)up_q15[2] * (int64_t)cal_mut[2]) >> 15;
+            const int64_t dn = b_north - (int64_t)state->earth_ref_horiz_mut;
+            const int64_t dw = b_west;
+            const int64_t du_w = state->earth_ref_has_up ? (b_up_q - (int64_t)state->earth_ref_up_mut) : 0ll;
+            const uint64_t an = (dn < 0) ? (uint64_t)(-dn) : (uint64_t)dn;
+            const uint64_t aw = (dw < 0) ? (uint64_t)(-dw) : (uint64_t)dw;
+            const uint64_t au = (du_w < 0) ? (uint64_t)(-du_w) : (uint64_t)du_w;
+            vec_err_mut = (uint32_t)isqrt64(an * an + aw * aw + au * au);
+            state->last_vec_err_mut = vec_err_mut;
+            have_world = 1;
+            const uint32_t vec_lim = gyro_is_still(state)
+                ? (uint32_t)kEarthVecStillDevMut : (uint32_t)kEarthVecMoveDevMut;
+            if (vec_err_mut > (uint32_t)kEarthVecInstantDevMut) {
+                state->vec_anom_cnt = (uint32_t)kEarthVecDebounce;
+                vec_anomaly = 1;
+                reason |= kMagDistReasonVec;
+            } else if (vec_err_mut > vec_lim) {
+                if (state->vec_anom_cnt < (uint32_t)kEarthVecDebounce) {
+                    state->vec_anom_cnt++;
+                }
+                if (state->vec_anom_cnt >= (uint32_t)kEarthVecDebounce) {
+                    vec_anomaly = 1;
+                    reason |= kMagDistReasonVec;
+                } else {
+                    vec_soft_skip = 1;
+                }
+            } else {
+                state->vec_anom_cnt = 0u;
+            }
+        } else {
+            state->vec_anom_cnt = 0u;
+        }
+
+        /* Heading-preserving room-change re-anchor: only re-anchor local |B|/H/B_up when heading
+         * STILL agrees with gyro (|B_west| <= 5 uT, B_north >= 12 uT), so a nearby magnet cannot hijack it. */
+        const int heading_consistent = !have_world ||
+            (b_north >= (int64_t)kEarthHorizMinMut &&
+             ((b_west < 0 ? -b_west : b_west) <= (int64_t)kEarthReanchorMaxWestMut));
+        if ((ref_anomaly || vec_anomaly) && !still_jump && heading_consistent &&
+            norm_diff <= (uint32_t)kEarthReanchorMaxDevMut &&
+            up_diff <= (uint32_t)kEarthReanchorMaxDevMut) {
+            int match_cand = 0;
+            if (state->earth_reanchor_count > 0u) {
+                const uint32_t cn = (norm_mut >= state->earth_reanchor_norm_mut)
+                    ? (norm_mut - state->earth_reanchor_norm_mut)
+                    : (state->earth_reanchor_norm_mut - norm_mut);
+                uint32_t cu = 0u;
+                if (accel_steady && state->earth_ref_has_up) {
+                    const int64_t du2 = (int64_t)up_mut - (int64_t)state->earth_reanchor_up_mut;
+                    cu = (du2 < 0) ? (uint32_t)(-du2) : (uint32_t)du2;
+                }
+                match_cand = (cn <= (uint32_t)kEarthReanchorTolNormMut &&
+                              cu <= (uint32_t)kEarthReanchorTolUpMut);
+            }
+            if (match_cand) {
+                state->earth_reanchor_count++;
+            } else {
+                state->earth_reanchor_norm_mut = norm_mut;
+                state->earth_reanchor_horiz_mut = horiz_mut;
+                state->earth_reanchor_up_mut = up_mut;
+                state->earth_reanchor_count = 1u;
+            }
+            if (state->earth_reanchor_count >= (uint32_t)kEarthReanchorSamples) {
+                state->earth_ref_norm_mut = norm_mut;
+                state->earth_ref_horiz_mut = horiz_mut;
+                if (accel_steady) {
+                    state->earth_ref_up_mut = up_mut;
+                    state->earth_ref_has_up = 1;
+                }
+                state->earth_reanchor_count = 0u;
+                state->vec_anom_cnt = 0u;
+                ref_anomaly = 0;
+                vec_anomaly = 0;
+                reason &= ~(kMagDistReasonNorm | kMagDistReasonUp | kMagDistReasonVec);
+            }
+        } else {
+            state->earth_reanchor_count = 0u;
+        }
+
+        /* Rotation-verified uniform-field relock: if phone booted near localized iron and later moved to a
+         * clean uniform Earth field, B_world = R(q) * B_cal stays invariant in 3D WHILE turning >=90 deg by gyro. */
+        if ((ref_anomaly || vec_anomaly || state->mag_disturbed) && !still_jump && accel_steady && have_world) {
+            const int32_t bw[3] = {(int32_t)b_north, (int32_t)b_west, (int32_t)b_up_q};
+            int match_relock = 0;
+            if (state->relock_steady_cnt > 0u) {
+                uint64_t dsq = 0ull;
+                for (unsigned idx = 0; idx < 3u; ++idx) {
+                    const int64_t d = (int64_t)bw[idx] - (int64_t)state->relock_world_mut[idx];
+                    const uint64_t ad = (d < 0) ? (uint64_t)(-d) : (uint64_t)d;
+                    dsq += ad * ad;
+                }
+                match_relock = (isqrt64(dsq) <= (uint64_t)kRelockTolVecMut);
+            }
+            if (match_relock) {
+                state->relock_steady_cnt++;
+            } else {
+                for (unsigned idx = 0; idx < 3u; ++idx) {
+                    state->relock_world_mut[idx] = bw[idx];
+                }
+                state->relock_steady_cnt = 1u;
+                state->gyro_turn_acc_mdeg = 0u;
+            }
+            if (state->relock_steady_cnt >= (uint32_t)kRelockSteadySamples &&
+                state->gyro_turn_acc_mdeg >= (uint32_t)kRelockMinTurnMdeg) {
+                state->earth_ref_norm_mut = norm_mut;
+                state->earth_ref_horiz_mut = horiz_mut;
+                state->earth_ref_up_mut = up_mut;
+                state->earth_ref_has_up = 1;
+                state->mag_disturbed = 0;
+                state->mag_disturb_hold = 0u;
+                state->mag_cal_quarantine = 0u;
+                state->vec_anom_cnt = 0u;
+                state->earth_anom_cnt = 0u;
+                state->bias_handoff_steps = (uint32_t)kBiasHandoffSteps;
+                state->relock_steady_cnt = 0u;
+                state->gyro_turn_acc_mdeg = 0u;
+                state->earth_reanchor_count = 0u;
+                ref_anomaly = 0;
+                vec_anomaly = 0;
+                reason = 0u;
+            }
+        } else {
+            state->relock_steady_cnt = 0u;
+            state->gyro_turn_acc_mdeg = 0u;
+        }
+    } else {
+        state->vec_anom_cnt = 0u;
+        state->earth_reanchor_count = 0u;
+        state->relock_steady_cnt = 0u;
+        state->gyro_turn_acc_mdeg = 0u;
+    }
+
+    if (earth_anomaly || ref_anomaly || vec_anomaly || still_jump) {
+        if (!state->mag_disturbed) {
+            state->mag_disturb_events++;
+        }
+        state->mag_disturbed = 1;
+        state->mag_disturb_reason = reason;
+        state->mag_disturb_hold = (uint32_t)kMagDisturbHoldSamples;
+        state->mag_cal_quarantine = (uint32_t)kMagCalQuarantineSamples;
+        state->mag_innov_reject_cnt = 0u;
+        state->mag_innov_confirm_cnt = 0u;
+        mag_hist_reset(state);
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            state->mag_raw[idx] = mag_q16[idx];
+        }
+        state->mag_acc = accuracy;
+        state->mag_valid = 1;
+        refresh_active_bias(state);
+        return;
+    }
+
+    if (earth_soft_skip || vec_soft_skip) {
+        state->mag_acc = accuracy;
+        state->mag_valid = 1;
+        refresh_active_bias(state);
+        return;
+    }
+
+    mag_hist_push(state, mag_q16);
+    if (state->mag_disturb_hold > 0u) {
+        state->mag_disturb_hold--;
+        if (state->mag_disturb_hold == 0u) {
+            state->mag_disturbed = 0;
+            state->mag_disturb_reason = 0u;
+        }
+    }
+    if (state->mag_cal_quarantine > 0u) {
+        state->mag_cal_quarantine--;
+    }
+
+    /* Bootstrap local Earth ref quickly (~0.5 s of calm gravity), then freeze it while stationary
+     * and only track very slowly (div=512) during clean rotation so a slowly-approaching magnet
+     * or violent mid-swing linear acceleration can never corrupt earth_ref. */
+    const int calm_boot_gyro = (!state->gyro_valid || gyro_l1_rate_q16(state) <= (uint64_t)kEarthBootGyroMaxQ16);
+    const int bootstrapping = (state->earth_ref_count < (uint32_t)kEarthRefMinSamples);
+    const int allow_boot_step = bootstrapping && calm_boot_gyro && (!have_up || accel_steady);
+    const int allow_slow_track = !bootstrapping &&
+        !state->mag_disturbed && state->mag_cal_quarantine == 0u && !state->last_yaw_rejected &&
+        !gyro_is_still(state) && (!have_world || vec_err_mut <= (uint32_t)kEarthRefTrackMaxVecMut);
+    if (allow_boot_step || allow_slow_track) {
+        if (state->earth_ref_count == 0u) {
+            state->earth_ref_norm_mut = norm_mut;
+            if (have_up) {
+                state->earth_ref_horiz_mut = horiz_mut;
+            }
+        } else {
+            const int64_t div = bootstrapping ? 8ll : 512ll;
+            const int64_t delta = (int64_t)norm_mut - (int64_t)state->earth_ref_norm_mut;
+            state->earth_ref_norm_mut = (uint32_t)((int64_t)state->earth_ref_norm_mut + (delta / div));
+            if (have_up) {
+                if (state->earth_ref_horiz_mut == 0u) {
+                    state->earth_ref_horiz_mut = horiz_mut;
+                } else {
+                    const int64_t hdelta = (int64_t)horiz_mut - (int64_t)state->earth_ref_horiz_mut;
+                    state->earth_ref_horiz_mut = (uint32_t)((int64_t)state->earth_ref_horiz_mut + (hdelta / div));
+                }
+            }
+        }
+        if (accel_steady) {
+            if (!state->earth_ref_has_up) {
+                state->earth_ref_up_mut = up_mut;
+                state->earth_ref_has_up = 1;
+            } else {
+                const int64_t div = bootstrapping ? 8ll : 512ll;
+                const int64_t delta = (int64_t)up_mut - (int64_t)state->earth_ref_up_mut;
+                state->earth_ref_up_mut = (int32_t)((int64_t)state->earth_ref_up_mut + (delta / div));
+            }
+        }
+        if (state->earth_ref_count < 0xffffffffu) {
+            state->earth_ref_count++;
+        }
+    }
+
+    state->mag_acc = accuracy;
+    state->mag_valid = 1;
+    refresh_active_bias(state);
+}
+
+void
+sns_compass_set_mag_cal(SnsCompass *state, const int32_t bias_q16[3], int32_t accuracy)
+{
+    const int was_trusted = mag_cal_is_trusted(state);
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        state->mag_cal_bias[idx] = bias_q16[idx];
+    }
+    state->mag_cal_acc = accuracy;
+    state->mag_cal_valid = 1;
+
+    if (accuracy <= 0) {
+        /* Transient acc=0 during anomalies clears pending candidates but preserves verified trusted_mag_cal_bias. */
+        state->mag_cal_polluted = 0;
+        state->mag_cal_cand_valid = 0;
+        state->mag_cal_cand_good = 0u;
+        state->mag_cal_cand_turn_mdeg = 0u;
+        refresh_active_bias(state);
+        return;
+    }
+
+    const int in_disturb = (state->mag_disturbed || state->mag_disturb_hold > 0u || state->mag_cal_quarantine > 0u);
+    const int32_t *drift_ref = state->has_trusted_mag_cal ? state->trusted_mag_cal_bias
+        : (state->has_default_mag_bias ? state->default_mag_bias : NULL);
+    const uint32_t drift = drift_ref ? bias_drift_mut(bias_q16, drift_ref) : 0u;
+
+    if (!in_disturb && (!drift_ref || drift <= (uint32_t)kMagCalFastDriftMut)) {
+        const int allow_update = !state->has_trusted_mag_cal ||
+            accuracy >= state->trusted_mag_cal_acc || accuracy >= 2;
+        if (allow_update) {
+            const int need_ref_reset = (!was_trusted && accuracy >= 2);
+            promote_trusted_mag_cal(state, bias_q16, accuracy, 0);
+            if (need_ref_reset) {
+                state->earth_ref_count = 0u;
+                state->earth_ref_horiz_mut = 0u;
+                state->earth_ref_has_up = 0;
+                state->earth_reanchor_count = 0u;
+                state->relock_steady_cnt = 0u;
+                state->gyro_turn_acc_mdeg = 0u;
+            }
+        } else {
+            state->mag_cal_polluted = 0;
+        }
+        refresh_active_bias(state);
+        return;
+    }
+
+    state->mag_cal_polluted = 1;
+    state->mag_cal_rejected++;
+
+    /* Allow acc=3 with drift <= 15 uT that arrived during transient disturbance to enter candidate
+     * verification instead of being silently dropped (boot #342 25 s mrej black hole). */
+    if (accuracy >= 3 && drift <= (uint32_t)kMagCalRemagMaxDriftMut) {
+        if (state->mag_cal_cand_valid &&
+            bias_drift_mut(bias_q16, state->mag_cal_cand_bias) <= (uint32_t)kMagCalCandStableMut) {
+            for (unsigned idx = 0; idx < 3u; ++idx) {
+                state->mag_cal_cand_bias[idx] = bias_q16[idx];
+            }
+            state->mag_cal_cand_acc = accuracy;
+            if (in_disturb) {
+                state->mag_cal_cand_from_disturb = 1;
+            }
+        } else {
+            for (unsigned idx = 0; idx < 3u; ++idx) {
+                state->mag_cal_cand_bias[idx] = bias_q16[idx];
+            }
+            state->mag_cal_cand_acc = accuracy;
+            state->mag_cal_cand_valid = 1;
+            state->mag_cal_cand_from_disturb = in_disturb ? 1 : 0;
+            state->mag_cal_cand_good = 0u;
+            state->mag_cal_cand_turn_mdeg = 0u;
+            state->mag_cal_cand_has_up = 0;
+            state->mag_cal_cand_has_world = 0;
+        }
+    } else {
+        state->mag_cal_cand_valid = 0;
+        state->mag_cal_cand_good = 0u;
+        state->mag_cal_cand_turn_mdeg = 0u;
+    }
+    refresh_active_bias(state);
+}
+
+static uint64_t
+quat_l1_dist_q30(const int32_t lhs[4], const int32_t rhs[4])
+{
+    uint64_t sum_pos = 0;
+    uint64_t sum_neg = 0;
+    for (unsigned idx = 0; idx < 4u; ++idx) {
+        const int64_t diff_pos = (int64_t)lhs[idx] - (int64_t)rhs[idx];
+        const int64_t diff_neg = (int64_t)lhs[idx] + (int64_t)rhs[idx];
+        sum_pos += (diff_pos < 0) ? (uint64_t)(-diff_pos) : (uint64_t)diff_pos;
+        sum_neg += (diff_neg < 0) ? (uint64_t)(-diff_neg) : (uint64_t)diff_neg;
+    }
+    return (sum_pos < sum_neg) ? sum_pos : sum_neg;
+}
+
+static int
+rotv_gravity_agrees(const SnsCompass *state, const int32_t quat_q30[4])
+{
+    if (!state->accel_valid) {
+        return 1;
+    }
+    int64_t up_raw[3];
+    uint64_t norm2 = 0;
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        const int64_t val = -(int64_t)state->accel_ios[idx];
+        up_raw[idx] = val;
+        const uint64_t mag = (val < 0) ? (uint64_t)(-val) : (uint64_t)val;
+        if (mag > 0x1000000ull) {
+            return 1;
+        }
+        norm2 += mag * mag;
+    }
+    const uint64_t norm_q16 = isqrt64(norm2);
+    if (norm_q16 < (uint64_t)kRotvGravAccelMinQ16 || norm_q16 > (uint64_t)kRotvGravAccelMaxQ16) {
+        return 1;
+    }
+    int32_t accel_up[3];
+    if (normalize_vec3_q15(up_raw, accel_up) != 0) {
+        return 1;
+    }
+    const int64_t qx = quat_q30[0] >> 15;
+    const int64_t qy = quat_q30[1] >> 15;
+    const int64_t qz = quat_q30[2] >> 15;
+    const int64_t qw = quat_q30[3] >> 15;
+    const int32_t rotv_up[3] = {
+        (int32_t)((2ll * (qx * qz - qw * qy)) >> 15),
+        (int32_t)((2ll * (qy * qz + qw * qx)) >> 15),
+        (int32_t)(kQ15One - ((2ll * (qx * qx + qy * qy)) >> 15)),
+    };
+    const int64_t dot_q15 =
+        ((int64_t)rotv_up[0] * (int64_t)accel_up[0] +
+         (int64_t)rotv_up[1] * (int64_t)accel_up[1] +
+         (int64_t)rotv_up[2] * (int64_t)accel_up[2]) >> 15;
+    return dot_q15 >= (int64_t)kRotvGravCosMinQ15;
+}
+
+void
+sns_compass_rotv_bounced(SnsCompass *state)
+{
+    state->rotv_has_prev = 0;
+    state->rotv_gyro_stuck_cnt = 0;
+    state->rotv_grav_stuck_cnt = 0;
+    state->rotv_resume_moved_cnt = 0;
+    state->rotv_post_bounce_skip = 2u;
+}
+
+int
+sns_compass_set_rotv(SnsCompass *state, const uint32_t quat_bits[4], int32_t accuracy)
+{
+    int64_t enu[4];
+    for (unsigned idx = 0; idx < 4u; ++idx) {
+        if (!is_finite_float_bits(quat_bits[idx])) {
+            return -1;
+        }
+        enu[idx] = sfx_scale(quat_bits[idx], 1, 1, 30, -(int64_t)kQ30One, (int64_t)kQ30One);
+    }
+    /* Convert Android ENU (+X=E, +Y=N, +Z=U) to Apple NWU (+X=N, +Y=W, +Z=U): q_nwu = q_z(-90 deg) * q_enu. */
+    const int64_t raw_nwu[4] = {
+        (enu[0] + enu[1]) >> 1,
+        (enu[1] - enu[0]) >> 1,
+        (enu[2] - enu[3]) >> 1,
+        (enu[3] + enu[2]) >> 1,
+    };
+    int32_t normalized[4];
+    if (normalize_quat_q30(raw_nwu, normalized) != 0) {
+        return -1;
+    }
+    for (unsigned idx = 0; idx < 4u; ++idx) {
+        state->rotv_raw_enu_milli[idx] = sfx_milli(quat_bits[idx]);
+    }
+    state->rotv_acc = accuracy;
+    state->last_rotv_heading_mdeg = heading_from_quat_q30(normalized);
+
+    if (state->compass_mode != SNS_COMPASS_MODE_ROTV) {
+        for (unsigned idx = 0; idx < 4u; ++idx) {
+            state->rotv_q[idx] = normalized[idx];
+            state->rotv_prev_q[idx] = normalized[idx];
+        }
+        state->rotv_has_prev = 1;
+        state->rotv_valid = 1;
+        return 0;
+    }
+
+    if (state->rotv_stuck) {
+        if (state->rotv_post_bounce_skip > 0u) {
+            state->rotv_post_bounce_skip--;
+            return 0;
+        }
+        const int grav_ok = rotv_gravity_agrees(state, normalized);
+        const uint64_t dist_stuck = quat_l1_dist_q30(normalized, state->rotv_stuck_q);
+        const uint64_t delta_prev = state->rotv_has_prev ? quat_l1_dist_q30(normalized, state->rotv_prev_q) : 0ull;
+        if (grav_ok && (dist_stuck > (uint64_t)kRotvUnstickDeltaQ30 ||
+                        (state->rotv_has_prev && delta_prev > (uint64_t)kRotvSameEpsQ30))) {
+            state->rotv_resume_moved_cnt++;
+        } else {
+            state->rotv_resume_moved_cnt = 0;
+        }
+        for (unsigned idx = 0; idx < 4u; ++idx) {
+            state->rotv_prev_q[idx] = normalized[idx];
+        }
+        state->rotv_has_prev = 1;
+        if (state->rotv_resume_moved_cnt >= kRotvResumeThreshold) {
+            for (unsigned idx = 0; idx < 4u; ++idx) {
+                state->rotv_q[idx] = normalized[idx];
+            }
+            state->rotv_stuck = 0;
+            state->rotv_valid = 1;
+            state->rotv_gyro_stuck_cnt = 0;
+            state->rotv_grav_stuck_cnt = 0;
+            state->rotv_resume_moved_cnt = 0;
+        }
+        return 0;
+    }
+
+    const int grav_ok = rotv_gravity_agrees(state, normalized);
+    if (state->rotv_has_prev) {
+        const uint64_t delta_prev = quat_l1_dist_q30(normalized, state->rotv_prev_q);
+        if (delta_prev <= (uint64_t)kRotvSameEpsQ30) {
+            if (gyro_is_rotating(state)) {
+                state->rotv_gyro_stuck_cnt++;
+            } else if (state->rotv_gyro_stuck_cnt > 0u) {
+                state->rotv_gyro_stuck_cnt--;
+            }
+        } else {
+            state->rotv_gyro_stuck_cnt = 0;
+        }
+        if (!grav_ok && delta_prev <= (uint64_t)kRotvSlowDeltaQ30) {
+            state->rotv_grav_stuck_cnt++;
+        } else {
+            state->rotv_grav_stuck_cnt = 0;
+        }
+        if (state->rotv_gyro_stuck_cnt >= kRotvStuckThreshold ||
+            state->rotv_grav_stuck_cnt >= kRotvStuckThreshold) {
+            state->rotv_stuck = 1;
+            state->rotv_valid = 0;
+            state->rotv_stuck_events++;
+            state->rotv_resume_moved_cnt = 0;
+            for (unsigned idx = 0; idx < 4u; ++idx) {
+                state->rotv_stuck_q[idx] = normalized[idx];
+                state->rotv_prev_q[idx] = normalized[idx];
+                state->fallback_q[idx] = normalized[idx];
+            }
+            state->fallback_valid = 1;
+            state->fallback_seeded_from_rotv = 1;
+            state->fallback_used_mag = (accuracy >= 1) ? 1 : 0;
+            if (!grav_ok) {
+                int32_t aligned_q30[4];
+                int aligned_mag = 0;
+                if (fallback_quat_from_accel_mag(state, aligned_q30, &aligned_mag, NULL) == 0) {
+                    for (unsigned idx = 0; idx < 4u; ++idx) {
+                        state->fallback_q[idx] = aligned_q30[idx];
+                    }
+                    if (aligned_mag) {
+                        state->fallback_used_mag = 1;
+                    }
+                }
+            }
+            return 0;
+        }
+    }
+
+    for (unsigned idx = 0; idx < 4u; ++idx) {
+        state->rotv_q[idx] = normalized[idx];
+        state->rotv_prev_q[idx] = normalized[idx];
+    }
+    state->rotv_has_prev = 1;
+    state->rotv_valid = 1;
+    return 0;
+}
+
+int
+sns_compass_build_report(SnsCompass *state, uint8_t out[SNS_COMPASS_REPORT_BYTES], int32_t *heading_mdeg_out)
+{
+    int32_t quat_q30[4];
+    int used_rotv = 0;
+    int used_fallback_mag = 0;
+    int yaw_innov_rejected = 0;
+
+    if (state->compass_mode == SNS_COMPASS_MODE_ROTV && state->rotv_valid) {
+        for (unsigned idx = 0; idx < 4u; ++idx) {
+            quat_q30[idx] = state->rotv_q[idx];
+        }
+        used_rotv = 1;
+        refresh_active_bias(state);
+    } else {
+        int32_t meas_q30[4];
+        int accel_steady = 0;
+        const int meas_rc = fallback_quat_from_accel_mag(state, meas_q30, &used_fallback_mag, &accel_steady);
+        if (meas_rc != 0) {
+            if (!state->fallback_valid) {
+                return -1;
+            }
+        } else {
+            if (!state->fallback_valid || (used_fallback_mag && !state->fallback_used_mag)) {
+                for (unsigned idx = 0; idx < 4u; ++idx) {
+                    state->fallback_q[idx] = meas_q30[idx];
+                }
+                state->fallback_valid = 1;
+                state->fallback_used_mag = used_fallback_mag;
+                state->prev_bias_src = state->active_bias_src;
+                state->bias_handoff_steps = 0u;
+                state->mag_innov_reject_cnt = 0u;
+                state->mag_innov_confirm_cnt = 0u;
+            } else {
+                if (state->active_bias_src != state->prev_bias_src) {
+                    if (state->prev_bias_src == SNS_COMPASS_BIAS_DEFAULT &&
+                        state->active_bias_src == SNS_COMPASS_BIAS_MAGCAL &&
+                        used_fallback_mag && state->fallback_used_mag) {
+                        state->bias_handoff_steps = kBiasHandoffSteps;
+                        state->mag_innov_reject_cnt = 0u;
+                        state->mag_innov_confirm_cnt = 0u;
+                    }
+                    state->prev_bias_src = state->active_bias_src;
+                }
+                if (accel_steady) {
+                    int hold_accel_only = 0;
+                    if (state->compass_mode == SNS_COMPASS_MODE_FUSION &&
+                        used_fallback_mag && state->fallback_used_mag &&
+                        state->fallback_gyro_steps > 0u && state->bias_handoff_steps == 0u) {
+                        const uint32_t abs_yaw_err = abs_i32_to_u32(quat_yaw_diff_mdeg(state->fallback_q, meas_q30));
+                        const int still_now = gyro_is_still(state);
+                        if (abs_yaw_err > (uint32_t)kMagYawInnovGateMdeg) {
+                            yaw_innov_rejected = 1;
+                            hold_accel_only = 1;
+                            state->mag_innov_reject_cnt++;
+                            if (state->mag_innov_reject_cnt == (uint32_t)kMagInnovQuarantineTrip &&
+                                state->mag_cal_quarantine < (uint32_t)kMagCalQuarantineSamples) {
+                                state->mag_cal_quarantine = (uint32_t)kMagCalQuarantineSamples;
+                            }
+                            if ((still_now && state->mag_innov_reject_cnt >= (uint32_t)kMagYawDisturbTrip) ||
+                                state->mag_innov_reject_cnt >= (uint32_t)kMagInnovQuarantineTrip) {
+                                if (!state->mag_disturbed) {
+                                    state->mag_disturb_events++;
+                                }
+                                state->mag_disturbed = 1;
+                                state->mag_disturb_reason |= kMagDistReasonYaw;
+                                state->mag_disturb_hold = (uint32_t)kMagDisturbHoldSamples;
+                                state->mag_cal_quarantine = (uint32_t)kMagCalQuarantineSamples;
+                                refresh_active_bias(state);
+                            }
+                        } else {
+                            state->mag_innov_reject_cnt = 0u;
+                            /* Stationary yaw lock: once initial gyro convergence completes, do not let
+                             * subtle (<8 deg) slowly-approaching magnetic perturbations creep yaw at rest. */
+                            if (still_now && state->fallback_gyro_steps >= (uint32_t)kStationaryYawLockSteps) {
+                                hold_accel_only = 1;
+                            }
+                        }
+                    }
+                    if (hold_accel_only) {
+                        int32_t accel_only_q30[4];
+                        if (fallback_quat_accel_only(state, accel_only_q30) == 0) {
+                            for (unsigned idx = 0; idx < 4u; ++idx) {
+                                meas_q30[idx] = accel_only_q30[idx];
+                            }
+                        }
+                    }
+                    int64_t gain_den;
+                    if (state->fallback_gyro_steps == 0u) {
+                        gain_den = 8ll;
+                    } else if (state->bias_handoff_steps > 0u) {
+                        /* Fast initial convergence (~0.3 s at 50 Hz -> 99% lock) before smooth tail,
+                         * so yaw aligns before post-handoff anomaly gates engage. */
+                        gain_den = (state->bias_handoff_steps > (uint32_t)kBiasHandoffSteps - 16u) ? 4ll : 16ll;
+                        state->bias_handoff_steps--;
+                    } else if (state->compass_mode == SNS_COMPASS_MODE_FUSION) {
+                        if (hold_accel_only) {
+                            gain_den = 128ll;
+                        } else if (used_fallback_mag &&
+                                   state->earth_ref_count < (uint32_t)kEarthRefMinSamples &&
+                                   gyro_is_still(state)) {
+                            /* Initial ~0.5 s stationary earth_ref bootstrap: settle single-sample startup
+                             * mag noise before anomaly gates & stationary yaw lock engage. */
+                            gain_den = 8ll;
+                        } else {
+                            gain_den = 384ll;
+                        }
+                    } else {
+                        gain_den = 32ll;
+                    }
+                    blend_quat_nlerp(state->fallback_q, meas_q30, 1ll, gain_den);
+                    if (used_fallback_mag && !yaw_innov_rejected) {
+                        state->fallback_used_mag = 1;
+                    }
+                }
+            }
+        }
+        used_fallback_mag = state->fallback_used_mag;
+        for (unsigned idx = 0; idx < 4u; ++idx) {
+            quat_q30[idx] = state->fallback_q[idx];
+        }
+    }
+    state->last_yaw_rejected = yaw_innov_rejected;
+
+    int32_t up_q15[3];
+    quat_to_axes_q15(quat_q30, NULL, NULL, up_q15);
+    const int32_t grav_q15[3] = {-up_q15[0], -up_q15[1], -up_q15[2]};
+    const int32_t heading_mdeg = heading_from_quat_q30(quat_q30);
+
+    int64_t uncal_q16[3] = {0, 0, 0};
+    int64_t bias_q16[3] = {0, 0, 0};
+    int use_real_mag_cal = 0;
+
+    if (state->mag_valid && !state->mag_disturbed && !yaw_innov_rejected &&
+        state->active_bias_src != SNS_COMPASS_BIAS_NONE &&
+        bias_is_earth_valid(state->mag_raw, state->active_bias, up_q15)) {
+        use_real_mag_cal = 1;
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            uncal_q16[idx] = state->mag_raw[idx];
+            bias_q16[idx] = state->active_bias[idx];
+        }
+    }
+    if (!use_real_mag_cal) {
+        int32_t synth_q16[3];
+        compute_synth_mag_q16(state, quat_q30, synth_q16);
+        const int32_t *ref_bias = select_instant_ref_bias(state);
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            const int64_t b = ref_bias ? (int64_t)ref_bias[idx] : 0ll;
+            bias_q16[idx] = b;
+            uncal_q16[idx] = b + (int64_t)synth_q16[idx];
+        }
+    }
+
+    int64_t user_accel_q16[3] = {0, 0, 0};
+    if (state->accel_valid) {
+        for (unsigned idx = 0; idx < 3u; ++idx) {
+            user_accel_q16[idx] = (int64_t)state->accel_ios[idx] - ((int64_t)grav_q15[idx] * 2ll);
+        }
+    }
+
+    int64_t acc_deg = 25;
+    if (used_rotv) {
+        acc_deg = (state->rotv_acc >= 2) ? 15 : (state->rotv_acc == 1) ? 20 : 25;
+    } else if (state->active_bias_src == SNS_COMPASS_BIAS_MAGCAL) {
+        acc_deg = (state->trusted_mag_cal_acc >= 2) ? 15 : 22;
+    } else if (state->active_bias_src == SNS_COMPASS_BIAS_DEFAULT) {
+        acc_deg = 18;
+    } else if (used_fallback_mag) {
+        acc_deg = 28;
+    } else {
+        acc_deg = 35;
+    }
+
+    for (unsigned idx = 0; idx < SNS_COMPASS_REPORT_BYTES; ++idx) {
+        out[idx] = 0;
+    }
+    uint16_t flags = (uint16_t)(kCompassFlagInit | kCompassFlagGravity | kCompassFlagBias);
+    if (state->gyro_valid) {
+        flags |= (uint16_t)kCompassFlagGyroCal;
+    }
+    if (used_rotv || used_fallback_mag || state->fallback_seeded_from_rotv) {
+        flags |= (uint16_t)(kCompassFlagYaw | kCompassFlagCompassCal | kCompassFlagNorth);
+    }
+    out[0] = (uint8_t)kCompassVersion;
+    out[1] = (uint8_t)kCompassCal3D;
+    write_le16(out + 0x02, flags);
+    write_le64(out + 0x04, 0ull);
+    write_le32(out + 0x0c, kFloatOneBits);
+
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        write_le32(out + 0x10 + idx * 4u, sns_compass_float_signed(uncal_q16[idx], kQ16One));
+    }
+    for (unsigned idx = 0; idx < 4u; ++idx) {
+        write_le32(out + 0x1c + idx * 4u, sns_compass_float_signed(quat_q30[idx], kQ30One));
+    }
+    int32_t gyro_corr[3] = {0, 0, 0};
+    if (state->gyro_valid) {
+        gyro_corrected_q16(state, state->gyro, gyro_corr);
+    }
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        const int64_t gyro_val = state->gyro_valid ? (int64_t)gyro_corr[idx] : 0ll;
+        write_le32(out + 0x2c + idx * 4u, sns_compass_float_signed(gyro_val, kQ16One));
+    }
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        write_le32(out + 0x38 + idx * 4u, sns_compass_float_signed(user_accel_q16[idx], kQ16One));
+    }
+    write_le32(out + 0x44, sns_compass_float_signed(heading_mdeg, 1000ull));
+    write_le32(out + 0x48, sns_compass_float_signed(acc_deg, 1ull));
+    for (unsigned idx = 0; idx < 3u; ++idx) {
+        write_le32(out + 0x4c + idx * 4u, sns_compass_float_signed(bias_q16[idx], kQ16One));
+    }
+
+    state->last_heading_mdeg = heading_mdeg;
+    state->emitted++;
+    if (heading_mdeg_out) {
+        *heading_mdeg_out = heading_mdeg;
+    }
+    return 0;
+}
diff --git a/xnu/fuxi-sensors/SensorsCompass.h b/xnu/fuxi-sensors/SensorsCompass.h
new file mode 100644
index 0000000..1e66e5c
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsCompass.h
@@ -0,0 +1,188 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Pure-integer CMDeviceMotionReport::Compass v2 (88-byte) builder for iOS 16.7.16 locationd CLCompass7 ({0xff0c, 8}).
+ *
+ * Reference:
+ *   - iOS 16.7.16 (20H392) locationd CLCompass7::onDeviceMotionServiceIohidEvent (0x1006bd9cc)
+ *     -> CMDeviceMotionReport unpack (0x1002152fc / 0x1006be77c, version=2 => 88 bytes)
+ *     -> CLCompass7::populateMotionType (0x1006bdc60), attitude-to-gravity (0x1007b41e4),
+ *        and attitude-to-north row0 (0x1007b4274) proving Apple NWU (+X=North, +Y=West, +Z=Up).
+ *   - Qualcomm ADSP SSC akm_rotv (9-axis ENU quaternion qx,qy,qz,qw via msg 1025, converted
+ *     to Apple NWU via q_z(-90 deg) * q_enu), sns_mag_cal (hard-iron bias uT via msg 1022),
+ *     and 8-sample magnetometer moving average matching Xiaomi sensors.ssc.so.
+ *   - Built under XNU -mgeneral-regs-only: zero hardware float or SIMD operations.
+ */
+#ifndef SENSORS_COMPASS_H
+#define SENSORS_COMPASS_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SNS_COMPASS_REPORT_BYTES 88u
+#define SNS_COMPASS_PERSIST_BYTES 24u
+#define SNS_COMPASS_MAG_AVG_WIN 8u
+#define SNS_COMPASS_POSE_HIST_WIN 16u
+
+typedef struct {
+    int32_t q[4];               /* fallback_q NWU quaternion in Q30 */
+    int32_t mag[3];             /* instantaneous raw mag uT in Q16 */
+    uint32_t seq;               /* mag_sample_seq when captured */
+} SnsCompassPoseSnap;
+
+enum {
+    SNS_COMPASS_MODE_FUSION = 0, /* 9-axis calibrated accel + gyro + (mag - active_bias) */
+    SNS_COMPASS_MODE_ROTV = 1,   /* legacy ADSP akm_rotv primary with stuck quarantine */
+};
+
+enum {
+    SNS_COMPASS_BIAS_NONE = 0,
+    SNS_COMPASS_BIAS_DEFAULT = 1, /* configured PCB hard-iron bias */
+    SNS_COMPASS_BIAS_MAGCAL = 2,  /* live ADSP sns_mag_cal bias */
+};
+
+typedef struct {
+    uint32_t compass_mode;      /* SNS_COMPASS_MODE_FUSION (0) or SNS_COMPASS_MODE_ROTV (1) */
+    int32_t default_mag_bias[3];/* configured PCB hard-iron bias uT in 16.16 fixed point */
+    int has_default_mag_bias;
+
+    int32_t rotv_q[4];          /* normalized NWU quaternion (qx, qy, qz, qw) in Q30 */
+    int32_t rotv_raw_enu_milli[4]; /* last raw ENU quaternion (qx, qy, qz, qw) in milli-units */
+    int32_t rotv_acc;           /* SSC accuracy 0..3, -1 unknown */
+    int rotv_valid;
+    int32_t rotv_prev_q[4];     /* previous normalized NWU quaternion for stuck detection */
+    int32_t rotv_stuck_q[4];    /* frozen quaternion captured when quarantine tripped */
+    int rotv_has_prev;
+    int rotv_stuck;             /* 1 while akm_rotv is frozen and quarantined */
+    uint32_t rotv_gyro_stuck_cnt;
+    uint32_t rotv_grav_stuck_cnt;
+    uint32_t rotv_stuck_events; /* total times stuck watchdog tripped */
+    uint32_t rotv_resume_moved_cnt;
+    uint32_t rotv_post_bounce_skip;
+
+    int32_t mag_cal_bias[3];    /* latest raw ADSP sns_mag_cal uT in 16.16 fixed point */
+    int32_t mag_cal_acc;
+    int mag_cal_valid;
+    int mag_cal_polluted;       /* 1 if latest mag_cal was rejected or held pending verification */
+    uint32_t mag_cal_quarantine;/* clean mag samples required after disturbance before trusting new mag_cal */
+    uint32_t mag_cal_rejected;  /* total rejected/held mag_cal updates */
+
+    int32_t trusted_mag_cal_bias[3]; /* verified ADSP mag_cal bias preserved across transient acc=0 drops */
+    int32_t trusted_mag_cal_acc;
+    int has_trusted_mag_cal;
+
+    int32_t mag_cal_cand_bias[3];    /* large-shift (remagnetization) acc=3 candidate awaiting physical proof */
+    int32_t mag_cal_cand_acc;
+    int mag_cal_cand_valid;
+    int mag_cal_cand_from_disturb;
+    uint32_t mag_cal_cand_good;
+    uint32_t mag_cal_cand_turn_mdeg;
+    uint32_t mag_cal_cand_norm_mut;
+    int32_t mag_cal_cand_up_mut;
+    int mag_cal_cand_has_up;
+    int32_t mag_cal_cand_world_mut[3];
+    int mag_cal_cand_has_world;
+
+    SnsCompassPoseSnap pose_hist[SNS_COMPASS_POSE_HIST_WIN];
+    uint32_t pose_hist_count;
+    uint32_t pose_hist_pos;
+    uint32_t mag_sample_seq;
+
+    int32_t active_bias[3];     /* currently validated hard-iron bias uT in 16.16 fixed point */
+    int active_bias_src;        /* SNS_COMPASS_BIAS_NONE / _DEFAULT / _MAGCAL */
+    int prev_bias_src;          /* previous bias source applied to fusion */
+    uint32_t bias_handoff_steps;/* faster blend countdown after bias source handoff */
+
+    int32_t mag_raw[3];         /* 8-sample moving-average uT in 16.16 fixed point */
+    int32_t mag_hist[SNS_COMPASS_MAG_AVG_WIN][3];
+    int64_t mag_sum[3];
+    uint32_t mag_hist_count;
+    uint32_t mag_hist_pos;
+    int32_t mag_acc;
+    int mag_valid;
+    int32_t mag_prev_inst[3];   /* previous instantaneous raw mag uT in Q16 for stationary jump detection */
+    int has_mag_prev_inst;
+    int mag_disturbed;          /* 1 while magnetic disturbance is active or holding */
+    uint32_t mag_disturb_hold;  /* clean mag samples required before resuming mag fusion */
+    uint32_t mag_disturb_events;/* total times magnetic disturbance hold tripped */
+    uint32_t mag_disturb_reason;/* bitmask: 1=earth 2=norm 4=up 8=vec 16=jump 32=yaw */
+    uint32_t last_vec_err_mut;  /* last 3D world-frame |B_world - B_world_ref| in milli-uT */
+    uint32_t vec_anom_cnt;      /* consecutive moderate vec_err samples for noise debouncing */
+    uint32_t earth_anom_cnt;    /* consecutive marginal earth-range samples for noise debouncing */
+    int last_yaw_rejected;      /* 1 if last build_report rejected mag yaw */
+
+    uint32_t earth_ref_norm_mut;/* learned local Earth field |B| in milli-uT */
+    uint32_t earth_ref_horiz_mut;/* learned local Earth horizontal field H in milli-uT */
+    int32_t earth_ref_up_mut;   /* learned local Earth field dot(B, up) in milli-uT */
+    int earth_ref_has_up;       /* 1 once earth_ref_up_mut is initialized from steady accel */
+    uint32_t earth_ref_count;   /* clean samples accumulated into earth_ref */
+    uint32_t earth_reanchor_norm_mut;
+    uint32_t earth_reanchor_horiz_mut;
+    int32_t earth_reanchor_up_mut;
+    uint32_t earth_reanchor_count;
+
+    int32_t relock_world_mut[3];/* candidate constant 3D B_world (N,W,U) during rotation-verified relock */
+    uint32_t relock_steady_cnt; /* consecutive steady clean samples matching candidate */
+    uint32_t gyro_turn_acc_mdeg;/* accumulated gyro turn (mdeg) while relock candidate stays invariant */
+
+    uint32_t mag_innov_reject_cnt;  /* consecutive samples rejected by gyro-vs-mag yaw innovation gate */
+    uint32_t mag_innov_confirm_cnt; /* consecutive clean steady samples at a shifted yaw before relock */
+    int32_t mag_innov_cand_hdg_mdeg;
+
+    int32_t accel_ios[3];       /* g in 16.16 fixed point (face-up z = -1 g) */
+    int accel_valid;
+
+    int32_t gyro[3];            /* raw rad/s in 16.16 fixed point */
+    int32_t gyro_bias[3];       /* learned stationary ZUPT gyro zero-rate bias rad/s in 16.16 fixed point */
+    int32_t zupt_gyro_ref[3];   /* reference raw gyro during stationary stability check */
+    int32_t zupt_accel_ref[3];  /* reference accel during stationary stability check */
+    int zupt_has_ref;
+    uint32_t zupt_still_cnt;    /* consecutive stationary gyro+accel samples */
+    uint32_t zupt_learn_cnt;    /* total stationary bias learning updates applied */
+    int gyro_valid;
+
+    int32_t fallback_q[4];      /* gyro+accel+mag complementary NWU quaternion in Q30 */
+    int fallback_valid;
+    int fallback_used_mag;
+    int fallback_seeded_from_rotv;
+    uint32_t fallback_gyro_steps;
+    uint64_t last_gyro_ts;      /* SSC 19.2 MHz QTimer ticks */
+
+    int32_t last_heading_mdeg;  /* 0..359999 millidegrees */
+    int32_t last_mag_heading_mdeg;  /* instantaneous tilt-compensated mag heading, or -1 */
+    int32_t last_rotv_heading_mdeg; /* last akm_rotv heading, or -1 */
+    uint32_t emitted;
+} SnsCompass;
+
+void sns_compass_init(SnsCompass *state);
+void sns_compass_set_mode(SnsCompass *state, uint32_t mode);
+void sns_compass_set_default_mag_bias(SnsCompass *state, const int32_t bias_q16[3]);
+int sns_compass_apply_mag_bias(const SnsCompass *state, const int32_t raw_q16[3], int32_t out_q16[3]);
+int sns_compass_apply_gyro_bias(const SnsCompass *state, const int32_t raw_q16[3], int32_t out_q16[3]);
+void sns_compass_reset_session(SnsCompass *state);
+/* Parses "X,Y,Z" signed milli-uT triplet into Q16 uT. Returns 1 if nonzero, 0 if all zero, -1 on error. */
+int sns_compass_parse_mag_bias(const char *spec, int32_t out_q16[3]);
+/* Binary persistence codec for verified hard-iron bias (/private/var/db/fuxi-mag-bias.bin). */
+int sns_compass_encode_persisted_bias(const int32_t bias_q16[3], uint8_t out[SNS_COMPASS_PERSIST_BYTES]);
+int sns_compass_decode_persisted_bias(const uint8_t in[SNS_COMPASS_PERSIST_BYTES], int32_t bias_q16[3]);
+int sns_compass_load_persisted_mag_bias(SnsCompass *state, const int32_t bias_q16[3]);
+int sns_compass_get_persistable_bias(const SnsCompass *state, int32_t bias_q16[3]);
+uint32_t sns_compass_bias_drift_mut(const int32_t lhs_q16[3], const int32_t rhs_q16[3]);
+void sns_compass_set_accel(SnsCompass *state, const int32_t accel_q16[3]);
+void sns_compass_set_gyro(SnsCompass *state, const int32_t gyro_q16[3]);
+void sns_compass_set_gyro_ts(SnsCompass *state, const int32_t gyro_q16[3], uint64_t timestamp_ticks);
+void sns_compass_set_mag(SnsCompass *state, const int32_t mag_q16[3], int32_t accuracy);
+void sns_compass_set_mag_cal(SnsCompass *state, const int32_t bias_q16[3], int32_t accuracy);
+int sns_compass_set_rotv(SnsCompass *state, const uint32_t quat_bits[4], int32_t accuracy);
+void sns_compass_rotv_bounced(SnsCompass *state);
+
+/* Builds an 88-byte CMDeviceMotionReport::Compass v2 payload. Returns 0 on success, -1 if no attitude source yet. */
+int sns_compass_build_report(SnsCompass *state, uint8_t out[SNS_COMPASS_REPORT_BYTES], int32_t *heading_mdeg_out);
+
+/* Pure-integer math helpers exposed for host verification. */
+int32_t sns_compass_atan2_mdeg(int32_t y_val, int32_t x_val);
+uint32_t sns_compass_float_signed(int64_t numerator, uint64_t denominator);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsCore.c b/xnu/fuxi-sensors/SensorsCore.c
new file mode 100644
index 0000000..2d20c6d
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsCore.c
@@ -0,0 +1,1196 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The sensor manager: see SensorsCore.h. */
+#include "SensorsCore.h"
+#include "SensorsText.h"
+
+enum {
+    kResponseMs = 2000,         /* a request's response */
+    kSendRetryMs = 200,         /* the router queue was full */
+    kAttrMs = 5000,             /* the attribute event after the request */
+    kAttrTries = 3,
+    kStreamTries = 8,           /* a stream refused this often in a row is given up */
+    kBackoffMaxMs = 60000,
+    kDiscoveryMs = 15000,
+    kQuietMs = 10000,           /* no sample this long after a stream start: logged once */
+    kSummaryMs = 3600000,
+    kBudget = 300,              /* ordinary log lines per boot (pagani-sensors-log=1) */
+    kListLines = 64,
+    kIdleMaxMs = 60000,
+    kListBit = 1u << PaganiSensorKinds,
+    kOrientIntervalUs = 40000,  /* the accelerometer's slowest rate while the orientation is computed: 25 Hz */
+    kMotionMinIntervalUs = 10000,    /* cap iOS motion sensor demand at 100 Hz to avoid 200 Hz flapping */
+    kCompassMotionIntervalUs = 10000,/* 100 Hz accel+gyro while compass is active: matches akm_rotv internal rate */
+    kCompassMinIntervalUs = 20000,   /* cap rotv streaming at 50 Hz */
+    kCompassMaxIntervalUs = 100000,  /* floor rotv streaming at 10 Hz when demanded */
+    kRotvPrereqWaitMs = 3000,        /* max wait for accel+gyro+mag to start before enabling rotv */
+    kRotvBouncePauseMs = 200,        /* pause after disabling stuck rotv before re-enabling */
+    kRotvBounceCooldownMs = 10000,   /* minimum interval between automatic rotv bounces */
+    kRotvBounceMax = 5,              /* bounded automatic rotv restarts per sensor PD session */
+};
+
+static const char *const kNames[PaganiSensorKinds] = {"accel", "gyro", "mag", "light", "prox", "pressure", "rotv", "mag_cal"};
+
+const char *sns_kind_name(unsigned kind)
+{
+    return kind < PaganiSensorKinds ? kNames[kind] : "?";
+}
+
+#define CTX (c->ops->context)
+static uint64_t now(SnsCore *c) {return c->ops->now_ms(CTX);}
+
+static void zero(void *p, uint32_t n)
+{
+    uint8_t *b = (uint8_t *)p;
+    for (uint32_t i = 0; i < n; ++i) b[i] = 0;
+}
+static int same_text(const char *a, const char *b)
+{
+    uint32_t i = 0;
+    for (; a[i] && b[i]; ++i) if (a[i] != b[i]) return 0;
+    return a[i] == b[i];
+}
+static uint64_t backoff(unsigned tries)
+{
+    const unsigned shift = tries > 7 ? 6 : (tries ? tries - 1 : 0);
+    const uint64_t ms = 1000ull << shift;
+    return ms > kBackoffMaxMs ? kBackoffMaxMs : ms;
+}
+
+/* ---- the log ---- */
+static SntText *begin(SnsCore *c, SntText *t, const char *what)
+{
+    snt_start(t, c->line, sizeof c->line);
+    snt_str(t, "[sensors] ");
+    snt_str(t, what);
+    return t;
+}
+static void end(SnsCore *c)
+{
+    if (c->ops->trace) c->ops->trace(CTX, c->line);
+}
+/* An ordinary line may go out: always with pagani-sensors-log=2, never with 0, within the budget with 1. Failures do not ask. */
+static int ordinary(SnsCore *c)
+{
+    if (c->cfg.log >= 2) return 1;
+    if (!c->cfg.log || !c->budget) return 0;
+    c->budget--;
+    return 1;
+}
+static void suid_text(SntText *t, const SscSuid *s)
+{
+    snt_hex(t, s->high);
+    snt_char(t, ':');
+    snt_hex(t, s->low);
+}
+static void rate_text(SntText *t, uint32_t bits)
+{
+    snt_milli(t, sfx_milli(bits));
+}
+static void fail_line(SnsCore *c, unsigned kind, int32_t stage, int32_t error, const char *why)
+{
+    SntText t;
+    c->error = error;
+    c->failures++;
+    begin(c, &t, "FAIL");
+    snt_kd(&t, "st", -stage);
+    snt_kd(&t, "err", error);
+    if (kind < PaganiSensorKinds) snt_ks(&t, "sensor", kNames[kind]);
+    snt_char(&t, ' ');
+    snt_str(&t, why);
+    end(c);
+}
+
+/* ---- requests ---- */
+static int request(SnsCore *c, unsigned conn, const SscSuid *suid, uint32_t msg, const uint8_t *payload, uint32_t length, uint32_t tag)
+{
+    SnsConn *k = &c->conn[conn];
+    uint8_t message[160], qmi[200];
+    const uint32_t n = ssc_build_request(message, sizeof message, suid, msg, SSC_DELIVERY_WAKEUP, payload, length, -1);
+    uint16_t txn = (uint16_t)(k->next_txn + 1);
+    if (!txn) txn = 1;
+    const uint32_t q = n ? ssc_build_qmi_request(qmi, sizeof qmi, txn, message, n, 0) : 0;
+    if (!q) {
+        c->failures++;
+        return -1;
+    }
+    if (c->ops->send(CTX, conn, c->node, c->port, qmi, q)) {
+        c->refused++;
+        return -1;
+    }
+    k->next_txn = txn;
+    k->pending = 1;
+    k->pending_txn = txn;
+    k->pending_msg = msg;
+    k->pending_tag = tag;
+    k->sent_ms = now(c);
+    k->requests++;
+    c->sent++;
+    return 0;
+}
+
+/* ---- the state ---- */
+static void restart(SnsCore *c)
+{
+    for (unsigned i = 0; i < SNS_CONNS; ++i) {
+        SnsConn *k = &c->conn[i];
+        k->pending = 0;
+        k->has_client = 0;
+        k->client_id = 0;
+    }
+    for (unsigned kind = 0; kind < PaganiSensorKinds; ++kind) {
+        SnsSensor *s = &c->sensor[kind];
+        const uint32_t demand = s->demand_us, events = s->events, errors = s->errors, bad = s->bad, skipped = s->skipped;
+        zero(s, sizeof *s);
+        s->demand_us = demand;
+        s->events = events;
+        s->errors = errors;
+        s->bad = bad;
+        s->skipped = skipped;
+        ssc_attrs_clear(&s->attrs);
+    }
+    c->lookup_sent = 0;
+    c->lookup_tries = 0;
+    c->lookup_retry_at = 0;
+    c->discovery_done = c->discovery_logged = 0;
+    c->listed = 0;
+    sns_compass_init(&c->compass);
+    sns_compass_set_mode(&c->compass, c->cfg.compass_mode);
+    if (c->cfg.has_mag_bias) {
+        sns_compass_set_default_mag_bias(&c->compass, c->cfg.mag_bias_q16);
+    }
+    c->compass_first_logged = 0;
+    c->last_rotv_acc_logged = -2;
+    c->last_mcal_acc_logged = -2;
+    c->mcal_cal_logs = 0;
+    c->rotv_bounce_phase = 0;
+    c->rotv_bounce_at = 0;
+    c->rotv_bounces = 0;
+}
+
+void sns_core_init(SnsCore *c, const SnsOps *ops, const SnsConfig *config)
+{
+    zero(c, sizeof *c);
+    c->ops = ops;
+    c->cfg = *config;
+    if (!c->cfg.als_permille) c->cfg.als_permille = 1000;
+    for (unsigned i = 0; i < 3; ++i) if (!sfx_axes_valid(&c->cfg.axes[i])) sfx_axes_identity(&c->cfg.axes[i]);
+    for (unsigned i = 0; i < PaganiSensorKinds; ++i) c->cfg.type[i][SSC_TYPE_MAX - 1] = 0;
+    c->budget = kBudget;
+    c->stage = PaganiSensorsStPorts;
+    sno_init(&c->orient);
+    restart(c);
+    const uint64_t t = now(c);
+    c->wait_since = t;
+    c->reminder_at = t + 10000;
+    c->summary_at = t + kSummaryMs;
+}
+
+void sns_core_stage(SnsCore *c, int32_t stage, int32_t error)
+{
+    c->stage = stage;
+    if (error) c->error = error;
+}
+
+static void step(SnsCore *c);
+
+/* The service's transitions: the first 32 logged, then every 64th (a flapping sensor PD must not fill the log). */
+static int transition(SnsCore *c)
+{
+    c->transitions++;
+    return c->transitions <= 32 || !(c->transitions % 64);
+}
+
+void sns_core_server(SnsCore *c, int up, uint32_t node, uint32_t port, uint32_t instance, uint32_t generation)
+{
+    SntText t;
+    const uint64_t at = now(c);
+    if (up && c->up && c->node == node && c->port == port && c->instance == instance && c->generation == generation) return;
+    if (c->up) {
+        if (transition(c)) {
+            begin(c, &t, "service gone");
+            snt_kd(&t, "node", c->node);
+            snt_kx(&t, "port", c->port);
+            snt_kd(&t, "gen", c->generation);
+            snt_kd(&t, "n", c->transitions);
+            snt_str(&t, up ? "; back at once (restarted), starting over" : "; streams and SUIDs dropped");
+            end(c);
+        }
+        restart(c);
+        c->up = 0;
+        c->wait_since = at;
+        c->reminders = 0;
+        c->reminder_at = at + 10000;
+    }
+    c->generation = generation;
+    if (!up) return;
+    c->up = 1;
+    c->node = node;
+    c->port = port;
+    c->instance = instance;
+    c->discovery_started = at;
+    if (transition(c)) {
+        begin(c, &t, "service up");
+        snt_kd(&t, "node", node);
+        snt_kx(&t, "port", port);
+        snt_kx(&t, "instance", instance);
+        snt_kd(&t, "gen", generation);
+        snt_kd(&t, "waited_ms", (int64_t)(at - c->wait_since));
+        end(c);
+    }
+    step(c);
+}
+
+/* ---- the lookups ---- */
+static void discovery_line(SnsCore *c, const char *what)
+{
+    SntText t;
+    if (!ordinary(c)) return;
+    begin(c, &t, "discovery ");
+    snt_str(&t, what);
+    snt_str(&t, " found=");
+    unsigned n = 0;
+    for (unsigned k = 0; k < PaganiSensorKinds; ++k)
+        if (c->sensor[k].found) {if (n++) snt_char(&t, ','); snt_str(&t, kNames[k]);}
+    if (!n) snt_str(&t, "none");
+    snt_str(&t, " missing=");
+    n = 0;
+    for (unsigned k = 0; k < PaganiSensorKinds; ++k)
+        if (c->cfg.type[k][0] && !c->sensor[k].found) {if (n++) snt_char(&t, ','); snt_str(&t, c->cfg.type[k]);}
+    if (!n) snt_str(&t, "none");
+    snt_kd(&t, "ms", (int64_t)(now(c) - c->discovery_started));
+    end(c);
+}
+
+static void found(SnsCore *c, unsigned kind, const SscSuidEvent *e)
+{
+    SnsSensor *s = &c->sensor[kind];
+    SntText t;
+    if (!e->count) {
+        if (ordinary(c)) {begin(c, &t, "suid "); snt_str(&t, kNames[kind]); snt_ks(&t, "type", c->cfg.type[kind]); snt_str(&t, " none"); end(c);}
+        return;
+    }
+    if (s->found) {
+        s->suids = e->count + e->more;
+        if (!ssc_suid_equal(&s->suid, &e->suid[0]) && ordinary(c)) {
+            begin(c, &t, "suid ");
+            snt_str(&t, kNames[kind]);
+            snt_str(&t, " another default ");
+            suid_text(&t, &e->suid[0]);
+            snt_str(&t, " (kept the first)");
+            end(c);
+        }
+        return;
+    }
+    s->found = 1;
+    s->found_ms = now(c);
+    s->suid = e->suid[0];
+    s->suids = e->count + e->more;
+    if (ordinary(c)) {
+        begin(c, &t, "suid ");
+        snt_str(&t, kNames[kind]);
+        snt_ks(&t, "type", e->data_type);
+        snt_kd(&t, "n", s->suids);
+        snt_char(&t, ' ');
+        suid_text(&t, &s->suid);
+        end(c);
+    }
+    if (c->ops->found) c->ops->found(CTX, kind);
+}
+
+static void list_line(SnsCore *c, const SscSuidEvent *e)
+{
+    SntText t;
+    if (c->listed >= kListLines || !c->cfg.log) return;
+    c->listed++;
+    begin(c, &t, "list ");
+    snt_str(&t, e->data_type[0] ? e->data_type : "(empty)");
+    snt_kd(&t, "n", e->count + e->more);
+    for (unsigned i = 0; i < e->count && i < 2; ++i) {snt_char(&t, ' '); suid_text(&t, &e->suid[i]);}
+    end(c);
+}
+
+static void lookup_event(SnsCore *c, unsigned conn, const SscEvent *e)
+{
+    SntText t;
+    if (e->msg_id == SSC_MSG_SUID_EVENT) {
+        SscSuidEvent se;
+        if (ssc_parse_suid_event(e->payload, e->length, &se)) {c->malformed++; return;}
+        if (conn == SNS_CONN_LIST) {list_line(c, &se); return;}
+        int matched = 0;
+        for (unsigned k = 0; k < PaganiSensorKinds; ++k)
+            if (c->cfg.type[k][0] && same_text(c->cfg.type[k], se.data_type)) {matched = 1; found(c, k, &se);}
+        if (!matched) list_line(c, &se);
+    } else if (e->msg_id == SSC_MSG_SUID_DONE_EVENT) {
+        if (conn == SNS_CONN_LOOKUP && !c->discovery_done) {
+            c->discovery_done = 1;
+            discovery_line(c, "done");
+        }
+    } else if (e->msg_id == SSC_MSG_ERROR_EVENT) {
+        int64_t error = -1;
+        ssc_parse_error_event(e->payload, e->length, &error);
+        begin(c, &t, "lookup error event");
+        snt_kd(&t, "error", error);
+        snt_kd(&t, "conn", conn);
+        end(c);
+    } else {
+        c->unexpected++;
+    }
+}
+
+static void lookup_answer(SnsCore *c, unsigned tag, int ok, int timeout)
+{
+    SntText t;
+    if (ok) {
+        c->lookup_sent |= 1u << tag;
+        c->lookup_tries = 0;
+        return;
+    }
+    c->lookup_tries++;
+    c->lookup_retry_at = now(c) + backoff(c->lookup_tries);
+    if (c->lookup_tries <= 3 || !(c->lookup_tries % 16)) {
+        begin(c, &t, "suid request ");
+        snt_str(&t, tag < PaganiSensorKinds ? c->cfg.type[tag] : "(every type)");
+        snt_str(&t, timeout ? " unanswered" : " refused");
+        snt_kd(&t, "tries", c->lookup_tries);
+        end(c);
+    }
+}
+
+static void lookup_step(SnsCore *c, uint64_t t)
+{
+    uint8_t req[64];
+    if (!c->conn[SNS_CONN_LOOKUP].pending && t >= c->lookup_retry_at) {
+        for (unsigned k = 0; k < PaganiSensorKinds; ++k) {
+            if (!c->cfg.type[k][0] || (c->lookup_sent & (1u << k))) continue;
+            const int default_only = (k != PaganiSensorRotv);
+            const uint32_t n = ssc_build_suid_req(req, sizeof req, c->cfg.type[k], 1, default_only);
+            if (request(c, SNS_CONN_LOOKUP, &ssc_suid_lookup, SSC_MSG_SUID_REQ, req, n, k)) c->lookup_retry_at = t + kSendRetryMs;
+            break;
+        }
+    }
+    if (c->cfg.list && !(c->lookup_sent & kListBit) && !c->conn[SNS_CONN_LIST].pending && t >= c->lookup_retry_at) {
+        const uint32_t n = ssc_build_suid_req(req, sizeof req, "", 1, 0);
+        if (request(c, SNS_CONN_LIST, &ssc_suid_lookup, SSC_MSG_SUID_REQ, req, n, PaganiSensorKinds)) c->lookup_retry_at = t + kSendRetryMs;
+    }
+    if (!c->discovery_done && !c->discovery_logged && t - c->discovery_started >= kDiscoveryMs) {
+        c->discovery_logged = 1;
+        discovery_line(c, "not done after 15 s");
+    }
+}
+
+/* ---- the sensors ---- */
+static uint32_t pick_rate(const SnsSensor *s, uint32_t interval_us)
+{
+    uint64_t mhz = 1000000000ull / (interval_us ? interval_us : 1);
+    if (mhz < 1000) mhz = 1000;
+    if (mhz > 500000) mhz = 500000;
+    const uint32_t want = sfx_float_from_ratio(mhz, 1000);
+    if (s->attr_state != 2 || !s->attrs.rate_count) return want;
+    uint32_t best = 0, top = 0;
+    for (unsigned i = 0; i < s->attrs.rate_count; ++i) {
+        const uint32_t r = s->attrs.rates[i];
+        if (!sfx_positive(r)) continue;
+        if (r > top) top = r;
+        if (r >= want && (!best || r < best)) best = r;
+    }
+    return best ? best : top ? top : want;
+}
+
+static uint32_t pick_rotv_rate(const SnsSensor *s, uint32_t interval_us)
+{
+    uint32_t clamped_us = interval_us;
+    if (!clamped_us || clamped_us > kCompassMaxIntervalUs) clamped_us = kCompassMaxIntervalUs;
+    if (clamped_us < kCompassMinIntervalUs) clamped_us = kCompassMinIntervalUs;
+    const uint64_t mhz = 1000000000ull / clamped_us;
+    const uint32_t want = sfx_float_from_ratio(mhz, 1000);
+    if (s->attr_state != 2 || !s->attrs.rate_count) return want;
+    uint32_t low = 0, high = 0;
+    for (unsigned i = 0; i < s->attrs.rate_count; ++i) {
+        const uint32_t r = s->attrs.rates[i];
+        if (!sfx_positive(r)) continue;
+        if (!low || r < low) low = r;
+        if (r > high) high = r;
+    }
+    if (!low) return want;
+    if (s->attrs.rate_count == 2) {
+        if (want < low) return low;
+        if (want > high) return high;
+        return want;
+    }
+    const uint32_t fifty = sfx_float_from_ratio(50000, 1000);
+    uint32_t best = 0, under_cap = 0;
+    for (unsigned i = 0; i < s->attrs.rate_count; ++i) {
+        const uint32_t r = s->attrs.rates[i];
+        if (!sfx_positive(r)) continue;
+        if (r >= want && r <= fifty && (!best || r < best)) best = r;
+        if (r <= fifty && r > under_cap) under_cap = r;
+    }
+    if (best) return best;
+    if (under_cap) return under_cap;
+    return low;
+}
+
+static void desired(SnsCore *c, unsigned kind, int *want, uint32_t *rate);
+
+static int rotv_prereqs_ready(SnsCore *c, uint64_t t)
+{
+    static const unsigned kPrereqs[] = {PaganiSensorAccel, PaganiSensorGyro, PaganiSensorMag};
+    const uint64_t since = c->sensor[PaganiSensorRotv].found_ms
+        ? c->sensor[PaganiSensorRotv].found_ms
+        : c->discovery_started;
+    const int timed_out = t >= since && (t - since) >= kRotvPrereqWaitMs;
+    for (unsigned i = 0; i < 3u; ++i) {
+        const unsigned prereq_kind = kPrereqs[i];
+        if (!c->cfg.type[prereq_kind][0]) continue;
+        const SnsSensor *prereq = &c->sensor[prereq_kind];
+        if (prereq->failed) continue;
+        int prereq_want = SNS_OFF;
+        uint32_t prereq_rate = 0;
+        desired(c, prereq_kind, &prereq_want, &prereq_rate);
+        if (prereq_want == SNS_OFF) continue;
+        if (prereq->active != prereq_want ||
+            (prereq_want == SNS_STREAMING && prereq->active_rate != prereq_rate) ||
+            prereq->session_events == 0u) {
+            return timed_out ? 1 : 0;
+        }
+    }
+    return 1;
+}
+
+static void desired(SnsCore *c, unsigned kind, int *want, uint32_t *rate)
+{
+    const SnsSensor *s = &c->sensor[kind];
+    const int described = s->attr_state == 2;
+    uint32_t interval = s->demand_us;
+    *want = SNS_OFF;
+    *rate = 0;
+    switch (kind) {
+    case PaganiSensorAccel:
+    case PaganiSensorGyro:
+    case PaganiSensorMag:
+        if (interval && interval < kMotionMinIntervalUs) interval = kMotionMinIntervalUs;
+        if (c->cfg.motion_hz) {
+            const uint32_t m_us = 1000000u / c->cfg.motion_hz ? 1000000u / c->cfg.motion_hz : 1;
+            if (!interval || interval > m_us) interval = m_us;
+        }
+        if (kind == PaganiSensorAccel && c->cfg.orient && (!interval || interval > kOrientIntervalUs)) interval = kOrientIntervalUs;
+        if (c->cfg.compass && (c->compass_demand_us || c->cfg.motion_hz)) {
+            const uint32_t comp_us = (kind == PaganiSensorMag) ? kCompassMinIntervalUs : kCompassMotionIntervalUs;
+            if (!interval || interval > comp_us) interval = comp_us;
+        }
+        break;
+    case PaganiSensorLight:
+        interval = 200000;          /* always on: auto-brightness; 5 Hz if it only streams */
+        break;
+    case PaganiSensorProximity:
+        if (!c->cfg.prox_always && !s->demand_us) return;
+        interval = 200000;
+        break;
+    case PaganiSensorRotv:
+        if (!c->cfg.compass || c->rotv_bounce_phase != 0) return;
+        interval = c->compass_demand_us;
+        if (c->cfg.motion_hz) {
+            const uint32_t m_us = 1000000u / c->cfg.motion_hz ? 1000000u / c->cfg.motion_hz : 1;
+            if (!interval || m_us < interval) interval = m_us;
+        }
+        if (!interval) return;
+        if (s->active == SNS_OFF && !rotv_prereqs_ready(c, now(c))) return;
+        *want = SNS_STREAMING;
+        *rate = pick_rotv_rate(s, interval);
+        return;
+    case PaganiSensorMagCal:
+        if (!c->cfg.compass || (!c->compass_demand_us && !c->cfg.motion_hz)) return;
+        interval = 200000;
+        break;
+    default:
+        break;
+    }
+    if (!interval) return;
+    const int on_change_kind = kind == PaganiSensorLight || kind == PaganiSensorProximity || kind == PaganiSensorMagCal;
+    if (described ? s->attrs.stream_type == SSC_STREAM_ON_CHANGE : on_change_kind) {
+        *want = SNS_ON_CHANGE;
+        return;
+    }
+    *want = SNS_STREAMING;
+    *rate = pick_rate(s, interval);
+}
+
+static void stream_line(SnsCore *c, unsigned kind, const char *what)
+{
+    SnsSensor *s = &c->sensor[kind];
+    SntText t;
+    if (!ordinary(c)) return;
+    begin(c, &t, "stream ");
+    snt_str(&t, kNames[kind]);
+    snt_char(&t, ' ');
+    snt_str(&t, what);
+    if (s->active == SNS_STREAMING) {snt_str(&t, " hz="); rate_text(&t, s->active_rate);}
+    snt_kd(&t, "demand_us", s->demand_us);
+    end(c);
+}
+
+static void sensor_answer(SnsCore *c, unsigned kind, uint32_t msg, int ok, int timeout)
+{
+    SnsSensor *s = &c->sensor[kind];
+    SntText t;
+    const uint64_t at = now(c);
+    if (msg == SSC_MSG_ATTR_REQ) {
+        if (ok) return;                              /* the attributes come in an event */
+        s->attr_state = 0;
+        s->retry_at = at + backoff(s->attr_tries);
+        if (s->attr_tries >= kAttrTries) {
+            s->attr_state = 3;
+            s->retry_at = 0;
+            if (ordinary(c)) {begin(c, &t, "attr "); snt_str(&t, kNames[kind]); snt_str(&t, " refused, going on with defaults"); end(c);}
+        }
+        return;
+    }
+    if (ok) {
+        const int changed = s->active != s->requested || s->active_rate != s->requested_rate;
+        s->active = s->requested;
+        s->active_rate = s->requested_rate;
+        s->tries = 0;
+        if (s->active && (changed || !s->active_since)) {
+            s->active_since = at;
+            s->first_logged = 0;
+            s->quiet_logged = 0;
+        }
+        if (!s->active) {
+            s->active_since = 0;
+            s->hw_rate = 0;
+            if (kind == PaganiSensorRotv && c->rotv_bounce_phase == 1) {
+                c->rotv_bounce_phase = 2;
+                c->rotv_bounce_at = at + kRotvBouncePauseMs;
+            }
+        }
+        stream_line(c, kind, s->active == SNS_OFF ? "off" : s->active == SNS_ON_CHANGE ? "on change" : "on");
+        return;
+    }
+    s->tries++;
+    if (kind == PaganiSensorRotv && c->rotv_bounce_phase == 1 && s->tries >= 2) {
+        c->rotv_bounce_phase = 0;
+        c->rotv_bounce_at = at + kRotvBounceCooldownMs;
+    }
+    if (s->tries >= kStreamTries) {
+        s->failed = 1;
+        fail_line(c, kind, PaganiSensorsStStreaming, timeout ? PaganiSensorsErrTimeout : PaganiSensorsErrRefused,
+                  "stream request refused every time; given up until the service restarts");
+        return;
+    }
+    s->retry_at = at + backoff(s->tries);
+    if (s->tries <= 2) {
+        begin(c, &t, "stream ");
+        snt_str(&t, kNames[kind]);
+        snt_str(&t, timeout ? " request unanswered" : " request refused");
+        snt_kd(&t, "msg", msg);
+        snt_kd(&t, "tries", s->tries);
+        end(c);
+    }
+}
+
+static void sensor_step(SnsCore *c, unsigned kind, uint64_t t)
+{
+    SnsSensor *s = &c->sensor[kind];
+    SnsConn *k = &c->conn[1 + kind];
+    SntText line;
+    if (!s->found || s->failed || k->pending) return;
+    if (s->attr_state == 1) {
+        if (t < s->attr_deadline) return;
+        s->attr_state = s->attr_tries >= kAttrTries ? 3 : 0;
+        if (s->attr_state == 3 && ordinary(c)) {
+            begin(c, &line, "attr ");
+            snt_str(&line, kNames[kind]);
+            snt_str(&line, " no attribute event, going on with defaults");
+            end(c);
+        }
+    }
+    if (t < s->retry_at) return;
+    if (s->attr_state == 0) {
+        if (request(c, 1 + kind, &s->suid, SSC_MSG_ATTR_REQ, 0, 0, 0)) {s->retry_at = t + kSendRetryMs; return;}
+        s->attr_tries++;
+        s->attr_state = 1;
+        s->attr_deadline = t + kAttrMs;
+        return;
+    }
+    if (c->cfg.mode < 3) return;
+    if (kind == PaganiSensorRotv) {
+        if (c->rotv_bounce_phase == 1 && s->active == SNS_OFF) {
+            c->rotv_bounce_phase = 2;
+            c->rotv_bounce_at = t + kRotvBouncePauseMs;
+        }
+        if (c->rotv_bounce_phase == 2 && t >= c->rotv_bounce_at) {
+            c->rotv_bounce_phase = 0;
+            c->rotv_bounces++;
+            c->rotv_bounce_at = t + kRotvBounceCooldownMs;
+            sns_compass_rotv_bounced(&c->compass);
+            begin(c, &line, "rotv bounce restart");
+            snt_kd(&line, "n", c->rotv_bounces);
+            end(c);
+        }
+    }
+    desired(c, kind, &s->want, &s->want_rate);
+    if (s->want == s->active && (s->want != SNS_STREAMING || s->want_rate == s->active_rate)) return;
+    int rc;
+    if (s->want == SNS_OFF) {
+        rc = request(c, 1 + kind, &s->suid, SSC_MSG_DISABLE_REQ, 0, 0, 0);
+    } else if (s->want == SNS_ON_CHANGE) {
+        rc = request(c, 1 + kind, &s->suid, SSC_MSG_ON_CHANGE_CONFIG, 0, 0, 0);
+    } else {
+        uint8_t config[16];
+        const uint32_t n = ssc_build_sensor_config(config, sizeof config, s->want_rate);
+        rc = request(c, 1 + kind, &s->suid, SSC_MSG_SENSOR_CONFIG, config, n, 0);
+    }
+    if (rc) {s->retry_at = t + kSendRetryMs; return;}
+    s->requested = s->want;
+    s->requested_rate = s->want == SNS_STREAMING ? s->want_rate : 0;
+}
+
+static void attr_line(SnsCore *c, unsigned kind)
+{
+    const SscAttrs *a = &c->sensor[kind].attrs;
+    SntText t;
+    if (!ordinary(c)) return;
+    begin(c, &t, "attr ");
+    snt_str(&t, kNames[kind]);
+    snt_ks(&t, "name", a->name[0] ? a->name : "?");
+    snt_ks(&t, "vendor", a->vendor[0] ? a->vendor : "?");
+    if (a->type[0]) snt_ks(&t, "type", a->type);
+    snt_kd(&t, "avail", a->available);
+    snt_kd(&t, "phys", a->physical);
+    snt_kd(&t, "stream", a->stream_type);
+    if (a->rate_count) {
+        snt_str(&t, " hz=");
+        for (unsigned i = 0; i < a->rate_count && i < 6; ++i) {if (i) snt_char(&t, ','); rate_text(&t, a->rates[i]);}
+    }
+    if (a->range_count) {
+        snt_str(&t, " range=");
+        rate_text(&t, a->ranges[0][0]);
+        snt_str(&t, "..");
+        rate_text(&t, a->ranges[0][1]);
+    }
+    if (a->resolution_count) {snt_str(&t, " res="); rate_text(&t, a->resolutions[0]);}
+    if (a->rigid_count) snt_kd(&t, "rigid", a->rigid_body[0]);
+    if (a->hw_id >= 0) snt_kd(&t, "hw", a->hw_id);
+    if (a->version >= 0) snt_kx(&t, "ver", (uint64_t)a->version);
+    end(c);
+}
+
+static void sample_line(SnsCore *c, const SnsSample *s, const char *what)
+{
+    SntText t;
+    begin(c, &t, what);
+    snt_char(&t, ' ');
+    snt_str(&t, kNames[s->kind]);
+    if (s->kind == PaganiSensorProximity) {
+        snt_ks(&t, "state", s->value[0] ? "near" : "far");
+        snt_kd(&t, "adc", s->value[1]);
+    } else {
+        const unsigned n = s->kind <= PaganiSensorMag ? 3 : 1;
+        for (unsigned i = 0; i < n; ++i) {snt_char(&t, ' '); snt_milli(&t, s->milli[i]);}
+        if (s->kind == PaganiSensorLight) snt_kd(&t, "lux", s->value[0]);
+    }
+    snt_kd(&t, "acc", s->status);
+    snt_kx(&t, "ts", s->timestamp);
+    end(c);
+}
+
+static void deliver(SnsCore *c, SnsSensor *s, const SnsSample *sample)
+{
+    s->events++;
+    s->session_events++;
+    s->sample_ms = now(c);
+    s->last = *sample;
+    if (c->ops->sample) c->ops->sample(CTX, sample);
+    if (!s->first_logged && (c->cfg.log >= 2 || ordinary(c))) {
+        s->first_logged = 1;
+        sample_line(c, sample, "first");
+    }
+}
+
+static void emit_compass(SnsCore *c, uint64_t timestamp, int from_rotv)
+{
+    uint8_t report[SNS_COMPASS_REPORT_BYTES];
+    int32_t heading_mdeg = 0;
+    if (sns_compass_build_report(&c->compass, report, &heading_mdeg) != 0) return;
+    c->compass_events++;
+    if (c->ops->compass) c->ops->compass(CTX, timestamp, report, heading_mdeg);
+    if (!c->compass_first_logged && (c->cfg.log >= 2 || ordinary(c))) {
+        SntText t;
+        const char *bsrc = (c->compass.active_bias_src == SNS_COMPASS_BIAS_MAGCAL) ? "mcal"
+            : (c->compass.active_bias_src == SNS_COMPASS_BIAS_DEFAULT) ? "pcb" : "none";
+        c->compass_first_logged = 1;
+        begin(c, &t, "first compass");
+        snt_kd(&t, "hdg", heading_mdeg / 1000);
+        snt_ks(&t, "src", from_rotv ? "rotv" : "fus");
+        snt_ks(&t, "bsrc", bsrc);
+        snt_kd(&t, "mhdg", c->compass.last_mag_heading_mdeg >= 0 ? c->compass.last_mag_heading_mdeg / 1000 : -1);
+        snt_kd(&t, "rotv", from_rotv);
+        snt_kd(&t, "racc", c->compass.rotv_acc);
+        snt_kd(&t, "mcal", c->compass.mag_cal_acc);
+        snt_kx(&t, "ts", timestamp);
+        end(c);
+    }
+}
+
+static void rotv_event(SnsCore *c, const SscEvent *e)
+{
+    SnsSensor *s = &c->sensor[PaganiSensorRotv];
+    SscSensorEvent ev;
+    const int was_stuck = c->compass.rotv_stuck;
+    if (ssc_parse_sensor_event(e->payload, e->length, &ev)) {s->bad++; c->malformed++; return;}
+    if (ev.count < 4u) {s->bad++; return;}
+    if (sns_compass_set_rotv(&c->compass, ev.data, (int32_t)ev.status) != 0) {s->bad++; return;}
+    s->events++;
+    s->session_events++;
+    s->sample_ms = now(c);
+    if (c->cfg.compass_mode == SNS_COMPASS_MODE_ROTV && !was_stuck && c->compass.rotv_stuck) {
+        if (c->compass.rotv_stuck_events <= 8u || c->cfg.log >= 2u) {
+            SntText t;
+            begin(c, &t, "rotv stuck");
+            snt_kd(&t, "n", c->compass.rotv_stuck_events);
+            snt_kd(&t, "gyro", c->compass.rotv_gyro_stuck_cnt);
+            snt_kd(&t, "grav", c->compass.rotv_grav_stuck_cnt);
+            snt_kd(&t, "hw_a", sfx_milli(c->sensor[PaganiSensorAccel].hw_rate) / 1000);
+            snt_kd(&t, "hw_g", sfx_milli(c->sensor[PaganiSensorGyro].hw_rate) / 1000);
+            end(c);
+        }
+        if (c->rotv_bounce_phase == 0 && c->rotv_bounces < kRotvBounceMax && s->sample_ms >= c->rotv_bounce_at) {
+            c->rotv_bounce_phase = 1;
+        }
+    } else if (c->cfg.compass_mode == SNS_COMPASS_MODE_ROTV && was_stuck && !c->compass.rotv_stuck) {
+        SntText t;
+        begin(c, &t, "rotv recovered");
+        snt_kd(&t, "bounces", c->rotv_bounces);
+        snt_kd(&t, "acc", ev.status);
+        end(c);
+    }
+    if (!s->first_logged && (c->cfg.log >= 2 || ordinary(c))) {
+        SntText t;
+        s->first_logged = 1;
+        c->last_rotv_acc_logged = (int32_t)ev.status;
+        begin(c, &t, "first rotv");
+        for (unsigned i = 0; i < 4u; ++i) {snt_char(&t, ' '); snt_milli(&t, sfx_milli(ev.data[i]));}
+        snt_kd(&t, "acc", ev.status);
+        snt_kx(&t, "ts", e->timestamp);
+        end(c);
+    } else if (s->first_logged && (int32_t)ev.status != c->last_rotv_acc_logged && ordinary(c)) {
+        SntText t;
+        c->last_rotv_acc_logged = (int32_t)ev.status;
+        begin(c, &t, "rotv acc");
+        for (unsigned i = 0; i < 4u; ++i) {snt_char(&t, ' '); snt_milli(&t, sfx_milli(ev.data[i]));}
+        snt_kd(&t, "acc", ev.status);
+        snt_kx(&t, "ts", e->timestamp);
+        end(c);
+    }
+    if (c->cfg.compass && c->cfg.compass_mode == SNS_COMPASS_MODE_ROTV &&
+        (c->compass_demand_us || c->cfg.motion_hz)) {
+        if (c->compass.rotv_valid) {
+            emit_compass(c, e->timestamp, 1);
+        } else if (c->sensor[PaganiSensorMag].active == SNS_OFF) {
+            emit_compass(c, e->timestamp, 0);
+        }
+    }
+}
+
+static void cal_event(SnsCore *c, const SscEvent *e)
+{
+    SnsSensor *s = &c->sensor[PaganiSensorMagCal];
+    SscCalEvent ev;
+    if (ssc_parse_cal_event(e->payload, e->length, &ev)) {s->bad++; c->malformed++; return;}
+    if (ev.count < 3u) {s->bad++; return;}
+    int32_t raw_bias[3], mapped_bias[3];
+    for (unsigned i = 0; i < 3u; ++i) raw_bias[i] = sfx_fixed(ev.bias[i]);
+    sfx_axes_apply(&c->cfg.axes[PaganiSensorMag], raw_bias, mapped_bias);
+    sns_compass_set_mag_cal(&c->compass, mapped_bias, (int32_t)ev.status);
+    s->events++;
+    s->sample_ms = now(c);
+    if (!s->first_logged && (c->cfg.log >= 2 || ordinary(c))) {
+        SntText t;
+        s->first_logged = 1;
+        c->last_mcal_acc_logged = (int32_t)ev.status;
+        if (ev.status >= 1) c->mcal_cal_logs++;
+        begin(c, &t, "first mag_cal");
+        for (unsigned i = 0; i < 3u; ++i) {snt_char(&t, ' '); snt_milli(&t, sfx_milli(ev.bias[i]));}
+        snt_kd(&t, "acc", ev.status);
+        snt_kd(&t, "rej", c->compass.mag_cal_polluted);
+        snt_kx(&t, "ts", e->timestamp);
+        end(c);
+    } else if (s->first_logged &&
+               ((int32_t)ev.status != c->last_mcal_acc_logged || (ev.status >= 1 && c->mcal_cal_logs < 32u)) &&
+               ordinary(c)) {
+        SntText t;
+        c->last_mcal_acc_logged = (int32_t)ev.status;
+        if (ev.status >= 1) c->mcal_cal_logs++;
+        begin(c, &t, "mag_cal");
+        for (unsigned i = 0; i < 3u; ++i) {snt_char(&t, ' '); snt_milli(&t, sfx_milli(ev.bias[i]));}
+        snt_kd(&t, "acc", ev.status);
+        snt_kd(&t, "rej", c->compass.mag_cal_polluted);
+        snt_kx(&t, "ts", e->timestamp);
+        end(c);
+    }
+}
+
+static void data_event(SnsCore *c, unsigned kind, const SscEvent *e)
+{
+    SnsSensor *s = &c->sensor[kind];
+    SscSensorEvent ev;
+    SnsSample out;
+    zero(&out, sizeof out);
+    out.kind = kind;
+    out.timestamp = e->timestamp;
+    if (ssc_parse_sensor_event(e->payload, e->length, &ev)) {s->bad++; c->malformed++; return;}
+    out.status = (int32_t)ev.status;
+    const unsigned need = kind <= PaganiSensorMag ? 3 : 1;
+    if (ev.count < need) {s->bad++; return;}
+    for (unsigned i = 0; i < need; ++i) out.milli[i] = sfx_milli(ev.data[i]);
+    if (kind <= PaganiSensorMag) {
+        int32_t v[3];
+        for (unsigned i = 0; i < 3; ++i) v[i] = kind == PaganiSensorAccel ? sfx_accel_ios(ev.data[i]) : sfx_fixed(ev.data[i]);
+        sfx_axes_apply(&c->cfg.axes[kind], v, out.value);
+    } else if (kind == PaganiSensorLight) {
+        out.value[0] = (int32_t)sfx_lux(ev.data[0], c->cfg.als_permille);
+        out.value[1] = ev.count > 1 ? (int32_t)sfx_scale(ev.data[1], 1, 1, 0, -0x7fffffffll, 0x7fffffffll) : 0;
+    } else if (kind == PaganiSensorPressure) {
+        out.value[0] = sfx_pressure_kpa(ev.data[0]);
+    } else {
+        s->skipped++;
+        return;
+    }
+    if (c->cfg.compass && kind == PaganiSensorGyro) {
+        sns_compass_set_gyro_ts(&c->compass, out.value, e->timestamp);
+        if (c->cfg.compass_mode == SNS_COMPASS_MODE_FUSION) {
+            (void)sns_compass_apply_gyro_bias(&c->compass, out.value, out.value);
+        }
+    } else if (c->cfg.compass && kind == PaganiSensorMag) {
+        sns_compass_set_mag(&c->compass, out.value, out.status);
+        if (c->cfg.compass_mode == SNS_COMPASS_MODE_FUSION) {
+            (void)sns_compass_apply_mag_bias(&c->compass, out.value, out.value);
+        }
+    }
+    deliver(c, s, &out);
+    if (kind == PaganiSensorAccel && c->cfg.orient) {
+        const int state = sno_update(&c->orient, out.value[0], out.value[1], out.value[2], now(c));
+        if (state >= 0 && c->ops->orientation) c->ops->orientation(CTX, state);
+    }
+    if (c->cfg.compass) {
+        if (kind == PaganiSensorAccel) {
+            sns_compass_set_accel(&c->compass, out.value);
+            if (c->cfg.compass_mode == SNS_COMPASS_MODE_FUSION &&
+                c->sensor[PaganiSensorMag].active == SNS_OFF &&
+                (c->compass_demand_us || c->cfg.motion_hz)) {
+                emit_compass(c, e->timestamp, 0);
+            }
+        } else if (kind == PaganiSensorMag) {
+            if ((c->cfg.compass_mode == SNS_COMPASS_MODE_FUSION || !c->compass.rotv_valid) &&
+                c->compass.accel_valid &&
+                (c->compass_demand_us || c->cfg.motion_hz)) {
+                emit_compass(c, e->timestamp, 0);
+            }
+        }
+    }
+}
+
+static void proximity_event(SnsCore *c, const SscEvent *e)
+{
+    SnsSensor *s = &c->sensor[PaganiSensorProximity];
+    SscProximityEvent ev;
+    SnsSample out;
+    if (ssc_parse_proximity_event(e->payload, e->length, &ev)) {s->bad++; c->malformed++; return;}
+    zero(&out, sizeof out);
+    out.kind = PaganiSensorProximity;
+    out.timestamp = e->timestamp;
+    out.value[0] = ev.type == SSC_PROXIMITY_NEAR;
+    out.value[1] = ev.raw_adc > 0x7fffffffu ? 0x7fffffff : (int32_t)ev.raw_adc;
+    out.milli[0] = out.value[0] * 1000;
+    out.status = (int32_t)ev.status;
+    const int changed = s->events && s->last.value[0] != out.value[0];
+    deliver(c, s, &out);
+    if (changed && c->cfg.log >= 2) sample_line(c, &out, "prox");
+}
+
+static void sensor_event(SnsCore *c, unsigned kind, const SscEvent *e)
+{
+    SnsSensor *s = &c->sensor[kind];
+    SntText t;
+    switch (e->msg_id) {
+    case SSC_MSG_ATTR_EVENT:
+        ssc_attrs_clear(&s->attrs);
+        if (ssc_parse_attr_event(e->payload, e->length, &s->attrs)) {c->malformed++; s->attr_state = 3; return;}
+        s->attr_state = 2;
+        s->retry_at = 0;
+        attr_line(c, kind);
+        if (s->attrs.available == 0) {
+            s->failed = 1;
+            fail_line(c, kind, PaganiSensorsStDescribed, PaganiSensorsErrOff, "the hub says the sensor is not available");
+        }
+        return;
+    case SSC_MSG_ERROR_EVENT: {
+        int64_t error = -1;
+        ssc_parse_error_event(e->payload, e->length, &error);
+        s->errors++;
+        if (s->errors <= 4 || c->cfg.log >= 2) {
+            begin(c, &t, "error event ");
+            snt_str(&t, kNames[kind]);
+            snt_kd(&t, "error", error);
+            snt_kd(&t, "n", s->errors);
+            end(c);
+        }
+        return;
+    }
+    case SSC_MSG_PHYSICAL_CONFIG_EVENT: {
+        SscPhysicalConfig pc;
+        if (ssc_parse_physical_config(e->payload, e->length, &pc)) {c->malformed++; return;}
+        const uint32_t prev_rate = s->hw_rate;
+        s->hw_rate = pc.sample_rate;
+        if ((!prev_rate || pc.sample_rate != prev_rate) && ordinary(c)) {
+            begin(c, &t, "hw ");
+            snt_str(&t, kNames[kind]);
+            snt_str(&t, " hz=");
+            rate_text(&t, pc.sample_rate);
+            if (pc.range_count == 2) {snt_str(&t, " range="); rate_text(&t, pc.range[0]); snt_str(&t, ".."); rate_text(&t, pc.range[1]);}
+            if (pc.op_mode[0]) snt_ks(&t, "mode", pc.op_mode);
+            snt_kd(&t, "wm", pc.water_mark);
+            snt_kd(&t, "dri", pc.dri);
+            end(c);
+        }
+        return;
+    }
+    case SSC_MSG_SENSOR_EVENT:
+        if (kind == PaganiSensorProximity || kind == PaganiSensorMagCal) {s->skipped++; return;}
+        if (kind == PaganiSensorRotv) {rotv_event(c, e); return;}
+        data_event(c, kind, e);
+        return;
+    case SSC_MSG_CAL_EVENT:
+        if (kind == PaganiSensorMagCal) cal_event(c, e);
+        else s->skipped++;
+        return;
+    case SSC_MSG_PROXIMITY_EVENT:
+    case SSC_MSG_PROXIMITY_RECURRENT:
+        if (kind == PaganiSensorProximity) proximity_event(c, e);
+        else s->skipped++;
+        return;
+    default:
+        s->skipped++;   /* flush, resampler and calibration events, the hub's own extras */
+        return;
+    }
+}
+
+/* ---- QMI ---- */
+static void response(SnsCore *c, unsigned conn, const SscQmi *m)
+{
+    SnsConn *k = &c->conn[conn];
+    SscResponse r;
+    if (!k->pending || m->transaction != k->pending_txn) {c->unexpected++; return;}
+    k->pending = 0;
+    k->responses++;
+    c->responses++;
+    const int parsed = !ssc_qmi_response(m, &r);
+    if (parsed && r.has_client) {k->has_client = 1; k->client_id = r.client_id;}
+    const int ok = parsed && ssc_response_ok(&r);
+    if (!ok) {k->refused++; c->refused++;}
+    if (conn == SNS_CONN_LOOKUP || conn == SNS_CONN_LIST) lookup_answer(c, k->pending_tag, ok, 0);
+    else sensor_answer(c, conn - 1, k->pending_msg, ok, 0);
+}
+
+static void report(SnsCore *c, unsigned conn, const SscQmi *m)
+{
+    SnsConn *k = &c->conn[conn];
+    int has_client = 0, r;
+    uint64_t client = 0;
+    const uint8_t *message = 0;
+    uint32_t length = 0;
+    SscEvents events;
+    SscEvent e;
+    if (ssc_qmi_report(m, &has_client, &client, &message, &length) || ssc_events_open(&events, message, length)) {c->malformed++; return;}
+    k->reports++;
+    c->reports++;
+    if (has_client && k->has_client && client != k->client_id) c->unexpected++;
+    if (conn == SNS_CONN_LOOKUP || conn == SNS_CONN_LIST) {
+        if (events.has_suid && !ssc_suid_equal(&events.suid, &ssc_suid_lookup)) {c->unexpected++; return;}
+        while ((r = ssc_events_next(&events, &e)) == 1) lookup_event(c, conn, &e);
+        if (r < 0) c->malformed++;
+        return;
+    }
+    const unsigned kind = conn - 1;
+    SnsSensor *s = &c->sensor[kind];
+    if (!s->found || (events.has_suid && !ssc_suid_equal(&events.suid, &s->suid))) {c->unexpected++; return;}
+    while ((r = ssc_events_next(&events, &e)) == 1) sensor_event(c, kind, &e);
+    if (r < 0) c->malformed++;
+}
+
+void sns_core_receive(SnsCore *c, unsigned conn, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length)
+{
+    SscQmi m;
+    if (conn >= SNS_CONNS) return;
+    if (!c->up || node != c->node || port != c->port) {c->stale++; return;}
+    if (ssc_qmi_parse(data, length, &m)) {c->malformed++; return;}
+    if (m.type == SSC_QMI_RESPONSE && m.message == SSC_QMI_REQ) response(c, conn, &m);
+    else if (m.type == SSC_QMI_INDICATION && (m.message == SSC_QMI_REPORT || m.message == SSC_QMI_JUMBO_REPORT)) report(c, conn, &m);
+    else c->unexpected++;
+    step(c);
+}
+
+void sns_core_demand(SnsCore *c, unsigned kind, uint32_t interval_us)
+{
+    if (kind >= PaganiSensorKinds) return;
+    SnsSensor *s = &c->sensor[kind];
+    if (s->demand_us == interval_us) {
+        if (kind == PaganiSensorProximity && interval_us && s->active && s->events && c->ops->sample) c->ops->sample(CTX, &s->last);
+        return;
+    }
+    s->demand_us = interval_us;
+    step(c);
+}
+
+void sns_core_compass_demand(SnsCore *c, uint32_t interval_us)
+{
+    if (c->compass_demand_us == interval_us) return;
+    const uint32_t prev = c->compass_demand_us;
+    c->compass_demand_us = interval_us;
+    if (prev == 0u && interval_us != 0u && !c->cfg.motion_hz && c->cfg.compass) {
+        sns_compass_reset_session(&c->compass);
+    }
+    step(c);
+}
+
+/* ---- time ---- */
+static void timeouts(SnsCore *c, uint64_t t)
+{
+    for (unsigned i = 0; i < SNS_CONNS; ++i) {
+        SnsConn *k = &c->conn[i];
+        if (!k->pending || t - k->sent_ms < kResponseMs) continue;
+        k->pending = 0;
+        k->timeouts++;
+        if (i == SNS_CONN_LOOKUP || i == SNS_CONN_LIST) lookup_answer(c, k->pending_tag, 0, 1);
+        else sensor_answer(c, i - 1, k->pending_msg, 0, 1);
+    }
+}
+
+static void quiet(SnsCore *c, uint64_t t)
+{
+    SntText line;
+    for (unsigned kind = 0; kind < PaganiSensorKinds; ++kind) {
+        SnsSensor *s = &c->sensor[kind];
+        if (!s->active || !s->active_since || s->quiet_logged || t - s->active_since < kQuietMs) continue;
+        s->quiet_logged = 1;
+        if (s->sample_ms >= s->active_since) continue;   /* samples came */
+        begin(c, &line, "stream ");
+        snt_str(&line, kNames[kind]);
+        snt_str(&line, " accepted but no sample in 10 s");
+        snt_kd(&line, "errors", s->errors);
+        snt_kd(&line, "skipped", s->skipped);
+        end(c);
+    }
+}
+
+static void summary(SnsCore *c)
+{
+    SntText t;
+    begin(c, &t, "summary");
+    snt_kd(&t, "up", c->up);
+    for (unsigned k = 0; k < PaganiSensorKinds; ++k) snt_kd(&t, kNames[k], c->sensor[k].events);
+    snt_kd(&t, "reports", c->reports);
+    snt_kd(&t, "refused", c->refused);
+    snt_kd(&t, "malformed", c->malformed);
+    snt_kd(&t, "stale", c->stale);
+    snt_kd(&t, "unexpected", c->unexpected);
+    end(c);
+}
+
+static void step(SnsCore *c)
+{
+    const uint64_t t = now(c);
+    if (t >= c->summary_at) {
+        c->summary_at = t + kSummaryMs;
+        if (c->reports || c->up) summary(c);
+    }
+    if (!c->up) {
+        if (t >= c->reminder_at) {
+            SntText line;
+            static const uint32_t next[] = {50000, 240000, 1500000};
+            begin(c, &line, "waiting for the sensor client service (400)");
+            snt_kd(&line, "s", (int64_t)((t - c->wait_since) / 1000));
+            end(c);
+            c->reminder_at = t + (c->reminders < 3 ? next[c->reminders] : 1800000u);
+            c->reminders++;
+        }
+        return;
+    }
+    timeouts(c, t);
+    lookup_step(c, t);
+    for (unsigned kind = 0; kind < PaganiSensorKinds; ++kind) sensor_step(c, kind, t);
+    quiet(c, t);
+}
+
+void sns_core_tick(SnsCore *c)
+{
+    step(c);
+}
+
+uint32_t sns_core_idle_ms(SnsCore *c)
+{
+    const uint64_t t = now(c);
+    uint64_t next = t + kIdleMaxMs;
+#define SOONER(at) do {if ((at) && (at) < next) next = (at);} while (0)
+    SOONER(c->summary_at);
+    if (!c->up) {
+        SOONER(c->reminder_at);
+    } else {
+        for (unsigned i = 0; i < SNS_CONNS; ++i) if (c->conn[i].pending) SOONER(c->conn[i].sent_ms + kResponseMs);
+        if (c->lookup_retry_at > t) SOONER(c->lookup_retry_at);
+        if (!c->discovery_done && !c->discovery_logged) SOONER(c->discovery_started + kDiscoveryMs);
+        for (unsigned k = 0; k < PaganiSensorKinds; ++k) {
+            const SnsSensor *s = &c->sensor[k];
+            if (!s->found || s->failed) continue;
+            if (s->attr_state == 1) SOONER(s->attr_deadline);
+            if (s->retry_at > t) SOONER(s->retry_at);
+            if (s->active && s->active_since && !s->quiet_logged) SOONER(s->active_since + kQuietMs);
+        }
+        if (c->rotv_bounce_phase == 2 && c->rotv_bounce_at > t) SOONER(c->rotv_bounce_at);
+        const SnsSensor *rotv = &c->sensor[PaganiSensorRotv];
+        if (c->cfg.compass && c->cfg.mode >= 3 && rotv->found && !rotv->failed &&
+            rotv->attr_state >= 2 && rotv->active == SNS_OFF && c->rotv_bounce_phase == 0 &&
+            (c->compass_demand_us || c->cfg.motion_hz)) {
+            const uint64_t wait_until = (rotv->found_ms ? rotv->found_ms : c->discovery_started) + kRotvPrereqWaitMs;
+            if (wait_until > t) SOONER(wait_until);
+        }
+    }
+#undef SOONER
+    if (next <= t) return 1;
+    return (uint32_t)(next - t);
+}
+
+void sns_core_status(const SnsCore *c, PaganiSensorsStatus *out)
+{
+    int32_t stage = c->stage;
+    if (stage >= PaganiSensorsStPorts) {
+        stage = c->up ? PaganiSensorsStService : PaganiSensorsStPorts;
+        for (unsigned k = 0; k < PaganiSensorKinds; ++k) {
+            const SnsSensor *s = &c->sensor[k];
+            if (s->found && stage < PaganiSensorsStDiscovered) stage = PaganiSensorsStDiscovered;
+            if (s->attr_state == 2 && stage < PaganiSensorsStDescribed) stage = PaganiSensorsStDescribed;
+            if (s->active && stage < PaganiSensorsStStreaming) stage = PaganiSensorsStStreaming;
+            if (s->active && s->events && stage < PaganiSensorsStData) stage = PaganiSensorsStData;
+        }
+    }
+    out->stage = stage;
+    out->error = c->error;
+    out->mode = c->cfg.mode;
+    out->node = c->up ? c->node : 0;
+    out->port = c->up ? c->port : 0;
+    out->instance = c->up ? c->instance : 0;
+    out->found = out->described = out->streaming = 0;
+    for (unsigned k = 0; k < PaganiSensorKinds; ++k) {
+        const SnsSensor *s = &c->sensor[k];
+        if (s->found) out->found |= 1u << k;
+        if (s->attr_state == 2) out->described |= 1u << k;
+        if (s->active) out->streaming |= 1u << k;
+        out->events[k] = s->events;
+    }
+    out->requests = c->sent;
+    out->responses = c->responses;
+    out->refused = c->refused;
+    out->reports = c->reports;
+    out->malformed = c->malformed;
+}
diff --git a/xnu/fuxi-sensors/SensorsCore.h b/xnu/fuxi-sensors/SensorsCore.h
new file mode 100644
index 0000000..fd5e738
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsCore.h
@@ -0,0 +1,168 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The sensor manager: portable C over a table of operations (PaganiSensors.cpp gives the kernel ones, Test/core.c a simulated sensor hub
+ * and router), single threaded (the driver's own thread). It is a client of the sensor client service (SensorsSsc.h) on one IPC router
+ * connection for the lookups (connection 0) and one per sensor (connection 1 + kind, as Android's HAL and libssc keep one per sensor):
+ *
+ *   service    waits for service 400 (any instance); a service that goes, or comes back with a new generation (a restarted sensor
+ *              PD), starts everything over; reminders in the log at 10 s, 60 s, 5 min, then every 30 min while it is missing
+ *   lookup     one SUID request per data type (register_updates, default_only, APSS, wakeup delivery; the answers may come any time
+ *              later, also after the discovery-done event: the hub reports late sensors), optionally one for every data type (the list)
+ *   attributes per sensor found: an attribute request (msg 1) on its connection, the attribute event read (5 s, three tries, then the
+ *              sensor goes on with defaults)
+ *   streams    (mode 3) what iOS asks for: the motion sensors at the rate iOS asks (the attribute rates' first at or above it) or
+ *              off, ambient light always (on change), proximity while iOS has a detection mode; changes become new config requests
+ *              (513 with the rate, 514 on change, 10 disable) on the sensor's connection
+ *   samples    1025 (sensor event), 769/1031 (proximity) converted to iOS units (SensorsFixed.h) with the axis maps, given to the glue;
+ *              with the orientation on, the accelerometer always streams (at least 25 Hz) and its samples feed SensorsOrient.h
+ *
+ * One request is outstanding per connection: the next goes out after the response (2 s timeout); a refused request is tried again after
+ * 1, 2, 4 ... 60 s, a stream refused 8 times in a row is given up until the service restarts. Everything is logged as "[sensors] ..."
+ * lines, rationed (a budget of lines per boot, then failures and an hourly summary only). */
+#ifndef SENSORS_CORE_H
+#define SENSORS_CORE_H
+#include <stdint.h>
+#include "PaganiSensors.h"
+#include "SensorsCompass.h"
+#include "SensorsFixed.h"
+#include "SensorsOrient.h"
+#include "SensorsSsc.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Connections: 0 the SUID lookups, 1 + kind each sensor's, then the list of every data type (diagnostic, never used to pick a sensor). */
+enum {SNS_CONN_LOOKUP = 0, SNS_CONN_LIST = 1 + PaganiSensorKinds, SNS_CONNS = 2 + PaganiSensorKinds};
+enum {SNS_OFF = 0, SNS_ON_CHANGE = 1, SNS_STREAMING = 2};
+
+typedef struct {
+    unsigned kind;
+    uint64_t timestamp;          /* the hub's (QTimer, 19.2 MHz ticks) */
+    int32_t value[3];            /* iOS units: 16.16 g, rad/s, uT; 16.16 kPa in [0]; lux in [0] (raw count in [1]); proximity 1 near */
+    int32_t milli[3];            /* the hub's own units x 1000 (m/s^2, rad/s, uT, hPa, lux), unmapped, for the log */
+    int32_t status;              /* accuracy 0..3, -1 not given */
+} SnsSample;
+
+typedef struct {
+    void *context;
+    uint64_t (*now_ms)(void *context);
+    /* One QMI message on connection conn to node:port. 0 when queued, nonzero when refused (the request then counts as failed). */
+    int (*send)(void *context, unsigned conn, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length);
+    void (*trace)(void *context, const char *line);
+    void (*sample)(void *context, const SnsSample *s);
+    /* A sensor's SUID is known (the glue may then publish an iOS service it only publishes for present hardware, e.g. pressure). */
+    void (*found)(void *context, unsigned kind);
+    /* The device orientation changed (SensorsOrient.h; only with SnsConfig.orient). */
+    void (*orientation)(void *context, int state);
+    /* Fused device-motion compass report (SensorsCompass.h; only with SnsConfig.compass). */
+    void (*compass)(void *context, uint64_t timestamp, const uint8_t report[SNS_COMPASS_REPORT_BYTES], int32_t heading_mdeg);
+} SnsOps;
+
+typedef struct {
+    uint32_t mode;                           /* 2: lookup and attributes; 3: also the streams */
+    SfxAxes axes[3];                         /* accelerometer, gyroscope, magnetometer */
+    uint32_t als_permille;                   /* 0: 1000 */
+    char type[PaganiSensorKinds][SSC_TYPE_MAX];   /* the data types; empty: that kind is not asked for */
+    uint32_t motion_hz;                      /* nonzero: the motion sensors stream at this rate without a request */
+    uint32_t prox_always;
+    uint32_t orient;                         /* compute the device orientation: the accelerometer stays on */
+    uint32_t compass;                        /* fuse rotv + mag_cal + motion into {0xff0c, 8} compass reports */
+    uint32_t compass_mode;                   /* 0: calibrated 9-axis fusion (default), 1: legacy akm_rotv */
+    int32_t mag_bias_q16[3];                 /* optional PCB hard-iron bias in 16.16 uT */
+    uint32_t has_mag_bias;                   /* nonzero: seed compass default_mag_bias from mag_bias_q16 */
+    uint32_t list;
+    uint32_t log;                            /* 0 failures, 1 rationed, 2 more */
+} SnsConfig;
+
+typedef struct {
+    uint16_t next_txn, pending_txn;
+    int pending;                             /* a request is outstanding */
+    uint32_t pending_msg;                    /* its sensor message id */
+    uint32_t pending_tag;                    /* lookup: the kind (or PaganiSensorKinds for the list) */
+    uint64_t sent_ms;
+    int has_client;
+    uint64_t client_id;
+    uint32_t requests, responses, refused, timeouts, reports;
+} SnsConn;
+
+typedef struct {
+    int found;
+    SscSuid suid;
+    unsigned suids;                          /* SUIDs the hub listed for the data type */
+    int attr_state;                          /* 0 to ask, 1 asked, 2 read, 3 gave up */
+    unsigned attr_tries;
+    uint64_t attr_deadline;
+    SscAttrs attrs;
+    uint32_t demand_us;                      /* iOS's report interval (0: none) */
+    int want, active, requested;             /* SNS_OFF / _ON_CHANGE / _STREAMING */
+    uint32_t want_rate, active_rate, requested_rate;   /* float bits, Hz */
+    uint32_t hw_rate;                        /* actual Hz from SSC_MSG_PHYSICAL_CONFIG_EVENT (float bits) */
+    unsigned tries;
+    uint64_t retry_at;
+    int failed;                              /* given up until the service restarts */
+    uint32_t events, session_events, errors, bad, skipped;
+    int first_logged, quiet_logged;
+    uint64_t found_ms, active_since, sample_ms; /* SUID found, stream accepted, last sample (our clock) */
+    SnsSample last;
+} SnsSensor;
+
+typedef struct {
+    const SnsOps *ops;
+    SnsConfig cfg;
+    int32_t stage, error;
+    int up;
+    uint32_t node, port, instance, generation;
+    uint64_t wait_since;
+    unsigned reminders;
+    uint64_t reminder_at;
+    unsigned lookup_sent;                    /* bit per kind (bit PaganiSensorKinds: the list): the request was accepted */
+    unsigned lookup_tries;
+    uint64_t lookup_retry_at;
+    int discovery_done, discovery_logged;
+    uint64_t discovery_started;
+    SnsConn conn[SNS_CONNS];
+    SnsSensor sensor[PaganiSensorKinds];
+    unsigned budget;                         /* ordinary lines left */
+    unsigned transitions;                    /* the service's ups and downs (the first 32 logged, then every 64th) */
+    unsigned listed;                         /* list lines written */
+    uint64_t summary_at;
+    uint32_t sent, refused, responses, reports, malformed, unexpected, failures, stale;
+    SnoState orient;
+    SnsCompass compass;
+    uint32_t compass_demand_us;
+    uint32_t compass_events;
+    int compass_first_logged;
+    int32_t last_rotv_acc_logged;
+    int32_t last_mcal_acc_logged;
+    uint32_t mcal_cal_logs;
+    int rotv_bounce_phase;                   /* 0 idle, 1 disabling, 2 waiting to re-enable */
+    uint64_t rotv_bounce_at;
+    uint32_t rotv_bounces;
+    char line[240];
+} SnsCore;
+
+void sns_core_init(SnsCore *c, const SnsOps *ops, const SnsConfig *config);
+/* The service's state from the router (the glue reads it on every edge): up with its address and the generation of the port's server. */
+void sns_core_server(SnsCore *c, int up, uint32_t node, uint32_t port, uint32_t instance, uint32_t generation);
+/* One QMI message that arrived on connection conn from node:port. */
+void sns_core_receive(SnsCore *c, unsigned conn, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length);
+/* iOS's request for a sensor: the report interval in microseconds (motion sensors), any nonzero value for on (proximity); 0 none. A
+ * repeated proximity request gives the current state again (backboardd writes a detection mode for each change of mode and expects
+ * the current mask each time; the hub only reports a change or a new request). */
+void sns_core_demand(SnsCore *c, unsigned kind, uint32_t interval_us);
+/* iOS's request for the {0xff0c, 8} device-motion compass service (microseconds; 0 none). */
+void sns_core_compass_demand(SnsCore *c, uint32_t interval_us);
+/* Timers and pending work. */
+void sns_core_tick(SnsCore *c);
+/* How long the thread may sleep before the next tick is due (1 .. 60000 ms). */
+uint32_t sns_core_idle_ms(SnsCore *c);
+/* The driver's stage for the parts before the service (Services, Ports) and their failures; logged by the glue. */
+void sns_core_stage(SnsCore *c, int32_t stage, int32_t error);
+/* Fills the core's parts of a status. */
+void sns_core_status(const SnsCore *c, PaganiSensorsStatus *out);
+const char *sns_kind_name(unsigned kind);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsFixed.c b/xnu/fuxi-sensors/SensorsFixed.c
new file mode 100644
index 0000000..0146c81
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsFixed.c
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* Integer arithmetic on float bit patterns and the 13T's axis maps: see SensorsFixed.h. */
+#include "SensorsFixed.h"
+
+#define INT64_TOP 0x7fffffffffffffffll
+
+static int64_t clamp(int64_t v, int64_t lo, int64_t hi)
+{
+    return v < lo ? lo : v > hi ? hi : v;
+}
+
+int64_t sfx_scale(uint32_t bits, int64_t num, int64_t den, int shift, int64_t lo, int64_t hi)
+{
+    const uint32_t exponent = (bits >> 23) & 0xff, fraction = bits & 0x7fffff;
+    const int negative = (int)(bits >> 31) ^ (num < 0);
+    if (den <= 0) return clamp(0, lo, hi);
+    if (exponent == 0xff) return fraction ? clamp(0, lo, hi) : (negative ? lo : hi);
+    uint64_t mant = exponent ? (fraction | 0x800000u) : fraction;
+    int power = (exponent ? (int)exponent - 150 : -149) + shift;
+    const uint64_t magnitude_num = num < 0 ? (uint64_t)0 - (uint64_t)num : (uint64_t)num;
+    if (!mant || !magnitude_num) return clamp(0, lo, hi);
+    uint64_t product = mant * magnitude_num;                 /* < 2^24 * 2^39 */
+    uint64_t result;
+    if (power >= 0) {
+        if (power > 62 || product > ((uint64_t)INT64_TOP >> power)) return negative ? lo : hi;
+        product <<= power;
+        result = (product + (uint64_t)den / 2) / (uint64_t)den;
+    } else {
+        int k = -power;
+        if (k > 62) return clamp(0, lo, hi);
+        if (k > 31) {   /* keep den << k inside 64 bits: drop the low bits first, rounded */
+            const int drop = k - 31;
+            product = (product + ((uint64_t)1 << (drop - 1))) >> drop;
+            k = 31;
+        }
+        const uint64_t divisor = (uint64_t)den << k;
+        result = (product + divisor / 2) / divisor;
+    }
+    if (result > (uint64_t)INT64_TOP) return negative ? lo : hi;
+    const int64_t value = negative ? -(int64_t)result : (int64_t)result;
+    return clamp(value, lo, hi);
+}
+
+uint32_t sfx_float_from_ratio(uint64_t num, uint64_t den)
+{
+    if (!num || !den || num >> 32 || den >> 32) return 0;
+    int e = 0;
+    while (num < (den << 23)) {num <<= 1; e--;}
+    while (num >= (den << 24)) {den <<= 1; e++;}
+    uint64_t q = num / den;
+    const uint64_t r = num % den;
+    if (2 * r > den || (2 * r == den && (q & 1))) q++;
+    if (q == (1u << 24)) {q >>= 1; e++;}
+    const int biased = e + 23 + 127;
+    if (biased >= 0xff) return 0x7f800000u;
+    if (biased <= 0) return 0;   /* far below anything a rate can be */
+    return (uint32_t)biased << 23 | (uint32_t)(q & 0x7fffff);
+}
+
+int32_t sfx_milli(uint32_t bits)
+{
+    return (int32_t)sfx_scale(bits, 1000, 1, 0, -0x7fffffffll - 1, 0x7fffffffll);
+}
+
+int sfx_positive(uint32_t bits)
+{
+    return !(bits >> 31) && ((bits >> 23) & 0xff) != 0xff && (bits & 0x7fffffffu) != 0;
+}
+
+int32_t sfx_accel_ios(uint32_t bits)
+{
+    return (int32_t)sfx_scale(bits, -100000, SFX_STANDARD_GRAVITY_X100000, 16, -0x7fffffffll - 1, 0x7fffffffll);
+}
+
+int32_t sfx_fixed(uint32_t bits)
+{
+    return (int32_t)sfx_scale(bits, 1, 1, 16, -0x7fffffffll - 1, 0x7fffffffll);
+}
+
+int32_t sfx_pressure_kpa(uint32_t bits)
+{
+    return (int32_t)sfx_scale(bits, 1, 10, 16, -0x7fffffffll - 1, 0x7fffffffll);
+}
+
+uint32_t sfx_lux(uint32_t bits, uint32_t permille)
+{
+    return (uint32_t)sfx_scale(bits, permille, 1000, 0, 0, 0x7fffffffll);
+}
+
+/* ---- axis maps ---- */
+void sfx_axes_identity(SfxAxes *a)
+{
+    for (uint8_t i = 0; i < 3; ++i) {a->src[i] = i; a->neg[i] = 0;}
+}
+
+int sfx_axes_valid(const SfxAxes *a)
+{
+    unsigned seen = 0;
+    for (unsigned i = 0; i < 3; ++i) {
+        if (a->src[i] > 2 || a->neg[i] > 1) return 0;
+        seen |= 1u << a->src[i];
+    }
+    return seen == 7;
+}
+
+void sfx_axes_apply(const SfxAxes *a, const int32_t in[3], int32_t out[3])
+{
+    for (unsigned i = 0; i < 3; ++i) {
+        const int32_t v = in[a->src[i] % 3];
+        /* the most negative value has no opposite: saturate */
+        out[i] = a->neg[i] ? (v == -0x7fffffff - 1 ? 0x7fffffff : -v) : v;
+    }
+}
+
+int sfx_axes_parse(const char *text, SfxAxes *accel, SfxAxes *gyro, SfxAxes *mag)
+{
+    SfxAxes maps[3];
+    int given[3] = {0, 0, 0};
+    unsigned at = 0;
+    if (!text) return -1;
+    for (unsigned i = 0; i < 3; ++i) maps[i] = *(i == 0 ? accel : i == 1 ? gyro : mag);
+    while (text[at]) {
+        const char which = text[at++];
+        const int k = which == 'a' ? 0 : which == 'g' ? 1 : which == 'm' ? 2 : -1;
+        if (k < 0 || given[k]) return -1;
+        SfxAxes m;
+        sfx_axes_identity(&m);
+        for (unsigned i = 0; i < 3; ++i) {
+            const char sign = text[at], axis = sign ? text[at + 1] : 0;
+            if ((sign != '+' && sign != '-') || axis < 'x' || axis > 'z') return -1;
+            m.neg[i] = sign == '-';
+            m.src[i] = (uint8_t)(axis - 'x');
+            at += 2;
+        }
+        if (!sfx_axes_valid(&m)) return -1;
+        maps[k] = m;
+        given[k] = 1;
+        if (text[at] == ',' || text[at] == '.') {
+            at++;
+            if (!text[at]) return -1;
+        } else if (text[at]) {
+            return -1;
+        }
+    }
+    if (!given[0] && !given[1] && !given[2]) return -1;
+    *accel = maps[0];
+    *gyro = maps[1];
+    *mag = maps[2];
+    return 0;
+}
+
+void sfx_axes_text(const SfxAxes *a, char out[7])
+{
+    for (unsigned i = 0; i < 3; ++i) {
+        out[2 * i] = a->neg[i] ? '-' : '+';
+        out[2 * i + 1] = (char)('x' + (a->src[i] % 3));
+    }
+    out[6] = 0;
+}
diff --git a/xnu/fuxi-sensors/SensorsFixed.h b/xnu/fuxi-sensors/SensorsFixed.h
new file mode 100644
index 0000000..e65036f
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsFixed.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* Integer arithmetic on IEEE-754 single precision bit patterns, for kernel code built without floating point registers
+ * (-mgeneral-regs-only): the sensor client service sends its samples, rates and attributes as floats, iOS wants integers and 16.16 fixed
+ * point (IOFixed). Also the axis maps of the 13T's sensors (identity by default: the sensor hub reports in the phone's frame, x right,
+ * y up, z out of the screen, which is iOS's frame too) and the unit conversions to the HID events iOS reads:
+ *   accelerometer  m/s^2 (gravity reads +9.81 on z lying face up)  ->  g, sign reversed (face up z = -1 g), IOFixed
+ *   gyroscope      rad/s                                           ->  rad/s, IOFixed
+ *   magnetometer   uT                                              ->  uT, IOFixed
+ *   pressure       hPa                                             ->  kPa, IOFixed
+ *   ambient light  lux                                             ->  lux, integer (times a scale in permille) */
+#ifndef SENSORS_FIXED_H
+#define SENSORS_FIXED_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* round(value(bits) * num / den * 2^shift) (half away from zero), saturated to [lo, hi]; NaN gives 0, infinities saturate.
+ * |num| < 2^39, 0 < den < 2^31. */
+int64_t sfx_scale(uint32_t bits, int64_t num, int64_t den, int shift, int64_t lo, int64_t hi);
+/* The float nearest num / den (ties to even); num, den < 2^32, 0 when either is 0. */
+uint32_t sfx_float_from_ratio(uint64_t num, uint64_t den);
+/* value * 1000, rounded and saturated to int32: the log's milli-units. */
+int32_t sfx_milli(uint32_t bits);
+/* 1 for a positive finite float (rates), comparable as unsigned integers. */
+int sfx_positive(uint32_t bits);
+
+#define SFX_STANDARD_GRAVITY_X100000 980665   /* 9.80665 m/s^2 */
+int32_t sfx_accel_ios(uint32_t bits);        /* -v / g in 16.16 */
+int32_t sfx_fixed(uint32_t bits);            /* v in 16.16 */
+int32_t sfx_pressure_kpa(uint32_t bits);     /* hPa / 10 in 16.16 */
+uint32_t sfx_lux(uint32_t bits, uint32_t permille);   /* lux * permille / 1000, at least 0 */
+
+/* out[i] = (neg[i] ? -1 : 1) * in[src[i]] */
+typedef struct {
+    uint8_t src[3], neg[3];
+} SfxAxes;
+void sfx_axes_identity(SfxAxes *a);
+int sfx_axes_valid(const SfxAxes *a);
+void sfx_axes_apply(const SfxAxes *a, const int32_t in[3], int32_t out[3]);
+/* "a-y+x+z,g+x+y+z,m+y-x+z": per sensor (a accelerometer, g gyroscope, m magnetometer) the three output axes, each a sign and the input
+ * axis it takes; groups separated by ',' or '.', any subset, each input axis once per group. 0 and the maps set; -1 (nothing changed)
+ * on any error. */
+int sfx_axes_parse(const char *text, SfxAxes *accel, SfxAxes *gyro, SfxAxes *mag);
+/* The text form of one map ("+x+y+z"), 7 bytes with the terminator. */
+void sfx_axes_text(const SfxAxes *a, char out[7]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsHid.c b/xnu/fuxi-sensors/SensorsHid.c
new file mode 100644
index 0000000..df02832
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsHid.c
@@ -0,0 +1,214 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* What iOS reads per sensor: see SensorsHid.h. */
+#include "SensorsHid.h"
+
+static const SnsHidKind kKinds[SNS_HID_KINDS] = {
+    {0xff00, 0x03, "Pagani Accelerometer", 0},
+    {0xff00, 0x09, "Pagani Gyroscope", 0},
+    {0xff00, 0x0a, "Pagani Compass", 0},
+    {0xff00, 0x04, "Pagani Ambient Light", 0},
+    {0xff00, 0x08, "Pagani Proximity", 1},   /* backboardd ignores a proximity service whose Placement is not 1 (top) */
+    {0x0020, 0x31, "Pagani Pressure", 0},
+    {0x0020, 0x8a, "Pagani Orientation", 0},
+    {0xff0c, 0x08, "Pagani Device Motion", 0},
+};
+
+const SnsHidKind *sns_hid_kind(unsigned kind)
+{
+    return kind < SNS_HID_KINDS ? &kKinds[kind] : 0;
+}
+
+/* Report 1: two 32-bit feature values on the Sensor page, 0x30e report interval and 0x31b report latency (us): IOHIDEventDriver's sensor
+ * property parser takes them (so the driver starts) and writes iOS's report interval there. */
+#define PROPERTIES \
+    0x85, 0x01, 0x05, 0x20, 0x0a, 0x0e, 0x03, 0x0a, 0x1b, 0x03, 0x15, 0x00, 0x27, 0xff, 0xff, 0xff, 0x7f, 0x55, 0x00, 0x75, 0x20, \
+    0x95, 0x02, 0xb1, 0x02
+/* Report 2 of the motion sensors: x, y, z on the Sensor page (the original driver's accelerometer 0x453.., gyroscope 0x457..,
+ * compass 0x485.. parsers know them; 16 bits, exponent -3). Never sent: the samples are events built here, this only gives the
+ * driver the elements a real HID motion sensor has. */
+#define AXES(x, y, z) \
+    0x85, 0x02, 0x05, 0x20, 0x0a, (x), 0x04, 0x0a, (y), 0x04, 0x0a, (z), 0x04, 0x16, 0x01, 0x80, 0x26, 0xff, 0x7f, 0x55, 0x0d, 0x75, \
+    0x10, 0x95, 0x03, 0x81, 0x02
+static const uint8_t kAccel[] = {0x06, 0x00, 0xff, 0x09, 0x03, 0xa1, 0x01, PROPERTIES, AXES(0x53, 0x54, 0x55), 0xc0};
+static const uint8_t kGyro[] = {0x06, 0x00, 0xff, 0x09, 0x09, 0xa1, 0x01, PROPERTIES, AXES(0x57, 0x58, 0x59), 0xc0};
+static const uint8_t kMag[] = {0x06, 0x00, 0xff, 0x09, 0x0a, 0xa1, 0x01, PROPERTIES, AXES(0x85, 0x86, 0x87), 0xc0};
+static const uint8_t kLight[] = {0x06, 0x00, 0xff, 0x09, 0x04, 0xa1, 0x01, PROPERTIES, 0xc0};
+static const uint8_t kProx[] = {0x06, 0x00, 0xff, 0x09, 0x08, 0xa1, 0x01, PROPERTIES, 0xc0};
+static const uint8_t kPressure[] = {0x05, 0x20, 0x09, 0x31, 0xa1, 0x01, PROPERTIES, 0xc0};
+/* Report 1: one bit per state on the vendor usages 0x64..0x6a, one padding bit: the original driver's device orientation parser and
+ * report handler (a bit going from 0 to 1 is an orientation event with that usage). */
+static const uint8_t kOrientation[] = {0x05, 0x20, 0x09, 0x8a, 0xa1, 0x01, 0x85, 0x01, 0x06, 0x0c, 0xff, 0x19, 0x64, 0x29, 0x6a, 0x15, 0x00,
+                                       0x25, 0x01, 0x75, 0x01, 0x95, 0x07, 0x81, 0x02, 0x75, 0x01, 0x95, 0x01, 0x81, 0x03, 0xc0};
+static const uint8_t kDevMotion[] = {0x06, 0x0c, 0xff, 0x09, 0x08, 0xa1, 0x01, PROPERTIES, 0xc0};
+#undef AXES
+#undef PROPERTIES
+
+const uint8_t *sns_hid_descriptor(unsigned kind, uint32_t *length)
+{
+    static const uint8_t *const tables[SNS_HID_KINDS] = {kAccel, kGyro, kMag, kLight, kProx, kPressure, kOrientation, kDevMotion};
+    static const uint32_t sizes[SNS_HID_KINDS] = {sizeof kAccel, sizeof kGyro, sizeof kMag, sizeof kLight, sizeof kProx, sizeof kPressure,
+                                                  sizeof kOrientation, sizeof kDevMotion};
+    if (kind >= SNS_HID_KINDS) {
+        if (length) *length = 0;
+        return 0;
+    }
+    if (length) *length = sizes[kind];
+    return tables[kind];
+}
+
+/* ---- the personalities, as XML text ---- */
+typedef struct {
+    char *out;
+    uint32_t cap, len;
+    int overflow;
+} Xml;
+
+static void put(Xml *x, const char *s)
+{
+    for (uint32_t i = 0; s[i]; ++i) {
+        if (x->len + 1 >= x->cap) {x->overflow = 1; return;}
+        x->out[x->len++] = s[i];
+    }
+}
+static void put_uint(Xml *x, uint32_t v)
+{
+    char digits[11];
+    unsigned n = 0;
+    do {
+        digits[n++] = (char)('0' + v % 10);
+        v /= 10;
+    } while (v);
+    char text[12];
+    for (unsigned i = 0; i < n; ++i) text[i] = digits[n - 1 - i];
+    text[n] = 0;
+    put(x, text);
+}
+static void key_int(Xml *x, const char *key, uint32_t value)
+{
+    put(x, "<key>");
+    put(x, key);
+    put(x, "</key><integer>");
+    put_uint(x, value);
+    put(x, "</integer>");
+}
+
+uint32_t sns_hid_personalities(uint32_t mask, char *out, uint32_t capacity)
+{
+    Xml x = {out, capacity, 0, 0};
+    if (!out || !capacity) return 0;
+    put(&x, "<array>");
+    for (unsigned kind = 0; kind < SNS_HID_KINDS; ++kind) {
+        if (!(mask & (1u << kind))) continue;
+        const SnsHidKind *k = &kKinds[kind];
+        put(&x, "<dict><key>IOClass</key><string>IOHIDEventDriver</string>"
+                "<key>IOProviderClass</key><string>IOHIDInterface</string>"
+                "<key>CFBundleIdentifier</key><string>com.apple.iokit.IOHIDFamily</string>"
+                "<key>HIDDefaultBehavior</key><string></string>");
+        key_int(&x, "IOProbeScore", 6000);   /* before any generic event driver personality of the same usage */
+        put(&x, "<key>IOPropertyMatch</key><dict><key>Product</key><string>");
+        put(&x, k->product);
+        put(&x, "</string></dict><key>DeviceUsagePairs</key><array><dict>");
+        key_int(&x, "DeviceUsagePage", k->page);
+        key_int(&x, "DeviceUsage", k->usage);
+        put(&x, "</dict></array>");
+        key_int(&x, "PrimaryUsagePage", k->page);
+        key_int(&x, "PrimaryUsage", k->usage);
+        put(&x, "<key>Built-In</key><true/>");
+        if (k->placement) key_int(&x, "Placement", k->placement);
+        put(&x, "</dict>");
+    }
+    put(&x, "</array>");
+    if (x.overflow) {
+        out[0] = 0;
+        return 0;
+    }
+    out[x.len] = 0;
+    return x.len;
+}
+
+/* ---- events and demand ---- */
+int sns_hid_event(const SnsSample *s, uint32_t sequence, SnsHidEvent *out)
+{
+    SnsHidEvent e = {0, 0, 0, 0, 0, 0, sequence};
+    switch (s->kind) {
+    case PaganiSensorAccel: e.type = SNS_HID_EVENT_ACCELEROMETER; break;
+    case PaganiSensorGyro: e.type = SNS_HID_EVENT_GYRO; break;
+    case PaganiSensorMag: e.type = SNS_HID_EVENT_COMPASS; break;
+    case PaganiSensorLight:
+        e.type = SNS_HID_EVENT_AMBIENT_LIGHT;
+        e.level = s->value[0] > 0 ? (uint32_t)s->value[0] : 0;
+        *out = e;
+        return 0;
+    case PaganiSensorProximity:
+        e.type = SNS_HID_EVENT_PROXIMITY;
+        e.mask = s->value[0] ? SNS_HID_PROXIMITY_NEAR : 0;
+        e.level = s->value[1] > 0 ? (uint32_t)s->value[1] : 0;
+        *out = e;
+        return 0;
+    case PaganiSensorPressure:
+        e.type = SNS_HID_EVENT_PRESSURE;
+        e.x = s->value[0];
+        *out = e;
+        return 0;
+    default:
+        return -1;
+    }
+    e.x = s->value[0];
+    e.y = s->value[1];
+    e.z = s->value[2];
+    *out = e;
+    return 0;
+}
+
+int sns_hid_demand(unsigned kind, unsigned key, uint64_t value, uint32_t *demand)
+{
+    switch (kind) {
+    case PaganiSensorAccel:
+    case PaganiSensorGyro:
+    case PaganiSensorMag:
+    case PaganiSensorPressure:
+    case SNS_HID_DEVMOTION:
+        if (key != SNS_HID_KEY_REPORT_INTERVAL) return 0;
+        *demand = value > 0xffffffffu ? 0xffffffffu : (uint32_t)value;
+        return 1;
+    case PaganiSensorProximity:
+        if (key != SNS_HID_KEY_DETECTION_MODE) return 0;
+        *demand = value ? 1u : 0u;
+        return 1;
+    default:
+        return 0;   /* ambient light: always on */
+    }
+}
+
+uint32_t sns_hid_orient_report(int state, uint8_t out[2])
+{
+    if (state < 0 || state > 6) return 0;
+    out[0] = 1;
+    out[1] = (uint8_t)(1u << state);
+    return 2;
+}
+
+int sns_hid_spu_method(uint32_t selector, uint32_t scalars, uint64_t first_scalar, uint32_t *command)
+{
+    switch (selector) {
+    case SNS_HID_SPU_OPEN:
+    case SNS_HID_SPU_CLOSE:
+        return 0;
+    case SNS_HID_SPU_COMMAND:
+        if (scalars < 1 || first_scalar > 0xffffffffu) return -1;
+        if (command) *command = (uint32_t)first_scalar;
+        return 0;
+    default:
+        return -1;
+    }
+}
+
+unsigned sns_hid_nodes(unsigned mode, uint32_t published, unsigned wanted)
+{
+    unsigned nodes = 0;
+    if (mode != 3 || !wanted) return 0;
+    if (published & (1u << PaganiSensorAccel)) nodes |= SNS_HID_NODE_ACCEL;
+    if (published & (1u << PaganiSensorGyro)) nodes |= SNS_HID_NODE_GYRO;
+    return nodes;
+}
diff --git a/xnu/fuxi-sensors/SensorsHid.h b/xnu/fuxi-sensors/SensorsHid.h
new file mode 100644
index 0000000..0e173e0
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsHid.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* What iOS 17.7 (21H461) reads, per sensor: the HID service each kind is published as, and the event each sample becomes. Portable C
+ * (the kernel glue PaganiSensorsHid.cpp and the host tests use the same tables). Facts from the static reverse engineering of the
+ * consumers (build-userspace/a830-inputs/sensors/ios-sensors.md sections 2 to 4):
+ *
+ *   kind           usage pair      extra properties       event                                   consumer
+ *   accelerometer  0xff00/0x03     Built-In               13 accelerometer x y z (16.16 g)        locationd, CoreMotion, backboardd
+ *   gyroscope      0xff00/0x09     Built-In               20 gyro x y z (16.16 rad/s)             locationd (CLGyro)
+ *   magnetometer   0xff00/0x0a     Built-In               21 compass x y z (16.16 uT)             locationd (CLMagnetometer)
+ *   ambient light  0xff00/0x04     Built-In               12 ambient light level (integer lux)    CoreBrightness (auto-brightness)
+ *   proximity      0xff00/0x08     Built-In, Placement 1  14 proximity mask (0x40 near, 0 far)    backboardd (screen off in calls)
+ *   pressure       0x0020/0x31     Built-In               31 atmospheric pressure (16.16 kPa)     locationd (CLPressure)
+ *   orientation    0x0020/0x8a     Built-In, 'ashd' above 10 orientation, usage 0x64 + state      CoreMotion in backboardd and locationd
+ *
+ * The services are the original IOHIDEventDriver on our IOHIDDevice: its descriptor holds one top-level application collection with the
+ * kind's usage pair, the sensor property feature elements (Sensor page 0x30e report interval, 0x31b report latency), which
+ * IOHIDEventDriver's parser accepts (so it starts) and which carry iOS's report interval, and for the motion sensors their x/y/z input
+ * elements (never sent, the shape of a real HID motion sensor for the driver's own parsers); the events are built with the original
+ * IOHIDEvent constructors and handed to the driver's dispatchEvent (the original driver has no ambient light or pressure parsing, and its
+ * proximity path only knows the masks 0 and 1, so no sensor goes through input reports). No "Transport" = "SPU": that is the real
+ * always-on processor's, and AppleSPU's plug-ins would match.
+ *
+ * The orientation service is the exception, and it is a trap. Its descriptor has the seven one-bit inputs of the 0xff0c usages
+ * 0x64..0x6a; a report with a bit going from 0 to 1 makes the original driver send the event itself. But the moment the service exists,
+ * CoreMotion's CLOrientationNotifier (in backboardd, every boot) takes the service's grandparent, opens the AppleSPULib plug-in on it and
+ * sends a configuration through the interface without checking that it opened: without that plug-in's user client, a null dereference
+ * (ios-sensors.md, conclusion 4). So this service is published only together with what makes the open succeed: on the same device
+ * object (the grandparent of the event driver) IOCFPlugInTypes naming the plug-in, the user client of type 'ashd' with the methods
+ * SNS_HID_SPU_* below, and NativeSandboxGrantAll (XNU patch zzwc-native-adreno-sandbox-grant-all: backboardd and locationd are
+ * sandboxed, and their profiles know Apple's user client class, not ours). PaganiSensorsHid.cpp sets all of them before the device
+ * starts: there is no moment when the service is visible and the user client is not. */
+#ifndef SENSORS_HID_H
+#define SENSORS_HID_H
+#include <stdint.h>
+#include "SensorsCore.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The HID kinds: the 6 direct sensors (0..5), then orientation (6) and device motion / compass (7). */
+enum {
+    SNS_HID_ORIENT = PaganiSensorPressure + 1,
+    SNS_HID_DEVMOTION = PaganiSensorPressure + 2,
+    SNS_HID_KINDS = PaganiSensorPressure + 3,
+};
+
+enum {
+    SNS_HID_EVENT_AMBIENT_LIGHT = 12, SNS_HID_EVENT_ACCELEROMETER = 13, SNS_HID_EVENT_PROXIMITY = 14, SNS_HID_EVENT_GYRO = 20,
+    SNS_HID_EVENT_COMPASS = 21, SNS_HID_EVENT_PRESSURE = 31,
+};
+#define SNS_HID_PROXIMITY_NEAR 0x40u    /* kIOHIDProximityDetectionReceiver: backboardd's "object present" in its active modes */
+
+typedef struct {
+    uint16_t page, usage;
+    const char *product;               /* the device's Product: the personality matches it */
+    uint32_t placement;                /* 0: not set */
+} SnsHidKind;
+const SnsHidKind *sns_hid_kind(unsigned kind);
+
+/* The report descriptor of a kind (its length in *length). */
+const uint8_t *sns_hid_descriptor(unsigned kind, uint32_t *length);
+/* The IOKit personalities (an XML array, one dictionary per kind in mask) matching the original IOHIDEventDriver to our devices; the
+ * length written (terminated), 0 when it did not fit. */
+uint32_t sns_hid_personalities(uint32_t mask, char *out, uint32_t capacity);
+
+/* One event: the original constructor's arguments for a sample. */
+typedef struct {
+    uint32_t type;                     /* SNS_HID_EVENT_* */
+    int32_t x, y, z;                   /* motion: 16.16; pressure: level 16.16 in x */
+    uint32_t level;                    /* ambient light: lux; proximity: the hub's raw count */
+    uint16_t mask;                     /* proximity */
+    uint32_t sequence;
+} SnsHidEvent;
+/* 0 and the event of a sample, -1 for a kind without one. */
+int sns_hid_event(const SnsSample *s, uint32_t sequence, SnsHidEvent *out);
+
+/* iOS's properties on a service, as the manager's demand: the report interval (us) of the motion services and pressure ("ReportInterval";
+ * 0 stops), the detection mode of proximity ("DetectionMode": 0 off, else on). */
+enum {SNS_HID_KEY_REPORT_INTERVAL = 1, SNS_HID_KEY_DETECTION_MODE = 2};
+/* 1 and the demand when the key concerns the kind, else 0. */
+int sns_hid_demand(unsigned kind, unsigned key, uint64_t value, uint32_t *demand);
+
+/* The orientation service's input report for a state (SensorsOrient.h): report id and the state's bit. 2, or 0 for a bad state. */
+uint32_t sns_hid_orient_report(int state, uint8_t out[2]);
+
+/* The AppleSPULib plug-in's side of the orientation service (ios-sensors.md 2.7, AppleSPUHIDDeviceClass): the user client type and the
+ * selectors CoreMotion uses; the rest of the interface is never called on this path. */
+#define SNS_HID_SPU_CLIENT 0x61736864u   /* 'ashd' */
+#define SNS_HID_SPU_PLUGIN_TYPE "7ACF5332-1A35-4893-87CB-BA64E1887FAE"
+#define SNS_HID_SPU_PLUGIN_PATH "AppleSPU.kext/PlugIns/AppleSPULib.plugin"
+enum {SNS_HID_SPU_OPEN = 4, SNS_HID_SPU_CLOSE = 5, SNS_HID_SPU_COMMAND = 6, SNS_HID_SPU_CONFIG = 0x20};
+/* 0 for a selector that succeeds (with no output), -1 unsupported. A command is recorded in *command when given. */
+int sns_hid_spu_method(uint32_t selector, uint32_t scalars, uint64_t first_scalar, uint32_t *command);
+
+/* The IODeviceTree nodes MobileGestalt's accelerometer and gyroscope answers look for, by name through the whole plane. Only a boot that
+ * asks for the streams (mode 3) claims them, and only for a service that is really there; never in the board's static device tree (a
+ * daily image would then answer "has an accelerometer" with no data source). The nodes to create: bit 0 accel, bit 1 gyro. */
+enum {SNS_HID_NODE_ACCEL = 1, SNS_HID_NODE_GYRO = 2};
+unsigned sns_hid_nodes(unsigned mode, uint32_t published, unsigned wanted);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsOrient.c b/xnu/fuxi-sensors/SensorsOrient.c
new file mode 100644
index 0000000..9f117ef
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsOrient.c
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The device orientation from the accelerometer: see SensorsOrient.h. */
+#include "SensorsOrient.h"
+
+#define G (1ll << 16)
+#define TOP (8 * G)             /* beyond any sample that counts: the squares below stay inside 64 bits */
+
+void sno_init(SnoState *s)
+{
+    s->state = SNO_UNKNOWN;
+    s->candidate = SNO_UNKNOWN;
+    s->since_ms = 0;
+}
+
+static int64_t absolute(int64_t v) {return v < 0 ? -v : v;}
+
+/* What one sample shows: a state, or the current one when it is in a dead zone. */
+static int classify(const SnoState *s, int64_t x, int64_t y, int64_t z)
+{
+    const int64_t ax = absolute(x), ay = absolute(y), az = absolute(z);
+    if (ax > TOP || ay > TOP || az > TOP) return s->state;
+    const int64_t length = x * x + y * y + z * z;                    /* 32.32, at most 3 * 2^38 */
+    if (length * 100 < 36 * (G * G) || length * 100 > 196 * (G * G)) return s->state;
+    if (az * az * 100 >= 72 * length) return z < 0 ? SNO_FACE_UP : SNO_FACE_DOWN;      /* 0.85 squared */
+    if ((ax * ax + ay * ay) * 100 < 16 * length) return s->state;    /* 0.4 squared: neither flat nor upright enough */
+    const int portrait = y < 0 ? SNO_PORTRAIT : SNO_UPSIDE_DOWN, landscape = x < 0 ? SNO_LANDSCAPE_LEFT : SNO_LANDSCAPE_RIGHT;
+    const int leading = ay >= ax ? portrait : landscape;
+    /* Any change (and the first state) needs the margin: the diagonals keep what they have. */
+    if (leading == s->state || (ay >= ax ? ay * 10 >= ax * 13 : ax * 10 >= ay * 13)) return leading;
+    return s->state;
+}
+
+int sno_update(SnoState *s, int32_t x, int32_t y, int32_t z, uint64_t now_ms)
+{
+    const int shown = classify(s, x, y, z);
+    if (shown == s->state) {
+        s->candidate = shown;
+        return -1;
+    }
+    if (shown != s->candidate) {
+        s->candidate = shown;
+        s->since_ms = now_ms;
+        return -1;
+    }
+    if (now_ms - s->since_ms < SNO_HOLD_MS) return -1;
+    s->state = shown;
+    return shown;
+}
diff --git a/xnu/fuxi-sensors/SensorsOrient.h b/xnu/fuxi-sensors/SensorsOrient.h
new file mode 100644
index 0000000..94e11a8
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsOrient.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The device orientation from the accelerometer, in the kernel. CoreMotion's motion capabilities are chosen by the product-id, which stays
+ * J120's: hardware type 62 has the capability "the orientation comes from the always-on processor", so CLOrientationNotifier (in
+ * backboardd, also in locationd) never computes it on the application processor and waits for orientation events (type 10, usage
+ * 0x64 + state) of the HID service 0x20/0x8a. On this phone nothing else computes it: this state machine does, on the samples iOS gets
+ * (16.16 g in iOS's convention: at rest the vector points down, portrait y = -1, face up z = -1).
+ *
+ * It is integer only (kernel code builds with -mgeneral-regs-only). A sample counts when the vector's length is 0.6 .. 1.4 g (not while
+ * the phone is being shaken or falling). Face up/down: z holds at least 0.85 of the length (within about 32 degrees). Portrait/landscape: the
+ * vector lies in the screen plane enough (x and y hold at least 0.4 of the length), and a change needs the leading axis to lead by 1.3
+ * times (about 52 degrees: 7 degrees of hysteresis on each side of the diagonal). A new state must hold for SNO_HOLD_MS before it is
+ * reported. */
+#ifndef SENSORS_ORIENT_H
+#define SENSORS_ORIENT_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* UIDeviceOrientation's order: the event's usage is 0x64 + state. */
+enum {SNO_UNKNOWN = 0, SNO_PORTRAIT = 1, SNO_UPSIDE_DOWN = 2, SNO_LANDSCAPE_LEFT = 3, SNO_LANDSCAPE_RIGHT = 4, SNO_FACE_UP = 5,
+      SNO_FACE_DOWN = 6, SNO_STATES = 7};
+#define SNO_HOLD_MS 250u
+
+typedef struct {
+    int state;                  /* the state reported last (SNO_UNKNOWN before the first) */
+    int candidate;              /* the state the samples show now */
+    uint64_t since_ms;          /* when they began to */
+} SnoState;
+
+void sno_init(SnoState *s);
+/* One sample. The state to report when it changes, else -1. */
+int sno_update(SnoState *s, int32_t x, int32_t y, int32_t z, uint64_t now_ms);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsPack.c b/xnu/fuxi-sensors/SensorsPack.c
new file mode 100644
index 0000000..862a99a
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsPack.c
@@ -0,0 +1,174 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The read-only file pack: see SensorsPack.h. */
+#include "SensorsPack.h"
+
+static uint32_t le32(const uint8_t *p) {return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;}
+static uint64_t le64(const uint8_t *p) {return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;}
+
+static int compare(const char *a, const char *b)
+{
+    uint32_t i = 0;
+    for (; a[i] && a[i] == b[i]; ++i) {}
+    return (int)(uint8_t)a[i] - (int)(uint8_t)b[i];
+}
+
+int ssp_header(const uint8_t *bytes, uint32_t length, SspHeader *out)
+{
+    static const char magic[] = "SSCPACK1";
+    if (!bytes || length < SSP_HEADER) return -1;
+    for (unsigned i = 0; i < 8; ++i) if (bytes[i] != (uint8_t)magic[i]) return -1;
+    out->count = le32(bytes + 8);
+    out->names = le32(bytes + 12);
+    out->total = le64(bytes + 16);
+    out->sum = le32(bytes + 24);
+    if (le32(bytes + 28) || !out->count || out->count > SSP_MAX_ENTRIES || !out->names || out->names > SSP_MAX_NAMES) return -1;
+    if (out->total < (uint64_t)SSP_HEADER + ssp_table_bytes(out)) return -1;
+    return 0;
+}
+
+uint32_t ssp_table_bytes(const SspHeader *h)
+{
+    return h->count * SSP_ENTRY + h->names;
+}
+
+void ssp_entry(const SspPack *p, uint32_t index, SspEntry *out)
+{
+    const uint8_t *e = p->table + (uint64_t)index * SSP_ENTRY;
+    out->offset = le64(e);
+    out->size = le64(e + 8);
+    out->name = (const char *)p->table + p->count * SSP_ENTRY + le32(e + 16);
+    out->flags = le32(e + 20);
+}
+
+int ssp_open(SspPack *p, const SspHeader *h, const uint8_t *table)
+{
+    const uint32_t bytes = ssp_table_bytes(h);
+    uint32_t sum = 0;
+    p->table = 0;
+    p->count = p->names = 0;
+    p->total = 0;
+    if (!table) return -1;
+    for (uint32_t i = 0; i < bytes; ++i) sum += table[i];
+    if (sum != h->sum) return -1;
+    const uint8_t *names = table + h->count * SSP_ENTRY;
+    if (names[h->names - 1]) return -1;                  /* every name below ends inside the area */
+    const uint64_t data = (uint64_t)SSP_HEADER + bytes;
+    const char *previous = 0;
+    for (uint32_t i = 0; i < h->count; ++i) {
+        const uint8_t *e = table + (uint64_t)i * SSP_ENTRY;
+        const uint64_t offset = le64(e), size = le64(e + 8);
+        const uint32_t name = le32(e + 16), flags = le32(e + 20);
+        if (name >= h->names || flags > SSP_DIRECTORY || names[name] != '/') return -1;
+        if (flags & SSP_DIRECTORY ? offset || size : offset < data || size > h->total || offset > h->total - size) return -1;
+        const char *path = (const char *)names + name;
+        if (previous && compare(previous, path) >= 0) return -1;
+        previous = path;
+    }
+    p->table = table;
+    p->count = h->count;
+    p->names = h->names;
+    p->total = h->total;
+    return 0;
+}
+
+int ssp_find(const SspPack *p, const char *path)
+{
+    uint32_t low = 0, high = p->count;
+    while (low < high) {
+        const uint32_t middle = low + (high - low) / 2;
+        SspEntry e;
+        ssp_entry(p, middle, &e);
+        const int order = compare(path, e.name);
+        if (!order) return (int)middle;
+        if (order < 0) high = middle;
+        else low = middle + 1;
+    }
+    return -1;
+}
+
+static int starts(const char *text, const char *prefix)
+{
+    uint32_t i = 0;
+    for (; prefix[i]; ++i) if (text[i] != prefix[i]) return 0;
+    return text[i] == 0 || text[i] == '/';
+}
+
+int ssp_path(const char *in, uint32_t length, char *out, uint32_t capacity)
+{
+    char clean[SSP_PATH];
+    uint32_t used = 0, at = 0;
+    if (!in || !length || in[0] != '/') return -1;
+    while (at < length && in[at]) {
+        while (at < length && in[at] == '/') at++;
+        const uint32_t start = at;
+        while (at < length && in[at] && in[at] != '/') at++;
+        const uint32_t n = at - start;
+        if (!n || (n == 1 && in[start] == '.')) continue;
+        if (n == 2 && in[start] == '.' && in[start + 1] == '.') {
+            while (used && clean[used - 1] != '/') used--;
+            if (used) used--;
+            continue;
+        }
+        if (used + 1 + n + 1 > sizeof clean) return -1;
+        clean[used++] = '/';
+        for (uint32_t i = 0; i < n; ++i) clean[used++] = in[start + i];
+    }
+    if (!used) clean[used++] = '/';
+    clean[used] = 0;
+    /* the aliases */
+    static const struct {const char *from, *to;} aliases[] = {{"/system/vendor", "/vendor"}, {"/persist", "/mnt/vendor/persist"}};
+    const char *prefix = "", *rest = clean;
+    for (unsigned k = 0; k < 2; ++k)
+        if (starts(clean, aliases[k].from)) {
+            prefix = aliases[k].to;
+            uint32_t skip = 0;
+            while (aliases[k].from[skip]) skip++;
+            rest = clean + skip;
+            break;
+        }
+    uint32_t n = 0;
+    for (const char *from = prefix; *from; ++from) {
+        if (n + 1 >= capacity) return -1;
+        out[n++] = *from;
+    }
+    for (const char *from = rest; *from; ++from) {
+        if (n + 1 >= capacity) return -1;
+        out[n++] = *from;
+    }
+    if (!capacity) return -1;
+    out[n] = 0;
+    return (int)n;
+}
+
+int ssp_child(const SspPack *p, uint32_t dir, uint32_t *cursor, SspEntry *child, const char **leaf)
+{
+    SspEntry d;
+    uint32_t n = 0;
+    if (dir >= p->count) return 0;
+    ssp_entry(p, dir, &d);
+    while (d.name[n]) n++;
+    if (n == 1) n = 0;                                   /* "/": the children's prefix is just the slash */
+    uint32_t i = *cursor ? *cursor : dir + 1;
+    for (; i < p->count; ++i) {
+        SspEntry e;
+        ssp_entry(p, i, &e);
+        uint32_t k = 0;
+        for (; k < n && e.name[k] == d.name[k]; ++k) {}
+        if (k < n || e.name[n] != '/') {
+            /* Sorted: names like "dir-x" and "dir.x" come before "dir/..."; once past that prefix nothing can follow. */
+            if (k < n ? (uint8_t)e.name[k] > (uint8_t)d.name[k] : (uint8_t)e.name[n] > '/') break;
+            continue;
+        }
+        const char *rest = e.name + n + 1;
+        uint32_t at = 0;
+        while (rest[at] && rest[at] != '/') at++;
+        if (rest[at] || !at) continue;                   /* deeper */
+        *child = e;
+        *leaf = rest;
+        *cursor = i + 1;
+        return 1;
+    }
+    *cursor = i;
+    return 0;
+}
diff --git a/xnu/fuxi-sensors/SensorsPack.h b/xnu/fuxi-sensors/SensorsPack.h
new file mode 100644
index 0000000..d768ccd
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsPack.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The read-only file tree the ADSP's sensor protection domain reads through FastRPC (SensorsRpc.h): the phone's /vendor/etc/sensors,
+ * /mnt/vendor/persist/sensors and /sys/devices/soc0, pulled once from Android and packed on the host by scripts/make-sensor-pack.py
+ * into one file of the RAM Data seed (/private/var/ngpu/sensors/pack.bin). Reading vendor's EROFS and persist's ext4 in place would need
+ * two file systems and super's partition table in the kernel for what one pack does; a pack also holds exactly what Android showed the
+ * DSP, the phone's own calibration included. Portable C without a C library.
+ *
+ * The file (little endian):
+ *   +0   "SSCPACK1"
+ *   +8   u32 entries, u32 names (bytes of the name area)
+ *   +16  u64 total (the size of the file)
+ *   +24  u32 sum (of the bytes of the table and the names), u32 zero
+ *   +32  entries: u64 offset, u64 size, u32 name (offset into the name area), u32 flags (1: a directory); sorted by name, byte by byte
+ *   then the names (NUL terminated absolute paths), then the files' bytes. */
+#ifndef SENSORS_PACK_H
+#define SENSORS_PACK_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {SSP_HEADER = 32, SSP_ENTRY = 24, SSP_MAX_ENTRIES = 8192, SSP_MAX_NAMES = 0x100000, SSP_PATH = 256, SSP_DIRECTORY = 1};
+
+typedef struct {
+    uint32_t count, names, sum;
+    uint64_t total;
+} SspHeader;
+/* 0 and the header's fields, -1 when it is not a pack header. */
+int ssp_header(const uint8_t *bytes, uint32_t length, SspHeader *out);
+/* The bytes of the table and the names that follow the header. */
+uint32_t ssp_table_bytes(const SspHeader *h);
+
+typedef struct {
+    const uint8_t *table;              /* the entries, then the names */
+    uint32_t count, names;
+    uint64_t total;
+} SspPack;
+/* Checks the whole table (sum, sorted names, every name terminated, every file inside total): 0, or -1. A zeroed SspPack is the empty
+ * pack: every lookup misses. */
+int ssp_open(SspPack *p, const SspHeader *h, const uint8_t *table);
+
+typedef struct {
+    uint64_t offset, size;
+    const char *name;
+    uint32_t flags;
+} SspEntry;
+void ssp_entry(const SspPack *p, uint32_t index, SspEntry *out);
+/* The index of a canonical path, -1 when it is not there. */
+int ssp_find(const SspPack *p, const char *path);
+/* A DSP path (length bytes, NUL terminated or not) made canonical: absolute, single slashes, "." removed, ".." resolved (clamped at "/"),
+ * no trailing slash, and the aliases the DSP may use for the same files: /system/vendor/... is /vendor/..., /persist/... is
+ * /mnt/vendor/persist/.... The length, or -1 for a relative path or one that does not fit. */
+int ssp_path(const char *in, uint32_t length, char *out, uint32_t capacity);
+/* The next direct child of directory dir: *cursor starts at 0; 1 and the child (leaf: its last segment), 0 at the end. */
+int ssp_child(const SspPack *p, uint32_t dir, uint32_t *cursor, SspEntry *child, const char **leaf);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsPb.c b/xnu/fuxi-sensors/SensorsPb.c
new file mode 100644
index 0000000..b3a5ef4
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsPb.c
@@ -0,0 +1,241 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* Protocol buffers wire format: see SensorsPb.h. */
+#include "SensorsPb.h"
+
+/* ---- encoder ---- */
+void spb_out(SpbOut *o, uint8_t *buf, uint32_t cap)
+{
+    o->buf = buf;
+    o->cap = buf ? cap : 0;
+    o->len = 0;
+    o->overflow = 0;
+}
+
+static void byte(SpbOut *o, uint8_t value)
+{
+    if (o->overflow || o->len >= o->cap) {o->overflow = 1; return;}
+    o->buf[o->len++] = value;
+}
+
+static unsigned varint_size(uint64_t value)
+{
+    unsigned n = 1;
+    while (value >= 0x80) {value >>= 7; ++n;}
+    return n;
+}
+
+void spb_varint(SpbOut *o, uint64_t value)
+{
+    while (value >= 0x80) {
+        byte(o, (uint8_t)(value | 0x80));
+        value >>= 7;
+    }
+    byte(o, (uint8_t)value);
+}
+
+void spb_tag(SpbOut *o, uint32_t field, uint32_t wire)
+{
+    spb_varint(o, (uint64_t)field << 3 | (wire & 7));
+}
+
+void spb_put_varint(SpbOut *o, uint32_t field, uint64_t value)
+{
+    spb_tag(o, field, SPB_VARINT);
+    spb_varint(o, value);
+}
+
+void spb_put_int(SpbOut *o, uint32_t field, int64_t value)
+{
+    spb_tag(o, field, SPB_VARINT);
+    spb_varint(o, (uint64_t)value);   /* two's complement: a negative int32/enum is ten bytes */
+}
+
+void spb_put_fixed32(SpbOut *o, uint32_t field, uint32_t value)
+{
+    spb_tag(o, field, SPB_I32);
+    for (unsigned i = 0; i < 4; ++i) byte(o, (uint8_t)(value >> (8 * i)));
+}
+
+void spb_put_fixed64(SpbOut *o, uint32_t field, uint64_t value)
+{
+    spb_tag(o, field, SPB_I64);
+    for (unsigned i = 0; i < 8; ++i) byte(o, (uint8_t)(value >> (8 * i)));
+}
+
+void spb_put_bytes(SpbOut *o, uint32_t field, const void *data, uint32_t length)
+{
+    const uint8_t *bytes = (const uint8_t *)data;
+    spb_tag(o, field, SPB_LEN);
+    spb_varint(o, length);
+    for (uint32_t i = 0; i < length && bytes; ++i) byte(o, bytes[i]);
+    if (length && !bytes) o->overflow = 1;
+}
+
+void spb_put_string(SpbOut *o, uint32_t field, const char *text)
+{
+    uint32_t n = 0;
+    while (text && text[n] && n < 0xffffu) ++n;
+    spb_put_bytes(o, field, text, n);
+}
+
+uint32_t spb_open(SpbOut *o, uint32_t field)
+{
+    spb_tag(o, field, SPB_LEN);
+    const uint32_t mark = o->len;
+    byte(o, 0);   /* the length, one byte for now */
+    return o->overflow ? 0xffffffffu : mark;
+}
+
+void spb_close(SpbOut *o, uint32_t mark)
+{
+    if (o->overflow || mark == 0xffffffffu || mark >= o->len) {o->overflow = 1; return;}
+    const uint32_t length = o->len - mark - 1;
+    const unsigned need = varint_size(length);
+    if (need > 1) {
+        const uint32_t extra = need - 1;
+        if (o->len + extra > o->cap) {o->overflow = 1; return;}
+        for (uint32_t i = o->len; i > mark + 1; --i) o->buf[i - 1 + extra] = o->buf[i - 1];
+        o->len += extra;
+    }
+    uint64_t value = length;
+    for (unsigned i = 0; i < need; ++i) {
+        o->buf[mark + i] = (uint8_t)((value & 0x7f) | (i + 1 < need ? 0x80 : 0));
+        value >>= 7;
+    }
+}
+
+uint32_t spb_done(const SpbOut *o)
+{
+    return o->overflow ? 0 : o->len;
+}
+
+/* ---- decoder ---- */
+void spb_in(SpbIn *in, const uint8_t *data, uint32_t length)
+{
+    in->p = data;
+    in->end = data ? data + length : data;
+    in->error = 0;
+}
+
+static int fail(SpbIn *in)
+{
+    in->error = 1;
+    return -1;
+}
+
+static int read_varint(SpbIn *in, uint64_t *value)
+{
+    uint64_t v = 0;
+    for (unsigned shift = 0; shift < 70; shift += 7) {
+        if (in->p >= in->end) return fail(in);
+        const uint8_t b = *in->p++;
+        if (shift == 63 && b > 1) return fail(in);   /* more than 64 bits */
+        v |= (uint64_t)(b & 0x7f) << shift;
+        if (!(b & 0x80)) {*value = v; return 0;}
+    }
+    return fail(in);
+}
+
+int spb_next(SpbIn *in, uint32_t *field, uint32_t *wire)
+{
+    uint64_t tag = 0;
+    if (in->error) return -1;
+    if (in->p >= in->end) return 0;
+    if (read_varint(in, &tag)) return -1;
+    if (tag >> 3 == 0 || tag >> 3 > 0x1fffffffu) return fail(in);
+    *field = (uint32_t)(tag >> 3);
+    *wire = (uint32_t)(tag & 7);
+    return 1;
+}
+
+int spb_varint_value(SpbIn *in, uint32_t wire, uint64_t *value)
+{
+    if (wire != SPB_VARINT) return fail(in);
+    return read_varint(in, value);
+}
+
+int spb_fixed32_value(SpbIn *in, uint32_t wire, uint32_t *value)
+{
+    if (wire != SPB_I32 || in->end - in->p < 4) return fail(in);
+    *value = (uint32_t)in->p[0] | (uint32_t)in->p[1] << 8 | (uint32_t)in->p[2] << 16 | (uint32_t)in->p[3] << 24;
+    in->p += 4;
+    return 0;
+}
+
+int spb_fixed64_value(SpbIn *in, uint32_t wire, uint64_t *value)
+{
+    if (wire != SPB_I64 || in->end - in->p < 8) return fail(in);
+    uint64_t v = 0;
+    for (unsigned i = 0; i < 8; ++i) v |= (uint64_t)in->p[i] << (8 * i);
+    *value = v;
+    in->p += 8;
+    return 0;
+}
+
+int spb_bytes_value(SpbIn *in, uint32_t wire, const uint8_t **data, uint32_t *length)
+{
+    uint64_t n = 0;
+    if (wire != SPB_LEN || read_varint(in, &n)) return fail(in);
+    if (n > (uint64_t)(in->end - in->p)) return fail(in);
+    *data = in->p;
+    *length = (uint32_t)n;
+    in->p += n;
+    return 0;
+}
+
+int spb_skip(SpbIn *in, uint32_t wire)
+{
+    uint64_t v = 0;
+    const uint8_t *data = 0;
+    uint32_t n = 0;
+    switch (wire) {
+    case SPB_VARINT: return read_varint(in, &v);
+    case SPB_I64: if (in->end - in->p < 8) return fail(in); in->p += 8; return 0;
+    case SPB_I32: if (in->end - in->p < 4) return fail(in); in->p += 4; return 0;
+    case SPB_LEN: return spb_bytes_value(in, wire, &data, &n);
+    default: return fail(in);   /* groups (3, 4) and the reserved wire types */
+    }
+}
+
+int spb_fixed32_values(SpbIn *in, uint32_t wire, uint32_t *out, unsigned max, unsigned *count, unsigned *more)
+{
+    uint32_t value = 0;
+    if (wire == SPB_I32) {
+        if (spb_fixed32_value(in, wire, &value)) return -1;
+        if (*count < max) out[(*count)++] = value;
+        else if (more) (*more)++;
+        return 0;
+    }
+    const uint8_t *data = 0;
+    uint32_t n = 0;
+    if (wire != SPB_LEN || spb_bytes_value(in, wire, &data, &n) || n % 4) return fail(in);
+    for (uint32_t i = 0; i < n; i += 4) {
+        value = (uint32_t)data[i] | (uint32_t)data[i + 1] << 8 | (uint32_t)data[i + 2] << 16 | (uint32_t)data[i + 3] << 24;
+        if (*count < max) out[(*count)++] = value;
+        else if (more) (*more)++;
+    }
+    return 0;
+}
+
+int spb_varint_values(SpbIn *in, uint32_t wire, int64_t *out, unsigned max, unsigned *count, unsigned *more)
+{
+    uint64_t value = 0;
+    if (wire == SPB_VARINT) {
+        if (read_varint(in, &value)) return -1;
+        if (*count < max) out[(*count)++] = (int64_t)value;
+        else if (more) (*more)++;
+        return 0;
+    }
+    const uint8_t *data = 0;
+    uint32_t n = 0;
+    if (wire != SPB_LEN || spb_bytes_value(in, wire, &data, &n)) return fail(in);
+    SpbIn packed;
+    spb_in(&packed, data, n);
+    while (packed.p < packed.end) {
+        if (read_varint(&packed, &value)) return fail(in);
+        if (*count < max) out[(*count)++] = (int64_t)value;
+        else if (more) (*more)++;
+    }
+    return 0;
+}
diff --git a/xnu/fuxi-sensors/SensorsPb.h b/xnu/fuxi-sensors/SensorsPb.h
new file mode 100644
index 0000000..640166a
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsPb.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* Protocol buffers wire format (proto2), our own encoder and decoder for the Qualcomm sensor client messages (SensorsSsc.c). Written from
+ * the format's public definition: tag = field << 3 | wire type; varint (7 bits a byte, low first, the top bit continues), 64-bit and
+ * 32-bit little endian, length-delimited (a varint length, then the bytes). Kernel code: no allocation, no floating point (floats travel
+ * as their IEEE-754 bit patterns, SensorsFixed.h converts them), every write and read bounded.
+ *
+ * Encoder: an output buffer that records an overflow instead of writing past its end; nested messages are opened and closed in place
+ * (the length is written minimal, the content moved when it needs more than one byte). Decoder: a cursor over one message; unknown fields
+ * are skipped by their wire type, groups (wire types 3 and 4) are refused, a varint longer than ten bytes or anything past the end is an
+ * error. Repeated scalars are read packed and unpacked alike. */
+#ifndef SENSORS_PB_H
+#define SENSORS_PB_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {SPB_VARINT = 0, SPB_I64 = 1, SPB_LEN = 2, SPB_I32 = 5};
+
+typedef struct {
+    uint8_t *buf;
+    uint32_t cap, len;
+    int overflow;
+} SpbOut;
+
+void spb_out(SpbOut *o, uint8_t *buf, uint32_t cap);
+void spb_varint(SpbOut *o, uint64_t value);
+void spb_tag(SpbOut *o, uint32_t field, uint32_t wire);
+void spb_put_varint(SpbOut *o, uint32_t field, uint64_t value);            /* uint32/uint64/bool/enum >= 0 */
+void spb_put_int(SpbOut *o, uint32_t field, int64_t value);                /* int32/int64/enum: negative as a ten-byte varint */
+void spb_put_fixed32(SpbOut *o, uint32_t field, uint32_t value);           /* fixed32, float bits */
+void spb_put_fixed64(SpbOut *o, uint32_t field, uint64_t value);           /* fixed64, sfixed64 */
+void spb_put_bytes(SpbOut *o, uint32_t field, const void *data, uint32_t length);
+void spb_put_string(SpbOut *o, uint32_t field, const char *text);          /* the bytes up to the terminator (may be empty) */
+/* A nested message: spb_open writes the tag and returns a mark for spb_close, which writes the length. */
+uint32_t spb_open(SpbOut *o, uint32_t field);
+void spb_close(SpbOut *o, uint32_t mark);
+/* The encoded length, 0 after an overflow. */
+uint32_t spb_done(const SpbOut *o);
+
+typedef struct {
+    const uint8_t *p, *end;
+    int error;
+} SpbIn;
+
+void spb_in(SpbIn *in, const uint8_t *data, uint32_t length);
+/* The next field: 1 with its number and wire type, 0 at the end, -1 on an error (also recorded in in->error). */
+int spb_next(SpbIn *in, uint32_t *field, uint32_t *wire);
+/* The value of the field just announced by spb_next, by its wire type. 0 when read, -1 on an error or a wrong wire type. */
+int spb_varint_value(SpbIn *in, uint32_t wire, uint64_t *value);
+int spb_fixed32_value(SpbIn *in, uint32_t wire, uint32_t *value);
+int spb_fixed64_value(SpbIn *in, uint32_t wire, uint64_t *value);
+int spb_bytes_value(SpbIn *in, uint32_t wire, const uint8_t **data, uint32_t *length);
+int spb_skip(SpbIn *in, uint32_t wire);
+/* A repeated fixed32/float field, packed (wire 2, n x 4 bytes) or one element (wire 5): appended to out while count < max (the rest is
+ * counted in *more). 0 when read, -1 on an error. */
+int spb_fixed32_values(SpbIn *in, uint32_t wire, uint32_t *out, unsigned max, unsigned *count, unsigned *more);
+/* A repeated varint field, packed or one element, the same way. */
+int spb_varint_values(SpbIn *in, uint32_t wire, int64_t *out, unsigned max, unsigned *count, unsigned *more);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsRpc.c b/xnu/fuxi-sensors/SensorsRpc.c
new file mode 100644
index 0000000..0555f2d
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsRpc.c
@@ -0,0 +1,1767 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The FastRPC reverse file service of the sensor PD: see SensorsRpc.h. Single threaded (the service's own thread), except the two
+ * entry points the DSP thread calls, which only record. The arena is uncached memory the DSP reads and writes: every access goes through
+ * the byte helpers below, nothing assumes alignment. */
+#include "SensorsRpc.h"
+#include "SensorsText.h"
+
+enum {
+    /* the arena */
+    kMeta = 0,
+    kPrimIn = 0x400,
+    kPrimOut = 0x800,
+    kInBlob = 0x1000,
+    kInCapacity = 0xf000,
+    kOutBlob = 0x10000,
+    /* the protocol */
+    kHandleRemotectl = 0, kHandleInit = 1, kHandleListener = 3,
+    kLocalRemotectl = 0, kLocalStd = 1, kLocalMem = 2,
+    kMethodAttach = 0, kMethodMmap = 4, kMethodInit2 = 3, kMethodNext2 = 4, kMethodOpen = 0, kMethodClose = 1,
+    kExtended = 31,                    /* the method id is the first word of in buffer 0 */
+    kFdBytes = 16 * 8, kCrcBytes = 64 * 4,
+    kPage = 0x1000,
+    kAddPages = 0x1000,                /* apps_mem rflags: the application processor gives the pages */
+    kMapMethod = 2, kUnmapMethod = 3,
+    kMaxBuffers = 8,
+    /* the patience */
+    kInvokeMs = 5000,
+    kAttachTries = 120,
+    kOpenTries = 16,
+    kRetryMs = 1000,
+    /* The event ring is shared and small (32 KiB, about 250 records): what is missing matters most. Lines per boot: */
+    kBudget = 40, kOpenLines = 32, kMissingLines = 64, kSummaries = 6,
+    kSummaryMs = 10000,                /* the DSP quiet this long after some work: one summary line */
+    kErrorLength = 64,
+    /* ephemeral in-RAM overlay (never touches disk) */
+    kOvSlots = 512,
+    kOvBlocks = 1024,
+    kOvBlockBytes = 512,
+    kOvMaxFile = kOvBlocks * kOvBlockBytes,
+    kBlockFree = 0xFFFFu,
+    kBlockEnd = 0xFFFEu,
+};
+enum {OvFree = 0, OvActive = 1, OvDeleted = 2, OvUnlinked = 3};
+static const uint64_t kDefaultMtime = 1230768000ull; /* matches odm sensor config json mtime in sns_reg_config */
+enum {PhaseChannel, PhasePack, PhaseAttach, PhaseOpen, PhaseRegister, PhaseClose, PhaseInit, PhaseServe, PhaseStopped};
+enum {InvokeOk = 0, InvokeRefused = -1, InvokeTimeout = -2, InvokeLink = -3};
+
+typedef struct {
+    uint8_t state;
+    uint8_t flags;
+    uint16_t head;
+    uint16_t open_refs;
+    uint32_t size;
+    uint64_t mtime;
+    char path[SSP_PATH];
+} SsrOvEntry;
+
+typedef struct {
+    SsrOvEntry slots[kOvSlots];
+    uint16_t next[kOvBlocks];
+    uint8_t data[kOvBlocks][kOvBlockBytes];
+} SsrRamFs;
+
+#define SC(method, in, out) ((uint32_t)(method) << 24 | (uint32_t)(in) << 16 | (uint32_t)(out) << 8)
+#define CTX (c->ops->context)
+
+typedef struct {
+    uint32_t offset, length;
+} Arg;
+typedef struct {
+    uint8_t *p;
+    uint32_t n;
+} Buf;
+typedef struct {
+    Buf in[kMaxBuffers], out[kMaxBuffers];
+    unsigned in_count, out_count;
+    uint32_t method;
+} Call;
+
+static void put32(uint8_t *p, uint32_t v) {for (unsigned i = 0; i < 4; ++i) p[i] = (uint8_t)(v >> (8 * i));}
+static void put64(uint8_t *p, uint64_t v) {for (unsigned i = 0; i < 8; ++i) p[i] = (uint8_t)(v >> (8 * i));}
+static uint32_t get32(const uint8_t *p) {return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;}
+static uint64_t get64(const uint8_t *p) {return (uint64_t)get32(p) | (uint64_t)get32(p + 4) << 32;}
+static void clear(uint8_t *p, uint32_t n) {for (uint32_t i = 0; i < n; ++i) p[i] = 0;}
+static void copy(uint8_t *to, const uint8_t *from, uint32_t n) {for (uint32_t i = 0; i < n; ++i) to[i] = from[i];}
+static int same(const char *a, const char *b)
+{
+    uint32_t i = 0;
+    for (; a[i] && a[i] == b[i]; ++i) {}
+    return a[i] == b[i];
+}
+static void copy_str(char *dst, uint32_t cap, const char *src)
+{
+    if (!cap) return;
+    uint32_t i = 0;
+    for (; i + 1 < cap && src[i]; ++i) dst[i] = src[i];
+    dst[i] = 0;
+}
+static uint64_t now(SsrCore *c) {return c->ops->now_ms(CTX);}
+
+/* ---- the log ---- */
+static SntText *begin(SsrCore *c, SntText *t, const char *what)
+{
+    snt_start(t, c->line, sizeof c->line);
+    snt_str(t, "[sensors] rpc ");
+    snt_str(t, what);
+    return t;
+}
+static void end(SsrCore *c)
+{
+    if (c->ops->trace) c->ops->trace(CTX, c->line);
+}
+static int ordinary(SsrCore *c)
+{
+    if (c->cfg.log >= 2) return 1;
+    if (!c->cfg.log || !c->budget) return 0;
+    c->budget--;
+    return 1;
+}
+/* Within a counter of its own (always with pagani-sensors-log=2, never with 0). */
+static int rationed(SsrCore *c, unsigned *lines, unsigned limit)
+{
+    if (c->cfg.log >= 2) return 1;
+    if (!c->cfg.log || *lines >= limit) return 0;
+    (*lines)++;
+    return 1;
+}
+static void text_of(SntText *t, const uint8_t *p, uint32_t n)
+{
+    for (uint32_t i = 0; i < n && p[i]; ++i) snt_char(t, p[i] >= 32 && p[i] < 127 ? (char)p[i] : '.');
+}
+
+static void summary(SsrCore *c)
+{
+    SntText t;
+    c->summary_due = 0;
+    if (!rationed(c, &c->summary_lines, kSummaries)) return;
+    begin(c, &t, "quiet");
+    snt_kd(&t, "calls", c->status.calls);
+    snt_kd(&t, "opens", c->status.opens);
+    snt_kd(&t, "missing", c->status.missing);
+    snt_kd(&t, "reads", c->status.reads);
+    snt_kd(&t, "writes", c->status.writes);
+    snt_kd(&t, "bytes", (int64_t)c->status.bytes);
+    snt_kd(&t, "refused", c->status.refused);
+    snt_kd(&t, "unknown", c->status.unknown);
+    snt_kd(&t, "heap", c->status.heap_used);
+    end(c);
+}
+
+/* The service stops for good: the stage, the reason. */
+static int stop(SsrCore *c, int32_t stage, int32_t error, const char *why)
+{
+    SntText t;
+    c->status.stage = -stage;
+    c->status.error = error;
+    c->phase = PhaseStopped;
+    begin(c, &t, "FAIL");
+    snt_kd(&t, "st", -stage);
+    snt_kd(&t, "err", error);
+    snt_char(&t, ' ');
+    snt_str(&t, why);
+    end(c);
+    return 0;
+}
+
+/* ---- the DSP thread's two entry points ---- */
+void ssr_core_channel(SsrCore *c, int up)
+{
+    __atomic_store_n(&c->link_up, up ? 1u : 0u, __ATOMIC_RELEASE);
+    __atomic_fetch_add(&c->link_changes, 1u, __ATOMIC_RELEASE);
+}
+
+void ssr_core_receive(SsrCore *c, const uint8_t *data, uint32_t length)
+{
+    if (length < 12) return;
+    uint64_t ctx = 0;
+    uint32_t value = 0;
+    for (unsigned i = 0; i < 8; ++i) ctx |= (uint64_t)data[i] << (8 * i);
+    for (unsigned i = 0; i < 4; ++i) value |= (uint32_t)data[8 + i] << (8 * i);
+    __atomic_store_n(&c->response_value, (int32_t)value, __ATOMIC_RELEASE);
+    __atomic_store_n(&c->response_ctx, ctx, __ATOMIC_RELEASE);
+    __atomic_fetch_add(&c->responses, 1u, __ATOMIC_RELEASE);
+}
+
+/* ---- one invoke ---- */
+static uint64_t bus(const SsrCore *c, uint64_t pa) {return (uint64_t)c->cfg.bank << 32 | pa;}
+
+/* The metadata of n buffers at the start of the arena; the buffers (arena offsets) in place. */
+static void metadata(SsrCore *c, const Arg *args, uint32_t n)
+{
+    uint8_t *a = c->cfg.arena + kMeta;
+    const uint32_t list = n * 16, pages = list + n * 8;
+    clear(a, pages + n * 16 + kFdBytes + kCrcBytes);
+    for (uint32_t i = 0; i < n; ++i) {
+        put32(a + list + i * 8 + 4, i);
+        if (!args[i].length) continue;
+        const uint64_t pa = c->cfg.arena_pa + args[i].offset;
+        const uint64_t first = pa & ~(uint64_t)(kPage - 1), last = (pa + args[i].length - 1) & ~(uint64_t)(kPage - 1);
+        put64(a + i * 16, pa);
+        put64(a + i * 16 + 8, args[i].length);
+        put32(a + list + i * 8, 1);
+        put64(a + pages + i * 16, bus(c, first));
+        put64(a + pages + i * 16 + 8, last - first + kPage);
+    }
+}
+
+/* kernel: the bring-up's invokes carry process id 0. timeout 0: as long as it takes (next2). */
+static int invoke(SsrCore *c, int kernel, uint32_t handle, uint32_t sc, const Arg *args, uint32_t timeout_ms, int32_t *value)
+{
+    const uint32_t n = ((sc >> 16) & 0xff) + ((sc >> 8) & 0xff);
+    uint8_t message[SSR_MESSAGE];
+    c->next_id = c->next_id >= 255 ? 1 : c->next_id + 1;
+    const uint64_t ctx = (uint64_t)c->next_id << 8 | SSR_PD_SENSORS;
+    if (n) metadata(c, args, n);
+    put32(message, kernel ? 0 : c->cfg.process);
+    put32(message + 4, c->cfg.process);
+    put64(message + 8, ctx);
+    put32(message + 16, handle);
+    put32(message + 20, sc);
+    put64(message + 24, n ? bus(c, c->cfg.arena_pa + kMeta) : 0);
+    put64(message + 32, n ? kPage : 0);
+    uint32_t seen = __atomic_load_n(&c->responses, __ATOMIC_ACQUIRE);
+    if (c->ops->publish) c->ops->publish(CTX);
+    if (c->ops->send(CTX, message, sizeof message)) return InvokeRefused;
+    const uint64_t since = now(c);
+    for (;;) {
+        const uint32_t responses = __atomic_load_n(&c->responses, __ATOMIC_ACQUIRE);
+        if (responses != seen) {
+            seen = responses;
+            if (__atomic_load_n(&c->response_ctx, __ATOMIC_ACQUIRE) == ctx) {
+                *value = __atomic_load_n(&c->response_value, __ATOMIC_ACQUIRE);
+                return InvokeOk;
+            }
+            c->stray++;
+            continue;
+        }
+        if (__atomic_load_n(&c->link_changes, __ATOMIC_ACQUIRE) != c->seen_changes) return InvokeLink;
+        uint32_t ms = 1000;
+        const uint64_t waited = now(c) - since;
+        if (timeout_ms) {
+            if (waited >= timeout_ms) return InvokeTimeout;
+            if (timeout_ms - waited < ms) ms = (uint32_t)(timeout_ms - waited);
+        } else if (c->summary_due && waited >= kSummaryMs) {
+            summary(c);
+        }
+        c->ops->wait(CTX, ms);
+    }
+}
+
+/* ---- the pack ---- */
+static void empty_pack(SsrCore *c, const char *why)
+{
+    SntText t;
+    c->pack.table = 0;
+    c->pack.count = 0;
+    begin(c, &t, "no file pack (");
+    snt_str(&t, why);
+    snt_str(&t, "): every open fails, the paths the DSP asks for are logged");
+    end(c);
+}
+
+static void load_pack(SsrCore *c, uint64_t size)
+{
+    SspHeader h;
+    SntText t;
+    uint8_t *header = c->cfg.bounce;
+    if (size < SSP_HEADER || c->ops->pack_read(CTX, 0, header, SSP_HEADER)) return empty_pack(c, "unreadable");
+    if (ssp_header(header, SSP_HEADER, &h) || h.total != size) return empty_pack(c, "not a pack, or truncated");
+    const uint32_t bytes = ssp_table_bytes(&h);
+    uint8_t *table = (uint8_t *)c->ops->alloc(CTX, bytes);
+    if (!table) return empty_pack(c, "no memory for its table");
+    for (uint32_t done = 0; done < bytes;) {
+        const uint32_t chunk = bytes - done < SSR_BOUNCE ? bytes - done : SSR_BOUNCE;
+        if (c->ops->pack_read(CTX, SSP_HEADER + done, table + done, chunk)) return empty_pack(c, "table unreadable");
+        done += chunk;
+    }
+    if (ssp_open(&c->pack, &h, table)) return empty_pack(c, "bad table");
+    const int override = ssp_find(&c->pack, SSR_LIBRARY_PATH_FILE);
+    if (override >= 0) {
+        SspEntry e;
+        ssp_entry(&c->pack, (uint32_t)override, &e);
+        if (e.size && e.size < sizeof c->library_path && !c->ops->pack_read(CTX, e.offset, c->library_path, (uint32_t)e.size)) {
+            uint32_t n = (uint32_t)e.size;
+            while (n && (c->library_path[n - 1] == '\n' || !c->library_path[n - 1])) n--;
+            c->library_path[n] = 0;
+        }
+    }
+    if (ordinary(c)) {
+        begin(c, &t, "pack");
+        snt_kd(&t, "entries", h.count);
+        snt_kd(&t, "bytes", (int64_t)h.total);
+        snt_ks(&t, "libraries", c->library_path);
+        end(c);
+    }
+}
+
+/* ---- the file calls ---- */
+static void ram_reset(SsrRamFs *fs)
+{
+    for (uint32_t i = 0; i < kOvSlots; ++i) {
+        fs->slots[i].state = OvFree;
+        fs->slots[i].flags = 0;
+        fs->slots[i].head = (uint16_t)kBlockEnd;
+        fs->slots[i].open_refs = 0;
+        fs->slots[i].size = 0;
+        fs->slots[i].mtime = kDefaultMtime;
+        fs->slots[i].path[0] = 0;
+    }
+    for (uint32_t i = 0; i < kOvBlocks; ++i) fs->next[i] = (uint16_t)kBlockFree;
+}
+
+static SsrRamFs *ram_ensure(SsrCore *c)
+{
+    if (c->ram_fs) return (SsrRamFs *)c->ram_fs;
+    if (!c->ops->alloc) return 0;
+    SsrRamFs *fs = (SsrRamFs *)c->ops->alloc(CTX, (uint32_t)sizeof(SsrRamFs));
+    if (!fs) return 0;
+    ram_reset(fs);
+    c->ram_fs = fs;
+    return fs;
+}
+
+static int ram_find(const SsrCore *c, const char *path)
+{
+    const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+    if (!fs) return -1;
+    for (uint32_t i = 0; i < kOvSlots; ++i) {
+        if ((fs->slots[i].state == OvActive || fs->slots[i].state == OvDeleted) && same(fs->slots[i].path, path))
+            return (int)i;
+    }
+    return -1;
+}
+
+static int ram_alloc_slot(const SsrRamFs *fs)
+{
+    for (uint32_t i = 0; i < kOvSlots; ++i) {
+        if (fs->slots[i].state == OvFree) return (int)i;
+    }
+    return -1;
+}
+
+static uint32_t ram_free_block_count(const SsrRamFs *fs)
+{
+    uint32_t count = 0;
+    for (uint32_t i = 0; i < kOvBlocks; ++i) {
+        if (fs->next[i] == kBlockFree) count++;
+    }
+    return count;
+}
+
+static uint16_t ram_alloc_block(SsrRamFs *fs)
+{
+    for (uint32_t i = 0; i < kOvBlocks; ++i) {
+        if (fs->next[i] == kBlockFree) {
+            fs->next[i] = (uint16_t)kBlockEnd;
+            clear(fs->data[i], kOvBlockBytes);
+            return (uint16_t)i;
+        }
+    }
+    return (uint16_t)kBlockFree;
+}
+
+static void ram_free_blocks(SsrRamFs *fs, SsrOvEntry *ov)
+{
+    uint16_t block = ov->head;
+    for (uint32_t guard = 0; block < kOvBlocks && guard < kOvBlocks; ++guard) {
+        const uint16_t next = fs->next[block];
+        fs->next[block] = (uint16_t)kBlockFree;
+        block = next;
+    }
+    ov->head = (uint16_t)kBlockEnd;
+    ov->size = 0;
+}
+
+static int32_t ram_ensure_blocks(SsrRamFs *fs, SsrOvEntry *ov, uint32_t need_bytes)
+{
+    if (need_bytes > kOvMaxFile) return SSR_ENOMEMORY;
+    const uint32_t need_blocks = (need_bytes + kOvBlockBytes - 1u) / kOvBlockBytes;
+    if (!need_blocks) return SSR_OK;
+    uint32_t have = 0;
+    uint16_t last = (uint16_t)kBlockEnd;
+    uint16_t cur = ov->head;
+    while (cur < kOvBlocks && have < kOvBlocks) {
+        last = cur;
+        cur = fs->next[cur];
+        have++;
+    }
+    if (have >= need_blocks) return SSR_OK;
+    const uint32_t add = need_blocks - have;
+    if (ram_free_block_count(fs) < add) return SSR_ENOMEMORY;
+    for (uint32_t i = 0; i < add; ++i) {
+        const uint16_t nb = ram_alloc_block(fs);
+        if (nb >= kOvBlocks) return SSR_ENOMEMORY;
+        if (last < kOvBlocks) fs->next[last] = nb;
+        else ov->head = nb;
+        last = nb;
+    }
+    return SSR_OK;
+}
+
+static void ram_read(const SsrRamFs *fs, const SsrOvEntry *ov, uint64_t pos, uint8_t *to, uint32_t n)
+{
+    if (!n) return;
+    uint32_t skip = (uint32_t)(pos / kOvBlockBytes);
+    uint32_t off = (uint32_t)(pos % kOvBlockBytes);
+    uint16_t block = ov->head;
+    while (skip && block < kOvBlocks) {
+        block = fs->next[block];
+        skip--;
+    }
+    uint32_t done = 0;
+    while (done < n && block < kOvBlocks) {
+        const uint32_t room = kOvBlockBytes - off;
+        const uint32_t chunk = (n - done) < room ? (n - done) : room;
+        copy(to + done, fs->data[block] + off, chunk);
+        done += chunk;
+        off = 0;
+        block = fs->next[block];
+    }
+}
+
+static int32_t ram_write(SsrRamFs *fs, SsrOvEntry *ov, uint64_t pos, const uint8_t *from, uint32_t n)
+{
+    if (pos > kOvMaxFile || n > kOvMaxFile - pos) return SSR_ENOMEMORY;
+    const uint32_t end_pos = (uint32_t)(pos + n);
+    if (end_pos > ov->size) {
+        const int32_t rc = ram_ensure_blocks(fs, ov, end_pos);
+        if (rc) return rc;
+    }
+    if (n) {
+        uint32_t skip = (uint32_t)(pos / kOvBlockBytes);
+        uint32_t off = (uint32_t)(pos % kOvBlockBytes);
+        uint16_t block = ov->head;
+        while (skip && block < kOvBlocks) {
+            block = fs->next[block];
+            skip--;
+        }
+        uint32_t done = 0;
+        while (done < n && block < kOvBlocks) {
+            const uint32_t room = kOvBlockBytes - off;
+            const uint32_t chunk = (n - done) < room ? (n - done) : room;
+            copy(fs->data[block] + off, from + done, chunk);
+            done += chunk;
+            off = 0;
+            block = fs->next[block];
+        }
+    }
+    if (end_pos > ov->size) ov->size = end_pos;
+    return SSR_OK;
+}
+
+static int32_t ram_trunc(SsrRamFs *fs, SsrOvEntry *ov, uint32_t new_size)
+{
+    if (new_size == 0) {
+        ram_free_blocks(fs, ov);
+        return SSR_OK;
+    }
+    if (new_size > ov->size) {
+        const int32_t rc = ram_ensure_blocks(fs, ov, new_size);
+        if (rc) return rc;
+        ov->size = new_size;
+        return SSR_OK;
+    }
+    if (new_size < ov->size) {
+        const uint32_t keep = (new_size + kOvBlockBytes - 1u) / kOvBlockBytes;
+        uint16_t block = ov->head;
+        for (uint32_t i = 1; i < keep && block < kOvBlocks; ++i) block = fs->next[block];
+        if (block < kOvBlocks) {
+            const uint32_t tail_off = new_size % kOvBlockBytes;
+            if (tail_off) clear(fs->data[block] + tail_off, kOvBlockBytes - tail_off);
+            uint16_t drop = fs->next[block];
+            fs->next[block] = (uint16_t)kBlockEnd;
+            for (uint32_t guard = 0; drop < kOvBlocks && guard < kOvBlocks; ++guard) {
+                const uint16_t next = fs->next[drop];
+                fs->next[drop] = (uint16_t)kBlockFree;
+                drop = next;
+            }
+        }
+        ov->size = new_size;
+    }
+    return SSR_OK;
+}
+
+static int32_t ram_copy_from_pack(SsrCore *c, SsrRamFs *fs, int pack_idx, SsrOvEntry *ov)
+{
+    SspEntry e;
+    ssp_entry(&c->pack, (uint32_t)pack_idx, &e);
+    if (e.size > kOvMaxFile) return SSR_ENOMEMORY;
+    if (e.size) {
+        const int32_t rc = ram_ensure_blocks(fs, ov, (uint32_t)e.size);
+        if (rc) return rc;
+        for (uint32_t done = 0; done < (uint32_t)e.size;) {
+            const uint32_t chunk = (uint32_t)e.size - done < SSR_BOUNCE ? (uint32_t)e.size - done : SSR_BOUNCE;
+            if (c->ops->pack_read(CTX, e.offset + done, c->cfg.bounce, chunk)) return SSR_EFAILED;
+            const int32_t wrc = ram_write(fs, ov, done, c->cfg.bounce, chunk);
+            if (wrc) return wrc;
+            done += chunk;
+        }
+    }
+    ov->size = (uint32_t)e.size;
+    ov->mtime = kDefaultMtime;
+    return SSR_OK;
+}
+
+static SsrFile *file_of(SsrCore *c, uint32_t fd)
+{
+    const uint32_t i = fd - 16;
+    return i < SSR_FILES && c->file[i].used ? &c->file[i] : 0;
+}
+
+static uint64_t file_size(const SsrCore *c, const SsrFile *f)
+{
+    if (f->is_ram) {
+        const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+        return fs && f->entry < kOvSlots ? fs->slots[f->entry].size : 0;
+    }
+    SspEntry e;
+    ssp_entry(&c->pack, f->entry, &e);
+    return e.size;
+}
+
+static void missing(SsrCore *c, const char *what, const char *path)
+{
+    SntText t;
+    c->status.missing++;
+    if (!c->status.note[0]) {
+        snt_start(&t, c->status.note, sizeof c->status.note);
+        snt_str(&t, path);
+    }
+    if (rationed(c, &c->missing_lines, kMissingLines)) {
+        begin(c, &t, what);
+        snt_char(&t, ' ');
+        snt_str(&t, path);
+        end(c);
+    }
+}
+
+static int32_t open_entry(SsrCore *c, const char *path, int index, uint32_t *fd)
+{
+    SntText t;
+    SspEntry e;
+    ssp_entry(&c->pack, (uint32_t)index, &e);
+    if (e.flags & SSP_DIRECTORY) return SSR_EFAILED;
+    for (uint32_t i = 0; i < SSR_FILES; ++i) {
+        if (c->file[i].used) continue;
+        c->file[i].used = 1;
+        c->file[i].is_ram = 0;
+        c->file[i].writable = 0;
+        c->file[i].append = 0;
+        c->file[i].entry = (uint32_t)index;
+        c->file[i].position = 0;
+        *fd = i + 16;
+        c->status.opens++;
+        if (rationed(c, &c->open_lines, kOpenLines)) {
+            begin(c, &t, "open ");
+            snt_str(&t, path);
+            snt_kd(&t, "bytes", (int64_t)e.size);
+            end(c);
+        }
+        return SSR_OK;
+    }
+    return SSR_ENOMEMORY;
+}
+
+static int32_t open_ram_entry(SsrCore *c, const char *path, int slot, uint8_t writable, uint8_t append, uint32_t *fd)
+{
+    SntText t;
+    SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+    if (!fs || slot < 0 || slot >= kOvSlots) return SSR_EFAILED;
+    SsrOvEntry *ov = &fs->slots[slot];
+    if (ov->state != OvActive || (ov->flags & SSP_DIRECTORY)) return SSR_EFAILED;
+    for (uint32_t i = 0; i < SSR_FILES; ++i) {
+        if (c->file[i].used) continue;
+        c->file[i].used = 1;
+        c->file[i].is_ram = 1;
+        c->file[i].writable = writable;
+        c->file[i].append = append;
+        c->file[i].entry = (uint32_t)slot;
+        c->file[i].position = append ? ov->size : 0;
+        ov->open_refs++;
+        *fd = i + 16;
+        c->status.opens++;
+        if (rationed(c, &c->open_lines, kOpenLines)) {
+            begin(c, &t, writable ? "open-w " : "open-r ");
+            snt_str(&t, path);
+            snt_kd(&t, "bytes", (int64_t)ov->size);
+            end(c);
+        }
+        return SSR_OK;
+    }
+    return SSR_ENOMEMORY;
+}
+
+/* A string argument: its bytes end with their NUL. */
+static int text_arg(const Buf *b)
+{
+    return b->n > 0 && b->n < SSP_PATH * 4 && b->p[b->n - 1] == 0;
+}
+
+static int write_mode(const Buf *mode)
+{
+    for (uint32_t i = 0; i + 1 < mode->n; ++i) if (mode->p[i] == 'w' || mode->p[i] == 'a' || mode->p[i] == '+') return 1;
+    return 0;
+}
+
+static int parse_mode(const Buf *mode, uint8_t *want_write, uint8_t *want_create, uint8_t *want_trunc, uint8_t *want_append)
+{
+    *want_write = *want_create = *want_trunc = *want_append = 0;
+    if (mode->n < 2) return -1;
+    const uint8_t c0 = mode->p[0];
+    int has_plus = 0;
+    for (uint32_t i = 1; i + 1 < mode->n; ++i) {
+        if (mode->p[i] == '+') has_plus = 1;
+    }
+    if (c0 == 'r') {
+        *want_write = (uint8_t)has_plus;
+        return 0;
+    }
+    if (c0 == 'w') {
+        *want_write = 1;
+        *want_create = 1;
+        *want_trunc = 1;
+        return 0;
+    }
+    if (c0 == 'a') {
+        *want_write = 1;
+        *want_create = 1;
+        *want_append = 1;
+        return 0;
+    }
+    return -1;
+}
+
+static int32_t refuse(SsrCore *c, const char *what, const Buf *name)
+{
+    SntText t;
+    c->status.refused++;
+    if (ordinary(c)) {
+        begin(c, &t, "refused ");
+        snt_str(&t, what);
+        if (name) {snt_char(&t, ' '); text_of(&t, name->p, name->n);}
+        end(c);
+    }
+    return SSR_EUNSUPPORTED;
+}
+
+static int32_t std_open(SsrCore *c, const Buf *name, const Buf *mode, uint32_t *fd)
+{
+    char path[SSP_PATH];
+    uint8_t want_write = 0, want_create = 0, want_trunc = 0, want_append = 0;
+    if (!text_arg(name) || !text_arg(mode)) return SSR_EBADPARM;
+    if (parse_mode(mode, &want_write, &want_create, &want_trunc, &want_append) < 0) return SSR_EBADPARM;
+    if (ssp_path((const char *)name->p, name->n, path, sizeof path) < 0) return SSR_EFAILED;
+    const int ov_idx = ram_find(c, path);
+    SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+    const int exists_ov = (fs && ov_idx >= 0 && fs->slots[ov_idx].state == OvActive);
+    const int whiteout = (fs && ov_idx >= 0 && fs->slots[ov_idx].state == OvDeleted);
+    const int pack_idx = (!exists_ov && !whiteout) ? ssp_find(&c->pack, path) : -1;
+    if (!want_write) {
+        if (exists_ov) return open_ram_entry(c, path, ov_idx, 0, 0, fd);
+        if (pack_idx >= 0) return open_entry(c, path, pack_idx, fd);
+        missing(c, "missing", path);
+        return SSR_EFAILED;
+    }
+    fs = ram_ensure(c);
+    if (!fs) return SSR_ENOMEMORY;
+    if (exists_ov) {
+        SsrOvEntry *ov = &fs->slots[ov_idx];
+        if (ov->flags & SSP_DIRECTORY) return SSR_EFAILED;
+        if (want_trunc) ram_free_blocks(fs, ov);
+        ov->mtime = kDefaultMtime;
+        return open_ram_entry(c, path, ov_idx, 1, want_append, fd);
+    }
+    if (pack_idx >= 0) {
+        SspEntry pe;
+        ssp_entry(&c->pack, (uint32_t)pack_idx, &pe);
+        if (pe.flags & SSP_DIRECTORY) return SSR_EFAILED;
+        const int slot = ram_alloc_slot(fs);
+        if (slot < 0) return SSR_ENOMEMORY;
+        SsrOvEntry *ov = &fs->slots[slot];
+        ov->state = OvActive;
+        ov->flags = 0;
+        ov->head = (uint16_t)kBlockEnd;
+        ov->open_refs = 0;
+        ov->size = 0;
+        ov->mtime = kDefaultMtime;
+        copy_str(ov->path, sizeof ov->path, path);
+        if (!want_trunc) {
+            const int32_t rc = ram_copy_from_pack(c, fs, pack_idx, ov);
+            if (rc) {
+                ram_free_blocks(fs, ov);
+                ov->state = OvFree;
+                ov->path[0] = 0;
+                return rc;
+            }
+        }
+        return open_ram_entry(c, path, slot, 1, want_append, fd);
+    }
+    if (!want_create) {
+        missing(c, "missing", path);
+        return SSR_EFAILED;
+    }
+    const int slot = whiteout ? ov_idx : ram_alloc_slot(fs);
+    if (slot < 0) return SSR_ENOMEMORY;
+    SsrOvEntry *ov = &fs->slots[slot];
+    ov->state = OvActive;
+    ov->flags = 0;
+    ov->head = (uint16_t)kBlockEnd;
+    ov->open_refs = 0;
+    ov->size = 0;
+    ov->mtime = kDefaultMtime;
+    copy_str(ov->path, sizeof ov->path, path);
+    return open_ram_entry(c, path, slot, 1, want_append, fd);
+}
+
+static int32_t std_open_env(SsrCore *c, const Buf *env, const Buf *name, const Buf *mode, uint32_t *fd)
+{
+    char joined[SSP_PATH], path[SSP_PATH];
+    if (!text_arg(env) || !text_arg(name) || !text_arg(mode)) return SSR_EBADPARM;
+    if (name->p[0] == '/') return std_open(c, name, mode, fd);
+    if (write_mode(mode)) return refuse(c, "write open", name);
+    const char *list = same((const char *)env->p, "ADSP_AVS_CFG_PATH") ? "/vendor/etc/acdbdata" : c->library_path;
+    for (uint32_t at = 0;;) {
+        uint32_t n = 0;
+        while (list[at] && list[at] != ';' && n + 1 < sizeof joined) joined[n++] = list[at++];
+        if (n + 1 + name->n <= sizeof joined) {
+            joined[n++] = '/';
+            copy((uint8_t *)joined + n, name->p, name->n);
+            if (ssp_path(joined, n + name->n, path, sizeof path) >= 0) {
+                const int ov_idx = ram_find(c, path);
+                const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+                if (fs && ov_idx >= 0) {
+                    if (fs->slots[ov_idx].state == OvActive) return open_ram_entry(c, path, ov_idx, 0, 0, fd);
+                } else {
+                    const int index = ssp_find(&c->pack, path);
+                    if (index >= 0) return open_entry(c, path, index, fd);
+                }
+            }
+        }
+        while (list[at] && list[at] != ';') at++;
+        if (!list[at]) break;
+        at++;
+    }
+    SntText t;
+    snt_start(&t, joined, sizeof joined);
+    snt_char(&t, '$');
+    text_of(&t, env->p, env->n);
+    snt_char(&t, '/');
+    text_of(&t, name->p, name->n);
+    missing(c, "missing", joined);
+    return SSR_EFAILED;
+}
+
+/* n bytes of the pack at offset into the arena. */
+static int32_t read_bytes(SsrCore *c, uint64_t offset, uint8_t *to, uint32_t n)
+{
+    for (uint32_t done = 0; done < n;) {
+        const uint32_t chunk = n - done < SSR_BOUNCE ? n - done : SSR_BOUNCE;
+        if (c->ops->pack_read(CTX, offset + done, c->cfg.bounce, chunk)) return SSR_EFAILED;
+        copy(to + done, c->cfg.bounce, chunk);
+        done += chunk;
+    }
+    return SSR_OK;
+}
+
+static int32_t std_read(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 1 || k->in[0].n < 8 || k->out_count < 2 || k->out[0].n < 8) return SSR_EBADPARM;
+    SsrFile *f = file_of(c, get32(k->in[0].p));
+    const uint32_t asked = get32(k->in[0].p + 4);
+    if (!f || asked > k->out[1].n) return SSR_EBADPARM;
+    const uint64_t size = file_size(c, f);
+    const uint64_t left = f->position < size ? size - f->position : 0;
+    const uint32_t n = left < asked ? (uint32_t)left : asked;
+    if (f->is_ram) {
+        const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+        if (!fs || f->entry >= kOvSlots) return SSR_EFAILED;
+        ram_read(fs, &fs->slots[f->entry], f->position, k->out[1].p, n);
+    } else {
+        SspEntry e;
+        ssp_entry(&c->pack, f->entry, &e);
+        const int32_t rc = read_bytes(c, e.offset + f->position, k->out[1].p, n);
+        if (rc) return rc;
+    }
+    f->position += n;
+    c->status.reads++;
+    c->status.bytes += n;
+    put32(k->out[0].p, n);
+    put32(k->out[0].p + 4, n < asked);
+    return SSR_OK;
+}
+
+static int32_t std_fwrite(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 2 || k->in[0].n < 8 || k->out_count < 1 || k->out[0].n < 8) return SSR_EBADPARM;
+    SsrFile *f = file_of(c, get32(k->in[0].p));
+    const uint32_t count = get32(k->in[0].p + 4);
+    if (!f || count > k->in[1].n) return SSR_EBADPARM;
+    if (!f->is_ram || !f->writable) return SSR_EFAILED;
+    SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+    if (!fs || f->entry >= kOvSlots) return SSR_EFAILED;
+    SsrOvEntry *ov = &fs->slots[f->entry];
+    if (ov->state != OvActive && ov->state != OvUnlinked) return SSR_EFAILED;
+    if (f->append) f->position = ov->size;
+    const int32_t rc = ram_write(fs, ov, f->position, k->in[1].p, count);
+    if (rc) return rc;
+    f->position += count;
+    c->status.writes++;
+    c->status.bytes += count;
+    put32(k->out[0].p, count);
+    put32(k->out[0].p + 4, 0);
+    return SSR_OK;
+}
+
+static int32_t std_ftrunc(SsrCore *c, const Call *k)
+{
+    /* extended method 32: in[0]+0 is method id, +4 is fd, +8 is new length */
+    if (k->in_count < 1 || k->in[0].n < 12) return SSR_EBADPARM;
+    SsrFile *f = file_of(c, get32(k->in[0].p + 4));
+    const int32_t new_len = (int32_t)get32(k->in[0].p + 8);
+    if (!f || new_len < 0) return SSR_EBADPARM;
+    if (!f->is_ram || !f->writable) return SSR_EFAILED;
+    SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+    if (!fs || f->entry >= kOvSlots) return SSR_EFAILED;
+    SsrOvEntry *ov = &fs->slots[f->entry];
+    if (ov->state != OvActive && ov->state != OvUnlinked) return SSR_EFAILED;
+    return ram_trunc(fs, ov, (uint32_t)new_len);
+}
+
+static int32_t std_gets(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 1 || k->in[0].n < 8 || k->out_count < 2 || k->out[0].n < 4) return SSR_EBADPARM;
+    SsrFile *f = file_of(c, get32(k->in[0].p));
+    uint32_t asked = get32(k->in[0].p + 4);
+    if (!f || asked > k->out[1].n) return SSR_EBADPARM;
+    const uint64_t size = file_size(c, f);
+    if (!asked || f->position >= size) {
+        put32(k->out[0].p, 1);
+        return SSR_OK;
+    }
+    if (asked > SSR_BOUNCE) asked = SSR_BOUNCE;
+    const uint64_t left = size - f->position;
+    uint32_t n = left < asked - 1 ? (uint32_t)left : asked - 1;
+    if (n) {
+        if (f->is_ram) {
+            const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+            if (!fs || f->entry >= kOvSlots) return SSR_EFAILED;
+            ram_read(fs, &fs->slots[f->entry], f->position, c->cfg.bounce, n);
+        } else {
+            SspEntry e;
+            ssp_entry(&c->pack, f->entry, &e);
+            if (c->ops->pack_read(CTX, e.offset + f->position, c->cfg.bounce, n)) return SSR_EFAILED;
+        }
+    }
+    for (uint32_t i = 0; i < n; ++i) if (c->cfg.bounce[i] == '\n') {n = i + 1; break;}
+    copy(k->out[1].p, c->cfg.bounce, n);
+    k->out[1].p[n] = 0;
+    f->position += n;
+    put32(k->out[0].p, 0);
+    return SSR_OK;
+}
+
+static int32_t std_seek(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 1 || k->in[0].n < 12) return SSR_EBADPARM;
+    SsrFile *f = file_of(c, get32(k->in[0].p));
+    if (!f) return SSR_EBADPARM;
+    const uint64_t size = file_size(c, f);
+    const int64_t offset = (int32_t)get32(k->in[0].p + 4);
+    const uint32_t whence = get32(k->in[0].p + 8);
+    const int64_t base = whence == 0 ? 0 : whence == 1 ? (int64_t)f->position : whence == 2 ? (int64_t)size : -1;
+    if (base < 0 || base + offset < 0) return SSR_EFAILED;
+    f->position = (uint64_t)(base + offset);
+    return SSR_OK;
+}
+
+static int32_t std_position(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 1 || k->in[0].n < 4) return SSR_EBADPARM;
+    SsrFile *f = file_of(c, get32(k->in[0].p));
+    if (!f) return SSR_EBADPARM;
+    const uint64_t size = file_size(c, f);
+    switch (k->method) {
+    case 8:                                       /* ftell */
+        if (k->out_count < 1 || k->out[0].n < 4) return SSR_EBADPARM;
+        put32(k->out[0].p, (uint32_t)f->position);
+        return SSR_OK;
+    case 10:                                      /* flen */
+        if (k->out_count < 1 || k->out[0].n < 8) return SSR_EBADPARM;
+        put64(k->out[0].p, size);
+        return SSR_OK;
+    case 11:                                      /* rewind */
+        f->position = 0;
+        return SSR_OK;
+    case 12:                                      /* feof */
+        if (k->out_count < 1 || k->out[0].n < 4) return SSR_EBADPARM;
+        put32(k->out[0].p, f->position >= size);
+        return SSR_OK;
+    default:                                      /* ferror (13): there are none */
+        if (k->out_count < 1 || k->out[0].n < 4) return SSR_EBADPARM;
+        put32(k->out[0].p, 0);
+        return SSR_OK;
+    }
+}
+
+static int32_t std_close(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 1 || k->in[0].n < 4) return SSR_EBADPARM;
+    SsrFile *f = file_of(c, get32(k->in[0].p));
+    if (!f) return SSR_EBADPARM;
+    if (f->is_ram && c->ram_fs && f->entry < kOvSlots) {
+        SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+        SsrOvEntry *ov = &fs->slots[f->entry];
+        if (ov->open_refs > 0) ov->open_refs--;
+        if (ov->open_refs == 0 && ov->state == OvUnlinked) {
+            ram_free_blocks(fs, ov);
+            ov->state = OvFree;
+            ov->flags = 0;
+            ov->path[0] = 0;
+        }
+    }
+    f->used = 0;
+    return SSR_OK;
+}
+
+static int32_t std_getenv(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 2 || !text_arg(&k->in[1]) || k->out_count < 2 || k->out[0].n < 4) return SSR_EBADPARM;
+    const char *name = (const char *)k->in[1].p;
+    const char *value = same(name, "ADSP_LIBRARY_PATH") || same(name, "DSP_LIBRARY_PATH") ? c->library_path :
+                        same(name, "ADSP_AVS_CFG_PATH") ? "/vendor/etc/acdbdata" : 0;
+    if (!value) return -1;                        /* as a libc getenv failure with errno 0 reads on Android */
+    uint32_t n = 0;
+    while (value[n]) n++;
+    put32(k->out[0].p, n + 1);
+    if (k->out[1].n) {
+        const uint32_t room = n + 1 < k->out[1].n ? n + 1 : k->out[1].n;
+        copy(k->out[1].p, (const uint8_t *)value, room - 1);
+        k->out[1].p[room - 1] = 0;
+    }
+    return SSR_OK;
+}
+
+static int32_t std_opendir(SsrCore *c, const Call *k)
+{
+    char path[SSP_PATH];
+    SspEntry e;
+    if (k->in_count < 2 || !text_arg(&k->in[1]) || k->out_count < 1 || k->out[0].n < 8) return SSR_EBADPARM;
+    if (ssp_path((const char *)k->in[1].p, k->in[1].n, path, sizeof path) < 0) return SSR_EFAILED;
+    const int ov_idx = ram_find(c, path);
+    const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+    int index = -1;
+    if (fs && ov_idx >= 0) {
+        if (fs->slots[ov_idx].state == OvDeleted) {
+            missing(c, "missing dir", path);
+            return SSR_EFAILED;
+        }
+        if (!(fs->slots[ov_idx].flags & SSP_DIRECTORY)) return SSR_EFAILED;
+        const int p_idx = ssp_find(&c->pack, path);
+        if (p_idx >= 0) {
+            ssp_entry(&c->pack, (uint32_t)p_idx, &e);
+            if (e.flags & SSP_DIRECTORY) index = p_idx;
+        }
+    } else {
+        index = ssp_find(&c->pack, path);
+        if (index < 0) {
+            missing(c, "missing dir", path);
+            return SSR_EFAILED;
+        }
+        ssp_entry(&c->pack, (uint32_t)index, &e);
+        if (!(e.flags & SSP_DIRECTORY)) return SSR_EFAILED;
+    }
+    for (uint32_t i = 0; i < SSR_DIRS; ++i) {
+        if (c->dir[i].used) continue;
+        c->dir[i].used = 1;
+        c->dir[i].has_pack = index >= 0 ? 1 : 0;
+        c->dir[i].entry = index >= 0 ? (uint32_t)index : 0;
+        c->dir[i].cursor = 0;
+        c->dir[i].ram_cursor = 0;
+        copy_str(c->dir[i].path, sizeof c->dir[i].path, path);
+        put64(k->out[0].p, i + 1);
+        return SSR_OK;
+    }
+    return SSR_ENOMEMORY;
+}
+
+static SsrDir *dir_of(SsrCore *c, const Call *k)
+{
+    if (k->in_count < 1 || k->in[0].n < 8) return 0;
+    const uint64_t handle = get64(k->in[0].p);
+    if (!handle || handle > SSR_DIRS || !c->dir[handle - 1].used) return 0;
+    return &c->dir[handle - 1];
+}
+
+static const char *direct_child(const char *dir_path, const char *cand)
+{
+    uint32_t n = 0;
+    while (dir_path[n]) n++;
+    if (n == 1 && dir_path[0] == '/') {
+        if (cand[0] != '/' || !cand[1]) return 0;
+        const char *leaf = cand + 1;
+        for (uint32_t i = 0; leaf[i]; ++i) if (leaf[i] == '/') return 0;
+        return leaf;
+    }
+    for (uint32_t i = 0; i < n; ++i) if (cand[i] != dir_path[i]) return 0;
+    if (cand[n] != '/' || !cand[n + 1]) return 0;
+    const char *leaf = cand + n + 1;
+    for (uint32_t i = 0; leaf[i]; ++i) if (leaf[i] == '/') return 0;
+    return leaf;
+}
+
+static int32_t std_readdir(SsrCore *c, const Call *k)
+{
+    SsrDir *d = dir_of(c, k);
+    SspEntry e;
+    const char *leaf = 0;
+    if (!d || k->out_count < 1 || k->out[0].n < 264) return SSR_EBADPARM;
+    if (d->has_pack) {
+        while (ssp_child(&c->pack, d->entry, &d->cursor, &e, &leaf) == 1) {
+            if (ram_find(c, e.name) >= 0) continue;
+            uint32_t n = 0;
+            for (; leaf[n] && n < 255; ++n) k->out[0].p[4 + n] = (uint8_t)leaf[n];
+            return SSR_OK;
+        }
+        d->has_pack = 0;
+    }
+    const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+    if (fs) {
+        while (d->ram_cursor < kOvSlots) {
+            const SsrOvEntry *ov = &fs->slots[d->ram_cursor++];
+            if (ov->state != OvActive) continue;
+            leaf = direct_child(d->path, ov->path);
+            if (!leaf) continue;
+            uint32_t n = 0;
+            for (; leaf[n] && n < 255; ++n) k->out[0].p[4 + n] = (uint8_t)leaf[n];
+            return SSR_OK;
+        }
+    }
+    put32(k->out[0].p + 260, 1);
+    return SSR_OK;
+}
+
+static int32_t std_closedir(SsrCore *c, const Call *k)
+{
+    SsrDir *d = dir_of(c, k);
+    if (!d) return SSR_EBADPARM;
+    d->used = 0;
+    return SSR_OK;
+}
+
+static int32_t std_stat(SsrCore *c, const Call *k)
+{
+    char path[SSP_PATH];
+    SspEntry e;
+    if (k->in_count < 2 || !text_arg(&k->in[1]) || k->out_count < 1 || k->out[0].n < 96) return SSR_EBADPARM;
+    if (ssp_path((const char *)k->in[1].p, k->in[1].n, path, sizeof path) < 0) return SSR_EFAILED;
+    const int ov_idx = ram_find(c, path);
+    const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+    uint64_t ino = 0, size = 0, mtime = kDefaultMtime;
+    uint32_t is_dir = 0;
+    if (fs && ov_idx >= 0) {
+        if (fs->slots[ov_idx].state == OvDeleted) {
+            missing(c, "missing stat", path);
+            return SSR_EFAILED;
+        }
+        ino = 0x10000ull + (uint64_t)ov_idx + 1ull;
+        is_dir = (fs->slots[ov_idx].flags & SSP_DIRECTORY) != 0;
+        size = fs->slots[ov_idx].size;
+        mtime = fs->slots[ov_idx].mtime;
+    } else {
+        const int index = ssp_find(&c->pack, path);
+        if (index < 0) {
+            missing(c, "missing stat", path);
+            return SSR_EFAILED;
+        }
+        ssp_entry(&c->pack, (uint32_t)index, &e);
+        ino = (uint64_t)index + 1ull;
+        is_dir = (e.flags & SSP_DIRECTORY) != 0;
+        size = e.size;
+    }
+    /* apps_std_STAT: tsz(0), dev(8), ino(16), mode(24), nlink(28), rdev(32), size(40),
+     * atime(48), atimensec(56), mtime(64), mtimensec(72), ctime(80), ctimensec(88) */
+    put64(k->out[0].p + 8, 1);
+    put64(k->out[0].p + 16, ino);
+    put32(k->out[0].p + 24, is_dir ? 040755u : 0100644u);
+    put32(k->out[0].p + 28, 1);
+    put64(k->out[0].p + 40, size);
+    put64(k->out[0].p + 48, mtime);
+    put64(k->out[0].p + 64, mtime);
+    put64(k->out[0].p + 80, mtime);
+    return SSR_OK;
+}
+
+static int32_t std_exists(SsrCore *c, const Call *k)
+{
+    char path[SSP_PATH];
+    if (k->in_count < 2 || !text_arg(&k->in[1]) || k->out_count < 1 || k->out[0].n < 1) return SSR_EBADPARM;
+    if (ssp_path((const char *)k->in[1].p, k->in[1].n, path, sizeof path) < 0) return SSR_EFAILED;
+    const int ov_idx = ram_find(c, path);
+    const SsrRamFs *fs = (const SsrRamFs *)c->ram_fs;
+    int found = 0;
+    if (fs && ov_idx >= 0) found = (fs->slots[ov_idx].state == OvActive);
+    else found = (ssp_find(&c->pack, path) >= 0);
+    k->out[0].p[0] = (uint8_t)found;
+    if (!found && c->cfg.log >= 2) missing(c, "exists no", path);
+    return SSR_OK;
+}
+
+static int32_t std_mkdir(SsrCore *c, const Call *k)
+{
+    char path[SSP_PATH];
+    SspEntry e;
+    if (k->in_count < 2 || !text_arg(&k->in[1])) return SSR_EBADPARM;
+    if (ssp_path((const char *)k->in[1].p, k->in[1].n, path, sizeof path) < 0) return SSR_EFAILED;
+    const int ov_idx = ram_find(c, path);
+    SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+    if (fs && ov_idx >= 0) {
+        if (fs->slots[ov_idx].state == OvActive) return (fs->slots[ov_idx].flags & SSP_DIRECTORY) ? SSR_OK : SSR_EFAILED;
+    } else {
+        const int index = ssp_find(&c->pack, path);
+        if (index >= 0) {
+            ssp_entry(&c->pack, (uint32_t)index, &e);
+            return (e.flags & SSP_DIRECTORY) ? SSR_OK : SSR_EFAILED;
+        }
+    }
+    fs = ram_ensure(c);
+    if (!fs) return SSR_ENOMEMORY;
+    const int slot = (ov_idx >= 0 && fs->slots[ov_idx].state == OvDeleted) ? ov_idx : ram_alloc_slot(fs);
+    if (slot < 0) return SSR_ENOMEMORY;
+    SsrOvEntry *ov = &fs->slots[slot];
+    ov->state = OvActive;
+    ov->flags = SSP_DIRECTORY;
+    ov->head = (uint16_t)kBlockEnd;
+    ov->open_refs = 0;
+    ov->size = 0;
+    ov->mtime = kDefaultMtime;
+    copy_str(ov->path, sizeof ov->path, path);
+    return SSR_OK;
+}
+
+static int32_t std_remove_entry(SsrCore *c, const Call *k, int expect_dir)
+{
+    char path[SSP_PATH];
+    SspEntry e;
+    if (k->in_count < 2 || !text_arg(&k->in[1])) return SSR_EBADPARM;
+    if (ssp_path((const char *)k->in[1].p, k->in[1].n, path, sizeof path) < 0) return SSR_EFAILED;
+    const int ov_idx = ram_find(c, path);
+    SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+    const int pack_idx = ssp_find(&c->pack, path);
+    if (fs && ov_idx >= 0) {
+        SsrOvEntry *ov = &fs->slots[ov_idx];
+        if (ov->state == OvDeleted) return SSR_EFAILED;
+        const int is_dir = (ov->flags & SSP_DIRECTORY) != 0;
+        if (is_dir != expect_dir) return SSR_EFAILED;
+        if (ov->open_refs == 0) {
+            ram_free_blocks(fs, ov);
+            ov->flags = 0;
+            if (pack_idx >= 0) ov->state = OvDeleted;
+            else {
+                ov->state = OvFree;
+                ov->path[0] = 0;
+            }
+            return SSR_OK;
+        }
+        int whiteout_slot = -1;
+        if (pack_idx >= 0) {
+            whiteout_slot = ram_alloc_slot(fs);
+            if (whiteout_slot < 0) return SSR_ENOMEMORY;
+        }
+        ov->state = OvUnlinked;
+        ov->path[0] = 0;
+        if (whiteout_slot >= 0) {
+            SsrOvEntry *wo = &fs->slots[whiteout_slot];
+            wo->state = OvDeleted;
+            wo->flags = 0;
+            wo->head = (uint16_t)kBlockEnd;
+            wo->open_refs = 0;
+            wo->size = 0;
+            wo->mtime = kDefaultMtime;
+            copy_str(wo->path, sizeof wo->path, path);
+        }
+        return SSR_OK;
+    }
+    if (pack_idx < 0) return SSR_EFAILED;
+    ssp_entry(&c->pack, (uint32_t)pack_idx, &e);
+    if (((e.flags & SSP_DIRECTORY) != 0) != expect_dir) return SSR_EFAILED;
+    fs = ram_ensure(c);
+    if (!fs) return SSR_ENOMEMORY;
+    const int slot = ram_alloc_slot(fs);
+    if (slot < 0) return SSR_ENOMEMORY;
+    SsrOvEntry *wo = &fs->slots[slot];
+    wo->state = OvDeleted;
+    wo->flags = 0;
+    wo->head = (uint16_t)kBlockEnd;
+    wo->open_refs = 0;
+    wo->size = 0;
+    wo->mtime = kDefaultMtime;
+    copy_str(wo->path, sizeof wo->path, path);
+    return SSR_OK;
+}
+
+static int32_t std_frename(SsrCore *c, const Call *k)
+{
+    char old_path[SSP_PATH], new_path[SSP_PATH];
+    if (k->in_count < 3 || !text_arg(&k->in[1]) || !text_arg(&k->in[2])) return SSR_EBADPARM;
+    if (ssp_path((const char *)k->in[1].p, k->in[1].n, old_path, sizeof old_path) < 0) return SSR_EFAILED;
+    if (ssp_path((const char *)k->in[2].p, k->in[2].n, new_path, sizeof new_path) < 0) return SSR_EFAILED;
+    int src_ov = ram_find(c, old_path);
+    SsrRamFs *fs = (SsrRamFs *)c->ram_fs;
+    const int src_pack = ssp_find(&c->pack, old_path);
+    const int src_in_ov = (fs && src_ov >= 0 && fs->slots[src_ov].state == OvActive);
+    const int src_deleted = (fs && src_ov >= 0 && fs->slots[src_ov].state == OvDeleted);
+    if (src_deleted || (!src_in_ov && src_pack < 0)) return SSR_EFAILED;
+    if (same(old_path, new_path)) return SSR_OK;
+    int src_is_dir = 0;
+    if (src_in_ov) {
+        src_is_dir = (fs->slots[src_ov].flags & SSP_DIRECTORY) != 0;
+    } else {
+        SspEntry pe;
+        ssp_entry(&c->pack, (uint32_t)src_pack, &pe);
+        src_is_dir = (pe.flags & SSP_DIRECTORY) != 0;
+        if (src_is_dir) return SSR_EUNSUPPORTED;
+    }
+    const int dst_ov = ram_find(c, new_path);
+    const int dst_pack = ssp_find(&c->pack, new_path);
+    if (fs && dst_ov >= 0 && fs->slots[dst_ov].state == OvActive) {
+        const int dst_is_dir = (fs->slots[dst_ov].flags & SSP_DIRECTORY) != 0;
+        if (dst_is_dir != src_is_dir) return SSR_EFAILED;
+    } else if (!(fs && dst_ov >= 0 && fs->slots[dst_ov].state == OvDeleted) && dst_pack >= 0) {
+        SspEntry de;
+        ssp_entry(&c->pack, (uint32_t)dst_pack, &de);
+        const int dst_is_dir = (de.flags & SSP_DIRECTORY) != 0;
+        if (dst_is_dir != src_is_dir) return SSR_EFAILED;
+    }
+    fs = ram_ensure(c);
+    if (!fs) return SSR_ENOMEMORY;
+    int created_src = 0;
+    if (!src_in_ov) {
+        src_ov = ram_alloc_slot(fs);
+        if (src_ov < 0) return SSR_ENOMEMORY;
+        SsrOvEntry *sov = &fs->slots[src_ov];
+        sov->state = OvActive;
+        sov->flags = 0;
+        sov->head = (uint16_t)kBlockEnd;
+        sov->open_refs = 0;
+        sov->size = 0;
+        sov->mtime = kDefaultMtime;
+        copy_str(sov->path, sizeof sov->path, old_path);
+        const int32_t rc = ram_copy_from_pack(c, fs, src_pack, sov);
+        if (rc) {
+            ram_free_blocks(fs, sov);
+            sov->state = OvFree;
+            sov->path[0] = 0;
+            return rc;
+        }
+        created_src = 1;
+    }
+    int whiteout_slot = -1;
+    if (src_pack >= 0) {
+        whiteout_slot = ram_alloc_slot(fs);
+        if (whiteout_slot < 0) {
+            if (created_src) {
+                ram_free_blocks(fs, &fs->slots[src_ov]);
+                fs->slots[src_ov].state = OvFree;
+                fs->slots[src_ov].path[0] = 0;
+            }
+            return SSR_ENOMEMORY;
+        }
+    }
+    if (dst_ov >= 0) {
+        SsrOvEntry *dov = &fs->slots[dst_ov];
+        if (dov->state == OvActive) {
+            if (dov->open_refs == 0) {
+                ram_free_blocks(fs, dov);
+                dov->state = OvFree;
+                dov->flags = 0;
+                dov->path[0] = 0;
+            } else {
+                dov->state = OvUnlinked;
+                dov->path[0] = 0;
+            }
+        } else if (dov->state == OvDeleted) {
+            dov->state = OvFree;
+            dov->path[0] = 0;
+        }
+    }
+    copy_str(fs->slots[src_ov].path, sizeof fs->slots[src_ov].path, new_path);
+    if (whiteout_slot >= 0) {
+        SsrOvEntry *wo = &fs->slots[whiteout_slot];
+        wo->state = OvDeleted;
+        wo->flags = 0;
+        wo->head = (uint16_t)kBlockEnd;
+        wo->open_refs = 0;
+        wo->size = 0;
+        wo->mtime = kDefaultMtime;
+        copy_str(wo->path, sizeof wo->path, old_path);
+    }
+    return SSR_OK;
+}
+
+static int32_t std_print(SsrCore *c, const Call *k)
+{
+    SntText t;
+    if (k->in_count < 2 || !k->in[1].n) return SSR_EBADPARM;
+    if (ordinary(c)) {
+        snt_start(&t, c->line, sizeof c->line);
+        snt_str(&t, "[sensors] dsp: ");
+        text_of(&t, k->in[1].p, k->in[1].n < 180 ? k->in[1].n : 180);
+        end(c);
+    }
+    return SSR_OK;
+}
+
+static int32_t apps_std(SsrCore *c, const Call *k)
+{
+    SntText t;
+    uint32_t fd = 0;
+    int32_t rc;
+    switch (k->method) {
+    case 0:                                       /* fopen(name, mode) */
+        if (k->in_count < 3 || k->out_count < 1 || k->out[0].n < 4) return SSR_EBADPARM;
+        rc = std_open(c, &k->in[1], &k->in[2], &fd);
+        if (!rc) put32(k->out[0].p, fd);
+        return rc;
+    case 2: case 14: case 17: case 18: case 23:   /* fflush, clearerr, setenv, unsetenv, fsync */
+        return SSR_OK;
+    case 3: return std_close(c, k);
+    case 4: return std_read(c, k);
+    case 5: return std_fwrite(c, k);
+    case 8: case 10: case 11: case 12: case 13: return std_position(c, k);
+    case 9: return std_seek(c, k);
+    case 15: return std_print(c, k);
+    case 16: return std_getenv(c, k);
+    case 19:                                      /* fopen_with_env(env, delimiter, name, mode) */
+        if (k->in_count < 5 || k->out_count < 1 || k->out[0].n < 4) return SSR_EBADPARM;
+        rc = std_open_env(c, &k->in[1], &k->in[3], &k->in[4], &fd);
+        if (!rc) put32(k->out[0].p, fd);
+        return rc;
+    case 20: return std_gets(c, k);
+    case 22: return std_exists(c, k);
+    case 24: return std_remove_entry(c, k, 0);
+    case 26: return std_opendir(c, k);
+    case 27: return std_closedir(c, k);
+    case 28: return std_readdir(c, k);
+    case 29: return std_mkdir(c, k);
+    case 30: return std_remove_entry(c, k, 1);
+    case 31: return std_stat(c, k);
+    case 32: return std_ftrunc(c, k);
+    case 33: return std_frename(c, k);
+    default:
+        c->status.unknown++;
+        if (ordinary(c)) {
+            begin(c, &t, "apps_std method");
+            snt_kd(&t, "id", k->method);
+            snt_str(&t, " unsupported");
+            end(c);
+        }
+        return SSR_EUNSUPPORTED;
+    }
+}
+
+/* ---- the other local interfaces ---- */
+static int32_t apps_remotectl(SsrCore *c, const Call *k)
+{
+    SntText t;
+    if (k->out_count < 2) return SSR_EBADPARM;
+    if (k->method == kMethodOpen) {
+        if (k->in_count < 2 || !text_arg(&k->in[1]) || k->out[0].n < 8) return SSR_EBADPARM;
+        const char *name = (const char *)k->in[1].p;
+        const uint32_t handle = same(name, "apps_std") ? kLocalStd : same(name, "apps_mem") ? kLocalMem : 0;
+        if (ordinary(c) || !handle) {
+            begin(c, &t, "dsp opens ");
+            text_of(&t, k->in[1].p, k->in[1].n);
+            if (!handle) snt_str(&t, ": no such interface here");
+            end(c);
+        }
+        if (!handle) {
+            c->status.unknown++;
+            return -5;                                /* Android's answer for an unknown name */
+        }
+        put32(k->out[0].p, handle);
+        return SSR_OK;
+    }
+    if (k->method == kMethodClose) return SSR_OK;
+    return SSR_EUNSUPPORTED;
+}
+
+/* map64: pages of the arena's heap, made known to the DSP's memory manager with the mmap method of the init handle. */
+static int32_t apps_mem(SsrCore *c, const Call *k)
+{
+    SntText t;
+    if (k->method == kUnmapMethod) return SSR_OK;     /* the pages stay the DSP's until reboot */
+    if (k->method != kMapMethod || k->in_count < 1 || k->in[0].n < 32 || k->out_count < 1 || k->out[0].n < 16) return SSR_EUNSUPPORTED;
+    const uint32_t rflags = get32(k->in[0].p + 8);
+    const uint64_t asked = get64(k->in[0].p + 24);
+    const uint64_t length = (asked + kPage - 1) & ~(uint64_t)(kPage - 1);
+    const uint32_t heap = c->cfg.arena_size > SSR_CALL_BYTES ? c->cfg.arena_size - SSR_CALL_BYTES : 0;
+    if (!(rflags & kAddPages) || !length || length > heap - c->heap_used) {
+        if (ordinary(c)) {
+            begin(c, &t, "apps_mem refused");
+            snt_kx(&t, "rflags", rflags);
+            snt_kx(&t, "bytes", asked);
+            snt_kx(&t, "used", c->heap_used);
+            end(c);
+        }
+        return SSR_ENOMEMORY;
+    }
+    uint8_t *a = c->cfg.arena;
+    const uint64_t pa = c->cfg.arena_pa + SSR_CALL_BYTES + c->heap_used;
+    clear(a + kPrimIn, 0x80);
+    put32(a + kPrimIn, c->cfg.process);
+    put32(a + kPrimIn + 4, rflags);
+    put32(a + kPrimIn + 16, 16);
+    put64(a + kPrimIn + 32, bus(c, pa));
+    put64(a + kPrimIn + 40, length);
+    const Arg args[3] = {{kPrimIn, 24}, {kPrimIn + 32, 16}, {kPrimOut, 8}};
+    int32_t value = 0;
+    const int rc = invoke(c, 1, kHandleInit, SC(kMethodMmap, 2, 1), args, kInvokeMs, &value);
+    if (rc || value) {
+        begin(c, &t, "apps_mem mmap failed");
+        snt_kd(&t, "rc", rc);
+        snt_kd(&t, "value", value);
+        end(c);
+        return SSR_EFAILED;
+    }
+    c->heap_used += (uint32_t)length;
+    c->status.heap_used = c->heap_used;
+    put64(k->out[0].p, 0);
+    put64(k->out[0].p + 8, get64(a + kPrimOut) & 0xffffffffu);
+    if (ordinary(c)) {
+        begin(c, &t, "apps_mem");
+        snt_kx(&t, "bytes", length);
+        snt_kx(&t, "pa", pa);
+        snt_kx(&t, "dsp", get64(a + kPrimOut));
+        end(c);
+    }
+    return SSR_OK;
+}
+
+/* ---- one call of the DSP ---- */
+/* The call's blob, length bytes at the in area: in buffers, then the out lengths; the answer's blob laid out, zeroed. */
+static int32_t unpack(SsrCore *c, uint32_t sc, uint32_t length, Call *k)
+{
+    uint8_t *blob = c->cfg.arena + kInBlob, *out = c->cfg.arena + kOutBlob;
+    const uint32_t capacity = SSR_CALL_BYTES - kOutBlob;
+    uint32_t at = 0, written = 0;
+    k->in_count = (sc >> 16) & 0xff;
+    k->out_count = (sc >> 8) & 0xff;
+    k->method = (sc >> 24) & 0x1f;
+    if (k->in_count > kMaxBuffers || k->out_count > kMaxBuffers || (sc & 0xff)) return SSR_EBADPARM;
+    for (unsigned i = 0; i < k->in_count; ++i) {
+        if (length - at < 4 || at > length) return SSR_EBADPARM;
+        const uint32_t n = get32(blob + at);
+        at += 4;
+        k->in[i].n = n;
+        k->in[i].p = blob;
+        if (!n) continue;
+        at = (at + 7) & ~7u;
+        if (at > length || n > length - at) return SSR_EBADPARM;
+        k->in[i].p = blob + at;
+        at += n;
+    }
+    for (unsigned i = 0; i < k->out_count; ++i) {
+        if (at > length || length - at < 4) return SSR_EBADPARM;
+        const uint32_t n = get32(blob + at);
+        at += 4;
+        if (written > capacity || capacity - written < 4) return SSR_ENOMEMORY;
+        put32(out + written, n);
+        written += 4;
+        k->out[i].n = n;
+        k->out[i].p = out;
+        if (!n) continue;
+        written = (written + 7) & ~7u;
+        if (written > capacity || n > capacity - written) return SSR_ENOMEMORY;
+        k->out[i].p = out + written;
+        clear(out + written, n);
+        written += n;
+    }
+    c->out_length = written;
+    if (k->method == kExtended) {
+        if (!k->in_count || k->in[0].n < 4) return SSR_EBADPARM;
+        k->method = get32(k->in[0].p);
+    }
+    return SSR_OK;
+}
+
+static int32_t call(SsrCore *c, uint32_t handle, uint32_t sc, uint32_t length)
+{
+    Call k;
+    SntText t;
+    c->out_length = 0;
+    if (length > kInCapacity) return SSR_EBADSIZE;
+    int32_t rc = unpack(c, sc, length, &k);
+    if (rc) return rc;
+    c->status.calls++;
+    switch (handle) {
+    case kLocalRemotectl: return apps_remotectl(c, &k);
+    case kLocalStd: return apps_std(c, &k);
+    case kLocalMem: return apps_mem(c, &k);
+    default:
+        c->status.unknown++;
+        if (ordinary(c)) {
+            begin(c, &t, "call on an unknown handle");
+            snt_kd(&t, "handle", handle);
+            snt_kx(&t, "sc", sc);
+            end(c);
+        }
+        return SSR_EUNSUPPORTED;
+    }
+}
+
+static int serve_one(SsrCore *c)
+{
+    SntText t;
+    uint8_t *a = c->cfg.arena;
+    int32_t value = 0;
+    put32(a + kPrimIn, c->rctx);
+    put32(a + kPrimIn + 4, (uint32_t)c->result);
+    put32(a + kPrimIn + 8, c->out_length);
+    put32(a + kPrimIn + 12, kInCapacity);
+    const Arg args[4] = {{kPrimIn, 16}, {kOutBlob, c->out_length}, {kPrimOut, 16}, {kInBlob, kInCapacity}};
+    const int rc = invoke(c, 0, kHandleListener, SC(kMethodNext2, 2, 2), args, 0, &value);
+    if (rc == InvokeLink) return 1;
+    if (rc) return stop(c, SsrStServing, rc, "next2 not sent");
+    c->out_length = 0;
+    if (value) {
+        if (value == SSR_EINTERRUPTED) {          /* the DSP restarted the wait: its context is gone */
+            c->rctx = 0;
+            c->result = -1;
+            return 1;
+        }
+        if (c->next_failures++) return stop(c, SsrStServing, value, "next2 failed twice");
+        begin(c, &t, "next2 failed");
+        snt_kd(&t, "value", value);
+        end(c);
+        c->result = value;
+        return 1;
+    }
+    c->next_failures = 0;
+    c->rctx = get32(a + kPrimOut);
+    const uint32_t handle = get32(a + kPrimOut + 4), sc = get32(a + kPrimOut + 8), length = get32(a + kPrimOut + 12);
+    if (c->status.stage == SsrStListen) {
+        c->status.stage = SsrStServing;
+        if (ordinary(c)) {
+            begin(c, &t, "first call of the DSP");
+            snt_kd(&t, "handle", handle);
+            snt_kx(&t, "sc", sc);
+            end(c);
+        }
+    }
+    c->result = call(c, handle, sc, length);
+    if (c->result) c->out_length = 0;
+    c->summary_due = 1;
+    return 1;
+}
+
+/* ---- the bring-up ---- */
+static void forget_session(SsrCore *c)
+{
+    for (uint32_t i = 0; i < SSR_FILES; ++i) c->file[i].used = 0;
+    for (uint32_t i = 0; i < SSR_DIRS; ++i) c->dir[i].used = 0;
+    if (c->ram_fs) ram_reset((SsrRamFs *)c->ram_fs);
+    c->heap_used = 0;
+    c->rctx = 0;
+    c->result = -1;
+    c->out_length = 0;
+    c->next_failures = 0;
+    c->tries = 0;
+    c->retry_at = 0;
+}
+
+static int attach(SsrCore *c)
+{
+    SntText t;
+    if (!c->prepared) {
+        const int error = c->ops->prepare ? c->ops->prepare(CTX) : 0;
+        if (error) return stop(c, SsrStSmmu, error, "the sensors PD's stream stays out of pass-through");
+        c->prepared = 1;
+        c->status.stage = SsrStSmmu;
+    }
+    const uint64_t at = now(c);
+    if (at < c->retry_at) {
+        c->ops->wait(CTX, (uint32_t)(c->retry_at - at));
+        return 1;
+    }
+    int32_t value = 0;
+    put32(c->cfg.arena + kPrimIn, c->cfg.process);
+    const Arg arg = {kPrimIn, 4};
+    c->status.attaches++;
+    const int rc = invoke(c, 1, kHandleInit, SC(kMethodAttach, 1, 0), &arg, kInvokeMs, &value);
+    if (rc == InvokeLink) return 1;
+    if (!rc && !value) {
+        c->status.stage = SsrStAttach;
+        c->tries = 0;
+        c->phase = PhaseOpen;
+        if (ordinary(c)) {
+            begin(c, &t, "attached to the sensors PD");
+            snt_kx(&t, "pa", c->cfg.arena_pa);
+            snt_kd(&t, "bank", c->cfg.bank);
+            snt_kd(&t, "ms", (int64_t)(at - c->started_ms));
+            end(c);
+        }
+        return 1;
+    }
+    c->tries++;
+    c->retry_at = at + kRetryMs;
+    if (c->tries <= 3 || !(c->tries % 16)) {
+        begin(c, &t, "attach");
+        snt_str(&t, rc == InvokeTimeout ? " unanswered" : rc ? " not sent" : " refused");
+        snt_kd(&t, "value", value);
+        snt_kd(&t, "tries", c->tries);
+        end(c);
+    }
+    if (c->tries >= kAttachTries) return stop(c, SsrStAttach, rc ? rc : value, "the sensors PD never took the attach");
+    return 1;
+}
+
+static int open_listener(SsrCore *c)
+{
+    static const char name[] = "adsp_default_listener";
+    SntText t;
+    uint8_t *a = c->cfg.arena;
+    int32_t value = 0;
+    clear(a + kPrimOut, 16 + kErrorLength);
+    put32(a + kPrimIn, sizeof name);
+    put32(a + kPrimIn + 4, kErrorLength);
+    copy(a + kPrimIn + 16, (const uint8_t *)name, sizeof name);
+    const Arg args[4] = {{kPrimIn, 8}, {kPrimIn + 16, sizeof name}, {kPrimOut, 8}, {kPrimOut + 16, kErrorLength}};
+    const int rc = invoke(c, 0, kHandleRemotectl, SC(kMethodOpen, 2, 2), args, kInvokeMs, &value);
+    if (rc == InvokeLink) return 1;
+    if (!rc && !value && !get32(a + kPrimOut + 4)) {
+        c->listener_handle = get32(a + kPrimOut);
+        c->tries = 0;
+        c->phase = PhaseRegister;
+        return 1;
+    }
+    c->tries++;
+    begin(c, &t, "remotectl open failed");
+    snt_kd(&t, "rc", rc);
+    snt_kd(&t, "value", value);
+    snt_kd(&t, "dlerr", (int32_t)get32(a + kPrimOut + 4));
+    snt_char(&t, ' ');
+    text_of(&t, a + kPrimOut + 16, kErrorLength);
+    end(c);
+    if (c->tries >= kOpenTries) return stop(c, SsrStRegister, rc ? rc : value, "adsp_default_listener did not open");
+    c->ops->wait(CTX, kRetryMs);
+    return 1;
+}
+
+static int register_listener(SsrCore *c)
+{
+    int32_t value = 0;
+    const int rc = invoke(c, 0, c->listener_handle, SC(0, 0, 0), 0, kInvokeMs, &value);
+    if (rc == InvokeLink) return 1;
+    if (rc || value) return stop(c, SsrStRegister, rc ? rc : value, "adsp_default_listener register failed");
+    c->status.stage = SsrStRegister;
+    c->phase = PhaseClose;
+    return 1;
+}
+
+static int close_handle(SsrCore *c)
+{
+    uint8_t *a = c->cfg.arena;
+    int32_t value = 0;
+    put32(a + kPrimIn, c->listener_handle);
+    put32(a + kPrimIn + 4, 0);
+    const Arg args[3] = {{kPrimIn, 8}, {kPrimOut, 4}, {kPrimOut + 16, 0}};
+    const int rc = invoke(c, 0, kHandleRemotectl, SC(kMethodClose, 1, 2), args, kInvokeMs, &value);
+    if (rc == InvokeLink) return 1;
+    c->phase = PhaseInit;                         /* a close that failed changes nothing */
+    return 1;
+}
+
+static int listener_init(SsrCore *c)
+{
+    SntText t;
+    int32_t value = 0;
+    const int rc = invoke(c, 0, kHandleListener, SC(kMethodInit2, 0, 0), 0, kInvokeMs, &value);
+    if (rc == InvokeLink) return 1;
+    if (rc || value) return stop(c, SsrStListen, rc ? rc : value, "adsp_listener init2 failed");
+    c->status.stage = SsrStListen;
+    c->rctx = 0;
+    c->result = -1;
+    c->out_length = 0;
+    c->phase = PhaseServe;
+    if (ordinary(c)) {
+        begin(c, &t, "listening");
+        snt_kd(&t, "ms", (int64_t)(now(c) - c->started_ms));
+        end(c);
+    }
+    return 1;
+}
+
+void ssr_core_init(SsrCore *c, const SsrOps *ops, const SsrConfig *config)
+{
+    uint8_t *b = (uint8_t *)c;
+    for (uint32_t i = 0; i < sizeof *c; ++i) b[i] = 0;
+    c->ops = ops;
+    c->cfg = *config;
+    c->budget = kBudget;
+    c->phase = PhaseChannel;
+    c->result = -1;
+    c->started_ms = now(c);
+    SntText t;
+    snt_start(&t, c->library_path, sizeof c->library_path);
+    snt_str(&t, SSR_LIBRARY_PATH);
+}
+
+int ssr_core_step(SsrCore *c)
+{
+    SntText t;
+    const uint32_t changes = __atomic_load_n(&c->link_changes, __ATOMIC_ACQUIRE);
+    if (changes != c->seen_changes) {
+        c->seen_changes = changes;
+        if (c->phase > PhaseChannel && c->phase != PhaseStopped) {
+            begin(c, &t, "channel went away: the session is over");
+            end(c);
+            forget_session(c);
+            c->phase = PhaseChannel;
+            c->status.stage = SsrStChannel;
+        }
+    }
+    switch (c->phase) {
+    case PhaseChannel:
+        if (!__atomic_load_n(&c->link_up, __ATOMIC_ACQUIRE)) {
+            c->ops->wait(CTX, kRetryMs);
+            return 1;
+        }
+        c->status.stage = SsrStChannel;
+        if (ordinary(c)) {
+            begin(c, &t, "channel up");
+            snt_kd(&t, "ms", (int64_t)(now(c) - c->started_ms));
+            end(c);
+        }
+        c->phase = c->pack_done ? PhaseAttach : PhasePack;
+        c->pack_since = now(c);
+        return 1;
+    case PhasePack: {
+        uint64_t size = 0;
+        const int rc = c->ops->pack_size(CTX, &size);
+        if (rc == SsrPackNotYet) {
+            if (now(c) - c->pack_since < SSR_PACK_WAIT_MS) {
+                c->ops->wait(CTX, kRetryMs);
+                return 1;
+            }
+            empty_pack(c, "the Data volume never came");
+        } else if (rc == SsrPackOk) {
+            load_pack(c, size);
+        } else {
+            empty_pack(c, rc == SsrPackAbsent ? "no such file" : "unreadable");
+        }
+        c->pack_done = 1;
+        c->status.stage = SsrStPack;
+        c->phase = PhaseAttach;
+        return 1;
+    }
+    case PhaseAttach: return attach(c);
+    case PhaseOpen: return open_listener(c);
+    case PhaseRegister: return register_listener(c);
+    case PhaseClose: return close_handle(c);
+    case PhaseInit: return listener_init(c);
+    case PhaseServe: return serve_one(c);
+    default: return 0;
+    }
+}
diff --git a/xnu/fuxi-sensors/SensorsRpc.h b/xnu/fuxi-sensors/SensorsRpc.h
new file mode 100644
index 0000000..5f31718
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsRpc.h
@@ -0,0 +1,169 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The FastRPC reverse file service of the ADSP's sensor protection domain. The sensor PD reads its registry and configuration from the
+ * application processor: on Android /vendor/bin/sensors.qti (the daemon adsp_default_listener) attaches to the sensors PD and serves
+ * apps_std file calls to it; without that the physical sensor drivers get no bus, interrupt or calibration and the SUID lookups find
+ * no accel (build-userspace/a830-inputs/sensors/ssc-facts.md 6.1). This is that daemon in the kernel, portable C over a table of
+ * operations (PaganiSensorsRpc.cpp gives the kernel's, Test/rpc.c a simulated DSP). Everything here is facts of the public protocol,
+ * written from the descriptions in Qualcomm's BSD-3 fastrpc (its IDL files, inc/listener_buf.h) and Linux's fastrpc.c and hexagonrpc read for
+ * facts only; no code was taken.
+ *
+ * Transport. One GLINK channel, "fastrpcglink-apps-dsp" (the DSP opens it). An invoke is a 40-byte message
+ *   s32 pid, s32 tid, u64 ctx, u32 handle, u32 sc, u64 addr, u64 size
+ * answered by { u64 ctx, s32 retval } (longer forms exist; the first twelve bytes are the same). ctx: our number << 8 | the PD (2: the
+ * sensors PD). sc: attr << 29 | method << 24 | in buffers << 16 | out buffers << 8 | in handles << 4 | out handles. addr: the buffer of the
+ * invoke's metadata: the context bank in bits 39:32 (compute-cb@2 of the 13T's devicetree: reg 4, pd-type 3 for the sensors PD, stream
+ * ids 0x1004/0x1044 in the apps SMMU) over the DMA address, which is the physical address here: those streams are in pass-through
+ * (the same planner as UFS, touch and speaker) and the DSP takes 32-bit addresses, so the arena lies below 4 GiB, outside XNU's memory.
+ * The metadata, for n = in + out buffers (each array packed):
+ *   n { u64 pv, u64 len }, n { u32 num, u32 pgidx }, n { u64 addr, u64 size }, 16 u64 fds, 64 u32 crcs
+ * a buffer's pages are { addr & ~0xfff, whole 4 KiB pages }, the low twelve bits of pv its offset in the first one.
+ *
+ * Bring-up (each step an invoke on a fixed handle):
+ *   attach    handle 1, method 0, in: u32 our process id, pid 0 in the message; from here on the messages carry that process id
+ *   open      handle 0 (remotectl), method 0, in {name length, error length} + name, out {handle, error} + error text: "adsp_default_listener"
+ *   register  that handle, method 0, no arguments; then remotectl close (method 1)
+ *   init2     handle 3 (adsp_listener), method 3, no arguments
+ *   next2     handle 3, method 4, in {previous ctx, previous result, previous out bytes, in capacity} + previous out buffers, out {ctx,
+ *             handle, sc, in bytes} + the next call's in buffers. It blocks until the DSP calls us. First with ctx 0, result -1.
+ * The DSP's call, packed: each in buffer u32 length, (when not empty) aligned to 8, its bytes; then one u32 length per out buffer (unaligned
+ * after the last in buffer). The answer: each out buffer u32 length (exactly what was asked), aligned to 8, its bytes; nothing at all when
+ * the result is not 0. Alignment counts from the start of the blob. A method id above 30 goes as method 31 with the id as the first word
+ * of in buffer 0.
+ *
+ * Local interfaces (the DSP's handles). 0 remotectl: open(name) gives the handles below, an unknown name -5 (logged: what is missing shows
+ * in the boot log). 1 apps_std: the read-only file calls below, over the pack (SensorsPack.h). 2 apps_mem: pages of the arena's heap
+ * for the DSP (map64 with ADD_PAGES, through the mmap method 4 of handle 1). The apps_std calls: fopen, fopen_with_env (a relative name
+ * searched in ADSP_LIBRARY_PATH), fclose, fread, fgets, fseek, ftell, flen, rewind, feof, ferror, clearerr, fflush, fsync, opendir, readdir,
+ * closedir, stat, fileExists, getenv, setenv, unsetenv, print_string, mkdir of what exists. Writes are refused (as hexagonrpcd does; the
+ * pack holds the registry Android generated).
+ *
+ * What is proven: nothing here has met a real DSP. Test/rpc.c holds the layouts to the facts above byte by byte; the first run with the
+ * phone decides the rest (see build-userspace/a830-inputs/sensors/build-report.md). */
+#ifndef SENSORS_RPC_H
+#define SENSORS_RPC_H
+#include <stdint.h>
+#include "SensorsPack.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SSR_CHANNEL "fastrpcglink-apps-dsp"
+#define SSR_INTENT_SIZE 0x181u          /* the devicetree's qcom,intents: 385 bytes */
+#define SSR_INTENT_COUNT 24u            /* PAGANI_ADSP_MAX_INTENTS (Android offers 64) */
+#define SSR_CONTEXT_BANK 4u             /* compute-cb@2 reg, the sensors PD's (Android): bits 39:32 of every address the DSP gets */
+#define SSR_PD_SENSORS 2u
+#define SSR_MESSAGE 40u
+#define SSR_ARENA_BYTES 0x800000u       /* the arena: 2 MiB for the calls (blobs up to about 1.9 MiB), the rest the DSP's heap (apps_mem) */
+#define SSR_CALL_BYTES 0x200000u
+#define SSR_BOUNCE 0x10000u             /* normal memory the pack is read through */
+#define SSR_LIBRARY_PATH "/vendor/dsp/adsp;/vendor/dsp;/vendor/lib/rfsa/adsp;/odm/lib/rfsa/adsp;/vendor/dsp/sensors"
+#define SSR_LIBRARY_PATH_FILE "/.pagani/library_path"   /* in the pack: overrides it (Android's own ADSP_LIBRARY_PATH) */
+#define SSR_PACK_WAIT_MS 240000u        /* longest wait for the Data volume before going on with an empty pack */
+
+/* Results towards the DSP (AEEStdErr.h). */
+enum {SSR_OK = 0, SSR_EFAILED = 1, SSR_ENOMEMORY = 2, SSR_EBADPARM = 14, SSR_EUNSUPPORTED = 20, SSR_EBADSIZE = 0x4d, SSR_EINTERRUPTED = 46};
+/* Stages; the status's stage is the last one reached, or minus the one that failed. */
+enum {
+    SsrStOff = 0, SsrStChannel = 1, SsrStPack = 2, SsrStSmmu = 3, SsrStAttach = 4, SsrStRegister = 5, SsrStListen = 6, SsrStServing = 7,
+};
+enum {SsrPackOk = 0, SsrPackNotYet = 1, SsrPackAbsent = 2, SsrPackError = -1};
+
+typedef struct {
+    void *context;
+    uint64_t (*now_ms)(void *context);
+    /* One message on the channel: 0 queued. */
+    int (*send)(void *context, const uint8_t *message, uint32_t length);
+    /* Sleeps up to ms; a response or a channel change wakes it. */
+    void (*wait)(void *context, uint32_t ms);
+    void (*trace)(void *context, const char *line);
+    /* What was written to the arena is visible to the DSP (a barrier). */
+    void (*publish)(void *context);
+    /* Once, before the first attach: the sensors PD's streams in pass-through. 0, or the error that stops the service. Late on purpose: the
+     * SMMU planner has no lock, and by then the boot's other users (UFS, touch) have long finished theirs. */
+    int (*prepare)(void *context);
+    /* The pack file: its size (SsrPack*). */
+    int (*pack_size)(void *context, uint64_t *size);
+    /* length bytes at offset into normal memory: 0, or nonzero. */
+    int (*pack_read)(void *context, uint64_t offset, void *to, uint32_t length);
+    /* Memory for the pack's table, never freed. */
+    void *(*alloc)(void *context, uint32_t bytes);
+} SsrOps;
+
+typedef struct {
+    uint8_t *arena;                    /* mapped uncached: everything the DSP sees */
+    uint64_t arena_pa;                 /* physical, below 4 GiB */
+    uint32_t arena_size;
+    uint8_t *bounce;                   /* SSR_BOUNCE bytes of normal memory */
+    uint32_t process;                  /* our process id on the DSP */
+    uint32_t bank;                     /* the context bank (SSR_CONTEXT_BANK; Linux takes the first free one, so 3 is worth a try too) */
+    uint32_t log;                      /* 0 failures, 1 rationed, 2 more */
+} SsrConfig;
+
+enum {SSR_FILES = 32, SSR_DIRS = 8};
+typedef struct {
+    int used;
+    uint8_t is_ram;
+    uint8_t writable;
+    uint8_t append;
+    uint32_t entry;
+    uint64_t position;
+} SsrFile;
+typedef struct {
+    int used;
+    uint8_t has_pack;
+    uint32_t entry, cursor;
+    uint32_t ram_cursor;
+    char path[SSP_PATH];
+} SsrDir;
+
+typedef struct {
+    int32_t stage, error;
+    uint32_t attaches, calls, opens, missing, reads, writes, refused, unknown;
+    uint64_t bytes;
+    uint32_t heap_used;
+    char note[80];                     /* the first path that was missing */
+} SsrStatus;
+
+typedef struct {
+    const SsrOps *ops;
+    SsrConfig cfg;
+    /* set on the DSP thread, read here */
+    volatile uint32_t link_up, link_changes, responses;
+    volatile uint64_t response_ctx;
+    volatile int32_t response_value;
+    /* the thread's */
+    int phase;
+    uint32_t seen_changes, seen_responses;
+    uint32_t next_id, stray;
+    uint64_t started_ms, retry_at, pack_since;
+    uint32_t tries;
+    int pack_done, prepared;
+    SspPack pack;
+    void *ram_fs;
+    SsrFile file[SSR_FILES];
+    SsrDir dir[SSR_DIRS];
+    uint32_t heap_used;
+    uint32_t listener_handle;
+    uint32_t rctx;
+    int32_t result;
+    uint32_t out_length;
+    uint32_t next_failures;
+    char library_path[192];
+    unsigned budget, open_lines, missing_lines, summary_lines;
+    int summary_due;
+    SsrStatus status;
+    char line[240];
+} SsrCore;
+
+void ssr_core_init(SsrCore *c, const SsrOps *ops, const SsrConfig *config);
+/* On the DSP thread: the channel's state, a message of the channel. They only record; the glue wakes the thread. */
+void ssr_core_channel(SsrCore *c, int up);
+void ssr_core_receive(SsrCore *c, const uint8_t *data, uint32_t length);
+/* One step of the thread (a stage, or one call of the DSP served): 1 go on, 0 stopped for good (the status says why). */
+int ssr_core_step(SsrCore *c);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsSsc.c b/xnu/fuxi-sensors/SensorsSsc.c
new file mode 100644
index 0000000..f584539
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsSsc.c
@@ -0,0 +1,491 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* The sensor client service's QMI frames and protobuf messages: see SensorsSsc.h. */
+#include "SensorsSsc.h"
+
+const SscSuid ssc_suid_lookup = {0xababababababababull, 0xababababababababull};
+
+int ssc_suid_equal(const SscSuid *a, const SscSuid *b)
+{
+    return a->low == b->low && a->high == b->high;
+}
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static uint64_t le64(const uint8_t *p) {return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;}
+static void put16(uint8_t *p, uint32_t v) {p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);}
+
+/* ---- requests ---- */
+uint32_t ssc_build_suid_req(uint8_t *out, uint32_t cap, const char *data_type, int register_updates, int default_only)
+{
+    SpbOut o;
+    spb_out(&o, out, cap);
+    spb_put_string(&o, 1, data_type ? data_type : "");   /* required: written even when empty (every data type) */
+    spb_put_varint(&o, 2, register_updates ? 1 : 0);
+    spb_put_varint(&o, 3, default_only ? 1 : 0);
+    return spb_done(&o);
+}
+
+uint32_t ssc_build_sensor_config(uint8_t *out, uint32_t cap, uint32_t rate_bits)
+{
+    SpbOut o;
+    spb_out(&o, out, cap);
+    spb_put_fixed32(&o, 1, rate_bits);
+    return spb_done(&o);
+}
+
+uint32_t ssc_build_request(uint8_t *out, uint32_t cap, const SscSuid *suid, uint32_t msg_id, uint32_t delivery, const uint8_t *payload,
+                           uint32_t payload_length, int64_t batch_period_us)
+{
+    SpbOut o;
+    if (!suid) return 0;
+    spb_out(&o, out, cap);
+    uint32_t mark = spb_open(&o, 1);                     /* suid */
+    spb_put_fixed64(&o, 1, suid->low);
+    spb_put_fixed64(&o, 2, suid->high);
+    spb_close(&o, mark);
+    spb_put_fixed32(&o, 2, msg_id);                       /* msg_id */
+    mark = spb_open(&o, 3);                               /* susp_config: both fields required */
+    spb_put_varint(&o, 1, SSC_PROC_APSS);
+    spb_put_varint(&o, 2, delivery);
+    spb_close(&o, mark);
+    mark = spb_open(&o, 4);                               /* request: required, even empty */
+    if (batch_period_us >= 0) {
+        const uint32_t batching = spb_open(&o, 1);
+        spb_put_varint(&o, 1, (uint64_t)batch_period_us);   /* batch_period, required inside batching */
+        spb_close(&o, batching);
+    }
+    if (payload_length) spb_put_bytes(&o, 2, payload, payload_length);
+    spb_close(&o, mark);
+    return spb_done(&o);
+}
+
+uint32_t ssc_build_qmi_request(uint8_t *out, uint32_t cap, uint16_t transaction, const uint8_t *message, uint32_t length, int jumbo)
+{
+    const uint32_t total = SSC_QMI_HEADER + 3 + 2 + length + (jumbo >= 0 ? 4u : 0u);
+    if (!out || !message || !length || length > SSC_QMI_MAX_PAYLOAD || total > cap) return 0;
+    out[0] = SSC_QMI_REQUEST;
+    put16(out + 1, transaction);
+    put16(out + 3, SSC_QMI_REQ);
+    put16(out + 5, total - SSC_QMI_HEADER);
+    out[7] = 0x01;
+    put16(out + 8, length + 2);
+    put16(out + 10, length);
+    for (uint32_t i = 0; i < length; ++i) out[12 + i] = message[i];
+    if (jumbo >= 0) {
+        uint8_t *p = out + 12 + length;
+        p[0] = 0x10;
+        put16(p + 1, 1);
+        p[3] = jumbo ? 1 : 0;
+    }
+    return total;
+}
+
+/* ---- QMI ---- */
+int ssc_qmi_parse(const uint8_t *data, uint32_t length, SscQmi *m)
+{
+    if (!data || length < SSC_QMI_HEADER) return -1;
+    m->type = data[0];
+    m->transaction = le16(data + 1);
+    m->message = le16(data + 3);
+    m->length = le16(data + 5);
+    if (m->length > length - SSC_QMI_HEADER) return -1;
+    m->tlvs = data + SSC_QMI_HEADER;
+    return 0;
+}
+
+const uint8_t *ssc_qmi_tlv(const SscQmi *m, uint8_t type, uint32_t *size)
+{
+    for (uint32_t at = 0; at + 3 <= m->length;) {
+        const uint32_t n = le16(m->tlvs + at + 1);
+        if (n > m->length - at - 3) return 0;
+        if (m->tlvs[at] == type) {
+            *size = n;
+            return m->tlvs + at + 3;
+        }
+        at += 3 + n;
+    }
+    return 0;
+}
+
+int ssc_qmi_response(const SscQmi *m, SscResponse *r)
+{
+    uint32_t n = 0;
+    *r = (SscResponse){0, 0, 0, 0, 0, 0};
+    const uint8_t *result = ssc_qmi_tlv(m, 0x02, &n);
+    if (!result || n < 4) return -1;
+    r->result = le16(result);
+    r->error = le16(result + 2);
+    const uint8_t *client = ssc_qmi_tlv(m, 0x10, &n);
+    if (client && n >= 8) {r->has_client = 1; r->client_id = le64(client);}
+    const uint8_t *status = ssc_qmi_tlv(m, 0x11, &n);
+    if (status && n >= 4) {r->has_status = 1; r->status = le32(status);}
+    return 0;
+}
+
+int ssc_response_ok(const SscResponse *r)
+{
+    return r->result == 0 && r->error == 0 && (!r->has_status || r->status == 0);
+}
+
+int ssc_qmi_report(const SscQmi *m, int *has_client, uint64_t *client_id, const uint8_t **message, uint32_t *length)
+{
+    uint32_t n = 0;
+    const uint8_t *client = ssc_qmi_tlv(m, 0x01, &n);
+    *has_client = client && n >= 8;
+    *client_id = *has_client ? le64(client) : 0;
+    const uint8_t *events = ssc_qmi_tlv(m, 0x02, &n);
+    if (!events || n < 2) return -1;
+    const uint32_t count = le16(events);
+    const uint32_t limit = m->message == SSC_QMI_JUMBO_REPORT ? SSC_QMI_MAX_JUMBO : SSC_QMI_MAX_PAYLOAD;
+    if (count > n - 2 || count > limit) return -1;
+    *message = events + 2;
+    *length = count;
+    return 0;
+}
+
+/* ---- events ---- */
+static int read_suid(const uint8_t *p, uint32_t n, SscSuid *suid)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    int r;
+    *suid = (SscSuid){0, 0};
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        if (field == 1 && wire == SPB_I64) {if (spb_fixed64_value(&in, wire, &suid->low)) return -1;}
+        else if (field == 2 && wire == SPB_I64) {if (spb_fixed64_value(&in, wire, &suid->high)) return -1;}
+        else if (spb_skip(&in, wire)) return -1;
+    }
+    return r;
+}
+
+int ssc_events_open(SscEvents *e, const uint8_t *message, uint32_t length)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    int r;
+    e->has_suid = 0;
+    e->suid = (SscSuid){0, 0};
+    spb_in(&in, message, length);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        if (field == 1 && wire == SPB_LEN) {
+            const uint8_t *p = 0;
+            uint32_t n = 0;
+            if (spb_bytes_value(&in, wire, &p, &n) || read_suid(p, n, &e->suid)) return -1;
+            e->has_suid = 1;
+        } else if (spb_skip(&in, wire)) {
+            return -1;
+        }
+    }
+    if (r < 0) return -1;
+    spb_in(&e->in, message, length);
+    return 0;
+}
+
+int ssc_events_next(SscEvents *e, SscEvent *ev)
+{
+    uint32_t field, wire;
+    int r;
+    while ((r = spb_next(&e->in, &field, &wire)) == 1) {
+        if (field != 2 || wire != SPB_LEN) {
+            if (spb_skip(&e->in, wire)) return -1;
+            continue;
+        }
+        const uint8_t *p = 0;
+        uint32_t n = 0;
+        if (spb_bytes_value(&e->in, wire, &p, &n)) return -1;
+        SpbIn in;
+        *ev = (SscEvent){0, 0, 0, 0};
+        spb_in(&in, p, n);
+        int s;
+        while ((s = spb_next(&in, &field, &wire)) == 1) {
+            if (field == 1 && wire == SPB_I32) {if (spb_fixed32_value(&in, wire, &ev->msg_id)) return -1;}
+            else if (field == 2 && wire == SPB_I64) {if (spb_fixed64_value(&in, wire, &ev->timestamp)) return -1;}
+            else if (field == 3 && wire == SPB_LEN) {if (spb_bytes_value(&in, wire, &ev->payload, &ev->length)) return -1;}
+            else if (spb_skip(&in, wire)) return -1;
+        }
+        return s < 0 ? -1 : 1;
+    }
+    return r;
+}
+
+/* ---- payloads ---- */
+int ssc_parse_sensor_event(const uint8_t *p, uint32_t n, SscSensorEvent *ev)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    uint64_t v = 0;
+    int r;
+    ev->count = ev->more = 0;
+    ev->status = -1;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        if (field == 1 && (wire == SPB_I32 || wire == SPB_LEN)) {
+            if (spb_fixed32_values(&in, wire, ev->data, SSC_MAX_DATA, &ev->count, &ev->more)) return -1;
+        } else if (field == 2 && wire == SPB_VARINT) {
+            if (spb_varint_value(&in, wire, &v)) return -1;
+            ev->status = (int64_t)v;
+        } else if (spb_skip(&in, wire)) {
+            return -1;
+        }
+    }
+    return r < 0 ? -1 : 0;
+}
+
+int ssc_parse_proximity_event(const uint8_t *p, uint32_t n, SscProximityEvent *ev)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    uint64_t v = 0;
+    int r;
+    ev->type = -1;
+    ev->raw_adc = 0;
+    ev->status = -1;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        if (field >= 1 && field <= 3 && wire == SPB_VARINT) {
+            if (spb_varint_value(&in, wire, &v)) return -1;
+            if (field == 1) ev->type = (int64_t)v;
+            else if (field == 2) ev->raw_adc = v;
+            else ev->status = (int64_t)v;
+        } else if (spb_skip(&in, wire)) {
+            return -1;
+        }
+    }
+    return r < 0 || ev->type < 0 ? -1 : 0;
+}
+
+int ssc_parse_cal_event(const uint8_t *p, uint32_t n, SscCalEvent *ev)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    uint64_t v = 0;
+    int r;
+    ev->bias[0] = ev->bias[1] = ev->bias[2] = 0;
+    ev->count = ev->more = 0;
+    ev->status = -1;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        if (field == 1 && (wire == SPB_I32 || wire == SPB_LEN)) {
+            if (spb_fixed32_values(&in, wire, ev->bias, 3u, &ev->count, &ev->more)) return -1;
+        } else if (field == 4 && wire == SPB_VARINT) {
+            if (spb_varint_value(&in, wire, &v)) return -1;
+            ev->status = (int64_t)v;
+        } else if (spb_skip(&in, wire)) {
+            return -1;
+        }
+    }
+    return r < 0 ? -1 : 0;
+}
+
+static void copy_text(char *to, uint32_t size, const uint8_t *from, uint32_t n)
+{
+    uint32_t i = 0;
+    if (!size) return;
+    for (; i < n && i + 1 < size; ++i) to[i] = from[i] >= 32 && from[i] < 127 ? (char)from[i] : '.';
+    to[i] = 0;
+}
+
+int ssc_parse_suid_event(const uint8_t *p, uint32_t n, SscSuidEvent *ev)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    int r;
+    ev->data_type[0] = 0;
+    ev->count = ev->more = 0;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        const uint8_t *bytes = 0;
+        uint32_t size = 0;
+        if (field == 1 && wire == SPB_LEN) {
+            if (spb_bytes_value(&in, wire, &bytes, &size)) return -1;
+            copy_text(ev->data_type, sizeof ev->data_type, bytes, size);
+        } else if (field == 2 && wire == SPB_LEN) {
+            SscSuid suid;
+            if (spb_bytes_value(&in, wire, &bytes, &size) || read_suid(bytes, size, &suid)) return -1;
+            if (ev->count < SSC_MAX_SUIDS) ev->suid[ev->count++] = suid;
+            else ev->more++;
+        } else if (spb_skip(&in, wire)) {
+            return -1;
+        }
+    }
+    return r < 0 ? -1 : 0;
+}
+
+/* sns_std_attr_value {repeated data {oneof: 1 subtype (attr_value), 2 str, 3 flt (float), 4 sint (sfixed64), 5 boolean}} */
+typedef struct {
+    uint32_t kind;                    /* the data's field: 1..5 */
+    const uint8_t *bytes;             /* subtype, str */
+    uint32_t size;
+    uint32_t flt;
+    int64_t sint;
+} AttrDatum;
+
+static int attr_values(const uint8_t *p, uint32_t n, AttrDatum *out, unsigned max, unsigned *count)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    int r;
+    *count = 0;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        if (field != 1 || wire != SPB_LEN) {
+            if (spb_skip(&in, wire)) return -1;
+            continue;
+        }
+        const uint8_t *data = 0;
+        uint32_t size = 0;
+        if (spb_bytes_value(&in, wire, &data, &size)) return -1;
+        AttrDatum d = {0, 0, 0, 0, 0};
+        SpbIn one;
+        spb_in(&one, data, size);
+        int s;
+        while ((s = spb_next(&one, &field, &wire)) == 1) {
+            uint64_t v = 0;
+            if ((field == 1 || field == 2) && wire == SPB_LEN) {if (spb_bytes_value(&one, wire, &d.bytes, &d.size)) return -1;}
+            else if (field == 3 && wire == SPB_I32) {if (spb_fixed32_value(&one, wire, &d.flt)) return -1;}
+            else if (field == 4 && wire == SPB_I64) {if (spb_fixed64_value(&one, wire, &v)) return -1; d.sint = (int64_t)v;}
+            else if (field == 5 && wire == SPB_VARINT) {if (spb_varint_value(&one, wire, &v)) return -1; d.sint = v != 0;}
+            else {if (spb_skip(&one, wire)) return -1; continue;}
+            d.kind = field;
+        }
+        if (s < 0) return -1;
+        if (d.kind && *count < max) out[(*count)++] = d;
+    }
+    return r < 0 ? -1 : 0;
+}
+
+void ssc_attrs_clear(SscAttrs *a)
+{
+    uint8_t *b = (uint8_t *)a;
+    for (uint32_t i = 0; i < sizeof *a; ++i) b[i] = 0;
+    a->available = a->physical = a->dri = -1;
+    a->version = a->stream_type = a->fifo_size = a->hw_id = -1;
+}
+
+static void attribute(SscAttrs *a, int64_t id, const uint8_t *value, uint32_t size)
+{
+    AttrDatum d[SSC_MAX_RATES];
+    unsigned n = 0;
+    if (attr_values(value, size, d, SSC_MAX_RATES, &n) || !n) return;
+    a->seen++;
+    switch (id) {
+    case SSC_ATTR_NAME: if (d[0].kind == 2) copy_text(a->name, sizeof a->name, d[0].bytes, d[0].size); break;
+    case SSC_ATTR_VENDOR: if (d[0].kind == 2) copy_text(a->vendor, sizeof a->vendor, d[0].bytes, d[0].size); break;
+    case SSC_ATTR_TYPE: if (d[0].kind == 2) copy_text(a->type, sizeof a->type, d[0].bytes, d[0].size); break;
+    case SSC_ATTR_API: if (d[0].kind == 2) copy_text(a->api, sizeof a->api, d[0].bytes, d[0].size); break;
+    case SSC_ATTR_AVAILABLE: if (d[0].kind == 5) a->available = (int)d[0].sint; break;
+    case SSC_ATTR_PHYSICAL_SENSOR: if (d[0].kind == 5) a->physical = (int)d[0].sint; break;
+    case SSC_ATTR_DRI: if (d[0].kind == 5) a->dri = (int)d[0].sint; break;
+    case SSC_ATTR_VERSION: if (d[0].kind == 4) a->version = d[0].sint; break;
+    case SSC_ATTR_STREAM_TYPE: if (d[0].kind == 4) a->stream_type = d[0].sint; break;
+    case SSC_ATTR_FIFO_SIZE: if (d[0].kind == 4) a->fifo_size = d[0].sint; break;
+    case SSC_ATTR_HW_ID: if (d[0].kind == 4) a->hw_id = d[0].sint; break;
+    case SSC_ATTR_RATES:
+        a->rate_count = 0;
+        for (unsigned i = 0; i < n; ++i) if (d[i].kind == 3 && a->rate_count < SSC_MAX_RATES) a->rates[a->rate_count++] = d[i].flt;
+        break;
+    case SSC_ATTR_RESOLUTIONS:
+        a->resolution_count = 0;
+        for (unsigned i = 0; i < n; ++i)
+            if (d[i].kind == 3 && a->resolution_count < SSC_MAX_RANGES) a->resolutions[a->resolution_count++] = d[i].flt;
+        break;
+    case SSC_ATTR_RIGID_BODY:
+        a->rigid_count = 0;
+        for (unsigned i = 0; i < n; ++i) if (d[i].kind == 4 && a->rigid_count < SSC_MAX_RANGES) a->rigid_body[a->rigid_count++] = d[i].sint;
+        break;
+    case SSC_ATTR_ACTIVE_CURRENT:
+        a->current_count = 0;
+        for (unsigned i = 0; i < n; ++i)
+            if (d[i].kind == 4 && a->current_count < SSC_MAX_RANGES) a->active_current[a->current_count++] = d[i].sint;
+        break;
+    case SSC_ATTR_RANGES:
+        a->range_count = 0;
+        for (unsigned i = 0; i < n && a->range_count < SSC_MAX_RANGES; ++i) {
+            AttrDatum pair[2];
+            unsigned k = 0;
+            if (d[i].kind != 1 || attr_values(d[i].bytes, d[i].size, pair, 2, &k) || k != 2 || pair[0].kind != 3 || pair[1].kind != 3)
+                continue;
+            a->ranges[a->range_count][0] = pair[0].flt;
+            a->ranges[a->range_count][1] = pair[1].flt;
+            a->range_count++;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+int ssc_parse_attr_event(const uint8_t *p, uint32_t n, SscAttrs *a)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    int r;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        if (field != 1 || wire != SPB_LEN) {
+            if (spb_skip(&in, wire)) return -1;
+            continue;
+        }
+        const uint8_t *attr = 0;
+        uint32_t size = 0;
+        if (spb_bytes_value(&in, wire, &attr, &size)) return -1;
+        SpbIn one;
+        int64_t id = -1;
+        const uint8_t *value = 0;
+        uint32_t value_size = 0;
+        int s;
+        spb_in(&one, attr, size);
+        while ((s = spb_next(&one, &field, &wire)) == 1) {
+            uint64_t v = 0;
+            if (field == 1 && wire == SPB_VARINT) {if (spb_varint_value(&one, wire, &v)) return -1; id = (int64_t)v;}
+            else if (field == 2 && wire == SPB_LEN) {if (spb_bytes_value(&one, wire, &value, &value_size)) return -1;}
+            else if (spb_skip(&one, wire)) return -1;
+        }
+        if (s < 0) return -1;
+        if (id >= 0 && value) attribute(a, id, value, value_size);
+    }
+    return r < 0 ? -1 : 0;
+}
+
+int ssc_parse_physical_config(const uint8_t *p, uint32_t n, SscPhysicalConfig *c)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    int r;
+    unsigned more = 0;
+    uint8_t *b = (uint8_t *)c;
+    for (uint32_t i = 0; i < sizeof *c; ++i) b[i] = 0;
+    c->dri = -1;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        uint64_t v = 0;
+        const uint8_t *bytes = 0;
+        uint32_t size = 0;
+        if (field == 1 && wire == SPB_I32) {if (spb_fixed32_value(&in, wire, &c->sample_rate)) return -1;}
+        else if (field == 2 && wire == SPB_VARINT) {if (spb_varint_value(&in, wire, &v)) return -1; c->water_mark = (uint32_t)v;}
+        else if (field == 3 && (wire == SPB_I32 || wire == SPB_LEN)) {if (spb_fixed32_values(&in, wire, c->range, 2, &c->range_count, &more)) return -1;}
+        else if (field == 4 && wire == SPB_I32) {if (spb_fixed32_value(&in, wire, &c->resolution)) return -1;}
+        else if (field == 5 && wire == SPB_LEN) {if (spb_bytes_value(&in, wire, &bytes, &size)) return -1; copy_text(c->op_mode, sizeof c->op_mode, bytes, size);}
+        else if (field == 6 && wire == SPB_VARINT) {if (spb_varint_value(&in, wire, &v)) return -1; c->active_current = (uint32_t)v;}
+        else if (field == 8 && wire == SPB_VARINT) {if (spb_varint_value(&in, wire, &v)) return -1; c->dri = v != 0;}
+        else if (spb_skip(&in, wire)) return -1;
+    }
+    return r < 0 ? -1 : 0;
+}
+
+int ssc_parse_error_event(const uint8_t *p, uint32_t n, int64_t *error)
+{
+    SpbIn in;
+    uint32_t field, wire;
+    int r;
+    *error = -1;
+    spb_in(&in, p, n);
+    while ((r = spb_next(&in, &field, &wire)) == 1) {
+        uint64_t v = 0;
+        if (field == 1 && wire == SPB_VARINT) {if (spb_varint_value(&in, wire, &v)) return -1; *error = (int64_t)v;}
+        else if (spb_skip(&in, wire)) return -1;
+    }
+    return r < 0 ? -1 : 0;
+}
