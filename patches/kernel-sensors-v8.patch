++    const uint64_t norm = isqrt64(norm2);
++    if (norm == 0) {
++        return -1;
++    }
++    for (unsigned idx = 0; idx < 3u; ++idx) {
++        const int64_t comp = (work[idx] * (int64_t)kQ15One) / (int64_t)norm;
++        out_q15[idx] = (comp > kQ15One) ? kQ15One : (comp < -kQ15One) ? -kQ15One : (int32_t)comp;
