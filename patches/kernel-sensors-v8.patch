++int
++sns_compass_parse_mag_bias(const char *spec, int32_t out_q16[3])
++{
++    if (!spec || !spec[0] || !out_q16) {
++        return -1;
++    }
++    int64_t mut[3] = {0, 0, 0};
++    const char *cursor = spec;
++    for (unsigned idx = 0; idx < 3u; ++idx) {
++        while (*cursor == ' ' || *cursor == '\t') {
++            cursor++;
++        }
++        int64_t sign = 1;
++        if (*cursor == '-') {
++            sign = -1;
++            cursor++;
++        } else if (*cursor == '+') {
++            cursor++;
++        }
++        if (*cursor < '0' || *cursor > '9') {
++            return -1;
++        }
++        int64_t acc = 0;
++        while (*cursor >= '0' && *cursor <= '9') {
++            acc = acc * 10ll + (int64_t)(*cursor - '0');
++            if (acc > 10000000ll) {
++                return -1;
++            }
++            cursor++;
++        }
++        mut[idx] = sign * acc;
++        while (*cursor == ' ' || *cursor == '\t') {
++            cursor++;
++        }
++        if (idx < 2u) {
++            if (*cursor != ',') {
++                return -1;
++            }
++            cursor++;
++        }
++    }
++    if (*cursor != '\0') {
++        return -1;
++    }
++    int nonzero = 0;
++    for (unsigned idx = 0; idx < 3u; ++idx) {
++        if (mut[idx] != 0) {
++            nonzero = 1;
++        }
++        int64_t q16;
++        if (mut[idx] >= 0) {
++            q16 = (mut[idx] * (int64_t)kQ16One + 500ll) / 1000ll;
++        } else {
++            q16 = -(((-mut[idx]) * (int64_t)kQ16One + 500ll) / 1000ll);
++        }
++        out_q16[idx] = (int32_t)q16;
++    }
++    return nonzero;
++}
++
++static int
++bias_triplet_sane(const int32_t bias_q16[3])
++{
++    if (!bias_q16) {
++        return 0;
++    }
++    int nonzero = 0;
++    for (unsigned idx = 0; idx < 3u; ++idx) {
++        if (bias_q16[idx] > kMagBiasPersistMaxQ16 || bias_q16[idx] < -kMagBiasPersistMaxQ16) {
++            return 0;
++        }
++        if (bias_q16[idx] != 0) {
++            nonzero = 1;
++        }
++    }
++    return nonzero;
++}
