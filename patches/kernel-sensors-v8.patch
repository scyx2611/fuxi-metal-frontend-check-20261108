++static uint32_t
++quat_abs_dot_q30(const int32_t lhs[4], const int32_t rhs[4])
++{
++    int64_t dot = 0;
++    for (unsigned idx = 0; idx < 4u; ++idx) {
++        dot += ((int64_t)lhs[idx] >> 15) * ((int64_t)rhs[idx] >> 15);
++    }
++    if (dot < 0) {
++        dot = -dot;
++    }
++    return (dot > (int64_t)kQ30One) ? (uint32_t)kQ30One : (uint32_t)dot;
++}
