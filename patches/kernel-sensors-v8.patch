++    write_le32(out + 4u, (uint32_t)kMagBiasPersistVersion);
++    for (unsigned idx = 0; idx < 3u; ++idx) {
++        write_le32(out + 8u + idx * 4u, (uint32_t)bias_q16[idx]);
