+        const SscSuid suids[5] = {
+            {0x1001ull, 0x2001ull}, {0x1002ull, 0x2002ull}, {0x1003ull, 0x2003ull},
+            {0x1004ull, 0x2004ull}, {0x1005ull, 0x2005ull},
+        };
+        const char *names[5] = {"accel", "gyro", "mag", "akm_rotv", "mag_cal"};
