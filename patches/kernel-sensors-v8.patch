++        unsigned bytes = 0;
++        if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
++            SecureDTGetProperty(chosen, dt_prop, &prop, &bytes) == kSuccess &&
++            bytes == sizeof(uint32_t)) {
++            memcpy(&val, prop, sizeof(val));
