+static bool
+isDevMotionService(unsigned svcKind)
+{
+    return svcKind == FUXI_SENSOR_DEVMOTION ||
+        svcKind == kSvcDevMotion9Axis ||
+        svcKind == kSvcDevMotion6Axis ||
+        svcKind == kSvcDevMotion3Axis;
