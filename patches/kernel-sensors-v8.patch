++    begin(c, &t, "summary");
++    snt_kd(&t, "up", c->up);
++    for (unsigned k = 0; k < PaganiSensorKinds; ++k) snt_kd(&t, kNames[k], c->sensor[k].events);
++    snt_kd(&t, "reports", c->reports);
++    snt_kd(&t, "refused", c->refused);
++    snt_kd(&t, "malformed", c->malformed);
