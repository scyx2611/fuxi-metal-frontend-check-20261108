++            c->status.stage = SsrStChannel;
++        }
++    }
++    switch (c->phase) {
++    case PhaseChannel:
++        if (!__atomic_load_n(&c->link_up, __ATOMIC_ACQUIRE)) {
++            c->ops->wait(CTX, kRetryMs);
++            return 1;
++        }
++        c->status.stage = SsrStChannel;
++        if (ordinary(c)) {
++            begin(c, &t, "channel up");
++            snt_kd(&t, "ms", (int64_t)(now(c) - c->started_ms));
++            end(c);
++        }
++        c->phase = c->pack_done ? PhaseAttach : PhasePack;
++        c->pack_since = now(c);
