++static uint64_t
++resolveStamp(uint64_t ticks)
++{
++    const uint64_t now = mach_absolute_time();
++    if (ticks && ticks <= now && (now - ticks) < kTicksPerSecond) {
++        return ticks;
++    }
++    if (ticks > now && (ticks - now) <= (kTicksPerSecond / 20u)) {
++        return now;
++    }
++    __atomic_fetch_add(&gRestamped, 1u, __ATOMIC_RELAXED);
++    return now;
++}
