++static void
++mag_bias_try_save(uint64_t now_ms)
++{
++    if (!gCore || !gMagPersistEnabled || !gMagBiasLoadDone) return;
++    int32_t bias[3];
++    if (!sns_compass_get_persistable_bias(&gCore->compass, bias)) return;
