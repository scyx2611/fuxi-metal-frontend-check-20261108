++    if (!ts) ts = 1u;
++    if (kind >= kTotalServices) return ts;
++    uint64_t prev = __atomic_load_n(&gLastSampleTs[kind], __ATOMIC_ACQUIRE);
++    if (ts <= prev) ts = prev + 1u;
++    __atomic_store_n(&gLastSampleTs[kind], ts, __ATOMIC_RELEASE);
++    return ts;
++}
