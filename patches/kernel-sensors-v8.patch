++    uint64_t bit = 1ull << 62;
++    while (bit > value) {
++        bit >>= 2;
++    }
++    while (bit != 0) {
++        if (value >= root + bit) {
++            value -= root + bit;
++            root = (root >> 1) + bit;
++        } else {
++            root >>= 1;
++        }
++        bit >>= 2;
++    }
++    return root;
