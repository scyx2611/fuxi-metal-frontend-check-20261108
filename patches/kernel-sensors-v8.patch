+/* The Qualcomm sensor client service of the ADSP's sensor protection domain (SSC/QSH "sns_client", QMI service 400 over the IPC
+ * router): the QMI frames and the protobuf messages, our own encoder and decoder (SensorsPb.h). Message ids, TLVs and field numbers are
+ * facts from Qualcomm's own BSD-3 sources (qualcomm/sensinghub: sns_client_api_v01, apis/proto), checked against the public protocol
+ * descriptions; no code was taken (build-userspace/a830-inputs/sensors/ssc-facts.md, sections 2 to 4 and appendix A).
+ *
+ * QMI (after the 7-byte header: type, transaction, message id, TLV length):
+ *   0x20 request   TLV 0x01 u16 n + n bytes of sns_client_request_msg (n <= 1000), TLV 0x10 u8 use_jumbo_report (optional)
+ *   0x20 response  TLV 0x02 u16 result + u16 error (0/0: received), TLV 0x10 u64 client id, TLV 0x11 u32 result (0: received)
+ *   0x21 report    TLV 0x01 u64 client id, TLV 0x02 u16 n + n bytes of sns_client_event_msg (n <= 1000)
+ *   0x22 jumbo     the same, n <= 10240 (only when use_jumbo_report was set; we never set it: PaganiAdsp's 2 KiB intents)
+ * Every request is answered at once by a response that only says it was received; the data come in reports. */
+#ifndef SENSORS_SSC_H
+#define SENSORS_SSC_H
+#include <stdint.h>
+#include "SensorsPb.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SSC_QMI_SERVICE 0x190u
+#define SSC_QMI_HEADER 7u
+#define SSC_QMI_MAX_PAYLOAD 1000u       /* protobuf bytes of a request or a report */
+#define SSC_QMI_MAX_JUMBO 10240u
+enum {SSC_QMI_REQUEST = 0, SSC_QMI_RESPONSE = 2, SSC_QMI_INDICATION = 4};
+enum {SSC_QMI_SUPPORTED = 0x1e, SSC_QMI_REQ = 0x20, SSC_QMI_REPORT = 0x21, SSC_QMI_JUMBO_REPORT = 0x22, SSC_QMI_VERSION = 0x24};
+
+/* Message ids: the framework's (0..255), the SUID sensor's, the standard sensor's and the per data type ones (only unique within a data
+ * type: 768 is the SUID event of the SUID sensor and the physical configuration event of a physical sensor; 769 the discovery-done event
+ * of the SUID sensor and the proximity event of a proximity sensor). */
+enum {
+    SSC_MSG_ATTR_REQ = 1, SSC_MSG_FLUSH_REQ = 2, SSC_MSG_DEBUG_REQ = 3, SSC_MSG_DISABLE_REQ = 10,
+    SSC_MSG_ATTR_EVENT = 128, SSC_MSG_FLUSH_EVENT = 129, SSC_MSG_ERROR_EVENT = 130, SSC_MSG_DEBUG_RESP = 131,
+    SSC_MSG_RESAMPLER_CONFIG_EVENT = 133,
+    SSC_MSG_SUID_REQ = 512, SSC_MSG_SUID_EVENT = 768, SSC_MSG_SUID_DONE_EVENT = 769,
+    SSC_MSG_SENSOR_CONFIG = 513, SSC_MSG_ON_CHANGE_CONFIG = 514,
+    SSC_MSG_PHYSICAL_CONFIG_EVENT = 768, SSC_MSG_SENSOR_EVENT = 1025,
+    SSC_MSG_PROXIMITY_EVENT = 769, SSC_MSG_PROXIMITY_RECURRENT = 1031,
+    SSC_MSG_CAL_EVENT = 1022,
+};
+/* Attribute ids (sns_std_sensor.proto). */
+enum {
+    SSC_ATTR_NAME = 0, SSC_ATTR_VENDOR = 1, SSC_ATTR_TYPE = 2, SSC_ATTR_AVAILABLE = 3, SSC_ATTR_VERSION = 4, SSC_ATTR_API = 5,
+    SSC_ATTR_RATES = 6, SSC_ATTR_RESOLUTIONS = 7, SSC_ATTR_FIFO_SIZE = 8, SSC_ATTR_ACTIVE_CURRENT = 9, SSC_ATTR_SLEEP_CURRENT = 10,
+    SSC_ATTR_RANGES = 11, SSC_ATTR_OP_MODES = 12, SSC_ATTR_DRI = 13, SSC_ATTR_STREAM_SYNC = 14, SSC_ATTR_EVENT_SIZE = 15,
+    SSC_ATTR_STREAM_TYPE = 16, SSC_ATTR_DYNAMIC = 17, SSC_ATTR_HW_ID = 18, SSC_ATTR_RIGID_BODY = 19, SSC_ATTR_PHYSICAL_SENSOR = 21,
+};
+enum {SSC_STREAM_STREAMING = 0, SSC_STREAM_ON_CHANGE = 1, SSC_STREAM_SINGLE = 2};
+enum {SSC_DELIVERY_WAKEUP = 0, SSC_DELIVERY_NO_WAKEUP = 1};
+enum {SSC_PROC_APSS = 1};
+enum {SSC_PROXIMITY_FAR = 0, SSC_PROXIMITY_NEAR = 1};
+
+typedef struct {
+    uint64_t low, high;
+} SscSuid;
+extern const SscSuid ssc_suid_lookup;   /* the SUID sensor itself: 0xabababababababab twice */
+int ssc_suid_equal(const SscSuid *a, const SscSuid *b);
+
+/* ---- requests (each returns the encoded length, 0 when it did not fit) ---- */
+/* sns_suid_req {data_type, register_updates, default_only} */
+uint32_t ssc_build_suid_req(uint8_t *out, uint32_t cap, const char *data_type, int register_updates, int default_only);
+/* sns_std_sensor_config {sample_rate} (float bits, Hz) */
+uint32_t ssc_build_sensor_config(uint8_t *out, uint32_t cap, uint32_t rate_bits);
+/* sns_client_request_msg {suid, msg_id, susp_config {APSS, delivery}, request {[batching {batch_period}], [payload]}}; batch_period_us
+ * < 0 leaves batching out (no batching). */
+uint32_t ssc_build_request(uint8_t *out, uint32_t cap, const SscSuid *suid, uint32_t msg_id, uint32_t delivery, const uint8_t *payload,
+                           uint32_t payload_length, int64_t batch_period_us);
+/* The QMI request 0x20 around a request message; jumbo < 0 leaves TLV 0x10 out. */
+uint32_t ssc_build_qmi_request(uint8_t *out, uint32_t cap, uint16_t transaction, const uint8_t *message, uint32_t length, int jumbo);
+
+/* ---- QMI ---- */
+typedef struct {
+    uint8_t type;
+    uint16_t transaction, message;
+    const uint8_t *tlvs;
+    uint32_t length;
+} SscQmi;
+int ssc_qmi_parse(const uint8_t *data, uint32_t length, SscQmi *m);            /* 0, or -1 when not a QMI message */
+const uint8_t *ssc_qmi_tlv(const SscQmi *m, uint8_t type, uint32_t *size);    /* null when absent or malformed */
+typedef struct {
+    uint16_t result, error;            /* TLV 0x02 */
+    int has_client;
+    uint64_t client_id;                /* TLV 0x10 */
+    int has_status;
+    uint32_t status;                   /* TLV 0x11 */
+} SscResponse;
+int ssc_qmi_response(const SscQmi *m, SscResponse *r);                         /* 0, or -1 without TLV 0x02 */
+int ssc_response_ok(const SscResponse *r);
+/* A report (0x21 or 0x22): the client id (TLV 0x01, optional) and the event message (TLV 0x02). 0, or -1. */
+int ssc_qmi_report(const SscQmi *m, int *has_client, uint64_t *client_id, const uint8_t **message, uint32_t *length);
+
+/* ---- sns_client_event_msg {suid, events: {msg_id, timestamp, payload}...} ---- */
+typedef struct {
+    uint32_t msg_id;
+    uint64_t timestamp;                /* QTimer ticks (19.2 MHz) */
+    const uint8_t *payload;
+    uint32_t length;
+} SscEvent;
+typedef struct {
+    SscSuid suid;
+    int has_suid;
+    SpbIn in;
+} SscEvents;
+int ssc_events_open(SscEvents *e, const uint8_t *message, uint32_t length);   /* 0 (the SUID read), -1 malformed */
+int ssc_events_next(SscEvents *e, SscEvent *ev);                              /* 1 one event, 0 the end, -1 malformed */
+
+/* ---- event payloads ---- */
+#define SSC_MAX_DATA 16u
+typedef struct {
+    uint32_t data[SSC_MAX_DATA];       /* float bits */
+    unsigned count, more;
+    int64_t status;                    /* 0 unreliable, 1 low, 2 medium, 3 high accuracy */
+} SscSensorEvent;
+int ssc_parse_sensor_event(const uint8_t *p, uint32_t n, SscSensorEvent *ev);
+
+typedef struct {
+    int64_t type;                      /* SSC_PROXIMITY_FAR / _NEAR */
+    uint64_t raw_adc;
+    int64_t status;
+} SscProximityEvent;
+int ssc_parse_proximity_event(const uint8_t *p, uint32_t n, SscProximityEvent *ev);
+
+typedef struct {
+    uint32_t bias[3];                  /* float bits (uT for sns_mag_cal) */
+    unsigned count, more;
+    int64_t status;                    /* 0 unreliable, 1 low, 2 medium, 3 high accuracy, -1 absent */
+} SscCalEvent;
+int ssc_parse_cal_event(const uint8_t *p, uint32_t n, SscCalEvent *ev);
+
+#define SSC_MAX_SUIDS 8u
+#define SSC_TYPE_MAX 32u
+typedef struct {
+    char data_type[SSC_TYPE_MAX];
+    SscSuid suid[SSC_MAX_SUIDS];
+    unsigned count, more;
+} SscSuidEvent;
+int ssc_parse_suid_event(const uint8_t *p, uint32_t n, SscSuidEvent *ev);
+
+#define SSC_MAX_RATES 16u
+#define SSC_MAX_RANGES 4u
+typedef struct {
+    unsigned seen;                     /* attributes read */
+    char name[32], vendor[32], type[SSC_TYPE_MAX], api[48];
+    int available, physical, dri;      /* -1 when not given */
+    int64_t version, stream_type, fifo_size, hw_id;   /* -1 when not given */
+    uint32_t rates[SSC_MAX_RATES];     /* Hz, float bits */
+    unsigned rate_count;
+    uint32_t ranges[SSC_MAX_RANGES][2];
+    unsigned range_count;
+    uint32_t resolutions[SSC_MAX_RANGES];
+    unsigned resolution_count;
+    int64_t rigid_body[SSC_MAX_RANGES];
+    unsigned rigid_count;
+    int64_t active_current[SSC_MAX_RANGES];
+    unsigned current_count;
+} SscAttrs;
+void ssc_attrs_clear(SscAttrs *a);
+int ssc_parse_attr_event(const uint8_t *p, uint32_t n, SscAttrs *a);
+
+typedef struct {
+    uint32_t sample_rate;              /* float bits */
+    uint32_t water_mark, active_current;
+    uint32_t range[2];
+    unsigned range_count;
+    uint32_t resolution;
+    char op_mode[16];
+    int64_t dri;                       /* -1 when not given */
+} SscPhysicalConfig;
+int ssc_parse_physical_config(const uint8_t *p, uint32_t n, SscPhysicalConfig *c);
+
+int ssc_parse_error_event(const uint8_t *p, uint32_t n, int64_t *error);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-sensors/SensorsText.h b/xnu/fuxi-sensors/SensorsText.h
new file mode 100644
index 0000000..50579b5
--- /dev/null
+++ b/xnu/fuxi-sensors/SensorsText.h
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Copyright (c) 2026, UniXNU contributors. All rights reserved. */
+/* One-line log records ("[sensors] ..." BootProgress ramoops U lines): a bounded text builder for kernel and host alike (no C library).
+ * It never writes past its buffer and always leaves it terminated. */
+#ifndef SENSORS_TEXT_H
+#define SENSORS_TEXT_H
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    char *buf;
+    size_t size, used;
+} SntText;
+
+static inline void snt_start(SntText *t, char *buf, size_t size)
+{
+    t->buf = buf;
+    t->size = size;
+    t->used = 0;
+    if (size) buf[0] = 0;
+}
+static inline void snt_char(SntText *t, char c)
+{
+    if (t->used + 1 < t->size) {
+        t->buf[t->used++] = c;
+        t->buf[t->used] = 0;
+    }
+}
+static inline void snt_str(SntText *t, const char *s)
+{
+    for (size_t i = 0; s && s[i]; ++i) snt_char(t, s[i]);
+}
+static inline void snt_udec(SntText *t, uint64_t v)
+{
+    char digits[20];
+    unsigned n = 0;
+    do {
+        digits[n++] = (char)('0' + v % 10);
+        v /= 10;
+    } while (v && n < sizeof digits);
+    while (n) snt_char(t, digits[--n]);
+}
+static inline void snt_dec(SntText *t, int64_t v)
+{
+    if (v < 0) {
+        snt_char(t, '-');
+        snt_udec(t, (uint64_t)0 - (uint64_t)v);
+    } else {
+        snt_udec(t, (uint64_t)v);
+    }
+}
+static inline void snt_hex(SntText *t, uint64_t v)
+{
+    char digits[16];
+    unsigned n = 0;
+    do {
+        digits[n++] = "0123456789abcdef"[v & 15];
+        v >>= 4;
+    } while (v && n < sizeof digits);
+    snt_str(t, "0x");
+    while (n) snt_char(t, digits[--n]);
+}
+/* A fixed-point value with three decimals (milli-units), "-1.250". */
+static inline void snt_milli(SntText *t, int64_t milli)
+{
+    if (milli < 0) {
+        snt_char(t, '-');
+        milli = -milli;
+    }
+    snt_udec(t, (uint64_t)milli / 1000);
+    snt_char(t, '.');
+    const unsigned frac = (unsigned)((uint64_t)milli % 1000);
+    snt_char(t, (char)('0' + frac / 100));
+    snt_char(t, (char)('0' + frac / 10 % 10));
+    snt_char(t, (char)('0' + frac % 10));
+}
+static inline void snt_kd(SntText *t, const char *key, int64_t v)
+{
+    snt_char(t, ' ');
+    snt_str(t, key);
+    snt_char(t, '=');
+    snt_dec(t, v);
+}
+static inline void snt_kx(SntText *t, const char *key, uint64_t v)
+{
+    snt_char(t, ' ');
+    snt_str(t, key);
+    snt_char(t, '=');
+    snt_hex(t, v);
+}
+static inline void snt_ks(SntText *t, const char *key, const char *s)
+{
+    snt_char(t, ' ');
+    snt_str(t, key);
+    snt_char(t, '=');
+    snt_str(t, s);
+}
+static inline void snt_km(SntText *t, const char *key, int64_t milli)
+{
+    snt_char(t, ' ');
+    snt_str(t, key);
+    snt_char(t, '=');
+    snt_milli(t, milli);
+}
+#endif
diff --git a/xnu/fuxi-sensors/fuxi_sensors.c b/xnu/fuxi-sensors/fuxi_sensors.c
new file mode 100644
index 0000000..f96b50a
--- /dev/null
+++ b/xnu/fuxi-sensors/fuxi_sensors.c
@@ -0,0 +1,696 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Fuxi (SM8550) ADSP SSC sensors manager glue.
+ * Adapted from PaganiSensors/PaganiSensors.cpp (BSD-2-Clause-Patent, Copyright (c) 2026 UniXNU contributors)
+ * to Fuxi's XNU BSD + ShengQrtr + native IOHIDEventService (FuxiSensorsHid.cpp) stack.
+ *
+ * Opt-in boot-arg `fuxisensors` or ADT `/chosen u32 "fuxi,sensors"` (default 0 = completely off):
+ *   bits 0..1 : mode (0=off, 1=HID services only, 2=SUID lookup + attrs, 3=full on-demand streams + DT nodes)
+ *   bit 2 (4) : start FastRPC reverse file service (fastrpcglink-apps-dsp)
+ *   bit 3 (8) : publish Orientation service (0x0020/0x8a) + AppleSPULib 'ashd' user client
+ *   bit 4 (16): also request SUID list of all sensor data types (diagnostic)
+ *   bit 5 (32): force 50 Hz motion streaming for bring-up (overridable via fuxisensorshz / fuxi,sensors-hz)
+ *   bit 6 (64): publish DeviceMotion compass service (0xff0c/8) backed by ADSP rotv + mag_cal
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/kalloc.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "ShengQrtr.h"
+#include "SensorsCore.h"
+#include "SensorsHid.h"
+#include "SensorsRpc.h"
+#include "SensorsText.h"
+#include "fuxi_sensors_hid.h"
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t clear_wait(thread_t, wait_result_t);
+extern wait_result_t thread_block(thread_continue_t);
+extern int fuxi_sensors_rpc_status(SsrStatus *out);
+
+void fuxi_sensors_start(void);
+
+enum {
+    kRingSlots = 64u,
+    kSlotBytes = 1088u,
+    kEvData = 1u << 0,
+    kEvServer = 1u << 1,
+    kEvDemand = 1u << 2,
+};
+
+struct fs_slot {
+    uint32_t conn, node, port, length;
+    uint8_t data[kSlotBytes];
+};
+
+static volatile uint32_t gStarted, gPending, gDemandDirty;
+static volatile uint32_t gDemand[SNS_HID_KINDS];
+static struct fs_slot *gRing;
+static uint32_t gHead, gTail;
+static volatile uint32_t gDropped, gTooLong;
+static ShengQrtrPort *gPort[SNS_CONNS];
+static SnsCore *gCore;
+static SnsConfig gConfig;
+static uint32_t gPublished;
+static uint32_t gMode;
+static int gRpcEnabled;
+static int gMagPersistEnabled;
+static int gMagBiasLoadDone;
+static int gHasSavedMagBias;
+static int32_t gSavedMagBias[3];
+static uint64_t gStartMs;
+static uint64_t gLastMagBiasSaveMs;
+static uint32_t gTestRotDelaySec;
+static uint32_t gTestRotStage;
+static int gTestRotActive;
+
+static const char kMagBiasDir[] = "/private/var/db";
+static const char kMagBiasPath[] = "/private/var/db/fuxi-mag-bias.bin";
+
+static uint64_t
+fs_now_ms(void *context)
+{
+    (void)context;
+    uint64_t ns = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    return ns / 1000000ull;
+}
+
+static void
+fs_trace(void *context, const char *line)
+{
+    (void)context;
+    if (line) printf("%s\n", line);
+}
+
+static void
+fs_wake(uint32_t bits)
+{
+    __atomic_fetch_or(&gPending, bits, __ATOMIC_RELEASE);
+    thread_wakeup((event_t)&gPending);
+}
+
+static uint32_t
+fs_wait(uint32_t ms)
+{
+    uint32_t bits = __atomic_exchange_n(&gPending, 0u, __ATOMIC_ACQ_REL);
+    if (bits) return bits;
+    assert_wait_timeout((event_t)&gPending, THREAD_UNINT, ms ? ms : 1u, 1000000u);
+    bits = __atomic_exchange_n(&gPending, 0u, __ATOMIC_ACQ_REL);
+    if (bits) {
+        clear_wait(current_thread(), THREAD_AWAKENED);
+        return bits;
+    }
+    thread_block(THREAD_CONTINUE_NULL);
+    return __atomic_exchange_n(&gPending, 0u, __ATOMIC_ACQ_REL);
+}
+
+static uint32_t
+read_u32_cfg(const char *boot_arg, const char *dt_prop, uint32_t fallback)
+{
+    uint32_t val = fallback;
+    if (boot_arg && PE_parse_boot_argn(boot_arg, &val, sizeof(val))) return val;
+    if (dt_prop) {
+        DTEntry chosen;
+        const void *prop = NULL;
+        unsigned bytes = 0;
+        if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+            SecureDTGetProperty(chosen, dt_prop, &prop, &bytes) == kSuccess &&
+            bytes == sizeof(uint32_t)) {
+            memcpy(&val, prop, sizeof(val));
+        }
+    }
+    return val;
+}
+
+static int
+read_str_cfg(const char *boot_arg, const char *dt_prop, char *out, unsigned cap)
+{
+    if (!out || !cap) return 0;
+    out[0] = 0;
+    if (boot_arg && PE_parse_boot_argn(boot_arg, out, (int)cap)) return 1;
+    if (dt_prop) {
+        DTEntry chosen;
+        const void *prop = NULL;
+        unsigned bytes = 0;
+        if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+            SecureDTGetProperty(chosen, dt_prop, &prop, &bytes) == kSuccess && bytes > 0) {
+            unsigned n = bytes < cap - 1 ? bytes : cap - 1;
+            memcpy(out, prop, n);
+            out[n] = 0;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void
+on_qrtr_receive(void *context, uint32_t node, uint32_t from_port, const uint8_t *data, uint32_t length)
+{
+    const uint32_t conn = (uint32_t)(uintptr_t)context;
+    if (!gRing) return;
+    if (length > kSlotBytes) {
+        __atomic_fetch_add(&gTooLong, 1u, __ATOMIC_RELAXED);
+        return;
+    }
+    const uint32_t head = __atomic_load_n(&gHead, __ATOMIC_RELAXED);
+    const uint32_t tail = __atomic_load_n(&gTail, __ATOMIC_ACQUIRE);
+    if (head - tail >= kRingSlots) {
+        __atomic_fetch_add(&gDropped, 1u, __ATOMIC_RELAXED);
+        return;
+    }
+    struct fs_slot *slot = &gRing[head % kRingSlots];
+    slot->conn = conn;
+    slot->node = node;
+    slot->port = from_port;
+    slot->length = length;
+    memcpy(slot->data, data, length);
+    __atomic_store_n(&gHead, head + 1u, __ATOMIC_RELEASE);
+    fs_wake(kEvData);
+}
+
+static void
+on_qrtr_server_change(void *context)
+{
+    (void)context;
+    fs_wake(kEvServer);
+}
+
+static void
+on_hid_demand(unsigned kind, uint32_t demand)
+{
+    if (kind >= SNS_HID_KINDS) return;
+    __atomic_store_n(&gDemand[kind], demand, __ATOMIC_RELEASE);
+    __atomic_fetch_or(&gDemandDirty, 1u << kind, __ATOMIC_RELEASE);
+    fs_wake(kEvDemand);
+}
+
+static int
+op_send(void *context, unsigned conn, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length)
+{
+    (void)context;
+    if (conn >= SNS_CONNS || !gPort[conn]) return -1;
+    return sheng_qrtr_send(gPort[conn], node, port, data, length);
+}
+
+static void
+op_sample(void *context, const SnsSample *s)
+{
+    (void)context;
+    if (!s) return;
+    fuxi_sensors_hid_dispatch_sample(s->kind, s->timestamp, s->value[0], s->value[1], s->value[2]);
+}
+
+static void
+op_found(void *context, unsigned kind)
+{
+    (void)context;
+    if (kind == PaganiSensorPressure && !(gPublished & (1u << kind))) {
+        if (fuxi_sensors_hid_publish(kind) == 0) {
+            gPublished |= 1u << kind;
+            printf("[sensors] published dynamic service kind=%u (%s)\n", kind, sns_kind_name(kind));
+        }
+    }
+}
