+static unsigned
+devMotionSlot(unsigned svcKind)
+{
+    if (svcKind == FUXI_SENSOR_DEVMOTION) return 0u;
+    if (svcKind == kSvcDevMotion9Axis) return 1u;
+    if (svcKind == kSvcDevMotion6Axis) return 2u;
+    return 3u;
