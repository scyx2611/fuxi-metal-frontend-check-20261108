++        (enu[0] + enu[1]) >> 1,
++        (enu[1] - enu[0]) >> 1,
++        (enu[2] - enu[3]) >> 1,
++        (enu[3] + enu[2]) >> 1,
++    };
++    int32_t normalized[4];
