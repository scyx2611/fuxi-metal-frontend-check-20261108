++           (work[1] > 0x7fffffffll || work[1] < -0x7fffffffll) ||
++           (work[2] > 0x7fffffffll || work[2] < -0x7fffffffll)) {
++        work[0] >>= 1;
++        work[1] >>= 1;
++        work[2] >>= 1;
++    }
++    uint64_t norm2 = 0;
++    for (unsigned idx = 0; idx < 3u; ++idx) {
++        const uint64_t mag = (work[idx] < 0) ? (uint64_t)(-work[idx]) : (uint64_t)work[idx];
