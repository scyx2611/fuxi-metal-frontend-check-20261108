+/// Reports the texture's `swizzle`, `parentRelativeLevel` and `parentRelativeSlice`.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_texture_view_info(texture: *const NmbTexture, swizzle: *mut u8, relative_level: *mut u64, relative_slice: *mut u64) {
