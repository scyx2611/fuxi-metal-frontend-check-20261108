+            out[1] = swizzle_to_u8(sw.green);
+            out[2] = swizzle_to_u8(sw.blue);
+            out[3] = swizzle_to_u8(sw.alpha);
+        }
+        if !relative_level.is_null() {
+            // SAFETY: caller pointer.
+            unsafe { *relative_level = t.parent_relative_level() };
+        }
+        if !relative_slice.is_null() {
+            // SAFETY: caller pointer.
+            unsafe { *relative_slice = t.parent_relative_slice() };
+        }
+        Ok(())
+    })
