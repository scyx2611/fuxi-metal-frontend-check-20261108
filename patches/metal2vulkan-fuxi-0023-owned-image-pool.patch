+#[test]
+fn pool_reuse_hit_and_lifo_order() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let now = Instant::now();
+    let key = base_key();
+
+    assert!(pool
+        .give_back_at(make_entry(&harness, key.clone(), 101, 4096, now), now)
+        .is_empty());
+    assert!(pool
+        .give_back_at(
+            make_entry(&harness, key.clone(), 102, 4096, now + Duration::from_millis(5)),
+            now + Duration::from_millis(5)
+        )
+        .is_empty());
+    assert_eq!(pool.stats(), (2, 8192));
+
+    let t = now + Duration::from_millis(10);
+    let (first, exp1) = pool.take_at(&key, t);
+    assert!(exp1.is_empty());
+    assert_eq!(first.expect("LIFO first").raw.as_raw(), 102);
+
+    let (second, exp2) = pool.take_at(&key, t);
+    assert!(exp2.is_empty());
+    assert_eq!(second.expect("LIFO second").raw.as_raw(), 101);
+
+    let (third, _) = pool.take_at(&key, t);
+    assert!(third.is_none());
+    assert_eq!(pool.stats(), (0, 0));
+    assert_eq!(harness.image_destroy_count(), 0);
+    assert_eq!(harness.memory_free_count(), 0);
+}
