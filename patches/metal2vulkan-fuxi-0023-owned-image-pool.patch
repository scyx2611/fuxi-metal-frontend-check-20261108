+#[test]
+fn device_lost_refuses_reuse_and_teardown_no_double_free() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let lost = AtomicBool::new(false);
+    let t0 = Instant::now();
+    let key = base_key();
+
+    let e1 = make_entry(&harness, key.clone(), 401, 40 << 20, t0);
+    assert!(pool.give_back_at(e1, t0).is_empty());
+
+    // Simulate DeviceLost: refuses borrow and refuses return (direct destroy).
+    lost.store(true, Ordering::Release);
+    let borrowed = if lost.load(Ordering::Acquire) {
+        None
+    } else {
+        pool.take_at(&key, t0).0
+    };
+    assert!(borrowed.is_none());
+
+    let e2 = make_entry(&harness, key.clone(), 402, 40 << 20, t0);
+    if lost.load(Ordering::Acquire) {
+        destroy_entries(&harness.vk, &harness.memory, vec![e2]);
+    } else {
+        let _ = pool.give_back_at(e2, t0);
+    }
+    assert_eq!(pool.stats(), (1, 40 << 20));
+    assert_eq!(harness.image_destroy_count(), 1);
+    assert_eq!(harness.memory_free_count(), 1);
+
+    // Simulate DeviceShared::drop teardown: drain image_pool then destroy memory.
+    let leftover = pool.drain_all();
+    let n = destroy_entries(&harness.vk, &harness.memory, leftover);
+    assert_eq!(n, 1);
+    harness.memory.lock().unwrap().destroy(&harness.vk);
+
+    assert_eq!(pool.stats(), (0, 0));
+    assert_eq!(harness.image_destroy_count(), 2);
+    assert_eq!(harness.memory_free_count(), 2);
+    assert_eq!(harness.double_free_count(), 0);
+}
