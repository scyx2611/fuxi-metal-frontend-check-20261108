+#[test]
+fn ttl_10s_eviction() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let t0 = Instant::now();
+    let key = base_key();
+
+    // Entry 201 is a dedicated allocation (> 32 MiB) so Memory::free immediately triggers vkFreeMemory.
+    // Pair with a 16 MiB entry 202 so both remain under MAX_POOL_BYTES (64 MiB).
+    assert!(pool
+        .give_back_at(make_entry(&harness, key.clone(), 201, 40 << 20, t0), t0)
+        .is_empty());
+    assert!(pool
+        .give_back_at(
+            make_entry(&harness, key.clone(), 202, 16 << 20, t0 + Duration::from_secs(2)),
+            t0 + Duration::from_secs(2)
+        )
+        .is_empty());
+
+    // At 9.999s after t0, entry 201 is not yet expired and LIFO returns 202.
+    let (hit, expired) = pool.take_at(&key, t0 + IMAGE_POOL_TTL - Duration::from_millis(1));
+    assert!(expired.is_empty());
+    assert_eq!(hit.expect("entry 202").raw.as_raw(), 202);
+
+    // At exactly 10.000s after t0, entry 201 expires and is evicted before matching.
+    let (miss, expired) = pool.take_at(&key, t0 + IMAGE_POOL_TTL);
+    assert!(miss.is_none());
+    assert_eq!(expired.len(), 1);
+    assert_eq!(expired[0].raw.as_raw(), 201);
+
+    destroy_entries(&harness.vk, &harness.memory, expired);
+    let ops = harness.ops();
+    assert_eq!(ops.len(), 2);
+    assert_eq!(ops[0], MockOp::Image(201));
+    assert!(matches!(ops[1], MockOp::Memory(_)));
+    assert_eq!(harness.double_free_count(), 0);
+}
