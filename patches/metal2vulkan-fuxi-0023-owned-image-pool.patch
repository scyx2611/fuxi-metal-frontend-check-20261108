+#[test]
+fn memory_pressure_release_kept_memory_drains_all() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let t0 = Instant::now();
+    let key = base_key();
+
+    // Mix dedicated (40 MiB -> direct vkFreeMemory) and pooled entries (16 MiB + 4 KiB -> empty block release) within 64 MiB budget.
+    let e1 = make_entry(&harness, key.clone(), 301, 40 << 20, t0);
+    let e2 = make_entry(&harness, key.clone(), 302, 16 << 20, t0);
+    let e3 = make_entry(&harness, key.clone(), 303, 4096, t0);
+    for e in [e1, e2, e3] {
+        assert!(pool.give_back_at(e, t0).is_empty());
+    }
+    assert_eq!(pool.stats(), (3, (56 << 20) + 4096));
+
+    // Simulate Device::release_kept_memory()
+    let drained = pool.drain_all();
+    let freed_images = destroy_entries(&harness.vk, &harness.memory, drained);
+    let freed_empty_blocks = harness
+        .memory
+        .lock()
+        .unwrap()
+        .release_empty_blocks(&harness.vk);
+    assert_eq!(freed_images, 3);
+    assert!(freed_empty_blocks >= 1);
+    assert_eq!(pool.stats(), (0, 0));
+    assert_eq!(harness.image_destroy_count(), 3);
+    // 1 dedicated block + 1 pooled block freed
+    assert_eq!(harness.memory_free_count(), 2);
+    assert_eq!(harness.double_free_count(), 0);
+
+    // Verify every Image destruction preceded its corresponding Memory free in order.
+    let ops = harness.ops();
+    let first_img = ops.iter().position(|op| matches!(op, MockOp::Image(301))).unwrap();
+    let first_mem = ops.iter().position(|op| matches!(op, MockOp::Memory(_))).unwrap();
+    assert!(first_img < first_mem, "VkImage must be destroyed before VkDeviceMemory is freed");
+}
