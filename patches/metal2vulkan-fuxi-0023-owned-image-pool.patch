index 0000000..4f6d9f3
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/image_pool.rs
@@ -0,0 +1,225 @@
+//! Owned `VkImage` backing pool (`ImagePool`): reuses runtime-owned `VkImage` objects and their
+//! bound `Placement`s across short-lived textures of the same creation shape and memory class.
+//!
+//! - **Ownership & retirement safety.** An image enters the pool only from [`Image::drop`], after
+//!   [`TextureShared::drop`] has retired the texture ID through `heap_sets::gone` (all prior
+//!   command buffers referencing the texture have completed) and all `VkImageView`s have been
+//!   destroyed. Every pooled image has zero views and zero in-flight GPU accesses.
+//! - **Lock ordering.** The pool's mutex is never held while calling `release::object` or locking
+//!   `DeviceShared::memory`. Entries to destroy are drained/evicted out of the mutex first and
+//!   destroyed lock-free via [`destroy_entries`], strictly destroying each `VkImage` before freeing
+//!   its [`Placement`].
+//! - **Budgets & TTL.** Bounded by [`IMAGE_POOL_TTL`] (10 s), [`MAX_POOL_BYTES`] (64 MiB),
+//!   [`MAX_POOL_IMAGES`] (64), and [`MAX_POOL_ENTRY_BYTES`] (48 MiB).
+
+use crate::device::lock;
+use crate::memory::{Memory, MemoryClass, Placement};
+use crate::release;
+use ash::vk;
+use std::collections::VecDeque;
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+/// Time-to-live of an idle pooled `VkImage` before automatic eviction.
+pub(super) const IMAGE_POOL_TTL: Duration = Duration::from_secs(10);
+
+/// Maximum total backing bytes held across all pooled images on one device (64 MiB).
+pub(super) const MAX_POOL_BYTES: u64 = 64 << 20;
+
+/// Maximum number of pooled `VkImage` entries kept on one device.
+pub(super) const MAX_POOL_IMAGES: usize = 64;
+
+/// Maximum backing byte size of a single poolable `VkImage` (48 MiB).
+pub(super) const MAX_POOL_ENTRY_BYTES: u64 = 48 << 20;
+
+/// 12-field lookup key covering every `VkImageCreateInfo` parameter, view format list, queue
+/// sharing mode, and [`MemoryClass`] compatibility property of a runtime-owned `VkImage`.
+#[derive(Clone, PartialEq, Eq, Hash)]
+pub(super) struct ImagePoolKey {
+    /// Vulkan image dimensionality (`VkImageCreateInfo::imageType`).
+    pub(super) image_type: metal2vulkan::vk::ImageType,
+    /// Vulkan texel format (`VkImageCreateInfo::format`).
+    pub(super) format: metal2vulkan::vk::Format,
+    /// Base level extent `[width, height, depth]`.
+    pub(super) extent: [u32; 3],
+    /// Mipmap level count (`VkImageCreateInfo::mipLevels`).
+    pub(super) mip_levels: u32,
+    /// Array layer count (`VkImageCreateInfo::arrayLayers`).
+    pub(super) array_layers: u32,
+    /// Multisample sample count (`VkImageCreateInfo::samples`).
+    pub(super) samples: metal2vulkan::vk::SampleCountFlags,
+    /// Vulkan image tiling (`VkImageCreateInfo::tiling`).
+    pub(super) tiling: vk::ImageTiling,
+    /// Vulkan image usage flags (`VkImageCreateInfo::usage`, including `HOST_TRANSFER` if any).
+    pub(super) usage: metal2vulkan::vk::ImageUsageFlags,
+    /// Vulkan image creation flags (`VkImageCreateInfo::flags`).
+    pub(super) flags: metal2vulkan::vk::ImageCreateFlags,
+    /// Mutable view formats chained via `VkImageFormatListCreateInfo`.
+    pub(super) view_formats: Vec<metal2vulkan::vk::Format>,
+    /// Whether the image is shared concurrently with the dedicated staging queue family.
+    pub(super) sharing_staging: bool,
+    /// Logical memory class requested for placement.
+    pub(super) memory_class: MemoryClass,
+}
+
+/// A pooled `VkImage` together with its bound [`Placement`] and layout state.
+pub(super) struct PooledImage {
+    /// Creation compatibility key.
+    pub(super) key: ImagePoolKey,
+    /// Bound `VkImage` handle (zero live views, zero in-flight command buffers).
+    pub(super) raw: vk::Image,
+    /// Backing memory placement owned with `raw`.
+    pub(super) placement: Placement,
+    /// Whether the image was created with host-transfer usage for host CPU copies.
+    pub(super) host_copies: bool,
+    /// `true` if a prior `FirstMove` or host/staging transition moved the image into `GENERAL`;
+    /// `false` if it still resides in `UNDEFINED`.
+    pub(super) in_general: bool,
+}
+
+struct PoolEntry {
+    image: PooledImage,
+    /// Timestamp sampled under the pool mutex when the entry was returned to the pool.
+    returned_at: Instant,
+}
+
+#[derive(Default)]
+struct ImagePoolInner {
+    /// Oldest entries at the front (FIFO/LRU eviction), newest at the back (LIFO reuse).
+    entries: VecDeque<PoolEntry>,
+    total_bytes: u64,
+}
+
+impl ImagePoolInner {
+    fn evict_expired(&mut self, now: Instant, expired: &mut Vec<PooledImage>) {
+        // Bounded by MAX_POOL_IMAGES (64), so scanning all entries avoids leaving stale
+        // entries behind if timestamps ever arrive non-monotonically.
+        let mut idx = 0;
+        while idx < self.entries.len() {
+            if now.saturating_duration_since(self.entries[idx].returned_at) >= IMAGE_POOL_TTL {
+                if let Some(entry) = self.entries.remove(idx) {
+                    self.total_bytes = self.total_bytes.saturating_sub(entry.image.placement.size());
+                    expired.push(entry.image);
+                }
+            } else {
+                idx += 1;
+            }
+        }
+    }
+}
+
+/// Per-device pool of idle runtime-owned `VkImage` objects and their bound placements.
+#[derive(Default)]
+pub(super) struct ImagePool {
+    inner: Mutex<ImagePoolInner>,
+}
+
+impl ImagePool {
+    /// Borrow the newest pooled image matching `key` at time `now` (LIFO), evicting any expired
+    /// entries first. The caller must destroy any returned expired entries outside locks via
+    /// [`destroy_entries`].
+    pub(super) fn take_at(
+        &self,
+        key: &ImagePoolKey,
+        now: Instant,
+    ) -> (Option<PooledImage>, Vec<PooledImage>) {
+        let mut expired = Vec::new();
+        let mut inner = lock(&self.inner);
+        inner.evict_expired(now, &mut expired);
+        let hit = inner
+            .entries
+            .iter()
+            .rposition(|entry| entry.image.key == *key)
+            .and_then(|idx| inner.entries.remove(idx))
+            .map(|entry| entry.image);
+        if let Some(ref image) = hit {
+            inner.total_bytes = inner.total_bytes.saturating_sub(image.placement.size());
+        }
+        (hit, expired)
+    }
+
+    /// Borrow a pooled image matching `key` at `Instant::now()`.
+    pub(super) fn take(&self, key: &ImagePoolKey) -> (Option<PooledImage>, Vec<PooledImage>) {
+        self.take_at(key, Instant::now())
+    }
+
+    fn give_back_inner(&self, image: PooledImage, explicit_now: Option<Instant>) -> Vec<PooledImage> {
+        let mut evicted = Vec::new();
+        let size = image.placement.size();
+        if size > MAX_POOL_ENTRY_BYTES {
+            evicted.push(image);
+            return evicted;
+        }
+        let mut inner = lock(&self.inner);
+        // Sample `Instant::now()` strictly after acquiring the pool mutex so real insertions
+        // record monotonic timestamps under lock.
+        let now = explicit_now.unwrap_or_else(Instant::now);
+        inner.evict_expired(now, &mut evicted);
+        while inner.entries.len() >= MAX_POOL_IMAGES
+            || inner.total_bytes.saturating_add(size) > MAX_POOL_BYTES
+        {
+            let Some(oldest) = inner.entries.pop_front() else {
+                break;
+            };
+            inner.total_bytes = inner.total_bytes.saturating_sub(oldest.image.placement.size());
+            evicted.push(oldest.image);
+        }
+        inner.total_bytes = inner.total_bytes.saturating_add(size);
+        inner.entries.push_back(PoolEntry {
+            image,
+            returned_at: now,
+        });
+        evicted
+    }
+
+    /// Return `entry` to the pool at time `now`, returning all expired or budget-evicted entries
+    /// (plus `entry` itself if it exceeds [`MAX_POOL_ENTRY_BYTES`]) for lock-free destruction via
+    /// [`destroy_entries`].
+    #[cfg(test)]
+    pub(super) fn give_back_at(&self, entry: PooledImage, now: Instant) -> Vec<PooledImage> {
+        self.give_back_inner(entry, Some(now))
+    }
+
+    /// Return `entry` to the pool, sampling `Instant::now()` under the pool mutex.
+    pub(super) fn give_back(&self, entry: PooledImage) -> Vec<PooledImage> {
+        self.give_back_inner(entry, None)
+    }
+
+    /// Drain all entries whose TTL has expired by `now` for lock-free destruction.
+    pub(super) fn drain_expired_at(&self, now: Instant) -> Vec<PooledImage> {
+        let mut expired = Vec::new();
+        lock(&self.inner).evict_expired(now, &mut expired);
+        expired
+    }
+
+    /// Drain every pooled entry (for memory pressure trimming or device teardown).
+    pub(super) fn drain_all(&self) -> Vec<PooledImage> {
+        let mut inner = lock(&self.inner);
+        inner.total_bytes = 0;
+        inner.entries.drain(..).map(|entry| entry.image).collect()
+    }
+
+    /// Current `(image_count, total_bytes)` held in the pool.
+    #[cfg(test)]
+    pub(super) fn stats(&self) -> (usize, u64) {
+        let inner = lock(&self.inner);
+        (inner.entries.len(), inner.total_bytes)
+    }
+}
+
+/// Destroy `entries` without holding the pool mutex: destroys each `VkImage` through
+/// [`release::object`] before freeing its [`Placement`] from `memory`.
+pub(super) fn destroy_entries(
+    vk: &ash::Device,
+    memory: &Mutex<Memory>,
+    entries: Vec<PooledImage>,
+) -> usize {
+    let count = entries.len();
+    for entry in entries {
+        // SAFETY: the image has zero live views and zero pending command buffer uses; destroy the
+        // image handle before freeing the memory placement bound to it.
+        unsafe { release::object(vk, entry.raw) };
+        lock(memory).free(vk, &entry.placement);
+    }
+    count
+}
