+#[test]
+fn non_monotonic_timestamp_ttl_eviction() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let t0 = Instant::now();
+    let key = base_key();
+
+    // Insert newer timestamp first, then older timestamp (Challenger 1 out-of-order scenario).
+    assert!(pool
+        .give_back_at(
+            make_entry(&harness, key.clone(), 501, 4096, t0),
+            t0 + Duration::from_secs(8)
+        )
+        .is_empty());
+    assert!(pool
+        .give_back_at(
+            make_entry(&harness, key.clone(), 502, 4096, t0),
+            t0 + Duration::from_secs(1)
+        )
+        .is_empty());
+    assert_eq!(pool.stats(), (2, 8192));
+
+    // At t0 + 12s, entry 502 (t0 + 1s, age 11s >= 10s) must be evicted even though 501 (age 4s) is at front.
+    let expired = pool.drain_expired_at(t0 + Duration::from_secs(12));
+    assert_eq!(expired.len(), 1);
+    assert_eq!(expired[0].raw.as_raw(), 502);
+    assert_eq!(pool.stats(), (1, 4096));
+    destroy_entries(&harness.vk, &harness.memory, expired);
+
+    // At t0 + 18s, entry 501 (t0 + 8s, age 10s) expires as well.
+    let expired2 = pool.drain_expired_at(t0 + Duration::from_secs(18));
+    assert_eq!(expired2.len(), 1);
+    assert_eq!(expired2[0].raw.as_raw(), 501);
+    assert_eq!(pool.stats(), (0, 0));
+    destroy_entries(&harness.vk, &harness.memory, expired2);
+    assert_eq!(harness.double_free_count(), 0);
+}
