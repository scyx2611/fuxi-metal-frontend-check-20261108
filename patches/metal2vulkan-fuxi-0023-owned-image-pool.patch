index 0000000..4ab25b6
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/image_pool.rs
@@ -0,0 +1,534 @@
+//! Unit and mock `ash::Device` lifecycle tests for the owned `VkImage` backing pool (`image_pool.rs`).
+
+use crate::image_pool::{
+    destroy_entries, ImagePool, ImagePoolKey, PooledImage, IMAGE_POOL_TTL, MAX_POOL_BYTES,
+    MAX_POOL_ENTRY_BYTES, MAX_POOL_IMAGES,
+};
+use crate::memory::{Holds, Memory, MemoryClass, Placement};
+use ash::vk::{self, Handle};
+use std::collections::{HashMap, HashSet};
+use std::ffi::{c_void, CStr};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum MockOp {
+    Image(u64),
+    Memory(u64),
+}
+
+#[derive(Default)]
+struct MockState {
+    next_memory: u64,
+    ops: Vec<MockOp>,
+    destroyed_images: HashSet<u64>,
+    freed_memories: HashSet<u64>,
+    double_frees: usize,
+}
+
+fn mock_states() -> &'static Mutex<HashMap<u64, MockState>> {
+    static STATES: OnceLock<Mutex<HashMap<u64, MockState>>> = OnceLock::new();
+    STATES.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+unsafe extern "system" fn stub_alloc_memory(
+    device: vk::Device,
+    _info: *const vk::MemoryAllocateInfo<'_>,
+    _allocator: *const vk::AllocationCallbacks<'_>,
+    memory: *mut vk::DeviceMemory,
+) -> vk::Result {
+    let mut map = mock_states().lock().unwrap();
+    let st = map.entry(device.as_raw()).or_default();
+    st.next_memory += 1;
+    let handle = st.next_memory;
+    unsafe { *memory = vk::DeviceMemory::from_raw(handle) };
+    vk::Result::SUCCESS
+}
+
+unsafe extern "system" fn stub_discard_memory(
+    device: vk::Device,
+    memory: vk::DeviceMemory,
+    _allocator: *const vk::AllocationCallbacks<'_>,
+) {
+    let raw = memory.as_raw();
+    let mut map = mock_states().lock().unwrap();
+    let st = map.entry(device.as_raw()).or_default();
+    if !st.freed_memories.insert(raw) {
+        st.double_frees += 1;
+    }
+    st.ops.push(MockOp::Memory(raw));
+}
+
+unsafe extern "system" fn stub_discard_image(
+    device: vk::Device,
+    image: vk::Image,
+    _allocator: *const vk::AllocationCallbacks<'_>,
+) {
+    let raw = image.as_raw();
+    let mut map = mock_states().lock().unwrap();
+    let st = map.entry(device.as_raw()).or_default();
+    if !st.destroyed_images.insert(raw) {
+        st.double_frees += 1;
+    }
+    st.ops.push(MockOp::Image(raw));
+}
+
+struct MockHarness {
+    id: u64,
+    vk: ash::Device,
+    memory: Mutex<Memory>,
+}
+
+impl MockHarness {
+    fn new() -> Self {
+        static NEXT_DEV: AtomicU64 = AtomicU64::new(0x1000);
+        let id = NEXT_DEV.fetch_add(1, Ordering::Relaxed);
+        {
+            let mut map = mock_states().lock().unwrap();
+            map.insert(id, MockState::default());
+        }
+        let load = |name: &CStr| -> *const c_void {
+            match name.to_bytes() {
+                b"vkAllocateMemory" => stub_alloc_memory as *const c_void,
+                b"vkFreeMemory" => stub_discard_memory as *const c_void,
+                b"vkDestroyImage" => stub_discard_image as *const c_void,
+                _ => std::ptr::null(),
+            }
+        };
+        // SAFETY: stub entry points have exact Vulkan C ABI signatures.
+        let vk = unsafe { ash::Device::load_with(load, vk::Device::from_raw(id)) };
+        let mem_props = vk::PhysicalDeviceMemoryProperties {
+            memory_type_count: 2,
+            memory_types: {
+                let mut arr = [vk::MemoryType::default(); vk::MAX_MEMORY_TYPES];
+                arr[0] = vk::MemoryType {
+                    property_flags: vk::MemoryPropertyFlags::DEVICE_LOCAL,
+                    heap_index: 0,
+                };
+                arr[1] = vk::MemoryType {
+                    property_flags: vk::MemoryPropertyFlags::HOST_VISIBLE
+                        | vk::MemoryPropertyFlags::HOST_COHERENT
+                        | vk::MemoryPropertyFlags::HOST_CACHED,
+                    heap_index: 0,
+                };
+                arr
+            },
+            memory_heap_count: 1,
+            memory_heaps: {
+                let mut arr = [vk::MemoryHeap::default(); vk::MAX_MEMORY_HEAPS];
+                arr[0] = vk::MemoryHeap {
+                    size: 4 << 30,
+                    flags: vk::MemoryHeapFlags::DEVICE_LOCAL,
+                };
+                arr
+            },
+        };
+        let memory = Mutex::new(Memory::new(&mem_props, u64::MAX, false, true, vec![0]));
+        Self { id, vk, memory }
+    }
+
+    fn alloc_image_placement(&self, size: u64) -> Placement {
+        let reqs = vk::MemoryRequirements {
+            size,
+            alignment: 4096,
+            memory_type_bits: 0b01,
+        };
+        crate::memory::allocate_image(&self.memory, &self.vk, &reqs, MemoryClass::Private)
+            .expect("mock allocate_image")
+    }
+
+    fn ops(&self) -> Vec<MockOp> {
+        mock_states().lock().unwrap().get(&self.id).unwrap().ops.clone()
+    }
+
+    fn image_destroy_count(&self) -> usize {
+        self.ops()
+            .iter()
+            .filter(|op| matches!(op, MockOp::Image(_)))
+            .count()
+    }
+
+    fn memory_free_count(&self) -> usize {
+        self.ops()
+            .iter()
+            .filter(|op| matches!(op, MockOp::Memory(_)))
+            .count()
+    }
+
+    fn double_free_count(&self) -> usize {
+        mock_states()
+            .lock()
+            .unwrap()
+            .get(&self.id)
+            .unwrap()
+            .double_frees
+    }
+}
+
+impl Drop for MockHarness {
+    fn drop(&mut self) {
+        mock_states().lock().unwrap().remove(&self.id);
+    }
+}
+
+fn base_key() -> ImagePoolKey {
+    ImagePoolKey {
+        image_type: metal2vulkan::vk::ImageType::TYPE_2D,
+        format: metal2vulkan::vk::Format::B8G8R8A8_UNORM,
+        extent: [1920, 1080, 1],
+        mip_levels: 1,
+        array_layers: 1,
+        samples: metal2vulkan::vk::SampleCountFlags::from_raw(1),
+        tiling: vk::ImageTiling::OPTIMAL,
+        usage: metal2vulkan::vk::ImageUsageFlags::SAMPLED
+            | metal2vulkan::vk::ImageUsageFlags::COLOR_ATTACHMENT,
+        flags: metal2vulkan::vk::ImageCreateFlags::empty(),
+        view_formats: vec![],
+        sharing_staging: false,
+        memory_class: MemoryClass::Private,
+    }
+}
+
+fn make_entry(
+    harness: &MockHarness,
+    key: ImagePoolKey,
+    raw_id: u64,
+    size: u64,
+    _returned_at: Instant,
+) -> PooledImage {
+    let placement = harness.alloc_image_placement(size);
+    PooledImage {
+        key,
+        raw: vk::Image::from_raw(raw_id),
+        placement,
+        host_copies: false,
+        in_general: true,
+    }
+}
+
+#[test]
+fn key_distinguishes_all_image_create_fields() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let now = Instant::now();
+    let base = base_key();
+    assert!(pool
+        .give_back_at(make_entry(&harness, base.clone(), 1, 4096, now), now)
+        .is_empty());
+
+    let mut variants = Vec::new();
+    {
+        let mut k = base.clone();
+        k.image_type = metal2vulkan::vk::ImageType::TYPE_3D;
+        variants.push(("image_type", k));
+    }
+    {
+        let mut k = base.clone();
+        k.format = metal2vulkan::vk::Format::R8G8B8A8_UNORM;
+        variants.push(("format", k));
+    }
+    {
+        let mut k = base.clone();
+        k.extent = [1280, 720, 1];
+        variants.push(("extent", k));
+    }
+    {
+        let mut k = base.clone();
+        k.mip_levels = 4;
+        variants.push(("mip_levels", k));
+    }
+    {
+        let mut k = base.clone();
+        k.array_layers = 2;
+        variants.push(("array_layers", k));
+    }
+    {
+        let mut k = base.clone();
+        k.samples = metal2vulkan::vk::SampleCountFlags::from_raw(4);
+        variants.push(("samples", k));
+    }
+    {
+        let mut k = base.clone();
+        k.tiling = vk::ImageTiling::LINEAR;
+        variants.push(("tiling", k));
+    }
+    {
+        let mut k = base.clone();
+        k.usage |= metal2vulkan::vk::ImageUsageFlags::HOST_TRANSFER;
+        variants.push(("usage", k));
+    }
+    {
+        let mut k = base.clone();
+        k.flags = metal2vulkan::vk::ImageCreateFlags::MUTABLE_FORMAT;
+        variants.push(("flags", k));
+    }
+    {
+        let mut k = base.clone();
+        k.view_formats = vec![metal2vulkan::vk::Format::B8G8R8A8_SRGB];
+        variants.push(("view_formats", k));
+    }
+    {
+        let mut k = base.clone();
+        k.sharing_staging = true;
+        variants.push(("sharing_staging", k));
+    }
+    {
+        let mut k = base.clone();
+        k.memory_class = MemoryClass::Memoryless;
+        variants.push(("memory_class", k));
+    }
+
+    for (field, variant) in variants {
+        let (hit, expired) = pool.take_at(&variant, now + Duration::from_secs(1));
+        assert!(expired.is_empty());
+        assert!(hit.is_none(), "key variant {field} must not alias base key");
+    }
+
+    let (hit, _) = pool.take_at(&base, now + Duration::from_secs(1));
+    assert_eq!(hit.expect("exact key must hit").raw.as_raw(), 1);
+    let _ = Holds::Images;
+}
