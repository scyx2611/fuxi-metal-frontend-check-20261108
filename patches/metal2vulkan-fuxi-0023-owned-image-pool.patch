+#[test]
+fn budget_bytes_and_count_cap_lru_eviction() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let t0 = Instant::now();
+    let key = base_key();
+
+    // 1. Oversized entry (> MAX_POOL_ENTRY_BYTES = 48 MiB) is rejected from pooling and destroyed immediately.
+    let oversized = make_entry(&harness, key.clone(), 900, MAX_POOL_ENTRY_BYTES + 4096, t0);
+    let evicted = pool.give_back_at(oversized, t0);
+    assert_eq!(evicted.len(), 1);
+    assert_eq!(evicted[0].raw.as_raw(), 900);
+    destroy_entries(&harness.vk, &harness.memory, evicted);
+    assert_eq!(pool.stats(), (0, 0));
+    assert_eq!(harness.image_destroy_count(), 1);
+
+    // 2. Count cap (MAX_POOL_IMAGES = 64): inserting 71 small entries evicts oldest 7.
+    for i in 0..(MAX_POOL_IMAGES + 7) {
+        let now = t0 + Duration::from_millis(i as u64);
+        let evicted = pool.give_back_at(make_entry(&harness, key.clone(), 1000 + i as u64, 4096, now), now);
+        destroy_entries(&harness.vk, &harness.memory, evicted);
+        let (count, bytes) = pool.stats();
+        assert!(count <= MAX_POOL_IMAGES);
+        assert!(bytes <= MAX_POOL_BYTES);
+    }
+    assert_eq!(pool.stats().0, MAX_POOL_IMAGES);
+    assert_eq!(harness.image_destroy_count(), 1 + 7);
+    // Oldest kept should be 1007 (1000..=1006 evicted); newest is 1000 + MAX_POOL_IMAGES + 6 (1070).
+    let mut popped = Vec::new();
+    while let (Some(e), _) = pool.take_at(&key, t0 + Duration::from_secs(1)) {
+        popped.push(e.raw.as_raw());
+    }
+    assert_eq!(popped.first().copied(), Some(1000 + MAX_POOL_IMAGES as u64 + 6));
+    assert_eq!(popped.last().copied(), Some(1007));
+
+    // 3. Bytes cap (MAX_POOL_BYTES = 64 MiB): inserting 3 x 25 MiB (= 75 MiB) evicts oldest first.
+    let ops_before = harness.image_destroy_count();
+    let big = 25 << 20;
+    for j in 0..3u64 {
+        let now = t0 + Duration::from_secs(2) + Duration::from_millis(j);
+        let evicted = pool.give_back_at(make_entry(&harness, key.clone(), 2000 + j, big, now), now);
+        destroy_entries(&harness.vk, &harness.memory, evicted);
+        let (count, bytes) = pool.stats();
+        assert!(count <= MAX_POOL_IMAGES);
+        assert!(bytes <= MAX_POOL_BYTES);
+    }
+    assert_eq!(pool.stats(), (2, 50 << 20));
+    assert_eq!(harness.image_destroy_count(), ops_before + 1);
+    let ops = harness.ops();
+    assert!(ops.contains(&MockOp::Image(2000)));
+}
