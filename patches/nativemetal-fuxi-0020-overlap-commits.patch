+/// Patch 0020: whether a command buffer this thread commits now may go to the deferred-encoding worker (`fuxihyb=8` and a
+/// deferred thread, FuxiDeferred.rs).
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_command_buffer_commit_deferrable() -> bool {
+    guard_free(false, || Ok(fuxi_deferred::overlap()))
+}
+
+struct Committing(*mut NmbCommandBuffer);
+// SAFETY: the frontend keeps the command buffer (and so its handle) alive until `after` has run, as the header states.
+unsafe impl Send for Committing {}
+
+/// Patch 0020: `nmb_command_buffer_on_completed`, `_on_scheduled` and `_commit`, queued on the worker behind this thread's
+/// queued render calls, returning at once: 1 queued, 0 not for this thread (nothing queued: commit as before), -1 refused.
+/// The worker runs them in that order and then `after(context, why)`: `why` null where the runtime took the commit, else
+/// the refusal (a refused registration or commit runs neither handler). Nothing touches the handle after `after`.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_command_buffer_commit_deferred(command_buffer: *mut NmbCommandBuffer,
+                                                     completed: Option<extern "C" fn(*mut c_void)>,
+                                                     scheduled: Option<extern "C" fn(*mut c_void)>,
+                                                     after: Option<extern "C" fn(*mut c_void, *const c_char)>,
+                                                     context: *mut c_void) -> i32 {
+    guard_free(-1, || {
+        if !fuxi_deferred::overlap() {
+            return Ok(0);
+        }
+        let (completed, scheduled, after) = (completed.ok_or("null handler")?, scheduled.ok_or("null handler")?, after.ok_or("null handler")?);
+        get(command_buffer)?;
+        let target = Committing(command_buffer);
+        let context = Context(context);
+        fuxi_deferred::task(Box::new(move || {
+            let (target, context) = (target, context);
+            let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| -> Result<(), String> {
+                let command_buffer = get(target.0)?;
+                let on_completed = Context(context.0);
+                command_buffer.current().add_completed_handler(Box::new(move |_| {
+                    let context = on_completed;
+                    completed(context.0)
+                })).map_err(e("completed handler"))?;
+                let on_scheduled = Context(context.0);
+                command_buffer.current().add_scheduled_handler(Box::new(move |_| {
+                    let context = on_scheduled;
+                    scheduled(context.0)
+                })).map_err(e("scheduled handler"))?;
+                if let Some(why) = fuxi_deferred::take_failure(&command_buffer.deferred) {
+                    return Err(why);
+                }
+                command_buffer.current().commit().map_err(e("commit"))?;
+                command_buffer.uncount();
+                Ok(())
+            }))
+            .unwrap_or_else(|_| Err("panic in the Metal runtime".into()));
+            match outcome {
+                Ok(()) => after(context.0, std::ptr::null()),
+                Err(why) => {
+                    let why = std::ffi::CString::new(why.replace('\0', " ")).unwrap_or_default();
+                    after(context.0, why.as_ptr())
+                }
+            }
+        }));
+        Ok(1)
+    })
+}
