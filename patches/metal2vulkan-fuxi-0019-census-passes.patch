+    "deferred", "lclear", "lload", "ldc", "big",
+];
+pub(crate) const PASS_KINDS: usize = 15;
+
+/// An ended render encoder's [`PASS_NAMES`] counts.
+#[inline]
+pub(crate) fn pass(counts: [u64; PASS_KINDS]) {
+    if on() {
+        PASS_COUNTS.with(|c| {
+            for (cell, n) in c.iter().zip(counts) {
+                cell.set(cell.get() + n);
+            }
+        });
+    }
+}
