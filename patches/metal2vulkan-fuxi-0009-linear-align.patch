+/// FUXI: the texels a linear texture's rows are aligned to in the alignment the device answers
+/// (`minimumLinearTextureAlignmentForPixelFormat:`, `deviceLinearTextureAlignmentBytes`), where the
+/// device answers more than [`LINEAR_ALIGNMENT`]: on iOS 64 (Turnip lays a linear image's rows 64
+/// texels apart, and a host allocation's image takes no other pitch without DRM format modifiers,
+/// which the phone's Darwin KMD lacks), unless `FUXI_M2V_LINEAR_ALIGN` is 0; elsewhere none.
+/// CoreAnimation lays the bytes of the images it decodes out at the answer, so their rows then sit
+/// where the device's linear image does and the texture aliases them: at 16 every such image was a
+/// shadow, copied in before every encoder that sampled it (the kernel's per-IB profile measured
+/// about 7.7 million texels a frame, most of the GPU's frame). Metal permits a larger answer; the
+/// runtime still takes every texture at [`LINEAR_ALIGNMENT`].
+pub(super) fn fuxi_linear_texels() -> Option<u64> {
+    static TEXELS: std::sync::OnceLock<Option<u64>> = std::sync::OnceLock::new();
+    *TEXELS.get_or_init(|| match std::env::var_os("FUXI_M2V_LINEAR_ALIGN") {
+        Some(value) if value == "0" => None,
+        Some(_) => Some(64),
+        None => cfg!(target_os = "ios").then_some(64),
+    })
+}
