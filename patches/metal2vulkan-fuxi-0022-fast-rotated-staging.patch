diff --git a/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs b/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs
index e39bdbe..1db1312 100644
--- a/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs
+++ b/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs
@@ -169,3 +169,33 @@ fn rotated_b3a8_surface_layout_matches_ios_landscape_notes() {
         }
     }
 }
+
+/// On iOS (`contiguous_planes = true`), two-plane IOSurface writebacks collapse per-row copies
+/// (up to 1,398 regions for MobileNotes landscape `'b3a8'`) into 2 contiguous plane copies while
+/// staying strictly inside each plane and never touching the inter-plane alignment gap.
+#[test]
+fn surface_two_plane_contiguous_back_regions_collapse_rows_without_touching_gap() {
+    let cases: [([u64; 2], u64, [u64; 2], u64); 2] = [
+        ([1125, 699], 4608, [3_227_648, 1152], 4_128_768),
+        ([1125, 147], 4608, [688_128, 1152], 884_736),
+    ];
+    for ([sw, sh], color_pitch, alpha, alloc_size) in cases {
+        let plane0 = color(0, color_pitch, [sw, sh]);
+        let (layout, _) = surface_layout(&plane0, alpha, alloc_size).unwrap();
+        let row_regions = layout.back_regions(64, 4096, false);
+        assert_eq!(row_regions.len(), (2 * sh) as usize);
+        let fast_regions = layout.back_regions(64, 4096, true);
+        assert_eq!(fast_regions.len(), 2);
+        // Plane 0 ends strictly at or before alpha_at (inter-plane gap untouched).
+        assert_eq!(fast_regions[0].src_offset, 64);
+        assert_eq!(fast_regions[0].dst_offset, 4096);
+        assert_eq!(fast_regions[0].size, (sh - 1) * color_pitch + 4 * sw);
+        assert!(fast_regions[0].size <= layout.alpha_at);
+        // Plane 1 starts at alpha_at and ends exactly at span.
+        assert_eq!(fast_regions[1].src_offset, 64 + layout.alpha_at);
+        assert_eq!(fast_regions[1].dst_offset, 4096 + layout.alpha_at);
+        assert_eq!(fast_regions[1].size, (sh - 1) * layout.alpha_pitch + sw);
+        assert_eq!(layout.alpha_at + fast_regions[1].size, layout.span());
+        assert!(layout.span() <= alloc_size);
+    }
+}
