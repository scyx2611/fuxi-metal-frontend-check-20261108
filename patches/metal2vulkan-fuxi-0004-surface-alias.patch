+/// FUXI: whether a surface plane's texture that renders or writes aliases its padded rows
+/// (`storage_over_buffer`): on iOS unless `FUXI_M2V_SURFACE_SHADOW` is 1; elsewhere only where it
+/// is 0.
+fn fuxi_surface_alias() -> bool {
+    static ALIAS: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ALIAS.get_or_init(|| match std::env::var_os("FUXI_M2V_SURFACE_SHADOW") {
+        Some(value) => value == "0",
+        None => cfg!(target_os = "ios"),
+    })
+}
