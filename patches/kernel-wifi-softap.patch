+/* ---- SoftAP virtual BSD interface (ap1) ----------------------------------------------------------- */
+
+static unsigned ap_tx_logged, ap_rx_logged, ap_flags_logged;
+static uint16_t ap_last_flags;
+
+static errno_t
+ap_output(ifnet_t ifp, mbuf_t packet)
+{
+	size_t length = mbuf_pkthdr_len(packet);
+	bool sent = false;
+
+	if (length >= ETHER_HDR_LEN && length <= FUXI_WIFI_NET_FRAME_MAX &&
+	    ap_link != NULL && __atomic_load_n(&ap_link_up, __ATOMIC_ACQUIRE)) {
+		uint8_t et[2] = { 0, 0 };
+		if (mbuf_copydata(packet, 12, 2, et) == 0) {
+			uint16_t ethertype = ((uint16_t)et[0] << 8) | et[1];
+			if (ethertype != 0x888eu) {
+				unsigned n = __atomic_fetch_add(&ap_tx_logged, 1u, __ATOMIC_RELAXED);
+				if (n < 16u) {
+					printf("FUXI WIFI IOS: ap1 TX #%u eth=0x%04x len=%zu\n", n + 1u, ethertype, length);
+				}
+			}
+		}
+		bpf_tap_out(ifp, DLT_EN10MB, packet, NULL, 0);
+		lck_mtx_lock(&ap_tx_lock);
+		sent = ap_link->transmit(packet, length);
+		lck_mtx_unlock(&ap_tx_lock);
+	}
+	if (sent) {
+		ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+void
+fuxi_wifi_ap_net_input(const uint8_t *frame, size_t length)
+{
+	struct ifnet_stat_increment_param stats = { .packets_in = 1, .bytes_in = (uint32_t)length };
+	unsigned int chunks = 1;
+	mbuf_t packet = NULL;
+
+	if (ap_ifp == NULL || !__atomic_load_n(&ap_link_up, __ATOMIC_ACQUIRE) ||
+	    length < ETHER_HDR_LEN || length > FUXI_WIFI_NET_FRAME_MAX ||
+	    mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &packet) != 0) {
+		return;
+	}
+	uint16_t ethertype = ((uint16_t)frame[12] << 8) | frame[13];
+	if (ethertype != 0x888eu) {
+		unsigned n = __atomic_fetch_add(&ap_rx_logged, 1u, __ATOMIC_RELAXED);
+		if (n < 16u) {
+			printf("FUXI WIFI IOS: ap1 RX #%u eth=0x%04x len=%zu\n", n + 1u, ethertype, length);
+		}
+	}
+	if (mbuf_copyback(packet, 0, length, frame, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(packet);
+		return;
+	}
+	char *header = mbuf_data(packet);
+	mbuf_pkthdr_setrcvif(packet, ap_ifp);
+	mbuf_pkthdr_setheader(packet, header);
+	mbuf_adj(packet, ETHER_HDR_LEN);
+	bpf_tap_in(ap_ifp, DLT_EN10MB, packet, header, ETHER_HDR_LEN);
+	ifnet_input(ap_ifp, packet, &stats);
+}
+
+static unsigned ap_ioctls_said;
+
+static errno_t
+ap_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	const int media[] = { IFM_IEEE80211 | IFM_AUTO };
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	if (ap_ioctls_said < 80) {
+		char who[32] = "?";
+		proc_selfname(who, sizeof(who));
+		if (strcmp(who, "configd") != 0) {
+			ap_ioctls_said++;
+			printf("FUXI WIFI IOS: ap1 is asked %#lx by %s\n", command, who);
+		}
+	}
+	switch (command) {
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS: {
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		uint16_t fl = ifnet_flags(ifp);
+		uint16_t prev = ap_last_flags;
+		if (fl != prev) {
+			ap_last_flags = fl;
+			if (ap_flags_logged < 40u) {
+				ap_flags_logged++;
+				printf("FUXI WIFI IOS: ap1 flags 0x%x (up=%u run=%u promisc=%u)\n",
+				    fl, !!(fl & IFF_UP), !!(fl & IFF_RUNNING), !!(fl & IFF_PROMISC));
+			}
+			if ((fl & IFF_PROMISC) && !(prev & IFF_PROMISC)) {
+				fuxi_wifi_apple80211_ap_bridge_ready(true);
+			} else if (!(fl & IFF_PROMISC) && (prev & IFF_PROMISC)) {
+				fuxi_wifi_apple80211_ap_bridge_ready(false);
+			}
+		}
+		break;
+	}
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID | (__atomic_load_n(&ap_link_up, __ATOMIC_ACQUIRE) ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;
+	default:
+		error = fuxi_wifi_apple80211_ioctl(command, data);
+		break;
+	}
+	return error;
+}
+
+void
+fuxi_wifi_ap_net_link_state(bool up)
+{
+	if (ap_ifp == NULL) {
+		return;
+	}
+	if (up) {
+		ifnet_set_flags(ap_ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	}
+	if (up == __atomic_load_n(&ap_link_up, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	__atomic_store_n(&ap_link_up, up, __ATOMIC_RELEASE);
+	printf("FUXI WIFI IOS: ap1 link (%s) is %s\n", ap_link ? ap_link->name : "?", up ? "up" : "down");
+	net_link_event(ap_ifp, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF);
+}
+
+bool
+fuxi_wifi_ap_net_attach(const struct fuxi_wifi_net_link *link)
+{
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "fuxi-wifi-ap1",
+		.uniqueid_len = sizeof("fuxi-wifi-ap1") - 1,
+		.name = "ap",
+		.unit = 1,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = IFNET_SUBFAMILY_WIFI,
+		.type = IFT_ETHER,
+		.output = ap_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = ap_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	ifnet_t ifp = NULL;
+	errno_t error;
+
+	if (ap_link != NULL || link == NULL) {
+		return false;
+	}
+	ap_link = link;
+	ap_link_up = false;
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("FUXI WIFI IOS: ap1 cannot be made: error %d\n", error);
+		ap_link = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(ifp, 0, -1);
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("FUXI WIFI IOS: ap1 cannot be attached: error %d\n", error);
+		ifnet_release(ifp);
+		ap_link = NULL;
+		return false;
+	}
+	ifnet_set_lladdr(ifp, link->address, ETHER_ADDR_LEN);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	ap_ifp = ifp;
+	printf("FUXI WIFI IOS: ap1 attached on %s (SoftAP)\n", link->name);
+	FuxiWLANStartAP("ap1", link->address);
+	return true;
+}
