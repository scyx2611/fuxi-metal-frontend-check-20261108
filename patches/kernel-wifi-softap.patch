++out:
++	if (asked != NULL) {
++		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
++		kfree_data(asked, sizeof(*asked));
++	}
++	if (cfg != NULL) {
++		memset_s(cfg, sizeof(*cfg), 0, sizeof(*cfg));
++		kfree_data(cfg, sizeof(*cfg));
