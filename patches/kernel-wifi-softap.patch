+void
+FuxiWLANStartAP(const char * interface, const uint8_t * address)
+{
+	IOService * controller = g_wlan_controller;
+	FuxiWLAN * ap = OSTypeAlloc(FuxiWLAN);
+	OSData * mac;
+	OSNumber * number;
+
+	if (controller == NULL || interface == NULL || ap == NULL || !ap->init()) {
+		OSSafeReleaseNULL(ap);
