+// True when args holds token as one whole whitespace-delimited word.
+static bool fuxiBootArgsHaveToken(const char *args,const char *token) {
+ if(!args || !token || !*token)return false;
+ const size_t length=strlen(token);
+ for(const char *at=args;*at;) {
+  while(*at==' ' || *at=='\t' || *at=='\n')at++;
+  const char *end=at;while(*end && *end!=' ' && *end!='\t' && *end!='\n')end++;
+  if((size_t)(end-at)==length && !strncmp(at,token,length))return true;
+  at=end;
+ }
+ return false;
+}
+static bool fuxiSwapWaitEnabled() {
+ if(const char *value=getenv("FUXI_NATIVE_SWAP_WAIT"))return strcmp(value,"0")!=0;
+ static const bool bootEnabled=[]{
+  char args[4096]={};size_t size=sizeof(args)-1;
+  return sysctlbyname("kern.bootargs",args,&size,nullptr,0)!=0 || !fuxiBootArgsHaveToken(args,"fuxiswapwait=0");
+ }();
+ return bootEnabled;
+}
