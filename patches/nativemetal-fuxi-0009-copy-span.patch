 /// # Safety
+/// `region_words` has six readable words and `out` has one writable word.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_texture_copy_span(texture: *const NmbTexture, region_words: *const u64,
+                                                level: u64, slice: u64, bytes_per_row: u64,
+                                                bytes_per_image: u64, write: bool, out: *mut u64) -> bool {
+    guard(false, || {
+        let out = unsafe { out.as_mut() }.ok_or("null span output")?;
+        let needed = get(texture)?.0.host_copy_required_bytes(region(region_words)?, level, slice,
+                                                                bytes_per_row, bytes_per_image, write)
+            .map_err(e("texture copy span"))?;
+        *out = needed as u64;
+        Ok(true)
+    })
+}
