+#[cfg(test)]
+mod ffi_span_tests {
+    use super::HostLayout;
+
+    fn layout(row_bytes: u64, rows: u64, images: u64, bytes_per_row: u64, bytes_per_image: u64) -> HostLayout {
+        HostLayout { row_bytes, rows, images, bytes_per_row, bytes_per_image }
+    }
+
+    #[test]
+    fn compressed_and_padded_rows_only_reach_the_last_block() {
+        // 1125 x 2436 ASTC 4x4: 282 blocks of 16 bytes in each of 609 block rows.
+        assert_eq!(layout(4512, 609, 1, 4512, 0).checked_host_len(), Some(2_747_808));
+        assert_eq!(layout(16, 2, 1, 64, 0).checked_host_len(), Some(80));
+        assert_eq!(layout(16, 4, 1, 0, 0).checked_host_len(), Some(16));
+    }
+
+    #[test]
+    fn image_stride_empty_regions_and_overflow_are_checked() {
+        assert_eq!(layout(16, 3, 2, 32, 128).checked_host_len(), Some(208));
+        assert_eq!(layout(16, 3, 2, 32, 0).checked_host_len(), Some(80));
+        assert_eq!(layout(0, 9, 2, u64::MAX, u64::MAX).checked_host_len(), Some(0));
+        assert_eq!(layout(16, 0, 2, u64::MAX, u64::MAX).checked_host_len(), Some(0));
+        assert_eq!(layout(16, 3, 2, u64::MAX, 0).checked_host_len(), None);
+        assert_eq!(layout(16, 1, 3, 0, u64::MAX).checked_host_len(), None);
+        assert_eq!(layout(16, 2, 2, 1, u64::MAX).checked_host_len(), None);
     }
 }
 
