+    /// Validate a CPU texture copy and return the exact caller memory span it reaches.
+    /// This lets FFI clients construct a slice without including unused row or block padding.
+    pub fn host_copy_required_bytes(
+        &self,
+        region: Region,
+        level: u64,
+        slice: u64,
+        bytes_per_row: u64,
+        bytes_per_image: u64,
+        write: bool,
+    ) -> Result<usize, Error> {
+        let call = if write { "replace_region" } else { "get_bytes" };
+        let Some(copy) = self.host_copy(call, &region, level, slice, bytes_per_row, bytes_per_image)? else {
+            return Ok(0);
+        };
+        let invalid_range = || invalid(call, Problem::Copy(CopyProblem::BufferRange));
+        let bytes = copy.host.checked_host_len().ok_or_else(invalid_range)?;
+        let bytes = usize::try_from(bytes).map_err(|_| invalid_range())?;
+        if bytes > isize::MAX as usize {
+            return Err(invalid_range());
+        }
+        Ok(bytes)
+    }
