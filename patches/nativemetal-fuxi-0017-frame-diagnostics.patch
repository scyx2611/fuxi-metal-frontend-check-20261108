+// Frame diagnostics (patch 0017, always on, report only): per display frame (a commit that stored an IOSurface), the time from
+// the command buffer's creation to its commit, the gap since the previous frame's commit in display periods, and what the
+// committing thread made since its previous frame (textures, buffers, pipelines, surface imports, and the time inside them).
+// Every 600 frames two lines: the distributions, and heavy (>= 6 ms) against light (< 4 ms) frames.
+struct FrameMakes {uint32_t textures=0,buffers=0,pipelines=0,imports=0;uint64_t us=0;};
+static thread_local FrameMakes tMakes;
+struct FrameMake {
+ const uint64_t began;uint32_t FrameMakes::*const kind;
+ explicit FrameMake(uint32_t FrameMakes::*what):began(nowUs()),kind(what){}
+ ~FrameMake(){tMakes.*kind+=1;tMakes.us+=nowUs()-began;}
+};
+struct FrameClass {uint32_t n=0,textures=0,buffers=0,pipelines=0,imports=0;uint64_t encodeUs=0,makeUs=0,draws=0,passes=0;};
+struct FrameStats {uint64_t lastUs=0;uint32_t n=0,encode[8]={},gap[5]={};FrameClass heavy,light;};
+static std::mutex gFrameLock;
+static FrameStats gFrames;
+static void fuxiFrameNote(uint64_t committedUs,uint64_t encodeUs,const EncodedWork &work) {
+ const FrameMakes made=tMakes;tMakes=FrameMakes();
+ std::lock_guard<std::mutex> lock(gFrameLock);
+ FrameStats &f=gFrames;
+ static const uint64_t limits[7]={2000,4000,6000,8000,10000,13000,17000};
+ unsigned bucket=0;while(bucket<7 && encodeUs>=limits[bucket])bucket++;
+ f.encode[bucket]++;
+ if(f.lastUs && committedUs>f.lastUs) {
+  const uint64_t gap=committedUs-f.lastUs;
+  f.gap[gap>=50000?4:std::min<uint64_t>(3,(gap+4135)/8270>0?(gap+4135)/8270-1:0)]++;
+ }
+ f.lastUs=committedUs;
+ FrameClass *c=encodeUs>=6000?&f.heavy:encodeUs<4000?&f.light:nullptr;
+ if(c) {
+  c->n++;c->encodeUs+=encodeUs;c->makeUs+=made.us;c->draws+=work.draws;c->passes+=work.passes;
+  c->textures+=made.textures>0;c->buffers+=made.buffers>0;c->pipelines+=made.pipelines>0;c->imports+=made.imports>0;
+ }
+ if(++f.n<600)return;
+ fprintf(stderr,"FUXI FRAME: n=%u encode_ms <2/<4/<6/<8/<10/<13/<17/more %u/%u/%u/%u/%u/%u/%u/%u gap_periods 1/2/3/4+/idle %u/%u/%u/%u/%u\n",
+  f.n,f.encode[0],f.encode[1],f.encode[2],f.encode[3],f.encode[4],f.encode[5],f.encode[6],f.encode[7],f.gap[0],f.gap[1],f.gap[2],f.gap[3],f.gap[4]);
