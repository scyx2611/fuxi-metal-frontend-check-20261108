+  fprintf(stderr,"FUXI FRAME: %s n=%u encode_us=%.0f draws=%.1f passes=%.1f make_us=%.0f with_tex=%u with_buf=%u with_pipe=%u with_import=%u\n",
+   name,c.n,c.encodeUs/n,c.draws/n,c.passes/n,c.makeUs/n,c.textures,c.buffers,c.pipelines,c.imports);
+ };
+ line("heavy",f.heavy);line("light",f.light);
+ const uint64_t last=f.lastUs;f=FrameStats();f.lastUs=last;
+}
