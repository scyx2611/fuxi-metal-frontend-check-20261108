+++ b/crates/metal2vulkan-runtime/src/tests/first_loss.rs
@@ -0,0 +1,73 @@
+//! Unit tests for the first device-loss latch and 32-entry event ring (`device/first_loss.rs`).
+
+use crate::device::first_loss::{FirstLossState, MAX_EVENT_RING};
+use ash::vk;
+
+#[test]
+fn event_ring_keeps_latest_32_entries_fifo() {
+    let state = FirstLossState::new();
+    assert!(state.get().is_none());
+    assert!(state.format_report().is_none());
+
+    for i in 0..45 {
+        state.record_event(format!("event-{i}"));
+    }
+
+    let latched = state.latch(vk::Result::ERROR_DEVICE_LOST, "unit_ring", "overflow_check");
+    assert_eq!(latched.recent_events.len(), MAX_EVENT_RING);
+    assert!(latched.recent_events[0].contains("event-14"));
+    assert!(latched.recent_events[MAX_EVENT_RING - 2].contains("event-44"));
+    assert!(latched.recent_events[MAX_EVENT_RING - 1].contains("LOSS stage=unit_ring"));
+}
+
+#[test]
+fn first_loss_latch_is_single_shot_and_never_overwritten() {
+    let state = FirstLossState::new();
+    state.record_event("submit_1");
+    state.record_event("bind_sparse_2");
+
+    let first = state
+        .latch(
+            vk::Result::ERROR_DEVICE_LOST,
+            "bind_sparse_buffer",
+            "initial hang",
+        )
+        .clone();
+    assert_eq!(first.stage, "bind_sparse_buffer");
+    assert_eq!(first.vk_result, vk::Result::ERROR_DEVICE_LOST.as_raw());
+    assert_eq!(first.detail, "initial hang");
+    assert_eq!(first.recent_events.len(), 3);
+
+    // Later events and subsequent loss calls must never overwrite the first latched snapshot.
+    state.record_event("late_event_after_loss");
+    let second = state.latch(
+        vk::Result::ERROR_SURFACE_LOST_KHR,
+        "completion_wait_semaphores",
+        "secondary ripple",
+    );
+    assert_eq!(second, &first);
+    assert_eq!(state.get(), Some(&first));
+    assert_eq!(state.get().unwrap().recent_events.len(), 3);
+}
+
+#[test]
+fn format_report_contains_stage_result_and_ring() {
+    let state = FirstLossState::new();
+    state.record_event("alloc_dma_buf");
+    state.record_event("create_image_linear");
+
+    let _ = state.latch(
+        vk::Result::ERROR_DEVICE_LOST,
+        "dma_buf_import",
+        "type_index=2 format=B8G8R8A8_UNORM",
+    );
+
+    let report = state.format_report().expect("latched report must exist");
+    assert!(report.contains("first_loss stage=dma_buf_import"));
+    assert!(report.contains("vk_result=-4"));
+    assert!(report.contains("detail=type_index=2 format=B8G8R8A8_UNORM"));
+    assert!(report.contains("recent_events(3):"));
+    assert!(report.contains("alloc_dma_buf"));
+    assert!(report.contains("create_image_linear"));
+    assert!(report.contains("LOSS stage=dma_buf_import"));
+}
