new file mode 100644
index 0000000..92e454c
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/device/first_loss.rs
@@ -0,0 +1,116 @@
+//! First device-loss latch and bounded 32-entry diagnostic event ring (`device/first_loss.rs`).
+
+use super::lock;
+use ash::vk;
+use std::collections::VecDeque;
+use std::fmt::Write as _;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+/// Maximum number of recent diagnostic events retained per device in the ring buffer.
+pub const MAX_EVENT_RING: usize = 32;
+
+/// Latched details of the very first `VK_ERROR_DEVICE_LOST` or fatal runtime loss observed on a
+/// device.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FirstLossInfo {
+    /// Raw Vulkan `VkResult` integer code (for example `-4` for `VK_ERROR_DEVICE_LOST`).
+    pub vk_result: i32,
+    /// Runtime stage where the first loss was observed.
+    pub stage: &'static str,
+    /// Contextual diagnostic message describing the failing operation.
+    pub detail: String,
+    /// Milliseconds elapsed from device creation until the first loss was latched.
+    pub elapsed_ms: u64,
+    /// Snapshot of up to [`MAX_EVENT_RING`] recent events ending at the latched loss.
+    pub recent_events: Vec<String>,
+}
+
+/// Per-device diagnostic ring buffer and atomic first-loss latch.
+pub(crate) struct FirstLossState {
+    created_at: Instant,
+    first_loss: OnceLock<FirstLossInfo>,
+    event_ring: Mutex<VecDeque<String>>,
+}
+
+impl Default for FirstLossState {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl FirstLossState {
+    /// Create a fresh diagnostic state anchored at the current monotonic instant.
+    pub(crate) fn new() -> Self {
+        Self {
+            created_at: Instant::now(),
+            first_loss: OnceLock::new(),
+            event_ring: Mutex::new(VecDeque::with_capacity(MAX_EVENT_RING)),
+        }
+    }
+
+    fn elapsed_ms(&self) -> u64 {
+        self.created_at.elapsed().as_millis() as u64
+    }
+
+    /// Push a bounded diagnostic event into the 32-entry FIFO ring buffer.
+    pub(crate) fn record_event(&self, event: impl AsRef<str>) {
+        let elapsed_ms = self.elapsed_ms();
+        let entry = format!("+{elapsed_ms}ms {}", event.as_ref());
+        let mut ring = lock(&self.event_ring);
+        while ring.len() >= MAX_EVENT_RING {
+            ring.pop_front();
+        }
+        ring.push_back(entry);
+    }
+
+    /// Atomically latch the first device loss. Subsequent calls preserve the original latch.
+    pub(crate) fn latch(
+        &self,
+        vk_result: vk::Result,
+        stage: &'static str,
+        detail: impl Into<String>,
+    ) -> &FirstLossInfo {
+        let detail = detail.into();
+        self.first_loss.get_or_init(|| {
+            let elapsed_ms = self.elapsed_ms();
+            let loss_entry = format!("+{elapsed_ms}ms LOSS stage={stage} vk={vk_result:?} {detail}");
+            let recent_events = {
+                let mut ring = lock(&self.event_ring);
+                while ring.len() >= MAX_EVENT_RING {
+                    ring.pop_front();
+                }
+                ring.push_back(loss_entry);
+                ring.iter().cloned().collect()
+            };
+            FirstLossInfo {
+                vk_result: vk_result.as_raw(),
+                stage,
+                detail,
+                elapsed_ms,
+                recent_events,
+            }
+        })
+    }
+
+    /// Return the latched first-loss info, if any loss has occurred.
+    pub(crate) fn get(&self) -> Option<&FirstLossInfo> {
+        self.first_loss.get()
+    }
+
+    /// Format the latched first-loss report and its captured event ring for diagnostics/logging.
+    pub(crate) fn format_report(&self) -> Option<String> {
+        let info = self.get()?;
+        let mut out = String::new();
+        let _ = writeln!(
+            out,
+            "first_loss stage={} vk_result={} elapsed_ms={} detail={}",
+            info.stage, info.vk_result, info.elapsed_ms, info.detail
+        );
+        let _ = writeln!(out, "recent_events({}):", info.recent_events.len());
+        for (idx, ev) in info.recent_events.iter().enumerate() {
+            let _ = writeln!(out, "  [{idx}] {ev}");
+        }
+        Some(out)
+    }
+}
