+/// [`image`](Self::image) on `device`, latching first-loss diagnostics before marking `device`
+/// lost if image creation reports `VK_ERROR_DEVICE_LOST`.
+///
+/// # Safety
+///
+/// As [`image`](Self::image)'s: `device` is live, and `info` and its chain are valid for it.
+pub(crate) unsafe fn device_image(
+    device: &crate::Device,
+    info: &vk::ImageCreateInfo<'_>,
+    stage: &'static str,
+) -> Result<vk::Image, Error> {
+    // SAFETY: the caller's.
+    match unsafe { image(device.shared().vk(), info) } {
+        Ok(raw) => Ok(raw),
+        Err(Error::DeviceLost) => {
+            device.latch_first_loss(
+                vk::Result::ERROR_DEVICE_LOST,
+                stage,
+                format!(
+                    "create_image format={} extent={}x{}x{}",
+                    info.format.as_raw(),
+                    info.extent.width,
+                    info.extent.height,
+                    info.extent.depth
+                ),
+            );
+            device.mark_lost();
+            Err(Error::DeviceLost)
+        }
+        Err(other) => {
+            device.record_event(format!("create_image stage={stage} err={other}"));
+            Err(other)
+        }
+    }
+}
+
+/// [`image_or_refusal`](Self::image_or_refusal) on `device`, latching first-loss diagnostics
+/// before marking `device` lost on `VK_ERROR_DEVICE_LOST`.
+///
+/// # Safety
+///
+/// As [`image_or_refusal`](Self::image_or_refusal)'s: `device` is live, and `info` and its chain
+/// are valid for it.
+pub(crate) unsafe fn device_image_or_refusal(
+    device: &crate::Device,
+    info: &vk::ImageCreateInfo<'_>,
+    stage: &'static str,
+) -> Result<Result<vk::Image, vk::Result>, Error> {
+    // SAFETY: the caller's.
+    match unsafe { image_or_refusal(device.shared().vk(), info) } {
+        Ok(res) => Ok(res),
+        Err(Error::DeviceLost) => {
+            device.latch_first_loss(
+                vk::Result::ERROR_DEVICE_LOST,
+                stage,
+                format!(
+                    "create_image_or_refusal format={} extent={}x{}x{}",
+                    info.format.as_raw(),
+                    info.extent.width,
+                    info.extent.height,
+                    info.extent.depth
+                ),
+            );
+            device.mark_lost();
+            Err(Error::DeviceLost)
+        }
+        Err(other) => {
+            device.record_event(format!("create_image_or_refusal stage={stage} err={other}"));
+            Err(other)
+        }
+    }
+}
