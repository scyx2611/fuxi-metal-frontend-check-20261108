+static inline uint32_t *
+tu_cs_error_buf(struct tu_cs *cs, uint32_t *cap_out)
+{
+   if (cs->error_scratch && cs->error_scratch_size) {
+      *cap_out = cs->error_scratch_size;
+      return cs->error_scratch;
+   }
+   *cap_out = ARRAY_SIZE(cs->error_scratch_inline);
+   return cs->error_scratch_inline;
+}
+
+void
+tu_cs_fail(struct tu_cs *cs, VkResult err, uint32_t min_dwords)
+{
+   if (err == VK_SUCCESS)
+      err = VK_ERROR_DEVICE_LOST;
+
+   if (cs->error == VK_SUCCESS) {
+      cs->error = err;
+      if (cs->vk_cmd)
+         vk_command_buffer_set_error(cs->vk_cmd, err);
+   }
+
+   for (uint32_t i = 0; i < TU_COND_EXEC_STACK_SIZE; i++)
+      cs->cond_dwords[i] = NULL;
+
+   uint32_t inline_cap = ARRAY_SIZE(cs->error_scratch_inline);
+   uint32_t *buf = cs->error_scratch_inline;
+   uint32_t cap = inline_cap;
+
+   if (cs->mode != TU_CS_MODE_EXTERNAL && min_dwords > inline_cap) {
+      if (cs->error_scratch_size >= min_dwords && cs->error_scratch) {
+         buf = cs->error_scratch;
+         cap = cs->error_scratch_size;
+      } else {
+         uint32_t target = MAX2(256u, min_dwords);
+         uint32_t *new_buf = (uint32_t *) realloc(cs->error_scratch,
+                                                  (size_t) target * sizeof(uint32_t));
+         if (new_buf) {
+            cs->error_scratch = new_buf;
+            cs->error_scratch_size = target;
+            buf = new_buf;
+            cap = target;
+         } else if (cs->error_scratch && cs->error_scratch_size) {
+            buf = cs->error_scratch;
+            cap = cs->error_scratch_size;
+         }
+      }
+   } else if (cs->error_scratch && cs->error_scratch_size) {
+      buf = cs->error_scratch;
+      cap = cs->error_scratch_size;
+   }
+
+   cs->start = buf;
+   cs->cur = buf;
+   cs->end = buf + cap;
+   cs->reserved_end = buf + MIN2(min_dwords ? min_dwords : cap, cap);
+}
+
