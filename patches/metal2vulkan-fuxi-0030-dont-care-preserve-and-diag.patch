 /// attachment ([`dont_care_clear`]) and to its clear value for depth and stencil. Which attachments took it, and whether the pass took
 /// the near-equivalent (its draws reach the tiles their primitives touch): the attachment it
 /// names, for the notice.
+static DONT_CARE_CLEARED_ATTACHMENTS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+static DONT_CARE_PRESERVED_ATTACHMENTS: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+/// Number of non-memoryless stored `DontCare` attachments converted to `LoadAction::Clear`.
+pub fn dont_care_cleared_attachments() -> u64 {
+    DONT_CARE_CLEARED_ATTACHMENTS.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// Number of non-memoryless stored `DontCare` attachments preserved as `LoadAction::Load`.
+pub fn dont_care_preserved_attachments() -> u64 {
+    DONT_CARE_PRESERVED_ATTACHMENTS.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// FUXI: `FUXI_M2V_DONT_CARE_PRESERVE=1` preserves all non-memoryless stored `DontCare`
+/// attachments as `LoadAction::Load` instead of clearing them to zero.
+fn fuxi_dont_care_preserve() -> bool {
+    static PRESERVE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *PRESERVE.get_or_init(|| match std::env::var_os("FUXI_M2V_DONT_CARE_PRESERVE") {
+        Some(value) => value != "0",
+        None => false,
+    })
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum DontCareStep {
+    Unchanged,
+    MemorylessCleared,
+    Cleared,
+    Preserved,
+}
+
+pub(super) fn step_dont_care_color(
+    access: &mut AttachmentAccess,
+    reach: PassReach,
+    preserve: bool,
+) -> DontCareStep {
+    // A memoryless color reads zero in every tile a draw touches, the only tiles where a
+    // fragment reads it (an Apple M4, EV ZIN-zp1-m4: a framebuffer fetch of one read 0 in
+    // 52 runs of 52, also after a pass that cleared other bytes into the tiles), and it is
+    // never stored: a clear to zero is Metal's answer exactly, in a pass that draws.
+    if access.load == LoadAction::DontCare && access.memoryless {
+        if reach != PassReach::Nothing {
+            access.load = LoadAction::Clear;
+            return DontCareStep::MemorylessCleared;
+        }
+        return DontCareStep::Unchanged;
+    }
+    if access.load != LoadAction::DontCare || access.memoryless || !stores(access.store) {
+        return DontCareStep::Unchanged;
+    }
+    if reach == PassReach::Nothing || preserve {
+        access.load = LoadAction::Load;
+        DONT_CARE_PRESERVED_ATTACHMENTS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        DontCareStep::Preserved
+    } else {
+        access.load = LoadAction::Clear;
+        DONT_CARE_CLEARED_ATTACHMENTS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        DontCareStep::Cleared
+    }
+}
+
+pub(super) fn step_dont_care_aspect(
+    access: &mut AttachmentAccess,
+    reach: PassReach,
+    preserve: bool,
+) -> DontCareStep {
+    if access.load != LoadAction::DontCare || access.memoryless || !stores(access.store) {
+        return DontCareStep::Unchanged;
+    }
+    if reach == PassReach::Nothing || preserve {
+        access.load = LoadAction::Load;
+        DONT_CARE_PRESERVED_ATTACHMENTS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        DontCareStep::Preserved
+    } else {
+        access.load = LoadAction::Clear;
+        DONT_CARE_CLEARED_ATTACHMENTS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        DontCareStep::Cleared
+    }
+}
