diff --git a/FuxiTilePipelineGuard.h b/FuxiTilePipelineGuard.h
new file mode 100644
index 0000000..911345a
--- /dev/null
+++ b/FuxiTilePipelineGuard.h
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: MIT
+// Structural validation and non-fatal NSError guard for Metal tile render pipeline descriptors
+// (VectorKit / WeatherUI probe newRenderPipelineStateWithTileDescriptor:options:reflection:error:).
+// Because NativeMetalObjects/metal2vulkan-runtime withholds supportsTileShaders=NO, exposing an
+// explicit optional refusal prevents _objc_msgForward / NSInvalidArgumentException and avoids
+// tripping ForegroundClientGate::fault() on normal vertex/fragment/compute GPU work.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+
+enum class FuxiTileGuardCode : int32_t {
+    NilDescriptor = 1,
+    MissingTileFunction = 2,
+    ForeignTileFunction = 3,
+    InvalidSampleCount = 4,
+    ForeignBinaryArchive = 5,
+    TileShadersUnsupported = 6,
+};
+
+struct FuxiTilePipelineDescInfo {
+    bool hasDescriptor = false;
+    bool hasTileFunction = false;
+    bool tileFunctionIsNative = false;
+    bool hasForeignArchive = false;
+    bool threadgroupSizeMatchesTileSize = false;
+    uint64_t rasterSampleCount = 0;
+    uint64_t maxTotalThreadsPerThreadgroup = 0;
+    uint64_t tileFunctionType = 0;
+    uint64_t options = 0;
+    uint32_t colorAttachmentMask = 0;
+    uint64_t colorFormats[8] = {};
+    const char *label = nullptr;
+    const char *tileFunctionName = nullptr;
+};
+
+struct FuxiTilePipelineGuardResult {
+    bool supported = false;
+    bool triggersGlobalFault = false;
+    bool shouldLog = false;
+    FuxiTileGuardCode code = FuxiTileGuardCode::TileShadersUnsupported;
+    const char *errorDomain = "org.fuxi.native-metal.optional";
+    int32_t errorCode = -1;
+    char reason[256] = {};
+};
+
+inline bool fuxiValidTileSampleCount(uint64_t samples) {
+    return samples >= 1 && samples <= 16 && (samples & (samples - 1)) == 0;
+}
+
+inline FuxiTilePipelineGuardResult fuxiEvaluateTilePipelineDescriptor(
+    const FuxiTilePipelineDescInfo &info,
+    std::atomic<uint64_t> *logCounter = nullptr,
+    uint64_t maxLogs = 8) {
+    FuxiTilePipelineGuardResult out{};
+    out.supported = false;
+    out.triggersGlobalFault = false;
+    out.errorDomain = "org.fuxi.native-metal.optional";
+    out.errorCode = -1;
+
+    if (logCounter) {
+        const uint64_t idx = logCounter->fetch_add(1, std::memory_order_relaxed);
+        out.shouldLog = idx < maxLogs;
+    }
+
+    const char *safeLabel = (info.label && info.label[0]) ? info.label : "-";
+    const char *safeFn = (info.tileFunctionName && info.tileFunctionName[0]) ? info.tileFunctionName : "-";
+
+    if (!info.hasDescriptor) {
+        out.code = FuxiTileGuardCode::NilDescriptor;
+        std::snprintf(out.reason, sizeof(out.reason),
+                      "tile pipeline descriptor is nil (supportsTileShaders=NO)");
+        return out;
+    }
+    if (!info.hasTileFunction) {
+        out.code = FuxiTileGuardCode::MissingTileFunction;
+        std::snprintf(out.reason, sizeof(out.reason),
+                      "tile pipeline missing tileFunction (label=%.48s supportsTileShaders=NO)",
+                      safeLabel);
+        return out;
+    }
+    if (!info.tileFunctionIsNative) {
+        out.code = FuxiTileGuardCode::ForeignTileFunction;
+        std::snprintf(out.reason, sizeof(out.reason),
+                      "tile pipeline foreign tileFunction (label=%.48s fn=%.48s)",
+                      safeLabel, safeFn);
+        return out;
+    }
+    if (!fuxiValidTileSampleCount(info.rasterSampleCount)) {
+        out.code = FuxiTileGuardCode::InvalidSampleCount;
+        std::snprintf(out.reason, sizeof(out.reason),
+                      "tile pipeline invalid rasterSampleCount=%llu (label=%.48s fn=%.48s)",
+                      static_cast<unsigned long long>(info.rasterSampleCount), safeLabel, safeFn);
+        return out;
+    }
+    if (info.hasForeignArchive) {
+        out.code = FuxiTileGuardCode::ForeignBinaryArchive;
+        std::snprintf(out.reason, sizeof(out.reason),
+                      "tile pipeline foreign binary archive (label=%.48s fn=%.48s)",
+                      safeLabel, safeFn);
+        return out;
+    }
+
+    uint32_t mask = info.colorAttachmentMask & 0xffu;
+    for (uint32_t i = 0; i < 8; ++i) {
+        if (info.colorFormats[i] != 0) {
+            mask |= (1u << i);
+        }
+    }
+
+    out.code = FuxiTileGuardCode::TileShadersUnsupported;
+    std::snprintf(
+        out.reason, sizeof(out.reason),
+        "tile pipelines are not supported on this GPU (supportsTileShaders=NO label=%.40s fn=%.40s ftype=%llu samples=%llu colors=0x%x tgMatch=%u maxThreads=%llu)",
+        safeLabel, safeFn,
+        static_cast<unsigned long long>(info.tileFunctionType),
+        static_cast<unsigned long long>(info.rasterSampleCount),
+        static_cast<unsigned>(mask),
+        info.threadgroupSizeMatchesTileSize ? 1u : 0u,
+        static_cast<unsigned long long>(info.maxTotalThreadsPerThreadgroup));
+    return out;
+}
