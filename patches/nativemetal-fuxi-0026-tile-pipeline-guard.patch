 } @catch(NSException *e){fuxiFailure(e.reason.UTF8String);@throw;} } catch(const std::exception &e){fuxiFailure(e.what());throw;} catch(...){fuxiFailure("NativeMetal C++ exception");throw;} }
+// Tile render pipelines (VectorKit / WeatherUI): supportsTileShaders is NO on this runtime, so implement both MTLDevice tile
+// selectors explicitly to validate the descriptor, log bounded diagnostics, and return nil + optional NSError instead of
+// falling into _objc_msgForward / NSInvalidArgumentException or tripping ForegroundClientGate::fault().
+- (id<MTLRenderPipelineState>)newRenderPipelineStateWithTileDescriptor:(MTLTileRenderPipelineDescriptor *)d options:(MTLPipelineOption)options
+                                                            reflection:(MTLAutoreleasedRenderPipelineReflection *)reflection error:(NSError **)error { try { @try {
+ if(reflection)*reflection=nil;
+ static std::atomic<uint64_t> gTileGuardLogs{0};
+ FuxiTilePipelineDescInfo info{};
+ info.options=(uint64_t)options;
+ if(d) {
+  info.hasDescriptor=true;
+  info.label=d.label?d.label.UTF8String:nullptr;
+  info.rasterSampleCount=(uint64_t)d.rasterSampleCount;
+  info.maxTotalThreadsPerThreadgroup=(uint64_t)d.maxTotalThreadsPerThreadgroup;
+  info.threadgroupSizeMatchesTileSize=(bool)d.threadgroupSizeMatchesTileSize;
+  id<MTLFunction> tf=d.tileFunction;
+  if(tf) {
+   info.hasTileFunction=true;
+   info.tileFunctionIsNative=[(id)tf isKindOfClass:[NBFunction class]];
+   info.tileFunctionType=(uint64_t)tf.functionType;
+   info.tileFunctionName=tf.name?tf.name.UTF8String:nullptr;
+  }
+  for(unsigned i=0;i<8;i++) {
+   MTLTileRenderPipelineColorAttachmentDescriptor *ca=d.colorAttachments[i];
+   if(ca)info.colorFormats[i]=(uint64_t)ca.pixelFormat;
+  }
+  for(id archive in d.binaryArchives) {
+   if(![archive isKindOfClass:[NBBinaryArchive class]]){info.hasForeignArchive=true;break;}
+  }
+ }
+ const FuxiTilePipelineGuardResult guard=fuxiEvaluateTilePipelineDescriptor(info,&gTileGuardLogs,8);
+ if(guard.shouldLog)NSLog(@"FUXI MTL: %s",guard.reason);
+ if(error)*error=[NSError errorWithDomain:@(guard.errorDomain) code:guard.errorCode userInfo:@{NSLocalizedDescriptionKey:[NSString stringWithUTF8String:guard.reason]?:@"tile pipelines unsupported"}];
+ return nil;
+} @catch(NSException *e){fuxiFailure(e.reason.UTF8String);@throw;} } catch(const std::exception &e){fuxiFailure(e.what());throw;} catch(...){fuxiFailure("NativeMetal C++ exception");throw;} }
+- (void)newRenderPipelineStateWithTileDescriptor:(MTLTileRenderPipelineDescriptor *)d options:(MTLPipelineOption)options
+                               completionHandler:(MTLNewRenderPipelineStateWithReflectionCompletionHandler)handler { try { @try {
+ NSError *error=nil;
+ id<MTLRenderPipelineState> state=[(id<MTLDevice>)self newRenderPipelineStateWithTileDescriptor:d options:options reflection:nil error:&error];
+ if(handler)handler(state,nil,error);
+} @catch(NSException *e){fuxiFailure(e.reason.UTF8String);@throw;} } catch(const std::exception &e){fuxiFailure(e.what());throw;} catch(...){fuxiFailure("NativeMetal C++ exception");throw;} }
 - (id<MTLBinaryArchive>)newBinaryArchiveWithDescriptor:(MTLBinaryArchiveDescriptor *)d error:(NSError **)error { try { @try {
  if(d.url && !d.url.isFileURL){if(error)*error=nbError(@"a file URL is required");return nil;}
  NmbBinaryArchive *handle=nmb_binary_archive_new(gDevice,d.url?d.url.fileSystemRepresentation:nullptr);
