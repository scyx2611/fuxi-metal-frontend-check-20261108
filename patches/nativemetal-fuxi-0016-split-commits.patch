+
+/// A frontend command buffer: the runtime command buffer it encodes into now and, in their order on the queue, the parts it
+/// committed early (patch 0016). The frontend splits only with `fuxisplit` on the boot line; without it there is never a part and
+/// this is exactly one runtime command buffer, as before.
+pub struct NmbCommandBuffer {
+    pieces: Mutex<Pieces>,
+    queue: Arc<QueueOpen>,
+}
+
+struct Pieces {
+    current: CommandBuffer,
+    earlier: Vec<CommandBuffer>,
+    /// Still counted among its queue's open command buffers: until its commit or its release.
+    counted: bool,
+}
+
+impl NmbCommandBuffer {
+    /// Its parts. Never held across a runtime call that may run a handler: a handler may ask for its status.
+    fn pieces(&self) -> MutexGuard<'_, Pieces> {
+        self.pieces.lock().unwrap_or_else(PoisonError::into_inner)
+    }
+
+    /// The runtime command buffer it encodes into now (its last part).
+    fn current(&self) -> CommandBuffer {
+        self.pieces().current.clone()
