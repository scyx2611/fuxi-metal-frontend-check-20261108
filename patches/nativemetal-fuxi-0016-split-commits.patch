+    /// Its parts, the early ones first.
+    fn all(&self) -> Vec<CommandBuffer> {
+        let pieces = self.pieces();
+        let mut all = Vec::with_capacity(pieces.earlier.len() + 1);
+        all.extend(pieces.earlier.iter().cloned());
+        all.push(pieces.current.clone());
+        all
+    }
