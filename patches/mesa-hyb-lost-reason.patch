+static pthread_mutex_t g_last_lost_lock = PTHREAD_MUTEX_INITIALIZER;
+static char g_last_lost_reason[512];
+static bool g_last_lost_set = false;
+
+static VkResult __attribute__((format(printf, 2, 3)))
+tu_darwin_set_lost(struct tu_device *dev, const char *fmt, ...)
+{
+   char msg[sizeof(g_last_lost_reason)];
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(msg, sizeof(msg), fmt, ap);
+   va_end(ap);
+
+   pthread_mutex_lock(&g_last_lost_lock);
+   if (!g_last_lost_set) {
+      snprintf(g_last_lost_reason, sizeof(g_last_lost_reason), "%s", msg);
+      g_last_lost_set = true;
+   }
+   pthread_mutex_unlock(&g_last_lost_lock);
+
+   mesa_loge("FUXI TURNIP LOST: %s", msg);
+   return vk_device_set_lost(&dev->vk, "%s", msg);
+}
+
+extern "C" __attribute__((visibility("default"))) size_t
+tu_darwin_last_lost_reason(char *out, size_t size)
+{
+   pthread_mutex_lock(&g_last_lost_lock);
+   size_t len = g_last_lost_set ? strlen(g_last_lost_reason) : 0;
+   if (len > 0 && out && size > 0)
+      snprintf(out, size, "%s", g_last_lost_reason);
+   pthread_mutex_unlock(&g_last_lost_lock);
+   return len;
+}
