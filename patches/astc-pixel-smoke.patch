+   if(got[0]!=want[2] || got[1]!=want[1] || got[2]!=want[0] || got[3]!=want[3])fail("ASTC phase %u pixel %u,%u BGRA %u,%u,%u,%u",phase,x,y,got[0],got[1],got[2],got[3]);
