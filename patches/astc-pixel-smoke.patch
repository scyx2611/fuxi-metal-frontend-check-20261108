+// ASTC 4x4 LDR constant-colour block: UNORM16 RGBA, in little-endian order.
+// Encoding reference: ARM astcenc_symbolic_physical.cpp, symbolic_to_physical.
+static void astcSolid(uint8_t *block,const uint8_t rgba[4]) {
+ static const uint8_t header[8]={0xfc,0xfd,0xff,0xff,0xff,0xff,0xff,0xff};
+ memcpy(block,header,sizeof(header));
+ for(unsigned i=0;i<4;++i){block[8+i*2]=rgba[i];block[9+i*2]=rgba[i];}
+}
+static void astcPixels(id<MTLDevice>device,id<MTLCommandQueue>q) {
+ static const uint8_t colors[5][4]={{255,0,0,255},{0,255,0,255},{0,0,255,255},{255,255,255,255},{255,255,0,255}};
+ uint8_t blocks[64];for(unsigned i=0;i<4;++i)astcSolid(blocks+i*16,colors[i]);
+ MTLTextureDescriptor *td=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatASTC_4x4_LDR width:8 height:8 mipmapped:NO];
+ td.storageMode=MTLStorageModeShared;td.usage=MTLTextureUsageShaderRead;
+ id<MTLTexture>input=[device newTextureWithDescriptor:td];if(!input)fail("ASTC input allocation");
+ [input replaceRegion:MTLRegionMake2D(0,0,8,8) mipmapLevel:0 slice:0 withBytes:blocks bytesPerRow:32 bytesPerImage:64];
+ uint8_t encoded[96];memset(encoded,0x39,sizeof(encoded));
+ [input getBytes:encoded+16 bytesPerRow:32 bytesPerImage:64 fromRegion:MTLRegionMake2D(0,0,8,8) mipmapLevel:0 slice:0];
+ if(memcmp(encoded+16,blocks,64))fail("ASTC compressed round-trip");
+ for(unsigned i=0;i<16;++i)if(encoded[i]!=0x39 || encoded[i+80]!=0x39)fail("ASTC encoded sentinel %u",i);
+ MTLTextureDescriptor *out=[MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatBGRA8Unorm width:256 height:256 mipmapped:NO];
+ out.storageMode=MTLStorageModePrivate;out.usage=MTLTextureUsageRenderTarget;
+ id<MTLTexture>target=[device newTextureWithDescriptor:out];
+ NSError *error=nil;id<MTLLibrary>lib=[device newLibraryWithURL:[NSURL fileURLWithPath:@FUXI_MTL_METALLIB] error:&error];
+ if(!target || !lib || error)fail("ASTC target/library %s",error.description.UTF8String);
+ id<MTLFunction>v=[lib newFunctionWithName:@"fuxi_quad"],f=[lib newFunctionWithName:@"fuxi_sample"];
+ if(!v || !f)fail("ASTC shader functions");
+ MTLRenderPipelineDescriptor *pd=[MTLRenderPipelineDescriptor new];pd.vertexFunction=v;pd.fragmentFunction=f;pd.colorAttachments[0].pixelFormat=MTLPixelFormatBGRA8Unorm;
+ id<MTLRenderPipelineState>p=[device newRenderPipelineStateWithDescriptor:pd error:&error];
+ MTLSamplerDescriptor *sd=[MTLSamplerDescriptor new];sd.minFilter=MTLSamplerMinMagFilterNearest;sd.magFilter=MTLSamplerMinMagFilterNearest;
+ id<MTLSamplerState>sampler=[device newSamplerStateWithDescriptor:sd];
+ id<MTLBuffer>readback=[device newBufferWithLength:262656 options:MTLResourceStorageModeShared];
+ if(!p || error || !sampler || !readback || !readback.contents)fail("ASTC pipeline/sampler/readback %s",error.description.UTF8String);
+ for(unsigned phase=0;phase<2;++phase) {
+  if(phase){uint8_t yellow[16];astcSolid(yellow,colors[4]);
+   [input replaceRegion:MTLRegionMake2D(0,0,4,4) mipmapLevel:0 slice:0 withBytes:yellow bytesPerRow:16 bytesPerImage:16];}
+  memset(readback.contents,0x39,readback.length);
+  MTLRenderPassDescriptor *pass=[MTLRenderPassDescriptor renderPassDescriptor];pass.colorAttachments[0].texture=target;
+  pass.colorAttachments[0].loadAction=MTLLoadActionClear;pass.colorAttachments[0].storeAction=MTLStoreActionStore;
+  id<MTLCommandBuffer>command=q.commandBuffer;id<MTLRenderCommandEncoder>r=[command renderCommandEncoderWithDescriptor:pass];
+  if(!r)fail("ASTC render encoder");[r setRenderPipelineState:p];[r setFragmentTexture:input atIndex:0];[r setFragmentSamplerState:sampler atIndex:0];
+  [r drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:6];[r endEncoding];
+  id<MTLBlitCommandEncoder>b=command.blitCommandEncoder;if(!b)fail("ASTC readback encoder");
+  [b copyFromTexture:target sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0,0,0) sourceSize:MTLSizeMake(256,256,1)
+   toBuffer:readback destinationOffset:256 destinationBytesPerRow:1024 destinationBytesPerImage:262144];[b endEncoding];finish(command);
+  verify(readback,0,256,0x39);verify(readback,262400,256,0x39);
+  const uint8_t *pixels=(const uint8_t *)readback.contents+256;
+  for(unsigned y=0;y<256;++y)for(unsigned x=0;x<256;++x) {
+   unsigned quadrant=(y>=128?2:0)+(x>=128?1:0);const uint8_t *want=colors[(phase && !quadrant)?4:quadrant];
