+            .shared()
+            .textures
+            .facts(self.compile_device().profile());
+        let usage = texture_usage(descriptor.usage, descriptor.swizzle);
+        let plan = plan_image(layout, usage, false, &facts)
+            .map_err(|refusal| image_error(call, refusal))?;
+        let plan = self.with_undeclared_usage(plan, layout, usage, false, &facts)?;
+        let copies = ImageUsageFlags::TRANSFER_SRC | ImageUsageFlags::TRANSFER_DST;
+        if !plan.usage.contains(copies) || plan.samples != SampleCountFlags::COUNT_1 {
+            return Err(Error::NotImplemented(RuntimeGap::RotatedTexture));
+        }
+        let hazard = turned.options().hazard_tracking_mode()?;
+        let identity = Identity::new(hazard, false);
+        let image =
+            self.new_image_as_it_lies(plan, layout, descriptor, identity, Device::runtime_owner)?;
+        let (raw, start) = turned.buffer.at(color.offset);
+        let staging = HeapPlaneCopies::staging(self, &planes_layout, start, hazard)?;
+        let planes = Box::new(HeapPlaneCopies::new(self, &staging, &planes_layout, hazard)?);
+        let [width, height, _] = layout.extent;
+        let stored_row_pitch = 8u64 * planes_layout.width;
+        let stored_span = stored_row_pitch * planes_layout.height;
+        let turn = Box::new(RotatedCopies::new_with_backing(
+            self,
+            planes.tight_backing(),
+            Frame {
+                rotation,
+                extent: [width, height],
+                texel_bytes: 8,
+                row_pitch: stored_row_pitch,
+                span: stored_span,
+            },
+            hazard,
+        )?);
+        let (bytes, tracked) = turned
+            .buffer
+            .tracked(color.offset..color.offset + planes_layout.span());
+        let copies = ShadowCopies {
+            source: ShadowSource::Bytes {
+                buffer: ShadowBuffer::of(&turned.buffer, raw),
+                key: bytes.key,
+                bytes: tracked,
+                target: ShadowTarget::RotatedPlanes {
+                    image: image.raw.get(),
+                    staging,
+                    planes,
+                    turn,
+                    pixel_format: pf,
+                },
+                alias: turned.buffer.alias().map(|alias| alias.key),
+            },
+            shadow_key: image.identity.key,
+            shadow_range: UseRange::Image {
+                aspects: vk::ImageAspectFlags::COLOR,
+                levels: 0..1,
+                layers: 0..1,
+            },
+            tracked: turned.tracked(),
+            drops_writes: false,
+        };
+        self.degrade(Degradation::ShadowedTexture, || {
+            let [stored_width, stored_height] = rotated::stored_extent(rotation, [width, height]);
+            let object = format!(
+                "a {width}x{height} {} texture of rotation {rotation} over a surface's two planes",
+                pf.name()
+            );
+            let why = format!(
+                "it renders through an image of its pass's frame, whose texels are turned into \
+                 the surface's {stored_width}x{stored_height} two-plane rows after each pass that \
+                 stores it and back before each that uses it"
+            );
+            (object, why)
+        });
+        Ok(Storage::Shadow {
+            image: image.shared(),
+            texels: Arc::new(turned.with_alpha(alpha_checked)),
+            copies: Arc::new(copies),
+        })
+    }
 }
