diff --git a/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs b/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs
index 811c963..e39bdbe 100644
--- a/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs
+++ b/crates/metal2vulkan-runtime/src/tests/surface_two_planes.rs
@@ -146,3 +146,26 @@ fn a_surface_two_plane_texture_takes_plane_1_from_the_surface_s_facts() {
         }
     }
 }
+
+/// Real iOS 16.7.16 landscape MobileNotes `'b3a8'` surfaces (699x1125 stored in 1125x699, and
+/// 147x1125 stored in 1125x147) satisfy `surface_layout` once `stored_extent` un-rotates them.
+#[test]
+fn rotated_b3a8_surface_layout_matches_ios_landscape_notes() {
+    use crate::rotated::stored_extent;
+    let cases: [([u32; 2], u64, [u64; 2], u64); 2] = [
+        ([699, 1125], 4608, [3_227_648, 1152], 4_128_768),
+        ([147, 1125], 4608, [688_128, 1152], 884_736),
+    ];
+    for rotation in [1u8, 3u8, 4u8] {
+        for (logical, color_pitch, alpha, alloc_size) in cases {
+            let [sw, sh] = stored_extent(rotation, logical);
+            assert_eq!([sw, sh], [logical[1], logical[0]]);
+            let plane0 = color(0, color_pitch, [u64::from(sw), u64::from(sh)]);
+            let (layout, plane1) = surface_layout(&plane0, alpha, alloc_size)
+                .unwrap_or_else(|why| panic!("rot={rotation} {logical:?}: {why}"));
+            assert_eq!((layout.width, layout.height), (u64::from(sw), u64::from(sh)));
+            assert!(layout.span() <= alloc_size);
+            assert_eq!(plane1.rows, u64::from(sh));
+        }
+    }
+}
