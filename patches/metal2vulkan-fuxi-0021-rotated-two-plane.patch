+
+    /// The unpacked 8-byte-per-texel tight buffer `(VkBuffer, offset)` holding the stored frame's
+    /// `(color_word, alpha_byte)` pairs, used as the backing buffer for rotated two-plane copies.
+    pub(crate) fn tight_backing(&self) -> (vk::Buffer, u64) {
+        (self.tight_raw, self.regions[0].buffer_offset)
+    }
+
+    /// Record only the surface-bytes <-> unpacked tight-buffer half of a two-plane copy, leaving
+    /// the tight buffer populated for a chained rotation pass (`into`) or consuming it back into
+    /// the two surface planes (`!into`).
+    ///
+    /// # Safety
+    ///
+    /// `command_buffer` is recording, outside a render pass; the buffers and sets are live until
+    /// it completes.
+    pub(crate) unsafe fn record_staging_only(
+        &self,
+        device: &ash::Device,
+        command_buffer: vk::CommandBuffer,
+        (bytes, staging): (vk::Buffer, &ShadowStaging),
+        into: bool,
+    ) {
+        let (step, set) = match into {
+            true => (&self.moves[0], self.sets.sets[0]),
+            false => (&self.moves[1], self.sets.sets[1]),
+        };
+        // SAFETY: the caller's contract; the copies lie in the buffers (planned when the texture
+        // was made), the shape's 52 bytes fit its slot, and the sets bind the texture's own buffers.
+        unsafe {
+            Barrier::everything().record(device, command_buffer);
+            if into {
+                device.cmd_copy_buffer(command_buffer, bytes, staging.raw(), &[staging.into]);
+            }
+            device.cmd_update_buffer(command_buffer, self.shapes_raw, step.at, &step.shape);
+            Barrier::everything().record(device, command_buffer);
+            device.cmd_bind_pipeline(
+                command_buffer,
+                vk::PipelineBindPoint::COMPUTE,
+                self.kernel.pipeline,
+            );
+            device.cmd_bind_descriptor_sets(
+                command_buffer,
+                vk::PipelineBindPoint::COMPUTE,
+                self.kernel.layout,
+                0,
+                &[set],
+                &[],
+            );
+            device.cmd_dispatch(command_buffer, step.groups[0], step.groups[1], 1);
+            Barrier::everything().record(device, command_buffer);
+            if !into {
+                device.cmd_copy_buffer(command_buffer, staging.raw(), bytes, &staging.back);
+            }
+        }
+    }
 }
