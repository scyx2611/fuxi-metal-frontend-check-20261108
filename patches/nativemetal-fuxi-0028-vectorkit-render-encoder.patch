+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_set_depth_clip_mode(encoder: *mut NmbEncoder, mode: u64) -> bool {
+    if let Some(slot) = deferred(encoder) {
+        return queue(slot, || Ok(Op::DepthClipMode(depth_clip_mode(mode)?)));
+    }
+    guard(false, || {
+        render(encoder)?.set_depth_clip_mode(depth_clip_mode(mode)?).map_err(e("depth clip mode"))?;
+        Ok(true)
+    })
+}
