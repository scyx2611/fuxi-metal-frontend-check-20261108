+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_set_viewports(encoder: *mut NmbEncoder, viewports: *const f64, count: usize) -> bool {
+    guard_free(false, || {
+        let list: Vec<Viewport> = if count == 0 {
+            Vec::new()
+        } else {
+            if viewports.is_null() {
+                return Err("null viewports".into());
+            }
+            // SAFETY: caller passes count * 6 f64 values per NativeMetalObjects.h.
+            let raw_vals = unsafe { std::slice::from_raw_parts(viewports, count * 6) };
+            raw_vals.chunks_exact(6).map(|v| Viewport::new(v[0], v[1], v[2], v[3], v[4], v[5])).collect()
+        };
+        if let Some(slot) = deferred(encoder) {
+            fuxi_deferred::push(slot, Op::Viewports(list.into_boxed_slice()));
+            return Ok(true);
+        }
+        fuxi_deferred::drain(Location::caller());
+        render(encoder)?.set_viewports(&list).map_err(e("viewports"))?;
+        Ok(true)
+    })
+}
