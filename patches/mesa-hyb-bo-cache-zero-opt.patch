+   out[1] = retire->cache_stats.zeroed_bytes;
+   out[2] = retire->cache_stats.zeroed_mapped_on_reuse;
+   out[3] = retire->cache_stats.zeroed_map_failures;
+   pthread_mutex_unlock(&retire->lock);
+}
+
+static bool
+darwin_zero_cache_bo_str_ieq(const char *a, const char *b)
+{
+   while (*a && *b) {
+      unsigned char ca = (unsigned char)*a++;
+      unsigned char cb = (unsigned char)*b++;
+      if (ca >= 'A' && ca <= 'Z')
+         ca += 'a' - 'A';
+      if (cb >= 'A' && cb <= 'Z')
+         cb += 'a' - 'A';
+      if (ca != cb)
+         return false;
+   }
+   return *a == '\0' && *b == '\0';
+}
+
+static bool
+darwin_zero_cache_bo_enabled(void)
+{
+   const char *env = getenv("FUXI_TURNIP_ZERO_CACHE_BO");
+   if (!env || !*env)
+      return false;
+   if (strcmp(env, "1") == 0 ||
+       darwin_zero_cache_bo_str_ieq(env, "true") ||
+       darwin_zero_cache_bo_str_ieq(env, "yes") ||
+       darwin_zero_cache_bo_str_ieq(env, "on")) {
+      static bool logged_once = false;
+      if (!__atomic_exchange_n(&logged_once, true, __ATOMIC_ACQ_REL))
+         mesa_logi("FUXI TURNIP BO CACHE: zero-on-reuse enabled (FUXI_TURNIP_ZERO_CACHE_BO=1)");
+      return true;
+   }
+   return false;
 }
 
