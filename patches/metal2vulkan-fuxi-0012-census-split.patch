+/// One split of a phase: its pieces' nanoseconds over the draws that reached every mark.
+#[derive(Clone, Copy)]
+struct Split<const N: usize> {
+    ns: [u64; N],
+    draws: u64,
+}
+
+impl<const N: usize> Default for Split<N> {
+    fn default() -> Self {
+        Split {
+            ns: [0; N],
+            draws: 0,
+        }
+    }
+}
+
+impl<const N: usize> Split<N> {
+    /// Add `cur`'s pieces from mark time `from` through `marks` to `to`, where all are set.
+    fn add<const M: usize>(&mut self, cur: &Current, from: u64, marks: [usize; M], to: u64) {
+        debug_assert_eq!(M + 1, N);
+        if from == 0 || to == 0 || marks.iter().any(|&m| cur.marks[m] == 0) {
+            return;
+        }
+        let mut at = from;
+        for (piece, &m) in self.ns.iter_mut().zip(&marks) {
+            *piece += cur.marks[m].saturating_sub(at);
+            at = at.max(cur.marks[m]);
+        }
+        self.ns[N - 1] += to.saturating_sub(at);
+        self.draws += 1;
+    }
+
+    /// The report line `{head} {name} n=.. piece=..`.
+    fn line(&self, head: &str, name: &str, names: [&str; N]) -> String {
+        let mut text = format!("{head} {name} n={}", self.draws);
+        for (piece, ns) in names.iter().zip(self.ns) {
+            text.push_str(&format!(" {piece}={:.1}", us(ns, self.draws)));
+        }
+        text
+    }
+}
