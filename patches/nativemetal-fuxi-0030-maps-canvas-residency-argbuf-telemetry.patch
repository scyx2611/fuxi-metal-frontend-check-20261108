+unsafe fn decode_deferred_heaps(heaps: *const *mut NmbHeap, count: usize) -> Result<Box<[Heap]>, String> {
+    let slice = unsafe { slice_from_raw(heaps, count, "heaps")? };
+    let mut out = Vec::with_capacity(slice.len());
+    for &h in slice {
+        out.push(get(h)?.0.clone());
+    }
+    Ok(out.into_boxed_slice())
+}
