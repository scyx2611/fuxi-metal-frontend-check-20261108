+#[repr(C)]
+pub struct NmbResourceRef {
+    pub kind: u32,
+    pub handle: *const c_void,
+}
+
+unsafe fn decode_resource_refs<'a>(resources: *const NmbResourceRef, count: usize) -> Result<Vec<ResourceRef<'a>>, String> {
+    let slice = unsafe { slice_from_raw(resources, count, "resources")? };
+    let mut out = Vec::with_capacity(slice.len());
+    for r in slice {
+        match r.kind {
+            NMB_RESOURCE_BUFFER => out.push(ResourceRef::Buffer(&get(r.handle as *const NmbBuffer)?.0)),
+            NMB_RESOURCE_TEXTURE => out.push(ResourceRef::Texture(&get(r.handle as *const NmbTexture)?.0)),
+            kind => return Err(format!("unknown resource kind {kind}")),
+        }
+    }
+    Ok(out)
+}
+
+unsafe fn decode_deferred_resources(resources: *const NmbResourceRef, count: usize) -> Result<Box<[DeferredResource]>, String> {
+    let slice = unsafe { slice_from_raw(resources, count, "resources")? };
+    let mut out = Vec::with_capacity(slice.len());
+    for r in slice {
+        match r.kind {
+            NMB_RESOURCE_BUFFER => out.push(DeferredResource::Buffer(get(r.handle as *const NmbBuffer)?.0.clone())),
+            NMB_RESOURCE_TEXTURE => out.push(DeferredResource::Texture(get(r.handle as *const NmbTexture)?.0.clone())),
+            kind => return Err(format!("unknown resource kind {kind}")),
+        }
+    }
+    Ok(out.into_boxed_slice())
+}
+
+unsafe fn decode_heaps<'a>(heaps: *const *mut NmbHeap, count: usize) -> Result<Vec<&'a Heap>, String> {
+    let slice = unsafe { slice_from_raw(heaps, count, "heaps")? };
+    let mut out = Vec::with_capacity(slice.len());
+    for &h in slice {
+        out.push(&get(h)?.0);
+    }
+    Ok(out)
+}
