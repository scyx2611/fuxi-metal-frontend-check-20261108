+    fn argument_descriptor_decode_and_abi_safety() {
+        let valid = NmbArgumentDescriptor {
+            data_type: DataType::Texture.as_raw() as u64,
+            index: 3,
+            array_length: 4,
+            access: BindingAccess::ReadOnly.as_raw() as u64,
