+    #[test]
+    fn slice_from_raw_handles_empty_and_null() {
+        assert!(unsafe { slice_from_raw::<u64>(std::ptr::null(), 0, "x") }.unwrap().is_empty());
+        assert!(unsafe { slice_from_raw::<u64>(std::ptr::null(), 1, "x") }.is_err());
+        assert!(unsafe { slice_from_raw::<u64>([1u64].as_ptr(), usize::MAX, "x") }.is_err());
+        let data = [10u64, 20];
+        assert_eq!(unsafe { slice_from_raw(data.as_ptr(), 2, "x") }.unwrap(), &[10, 20]);
+    }
+
+    #[test]
+    fn resource_and_stage_bitflags_validate() {
+        assert_eq!(raw::<ResourceUsage>(1 | 2 | 4, "usage").unwrap(), ResourceUsage::READ | ResourceUsage::WRITE | ResourceUsage::SAMPLE);
+        assert!(raw::<ResourceUsage>(0x100, "usage").is_err());
+        assert_eq!(raw::<RenderStages>(0x3, "stages").unwrap(), RenderStages::VERTEX | RenderStages::FRAGMENT);
+        assert!(raw::<RenderStages>(0x1000, "stages").is_err());
+        assert_eq!(raw::<BarrierScope>(1 | 2, "scope").unwrap(), BarrierScope::BUFFERS | BarrierScope::TEXTURES);
+        assert!(raw::<BarrierScope>(0x100, "scope").is_err());
+    }
+
+    #[test]
+    fn encoder_residency_and_barrier_reject_invalid_inputs() {
+        assert!(!unsafe { nmb_encoder_use_resources(std::ptr::null_mut(), std::ptr::null(), 0, 1, 3) });
+        assert!(!unsafe { CStr::from_ptr(nmb_last_error()) }.to_str().unwrap().is_empty());
+
+        let bad_ref = NmbResourceRef { kind: 99, handle: std::ptr::null() };
+        assert!(unsafe { decode_resource_refs(&bad_ref, 1) }.is_err());
+        assert!(unsafe { decode_deferred_resources(&bad_ref, 1) }.is_err());
+        assert!(unsafe { decode_resource_refs(std::ptr::null(), 2) }.is_err());
+
+        assert!(!unsafe { nmb_encoder_use_heaps(std::ptr::null_mut(), std::ptr::null(), 0, 3) });
+        assert!(!nmb_encoder_memory_barrier_scope(std::ptr::null_mut(), 1, 1, 2));
+        assert!(!unsafe { nmb_encoder_memory_barrier_resources(std::ptr::null_mut(), std::ptr::null(), 0, 1, 2) });
+
+        // Exercise actual FFI -> FuxiDeferred queuing path with NmbEncoder::Deferred
+        let slot = fuxi_deferred::new_test_slot(Arc::default());
+        let mut enc = NmbEncoder::Deferred(slot);
+        let enc_ptr: *mut NmbEncoder = &mut enc;
+
+        assert!(unsafe { nmb_encoder_use_resources(enc_ptr, std::ptr::null(), 0, 1, 3) });
+        assert!(unsafe { nmb_encoder_use_heaps(enc_ptr, std::ptr::null(), 0, 2) });
+        assert!(nmb_encoder_memory_barrier_scope(enc_ptr, 3, 1, 2));
+        assert!(unsafe { nmb_encoder_memory_barrier_resources(enc_ptr, std::ptr::null(), 0, 1, 2) });
+        // Invalid render stages/scope on deferred path must fail immediately without queuing
+        assert!(!unsafe { nmb_encoder_use_resources(enc_ptr, std::ptr::null(), 0, 1, 0x8000) });
+        assert!(!nmb_encoder_memory_barrier_scope(enc_ptr, 0x8000, 1, 2));
+
+        let ops = fuxi_deferred::take_test_ops(slot);
+        assert_eq!(ops.len(), 4);
+        assert!(matches!(ops[0], Op::UseResources { usage, stages, .. } if usage == ResourceUsage::READ && stages == (RenderStages::VERTEX | RenderStages::FRAGMENT)));
+        assert!(matches!(ops[1], Op::UseHeaps { stages, .. } if stages == RenderStages::FRAGMENT));
+        assert!(matches!(ops[2], Op::BarrierScope { scope, after, before } if scope == (BarrierScope::BUFFERS | BarrierScope::TEXTURES) && after == RenderStages::VERTEX && before == RenderStages::FRAGMENT));
+        assert!(matches!(ops[3], Op::BarrierResources { after, before, .. } if after == RenderStages::VERTEX && before == RenderStages::FRAGMENT));
+        unsafe { fuxi_deferred::free_test_slot(slot) };
+    }
