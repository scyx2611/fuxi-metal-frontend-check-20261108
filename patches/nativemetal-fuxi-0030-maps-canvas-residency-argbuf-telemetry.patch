+static void fuxiMapsTelemetryNote(NmbDevice *device) {
+ if(!fuxiIsTelemetryClient())return;
+ const uint64_t cb=gMapsCommits.fetch_add(1,std::memory_order_relaxed)+1;
+ if(cb!=1 && cb!=10 && cb!=50 && cb!=100 && (cb%200)!=0)return;
+ uint64_t work[10]={};
+ if(device)(void)nmb_device_work_stats(device,work);
+ const uint64_t nullDraws=device?nmb_device_skipped_null_draws(device):0;
+ fprintf(stderr,
+  "FUXI MAPS DIAG: cb=%llu surf_pass=%llu load(c/l/dc)=%llu/%llu/%llu store(s/dc/o)=%llu/%llu/%llu "
+  "nz_clear=%llu surf_draws=%llu store_promo=%llu use_res=%llu/%llu use_heap=%llu/%llu "
+  "mbar(s/r)=%llu/%llu vkpipe_fail=%llu null_draws=%llu\n",
+  (unsigned long long)cb,(unsigned long long)gMapsSurfPasses.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsLoadClear.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsLoadLoad.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsLoadDontCare.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsStoreStore.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsStoreDontCare.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsStoreOther.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsNonZeroClears.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsSurfPassDraws.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsStoreActionPromoted.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsUseResourceCalls.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsUseResourceCount.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsUseHeapCalls.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsUseHeapCount.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsBarrierScopeCalls.load(std::memory_order_relaxed),
+  (unsigned long long)gMapsBarrierResourceCalls.load(std::memory_order_relaxed),
+  (unsigned long long)work[4],(unsigned long long)nullDraws);
+}
