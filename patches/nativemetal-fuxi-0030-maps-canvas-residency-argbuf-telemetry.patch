+/// # Safety
+/// `resources` is null when `count == 0`, or holds `count` valid `NmbResourceRef` entries.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_encoder_use_resources(
+    encoder: *mut NmbEncoder,
+    resources: *const NmbResourceRef,
+    count: usize,
+    usage: u64,
+    stages: u64,
+) -> bool {
+    if let Some(slot) = deferred(encoder) {
+        return queue(slot, || {
+            Ok(Op::UseResources {
+                resources: unsafe { decode_deferred_resources(resources, count)? },
+                usage: raw::<ResourceUsage>(usage, "resource usage")?,
+                stages: raw::<RenderStages>(stages, "render stages")?,
+            })
+        });
+    }
+    guard(false, || {
+        let usage = raw::<ResourceUsage>(usage, "resource usage")?;
+        let refs = unsafe { decode_resource_refs(resources, count)? };
+        match get_mut(encoder)? {
+            NmbEncoder::Compute(c) => c.use_resources(&refs, usage).map_err(e("use resources"))?,
+            NmbEncoder::Render(r) => {
+                let stages = raw::<RenderStages>(stages, "render stages")?;
+                r.use_resources(&refs, usage, stages).map_err(e("use resources"))?;
+            }
+            NmbEncoder::Blit(_) => return Err("not a compute or render encoder".into()),
+            NmbEncoder::Deferred(_) => return Err("deferred encoder".into()),
+        }
+        Ok(true)
+    })
+}
