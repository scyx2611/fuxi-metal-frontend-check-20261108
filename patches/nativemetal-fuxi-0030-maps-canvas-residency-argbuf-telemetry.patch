+  const char *slash=strrchr(raw,'/');
+  const char *name=slash?slash+1:raw;
+  if(!strcmp(name,"SpringBoard") || !strcmp(name,"backboardd") || !strcmp(name,"mediaserverd"))return false;
+  if(strcasestr(name,"poster")!=nullptr)return false;
+  return strcmp(name,"Maps")==0;
+ }();
