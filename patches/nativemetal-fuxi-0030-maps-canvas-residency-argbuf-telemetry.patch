+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct NmbArgumentDescriptor {
+    pub data_type: u64,
+    pub index: u64,
+    pub array_length: u64,
+    pub access: u64,
+    pub texture_type: u64,
+    pub constant_block_alignment: u64,
+}
+
+unsafe fn slice_from_raw<'a, T>(ptr: *const T, count: usize, what: &str) -> Result<&'a [T], String> {
+    if count == 0 {
+        return Ok(&[]);
+    }
+    if ptr.is_null() || count > isize::MAX as usize / std::mem::size_of::<T>().max(1) {
+        return Err(format!("invalid {what} array"));
+    }
+    Ok(unsafe { std::slice::from_raw_parts(ptr, count) })
+}
+
+fn decode_argument_descriptor(d: &NmbArgumentDescriptor) -> Result<ArgumentDescriptor, String> {
+    let data_type = raw::<DataType>(d.data_type, "argument data type")?;
+    let index = u32::try_from(d.index).map_err(e("argument index"))?;
+    let mut out = ArgumentDescriptor::new(data_type, index);
+    out.array_length = u32::try_from(d.array_length).map_err(e("argument array length"))?;
+    out.access = raw::<BindingAccess>(d.access, "argument access")?;
+    out.texture_type = raw::<TextureType>(d.texture_type, "argument texture type")?;
+    out.constant_block_alignment = u32::try_from(d.constant_block_alignment).map_err(e("constant block alignment"))?;
+    Ok(out)
+}
