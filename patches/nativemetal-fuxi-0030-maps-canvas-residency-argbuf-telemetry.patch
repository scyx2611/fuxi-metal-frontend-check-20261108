+/// # Safety
+/// `descriptors` is null when `count == 0`, or holds `count` readable `NmbArgumentDescriptor` records.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_argument_encoder_new_with_arguments(
+    device: *mut NmbDevice,
+    descriptors: *const NmbArgumentDescriptor,
+    count: usize,
+) -> *mut NmbArgumentEncoder {
+    guard(std::ptr::null_mut(), || {
+        let raw_descs = unsafe { slice_from_raw(descriptors, count, "argument descriptors")? };
+        let mut descs = Vec::with_capacity(raw_descs.len());
+        for d in raw_descs {
+            descs.push(decode_argument_descriptor(d)?);
+        }
+        let encoder = get(device)?.0.new_argument_encoder_with_arguments(&descs).map_err(e("argument encoder"))?;
+        Ok(boxed(NmbArgumentEncoder(encoder)))
+    })
+}
