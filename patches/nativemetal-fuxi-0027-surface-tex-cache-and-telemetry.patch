+#[repr(C)]
+pub struct NmbImagePoolStats {
+    pub hits: u64,
+    pub misses: u64,
+    pub evicts: u64,
+    pub entries: u64,
+    pub bytes: u64,
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_device_image_pool_stats(device: *const NmbDevice, out: *mut NmbImagePoolStats) -> bool {
+    guard(false, || {
+        let out = get_mut(out)?;
+        let (hits, misses, evicts, entries, bytes) = get(device)?.0.image_pool_stats();
+        *out = NmbImagePoolStats {
+            hits,
+            misses,
+            evicts,
+            entries: entries as u64,
+            bytes,
+        };
+        Ok(true)
+    })
+}
