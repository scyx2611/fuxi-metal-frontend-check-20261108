+// Hybrid Turnip (patch 0019): with fuxiturnip=1 on the boot line the device opens libvulkan_freedreno_hyb.dylib, the hybrid
+// lane's Turnip build (Mesa patches mesa-hyb-*.patch), from the directory of the default loader instead of that loader, so one
+// root image A/B tests a Turnip change by boot argument. Without the argument, or without that file, the loader is unchanged.
+static std::string fuxiTurnipLoader(const char *loader) {
+ if(!loader)return std::string();
+ const std::string given(loader);
+ char args[4096]={};size_t size=sizeof(args)-1;
+ if(sysctlbyname("kern.bootargs",args,&size,nullptr,0)!=0 || !fuxiBootArgsHaveToken(args,"fuxiturnip=1"))return given;
+ static const std::string name="/libvulkan_freedreno.dylib";
+ if(given.size()<=name.size() || given.compare(given.size()-name.size(),name.size(),name)!=0) {
+  fprintf(stderr,"FUXI TURNIP: fuxiturnip=1 but the loader is %s; unchanged\n",loader);
+  return given;
+ }
+ const std::string hybrid=given.substr(0,given.size()-name.size())+"/libvulkan_freedreno_hyb.dylib";
+ if(access(hybrid.c_str(),R_OK)!=0) {
+  fprintf(stderr,"FUXI TURNIP: fuxiturnip=1 but %s is missing; default loader\n",hybrid.c_str());
+  return given;
+ }
+ fprintf(stderr,"FUXI TURNIP: loader=%s\n",hybrid.c_str());
+ return hybrid;
+}
