+// True when the boot line's first fuxitudebug=<flags> word lists flag as one of its comma-separated flags.
+static bool fuxiTuDebugHasFlag(const char *args,const char *flag) {
+ static const char key[]="fuxitudebug=";const size_t keyLength=sizeof(key)-1,length=strlen(flag);
+ for(const char *at=args;at && *at;) {
+  while(*at==' ' || *at=='\t' || *at=='\n')at++;
+  const char *end=at;while(*end && *end!=' ' && *end!='\t' && *end!='\n')end++;
+  if((size_t)(end-at)>keyLength && !strncmp(at,key,keyLength)) {
+   for(const char *f=at+keyLength;f<end;) {
+    const char *stop=f;while(stop<end && *stop!=',')stop++;
+    if((size_t)(stop-f)==length && !strncmp(f,flag,length))return true;
+    f=stop<end?stop+1:end;
+   }
+   return false;
+  }
+  at=end;
+ }
+ return false;
+}
+// Hybrid Turnip (patch 0019): with the flag hyb in the boot line's fuxitudebug= list (e.g. fuxitudebug=nocb,hyb) the device
+// opens libvulkan_freedreno_hyb.dylib, the hybrid lane's Turnip build (Mesa patches mesa-hyb-*.patch), from the directory of the
+// default loader instead of that loader, so one root image A/B tests a Turnip change by boot argument. It rides on fuxitudebug=
+// because the boot line is at XNU's 608-byte limit and a token of its own does not fit; Turnip ignores the unknown flag in
+// TU_DEBUG. Without the flag, or without that file, the loader is unchanged.
+static std::string fuxiTurnipLoader(const char *loader) {
+ if(!loader)return std::string();
+ const std::string given(loader);
+ char args[4096]={};size_t size=sizeof(args)-1;
+ if(sysctlbyname("kern.bootargs",args,&size,nullptr,0)!=0 || !fuxiTuDebugHasFlag(args,"hyb"))return given;
+ static const std::string name="/libvulkan_freedreno.dylib";
+ if(given.size()<=name.size() || given.compare(given.size()-name.size(),name.size(),name)!=0) {
+  fprintf(stderr,"FUXI TURNIP: fuxitudebug has hyb but the loader is %s; unchanged\n",loader);
+  return given;
+ }
+ const std::string hybrid=given.substr(0,given.size()-name.size())+"/libvulkan_freedreno_hyb.dylib";
+ if(access(hybrid.c_str(),R_OK)!=0) {
+  fprintf(stderr,"FUXI TURNIP: fuxitudebug has hyb but %s is missing; default loader\n",hybrid.c_str());
+  return given;
+ }
+ fprintf(stderr,"FUXI TURNIP: loader=%s\n",hybrid.c_str());
+ return hybrid;
+}
