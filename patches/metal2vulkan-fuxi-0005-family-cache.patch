+/// FUXI: a cache of family answers, keyed by the device's shared state (one per `Device`).
+type FuxiCache<K, V> = std::sync::OnceLock<std::sync::Mutex<std::collections::HashMap<K, V>>>;
+
+/// FUXI: the cache's lock, whether or not a holder panicked (the map stays consistent).
+fn fuxi_lock<K, V>(
+    map: &std::sync::Mutex<std::collections::HashMap<K, V>>,
+) -> std::sync::MutexGuard<'_, std::collections::HashMap<K, V>> {
+    map.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+}
+
+/// FUXI: whether family answers are kept (`Device::family_rows`): on iOS unless
+/// `FUXI_M2V_FAMILY_CACHE` is 0; elsewhere only where it is 1.
+fn fuxi_family_cache() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| match std::env::var_os("FUXI_M2V_FAMILY_CACHE") {
+        Some(value) => value != "0",
+        None => cfg!(target_os = "ios"),
+    })
+}
