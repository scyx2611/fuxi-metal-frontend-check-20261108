+/// What runs around the draws, timed (`calls` line).
+#[derive(Clone, Copy)]
+pub(crate) enum Around {
+    /// A bind call (outermost).
+    Setter = 0,
+    /// A render encoder's opening.
+    Open = 1,
+    /// A render encoder's end.
+    End = 2,
+    /// A command buffer's commit.
+    Commit = 3,
+}
+const AROUND: usize = 4;
+
+/// A timed call, which adds its time to its `Around` as it goes (census on only).
+pub(crate) struct Timed {
+    start: u64,
+    what: u8,
+}
+
+impl Drop for Timed {
+    fn drop(&mut self) {
+        if self.start != 0 {
+            let ns = now().saturating_sub(self.start);
+            let what = usize::from(self.what);
+            AROUND_NS.with(|c| c[what].set(c[what].get() + ns));
+            AROUND_N.with(|c| c[what].set(c[what].get() + 1));
+            if self.what == Around::Setter as u8 {
+                SETTER_DEPTH.with(|d| d.set(0));
+            }
+        }
+    }
+}
+
+/// Time a call of `what` until the returned value goes.
+#[inline]
+pub(crate) fn timed(what: Around) -> Timed {
+    Timed {
+        start: if on() { now() } else { 0 },
+        what: what as u8,
+    }
+}
+
+/// A bind call of `kind`, timed from here to its return where it is the outermost one.
+#[inline]
+pub(crate) fn setter(kind: Set) -> Timed {
+    set(kind);
+    let outermost = on() && SETTER_DEPTH.with(|d| d.replace(1)) == 0;
+    Timed {
+        start: if outermost { now() } else { 0 },
+        what: Around::Setter as u8,
+    }
+}
+
+/// A render encoder opened that logs its calls (for a rebind).
+#[inline]
+pub(crate) fn logging_encoder() {
+    if on() {
+        LOGGING_ENCODERS.with(|c| c.set(c.get() + 1));
+    }
+}
