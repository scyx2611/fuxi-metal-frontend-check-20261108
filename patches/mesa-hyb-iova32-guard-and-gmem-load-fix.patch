 #include "tu_cs.h"
 
+#include <inttypes.h>
+
 #include "tu_device.h"
 #include "tu_rmv.h"
 #include "tu_suballoc.h"
 
+static bool
+tu_debug_str_has_token(const char *s, const char *tok)
+{
+   if (!s || !tok)
+      return false;
+   size_t tok_len = strlen(tok);
+   const char *p = s;
+   while (*p) {
+      while (*p == ',' || *p == ' ' || *p == '\t' || *p == ';')
+         p++;
+      if (!*p)
+         break;
+      const char *end = p;
+      while (*end && *end != ',' && *end != ' ' && *end != '\t' && *end != ';')
+         end++;
+      if ((size_t) (end - p) == tok_len && strncmp(p, tok, tok_len) == 0)
+         return true;
+      p = end;
+   }
+   return false;
+}
+
+static int
+tu_iova32_guard_mode(void)
+{
+   const char *env = getenv("FUXI_TURNIP_IOVA32_GUARD");
+   if (env && *env) {
+      if (strcmp(env, "0") == 0 || strcmp(env, "off") == 0 ||
+          strcmp(env, "disable") == 0 || strcmp(env, "none") == 0)
+         return 0;
+      if (strcmp(env, "1") == 0 || strcmp(env, "log") == 0 ||
+          strcmp(env, "warn") == 0)
+         return 1;
+      if (strcmp(env, "2") == 0 || strcmp(env, "lost") == 0 ||
+          strcmp(env, "fatal") == 0)
+         return 2;
+      if (strcmp(env, "3") == 0 || strcmp(env, "zero") == 0 ||
+          strcmp(env, "clamp") == 0 || strcmp(env, "drop") == 0)
+         return 3;
+   }
+
+   const char *tu_dbg = getenv("TU_DEBUG");
+   if (tu_dbg && *tu_dbg) {
+      if (tu_debug_str_has_token(tu_dbg, "noiova32"))
+         return 0;
+      if (tu_debug_str_has_token(tu_dbg, "iova32zero"))
+         return 3;
+      if (tu_debug_str_has_token(tu_dbg, "iova32lost"))
+         return 2;
+   }
+
+   return 1;
+}
+
+static uint32_t
+tu_iova32_guard_log_limit(void)
+{
+   const char *env = getenv("FUXI_TURNIP_IOVA32_GUARD_LIMIT");
+   if (env && *env) {
+      if (strcmp(env, "all") == 0)
+         return 0;
+      long v = strtol(env, NULL, 10);
+      if (v <= 0)
+         return 0;
+      return (uint32_t) v;
+   }
+   return 64;
+}
+
+uint64_t
+tu_iova32_guard_slow(const struct tu_device *device,
+                      uint64_t addr,
+                      const char *source,
+                      const char *site)
+{
+   int mode = tu_iova32_guard_mode();
+   if (mode <= 0)
+      return addr;
+
+   const char *src = source ? source : "unknown";
+   const char *loc = site ? site : "unknown";
+   static uint32_t log_count = 0;
+   uint32_t limit = tu_iova32_guard_log_limit();
+   uint32_t seq = (uint32_t) p_atomic_inc_return(&log_count);
+   if (limit == 0 || seq <= limit) {
+      mesa_loge("FUXI TURNIP IOVA32 GUARD: upper32 non-zero addr=0x%016" PRIx64
+                " (hi=0x%08x lo=0x%08x) source=%s site=%s mode=%d seq=%u",
+                addr, (uint32_t) (addr >> 32), (uint32_t) addr,
+                src, loc, mode, seq);
+   }
+
+   if (mode >= 2 && device) {
+      vk_device_set_lost(const_cast<struct vk_device *>(&device->vk),
+                         "FUXI TURNIP IOVA32 GUARD: addr=0x%016" PRIx64
+                         " source=%s site=%s",
+                         addr, src, loc);
+   }
+
+   if (mode >= 3)
+      return 0;
+
+   return addr;
+}
+
