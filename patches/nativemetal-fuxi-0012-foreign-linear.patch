+// Cross-process source. A client without a Metal device (SpringBoard and the
+// poster extensions here) has no layout object: ImageIO serializes its ASTC
+// snapshot as row-major blocks behind a zero watermark (ATX payload at a
+// page-aligned file offset), maps the file and QuartzCore forwards that mapping
+// to the render server unchanged. No producer record can exist for it in this
+// process. Only the unambiguous shape is admitted: one level, one slice, a
+// page-aligned base and a length covering every block. The bytes are copied
+// with bounded self-memory reads, so a truncated or revoked mapping refuses.
+static bool fuxiForeignLinearEnabled() {
+ const char *value=std::getenv("FUXI_NATIVE_FOREIGN_LINEAR");
+ return !value || std::strcmp(value,"0")!=0;
+}
+static std::atomic<unsigned> gFuxiLayoutForeignImports;
+static bool fuxiSnapshotForeign(void *memory,NSUInteger length,const fuxi_layout::Layout &layout,std::vector<uint8_t> &out) {
+ const uintptr_t base=(uintptr_t)memory;
+ if(!fuxiForeignLinearEnabled() || layout.descriptor.levels!=1 || layout.descriptor.slices!=1 ||
+    !fuxiLayoutRange(base,layout.totalBytes) || base%16384 || length<layout.totalBytes)return false;
+ std::vector<uint8_t> copy(layout.totalBytes);
+ for(size_t offset=0;offset<copy.size();) {
+  const size_t count=std::min<size_t>(65536,copy.size()-offset);
+  if(!fuxiSafeRead(base+offset,copy.data()+offset,count))return false;
+  offset+=count;
+ }
+ out=std::move(copy);return true;
+}
 typedef struct {uint64_t words[2];} FuxiLayoutWatermark;
 @interface FuxiLinearTextureLayout : NSObject
 + (instancetype)layoutWithDescriptor:(MTLTextureDescriptor *)descriptor;
