+/// FUXI: the most written sets an arena keeps for a draw to take again.
+const KEPT_SETS: usize = 32;
+
 impl DescriptorArena {
     /// One set of `layout`, whose needs are `needs` (not empty), from the newest pool with room
     /// for it, or a pool opened for it: a spare of the device's with room, else a new one.
+    /// FUXI (`fuxihyb=2`): a set of `layout` this command buffer already holds whose writes were
+    /// exactly `writes` (flattened by the caller), none written since: a draw that would write
+    /// the same into a new set binds that one instead. Every object its writes name is held by the
+    /// command buffer since the draw that wrote it, so the set reads the same until it completes.
+    pub(crate) fn reused(
+        &self,
+        layout: vk::DescriptorSetLayout,
+        writes: &[u64],
+    ) -> Option<vk::DescriptorSet> {
+        self.written
+            .iter()
+            .rev()
+            .find(|(of, kept, _)| *of == layout && kept[..] == *writes)
+            .map(|&(_, _, set)| set)
+    }
+
+    /// FUXI (`fuxihyb=2`): note that `set`, of `layout`, holds `writes` (flattened), for
+    /// [`reused`](Self::reused).
+    pub(crate) fn wrote(
+        &mut self,
+        layout: vk::DescriptorSetLayout,
+        writes: Vec<u64>,
+        set: vk::DescriptorSet,
+    ) {
+        if self.written.len() == KEPT_SETS {
+            self.written.remove(0);
+        }
+        self.written.push((layout, writes, set));
+    }
