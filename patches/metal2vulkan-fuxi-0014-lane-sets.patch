+/// FUXI (`fuxihyb=2`): a draw's set-0 writes flattened, field by field and handle by handle, the
+/// key a written set is taken again by (`DescriptorArena::reused`): equal words, equal writes.
+fn set_zero_words(writes: &[binding::Write]) -> Vec<u64> {
+    use ash::vk::Handle as _;
+    let mut words = Vec::with_capacity(writes.len() * 5);
+    for write in writes {
+        words.push(u64::from(write.set) << 32 | u64::from(write.binding));
+        words.push(u64::from(write.element) << 32 | write.ty.as_raw() as u32 as u64);
+        match write.info {
+            binding::Info::Buffer(info) => {
+                words.extend([1, info.buffer.as_raw(), info.offset, info.range]);
+            }
+            binding::Info::Image(info) => words.extend([
+                2,
+                info.sampler.as_raw(),
+                info.image_view.as_raw(),
+                info.image_layout.as_raw() as u32 as u64,
+            ]),
+            binding::Info::Texel(view) => words.extend([3, view.as_raw()]),
+        }
+    }
+    words
+}
