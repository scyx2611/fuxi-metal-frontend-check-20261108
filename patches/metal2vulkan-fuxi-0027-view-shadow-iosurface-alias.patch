--- a/crates/metal2vulkan-runtime/src/render/shadows.rs
+++ b/crates/metal2vulkan-runtime/src/render/shadows.rs
@@ -516,4 +516,81 @@ mod tests {
         assert_eq!(ranges.len(), RANGES_PER_BUFFER);
         assert!(ranges.contains(&(300..340)), "{ranges:?}");
     }
+
+    #[test]
+    fn view_shadow_copies_in_and_back_and_rejects_two_way_write() {
+        use crate::error::Error;
+        use crate::shadow::{ShadowCopies, ShadowSource, ShadowSync, ShadowUse, Step};
+        use std::sync::Arc;
+
+        let base_key = ResourceKey::new();
+        let shadow_key = ResourceKey::new();
+        let range = UseRange::Image {
+            aspects: vk::ImageAspectFlags::COLOR,
+            levels: 0..1,
+            layers: 0..1,
+        };
+        let copies = Arc::new(ShadowCopies {
+            source: ShadowSource::Image {
+                image: vk::Image::null(),
+                key: base_key,
+                range: range.clone(),
+                shadow: vk::Image::null(),
+                regions: Vec::new(),
+            },
+            shadow_key,
+            shadow_range: range.clone(),
+            tracked: true,
+            drops_writes: false,
+        });
+        let used = ShadowUse {
+            copies: Arc::clone(&copies),
+            writes: true,
+            overwrites: false,
+            kept: false,
+            area: None,
+        };
+        let mut sync = ShadowSync::<()>::default();
+        let before = sync
+            .before(std::slice::from_ref(&used), &[], |_| Ok(()))
+            .expect("single-writer ViewShadow pass succeeds");
+        assert_eq!(before.len(), 1);
+        assert!(matches!(before[0].step, Step::Into));
+        assert_eq!(before[0].copies.shadow_key, shadow_key);
+
+        sync.after(std::slice::from_ref(&used), &[]);
+        let back = sync.finish();
+        assert_eq!(back.len(), 1);
+        assert!(matches!(back[0].step, Step::Back));
+
+        let overwrite = ShadowUse {
+            overwrites: true,
+            ..used
+        };
+        let mut overwrite_sync = ShadowSync::<()>::default();
+        let skipped_into = overwrite_sync
+            .before(std::slice::from_ref(&overwrite), &[], |_| Ok(()))
+            .expect("overwrite ViewShadow pass succeeds");
+        assert!(skipped_into.is_empty());
+        overwrite_sync.after(std::slice::from_ref(&overwrite), &[]);
+        let overwrite_back = overwrite_sync.finish();
+        assert_eq!(overwrite_back.len(), 1);
+        assert!(matches!(overwrite_back[0].step, Step::Back));
+
+        let conflicting_base_write = Use::writes(
+            base_key,
+            true,
+            range,
+            Access::new(
+                vk::PipelineStageFlags2::ALL_COMMANDS,
+                vk::AccessFlags2::MEMORY_WRITE,
+            ),
+        );
+        let mut conflict_sync = ShadowSync::<()>::default();
+        let err = match conflict_sync.before(&[overwrite], &[conflicting_base_write], |_| Ok(())) {
+            Ok(_) => panic!("two-way write of ViewShadow and its truth image must be refused"),
+            Err(err) => err,
+        };
+        assert!(matches!(err, Error::Unsupported(_)));
+    }
 }
