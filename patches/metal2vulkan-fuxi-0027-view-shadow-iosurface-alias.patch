+
+fn reinterpreted_buffer_descriptor(
+    record: &ViewRecord,
+    resource_options: ResourceOptions,
+    allow_gpu_optimized_contents: bool,
+) -> TextureDescriptor {
+    let mut descriptor = TextureDescriptor::texture_2d(
+        record.pixel_format,
+        u64::from(record.image_extent[0]),
+        u64::from(record.image_extent[1]),
+        false,
+    );
+    descriptor.usage = record.usage;
+    descriptor.swizzle = record.swizzle;
+    descriptor.resource_options = resource_options;
+    descriptor.allow_gpu_optimized_contents = allow_gpu_optimized_contents;
+    descriptor.alpha_reads_one = record.alpha_reads_one;
+    descriptor.address_mode_map = record.address_mode_map;
+    descriptor.framebuffer_only = record.presented.framebuffer_only;
+    descriptor.rotation = u64::from(record.presented.rotation);
+    descriptor.is_drawable = record.presented.is_drawable;
+    descriptor
+}
+
+#[cfg(test)]
+mod tests {
+    use super::reinterpreted_buffer_descriptor;
+    use crate::address_map::AddressModeMap;
+    use crate::texture::fuxi_allows_padded_surface_alias_with;
+    use crate::texture_descriptor::TextureSwizzleChannels;
+    use crate::values::ResourceOptions;
+    use crate::view_plan::{Presented, ViewRecord};
+    use metal2vulkan::metal::{
+        PixelFormat, SamplerAddressMode, TextureSwizzle, TextureType, TextureUsage,
+    };
+
+    #[test]
+    fn reinterpreted_buffer_descriptor_inherits_presentation_and_sampling_metadata() {
+        let map = AddressModeMap::IDENTITY
+            .with(SamplerAddressMode::ClampToEdge, SamplerAddressMode::Repeat);
+        let swizzle = TextureSwizzleChannels::new(
+            TextureSwizzle::Blue,
+            TextureSwizzle::Green,
+            TextureSwizzle::Red,
+            TextureSwizzle::One,
+        );
+        let record = ViewRecord {
+            pixel_format: PixelFormat::R32Uint,
+            texture_type: TextureType::Type2D,
+            image_extent: [1125, 2500, 1],
+            base_level: 0,
+            level_count: 1,
+            base_layer: 0,
+            layer_count: 1,
+            samples: 1,
+            swizzle,
+            usage: TextureUsage::SHADER_READ | TextureUsage::RENDER_TARGET,
+            alpha_reads_one: true,
+            address_mode_map: map,
+            presented: Presented {
+                framebuffer_only: true,
+                rotation: 2,
+                is_drawable: true,
+            },
+        };
+        let opts = ResourceOptions::default();
+        let desc = reinterpreted_buffer_descriptor(&record, opts, false);
+        assert_eq!(desc.pixel_format, PixelFormat::R32Uint);
+        assert_eq!(desc.width, 1125);
+        assert_eq!(desc.height, 2500);
+        assert_eq!(desc.usage, record.usage);
+        assert_eq!(desc.swizzle, swizzle);
+        assert!(!desc.allow_gpu_optimized_contents);
+        assert!(desc.alpha_reads_one);
+        assert_eq!(desc.address_mode_map, map);
+        assert!(desc.framebuffer_only);
+        assert_eq!(desc.rotation, 2);
+        assert!(desc.is_drawable);
+    }
+
+    #[test]
+    fn iosurface_view_preserves_padded_surface_alias_eligibility() {
+        assert!(fuxi_allows_padded_surface_alias_with(
+            "new_texture_with_iosurface_plane",
+            false,
+            true
+        ));
+        assert!(fuxi_allows_padded_surface_alias_with(
+            "new_texture_view",
+            true,
+            true
+        ));
+        assert!(!fuxi_allows_padded_surface_alias_with(
+            "new_texture_view",
+            false,
+            true
+        ));
+        assert!(!fuxi_allows_padded_surface_alias_with(
+            "new_texture_view",
+            true,
+            false
+        ));
+    }
+}
