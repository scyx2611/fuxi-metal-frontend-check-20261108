+/// FUXI: whether `storage_over_buffer` for `call` / `texels` allows aliasing an IOSurface plane's
+/// padded rows (`Holds::Padding`), preserving alias eligibility for views of IOSurface textures.
+pub(crate) fn fuxi_allows_padded_surface_alias_with(
+    call: &str,
+    texels_iosurface: bool,
+    surface_alias: bool,
+) -> bool {
+    (call == "new_texture_with_iosurface_plane" || texels_iosurface) && surface_alias
+}
+
+/// FUXI: runtime wrapper around [`fuxi_allows_padded_surface_alias_with`] reading [`fuxi_surface_alias`].
+pub(crate) fn fuxi_allows_padded_surface_alias(call: &str, texels_iosurface: bool) -> bool {
+    fuxi_allows_padded_surface_alias_with(call, texels_iosurface, fuxi_surface_alias())
+}
