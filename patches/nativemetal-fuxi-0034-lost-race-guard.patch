+/// Returns whether device loss has been latched on `device` without draining deferred work.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_device_is_lost(device: *const NmbDevice) -> bool {
+    guard_free(false, || {
+        if device.is_null() {
+            return Ok(false);
+        }
+        let dev = get(device)?;
+        Ok(dev.0.first_loss_report().is_some() || dev.5.load(Ordering::Acquire))
+    })
+}
+
+#[cfg(test)]
+mod lost_race_tests {
+    use super::*;
+
+    #[test]
+    fn null_device_is_lost_returns_false_without_error() {
+        set_error(String::new());
+        assert!(!nmb_device_is_lost(std::ptr::null()));
+        let err = unsafe { CStr::from_ptr(nmb_last_error()) }.to_str().unwrap();
+        assert_eq!(err, "");
+    }
+}
