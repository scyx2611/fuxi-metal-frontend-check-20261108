diff --git a/FuxiLostRaceGuard.h b/FuxiLostRaceGuard.h
new file mode 100644
index 0000000..b8448ec
--- /dev/null
+++ b/FuxiLostRaceGuard.h
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: MIT
+// Device-lost race guard for NativeBridgeMetalFrontend (nativemetal patch 0034).
+// Pure C++17 so Linux/macOS host ASan/UBSan unit tests can compile and verify
+// the exact production logic for NBBuffer::contents, newBuffer* failure/lost
+// reporting, and fuxihyb=8 commitAndWaitUntilSubmitted async window safety.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+struct FuxiLostLatch {
+    std::mutex logMu;
+    std::atomic<bool> logged{false};
+    std::atomic<bool> failureNotified{false};
+
+    void resetForTest() {
+        std::lock_guard<std::mutex> guard(logMu);
+        logged.store(false, std::memory_order_release);
+        failureNotified.store(false, std::memory_order_release);
+    }
+};
+
+struct FuxiLostRaceOps {
+    void *ctx = nullptr;
+    bool (*isDeviceLost)(void *ctx) = nullptr;
+    size_t (*firstLostReport)(void *ctx, char *out, size_t size) = nullptr;
+    const char *(*lastError)(void *ctx) = nullptr;
+    void (*logFirstLost)(void *ctx, const char *where, const char *report) = nullptr;
+    void (*signalFailure)(void *ctx, const char *reason) = nullptr;
+};
+
+inline void fuxiCopySummaryLine(const char *src, char *out, size_t outSize) {
+    if (!out || outSize == 0) return;
+    out[0] = '\0';
+    if (!src || !*src) return;
+    size_t j = 0;
+    for (size_t i = 0; src[i] != '\0' && j + 1 < outSize; ++i) {
+        char c = src[i];
+        if (c == '\r' || c == '\n') {
+            if (j > 0 && out[j - 1] != ' ') {
+                out[j++] = ' ';
+            }
+        } else {
+            out[j++] = c;
+        }
+    }
+    while (j > 0 && out[j - 1] == ' ') {
+        --j;
+    }
+    out[j] = '\0';
+}
+
+inline void fuxiEmitFirstLostOnceLocked(
+    FuxiLostLatch &latch,
+    const FuxiLostRaceOps &ops,
+    const char *tag,
+    const char *report) {
+    if (latch.logged.load(std::memory_order_acquire)) {
+        return;
+    }
+    std::lock_guard<std::mutex> guard(latch.logMu);
+    if (!latch.logged.load(std::memory_order_relaxed)) {
+        if (ops.logFirstLost != nullptr) {
+            ops.logFirstLost(ops.ctx, tag, report);
+        }
+        latch.logged.store(true, std::memory_order_release);
+    }
+}
+
+inline bool fuxiNoteFirstLostOnce(
+    FuxiLostLatch &latch,
+    const FuxiLostRaceOps &ops,
+    const char *where,
+    char *reasonOut,
+    size_t reasonOutSize) {
+    if (reasonOut && reasonOutSize > 0) {
+        reasonOut[0] = '\0';
+    }
+    const char *tag = (where && *where) ? where : "unknown";
+    const bool devLost = (ops.isDeviceLost != nullptr && ops.isDeviceLost(ops.ctx));
+
+    char report[2048] = {};
+    size_t reportLen = 0;
+    if (ops.firstLostReport != nullptr) {
+        reportLen = ops.firstLostReport(ops.ctx, report, sizeof(report));
+        report[sizeof(report) - 1] = '\0';
+    }
+    const bool hasReport = (reportLen > 0 && report[0] != '\0');
+    if (!hasReport && !devLost) {
+        return false;
+    }
+
+    if (hasReport) {
+        fuxiEmitFirstLostOnceLocked(latch, ops, tag, report);
+        if (reasonOut && reasonOutSize > 0) {
+            fuxiCopySummaryLine(report, reasonOut, reasonOutSize);
+        }
+        return true;
+    }
+
+    char fallback[256] = {};
+    const char *err = (ops.lastError != nullptr) ? ops.lastError(ops.ctx) : nullptr;
+    if (err && *err) {
+        std::snprintf(fallback, sizeof(fallback), "device lost (%s): %s", tag, err);
+    } else {
+        std::snprintf(fallback, sizeof(fallback), "device lost (%s)", tag);
+    }
+    fuxiEmitFirstLostOnceLocked(latch, ops, tag, fallback);
+    if (reasonOut && reasonOutSize > 0) {
+        fuxiCopySummaryLine(fallback, reasonOut, reasonOutSize);
+    }
+    return true;
+}
+
+inline bool fuxiRecordLostIfDeviceLost(
+    FuxiLostLatch &latch,
+    const FuxiLostRaceOps &ops,
+    const char *where) {
+    if (ops.isDeviceLost == nullptr || !ops.isDeviceLost(ops.ctx)) {
+        return false;
+    }
+    if (latch.logged.load(std::memory_order_acquire) &&
+        latch.failureNotified.load(std::memory_order_acquire)) {
+        return true;
+    }
+    char reason[512] = {};
+    (void)fuxiNoteFirstLostOnce(latch, ops, where, reason, sizeof(reason));
+    if (!reason[0]) {
+        const char *tag = (where && *where) ? where : "unknown";
+        std::snprintf(reason, sizeof(reason), "device lost (%s)", tag);
+    }
+    if (ops.signalFailure != nullptr) {
+        ops.signalFailure(ops.ctx, reason);
+    }
+    latch.failureNotified.store(true, std::memory_order_release);
+    return true;
+}
+
+inline void fuxiRecordFailureWithLostContext(
+    FuxiLostLatch &latch,
+    const FuxiLostRaceOps &ops,
+    const char *where,
+    const char *detail) {
+    const bool devLost = (ops.isDeviceLost != nullptr && ops.isDeviceLost(ops.ctx));
+    if (devLost &&
+        latch.logged.load(std::memory_order_acquire) &&
+        latch.failureNotified.load(std::memory_order_acquire)) {
+        return;
+    }
+    char lostReason[512] = {};
+    const bool isLost = fuxiNoteFirstLostOnce(latch, ops, where, lostReason, sizeof(lostReason));
+    const char *tag = (where && *where) ? where : "native-metal failure";
+    const char *msg = (isLost && lostReason[0]) ? lostReason : ((detail && *detail) ? detail : tag);
+    if (ops.signalFailure != nullptr) {
+        ops.signalFailure(ops.ctx, msg);
+    }
+    if (isLost) {
+        latch.failureNotified.store(true, std::memory_order_release);
+    }
+}
+
+inline void *fuxiGuardBufferContents(
+    FuxiLostLatch &latch,
+    const FuxiLostRaceOps &ops,
+    bool hasHandle,
+    bool isPrivateStorage,
+    void *rawContents) {
+    const bool devLost = (ops.isDeviceLost != nullptr && ops.isDeviceLost(ops.ctx));
+    const bool unexpectedNull = (!hasHandle || (rawContents == nullptr && !isPrivateStorage));
+    if (devLost || unexpectedNull) {
+        const char *where = devLost ? "buffer_contents_lost" : "buffer_contents_null";
+        const char *detail = !hasHandle
+            ? "NBBuffer missing handle"
+            : (devLost ? "NBBuffer contents queried after device lost" : "NBBuffer contents is null for non-private storage");
+        fuxiRecordFailureWithLostContext(latch, ops, where, detail);
+    }
+    return rawContents;
+}
+
+inline bool fuxiGuardCommitAndWait(
+    FuxiLostLatch &latch,
+    const FuxiLostRaceOps &ops,
+    bool failedLocally,
+    bool hasEncodeFailure,
+    bool blocked,
+    bool overlapPending,
+    bool isNoop,
+    bool statusIsError,
+    const char *cbErrorText,
+    const char *encodeFailureText) {
+    const bool devLost = (ops.isDeviceLost != nullptr && ops.isDeviceLost(ops.ctx));
+    const bool asyncErr = (!overlapPending && !isNoop && statusIsError);
+    if (!failedLocally && !hasEncodeFailure && !blocked && !devLost && !asyncErr) {
+        return true;
+    }
+    const char *where = devLost ? "commitAndWaitUntilSubmitted_lost"
+                      : asyncErr ? "commitAndWaitUntilSubmitted_error"
+                      : hasEncodeFailure ? "commitAndWaitUntilSubmitted_refused"
+                      : blocked ? "commitAndWaitUntilSubmitted_blocked"
+                      : "commitAndWaitUntilSubmitted_failed";
+    const char *detail = (cbErrorText && *cbErrorText) ? cbErrorText
+                       : (encodeFailureText && *encodeFailureText) ? encodeFailureText
+                       : (blocked ? "command buffer blocked after device failure" : "command buffer commit failed");
+    fuxiRecordFailureWithLostContext(latch, ops, where, detail);
+    return false;
+}
