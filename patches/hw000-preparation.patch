--- /dev/null
+++ b/xnu/fuxi-htc-prep/fuxi_htc_prep.c
@@ -0,0 +1,211 @@
+#include "fuxi_htc_prep.h"
+
+static uint16_t
+fuxi_htc_read16(const uint8_t *bytes)
+{
+	return (uint16_t)((uint16_t)bytes[0] | ((uint16_t)bytes[1] << 8));
+}
+
+static int
+fuxi_htc_parse_trailer(const uint8_t *bytes, size_t length,
+    struct fuxi_htc_frame *frame)
+{
+	size_t position = 0;
+	while (position < length) {
+		if (length - position < 4u) {
+			return FUXI_HTC_INVALID_LENGTH;
+		}
+		const uint8_t *record = bytes + position;
+		size_t record_bytes = record[1];
+		if (record_bytes > length - position - 4u) {
+			return FUXI_HTC_INVALID_LENGTH;
+		}
+		if (record[2] || record[3] || record[0] > 1u) {
+			return FUXI_HTC_INVALID_PROTOCOL;
+		}
+		if (frame->trailer_records >= FUXI_HTC_MAX_TRAILER_RECORDS) {
+			return FUXI_HTC_INVALID_LENGTH;
+		}
+		frame->trailer_records++;
+		if (record[0] == 1u) {
+			if (!record_bytes || record_bytes % 4u) {
+				return FUXI_HTC_INVALID_CREDIT;
+			}
+			for (size_t offset = 0; offset < record_bytes; offset += 4u) {
+				const uint8_t *report = record + 4u + offset;
+				unsigned endpoint = report[0];
+				if (endpoint >= FUXI_HTC_MAX_ENDPOINTS) {
+					return FUXI_HTC_INVALID_ENDPOINT;
+				}
+				if (report[2] || report[3] ||
+				    frame->credit_reports >= FUXI_HTC_MAX_CREDIT_REPORTS) {
+					return FUXI_HTC_INVALID_CREDIT;
+				}
+				unsigned total = (unsigned)frame->credit_delta[endpoint] + report[1];
+				if (total > UINT16_MAX) {
+					return FUXI_HTC_INVALID_CREDIT;
+				}
+				frame->credit_delta[endpoint] = (uint16_t)total;
+				frame->credit_mask |= (uint16_t)(1u << endpoint);
+				frame->credit_reports++;
+			}
+		}
+		position += 4u + record_bytes;
+	}
+	return FUXI_HTC_OK;
+}
+
+static int
+fuxi_htc_parse_control(const uint8_t *bytes, size_t length,
+    struct fuxi_htc_frame *frame)
+{
+	if (length < 4u || length > FUXI_HTC_MAX_CONTROL) {
+		return FUXI_HTC_INVALID_CONTROL;
+	}
+	frame->message_id = fuxi_htc_read16(bytes);
+	frame->control_bytes = (uint16_t)length;
+	frame->control_kind = FUXI_HTC_CONTROL_OTHER;
+	for (size_t index = 0; index < length; index++) {
+		frame->control[index] = bytes[index];
+	}
+	if (frame->message_id == 1u) {
+		if ((length != 8u && length != 12u) || bytes[7]) {
+			return FUXI_HTC_INVALID_CONTROL;
+		}
+		frame->control_kind = FUXI_HTC_CONTROL_READY;
+		frame->ready_credit_count = fuxi_htc_read16(bytes + 2u);
+		frame->ready_credit_size = fuxi_htc_read16(bytes + 4u);
+		frame->ready_max_endpoints = bytes[6];
+		if (!frame->ready_credit_count || !frame->ready_credit_size ||
+		    !frame->ready_max_endpoints ||
+		    frame->ready_max_endpoints > FUXI_HTC_MAX_ENDPOINTS) {
+			return FUXI_HTC_INVALID_CONTROL;
+		}
+		if (length == 12u) {
+			if (bytes[8] > 1u || bytes[10] || bytes[11]) {
+				return FUXI_HTC_INVALID_CONTROL;
+			}
+			frame->ready_extended = 1u;
+			frame->ready_version = bytes[8];
+			frame->ready_max_bundle = bytes[9];
+		}
+	} else if (frame->message_id == 3u) {
+		if (length < 12u || length != 12u + bytes[8] ||
+		    bytes[9] || bytes[10] || bytes[11] || bytes[4] > 4u) {
+			return FUXI_HTC_INVALID_CONTROL;
+		}
+		frame->control_kind = FUXI_HTC_CONTROL_CONNECT_RESPONSE;
+		frame->connect_service_id = fuxi_htc_read16(bytes + 2u);
+		frame->connect_status = bytes[4];
+		frame->connect_endpoint = bytes[5];
+		frame->connect_max_message = fuxi_htc_read16(bytes + 6u);
+		frame->connect_metadata_bytes = bytes[8];
+		if (!frame->connect_service_id) {
+			return FUXI_HTC_INVALID_CONTROL;
+		}
+		if (!frame->connect_status &&
+		    (!frame->connect_endpoint ||
+		     frame->connect_endpoint >= FUXI_HTC_MAX_ENDPOINTS ||
+		     !frame->connect_max_message ||
+		     frame->connect_max_message > FUXI_HTC_MAX_FRAME - 8u)) {
+			return FUXI_HTC_INVALID_CONTROL;
+		}
+	}
+	return FUXI_HTC_OK;
+}
+
+int
+fuxi_htc_parse_frame(const uint8_t *bytes, size_t length,
+    struct fuxi_htc_frame *output)
+{
+	if (!bytes || !output) {
+		return FUXI_HTC_INVALID_INPUT;
+	}
+	if (length < 8u || length > FUXI_HTC_MAX_FRAME) {
+		return FUXI_HTC_INVALID_LENGTH;
+	}
+	struct fuxi_htc_frame parsed = {0};
+	parsed.endpoint = bytes[0];
+	parsed.flags = bytes[1];
+	parsed.control_byte1 = bytes[5];
+	if (parsed.endpoint >= FUXI_HTC_MAX_ENDPOINTS) {
+		return FUXI_HTC_INVALID_ENDPOINT;
+	}
+	if ((parsed.flags & ~2u) || bytes[6] || bytes[7]) {
+		return FUXI_HTC_INVALID_PROTOCOL;
+	}
+	size_t payload_bytes = fuxi_htc_read16(bytes + 2u);
+	if (payload_bytes != length - 8u) {
+		return FUXI_HTC_INVALID_LENGTH;
+	}
+	if (parsed.flags & 2u) {
+		parsed.trailer_bytes = bytes[4];
+		if (parsed.trailer_bytes < 4u || parsed.trailer_bytes > payload_bytes) {
+			return FUXI_HTC_INVALID_LENGTH;
+		}
+		int result = fuxi_htc_parse_trailer(bytes + length - parsed.trailer_bytes,
+		    parsed.trailer_bytes, &parsed);
+		if (result) {
+			return result;
+		}
+	} else if (bytes[4]) {
+		return FUXI_HTC_INVALID_PROTOCOL;
+	}
+	payload_bytes -= parsed.trailer_bytes;
+	parsed.payload_bytes = (uint16_t)payload_bytes;
+	if (!parsed.endpoint && payload_bytes) {
+		int result = fuxi_htc_parse_control(bytes + 8u, payload_bytes, &parsed);
+		if (result) {
+			return result;
+		}
+	}
+	*output = parsed;
+	return FUXI_HTC_OK;
+}
+
+int
+fuxi_htc_observer_init(struct fuxi_htc_observer *observer,
+    fuxi_htc_callback callback, void *context)
+{
+	if (!observer) {
+		return FUXI_HTC_INVALID_INPUT;
+	}
+	*observer = (struct fuxi_htc_observer){0};
+	observer->active = FUXI_HTC_DEFAULT_ACTIVE;
+	observer->callbacks_remaining = FUXI_HTC_CALLBACK_BUDGET;
+	observer->callback = callback;
+	observer->context = context;
+	return FUXI_HTC_OK;
+}
+
+int
+fuxi_htc_observe(struct fuxi_htc_observer *observer,
+    const uint8_t *bytes, size_t length)
+{
+	if (!observer) {
+		return FUXI_HTC_INVALID_INPUT;
+	}
+	if (!observer->active) {
+		return FUXI_HTC_INACTIVE;
+	}
+	if (observer->active != 1u || !observer->callback) {
+		return FUXI_HTC_INVALID_INPUT;
+	}
+	if (observer->in_callback) {
+		return FUXI_HTC_CALLBACK_BUSY;
+	}
+	if (!observer->callbacks_remaining) {
+		return FUXI_HTC_CALLBACK_LIMIT;
+	}
+	struct fuxi_htc_frame parsed;
+	int result = fuxi_htc_parse_frame(bytes, length, &parsed);
+	if (result) {
+		return result;
+	}
+	observer->callbacks_remaining--;
+	observer->callbacks_delivered++;
+	observer->in_callback = 1u;
+	observer->callback(observer->context, &parsed);
+	observer->in_callback = 0u;
+	return FUXI_HTC_OK;
+}
diff --git a/xnu/fuxi-htc-prep/fuxi_htc_prep.h b/xnu/fuxi-htc-prep/fuxi_htc_prep.h
new file mode 100644
index 0000000..187ad59
--- /dev/null
+++ b/xnu/fuxi-htc-prep/fuxi_htc_prep.h
@@ -0,0 +1,81 @@
+#ifndef FUXI_HTC_PREP_H
+#define FUXI_HTC_PREP_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define FUXI_HTC_DEFAULT_ACTIVE 0u
+#define FUXI_HTC_MAX_FRAME 4096u
+#define FUXI_HTC_MAX_CONTROL 256u
+#define FUXI_HTC_MAX_ENDPOINTS 9u
+#define FUXI_HTC_MAX_TRAILER_RECORDS 63u
+#define FUXI_HTC_MAX_CREDIT_REPORTS 62u
+#define FUXI_HTC_CALLBACK_BUDGET 16u
+
+enum fuxi_htc_result {
+	FUXI_HTC_OK = 0,
+	FUXI_HTC_INACTIVE = 1,
+	FUXI_HTC_CALLBACK_LIMIT = 2,
+	FUXI_HTC_CALLBACK_BUSY = 3,
+	FUXI_HTC_INVALID_INPUT = -1,
+	FUXI_HTC_INVALID_LENGTH = -2,
+	FUXI_HTC_INVALID_PROTOCOL = -3,
+	FUXI_HTC_INVALID_ENDPOINT = -4,
+	FUXI_HTC_INVALID_CREDIT = -5,
+	FUXI_HTC_INVALID_CONTROL = -6
+};
+
+enum fuxi_htc_control_kind {
+	FUXI_HTC_CONTROL_NONE = 0,
+	FUXI_HTC_CONTROL_READY = 1,
+	FUXI_HTC_CONTROL_CONNECT_RESPONSE = 3,
+	FUXI_HTC_CONTROL_OTHER = 255
+};
+
+struct fuxi_htc_frame {
+	uint8_t endpoint;
+	uint8_t flags;
+	uint8_t control_byte1;
+	uint8_t trailer_bytes;
+	uint16_t payload_bytes;
+	uint16_t control_bytes;
+	uint16_t message_id;
+	uint16_t credit_mask;
+	uint16_t credit_delta[FUXI_HTC_MAX_ENDPOINTS];
+	uint8_t trailer_records;
+	uint8_t credit_reports;
+	uint8_t control_kind;
+	uint8_t ready_extended;
+	uint16_t ready_credit_count;
+	uint16_t ready_credit_size;
+	uint8_t ready_max_endpoints;
+	uint8_t ready_version;
+	uint8_t ready_max_bundle;
+	uint8_t connect_status;
+	uint16_t connect_service_id;
+	uint16_t connect_max_message;
+	uint8_t connect_endpoint;
+	uint8_t connect_metadata_bytes;
+	uint8_t control[FUXI_HTC_MAX_CONTROL];
+};
+
+typedef void (*fuxi_htc_callback)(void *context,
+    const struct fuxi_htc_frame *frame);
+
+struct fuxi_htc_observer {
+	unsigned active;
+	unsigned callbacks_remaining;
+	unsigned callbacks_delivered;
+	unsigned in_callback;
+	fuxi_htc_callback callback;
+	void *context;
+};
+
+int fuxi_htc_parse_frame(const uint8_t *bytes, size_t length,
+    struct fuxi_htc_frame *output);
+int fuxi_htc_observer_init(struct fuxi_htc_observer *observer,
+    fuxi_htc_callback callback, void *context);
+int fuxi_htc_observe(struct fuxi_htc_observer *observer,
+    const uint8_t *bytes, size_t length);
+
+#endif
diff --git a/xnu/fuxi-ram-prep/fuxi_ram_bank.c b/xnu/fuxi-ram-prep/fuxi_ram_bank.c
new file mode 100644
index 0000000..4d7c4c3
--- /dev/null
+++ b/xnu/fuxi-ram-prep/fuxi_ram_bank.c
@@ -0,0 +1,208 @@
+#include "fuxi_ram_bank.h"
+#include <string.h>
+
+#define FUXI_RAM_PREP_INITIALIZED UINT32_C(0x46525031)
+
+int fuxi_ram_prep_range_end(struct fuxi_ram_prep_range range, uint64_t *end)
+{
+    if (!end || !range.size || ((range.start | range.size) & (FUXI_RAM_PREP_PAGE_SIZE - 1)))
+        return FUXI_RAM_PREP_BAD_RANGE;
+    if (range.size > UINT64_MAX - range.start)
+        return FUXI_RAM_PREP_OVERFLOW;
+    *end = range.start + range.size;
+    if (((*end - 1) >> 14) > UINT32_MAX)
+        return FUXI_RAM_PREP_BAD_PFN;
+    return FUXI_RAM_PREP_OK;
+}
+
+static int has_evidence(const uint8_t evidence[32])
+{
+    for (size_t index = 0; index < 32; index++)
+        if (evidence[index]) return 1;
+    return 0;
+}
+
+static int contains_page(struct fuxi_ram_prep_range range, uint64_t physical)
+{
+    return physical >= range.start && physical - range.start < range.size;
+}
+
+static int geometry_result(const struct fuxi_ram_prep_manifest *manifest, uint64_t physical)
+{
+    int whitelisted = 0;
+    if (physical >= FUXI_RAM_PREP_GPU_BASE && physical < FUXI_RAM_PREP_GPU_END)
+        return FUXI_RAM_PREP_GPU;
+    for (uint32_t index = 0; index < manifest->bank_count; index++)
+        if (contains_page(manifest->banks[index], physical)) whitelisted = 1;
+    if (!whitelisted) return FUXI_RAM_PREP_NOT_WHITELISTED;
+    for (uint32_t index = 0; index < manifest->exclusion_count; index++)
+        if (contains_page(manifest->exclusions[index], physical)) return FUXI_RAM_PREP_STATIC;
+    for (uint32_t owner_index = 0; owner_index < manifest->owner_count; owner_index++) {
+        const struct fuxi_ram_prep_owner *owner = &manifest->owners[owner_index];
+        for (uint32_t range_index = 0; range_index < owner->range_count; range_index++)
+            if (contains_page(owner->ranges[range_index], physical)) return FUXI_RAM_PREP_OWNER;
+    }
+    return FUXI_RAM_PREP_OK;
+}
+
+static int validate_manifest(const struct fuxi_ram_prep_manifest *manifest, uint64_t *span_end,
+    int *owners_complete)
+{
+    if (!manifest || manifest->version != FUXI_RAM_PREP_VERSION ||
+        manifest->structure_bytes != sizeof(*manifest) ||
+        manifest->page_size != FUXI_RAM_PREP_PAGE_SIZE ||
+        (manifest->flags & ~FUXI_RAM_PREP_EXPERIMENTAL) ||
+        manifest->bank_count > FUXI_RAM_PREP_MAX_BANKS ||
+        manifest->exclusion_count > FUXI_RAM_PREP_MAX_EXCLUSIONS ||
+        manifest->owner_count > FUXI_RAM_PREP_MAX_OWNERS || manifest->owner_coverage_complete > 1)
+        return FUXI_RAM_PREP_BAD_MANIFEST;
+    struct fuxi_ram_prep_range span = {manifest->physical_base, manifest->physical_size};
+    int result = fuxi_ram_prep_range_end(span, span_end);
+    if (result != FUXI_RAM_PREP_OK) return result;
+    if (manifest->physical_size / FUXI_RAM_PREP_PAGE_SIZE > UINT32_MAX)
+        return FUXI_RAM_PREP_BAD_MANIFEST;
+    uint64_t previous_end = manifest->physical_base;
+    for (uint32_t index = 0; index < manifest->bank_count; index++) {
+        uint64_t end;
+        result = fuxi_ram_prep_range_end(manifest->banks[index], &end);
+        if (result != FUXI_RAM_PREP_OK) return result;
+        if (manifest->banks[index].start < previous_end || end > *span_end)
+            return FUXI_RAM_PREP_BAD_MANIFEST;
+        previous_end = end;
+    }
+    for (uint32_t index = 0; index < manifest->exclusion_count; index++) {
+        uint64_t end;
+        result = fuxi_ram_prep_range_end(manifest->exclusions[index], &end);
+        if (result != FUXI_RAM_PREP_OK) return result;
+    }
+    *owners_complete = manifest->owner_coverage_complete && manifest->owner_count &&
+        has_evidence(manifest->owner_manifest_sha256);
+    for (uint32_t index = 0; index < manifest->owner_count; index++) {
+        const struct fuxi_ram_prep_owner *owner = &manifest->owners[index];
+        if (!owner->id || owner->reserved || owner->range_count > FUXI_RAM_PREP_MAX_OWNER_RANGES ||
+            (owner->flags & ~(FUXI_RAM_OWNER_COMPLETE | FUXI_RAM_OWNER_PLACEMENT_KNOWN | FUXI_RAM_OWNER_PROVEN_ABSENT)) ||
+            ((owner->flags & FUXI_RAM_OWNER_PROVEN_ABSENT) &&
+             (owner->range_count || (owner->flags & FUXI_RAM_OWNER_PLACEMENT_KNOWN))))
+            return FUXI_RAM_PREP_BAD_MANIFEST;
+        for (uint32_t earlier = 0; earlier < index; earlier++)
+            if (manifest->owners[earlier].id == owner->id) return FUXI_RAM_PREP_BAD_MANIFEST;
+        for (uint32_t range_index = 0; range_index < owner->range_count; range_index++) {
+            uint64_t end;
+            result = fuxi_ram_prep_range_end(owner->ranges[range_index], &end);
+            if (result != FUXI_RAM_PREP_OK) return result;
+        }
+        if (!(owner->flags & FUXI_RAM_OWNER_COMPLETE) || !has_evidence(owner->evidence_sha256) ||
+            !((owner->flags & FUXI_RAM_OWNER_PROVEN_ABSENT) ||
+              ((owner->flags & FUXI_RAM_OWNER_PLACEMENT_KNOWN) && owner->range_count)))
+            *owners_complete = 0;
+    }
+    return FUXI_RAM_PREP_OK;
+}
+
+int fuxi_ram_prep_init_zeroed(struct fuxi_ram_prep_state *state,
+    const struct fuxi_ram_prep_manifest *manifest, uint8_t *shadow_ledger, size_t ledger_bytes)
+{
+    if (!state) return FUXI_RAM_PREP_BAD_MANIFEST;
+    if (state->initialized) return FUXI_RAM_PREP_ALREADY_INITIALIZED;
+    uint64_t span_end;
+    int owners_complete;
+    int result = validate_manifest(manifest, &span_end, &owners_complete);
+    if (result != FUXI_RAM_PREP_OK) return result;
+    uint64_t span_pages = manifest->physical_size / FUXI_RAM_PREP_PAGE_SIZE;
+    uint64_t needed = (span_pages + 7) / 8;
+    if (!shadow_ledger || needed > ledger_bytes) return FUXI_RAM_PREP_LEDGER_CAPACITY;
+    for (size_t index = 0; index < (size_t)needed; index++)
+        if (shadow_ledger[index]) return FUXI_RAM_PREP_DIRTY_LEDGER;
+    struct fuxi_ram_prep_counts counts = {0};
+    counts.span_pages = span_pages;
+    for (uint32_t bank_index = 0; bank_index < manifest->bank_count; bank_index++) {
+        struct fuxi_ram_prep_range bank = manifest->banks[bank_index];
+        counts.whitelist_pages += bank.size / FUXI_RAM_PREP_PAGE_SIZE;
+        for (uint64_t physical = bank.start; physical < bank.start + bank.size; physical += FUXI_RAM_PREP_PAGE_SIZE)
+            if (geometry_result(manifest, physical) == FUXI_RAM_PREP_OK) counts.geometric_candidate_pages++;
+    }
+    counts.known_excluded_pages = counts.whitelist_pages - counts.geometric_candidate_pages;
+    state->manifest = *manifest;
+    state->span_end = span_end;
+    state->owners_complete = (uint32_t)owners_complete;
+    state->shadow_ledger = shadow_ledger;
+    state->shadow_ledger_bytes = (size_t)needed;
+    state->counts = counts;
+    state->initialized = FUXI_RAM_PREP_INITIALIZED;
+    return FUXI_RAM_PREP_OK;
+}
+
+int fuxi_ram_prep_dense_index(const struct fuxi_ram_prep_state *state, uint64_t pfn, uint32_t *index)
+{
+    if (!state || state->initialized != FUXI_RAM_PREP_INITIALIZED) return FUXI_RAM_PREP_UNINITIALIZED;
+    if (!index) return FUXI_RAM_PREP_BAD_MANIFEST;
+    if (pfn > UINT32_MAX) return FUXI_RAM_PREP_BAD_PFN;
+    uint64_t physical = pfn << 14;
+    if (physical < state->manifest.physical_base || physical >= state->span_end)
+        return FUXI_RAM_PREP_OUTSIDE_SPAN;
+    *index = (uint32_t)((physical - state->manifest.physical_base) / FUXI_RAM_PREP_PAGE_SIZE);
+    return FUXI_RAM_PREP_OK;
+}
+
+int fuxi_ram_prep_probe(const struct fuxi_ram_prep_state *state, uint64_t pfn)
+{
+    uint32_t index;
+    if (!state || state->initialized != FUXI_RAM_PREP_INITIALIZED) return FUXI_RAM_PREP_UNINITIALIZED;
+    if (pfn > UINT32_MAX) return FUXI_RAM_PREP_BAD_PFN;
+    uint64_t physical = pfn << 14;
+    if (physical >= FUXI_RAM_PREP_GPU_BASE && physical < FUXI_RAM_PREP_GPU_END)
+        return FUXI_RAM_PREP_GPU;
+    int result = fuxi_ram_prep_dense_index(state, pfn, &index);
+    if (result != FUXI_RAM_PREP_OK) return result;
+    result = geometry_result(&state->manifest, physical);
+    if (result != FUXI_RAM_PREP_OK) return result;
+    if (!FUXI_RAM_PREP_ENABLED || !(state->manifest.flags & FUXI_RAM_PREP_EXPERIMENTAL))
+        return FUXI_RAM_PREP_DISABLED;
+    if (!state->owners_complete) return FUXI_RAM_PREP_PENDING_OWNER;
+    return FUXI_RAM_PREP_OK;
+}
+
+int fuxi_ram_prep_get_counts(const struct fuxi_ram_prep_state *state, struct fuxi_ram_prep_counts *counts)
+{
+    if (!state || state->initialized != FUXI_RAM_PREP_INITIALIZED) return FUXI_RAM_PREP_UNINITIALIZED;
+    if (!counts) return FUXI_RAM_PREP_BAD_MANIFEST;
+    if (state->counts.whitelist_pages > state->counts.span_pages ||
+        state->counts.geometric_candidate_pages > state->counts.whitelist_pages ||
+        state->counts.known_excluded_pages != state->counts.whitelist_pages - state->counts.geometric_candidate_pages ||
+        state->counts.shadow_released_pages > state->counts.geometric_candidate_pages)
+        return FUXI_RAM_PREP_CORRUPT_COUNTERS;
+    *counts = state->counts;
+    counts->remaining_geometric_pages = counts->geometric_candidate_pages - counts->shadow_released_pages;
+    counts->host_admissible_known = FUXI_RAM_PREP_ENABLED && state->owners_complete &&
+        (state->manifest.flags & FUXI_RAM_PREP_EXPERIMENTAL);
+    counts->host_admissible_pages = counts->host_admissible_known ? counts->geometric_candidate_pages : 0;
+    return FUXI_RAM_PREP_OK;
+}
+
+int fuxi_ram_prep_shadow_release(struct fuxi_ram_prep_state *state, struct fuxi_ram_prep_range range)
+{
+    uint64_t end;
+    int result = fuxi_ram_prep_range_end(range, &end);
+    if (result != FUXI_RAM_PREP_OK) return result;
+    struct fuxi_ram_prep_counts counts;
+    result = fuxi_ram_prep_get_counts(state, &counts);
+    if (result != FUXI_RAM_PREP_OK) return result;
+    for (uint64_t physical = range.start; physical < end; physical += FUXI_RAM_PREP_PAGE_SIZE) {
+        uint32_t index;
+        result = fuxi_ram_prep_probe(state, physical >> 14);
+        if (result != FUXI_RAM_PREP_OK) return result;
+        result = fuxi_ram_prep_dense_index(state, physical >> 14, &index);
+        if (result != FUXI_RAM_PREP_OK) return result;
+        if (index / 8 >= state->shadow_ledger_bytes) return FUXI_RAM_PREP_LEDGER_CAPACITY;
+        if (state->shadow_ledger[index / 8] & (1u << (index % 8)))
+            return FUXI_RAM_PREP_DUPLICATE_RELEASE;
+    }
+    uint64_t pages = range.size / FUXI_RAM_PREP_PAGE_SIZE;
+    if (pages > counts.remaining_geometric_pages) return FUXI_RAM_PREP_CORRUPT_COUNTERS;
+    for (uint64_t physical = range.start; physical < end; physical += FUXI_RAM_PREP_PAGE_SIZE) {
+        uint32_t index = (uint32_t)((physical - state->manifest.physical_base) / FUXI_RAM_PREP_PAGE_SIZE);
+        state->shadow_ledger[index / 8] |= (uint8_t)(1u << (index % 8));
+    }
+    state->counts.shadow_released_pages += pages;
+    return FUXI_RAM_PREP_OK;
+}
diff --git a/xnu/fuxi-ram-prep/fuxi_ram_bank.h b/xnu/fuxi-ram-prep/fuxi_ram_bank.h
new file mode 100644
index 0000000..684955b
--- /dev/null
+++ b/xnu/fuxi-ram-prep/fuxi_ram_bank.h
@@ -0,0 +1,108 @@
+#ifndef FUXI_RAM_BANK_PREP_H
+#define FUXI_RAM_BANK_PREP_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef FUXI_RAM_PREP_ENABLED
+#define FUXI_RAM_PREP_ENABLED 0
+#endif
+#if FUXI_RAM_PREP_ENABLED != 0 && FUXI_RAM_PREP_ENABLED != 1
+#error FUXI_RAM_PREP_ENABLED_must_be_zero_or_one
+#endif
+
+#define FUXI_RAM_PREP_VERSION 1u
+#define FUXI_RAM_PREP_PAGE_SIZE UINT64_C(0x4000)
+#define FUXI_RAM_PREP_MAX_BANKS 16u
+#define FUXI_RAM_PREP_MAX_EXCLUSIONS 32u
+#define FUXI_RAM_PREP_MAX_OWNERS 96u
+#define FUXI_RAM_PREP_MAX_OWNER_RANGES 8u
+#define FUXI_RAM_PREP_EXPERIMENTAL 1u
+#define FUXI_RAM_OWNER_COMPLETE 1u
+#define FUXI_RAM_OWNER_PLACEMENT_KNOWN 2u
+#define FUXI_RAM_OWNER_PROVEN_ABSENT 4u
+#define FUXI_RAM_PREP_GPU_BASE UINT64_C(0xafe000000)
+#define FUXI_RAM_PREP_GPU_END UINT64_C(0xb00000000)
+
+enum fuxi_ram_prep_result {
+    FUXI_RAM_PREP_OK = 0,
+    FUXI_RAM_PREP_BAD_MANIFEST,
+    FUXI_RAM_PREP_BAD_RANGE,
+    FUXI_RAM_PREP_OVERFLOW,
+    FUXI_RAM_PREP_BAD_PFN,
+    FUXI_RAM_PREP_OUTSIDE_SPAN,
+    FUXI_RAM_PREP_NOT_WHITELISTED,
+    FUXI_RAM_PREP_GPU,
+    FUXI_RAM_PREP_STATIC,
+    FUXI_RAM_PREP_OWNER,
+    FUXI_RAM_PREP_DISABLED,
+    FUXI_RAM_PREP_PENDING_OWNER,
+    FUXI_RAM_PREP_DUPLICATE_RELEASE,
+    FUXI_RAM_PREP_LEDGER_CAPACITY,
+    FUXI_RAM_PREP_DIRTY_LEDGER,
+    FUXI_RAM_PREP_ALREADY_INITIALIZED,
+    FUXI_RAM_PREP_UNINITIALIZED,
+    FUXI_RAM_PREP_CORRUPT_COUNTERS
+};
+
+struct fuxi_ram_prep_range {
+    uint64_t start;
+    uint64_t size;
+};
+
+struct fuxi_ram_prep_owner {
+    uint32_t id;
+    uint32_t flags;
+    uint32_t range_count;
+    uint32_t reserved;
+    uint8_t evidence_sha256[32];
+    struct fuxi_ram_prep_range ranges[FUXI_RAM_PREP_MAX_OWNER_RANGES];
+};
+
+struct fuxi_ram_prep_manifest {
+    uint32_t version;
+    uint32_t structure_bytes;
+    uint32_t page_size;
+    uint32_t flags;
+    uint64_t physical_base;
+    uint64_t physical_size;
+    uint32_t bank_count;
+    uint32_t exclusion_count;
+    uint32_t owner_count;
+    uint32_t owner_coverage_complete;
+    uint8_t owner_manifest_sha256[32];
+    struct fuxi_ram_prep_range banks[FUXI_RAM_PREP_MAX_BANKS];
+    struct fuxi_ram_prep_range exclusions[FUXI_RAM_PREP_MAX_EXCLUSIONS];
+    struct fuxi_ram_prep_owner owners[FUXI_RAM_PREP_MAX_OWNERS];
+};
+
+struct fuxi_ram_prep_counts {
+    uint64_t span_pages;
+    uint64_t whitelist_pages;
+    uint64_t known_excluded_pages;
+    uint64_t geometric_candidate_pages;
+    uint64_t shadow_released_pages;
+    uint64_t remaining_geometric_pages;
+    uint32_t host_admissible_known;
+    uint64_t host_admissible_pages;
+};
+
+struct fuxi_ram_prep_state {
+    uint32_t initialized;
+    uint32_t owners_complete;
+    uint64_t span_end;
+    struct fuxi_ram_prep_manifest manifest;
+    struct fuxi_ram_prep_counts counts;
+    uint8_t *shadow_ledger;
+    size_t shadow_ledger_bytes;
+};
+
+int fuxi_ram_prep_range_end(struct fuxi_ram_prep_range range, uint64_t *end);
+int fuxi_ram_prep_init_zeroed(struct fuxi_ram_prep_state *state,
+    const struct fuxi_ram_prep_manifest *manifest, uint8_t *shadow_ledger, size_t ledger_bytes);
+int fuxi_ram_prep_dense_index(const struct fuxi_ram_prep_state *state, uint64_t pfn, uint32_t *index);
+int fuxi_ram_prep_probe(const struct fuxi_ram_prep_state *state, uint64_t pfn);
+int fuxi_ram_prep_shadow_release(struct fuxi_ram_prep_state *state, struct fuxi_ram_prep_range range);
+int fuxi_ram_prep_get_counts(const struct fuxi_ram_prep_state *state, struct fuxi_ram_prep_counts *counts);
+
+#endif
diff --git a/xnu/fuxi-ram-prep/test_fuxi_ram_bank.c b/xnu/fuxi-ram-prep/test_fuxi_ram_bank.c
new file mode 100644
index 0000000..8a1b9db
--- /dev/null
+++ b/xnu/fuxi-ram-prep/test_fuxi_ram_bank.c
@@ -0,0 +1,410 @@
+#include "fuxi_ram_bank.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if FUXI_RAM_PREP_ENABLED
+#include "trace_fixture.h"
+#endif
+
+#define HOST_BASE UINT64_C(0x100000000)
+#define CHECK(condition) do { \
+    if (!(condition)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); exit(1); } \
+    checks++; \
+} while (0)
+
+static unsigned checks;
+static unsigned cases;
+
+static struct fuxi_ram_prep_manifest fixture_manifest(void)
+{
+    struct fuxi_ram_prep_manifest manifest;
+    memset(&manifest, 0, sizeof(manifest));
+    manifest.version = FUXI_RAM_PREP_VERSION;
+    manifest.structure_bytes = (uint32_t)sizeof(manifest);
+    manifest.page_size = (uint32_t)FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.flags = FUXI_RAM_PREP_EXPERIMENTAL;
+    manifest.physical_base = HOST_BASE;
+    manifest.physical_size = 16 * FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.bank_count = 2;
+    manifest.banks[0].start = HOST_BASE;
+    manifest.banks[0].size = 4 * FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.banks[1].start = HOST_BASE + 8 * FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.banks[1].size = 4 * FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.exclusion_count = 1;
+    manifest.exclusions[0].start = HOST_BASE + FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.exclusions[0].size = FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.owner_count = 1;
+    manifest.owner_coverage_complete = 1;
+    manifest.owner_manifest_sha256[0] = 1;
+    manifest.owners[0].id = 1;
+    manifest.owners[0].flags = FUXI_RAM_OWNER_COMPLETE | FUXI_RAM_OWNER_PROVEN_ABSENT;
+    manifest.owners[0].evidence_sha256[0] = 1;
+    return manifest;
+}
+
+static void expect_bad_init(const struct fuxi_ram_prep_manifest *manifest, int expected)
+{
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    uint8_t ledger[2] = {0};
+    CHECK(state != NULL);
+    CHECK(fuxi_ram_prep_init_zeroed(state, manifest, ledger, sizeof(ledger)) == expected);
+    CHECK(!state->initialized && !ledger[0] && !ledger[1]);
+    free(state);
+}
+
+static void test_manifest_contract(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    uint32_t *fields[] = {&manifest.version, &manifest.structure_bytes, &manifest.page_size,
+        &manifest.flags, &manifest.bank_count, &manifest.exclusion_count, &manifest.owner_count,
+        &manifest.owner_coverage_complete};
+    for (size_t index = 0; index < sizeof(fields) / sizeof(fields[0]); index++) {
+        uint32_t saved = *fields[index];
+        *fields[index] = UINT32_MAX;
+        expect_bad_init(&manifest, FUXI_RAM_PREP_BAD_MANIFEST);
+        *fields[index] = saved;
+    }
+    manifest.banks[1] = manifest.banks[0];
+    expect_bad_init(&manifest, FUXI_RAM_PREP_BAD_MANIFEST);
+    manifest = fixture_manifest();
+    manifest.owners[0].range_count = FUXI_RAM_PREP_MAX_OWNER_RANGES + 1;
+    expect_bad_init(&manifest, FUXI_RAM_PREP_BAD_MANIFEST);
+    manifest = fixture_manifest();
+    manifest.owner_count = 2;
+    manifest.owners[1] = manifest.owners[0];
+    expect_bad_init(&manifest, FUXI_RAM_PREP_BAD_MANIFEST);
+    manifest = fixture_manifest();
+    manifest.owners[0].flags = FUXI_RAM_OWNER_COMPLETE | FUXI_RAM_OWNER_PLACEMENT_KNOWN;
+    manifest.owners[0].range_count = 1;
+    manifest.owners[0].ranges[0].start = HOST_BASE;
+    expect_bad_init(&manifest, FUXI_RAM_PREP_BAD_RANGE);
+    cases++;
+}
+
+static void test_range_boundaries(void)
+{
+    uint64_t end;
+    struct fuxi_ram_prep_range range = {HOST_BASE, FUXI_RAM_PREP_PAGE_SIZE};
+    CHECK(fuxi_ram_prep_range_end(range, &end) == FUXI_RAM_PREP_OK && end == HOST_BASE + range.size);
+    range.size = 0;
+    CHECK(fuxi_ram_prep_range_end(range, &end) == FUXI_RAM_PREP_BAD_RANGE);
+    range.size = FUXI_RAM_PREP_PAGE_SIZE;
+    range.start++;
+    CHECK(fuxi_ram_prep_range_end(range, &end) == FUXI_RAM_PREP_BAD_RANGE);
+    range.start = HOST_BASE;
+    range.size++;
+    CHECK(fuxi_ram_prep_range_end(range, &end) == FUXI_RAM_PREP_BAD_RANGE);
+    range.start = UINT64_MAX & ~(FUXI_RAM_PREP_PAGE_SIZE - 1);
+    range.size = FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_range_end(range, &end) == FUXI_RAM_PREP_OVERFLOW);
+    range.start = (uint64_t)UINT32_MAX << 14;
+    CHECK(fuxi_ram_prep_range_end(range, &end) == FUXI_RAM_PREP_OK);
+    range.size *= 2;
+    CHECK(fuxi_ram_prep_range_end(range, &end) == FUXI_RAM_PREP_BAD_PFN);
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    manifest.physical_base = 0;
+    manifest.physical_size = (UINT64_C(1) << 32) * FUXI_RAM_PREP_PAGE_SIZE;
+    expect_bad_init(&manifest, FUXI_RAM_PREP_BAD_MANIFEST);
+    cases++;
+}
+
+static void test_dense_index_and_storage(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    uint8_t ledger[2] = {0};
+    uint32_t index;
+    CHECK(state != NULL);
+    CHECK(fuxi_ram_prep_dense_index(state, HOST_BASE >> 14, &index) == FUXI_RAM_PREP_UNINITIALIZED);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, NULL, 2) == FUXI_RAM_PREP_LEDGER_CAPACITY);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 1) == FUXI_RAM_PREP_LEDGER_CAPACITY);
+    ledger[1] = 128;
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_DIRTY_LEDGER);
+    ledger[1] = 0;
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_dense_index(state, HOST_BASE >> 14, &index) == FUXI_RAM_PREP_OK && index == 0);
+    CHECK(fuxi_ram_prep_dense_index(state, (HOST_BASE >> 14) + 4, &index) == FUXI_RAM_PREP_OK && index == 4);
+    CHECK(fuxi_ram_prep_probe(state, (HOST_BASE >> 14) + 4) == FUXI_RAM_PREP_NOT_WHITELISTED);
+    CHECK(fuxi_ram_prep_dense_index(state, (HOST_BASE >> 14) + 8, &index) == FUXI_RAM_PREP_OK && index == 8);
+    CHECK(fuxi_ram_prep_dense_index(state, (HOST_BASE >> 14) + 15, &index) == FUXI_RAM_PREP_OK && index == 15);
+    CHECK(fuxi_ram_prep_dense_index(state, (HOST_BASE >> 14) + 16, &index) == FUXI_RAM_PREP_OUTSIDE_SPAN);
+    CHECK(fuxi_ram_prep_dense_index(state, UINT64_C(1) << 32, &index) == FUXI_RAM_PREP_BAD_PFN);
+    CHECK(fuxi_ram_prep_probe(state, FUXI_RAM_PREP_GPU_BASE >> 14) == FUXI_RAM_PREP_GPU);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_ALREADY_INITIALIZED);
+    free(state);
+    cases++;
+}
+
+static void test_default_disable(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    struct fuxi_ram_prep_counts counts;
+    uint8_t ledger[2] = {0};
+    CHECK(state != NULL);
+    manifest.flags = 0;
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_probe(state, HOST_BASE >> 14) == FUXI_RAM_PREP_DISABLED);
+    struct fuxi_ram_prep_range range = {HOST_BASE, FUXI_RAM_PREP_PAGE_SIZE};
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_DISABLED);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(!counts.host_admissible_known && !counts.shadow_released_pages && !ledger[0] && !ledger[1]);
+    free(state);
+    state = calloc(1, sizeof(*state));
+    CHECK(state != NULL);
+    manifest.flags = FUXI_RAM_PREP_EXPERIMENTAL;
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_probe(state, HOST_BASE >> 14) ==
+        (FUXI_RAM_PREP_ENABLED ? FUXI_RAM_PREP_OK : FUXI_RAM_PREP_DISABLED));
+    if (!FUXI_RAM_PREP_ENABLED)
+        CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_DISABLED && !ledger[0]);
+    free(state);
+    cases++;
+}
+
+static void test_twelve_gib_span(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    manifest.physical_size = UINT64_C(12) << 30;
+    manifest.bank_count = 1;
+    manifest.banks[0].size = manifest.physical_size;
+    manifest.exclusion_count = 0;
+    size_t ledger_bytes = (size_t)(manifest.physical_size / FUXI_RAM_PREP_PAGE_SIZE / 8);
+    uint8_t *ledger = calloc(ledger_bytes, 1);
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    struct fuxi_ram_prep_counts counts;
+    uint32_t index;
+    CHECK(state != NULL && ledger != NULL);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, ledger_bytes) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(counts.span_pages == 786432 && counts.geometric_candidate_pages == 786432);
+    CHECK(fuxi_ram_prep_dense_index(state, (HOST_BASE + manifest.physical_size) / FUXI_RAM_PREP_PAGE_SIZE - 1,
+        &index) == FUXI_RAM_PREP_OK && index == 786431);
+    free(state);
+    free(ledger);
+    cases++;
+}
+
+#if FUXI_RAM_PREP_ENABLED
+static void expect_pending_owner(const struct fuxi_ram_prep_manifest *manifest)
+{
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    uint8_t ledger[2] = {0};
+    struct fuxi_ram_prep_counts counts;
+    struct fuxi_ram_prep_range range = {HOST_BASE + 2 * FUXI_RAM_PREP_PAGE_SIZE, FUXI_RAM_PREP_PAGE_SIZE};
+    CHECK(state != NULL);
+    CHECK(fuxi_ram_prep_init_zeroed(state, manifest, ledger, 2) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_probe(state, range.start >> 14) == FUXI_RAM_PREP_PENDING_OWNER);
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_PENDING_OWNER);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(!counts.host_admissible_known && !counts.shadow_released_pages && !ledger[0] && !ledger[1]);
+    free(state);
+}
+
+static void test_owner_evidence(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    manifest.owner_count = 0;
+    expect_pending_owner(&manifest);
+    manifest = fixture_manifest();
+    manifest.owner_coverage_complete = 0;
+    expect_pending_owner(&manifest);
+    manifest = fixture_manifest();
+    memset(manifest.owner_manifest_sha256, 0, 32);
+    expect_pending_owner(&manifest);
+    manifest = fixture_manifest();
+    memset(manifest.owners[0].evidence_sha256, 0, 32);
+    expect_pending_owner(&manifest);
+    manifest = fixture_manifest();
+    manifest.owners[0].flags = FUXI_RAM_OWNER_PLACEMENT_KNOWN | FUXI_RAM_OWNER_COMPLETE;
+    expect_pending_owner(&manifest);
+    manifest = fixture_manifest();
+    manifest.owners[0].flags = FUXI_RAM_OWNER_PROVEN_ABSENT;
+    expect_pending_owner(&manifest);
+    cases++;
+}
+
+static void test_exclusion_union_and_observed_owner(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    struct fuxi_ram_prep_counts counts;
+    uint8_t ledger[2] = {0};
+    CHECK(state != NULL);
+    manifest.exclusion_count = 2;
+    manifest.exclusions[1] = manifest.exclusions[0];
+    manifest.owners[0].flags = FUXI_RAM_OWNER_COMPLETE | FUXI_RAM_OWNER_PLACEMENT_KNOWN;
+    manifest.owners[0].range_count = 2;
+    manifest.owners[0].ranges[0] = manifest.exclusions[0];
+    manifest.owners[0].ranges[1].start = HOST_BASE + 9 * FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.owners[0].ranges[1].size = FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_probe(state, (HOST_BASE >> 14) + 1) == FUXI_RAM_PREP_STATIC);
+    CHECK(fuxi_ram_prep_probe(state, (HOST_BASE >> 14) + 9) == FUXI_RAM_PREP_OWNER);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(counts.span_pages == 16 && counts.whitelist_pages == 8 && counts.known_excluded_pages == 2);
+    CHECK(counts.geometric_candidate_pages == 6 && counts.host_admissible_known && counts.host_admissible_pages == 6);
+    free(state);
+    state = calloc(1, sizeof(*state));
+    CHECK(state != NULL);
+    manifest.owners[0].flags = 0;
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_probe(state, (HOST_BASE >> 14) + 9) == FUXI_RAM_PREP_OWNER);
+    CHECK(fuxi_ram_prep_probe(state, HOST_BASE >> 14) == FUXI_RAM_PREP_PENDING_OWNER);
+    free(state);
+    cases++;
+}
+
+static void test_shadow_release_once(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    struct fuxi_ram_prep_counts counts;
+    uint8_t ledger[2] = {0};
+    CHECK(state != NULL);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_OK);
+    struct fuxi_ram_prep_range range = {HOST_BASE + 2 * FUXI_RAM_PREP_PAGE_SIZE, 2 * FUXI_RAM_PREP_PAGE_SIZE};
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_DUPLICATE_RELEASE);
+    range.start = HOST_BASE;
+    range.size = 4 * FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_STATIC && ledger[0] == 12 && !ledger[1]);
+    range.size = FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_OK);
+    range.start = HOST_BASE + 8 * FUXI_RAM_PREP_PAGE_SIZE;
+    range.size = 5 * FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_NOT_WHITELISTED && !ledger[1]);
+    range.start = HOST_BASE + 10 * FUXI_RAM_PREP_PAGE_SIZE;
+    range.size = FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_OK);
+    range.start = HOST_BASE + 8 * FUXI_RAM_PREP_PAGE_SIZE;
+    range.size = 4 * FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_DUPLICATE_RELEASE && ledger[1] == 4);
+    range.size = 2 * FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_OK);
+    range.start = HOST_BASE + 11 * FUXI_RAM_PREP_PAGE_SIZE;
+    range.size = FUXI_RAM_PREP_PAGE_SIZE;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(counts.geometric_candidate_pages == 7 && counts.shadow_released_pages == 7 && !counts.remaining_geometric_pages);
+    CHECK(counts.known_excluded_pages + counts.geometric_candidate_pages == counts.whitelist_pages);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, 2) == FUXI_RAM_PREP_ALREADY_INITIALIZED);
+    struct fuxi_ram_prep_state *fresh = calloc(1, sizeof(*fresh));
+    CHECK(fresh != NULL);
+    CHECK(fuxi_ram_prep_init_zeroed(fresh, &manifest, ledger, 2) == FUXI_RAM_PREP_DIRTY_LEDGER);
+    state->counts.shadow_released_pages++;
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_CORRUPT_COUNTERS);
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_CORRUPT_COUNTERS);
+    free(fresh);
+    free(state);
+    cases++;
+}
+
+static void test_gpu_whitelist_conflict(void)
+{
+    struct fuxi_ram_prep_manifest manifest = fixture_manifest();
+    manifest.physical_base = FUXI_RAM_PREP_GPU_BASE - FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.physical_size = FUXI_RAM_PREP_GPU_END - manifest.physical_base + FUXI_RAM_PREP_PAGE_SIZE;
+    manifest.bank_count = 1;
+    manifest.banks[0].start = manifest.physical_base;
+    manifest.banks[0].size = manifest.physical_size;
+    manifest.exclusion_count = 0;
+    size_t ledger_bytes = (size_t)((manifest.physical_size / FUXI_RAM_PREP_PAGE_SIZE + 7) / 8);
+    uint8_t *ledger = calloc(ledger_bytes, 1);
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    struct fuxi_ram_prep_counts counts;
+    CHECK(state != NULL && ledger != NULL);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, ledger_bytes) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(counts.span_pages == 2050 && counts.known_excluded_pages == 2048 && counts.geometric_candidate_pages == 2);
+    CHECK(fuxi_ram_prep_probe(state, FUXI_RAM_PREP_GPU_BASE >> 14) == FUXI_RAM_PREP_GPU);
+    CHECK(fuxi_ram_prep_probe(state, (FUXI_RAM_PREP_GPU_END >> 14) - 1) == FUXI_RAM_PREP_GPU);
+    CHECK(fuxi_ram_prep_shadow_release(state, manifest.banks[0]) == FUXI_RAM_PREP_GPU && !ledger[0]);
+    struct fuxi_ram_prep_range range = {manifest.physical_base, FUXI_RAM_PREP_PAGE_SIZE};
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_OK);
+    range.start = FUXI_RAM_PREP_GPU_END;
+    CHECK(fuxi_ram_prep_shadow_release(state, range) == FUXI_RAM_PREP_OK);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(counts.shadow_released_pages == 2 && !counts.remaining_geometric_pages);
+    free(state);
+    free(ledger);
+    cases++;
+}
+
+static void test_actual_trace(void)
+{
+    struct fuxi_ram_prep_manifest manifest;
+    load_actual_manifest(&manifest);
+    size_t ledger_bytes = (size_t)((manifest.physical_size / FUXI_RAM_PREP_PAGE_SIZE + 7) / 8);
+    uint8_t *ledger = calloc(ledger_bytes, 1);
+    struct fuxi_ram_prep_state *state = calloc(1, sizeof(*state));
+    struct fuxi_ram_prep_counts counts;
+    uint64_t audited = 0, dense = 0, deferred = 0, rejected = 0;
+    CHECK(state != NULL && ledger != NULL);
+    CHECK(fuxi_ram_prep_init_zeroed(state, &manifest, ledger, ledger_bytes) == FUXI_RAM_PREP_OK);
+    for (size_t run_index = 0; run_index < sizeof(actual_runs) / sizeof(actual_runs[0]); run_index++) {
+        const struct actual_trace_run *run = &actual_runs[run_index];
+        for (uint64_t page = 0; page < run->pages; page++) {
+            uint64_t pfn = run->first_pfn + page;
+            uint32_t index;
+            int result = fuxi_ram_prep_probe(state, pfn);
+            if (run->defer) {
+                CHECK(result == FUXI_RAM_PREP_PENDING_OWNER);
+                deferred++;
+            } else {
+                CHECK(result != FUXI_RAM_PREP_OK && result != FUXI_RAM_PREP_PENDING_OWNER && result != FUXI_RAM_PREP_DISABLED);
+                rejected++;
+            }
+            if (fuxi_ram_prep_dense_index(state, pfn, &index) == FUXI_RAM_PREP_OK) {
+                CHECK(index == pfn - (manifest.physical_base >> 14));
+                dense++;
+            }
+            audited++;
+        }
+    }
+    CHECK(audited == ACTUAL_AUDITED && dense == ACTUAL_DENSE && deferred == ACTUAL_DEFERRED && rejected == ACTUAL_REJECTED);
+    CHECK(fuxi_ram_prep_shadow_release(state, manifest.banks[0]) == FUXI_RAM_PREP_PENDING_OWNER);
+    CHECK(fuxi_ram_prep_get_counts(state, &counts) == FUXI_RAM_PREP_OK);
+    CHECK(!counts.host_admissible_known && !counts.shadow_released_pages && counts.geometric_candidate_pages == deferred);
+    CHECK(counts.geometric_candidate_pages == counts.remaining_geometric_pages + counts.shadow_released_pages);
+    printf("{\"mode\":\"actual-trace\",\"audited_pfns\":%llu,\"dense_indices\":%llu,\"deferred_pfns\":%llu,"
+        "\"rejected_pfns\":%llu,\"owners\":%u,\"shadow_released_pages\":0,\"allocatable_bytes\":null}\n",
+        (unsigned long long)audited, (unsigned long long)dense, (unsigned long long)deferred,
+        (unsigned long long)rejected, manifest.owner_count);
+    free(state);
+    free(ledger);
+}
