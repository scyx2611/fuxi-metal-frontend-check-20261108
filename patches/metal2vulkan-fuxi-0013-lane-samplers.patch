+#[cold]
+fn lane_start() -> bool {
+    let on = boot_value().is_some_and(|v| v >= 2);
+    let _ = LANE.compare_exchange(
+        UNKNOWN,
+        if on { ON } else { OFF },
+        Ordering::AcqRel,
+        Ordering::Acquire,
+    );
+    LANE.load(Ordering::Acquire) == ON
