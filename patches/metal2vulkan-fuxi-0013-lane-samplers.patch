+/// FUXI census: a hash (FNV-1a) of a draw's set-0 writes, what its descriptor set holds, so the
+/// census can count draws whose writes equal the last ones of their pipeline layout.
+fn set_zero_hash(writes: &[binding::Write]) -> u64 {
+    use ash::vk::Handle as _;
+    let mut hash = 0xcbf2_9ce4_8422_2325_u64;
+    let mut mix = |value: u64| {
+        hash ^= value;
+        hash = hash.wrapping_mul(0x0100_0000_01b3);
+    };
+    for write in writes {
+        mix(u64::from(write.set) << 32 | u64::from(write.binding));
+        mix(u64::from(write.element) << 32 | write.ty.as_raw() as u32 as u64);
+        match write.info {
+            binding::Info::Buffer(info) => {
+                mix(1);
+                mix(info.buffer.as_raw());
+                mix(info.offset);
+                mix(info.range);
+            }
+            binding::Info::Image(info) => {
+                mix(2);
+                mix(info.sampler.as_raw());
+                mix(info.image_view.as_raw());
+                mix(info.image_layout.as_raw() as u32 as u64);
+            }
+            binding::Info::Texel(view) => {
+                mix(3);
+                mix(view.as_raw());
+            }
+        }
+    }
+    hash
+}
