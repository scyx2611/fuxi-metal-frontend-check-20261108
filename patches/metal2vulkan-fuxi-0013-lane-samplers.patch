+
+/// Whether the hybrid lane's cuts are on (`fuxihyb=2` or more), read once per process.
+#[inline]
+pub(crate) fn lane() -> bool {
+    match LANE.load(Ordering::Relaxed) {
+        ON => true,
+        OFF => false,
+        _ => lane_start(),
+    }
+}
