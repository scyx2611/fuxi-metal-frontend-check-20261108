 /// Destroy `entries` without holding the pool mutex: destroys each `VkImage` through
diff --git a/crates/metal2vulkan-runtime/src/tests/image_pool.rs b/crates/metal2vulkan-runtime/src/tests/image_pool.rs
index 4ab25b6..36b43e6 100644
--- a/crates/metal2vulkan-runtime/src/tests/image_pool.rs
+++ b/crates/metal2vulkan-runtime/src/tests/image_pool.rs
@@ -532,3 +532,59 @@ fn non_monotonic_timestamp_ttl_eviction() {
     destroy_entries(&harness.vk, &harness.memory, expired2);
     assert_eq!(harness.double_free_count(), 0);
 }
+
+#[test]
+fn telemetry_counts_hits_misses_and_evictions() {
+    let harness = MockHarness::new();
+    let pool = ImagePool::default();
+    let t0 = Instant::now();
+    let key = base_key();
+
+    // Cold miss.
+    let (hit0, exp0) = pool.take_at(&key, t0);
+    assert!(hit0.is_none() && exp0.is_empty());
+    let st = pool.telemetry_stats();
+    assert_eq!((st.hits, st.misses, st.evicts, st.entries, st.bytes), (0, 1, 0, 0, 0));
+
+    // Return two entries -> hit one, let the other expire on a later lookup.
+    assert!(pool.give_back_at(make_entry(&harness, key.clone(), 601, 4096, t0), t0).is_empty());
+    assert!(pool
+        .give_back_at(
+            make_entry(&harness, key.clone(), 602, 4096, t0 + Duration::from_secs(5)),
+            t0 + Duration::from_secs(5)
+        )
+        .is_empty());
+
+    let (hit1, exp1) = pool.take_at(&key, t0 + Duration::from_secs(6));
+    assert_eq!(hit1.unwrap().raw.as_raw(), 602);
+    assert!(exp1.is_empty());
+    let st = pool.telemetry_stats();
+    assert_eq!((st.hits, st.misses, st.evicts, st.entries, st.bytes), (1, 1, 0, 1, 4096));
+
+    // At t0 + 11s, 601 expires during take_at -> 1 evict + 1 miss.
+    let (hit2, exp2) = pool.take_at(&key, t0 + Duration::from_secs(11));
+    assert!(hit2.is_none());
+    assert_eq!(exp2.len(), 1);
+    destroy_entries(&harness.vk, &harness.memory, exp2);
+    let st = pool.telemetry_stats();
+    assert_eq!((st.hits, st.misses, st.evicts, st.entries, st.bytes), (1, 2, 1, 0, 0));
+
+    // Oversized rejection increments evicts immediately.
+    let oversized = pool.give_back_at(
+        make_entry(&harness, key.clone(), 603, MAX_POOL_ENTRY_BYTES + 4096, t0),
+        t0,
+    );
+    assert_eq!(oversized.len(), 1);
+    destroy_entries(&harness.vk, &harness.memory, oversized);
+    assert_eq!(pool.telemetry_stats().evicts, 2);
+
+    // Budget drain_all increments evicts for all drained entries.
+    assert!(pool.give_back_at(make_entry(&harness, key.clone(), 604, 4096, t0), t0).is_empty());
+    assert!(pool.give_back_at(make_entry(&harness, key, 605, 4096, t0), t0).is_empty());
+    let drained = pool.drain_all();
+    assert_eq!(drained.len(), 2);
+    destroy_entries(&harness.vk, &harness.memory, drained);
+    let st = pool.telemetry_stats();
+    assert_eq!((st.hits, st.misses, st.evicts, st.entries, st.bytes), (1, 2, 4, 0, 0));
+    assert_eq!(harness.double_free_count(), 0);
+}
