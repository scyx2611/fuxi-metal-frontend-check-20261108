+        None
+    } else {
+        // SAFETY: `tu_darwin_last_lost_reason` has C ABI `size_t (*)(char *, size_t)`.
+        let query: unsafe extern "C" fn(*mut c_char, usize) -> usize = unsafe { std::mem::transmute(sym) };
+        let mut buf = vec![0u8; 512];
+        // SAFETY: `buf` is writable for `buf.len()` bytes.
+        let n = unsafe { query(buf.as_mut_ptr() as *mut c_char, buf.len()) };
+        if n > 0 {
+            let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());
+            let s = String::from_utf8_lossy(&buf[..end]).into_owned();
+            if s.is_empty() { None } else { Some(s) }
+        } else {
+            None
+        }
+    };
+    // SAFETY: closes the `dlopen` reference acquired above.
+    unsafe { dlclose(handle) };
+    out
+}
+
+#[cfg(not(unix))]
+fn query_turnip_lost_reason(_loader: &Path) -> Option<String> {
+    None
+}
+
+const FORBIDDEN_LAST_LOST_PREFIXES: &[&str] = &["/private/var/db/fuxi-metal", "/var/db/fuxi-metal"];
+
+fn has_forbidden_prefix(path: &Path, forbidden_prefixes: &[&Path]) -> bool {
+    forbidden_prefixes.iter().any(|prefix| path.starts_with(prefix))
+}
+
+fn is_forbidden_last_lost_cache_dir_against(cache: &Path, forbidden_prefixes: &[&Path]) -> bool {
+    if cache.as_os_str().is_empty() {
+        return true;
+    }
+    if cache.components().any(|c| matches!(c, std::path::Component::ParentDir)) {
+        return true;
+    }
+    let normalized: PathBuf = cache
+        .components()
+        .filter(|c| !matches!(c, std::path::Component::CurDir))
+        .collect();
+    if has_forbidden_prefix(&normalized, forbidden_prefixes) {
+        return true;
+    }
+    if let Ok(canon) = std::fs::canonicalize(&normalized) {
+        if has_forbidden_prefix(&canon, forbidden_prefixes) {
+            return true;
+        }
+    } else {
+        let mut cur = normalized.as_path();
+        while let Some(parent) = cur.parent() {
+            if parent.as_os_str().is_empty() {
+                break;
+            }
+            if let Ok(canon_parent) = std::fs::canonicalize(parent) {
+                if let Ok(tail) = normalized.strip_prefix(parent) {
+                    let resolved = canon_parent.join(tail);
+                    if has_forbidden_prefix(&resolved, forbidden_prefixes) {
+                        return true;
+                    }
+                }
+                break;
+            }
+            cur = parent;
+        }
+    }
+    false
+}
+
+fn is_forbidden_last_lost_cache_dir(cache: &Path) -> bool {
+    let prefixes = [
+        Path::new(FORBIDDEN_LAST_LOST_PREFIXES[0]),
+        Path::new(FORBIDDEN_LAST_LOST_PREFIXES[1]),
+    ];
+    is_forbidden_last_lost_cache_dir_against(cache, &prefixes)
+}
+
+fn write_last_lost_log_to_cache(cache: &Path, report: &str) {
+    if is_forbidden_last_lost_cache_dir(cache) {
+        return;
+    }
+    let tmp_path = cache.join("last-lost.log.tmp");
+    let final_path = cache.join("last-lost.log");
+    let result = (|| -> std::io::Result<()> {
+        let mut file = std::fs::OpenOptions::new()
+            .create(true)
+            .write(true)
+            .truncate(true)
+            .open(&tmp_path)?;
+        file.write_all(report.as_bytes())?;
+        file.sync_all()?;
+        drop(file);
+        std::fs::rename(&tmp_path, &final_path)?;
+        Ok(())
+    })();
+    if let Err(err) = result {
+        eprintln!("FUXI NMB: failed to write {}: {err}", final_path.display());
+    }
+}
+
+fn write_last_lost_log_once(dev: &NmbDevice, report: &str) {
+    if dev.5.compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire).is_err() {
+        return;
+    }
+    eprintln!("FUXI NMB FIRST LOST:\n{report}");
+    write_last_lost_log_to_cache(&dev.4, report);
+}
