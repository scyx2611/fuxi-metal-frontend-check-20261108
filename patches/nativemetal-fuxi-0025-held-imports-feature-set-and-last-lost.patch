+#[cfg(test)]
+mod last_lost_tests {
+    use super::*;
+
+    #[test]
+    fn rejects_var_and_private_var_and_parent_traversal() {
+        assert!(is_forbidden_last_lost_cache_dir(Path::new("")));
+        assert!(is_forbidden_last_lost_cache_dir(Path::new("/private/var/db/fuxi-metal")));
+        assert!(is_forbidden_last_lost_cache_dir(Path::new("/private/var/db/fuxi-metal/app")));
+        assert!(is_forbidden_last_lost_cache_dir(Path::new("/var/db/fuxi-metal")));
+        assert!(is_forbidden_last_lost_cache_dir(Path::new("/var/db/fuxi-metal/app")));
+        assert!(is_forbidden_last_lost_cache_dir(Path::new("/var/./db//fuxi-metal/")));
+        assert!(is_forbidden_last_lost_cache_dir(Path::new("/tmp/safe/../var/db/fuxi-metal")));
+        assert!(!is_forbidden_last_lost_cache_dir(Path::new("/var/db/fuxi-metal-other")));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn canonicalize_blocks_symlink_and_writes_safe_dir() {
+        let base = std::env::temp_dir().join(format!("fuxi_last_lost_test_{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&base);
+        let forbidden_real = base.join("private/var/db/fuxi-metal");
+        let safe_dir = base.join("app_cache");
+        let symlink_var = base.join("var_link");
+        std::fs::create_dir_all(&forbidden_real).unwrap();
+        std::fs::create_dir_all(&safe_dir).unwrap();
+        std::os::unix::fs::symlink(base.join("private/var"), &symlink_var).unwrap();
+
+        let canon_forbidden = std::fs::canonicalize(&forbidden_real).unwrap();
+        let prefixes = [canon_forbidden.as_path()];
+
+        let via_symlink = symlink_var.join("db/fuxi-metal");
+        assert!(is_forbidden_last_lost_cache_dir_against(&via_symlink, &prefixes));
+        let via_symlink_sub = symlink_var.join("db/fuxi-metal/app_not_created_yet");
+        assert!(is_forbidden_last_lost_cache_dir_against(&via_symlink_sub, &prefixes));
+        assert!(!is_forbidden_last_lost_cache_dir_against(&safe_dir, &prefixes));
+
+        // Actual atomic write in safe_dir + no-op on /var/db/fuxi-metal
+        write_last_lost_log_to_cache(&safe_dir, "first_loss stage=test\n");
+        let written = std::fs::read_to_string(safe_dir.join("last-lost.log")).unwrap();
+        assert_eq!(written, "first_loss stage=test\n");
+        assert!(!safe_dir.join("last-lost.log.tmp").exists());
+
+        write_last_lost_log_to_cache(Path::new("/var/db/fuxi-metal"), "should_not_write");
+        write_last_lost_log_to_cache(Path::new("/var/db/fuxi-metal/app"), "should_not_write");
+        write_last_lost_log_to_cache(Path::new("/private/var/db/fuxi-metal"), "should_not_write");
+
+        let _ = std::fs::remove_dir_all(&base);
+    }
+}
