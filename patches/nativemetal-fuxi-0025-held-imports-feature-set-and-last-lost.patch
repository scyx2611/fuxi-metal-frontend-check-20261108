+/// Releases all idle pooled `VkImage` entries and empty kept memory blocks back to Vulkan.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_device_release_kept_memory(device: *const NmbDevice) -> usize {
+    guard(0, || Ok(get(device)?.0.release_kept_memory()))
+}
+
+/// Returns the first-loss diagnostics report (with optional Turnip `tu_darwin_last_lost_reason` and recent VK errors)
+/// and atomically writes `<cache>/last-lost.log` once per device.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_device_first_lost_report(device: *const NmbDevice, out: *mut c_char, size: usize) -> usize {
+    guard(0, || {
+        let dev = get(device)?;
+        let runtime_report = dev.0.first_loss_report_text();
+        let turnip_reason = query_turnip_lost_reason(&dev.3);
+        if runtime_report.is_none() && turnip_reason.is_none() {
+            return Ok(0);
+        }
+        let mut report = runtime_report.unwrap_or_else(|| "first_loss stage=turnip_or_external\n".to_string());
+        if let Some(reason) = turnip_reason {
+            report.push_str(&format!("turnip_last_lost_reason={reason}\n"));
+        }
+        if let Ok(ring) = VK_ERROR_RING.lock() {
+            if !ring.is_empty() {
+                report.push_str(&format!("vk_error_ring({}):\n", ring.len()));
+                for (idx, line) in ring.iter().enumerate() {
+                    report.push_str(&format!("  [{idx}] {line}\n"));
+                }
+            }
+        }
+        write_last_lost_log_once(dev, &report);
+        Ok(copy_out(&report, out, size))
+    })
+}
