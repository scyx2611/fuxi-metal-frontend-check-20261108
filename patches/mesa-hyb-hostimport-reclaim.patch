 static VkResult
+darwin_reclaim_import_cache(struct tu_device *dev, bool *released)
+{
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   const uint64_t before = retire->cache_bytes;
+   darwin_cache_flush(dev, retire);
+   *released = retire->cache_bytes < before;
+   VkResult result = retire->failure;
+   pthread_mutex_unlock(&retire->lock);
+   return result;
+}
