+    write16(bytes + 10, 0);
+    CHECK(fuxi_htc_parse_frame(bytes, length, &output) == FUXI_HTC_INVALID_CONTROL);
+    payload[4] = 2; payload[5] = 255; payload[6] = payload[7] = 0;
