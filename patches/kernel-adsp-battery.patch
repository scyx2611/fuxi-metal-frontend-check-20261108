+    CHECK(fuxi_haptic_fifo_prepare(&io, &request, &state) == FuxiHapticFifoGateClosed);
+    CHECK(state.probed && !model.writes);
+    for (index = 0; index < sizeof(phases) / sizeof(phases[0]); index++) {
