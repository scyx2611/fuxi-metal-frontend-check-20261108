++        if (rd(&gTcsr, FA_MUTEX_OFF) == 1) return 1;
++        delay(10);
++    }
++    return 0;
++}
++static void unlockSmem(void) { wr(&gTcsr, FA_MUTEX_OFF, 0); }
++static int allocItem(uint16_t id, uint32_t size)
++{
++    if (!lockSmem()) return -16;
