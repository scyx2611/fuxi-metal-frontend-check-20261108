+        CHECK(memcmp(values_before, fb_values, sizeof values_before) == 0);
+        CHECK(memcmp(codec_values_before, fb_bm.value, sizeof codec_values_before) == 0);
+        CHECK(memcmp(&pub_before, &fb_pub, sizeof pub_before) == 0);
