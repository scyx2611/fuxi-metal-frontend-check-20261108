diff --git a/xnu/fuxi-haptic-prep/fuxi_haptic_fifo.c b/xnu/fuxi-haptic-prep/fuxi_haptic_fifo.c
new file mode 100644
index 0000000000000000000000000000000000000000..f15fc6d6edd80da07b5ed659a86615c6a867d001
--- /dev/null
+++ b/xnu/fuxi-haptic-prep/fuxi_haptic_fifo.c
@@ -0,0 +1,335 @@
+#include "fuxi_haptic_fifo.h"
+
+static const uint8_t cfg_offsets[] = {
+    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x0b, 0x0c, 0x46, 0x48,
+    0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x50, 0x51, 0x5c, 0x5d,
+    0x63, 0x68, 0x70, 0x71, 0x72
+};
+static const uint8_t ptn_offsets[] = {
+    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x08, 0x09, 0x24, 0x2a,
+    0x2d, 0x30, 0x31, 0xa0
+};
+static const uint8_t boost_offsets[] = {
+    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x0b, 0x41, 0x46
+};
+
+_Static_assert(FUXI_HAPTIC_FIFO_ACTIVE_GATE == 0u && FUXI_HAPTIC_FIFO_MAX_WRITES == 0u,
+    "FIFO preparation must remain read-only");
+_Static_assert(FUXI_HAPTIC_FIFO_MAX_REFILLS == 0u && FUXI_HAPTIC_FIFO_MAX_STOP_POLLS == 0u,
+    "FIFO preparation must not refill or stop hardware");
+_Static_assert(2u * (sizeof(cfg_offsets) + sizeof(ptn_offsets) + sizeof(boost_offsets) + 4u) ==
+    FUXI_HAPTIC_FIFO_MAX_READS, "FIFO read budget must match the snapshot inventory");
+_Static_assert(FUXI_HAPTIC_FIFO_MAX_OWNER_READS == FUXI_HAPTIC_FIFO_MAX_READS + 6u,
+    "FIFO owner budget must include both end-of-snapshot checks");
+
+static void zero_bytes(void *target, size_t count)
+{
+    uint8_t *bytes = target;
+    size_t index;
+    for (index = 0; index < count; index++) bytes[index] = 0;
+}
+
+int fuxi_haptic_fifo_encode(const uint8_t *codes, unsigned count,
+    unsigned vmax_mv, uint16_t tlra_code, FuxiHapticFifoPlan *plan)
+{
+    FuxiHapticFifoPlan encoded;
+    unsigned index, cursor;
+    if (!codes || !plan) return FuxiHapticFifoInvalid;
+    if (count <= FUXI_HAPTIC_FIFO_TAIL_ZEROS || count > FUXI_HAPTIC_FIFO_MAX_SAMPLES ||
+        !vmax_mv || vmax_mv > FUXI_HAPTIC_FIFO_MAX_VMAX_MV || vmax_mv % 50u ||
+        !tlra_code || tlra_code > 4095u) return FuxiHapticFifoBounds;
+    for (index = 0; index < count; index++) {
+        if (codes[index] > FUXI_HAPTIC_FIFO_MAX_CODE) return FuxiHapticFifoBounds;
+        if (index >= count - FUXI_HAPTIC_FIFO_TAIL_ZEROS && codes[index])
+            return FuxiHapticFifoInvalid;
+    }
+    zero_bytes(&encoded, sizeof(encoded));
+    encoded.sample_count = count;
+    encoded.vmax_mv = vmax_mv;
+    encoded.tlra_code = tlra_code;
+    encoded.nominal_data_us = count * (unsigned)tlra_code * 5u;
+    for (index = 0; index < count; index++) encoded.sample_codes[index] = codes[index];
+    cursor = 0;
+    while (count - cursor >= 4u) {
+        FuxiHapticFifoChunk *chunk = &encoded.chunks[encoded.chunk_count++];
+        chunk->address = 0xf120;
+        chunk->length = 4;
+        for (index = 0; index < 4; index++) chunk->bytes[index] = codes[cursor++];
+    }
+    while (cursor < count) {
+        FuxiHapticFifoChunk *chunk = &encoded.chunks[encoded.chunk_count++];
+        chunk->address = 0xf12c;
+        chunk->length = 1;
+        chunk->bytes[0] = codes[cursor++];
+    }
+    *plan = encoded;
+    return FuxiHapticFifoOk;
+}
+
+int fuxi_haptic_fifo_validate_plan(const FuxiHapticFifoPlan *plan)
+{
+    FuxiHapticFifoPlan encoded;
+    unsigned index, byte_index;
+    int result;
+    if (!plan) return FuxiHapticFifoInvalid;
+    result = fuxi_haptic_fifo_encode(plan->sample_codes, plan->sample_count,
+        plan->vmax_mv, plan->tlra_code, &encoded);
+    if (result) return FuxiHapticFifoCorrupt;
+    if (plan->chunk_count != encoded.chunk_count ||
+        plan->nominal_data_us != encoded.nominal_data_us) return FuxiHapticFifoCorrupt;
+    for (index = 0; index < FUXI_HAPTIC_FIFO_MAX_SAMPLES; index++)
+        if (plan->sample_codes[index] != encoded.sample_codes[index]) return FuxiHapticFifoCorrupt;
+    for (index = 0; index < FUXI_HAPTIC_FIFO_MAX_CHUNKS; index++) {
+        if (plan->chunks[index].address != encoded.chunks[index].address ||
+            plan->chunks[index].length != encoded.chunks[index].length) return FuxiHapticFifoCorrupt;
+        for (byte_index = 0; byte_index < 4; byte_index++)
+            if (plan->chunks[index].bytes[byte_index] != encoded.chunks[index].bytes[byte_index])
+                return FuxiHapticFifoCorrupt;
+    }
+    return FuxiHapticFifoOk;
+}
+
+int fuxi_haptic_fifo_record_transfer(const FuxiHapticFifoPlan *plan,
+    FuxiHapticFifoJournal *journal, unsigned chunk_index,
+    int transport_result, unsigned transferred)
+{
+    unsigned index, expected_bytes = 0;
+    int result;
+    if (!plan || !journal) return FuxiHapticFifoInvalid;
+    if (journal->failed || journal->complete) return FuxiHapticFifoLocked;
+    result = fuxi_haptic_fifo_validate_plan(plan);
+    if (result) {
+        journal->failed = 1;
+        return result;
+    }
+    if (chunk_index != journal->next_chunk || chunk_index >= plan->chunk_count) {
+        journal->failed = 1;
+        return FuxiHapticFifoBounds;
+    }
+    for (index = 0; index < chunk_index; index++) expected_bytes += plan->chunks[index].length;
+    if (journal->acknowledged_bytes != expected_bytes) {
+        journal->failed = 1;
+        return FuxiHapticFifoCorrupt;
+    }
+    if (transport_result || transferred != plan->chunks[chunk_index].length) {
+        journal->failed = 1;
+        return FuxiHapticFifoPartialWrite;
+    }
+    journal->acknowledged_bytes += transferred;
+    journal->next_chunk++;
+    journal->complete = journal->next_chunk == plan->chunk_count;
+    return FuxiHapticFifoOk;
+}
+
+int fuxi_haptic_fifo_read_allowed(uint16_t address)
+{
+    const uint8_t *offsets;
+    size_t count, index;
+    switch (address & 0xff00u) {
+    case 0xf000:
+        if (address == 0xf009 || address == 0xf00a) return 1;
+        offsets = cfg_offsets;
+        count = sizeof(cfg_offsets);
+        break;
+    case 0xf100:
+        offsets = ptn_offsets;
+        count = sizeof(ptn_offsets);
+        break;
+    case 0xf200:
+        offsets = boost_offsets;
+        count = sizeof(boost_offsets);
+        break;
+    default:
+        return 0;
+    }
+    for (index = 0; index < count; index++)
+        if (offsets[index] == (address & 0xffu)) return 1;
+    return 0;
+}
+
+int fuxi_haptic_fifo_write_allowed(uint16_t address, unsigned length)
+{
+    (void)address;
+    (void)length;
+    return 0;
+}
+
+int fuxi_haptic_fifo_decode_status(uint8_t selector, uint8_t selector_xt,
+    uint8_t msb, uint8_t lsb, unsigned capacity, unsigned *fill, unsigned *empty)
+{
+    unsigned decoded_fill, decoded_empty, decoded_full;
+    if (!fill || !empty) return FuxiHapticFifoInvalid;
+    if (selector != 0x05 || selector_xt != 0x80) return FuxiHapticFifoProfileFork;
+    if (!capacity || capacity > 2048u) return FuxiHapticFifoBounds;
+    decoded_fill = ((unsigned)(msb & 0x0fu) << 8) | lsb;
+    decoded_empty = !!(msb & 0x40u);
+    decoded_full = !!(msb & 0x20u);
+    if (decoded_fill > capacity || (decoded_empty && decoded_fill) ||
+        (decoded_full && decoded_fill != capacity) || (decoded_empty && decoded_full))
+        return FuxiHapticFifoCorrupt;
+    *fill = decoded_fill;
+    *empty = decoded_empty;
+    return FuxiHapticFifoOk;
+}
+
+unsigned fuxi_haptic_fifo_independent_cutoff_verified(void)
+{
+    return 0;
+}
+
+void fuxi_haptic_fifo_init(FuxiHapticFifoState *state)
+{
+    if (state) zero_bytes(state, sizeof(*state));
+}
+
+static int check_owner(const FuxiHapticFifoIo *io, FuxiHapticFifoState *state, unsigned peripheral)
+{
+    unsigned owner = 255u;
+    if (state->owner_reads >= FUXI_HAPTIC_FIFO_MAX_OWNER_READS) return FuxiHapticFifoBounds;
+    state->owner_reads++;
+    if (io->owner(io->context, (uint16_t)(0xf000u + peripheral * 256u), &owner))
+        return FuxiHapticFifoIoError;
+    if (owner != (peripheral == 2u ? 3u : 0u)) return FuxiHapticFifoHardware;
+    return FuxiHapticFifoOk;
+}
+
+static int read_byte(const FuxiHapticFifoIo *io, FuxiHapticFifoState *state,
+    unsigned peripheral, uint8_t offset, uint8_t *value)
+{
+    uint16_t address = (uint16_t)(0xf000u + peripheral * 256u + offset);
+    uint8_t observed;
+    int result;
+    if (!fuxi_haptic_fifo_read_allowed(address) ||
+        state->reads >= FUXI_HAPTIC_FIFO_MAX_READS) return FuxiHapticFifoBounds;
+    result = check_owner(io, state, peripheral);
+    if (result) return result;
+    state->reads++;
+    observed = (uint8_t)(state->reads ^ 0xa5u);
+    if (io->read(io->context, address, &observed)) return FuxiHapticFifoIoError;
+    *value = observed;
+    return FuxiHapticFifoOk;
+}
+
+static int take_snapshot(const FuxiHapticFifoIo *io,
+    FuxiHapticFifoState *state, FuxiHapticFifoSnapshot *snapshot)
+{
+    const uint8_t *offsets;
+    size_t count, index;
+    unsigned peripheral;
+    uint8_t selector = 0xff, selector_xt = 0xff;
+    int result;
+    zero_bytes(snapshot, sizeof(*snapshot));
+    for (peripheral = 0; peripheral < 3; peripheral++) {
+        if (peripheral == 0) { offsets = cfg_offsets; count = sizeof(cfg_offsets); }
+        else if (peripheral == 1) { offsets = ptn_offsets; count = sizeof(ptn_offsets); }
+        else { offsets = boost_offsets; count = sizeof(boost_offsets); }
+        for (index = 0; index < count; index++) {
+            result = read_byte(io, state, peripheral, offsets[index],
+                &snapshot->raw[peripheral][offsets[index]]);
+            if (result) return result;
+        }
+    }
+    result = read_byte(io, state, 0, 0x09, &snapshot->raw[0][0x09]);
+    if (result) return result;
+    result = read_byte(io, state, 0, 0x0a, &snapshot->raw[0][0x0a]);
+    if (result) return result;
+    result = read_byte(io, state, 0, 0x70, &selector);
+    if (result) return result;
+    result = read_byte(io, state, 0, 0x71, &selector_xt);
+    if (result) return result;
+    if (selector != snapshot->raw[0][0x70] || selector_xt != snapshot->raw[0][0x71])
+        return FuxiHapticFifoUnstable;
+    for (peripheral = 0; peripheral < 3; peripheral++) {
+        result = check_owner(io, state, peripheral);
+        if (result) return result;
+    }
+    return FuxiHapticFifoOk;
+}
+
+static int validate_snapshot(FuxiHapticFifoSnapshot *snapshot)
+{
+    const uint8_t *cfg = snapshot->raw[0];
+    const uint8_t *ptn = snapshot->raw[1];
+    const uint8_t *boost = snapshot->raw[2];
+    int result;
+    if (cfg[0x00] || cfg[0x01] != 4 || cfg[0x04] != 0x15 || cfg[0x05] != 0x0a ||
+        ptn[0x00] || ptn[0x01] != 4 || ptn[0x04] != 0x15 || ptn[0x05] != 0x0b ||
+        boost[0x00] != 2 || boost[0x01] || boost[0x04] != 0x31 || boost[0x05] != 1 ||
+        (boost[0x41] & 0xe0u) != 0xe0u) return FuxiHapticFifoHardware;
+    if (cfg[0x0c]) return FuxiHapticFifoFault;
+    if ((cfg[0x0b] & 3u) || (cfg[0x4c] & 0x80u) || (boost[0x46] & 0x80u) ||
+        (boost[0x0b] & 1u) || !(ptn[0x08] & 1u) || ptn[0x2d]) return FuxiHapticFifoBusy;
+    snapshot->tlra_us = (((unsigned)cfg[0x5c] & 0x0fu) * 256u + cfg[0x5d]) * 5u;
+    snapshot->vmax_mv = (unsigned)cfg[0x48] * 50u;
+    if (snapshot->tlra_us != FUXI_HAPTIC_FIFO_PROFILE_TLRA_CODE * 5u ||
+        (ptn[0x24] & 0x0fu) || (cfg[0x72] & 0x0cu) != 4u ||
+        cfg[0x49] != 1 || cfg[0x63] != 0x89 || (cfg[0x68] & 3u))
+        return FuxiHapticFifoProfileFork;
+    if (!(ptn[0xa0] & 0x80u)) return FuxiHapticFifoHardware;
+    snapshot->fifo_capacity = ((unsigned)(ptn[0xa0] & 0x0fu) + 1u) * 128u;
+    if (cfg[0x70] == 5 && cfg[0x71] == 0x80) {
+        result = fuxi_haptic_fifo_decode_status(cfg[0x70], cfg[0x71], cfg[0x09], cfg[0x0a],
+            snapshot->fifo_capacity, &snapshot->fifo_fill, &snapshot->fifo_empty);
+        if (result) return result;
+        snapshot->fifo_status_available = 1;
+        if (snapshot->fifo_fill) return FuxiHapticFifoBusy;
+    }
+    return FuxiHapticFifoOk;
+}
+
+static int fail_state(FuxiHapticFifoState *state, int result)
+{
+    state->phase = FuxiHapticFifoFailed;
+    state->result = result;
+    return result;
+}
+
+int fuxi_haptic_fifo_prepare(const FuxiHapticFifoIo *io,
+    const FuxiHapticFifoRequest *request, FuxiHapticFifoState *state)
+{
+    FuxiHapticFifoSnapshot second;
+    unsigned peripheral, offset;
+    int result;
+    if (!io || !request || !state || !io->owner || !io->read) return FuxiHapticFifoInvalid;
+    if (state->phase != FuxiHapticFifoNew || state->reads || state->owner_reads)
+        return FuxiHapticFifoLocked;
+    result = fuxi_haptic_fifo_encode(request->sample_codes, request->sample_count,
+        request->vmax_mv, request->tlra_code, &state->plan);
+    if (result) return fail_state(state, result);
+    state->phase = FuxiHapticFifoEncoded;
+    result = take_snapshot(io, state, &state->snapshot);
+    if (result) return fail_state(state, result);
+    result = take_snapshot(io, state, &second);
+    if (result) return fail_state(state, result);
+    for (peripheral = 0; peripheral < 3; peripheral++)
+        for (offset = 0; offset < 256; offset++)
+            if (state->snapshot.raw[peripheral][offset] != second.raw[peripheral][offset])
+                return fail_state(state, FuxiHapticFifoUnstable);
+    result = fuxi_haptic_fifo_validate_plan(&state->plan);
+    if (result) return fail_state(state, result);
+    result = validate_snapshot(&state->snapshot);
+    if (result) return fail_state(state, result);
+    if (state->plan.tlra_code * 5u != state->snapshot.tlra_us)
+        return fail_state(state, FuxiHapticFifoProfileFork);
+    state->phase = FuxiHapticFifoProbed;
+    state->probed = 1;
+    state->blockers = FuxiHapticFifoBlockActiveGate | FuxiHapticFifoBlockIndependentCutoff |
+        FuxiHapticFifoBlockExternalRoute | FuxiHapticFifoBlockClockProof;
+    if (state->snapshot.vmax_mv != state->plan.vmax_mv) state->blockers |= FuxiHapticFifoNeedsVmaxStage;
+    if (state->snapshot.raw[0][0x4a] & 4u) state->blockers |= FuxiHapticFifoNeedsHoldDisable;
+    if (state->snapshot.raw[1][0x2a] & 0x0fu) state->blockers |= FuxiHapticFifoNeedsThresholdStage;
+    state->phase = FuxiHapticFifoRejected;
+    state->result = FuxiHapticFifoGateClosed;
+    return state->result;
+}
+
+void fuxi_haptic_fifo_cleanup(FuxiHapticFifoState *state)
+{
+    if (!state) return;
+    zero_bytes(&state->plan, sizeof(state->plan));
+    if (state->phase == FuxiHapticFifoNew || state->phase == FuxiHapticFifoEncoded ||
+        state->phase == FuxiHapticFifoProbed) {
+        state->phase = FuxiHapticFifoFailed;
+        state->result = FuxiHapticFifoLocked;
+    }
+}
diff --git a/xnu/fuxi-haptic-prep/fuxi_haptic_fifo.h b/xnu/fuxi-haptic-prep/fuxi_haptic_fifo.h
new file mode 100644
index 0000000000000000000000000000000000000000..0d62be79b7208bbf4f0ecc4888ab91d55583f4e0
--- /dev/null
+++ b/xnu/fuxi-haptic-prep/fuxi_haptic_fifo.h
@@ -0,0 +1,137 @@
+#ifndef FUXI_HAPTIC_FIFO_H
+#define FUXI_HAPTIC_FIFO_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define FUXI_HAPTIC_FIFO_ACTIVE_GATE 0u
+#define FUXI_HAPTIC_FIFO_MAX_SAMPLES 32u
+#define FUXI_HAPTIC_FIFO_MAX_CHUNKS 10u
+#define FUXI_HAPTIC_FIFO_TAIL_ZEROS 4u
+#define FUXI_HAPTIC_FIFO_MAX_CODE 0x20u
+#define FUXI_HAPTIC_FIFO_MAX_VMAX_MV 1200u
+#define FUXI_HAPTIC_FIFO_MAX_READS 104u
+#define FUXI_HAPTIC_FIFO_MAX_OWNER_READS 110u
+#define FUXI_HAPTIC_FIFO_MAX_WRITES 0u
+#define FUXI_HAPTIC_FIFO_MAX_REFILLS 0u
+#define FUXI_HAPTIC_FIFO_MAX_STOP_POLLS 0u
+#define FUXI_HAPTIC_FIFO_PROFILE_TLRA_CODE 1142u
+
+typedef enum {
+    FuxiHapticFifoOk = 0,
+    FuxiHapticFifoInvalid = -1,
+    FuxiHapticFifoBounds = -2,
+    FuxiHapticFifoHardware = -3,
+    FuxiHapticFifoIoError = -4,
+    FuxiHapticFifoUnstable = -5,
+    FuxiHapticFifoBusy = -6,
+    FuxiHapticFifoFault = -7,
+    FuxiHapticFifoProfileFork = -8,
+    FuxiHapticFifoCorrupt = -9,
+    FuxiHapticFifoPartialWrite = -10,
+    FuxiHapticFifoGateClosed = -11,
+    FuxiHapticFifoLocked = -12
+} FuxiHapticFifoResult;
+
+typedef enum {
+    FuxiHapticFifoNew,
+    FuxiHapticFifoEncoded,
+    FuxiHapticFifoProbed,
+    FuxiHapticFifoRejected,
+    FuxiHapticFifoFailed
+} FuxiHapticFifoPhase;
+
+typedef enum {
+    FuxiHapticFifoEvidenceNone,
+    FuxiHapticFifoEvidenceHap525HoldOnly,
+    FuxiHapticFifoEvidenceHap530AutoStopOnly
+} FuxiHapticFifoEvidence;
+
+enum {
+    FuxiHapticFifoBlockActiveGate = 1u << 0,
+    FuxiHapticFifoBlockIndependentCutoff = 1u << 1,
+    FuxiHapticFifoBlockExternalRoute = 1u << 2,
+    FuxiHapticFifoBlockClockProof = 1u << 3,
+    FuxiHapticFifoNeedsVmaxStage = 1u << 4,
+    FuxiHapticFifoNeedsHoldDisable = 1u << 5,
+    FuxiHapticFifoNeedsThresholdStage = 1u << 6
+};
+
+typedef struct {
+    uint16_t address;
+    unsigned length;
+    uint8_t bytes[4];
+} FuxiHapticFifoChunk;
+
+typedef struct {
+    unsigned sample_count;
+    unsigned chunk_count;
+    unsigned vmax_mv;
+    unsigned nominal_data_us;
+    uint16_t tlra_code;
+    uint8_t sample_codes[FUXI_HAPTIC_FIFO_MAX_SAMPLES];
+    FuxiHapticFifoChunk chunks[FUXI_HAPTIC_FIFO_MAX_CHUNKS];
+} FuxiHapticFifoPlan;
+
+typedef struct {
+    unsigned next_chunk;
+    unsigned acknowledged_bytes;
+    unsigned failed;
+    unsigned complete;
+} FuxiHapticFifoJournal;
+
+typedef struct {
+    uint8_t raw[3][256];
+    unsigned tlra_us;
+    unsigned vmax_mv;
+    unsigned fifo_capacity;
+    unsigned fifo_status_available;
+    unsigned fifo_fill;
+    unsigned fifo_empty;
+} FuxiHapticFifoSnapshot;
+
+typedef struct {
+    void *context;
+    int (*owner)(void *context, uint16_t base, unsigned *owner);
+    int (*read)(void *context, uint16_t address, uint8_t *value);
+    int (*write)(void *context, uint16_t address, const uint8_t *bytes,
+        unsigned length, unsigned *transferred);
+} FuxiHapticFifoIo;
+
+typedef struct {
+    const uint8_t *sample_codes;
+    unsigned sample_count;
+    unsigned vmax_mv;
+    uint16_t tlra_code;
+    unsigned active_requested;
+    FuxiHapticFifoEvidence evidence;
+} FuxiHapticFifoRequest;
+
+typedef struct {
+    FuxiHapticFifoPhase phase;
+    FuxiHapticFifoPlan plan;
+    FuxiHapticFifoSnapshot snapshot;
+    unsigned reads;
+    unsigned owner_reads;
+    unsigned probed;
+    unsigned blockers;
+    int result;
+} FuxiHapticFifoState;
+
+int fuxi_haptic_fifo_encode(const uint8_t *codes, unsigned count,
+    unsigned vmax_mv, uint16_t tlra_code, FuxiHapticFifoPlan *plan);
+int fuxi_haptic_fifo_validate_plan(const FuxiHapticFifoPlan *plan);
+int fuxi_haptic_fifo_record_transfer(const FuxiHapticFifoPlan *plan,
+    FuxiHapticFifoJournal *journal, unsigned chunk_index,
+    int transport_result, unsigned transferred);
+int fuxi_haptic_fifo_read_allowed(uint16_t address);
+int fuxi_haptic_fifo_write_allowed(uint16_t address, unsigned length);
+int fuxi_haptic_fifo_decode_status(uint8_t selector, uint8_t selector_xt,
+    uint8_t msb, uint8_t lsb, unsigned capacity, unsigned *fill, unsigned *empty);
+unsigned fuxi_haptic_fifo_independent_cutoff_verified(void);
+void fuxi_haptic_fifo_init(FuxiHapticFifoState *state);
+int fuxi_haptic_fifo_prepare(const FuxiHapticFifoIo *io,
+    const FuxiHapticFifoRequest *request, FuxiHapticFifoState *state);
+void fuxi_haptic_fifo_cleanup(FuxiHapticFifoState *state);
+
+#endif
diff --git a/xnu/fuxi-haptic-prep/test_fifo.c b/xnu/fuxi-haptic-prep/test_fifo.c
new file mode 100644
index 0000000000000000000000000000000000000000..d69bfaab0b7f42664204fb1ed741344de60f46ef
--- /dev/null
+++ b/xnu/fuxi-haptic-prep/test_fifo.c
@@ -0,0 +1,550 @@
+#include "fuxi_haptic_fifo.h"
+
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static unsigned checks;
+
+static const uint16_t expected_read_addresses[] = {
+    0xf000, 0xf001, 0xf002, 0xf003, 0xf004, 0xf005, 0xf00b, 0xf00c,
+    0xf046, 0xf048, 0xf049, 0xf04a, 0xf04b, 0xf04c, 0xf04d, 0xf04e,
+    0xf050, 0xf051, 0xf05c, 0xf05d, 0xf063, 0xf068, 0xf070, 0xf071, 0xf072,
+    0xf100, 0xf101, 0xf102, 0xf103, 0xf104, 0xf105, 0xf108, 0xf109,
+    0xf124, 0xf12a, 0xf12d, 0xf130, 0xf131, 0xf1a0,
+    0xf200, 0xf201, 0xf202, 0xf203, 0xf204, 0xf205, 0xf20b, 0xf241, 0xf246,
+    0xf009, 0xf00a
+};
+
+#define CHECK(condition) do { \
+    checks++; \
+    if (!(condition)) { \
+        fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); \
+        exit(1); \
+    } \
+} while (0)
+
+typedef struct {
+    uint8_t raw[3][256];
+    unsigned owners[3];
+    unsigned reads, owner_reads, writes;
+    unsigned fail_read, corrupt_read, fail_owner, change_owner, drop_owner;
+    unsigned mutate_after, short_write, drop_write, fail_write;
+    uint16_t mutate_address, drop_read_address;
+    FuxiHapticFifoState *corrupt_plan;
+} Model;
+
+static unsigned peripheral_for(uint16_t address)
+{
+    CHECK(address >= 0xf000 && address <= 0xf2ff);
+    return (address - 0xf000u) / 256u;
+}
+
+static int model_owner(void *context, uint16_t base, unsigned *owner)
+{
+    Model *model = context;
+    unsigned peripheral = peripheral_for(base);
+    CHECK((base & 0xffu) == 0);
+    model->owner_reads++;
+    if (model->owner_reads == model->fail_owner) return -1;
+    if (model->owner_reads == model->drop_owner) return 0;
+    *owner = model->owners[peripheral];
+    if (model->owner_reads == model->change_owner) *owner ^= 1u;
+    return 0;
+}
+
+static int model_read(void *context, uint16_t address, uint8_t *value)
+{
+    Model *model = context;
+    unsigned peripheral = peripheral_for(address);
+    CHECK(fuxi_haptic_fifo_read_allowed(address));
+    model->reads++;
+    if (model->reads == model->fail_read) return -1;
+    if (address == model->drop_read_address) return 0;
+    if (model->reads == model->mutate_after)
+        model->raw[peripheral_for(model->mutate_address)][model->mutate_address & 0xffu] ^= 1;
+    if (model->corrupt_plan && model->reads == 5)
+        model->corrupt_plan->plan.chunks[0].bytes[0] ^= 1;
+    *value = model->raw[peripheral][address & 0xffu];
+    if (model->reads == model->corrupt_read) *value ^= 1;
+    return 0;
+}
+
+static int model_write(void *context, uint16_t address, const uint8_t *bytes,
+    unsigned length, unsigned *transferred)
+{
+    Model *model = context;
+    (void)address;
+    (void)bytes;
+    model->writes++;
+    *transferred = model->short_write ? length - 1u : length;
+    if (model->drop_write) *transferred = length;
+    return model->fail_write ? -1 : 0;
+}
+
+static void fixture(Model *model)
+{
+    memset(model, 0, sizeof(*model));
+    model->owners[2] = 3;
+    model->raw[0][0x01] = 4;
+    model->raw[0][0x04] = 0x15;
+    model->raw[0][0x05] = 0x0a;
+    model->raw[0][0x46] = 0x80;
+    model->raw[0][0x48] = 0x1c;
+    model->raw[0][0x49] = 1;
+    model->raw[0][0x4a] = 0x84;
+    model->raw[0][0x4b] = 4;
+    model->raw[0][0x4c] = 1;
+    model->raw[0][0x4d] = 0xc8;
+    model->raw[0][0x4e] = 0xe0;
+    model->raw[0][0x50] = 0x41;
+    model->raw[0][0x5c] = 4;
+    model->raw[0][0x5d] = 0x76;
+    model->raw[0][0x63] = 0x89;
+    model->raw[0][0x68] = 0x54;
+    model->raw[0][0x72] = 4;
+    model->raw[1][0x01] = 4;
+    model->raw[1][0x04] = 0x15;
+    model->raw[1][0x05] = 0x0b;
+    model->raw[1][0x08] = 1;
+    model->raw[1][0x09] = 8;
+    model->raw[1][0xa0] = 0x84;
+    model->raw[2][0x00] = 2;
+    model->raw[2][0x04] = 0x31;
+    model->raw[2][0x05] = 1;
+    model->raw[2][0x41] = 0xe0;
+}
+
+static FuxiHapticFifoRequest request_for(const uint8_t *codes, unsigned count)
+{
+    FuxiHapticFifoRequest request;
+    memset(&request, 0, sizeof(request));
+    request.sample_codes = codes;
+    request.sample_count = count;
+    request.vmax_mv = 1200;
+    request.tlra_code = FUXI_HAPTIC_FIFO_PROFILE_TLRA_CODE;
+    return request;
+}
+
+static int prepare(Model *model, const FuxiHapticFifoRequest *request, FuxiHapticFifoState *state)
+{
+    uint8_t before[3][256];
+    FuxiHapticFifoIo io = {model, model_owner, model_read, model_write};
+    int result;
+    memcpy(before, model->raw, sizeof(before));
+    result = fuxi_haptic_fifo_prepare(&io, request, state);
+    CHECK(model->writes == 0);
+    CHECK(model->reads <= FUXI_HAPTIC_FIFO_MAX_READS);
+    CHECK(model->owner_reads <= FUXI_HAPTIC_FIFO_MAX_OWNER_READS);
+    CHECK(!memcmp(before[2], model->raw[2], sizeof(before[2])));
+    if (!model->mutate_after) CHECK(!memcmp(before, model->raw, sizeof(before)));
+    CHECK(!fuxi_haptic_fifo_independent_cutoff_verified());
+    return result;
+}
+
+static void check_locked(Model *model, const FuxiHapticFifoRequest *request, FuxiHapticFifoState *state)
+{
+    unsigned reads = model->reads, owners = model->owner_reads;
+    CHECK(prepare(model, request, state) == FuxiHapticFifoLocked);
+    CHECK(model->reads == reads && model->owner_reads == owners);
+    fuxi_haptic_fifo_cleanup(state);
+    fuxi_haptic_fifo_cleanup(state);
+    CHECK(state->plan.sample_count == 0 && state->plan.chunk_count == 0);
+    CHECK(prepare(model, request, state) == FuxiHapticFifoLocked);
+    CHECK(model->reads == reads && model->owner_reads == owners);
+}
+
+static void test_encoding_and_journal(void)
+{
+    uint8_t codes[32], unpacked[32];
+    FuxiHapticFifoPlan plan, corrupted;
+    FuxiHapticFifoJournal journal;
+    unsigned count, index, chunk_index, byte_index, cursor, transferred;
+    for (count = 5; count <= 32; count++) {
+        for (index = 0; index < 32; index++) codes[index] = (uint8_t)(index % 33u);
+        for (index = count - 4; index < count; index++) codes[index] = 0;
+        CHECK(fuxi_haptic_fifo_encode(codes, count, 1200, 1142, &plan) == 0);
+        CHECK(fuxi_haptic_fifo_validate_plan(&plan) == 0);
+        CHECK(plan.chunk_count == count / 4u + count % 4u);
+        CHECK(plan.nominal_data_us == count * 5710u);
+        cursor = 0;
+        memset(&journal, 0, sizeof(journal));
+        for (chunk_index = 0; chunk_index < plan.chunk_count; chunk_index++) {
+            const FuxiHapticFifoChunk *chunk = &plan.chunks[chunk_index];
+            CHECK(chunk->address == (chunk_index < count / 4u ? 0xf120 : 0xf12c));
+            CHECK(chunk->length == (chunk_index < count / 4u ? 4u : 1u));
+            for (byte_index = 0; byte_index < chunk->length; byte_index++)
+                unpacked[cursor++] = chunk->bytes[byte_index];
+            CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, chunk_index, 0, chunk->length) == 0);
+        }
+        CHECK(cursor == count && !memcmp(unpacked, codes, count));
+        CHECK(journal.complete && journal.acknowledged_bytes == count);
+        CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, 0, 0, 4) == FuxiHapticFifoLocked);
+        for (chunk_index = 0; chunk_index < plan.chunk_count; chunk_index++) {
+            for (transferred = 0; transferred <= plan.chunks[chunk_index].length + 1u; transferred++) {
+                if (transferred == plan.chunks[chunk_index].length) continue;
+                memset(&journal, 0, sizeof(journal));
+                for (index = 0; index < chunk_index; index++)
+                    CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, index, 0, plan.chunks[index].length) == 0);
+                cursor = journal.acknowledged_bytes;
+                CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, chunk_index, 0, transferred) == FuxiHapticFifoPartialWrite);
+                CHECK(journal.failed && journal.acknowledged_bytes == cursor);
+                CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, chunk_index, 0, plan.chunks[chunk_index].length) == FuxiHapticFifoLocked);
+            }
+            memset(&journal, 0, sizeof(journal));
+            for (index = 0; index < chunk_index; index++)
+                CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, index, 0, plan.chunks[index].length) == 0);
+            CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, chunk_index, -1, plan.chunks[chunk_index].length) == FuxiHapticFifoPartialWrite);
+        }
+        for (chunk_index = 0; chunk_index < FUXI_HAPTIC_FIFO_MAX_CHUNKS; chunk_index++) {
+            corrupted = plan;
+            corrupted.chunks[chunk_index].address ^= 1;
+            CHECK(fuxi_haptic_fifo_validate_plan(&corrupted) == FuxiHapticFifoCorrupt);
+            corrupted = plan;
+            corrupted.chunks[chunk_index].length = UINT_MAX;
+            CHECK(fuxi_haptic_fifo_validate_plan(&corrupted) == FuxiHapticFifoCorrupt);
+            for (byte_index = 0; byte_index < 4; byte_index++) {
+                corrupted = plan;
+                corrupted.chunks[chunk_index].bytes[byte_index] ^= 1;
+                CHECK(fuxi_haptic_fifo_validate_plan(&corrupted) == FuxiHapticFifoCorrupt);
+            }
+        }
+        for (index = 0; index < 32; index++) {
+            corrupted = plan;
+            corrupted.sample_codes[index] ^= 1;
+            CHECK(fuxi_haptic_fifo_validate_plan(&corrupted) == FuxiHapticFifoCorrupt);
+        }
+    }
+    corrupted = plan;
+    corrupted.sample_count = UINT_MAX;
+    CHECK(fuxi_haptic_fifo_validate_plan(&corrupted) == FuxiHapticFifoCorrupt);
+    corrupted = plan;
+    corrupted.chunk_count = UINT_MAX;
+    CHECK(fuxi_haptic_fifo_validate_plan(&corrupted) == FuxiHapticFifoCorrupt);
+    corrupted = plan;
+    corrupted.nominal_data_us++;
+    CHECK(fuxi_haptic_fifo_validate_plan(&corrupted) == FuxiHapticFifoCorrupt);
+    memset(&journal, 0, sizeof(journal));
+    CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, 1, 0, 4) == FuxiHapticFifoBounds);
+    memset(&journal, 0, sizeof(journal));
+    journal.acknowledged_bytes = UINT_MAX;
+    CHECK(fuxi_haptic_fifo_record_transfer(&plan, &journal, 0, 0, 4) == FuxiHapticFifoCorrupt);
+    memset(&journal, 0, sizeof(journal));
+    CHECK(fuxi_haptic_fifo_record_transfer(&corrupted, &journal, 0, 0, 4) == FuxiHapticFifoCorrupt);
+    CHECK(journal.failed);
+}
+
+static void test_bounds(void)
+{
+    uint8_t codes[32] = {0x20, 0x20, 0x20, 0x20};
+    FuxiHapticFifoPlan plan, before;
+    static const unsigned counts[] = {0, 1, 4, 33, UINT_MAX};
+    static const unsigned voltages[] = {0, 1, 49, 51, 1201, UINT_MAX};
+    unsigned index, code;
+    memset(&plan, 0xa5, sizeof(plan));
+    before = plan;
+    for (index = 0; index < sizeof(counts) / sizeof(counts[0]); index++) {
+        CHECK(fuxi_haptic_fifo_encode(codes, counts[index], 1200, 1142, &plan) == FuxiHapticFifoBounds);
+        CHECK(!memcmp(&plan, &before, sizeof(plan)));
+    }
+    for (index = 0; index < sizeof(voltages) / sizeof(voltages[0]); index++)
+        CHECK(fuxi_haptic_fifo_encode(codes, 8, voltages[index], 1142, &plan) == FuxiHapticFifoBounds);
+    CHECK(fuxi_haptic_fifo_encode(codes, 8, 1200, 0, &plan) == FuxiHapticFifoBounds);
+    CHECK(fuxi_haptic_fifo_encode(codes, 8, 1200, 4096, &plan) == FuxiHapticFifoBounds);
+    for (code = 33; code < 256; code++) {
+        codes[0] = (uint8_t)code;
+        CHECK(fuxi_haptic_fifo_encode(codes, 8, 1200, 1142, &plan) == FuxiHapticFifoBounds);
+    }
+    codes[0] = 32;
+    codes[7] = 1;
+    CHECK(fuxi_haptic_fifo_encode(codes, 8, 1200, 1142, &plan) == FuxiHapticFifoInvalid);
+    codes[7] = 0;
+    CHECK(fuxi_haptic_fifo_encode(codes, 8, 50, 1, &plan) == 0 && plan.nominal_data_us == 40);
+    CHECK(fuxi_haptic_fifo_encode(codes, 32, 1200, 4095, &plan) == 0 && plan.nominal_data_us == 655200);
+    CHECK(fuxi_haptic_fifo_encode(NULL, 8, 1200, 1142, &plan) == FuxiHapticFifoInvalid);
+    CHECK(fuxi_haptic_fifo_encode(codes, 8, 1200, 1142, NULL) == FuxiHapticFifoInvalid);
+    CHECK(fuxi_haptic_fifo_validate_plan(NULL) == FuxiHapticFifoInvalid);
+}
+
+static void test_status(void)
+{
+    unsigned fill = UINT_MAX, empty = UINT_MAX;
+    CHECK(fuxi_haptic_fifo_decode_status(0, 0, 0x40, 0, 640, &fill, &empty) == FuxiHapticFifoProfileFork);
+    CHECK(fill == UINT_MAX && empty == UINT_MAX);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0, 0x40, 0, 640, &fill, &empty) == FuxiHapticFifoProfileFork);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0x40, 1, 640, &fill, &empty) == FuxiHapticFifoCorrupt);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0x60, 0, 640, &fill, &empty) == FuxiHapticFifoCorrupt);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0x20, 0, 640, &fill, &empty) == FuxiHapticFifoCorrupt);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0x0f, 0xff, 640, &fill, &empty) == FuxiHapticFifoCorrupt);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0, 0, 2049, &fill, &empty) == FuxiHapticFifoBounds);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0, 0, 0, &fill, &empty) == FuxiHapticFifoBounds);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0x22, 0x80, 640, &fill, &empty) == 0 && fill == 640 && !empty);
+    CHECK(fuxi_haptic_fifo_decode_status(5, 0x80, 0x40, 0, 640, &fill, &empty) == 0 && !fill && empty);
+    CHECK(!fuxi_haptic_fifo_independent_cutoff_verified());
+}
+
+static void test_preflight_and_faults(void)
+{
+    uint8_t codes[8] = {0x20, 0x20, 0x20, 0x20, 0, 0, 0, 0};
+    FuxiHapticFifoRequest request = request_for(codes, 8);
+    FuxiHapticFifoState state;
+    Model model;
+    unsigned index, evidence;
+    static const uint16_t identities[] = {
+        0xf000, 0xf001, 0xf004, 0xf005, 0xf100, 0xf101, 0xf104, 0xf105,
+        0xf200, 0xf201, 0xf204, 0xf205, 0xf241
+    };
+    static const uint16_t busy_addresses[] = {0xf00b, 0xf04c, 0xf246, 0xf20b, 0xf108, 0xf12d};
+    static const uint8_t busy_values[] = {3, 0x81, 0x80, 1, 0, 1};
+    static const uint16_t forks[] = {0xf124, 0xf072, 0xf05d, 0xf049, 0xf063, 0xf068};
+    fixture(&model);
+    fuxi_haptic_fifo_init(&state);
+    CHECK(prepare(&model, &request, &state) == FuxiHapticFifoGateClosed);
+    CHECK(state.probed && state.phase == FuxiHapticFifoRejected);
+    CHECK(state.snapshot.tlra_us == 5710 && state.snapshot.vmax_mv == 1400);
+    CHECK(state.snapshot.fifo_capacity == 640 && !state.snapshot.fifo_status_available);
+    CHECK((state.blockers & 0x3fu) == 0x3fu);
+    CHECK(model.reads == 104 && model.owner_reads == 110);
+    check_locked(&model, &request, &state);
+    for (evidence = 0; evidence <= 3; evidence++) {
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        request.active_requested = UINT_MAX;
+        request.evidence = (FuxiHapticFifoEvidence)evidence;
+        model.short_write = model.drop_write = model.fail_write = 1;
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoGateClosed);
+        CHECK(state.blockers & FuxiHapticFifoBlockIndependentCutoff);
+        CHECK(state.blockers & FuxiHapticFifoBlockExternalRoute);
+    }
+    for (index = 1; index <= 104; index++) {
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        model.fail_read = index;
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoIoError);
+        CHECK(model.reads == index);
+        check_locked(&model, &request, &state);
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        model.corrupt_read = index;
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoUnstable);
+        check_locked(&model, &request, &state);
+    }
+    for (index = 1; index <= 110; index++) {
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        model.fail_owner = index;
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoIoError);
+        check_locked(&model, &request, &state);
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        model.change_owner = index;
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoHardware);
+        check_locked(&model, &request, &state);
+    }
+    for (index = 0; index < sizeof(identities) / sizeof(identities[0]); index++) {
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        model.raw[peripheral_for(identities[index])][identities[index] & 0xffu] ^= 0x80;
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoHardware);
+    }
+    for (index = 0; index < sizeof(busy_addresses) / sizeof(busy_addresses[0]); index++) {
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        model.raw[peripheral_for(busy_addresses[index])][busy_addresses[index] & 0xffu] = busy_values[index];
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoBusy);
+    }
+    for (index = 0; index < sizeof(forks) / sizeof(forks[0]); index++) {
+        fixture(&model);
+        fuxi_haptic_fifo_init(&state);
+        model.raw[peripheral_for(forks[index])][forks[index] & 0xffu] ^= 1;
+        if (forks[index] == 0xf072) model.raw[0][0x72] = 8;
+        CHECK(prepare(&model, &request, &state) == FuxiHapticFifoProfileFork);
