++    wr(g, GENI_RX_PACK0, 0x7f8fe); wr(g, GENI_RX_PACK1, 0xffefe);
++    wr(g, GENI_BYTE_GRAN, 0);
++    wr(g, GENI_TX_WATERMARK, 0);
