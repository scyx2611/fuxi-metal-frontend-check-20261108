+static void stage(int value) { gStage = value; }
+static void fail(int step, int error)
+{
+    gStage = -step;
+    gError = error;
+    printf("FUXI ADSP: failed at stage %d error %d (scm x0=%lld x1=%#llx)\n", step, error, (long long)gScmX0,
+        (unsigned long long)gScmX1);
+}
