+def configure_ram(layout):
+    global BANK_SIZE, GPU_BASE, MEM_SIZE
+    banks = {'full': 0x140000000, '9g': 0x240000000}
+    if layout not in banks:
+        raise ValueError('unsupported Fuxi RAM layout')
