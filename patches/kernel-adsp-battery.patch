+/* ---- secure world calls ---- */
+struct scm_result { int64_t x0; uint64_t x1; };
+static struct scm_result scm(uint32_t command, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c)
+{
+    struct scm_result result = {-1, 0};
+    for (unsigned busy = 0; busy < 20; ++busy) {
+        uint64_t function = qcom_scm_fn(QCOM_SCM_SVC_PIL, command), session = 0;
+        unsigned resumes = 0;
+        for (;;) {
+            register uint64_t x0 __asm__("x0") = function, x1 __asm__("x1") = arginfo, x2 __asm__("x2") = a, x3 __asm__("x3") = b,
+                x4 __asm__("x4") = c, x5 __asm__("x5") = 0, x6 __asm__("x6") = session, x7 __asm__("x7") = 0;
+            __asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+                :: "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+            result.x0 = (int64_t)x0;
+            result.x1 = x1;
+            if ((int64_t)x0 != QCOM_SCM_INTERRUPTED || ++resumes > 100000) break;
+            function = QCOM_SCM_INTERRUPTED; /* resume the interrupted call in its session */
+            session = x6;
+        }
+        if (result.x0 != QCOM_SCM_V2_EBUSY) break;
+        IOSleep(30);
+    }
+    gScmX0 = result.x0;
+    gScmX1 = result.x1;
+    return result;
+}
+static int scmOk(struct scm_result r) { return r.x0 == 0 && r.x1 == 0; }
+
+/* ---- a firmware image: parsed from its file, metadata handed over, segments written into the carveout ---- */
+struct fa_image {
+    void *file;
+    uint64_t size;
+    QcomMdtImage mdt;
+    vm_offset_t meta;
+    vm_size_t meta_bytes;
+};
+static struct fa_image gDtbImage, gAdspImage;
+static int fileRead(void *context, uint64_t offset, void *to, size_t length) { return fuxi_adsp_fw_read(context, offset, to, length); }
+static void release(struct fa_image *image)
+{
+    if (image->file) fuxi_adsp_fw_close(image->file);
+    if (image->meta) kmem_free(kernel_map, image->meta, image->meta_bytes);
+    image->file = NULL;
+    image->meta = 0;
+}
+static int openImage(struct fa_image *image, const char *name)
+{
+    int rc = fuxi_adsp_fw_open(name, &image->file, &image->size);
+    if (rc) { image->file = NULL; return rc; }
+    rc = qcom_mdt_parse(&image->mdt, image->size, fileRead, image->file);
+    return rc ? 1000 - rc : 0;
+}
+/* init_image with the metadata in physically contiguous memory, then the memory setup of a relocatable image. */
+static int authenticateHeader(struct fa_image *image, uint32_t pas, uint64_t base)
+{
+    const uint64_t bytes = qcom_mdt_metadata_size(&image->mdt);
+    vm_offset_t va = 0;
+    if (!bytes || bytes > 1024 * 1024) return -22;
+    image->meta_bytes = round_page((vm_size_t)bytes);
+    if (kmem_alloc_contig(kernel_map, &va, image->meta_bytes, PAGE_MASK, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_NOPAGEWAIT,
+        VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+        return -12;
+    image->meta = va;
+    if (qcom_mdt_metadata(&image->mdt, fileRead, image->file, (uint8_t *)va, bytes)) return -5;
+    CleanPoC_DcacheRegion_Force(va, (unsigned)image->meta_bytes);
+    const ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+    if (!pn) return -14;
+    const uint64_t phys = ptoa_64(pn);
+    if (!scmOk(scm(QCOM_SCM_PAS_INIT_IMAGE, qcom_scm_args(2, QCOM_SCM_VAL, QCOM_SCM_RW, 0), pas, phys, 0))) return -1;
+    if (image->mdt.relocatable &&
+        !scmOk(scm(QCOM_SCM_PAS_MEM_SETUP, qcom_scm_args(3, 0, 0, 0), pas, base, qcom_mdt_span(&image->mdt))))
+        return -2;
+    return 0;
+}
+static int loadSegments(struct fa_image *image, uint64_t base, uint64_t size)
+{
+    struct fa_window region = {base, (vm_size_t)size, 0};
+    const size_t chunk = 256 * 1024;
+    if (fa_map(&region, VM_WIMG_WCOMB) != KERN_SUCCESS) return -12;
+    uint8_t *bounce = kalloc_data(chunk, Z_WAITOK);
+    int rc = bounce ? 0 : -12;
+    for (unsigned i = 0; !rc && i < image->mdt.count; ++i) {
+        const QcomMdtSegment *s = &image->mdt.segment[i];
+        uint64_t at = 0;
+        if (!s->load) continue;
+        if (qcom_mdt_place(&image->mdt, i, base, size, &at)) { rc = -7; break; }
+        uint8_t *to = (uint8_t *)region.va + at;
+        for (uint64_t done = 0; !rc && done < s->file_size;) {
+            const size_t n = s->file_size - done < chunk ? (size_t)(s->file_size - done) : chunk;
+            if (fuxi_adsp_fw_read(image->file, s->file_offset + done, bounce, n)) { rc = -5; break; }
+            memcpy(to + done, bounce, n);
+            done += n;
+        }
+        if (!rc && s->memory_size > s->file_size) bzero(to + s->file_size, (size_t)(s->memory_size - s->file_size));
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+    if (bounce) kfree_data(bounce, chunk);
+    fa_unmap(&region);
+    return rc;
+}
+
+/* ---- events ---- */
+static void serviceSmp2p(void)
+{
+    if (!gP2p.in) {
+        volatile uint8_t *in = item(FA_ITEM_IN, NULL);
+        if (!in) return;
+        gP2p.in = (volatile uint32_t *)in;
+    }
+    uint32_t value = 0, changed = 0;
+    if (qcom_smp2p_service(&gP2p, "slave-kernel", &value, &changed)) kickSmp2p();
+    if (value != gSlave || !gSlaveKnown) printf("FUXI ADSP: slave-kernel %#x -> %#x\n", gSlave, value);
+    gSlave = value;
+    gSlaveKnown = 1;
+    if (changed & value & FA_FATAL) readCrashReason();
+    if ((value & FA_HANDOVER) && !gHandedOver) {
+        gHandedOver = 1;
+        vote(0, 0); /* the DSP holds its own votes now */
+    }
+}
+
+static void applyClients(void);
+static void pumpSends(void);
+static void serviceGlink(void)
+{
+    if (!gGlinkStarted) return;
+    if (!gGlink.rx.data) {
+        uint32_t size = 0;
+        volatile uint8_t *rx = item(FA_ITEM_GLINK_RX, &size);
+        if (rx) qcom_glink_set_rx(&gGlink, rx, size);
+    }
+    const uint8_t agreed = gGlink.version_agreed;
+    qcom_glink_poll(&gGlink);
+    pumpSends();
+    if (!agreed && gGlink.version_agreed) { stage(StGlink); printf("FUXI ADSP: glink version agreed\n"); }
+    for (unsigned i = 0; i < gClientCount; ++i) {
+        struct ShengAdspChannel *c = &gClients[i];
+        const uint8_t up = c->glink && c->glink->up;
+        if (up != c->was_up) {
+            c->was_up = up;
+            printf("FUXI ADSP: channel %s %s\n", c->name, up ? "up" : "down");
+            if (up) stage(StChannel);
+        }
+    }
+}
+static void service(uint32_t bits)
+{
+    if (bits & EV_AOP) qcom_qmp_step(&gQmp);
+    if (bits & (EV_SMP2P | EV_GLINK)) serviceSmp2p();
+    if (bits & (EV_GLINK | EV_SEND)) { applyClients(); serviceGlink(); }
+    if (bits) {
+        uint64_t window;
+        clock_interval_to_deadline(FA_FAST_MS, NSEC_PER_MSEC, &window);
+        gFastUntil = window;
+    }
+}
+
+/* ---- client glue (thread side) ---- */
+static void clientState(void *context, QcomGlinkChannel *channel, int up)
+{
+    (void)channel;
+    struct ShengAdspChannel *c = context;
+    if (c->client.state) c->client.state(c->context, up);
+}
+static void clientReceive(void *context, QcomGlinkChannel *channel, const uint8_t *data, uint32_t length)
+{
+    (void)channel;
+    struct ShengAdspChannel *c = context;
+    if (c->client.receive) c->client.receive(c->context, data, length);
+}
+static void applyClients(void)
+{
+    if (!gGlinkStarted) return;
+    const QcomGlinkClient glue = {clientState, clientReceive};
+    /* Channels are only appended, never removed: entries below the published count are stable without the lock. A state callback
+     * from qcom_glink_channel therefore runs without fa_client_lock held. */
+    const uint32_t count = __atomic_load_n(&gClientCount, __ATOMIC_ACQUIRE);
+    for (unsigned i = 0; i < count; ++i) {
+        struct ShengAdspChannel *c = &gClients[i];
+        if (!c->glink) c->glink = qcom_glink_channel(&gGlink, c->name, c->intent_size, c->intent_count, c->storage, &glue, c, c->initiator);
+    }
+}
+static void pumpSends(void)
+{
+    const uint32_t count = __atomic_load_n(&gClientCount, __ATOMIC_ACQUIRE);
+    for (unsigned i = 0; i < count; ++i) {
+        struct ShengAdspChannel *c = &gClients[i];
+        if (!c->glink || !c->glink->up) continue;
+        for (;;) {
+            lck_mtx_lock(&fa_client_lock);
+            if (!c->count) { lck_mtx_unlock(&fa_client_lock); break; }
+            struct fa_message *m = &c->queue[c->head];
+            lck_mtx_unlock(&fa_client_lock);
+            /* Only this thread takes messages off the queue, so m stays valid while the lock is dropped for the send. */
+            if (qcom_glink_send(&gGlink, c->glink, m->data, m->length) != QcomGlinkOk) break;
+            lck_mtx_lock(&fa_client_lock);
+            c->head = (c->head + 1) % FA_QUEUE;
+            c->count--;
+            lck_mtx_unlock(&fa_client_lock);
+        }
+    }
+}
+
+/* ---- the bring-up ---- */
+static int startDoorbells(void)
+{
+    /* Mask first: no handler here owns these level lines. */
+    fa_gic_mask(FA_INTID_IPCC);
+    fa_gic_mask(FA_INTID_RSC);
+    if (fa_gic_enabled(FA_INTID_IPCC) || fa_gic_enabled(FA_INTID_RSC)) return -16;
+    const uint32_t enable[3] = {qcom_ipcc_id(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_SMP2P),
+        qcom_ipcc_id(QCOM_IPCC_CLIENT_LPASS, QCOM_IPCC_SIGNAL_GLINK_QMP), qcom_ipcc_id(QCOM_IPCC_CLIENT_AOP, QCOM_IPCC_SIGNAL_GLINK_QMP)};
+    for (unsigned i = 0; i < 3; ++i) wr(&gIpcc, QCOM_IPCC_RECV_ENABLE, enable[i]);
+    gIpccOn = 1;
+    return 0;
+}
+/* The firmware partition may not be readable yet: a few tries with growing pauses (about two minutes in all). */
+static int openFirmware(struct fa_image *dtb, struct fa_image *adsp)
+{
+    static const uint32_t pauses[] = {1, 2, 4, 8, 16, 30, 30, 30};
+    for (unsigned i = 0;; ++i) {
+        int rc = openImage(dtb, "adsp_dtb");
+        if (!rc) {
+            rc = openImage(adsp, "adsp");
+            if (rc) release(dtb);
+        }
+        if (!rc) return 0;
+        if ((rc != ENOENT && rc != ENXIO && rc != EIO) || i == sizeof(pauses) / sizeof(pauses[0])) return rc;
+        IOSleep(pauses[i] * 1000);
+    }
+}
+static void shutdownDsp(int dtb, int adsp)
+{
+    if (adsp) scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), FA_PAS_ADSP, 0, 0);
+    if (dtb) scm(QCOM_SCM_PAS_SHUTDOWN, qcom_scm_args(1, 0, 0, 0), FA_PAS_DTB, 0, 0);
+}
+/* Runs events with fast polling until the AOSS mailbox reaches want or ms pass. */
+static int qmpUntil(int want, uint32_t ms)
+{
+    uint64_t deadline;
+    clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+    while (qcom_qmp_step(&gQmp) != want) {
+        if (gQmp.state < 0 || mach_absolute_time() >= deadline) return qcom_qmp_step(&gQmp) == want;
+        service(waitEvents(10, 1));
+    }
+    return 1;
+}
+static int start(void)
+{
+    struct fa_image *dtb = &gDtbImage, *adsp = &gAdspImage;
+    int rc = openFirmware(dtb, adsp);
+    if (rc) { fail(StFirmware, rc); return 0; }
+    printf("FUXI ADSP: firmware adsp %llu KiB, adsp_dtb %llu KiB, %u + %u segments\n", adsp->size >> 10, dtb->size >> 10,
+        adsp->mdt.count, dtb->mdt.count);
+    stage(StFirmware);
+    if (gSlaveKnown && gSlave) { fail(StFirmware, -114); release(dtb); release(adsp); return 0; } /* running already: left alone */
+
+    /* Our SMP2P item, before the DSP starts (it looks for it at boot). */
+    if ((rc = allocItem(FA_ITEM_OUT, QCOM_SMP2P_ITEM_BYTES))) { fail(StSmp2p, rc); release(dtb); release(adsp); return 0; }
+    qcom_smp2p_init_out(&gP2p, (volatile uint32_t *)item(FA_ITEM_OUT, NULL), 0, FA_REMOTE_PID);
+    gStopEntry = qcom_smp2p_add_entry(&gP2p, "master-kernel");
+    stage(StSmp2p);
+    if ((rc = startDoorbells())) { fail(StDoorbells, rc); release(dtb); release(adsp); return 0; }
+    kickSmp2p();
+    stage(StDoorbells);
+
+    qcom_qmp_init(&gQmp, (volatile uint32_t *)gAoss.va, 0x400, kickAop, NULL);
+    for (int phase = 0; phase < 4 && qcom_qmp_step(&gQmp) > 0 && gQmp.state != QcomQmpOpen; ++phase) qmpUntil(QcomQmpOpen, 1000);
+    if (gQmp.state != QcomQmpOpen) { fail(StLoadState, gQmp.state); release(dtb); release(adsp); return 0; }
+    qcom_qmp_send(&gQmp, "{class: image, res: load_state, name: adsp, val: on}");
+    if (!qmpUntil(QcomQmpOpen, 1000)) { qcom_qmp_abandon(&gQmp); fail(StLoadState, -60); release(dtb); release(adsp); return 0; }
+    stage(StLoadState);
+    printf("FUXI ADSP: aoss load_state adsp on\n");
+
+    /* A copy of the command database, held only while the levels are looked up. */
+    uint8_t *db = kalloc_data(FA_CMD_DB_SIZE, Z_WAITOK);
+    uint32_t lcx = 0, lmx = 0;
+    rc = !db || !readCmdDb(db) || qcom_cmd_db_find(db, FA_CMD_DB_SIZE, "lcx.lvl", &gLcx) ||
+        qcom_cmd_db_find(db, FA_CMD_DB_SIZE, "lmx.lvl", &gLmx) || qcom_rpmh_level_index(&gLcx, 0xffffffffu, &lcx) ||
+        qcom_rpmh_level_index(&gLmx, 0xffffffffu, &lmx);
+    if (db) kfree_data(db, FA_CMD_DB_SIZE);
+    if (rc) { fail(StRails, -2); release(dtb); release(adsp); return 0; }
+    printf("FUXI ADSP: cmd-db lcx.lvl %#x (%u levels) lmx.lvl %#x (%u levels)\n", gLcx.address, gLcx.level_count, gLmx.address,
+        gLmx.level_count);
+    if ((rc = vote(lcx, lmx))) { fail(StRails, rc); release(dtb); release(adsp); return 0; }
+    stage(StRails);
+
+    /* The DSP's devicetree image first, as its own authenticated image, then the DSP image. */
+    if ((rc = authenticateHeader(dtb, FA_PAS_DTB, FA_DTB_BASE)) || (rc = loadSegments(dtb, FA_DTB_BASE, FA_DTB_SIZE)) ||
+        (rc = scmOk(scm(QCOM_SCM_PAS_AUTH_AND_RESET, qcom_scm_args(1, 0, 0, 0), FA_PAS_DTB, 0, 0)) ? 0 : -3)) {
+        fail(StDtb, rc); vote(0, 0); release(dtb); release(adsp); return 0;
+    }
+    stage(StDtb);
+    printf("FUXI ADSP: adsp_dtb authenticated and started\n");
+    if ((rc = authenticateHeader(adsp, FA_PAS_ADSP, FA_ADSP_BASE)) || (rc = loadSegments(adsp, FA_ADSP_BASE, FA_ADSP_SIZE))) {
+        fail(StLoaded, rc); shutdownDsp(1, 0); vote(0, 0); release(dtb); release(adsp); return 0;
+    }
+    stage(StLoaded);
+    const uint64_t began = mach_absolute_time();
+    if (!scmOk(scm(QCOM_SCM_PAS_AUTH_AND_RESET, qcom_scm_args(1, 0, 0, 0), FA_PAS_ADSP, 0, 0))) {
+        fail(StStarted, -3); shutdownDsp(1, 0); vote(0, 0); release(dtb); release(adsp); return 0;
+    }
+    stage(StStarted);
+    printf("FUXI ADSP: adsp authenticated and reset; waiting for ready\n");
+    uint64_t deadline;
+    clock_interval_to_deadline(5000, NSEC_PER_MSEC, &deadline);
+    while (!(gSlave & (FA_READY | FA_FATAL)) && mach_absolute_time() < deadline) service(waitEvents(10, 1));
+    uint64_t ns = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+    release(dtb);
+    release(adsp); /* the metadata may go once the images are authenticated */
+    if (!(gSlave & FA_READY) || (gSlave & FA_FATAL)) {
+        readCrashReason();
+        fail(StReady, (gSlave & FA_FATAL) ? -5 : -60);
+        shutdownDsp(1, 1);
+        if (!gHandedOver) vote(0, 0);
+        return 0;
+    }
+    stage(StReady);
+    printf("FUXI ADSP: ready after %llu ms (slave-kernel %#x)\n", ns / 1000000u, gSlave);
+    return 1;
+}
+
+static int startGlink(void)
+{
+    int rc = allocItem(FA_ITEM_GLINK_DESC, 32);
+    if (!rc) rc = allocItem(FA_ITEM_GLINK_TX, FA_GLINK_FIFO);
+    uint32_t size = 0;
+    volatile uint8_t *desc = item(FA_ITEM_GLINK_DESC, NULL), *txf = item(FA_ITEM_GLINK_TX, &size);
+    if (rc || !desc || !txf) { fail(StGlink, rc ? rc : -2); return 0; }
+    volatile uint32_t *d = (volatile uint32_t *)desc;
+    /* Descriptor words: our FIFO's tail and head, then the DSP's FIFO's tail and head. */
+    const QcomGlinkFifo tx = {&d[1], &d[0], txf, size}, rx = {&d[3], &d[2], NULL, 0};
+    qcom_glink_init(&gGlink, tx, rx, kickGlink, NULL);
+    gGlinkStarted = 1;
+    applyClients();
+    serviceGlink();
+    return 1;
+}
+
+static void report(void)
+{
+    printf("FUXI ADSP: stage=%d ipcc=%u other=%u glink in=%u out=%u unknown_opens=%u (%s) qrtr stage=%d in=%d out=%d "
+        "locator=%d/%d dsp_node=%d services=%d [%s]\n", gStage, gIpccEvents, gIpccOther, gGlink.rx_messages, gGlink.tx_messages,
+        gGlink.unknown_opens, gGlink.unknown_names, native_qrtr_stats[0], native_qrtr_stats[1], native_qrtr_stats[4],
+        native_qrtr_stats[6], native_qrtr_stats[7], native_qrtr_stats[8], native_qrtr_stats[9], native_qrtr_text);
+}
+
+static void adspThread(void *arg, wait_result_t result)
+{
+    (void)result;
+    const unsigned mode = (unsigned)(uintptr_t)arg;
+    if (fa_map(&gSmemW, VM_WIMG_IO) != KERN_SUCCESS || fa_map(&gTcsr, VM_WIMG_IO) != KERN_SUCCESS ||
+        fa_map(&gIpcc, VM_WIMG_IO) != KERN_SUCCESS || fa_map(&gAoss, VM_WIMG_IO) != KERN_SUCCESS ||
+        fa_map(&gRsc, VM_WIMG_IO) != KERN_SUCCESS || fa_map(&gGicd, VM_WIMG_IO) != KERN_SUCCESS) {
+        fail(StMapped, -12);
+        thread_terminate(current_thread());
+        return;
+    }
+    gSmem.base = (volatile uint8_t *)gSmemW.va;
+    gSmem.size = FA_SMEM_SIZE;
+    gLayout = qcom_rsc_layout(rd(&gRsc, 0));
+    stage(StMapped);
+    survey();
+    stage(StSurveyed);
+    if (mode >= 2 && start() && startGlink()) {
+        /* From here on the thread answers doorbells and client sends. Fast polling while traffic is recent, else 200 ms. */
+        uint64_t next_report;
+        clock_interval_to_deadline(30000, NSEC_PER_MSEC, &next_report);
+        unsigned reports = 0;
+        for (;;) {
+            const int fast = mach_absolute_time() < gFastUntil;
+            int pending = 0;
+            const uint32_t count = __atomic_load_n(&gClientCount, __ATOMIC_ACQUIRE);
+            for (unsigned i = 0; i < count; ++i) pending |= gClients[i].count != 0;
+            service(waitEvents(fast || pending ? 50 : 200, fast || pending ? 2 : 200) | (pending ? EV_SEND : 0));
+            if (mach_absolute_time() >= next_report) {
+                report();
+                clock_interval_to_deadline(++reports < 10 ? 30000u : 600000u, NSEC_PER_MSEC, &next_report);
+            }
+        }
+    }
+    report();
+    thread_terminate(current_thread());
+}
+
+ShengAdspChannel *sheng_adsp_channel(const char *name, uint32_t intent_size, uint32_t intent_count, int initiator,
+    const ShengAdspClient *client, void *context)
+{
+    if (!gStarted || !name || !client || !intent_size || !intent_count || intent_count > QCOM_GLINK_MAX_LOCAL_INTENTS) return NULL;
+    const vm_size_t storage_bytes = (vm_size_t)intent_size * intent_count, queue_bytes = sizeof(struct fa_message) * FA_QUEUE;
+    uint8_t *storage = kalloc_data(storage_bytes, Z_WAITOK | Z_ZERO);
+    struct fa_message *queue = kalloc_data(queue_bytes, Z_WAITOK | Z_ZERO);
+    struct ShengAdspChannel *c = NULL;
+    lck_mtx_lock(&fa_client_lock);
+    if (gClientCount < FA_CLIENTS && storage && queue) {
+        c = &gClients[gClientCount];
+        bzero(c, sizeof(*c));
+        strlcpy(c->name, name, sizeof(c->name));
+        c->intent_size = intent_size; c->intent_count = intent_count; c->initiator = initiator;
+        c->client = *client; c->context = context; c->storage = storage; c->queue = queue;
+        __atomic_store_n(&gClientCount, gClientCount + 1, __ATOMIC_RELEASE);
+    }
+    lck_mtx_unlock(&fa_client_lock);
+    if (!c) {
+        if (storage) kfree_data(storage, storage_bytes);
+        if (queue) kfree_data(queue, queue_bytes);
+        return NULL;
+    }
+    wake(EV_SEND);
+    return c;
+}
+
+int sheng_adsp_send(ShengAdspChannel *c, const void *data, uint32_t length)
+{
+    if (!c || !data || !length) return -2;
+    if (length > SHENG_ADSP_MAX_MESSAGE) return -1;
+    lck_mtx_lock(&fa_client_lock);
+    if (c->count == FA_QUEUE) { lck_mtx_unlock(&fa_client_lock); return -1; }
+    struct fa_message *m = &c->queue[(c->head + c->count) % FA_QUEUE];
+    memcpy(m->data, data, length);
+    m->length = length;
+    c->count++;
+    lck_mtx_unlock(&fa_client_lock);
+    wake(EV_SEND);
+    return 0;
+}
+
+/* Boot argument fuxiadsp, else ADT /chosen u32 "fuxi,adsp" (the command line is nearly full). */
+static unsigned fa_mode(void)
+{
+    unsigned mode = 0;
+    DTEntry chosen;
+    const void *prop;
+    unsigned bytes;
+    if (PE_parse_boot_argn("fuxiadsp", &mode, sizeof(mode))) return mode;
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+        SecureDTGetProperty(chosen, "fuxi,adsp", &prop, &bytes) == kSuccess && bytes == sizeof(uint32_t))
+        memcpy(&mode, prop, sizeof(mode));
+    return mode;
+}
+
+/* The mode that runs: 0 off, 1 survey, 2 start the DSP and log the battery manager, 3 also feed SweetBattery. 2 and 3 fall back to
+ * 1 with fuxiwlan until combined hardware validation. Read again on every call, so SweetBattery can ask before or
+ * after fuxi_adsp_init ran. */
+unsigned fuxi_adsp_mode(void);
+unsigned fuxi_adsp_mode(void)
+{
+    char wlan[8];
+    const unsigned mode = fa_mode();
+    if (!mode) return 0;
+    if (mode >= 2 && PE_parse_boot_argn("fuxiwlan", wlan, sizeof(wlan))) return 1;
+    return mode > 3 ? 3 : mode;
+}
+
+/* fuxi,adsp=4 (test loaders only): runs as 3, and the boot tour may ask fuxi_adsp_battery.c for a staged "unplugged, 57%" reading
+ * to check that iOS's battery display follows a published change (fuxi_adsp_battery_test_unplug). */
+unsigned fuxi_adsp_battery_test_mode(void);
+unsigned fuxi_adsp_battery_test_mode(void)
+{
+    return fa_mode() == 4 && fuxi_adsp_mode() == 3;
+}
+
+/* Called once from sweet_ufs.c after the UFS driver is ready (the firmware is read through it). */
+void fuxi_adsp_init(void)
+{
+    const unsigned asked = fa_mode(), run = fuxi_adsp_mode();
+    thread_t thread = NULL;
+    fuxi_pmic_init();
+    fuxi_amp_init(); /* the speaker amplifiers' own switch (fuxi_amp.c, fuxiamp / ADT fuxi,amp), independent of fuxiadsp */
+    if (!run || gStarted) return;
+    if (asked >= 2 && run < 2) {
+        printf("FUXI ADSP: fuxiadsp=%u refused with fuxiwlan (combined hardware validation pending); surveying only\n", asked);
+    }
+    gStarted = 1;
+    if (run >= 2) {
+        sheng_qrtr_start();               /* the router link registers before the DSP can open it */
+        fuxi_adsp_battery_start(run >= 3); /* PMIC_RTR_ADSP_APPS */
+    }
+    if (kernel_thread_start(adspThread, (void *)(uintptr_t)run, &thread) != KERN_SUCCESS) {
+        fail(StMapped, -7);
+        return;
+    }
+    thread_deallocate(thread);
+    printf("FUXI ADSP: started mode %u\n", run);
+}
+#endif /* FUXI */
diff --git a/xnu/fuxi-adsp/fuxi_adsp_battery.c b/xnu/fuxi-adsp/fuxi_adsp_battery.c
new file mode 100644
index 0000000..b40d2f7
--- /dev/null
+++ b/xnu/fuxi-adsp/fuxi_adsp_battery.c
@@ -0,0 +1,296 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* fuxiadsp=2: the client of the battery manager the audio DSP runs (PMIC GLINK channel "PMIC_RTR_ADSP_APPS"). Phase 1 only reads:
+ * every refresh cycle of ShengBattmgr.c (one request in flight, 2 s per request, a cycle every 60 s and at each notification) ends
+ * in a "FUXI BATTERY:" log line with what iOS would be shown, and the first cycles also list every raw field, so the Fuxi board's
+ * properties can be checked before anything is published to powerd (SweetBattery keeps its default until then). Charging itself
+ * stays with the DSP firmware; nothing is written to it except the notification enable request.
+ * Adapted from UniXNU-sheng package/ShengBattery.cpp (6880068), BSD-2-Clause-Patent: Copyright (c) 2026, UniXNU contributors
+ * (LICENSE.UniXNU-sheng). Design as there: the DSP thread's callbacks only copy a message into a small ring and kick a thread
+ * call, so the DSP thread never waits for this client and never re-enters sheng_adsp_send; the cycle runs in that thread call.
+ *
+ * fuxiadsp=3 (phase 2): each finished cycle whose snapshot is plausible (a charge reading, 2.5-4.8 V when the voltage was read)
+ * also becomes the reading SweetBattery publishes (fuxi_adsp_battery_reading, fuxi_adsp_battery.h). The percentage is published
+ * as at least 1: a misread 0 would make iOS shut down, and the PMIC cuts off a really empty cell by itself. */
+#include <pexpert/arm64/board_config.h>
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+/* thread_call_data_t / thread_call_setup_with_options are MACH_KERNEL_PRIVATE; same exposure as fuxi_adreno.c. */
+#define MACH_KERNEL_PRIVATE 1
+#include <kern/thread_call.h>
+#undef MACH_KERNEL_PRIVATE
+#include <pexpert/pexpert.h>
+#include "ShengAdsp.h"
+#include "ShengBattmgr.h"
+#include "fuxi_adsp_battery.h"
+
+void fuxi_adsp_battery_start(int publish);
+extern unsigned fuxi_adsp_mode(void);
+
+#define FB_REQUEST_MS 2000u
+#define FB_REFRESH_MS 10000u
+#define FB_SLOW_EVERY 10u
+#define FB_RING 16u
+
+static LCK_GRP_DECLARE(fb_grp, "fuxi_adsp_battery");
+static LCK_MTX_DECLARE(fb_ring_lock, &fb_grp); /* the ring (callbacks on the DSP thread vs. the thread call) */
+static LCK_MTX_DECLARE(fb_lock, &fb_grp);      /* the battery manager state */
+static struct { uint32_t length; uint8_t data[SHENG_ADSP_MAX_MESSAGE]; } fb_ring[FB_RING];
+static uint32_t fb_head, fb_count, fb_dropped;
+static volatile uint32_t fb_up, fb_changed, fb_lost;
+static ShengBattmgr fb_bm;
+static ShengAdspChannel *fb_channel;
+static thread_call_data_t fb_call;
+static int fb_was_up;
+static uint64_t fb_request_due, fb_refresh_due; /* absolute time; 0 = none */
+static uint32_t fb_refreshes, fb_logged, fb_send_refused;
+static LCK_MTX_DECLARE(fb_pub_lock, &fb_grp);  /* the published reading (the thread call vs. SweetBattery's work loop) */
+static FuxiAdspBattery fb_pub;
+static int fb_publish;
+static uint32_t fb_implausible;
+
+/* ---- the DSP thread: copy and kick, nothing else ---- */
+static void fbState(void *context, int up)
+{
+    (void)context;
+    if (!up) __atomic_store_n(&fb_lost, 1u, __ATOMIC_RELEASE);
+    __atomic_store_n(&fb_up, up ? 1u : 0u, __ATOMIC_RELEASE);
+    __atomic_store_n(&fb_changed, 1u, __ATOMIC_RELEASE);
+    (void)thread_call_enter(&fb_call);
+}
+static void fbReceive(void *context, const uint8_t *data, uint32_t length)
+{
+    (void)context;
+    lck_mtx_lock(&fb_ring_lock);
+    if (fb_count < FB_RING && length && length <= SHENG_ADSP_MAX_MESSAGE) {
+        const uint32_t slot = (fb_head + fb_count) % FB_RING;
+        memcpy(fb_ring[slot].data, data, length);
+        fb_ring[slot].length = length;
+        fb_count++;
+    } else {
+        fb_dropped++;
+    }
+    lck_mtx_unlock(&fb_ring_lock);
+    (void)thread_call_enter(&fb_call);
+}
+
+/* ---- the thread call ---- */
+static uint64_t fbDeadline(uint32_t ms)
+{
+    uint64_t at;
+    clock_interval_to_deadline(ms, NSEC_PER_MSEC, &at);
+    return at;
+}
+static void fbRaw(void)
+{
+    char line[400];
+    unsigned at = 0;
+    for (unsigned i = 0; i < BmFields && at + 24 < sizeof(line); ++i) {
+        const int n = (fb_bm.valid >> i) & 1u ? snprintf(line + at, sizeof(line) - at, " f%u=%d", i, fb_bm.value[i])
+                                              : snprintf(line + at, sizeof(line) - at, " f%u=-", i);
+        if (n <= 0) break;
+        at += (unsigned)n;
+    }
+    printf("FUXI BATTERY: raw valid=%#x last_timeout=%d%s\n", fb_bm.valid, fb_bm.last_timeout, line);
+}
+/* fuxiadsp=3: a plausible snapshot becomes the reading SweetBattery publishes; anything else keeps the previous one. */
+static void fbPublish(const ShengBatterySnapshot *s)
+{
+    const int volts_read = s->voltage_mv != 0;
+    if (!s->charge_known || s->percent < 0 || s->percent > 100 || (volts_read && (s->voltage_mv < 2500 || s->voltage_mv > 4800))) {
+        if (fb_implausible++ < 8)
+            printf("FUXI BATTERY: not published (charge_known=%d percent=%d mV=%d)\n", s->charge_known, s->percent, s->voltage_mv);
+        return;
+    }
+    FuxiAdspBattery b;
+    bzero(&b, sizeof(b));
+    b.percent = s->percent < 1 ? 1 : s->percent;
+    b.voltage_mv = s->voltage_mv;
+    b.current_ma = s->current_ma;
+    b.temperature = s->temperature;
+    b.temperature_valid = s->temperature_valid ? 1 : 0;
+    b.raw_mah = s->raw_mah > 0 ? s->raw_mah : 0;
+    b.full_mah = s->full_mah > 0 ? s->full_mah : 0;
+    b.design_mah = s->design_mah > 0 ? s->design_mah : 0;
+    b.cycles = s->cycles > 0 ? s->cycles : 0;
+    b.minutes_to_empty = s->time_to_empty_min;
+    b.minutes_to_full = s->time_to_full_min;
+    b.adapter_family = s->adapter_family;
+    b.adapter_mv = s->adapter_mv;
+    b.adapter_ma = s->adapter_ma;
+    b.adapter_watts = s->adapter_watts;
+    b.present = s->present ? 1 : 0;
+    b.external = s->external ? 1 : 0;
+    b.external_known = s->external_known ? 1 : 0;
+    b.charging = s->charging ? 1 : 0;
+    b.status_known = s->status_known ? 1 : 0;
+    b.fully_charged = s->fully_charged ? 1 : 0;
+    lck_mtx_lock(&fb_pub_lock);
+    b.sequence = fb_pub.sequence + 1;
+    fb_pub = b;
+    lck_mtx_unlock(&fb_pub_lock);
+    if (b.sequence == 1) printf("FUXI BATTERY: first reading for SweetBattery: %d%%\n", b.percent);
+}
+
+int fuxi_adsp_battery_wanted(void) { return fuxi_adsp_mode() >= 3; }
+
+/* Test loaders only (fuxi,adsp=4, fuxi_adsp.c): once the boot tour sets fuxi_tour_battery_test (bsd/dev/fuxi_keys.c), every
+ * reading handed to SweetBattery says "57%, unplugged, discharging" while the log keeps the real one, so a screenshot shows whether
+ * iOS's battery display follows a published change. Without fuxi,adsp=4 the flag is ignored. */
+extern unsigned fuxi_adsp_battery_test_mode(void);
+extern volatile uint32_t fuxi_tour_battery_test;
+static uint32_t fb_test_said;
+
+int fuxi_adsp_battery_reading(FuxiAdspBattery *out)
+{
+    int have;
+    if (!out || !fb_publish) return 0;
+    lck_mtx_lock(&fb_pub_lock);
+    have = fb_pub.sequence != 0;
+    if (have) *out = fb_pub;
+    lck_mtx_unlock(&fb_pub_lock);
+    if (have && __atomic_load_n(&fuxi_tour_battery_test, __ATOMIC_ACQUIRE) && fuxi_adsp_battery_test_mode()) {
+        if (!__atomic_exchange_n(&fb_test_said, 1u, __ATOMIC_ACQ_REL))
+            printf("FUXI BATTERY: TEST (fuxi,adsp=4) SweetBattery now gets a staged reading: 57%%, unplugged, -300 mA\n");
+        out->percent = 57;
+        out->current_ma = -300;
+        out->external = 0;
+        out->external_known = 1;
+        out->charging = 0;
+        out->status_known = 1;
+        out->fully_charged = 0;
+        out->minutes_to_full = -1;
+    }
+    return have;
+}
+
+/* Fuxi has one cell and one fuel gauge. ShengBattmgr's snapshot adds the sheng tablet's second gauge (board properties
+ * 0xa6/0xa7), which this firmware answers with 0 and with the first gauge's remaining charge, so the sum read about half
+ * (2026-11-16 adsp2: 4002/(4265+4002) mAh = 48% while Android showed 97% and the firmware's capacity property was 9600).
+ * Use the firmware's state of charge (battery property 4, hundredths of a percent) as Android does, and the first gauge's
+ * remaining charge (uAh) as the raw capacity: property 15 answers 4002 here, i.e. mAh, which the snapshot turns into 4. */
+static void fbBoard(ShengBatterySnapshot *s)
+{
+#define FB_HAS(f) ((fb_bm.valid >> (f)) & 1u)
+    if (FB_HAS(BmCapacity) && fb_bm.value[BmCapacity] >= 0 && fb_bm.value[BmCapacity] <= 10000) {
+        s->percent = (fb_bm.value[BmCapacity] + 50) / 100;
+        s->charge_known = 1;
+        s->fully_charged = s->external && ((FB_HAS(BmStatus) && fb_bm.value[BmStatus] == 4) || s->percent == 100);
+        s->critical = s->present && s->external_known && !s->external && s->percent <= 2;
+    }
+    if (FB_HAS(BmGauge1Remaining) && fb_bm.value[BmGauge1Remaining] > 0)
+        s->raw_mah = fb_bm.value[BmGauge1Remaining] / 1000;
+    /* The adapter's kind: this firmware keeps the USB property 1 (BmUsbType) at SDP for the whole session and reports what charger
+     * detection found in property 20 (BmUsbAdapter): 2026-11-16 adsp2b went SDP -> PD there (input limit 500 mA -> 1.2 A) while
+     * BmUsbType stayed 1, so the log named a PD charger a computer port (SweetBattery does not publish the family yet). Same
+     * POWER_SUPPLY_USB_TYPE -> kIOPSFamilyCode mapping as ShengBattmgr.c family(). */
+    if (s->external && FB_HAS(BmUsbAdapter) && fb_bm.value[BmUsbAdapter] > 0) {
+        switch (fb_bm.value[BmUsbAdapter]) {
+        case 1: s->adapter_family = 0xe0004000u; break;
+        case 2: s->adapter_family = 0xe0004004u; break;
+        case 3: s->adapter_family = 0xe0004005u; break;
+        case 5: s->adapter_family = 0xe0004009u; break;
+        case 6: case 7: case 8: s->adapter_family = 0xe000400au; break;
+        default: s->adapter_family = 0xe0004007u; break;
+        }
+    }
+#undef FB_HAS
+}
+
+static void fbLog(void)
+{
+    ShengBatterySnapshot s;
+    sheng_battmgr_snapshot(&fb_bm, &s);
+    fbBoard(&s);
+    printf("FUXI BATTERY: percent=%d%s mV=%d mA=%d temp=%d%s present=%d external=%d%s charging=%d%s full=%d critical=%d "
+        "mAh raw=%d full=%d design=%d cycles=%d tte_min=%d ttf_min=%d adapter=%#x %dmV %dmA %dW | cycles=%u answers=%u timeouts=%u "
+        "errors=%u notifications=%u ignored=%u dropped=%u refused=%u\n",
+        s.percent, s.charge_known ? "" : "(default)", s.voltage_mv, s.current_ma, s.temperature, s.temperature_valid ? "" : "(invalid)",
+        s.present, s.external, s.external_known ? "" : "(unknown)", s.charging, s.status_known ? "" : "(unknown)", s.fully_charged,
+        s.critical, s.raw_mah, s.full_mah, s.design_mah, s.cycles, s.time_to_empty_min, s.time_to_full_min, s.adapter_family,
+        s.adapter_mv, s.adapter_ma, s.adapter_watts, fb_bm.cycles_done, fb_bm.responses, fb_bm.timeouts, fb_bm.errors,
+        fb_bm.notifications, fb_bm.ignored, fb_dropped, fb_send_refused);
+    if (fb_logged++ < 3 || fb_logged % 10 == 0) fbRaw();
+    if (fb_publish) fbPublish(&s);
+}
+static void fbPump(void)
+{
+    uint8_t out[SHENG_BATTMGR_REQUEST_BYTES];
+    if (!fb_was_up || fb_request_due) return;
+    const uint32_t n = sheng_battmgr_next(&fb_bm, out);
+    if (!n) return;
+    if (sheng_adsp_send(fb_channel, out, n)) fb_send_refused++; /* the request timer skips the field */
+    fb_request_due = fbDeadline(FB_REQUEST_MS);
+}
+static void fbRun(thread_call_param_t p0, thread_call_param_t p1)
+{
+    (void)p0; (void)p1;
+    lck_mtx_lock(&fb_lock);
+    if (__atomic_exchange_n(&fb_changed, 0u, __ATOMIC_ACQ_REL)) {
+        const int up = __atomic_load_n(&fb_up, __ATOMIC_ACQUIRE) != 0;
+        /* A down/up pair may coalesce into one event: a loss always resets the cycle. */
+        if (__atomic_exchange_n(&fb_lost, 0u, __ATOMIC_ACQ_REL)) {
+            fb_request_due = 0;
+            sheng_battmgr_init(&fb_bm);
+            if (fb_was_up) printf("FUXI BATTERY: channel down\n");
+            fb_was_up = 0;
+        }
+        const int before = fb_was_up;
+        fb_was_up = up;
+        if (up && !before) {
+            uint8_t enable[SHENG_BATTMGR_ENABLE_BYTES];
+            if (sheng_adsp_send(fb_channel, enable, sheng_battmgr_enable_request(enable))) fb_send_refused++;
+            sheng_battmgr_refresh(&fb_bm, 1);
+            fb_refresh_due = fbDeadline(FB_REFRESH_MS);
+            printf("FUXI BATTERY: channel up; notifications requested, first refresh\n");
+        }
+    }
+    for (;;) {
+        uint8_t data[SHENG_ADSP_MAX_MESSAGE];
+        uint32_t length = 0;
+        lck_mtx_lock(&fb_ring_lock);
+        if (fb_count) {
+            length = fb_ring[fb_head].length;
+            memcpy(data, fb_ring[fb_head].data, length);
+            fb_head = (fb_head + 1) % FB_RING;
+            fb_count--;
+        }
+        lck_mtx_unlock(&fb_ring_lock);
+        if (!length) break;
+        const int result = sheng_battmgr_receive(&fb_bm, data, length);
+        if (result == BmAnswer || result == BmCycleDone) fb_request_due = 0;
+        if (result == BmCycleDone) fbLog();
+    }
+    const uint64_t now = mach_absolute_time();
+    if (fb_was_up && fb_request_due && now >= fb_request_due) {
+        const uint32_t before = fb_bm.cycles_done;
+        sheng_battmgr_timeout(&fb_bm);
+        fb_request_due = 0;
+        if (fb_bm.cycles_done != before) fbLog();
+    }
+    if (fb_was_up && fb_refresh_due && now >= fb_refresh_due) {
+        sheng_battmgr_refresh(&fb_bm, ++fb_refreshes % FB_SLOW_EVERY == 0);
+        fb_refresh_due = fbDeadline(FB_REFRESH_MS);
+    }
+    fbPump();
+    uint64_t next = 0;
+    if (fb_was_up && fb_request_due) next = fb_request_due;
+    if (fb_was_up && fb_refresh_due && (!next || fb_refresh_due < next)) next = fb_refresh_due;
+    if (next) (void)thread_call_enter_delayed(&fb_call, next);
+    lck_mtx_unlock(&fb_lock);
+}
+
+/* Called by fuxi_adsp_init before the DSP thread starts (the channel registers before the DSP can open it). publish: fuxiadsp=3. */
+void fuxi_adsp_battery_start(int publish)
+{
+    static const ShengAdspClient client = {fbState, fbReceive};
+    sheng_battmgr_init(&fb_bm);
+    thread_call_setup_with_options(&fb_call, fbRun, NULL, THREAD_CALL_PRIORITY_KERNEL, THREAD_CALL_OPTIONS_ONCE);
+    fb_publish = publish != 0;
+    fb_channel = sheng_adsp_channel("PMIC_RTR_ADSP_APPS", 1024, 4, 0, &client, NULL);
+    printf("FUXI BATTERY: battery manager client %s%s\n", fb_channel ? "registered" : "NOT registered",
+        fb_publish ? ", readings go to SweetBattery" : "");
+}
+#endif /* FUXI */
diff --git a/xnu/fuxi-adsp/fuxi_adsp_battery.h b/xnu/fuxi-adsp/fuxi_adsp_battery.h
new file mode 100644
index 0000000..b89d988
--- /dev/null
+++ b/xnu/fuxi-adsp/fuxi_adsp_battery.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* fuxiadsp=3: the battery manager's readings as SweetBattery (iokit/Kernel/arm/SweetBattery.cpp) publishes them to powerd.
+ * Shared by bsd/dev/fuxi_adsp_battery.c (C) and SweetBattery.cpp (C++); plain data only. */
+#ifndef FUXI_ADSP_BATTERY_H
+#define FUXI_ADSP_BATTERY_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    uint32_t sequence;                /* plausible readings taken so far (1 = the first) */
+    int32_t percent;                  /* 1..100: a reading never publishes 0 (iOS would shut down on a bad parse) */
+    int32_t voltage_mv, current_ma;   /* current positive while the battery takes charge */
+    int32_t temperature;              /* centidegrees C, valid only with temperature_valid */
+    int32_t raw_mah, full_mah, design_mah, cycles;  /* 0: not reported */
+    int32_t minutes_to_empty, minutes_to_full;      /* -1: unknown */
+    uint32_t adapter_family;
+    int32_t adapter_mv, adapter_ma, adapter_watts;
+    uint8_t present, external, external_known, charging, status_known, fully_charged, temperature_valid, pad;
+} FuxiAdspBattery;
+
+/* 1 when the DSP's battery manager is meant to feed the power source (fuxiadsp=3); SweetBattery then polls. */
+int fuxi_adsp_battery_wanted(void);
+/* 1 and the latest plausible reading (none yet: 0, and SweetBattery keeps its fallback). */
+int fuxi_adsp_battery_reading(FuxiAdspBattery *out);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/fuxi_adsp_fw.c b/xnu/fuxi-adsp/fuxi_adsp_fw.c
new file mode 100644
index 0000000..7755f92
--- /dev/null
+++ b/xnu/fuxi-adsp/fuxi_adsp_fw.c
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* ADSP firmware files for fuxi_adsp.c, read in place from the device's own firmware partition: the split image NAME.b00,
+ * NAME.b01, ... in /image of modem_a (else modem_b), a FAT16 volume read through sweet_ufs.c's read-only firmware-partition
+ * reads. Nothing is installed and the boot image does not grow. Plain reads on the caller's thread (the ADSP thread is the
+ * only caller). Adapted from UniXNU-sheng package/AdspFirmware.c (6880068; only its "modem:" source), BSD-2-Clause-Patent:
+ * Copyright (c) 2026, UniXNU contributors (LICENSE.UniXNU-sheng). */
+#include <pexpert/arm64/board_config.h>
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/kalloc.h>
+#include "FatVolume.h"
+#include "QcomMdt.h"
+
+int fuxi_adsp_fw_open(const char *name, void **handle, uint64_t *size);
+int fuxi_adsp_fw_read(void *handle, uint64_t offset, void *to, size_t length);
+void fuxi_adsp_fw_close(void *handle);
+
+extern int fuxi_ufs_part_find(const char *name, uint32_t *lun, uint64_t *first, uint64_t *blocks);
+extern int fuxi_ufs_part_read(uint32_t lun, uint64_t lba, uint32_t blocks, void *dst);
+
+#define FW_BLOCK 4096u
+#define FW_RUN 256u /* blocks per UFS read: the driver's 1 MiB bounce buffer */
+
+/* The partition (one for the boot) and its one-block cache. Static: no allocation, and the only user is the ADSP thread. */
+static struct {
+    uint32_t lun;
+    uint64_t first, blocks;
+    uint64_t cached; /* block in block (UINT64_MAX: none) */
+    uint8_t block[FW_BLOCK];
+} gPart;
+static FatVolume gVolume;
+static int gMounted;
+
+/* Bytes of the partition: whole blocks straight into to, the ends of a range through the one-block cache. Never past its end. */
+static int partitionRead(void *context, uint64_t offset, void *to, size_t length)
+{
+    (void)context;
+    uint8_t *out = to;
+    if (offset > gPart.blocks * FW_BLOCK || length > gPart.blocks * FW_BLOCK - offset) return EIO;
+    while (length) {
+        const uint64_t lba = offset / FW_BLOCK;
+        const size_t within = (size_t)(offset % FW_BLOCK);
+        if (!within && length >= FW_BLOCK) {
+            const uint32_t n = length / FW_BLOCK > FW_RUN ? FW_RUN : (uint32_t)(length / FW_BLOCK);
+            if (!fuxi_ufs_part_read(gPart.lun, gPart.first + lba, n, out)) return EIO;
+            out += (size_t)n * FW_BLOCK; offset += (uint64_t)n * FW_BLOCK; length -= (size_t)n * FW_BLOCK;
+            continue;
+        }
+        if (gPart.cached != lba) {
+            gPart.cached = UINT64_MAX;
+            if (!fuxi_ufs_part_read(gPart.lun, gPart.first + lba, 1, gPart.block)) return EIO;
+            gPart.cached = lba;
+        }
+        const size_t take = FW_BLOCK - within < length ? FW_BLOCK - within : length;
+        memcpy(out, gPart.block + within, take);
+        out += take; offset += take; length -= take;
+    }
+    return 0;
+}
+
+static int mountPartition(void)
+{
+    static const char *const names[] = {"modem_a", "modem_b"};
+    int rc = ENOENT;
+    if (gMounted) return 0;
+    for (unsigned i = 0; i < 2 && rc; ++i) {
+        uint64_t blocks = 0;
+        /* ENXIO while the UFS driver is not ready: the caller tries again later */
+        if (!fuxi_ufs_part_find(names[i], &gPart.lun, &gPart.first, &blocks)) {rc = ENXIO; continue;}
+        gPart.blocks = blocks;
+        gPart.cached = UINT64_MAX;
+        rc = fat_mount(&gVolume, blocks * FW_BLOCK, partitionRead, NULL) ? EFTYPE : 0;
+        if (!rc) printf("FUXI ADSP: firmware volume %s (LUN %u, %llu MiB)\n", names[i], gPart.lun, blocks * FW_BLOCK >> 20);
+    }
+    if (!rc) gMounted = 1;
+    return rc;
+}
+
+/* The two images the bring-up uses (adsp_dtb, then adsp) are open at the same time. */
+#define FW_IMAGES 2u
+struct modem_image {
+    uint8_t used;
+    QcomMdtSplit split;
+    FatFile piece[QCOM_MDT_MAX_SEGMENTS];
+};
+static struct modem_image gImages[FW_IMAGES];
+
+static int pieceRead(void *context, unsigned piece, uint64_t offset, void *to, size_t length)
+{
+    struct modem_image *m = context;
+    if (piece >= QCOM_MDT_MAX_SEGMENTS) return EIO;
+    return fat_read(&gVolume, &m->piece[piece], offset, to, length);
+}
+
+int fuxi_adsp_fw_open(const char *name, void **handle, uint64_t *size)
+{
+    char path[48];
+    struct modem_image *m = NULL;
+    int rc = mountPartition();
+    if (rc) return rc;
+    for (unsigned i = 0; i < FW_IMAGES && !m; ++i) if (!gImages[i].used) m = &gImages[i];
+    if (!m) return ENFILE;
+    bzero(m, sizeof(*m));
+    snprintf(path, sizeof(path), "image/%s.b00", name);
+    FatFile headers;
+    rc = fat_open(&gVolume, path, &headers);
+    if (rc == FatNotFound) rc = ENOENT;
+    else if (rc) rc = EIO;
+    else if (headers.size < 52 || headers.size > 64 * 1024) rc = EFTYPE;
+    uint8_t *bytes = rc ? NULL : kalloc_data(headers.size, Z_WAITOK);
+    if (!rc && !bytes) rc = ENOMEM;
+    if (!rc && fat_read(&gVolume, &headers, 0, bytes, headers.size)) rc = EIO;
+    if (!rc && qcom_mdt_split(&m->split, bytes, headers.size)) rc = EFTYPE;
+    if (bytes) kfree_data(bytes, headers.size);
+    for (unsigned i = 0; !rc && i < m->split.count; ++i) {
+        if (!m->split.piece[i].size) continue;
+        snprintf(path, sizeof(path), "image/%s.b%02u", name, i);
+        if (fat_open(&gVolume, path, &m->piece[i])) rc = ENOENT;
+        else if (m->piece[i].size < m->split.piece[i].size) rc = EFTYPE;
+    }
+    if (rc) return rc;
+    m->used = 1;
+    *handle = m;
+    *size = m->split.size;
+    return 0;
+}
+
+int fuxi_adsp_fw_read(void *handle, uint64_t offset, void *to, size_t length)
+{
+    struct modem_image *m = handle;
+    if (!m || !m->used) return EBADF;
+    return qcom_mdt_split_read(&m->split, pieceRead, m, offset, to, length) ? EIO : 0;
+}
+
+void fuxi_adsp_fw_close(void *handle)
+{
+    struct modem_image *m = handle;
+    if (m) m->used = 0;
+}
+#endif /* FUXI */
diff --git a/xnu/fuxi-adsp/fuxi_amp.c b/xnu/fuxi-adsp/fuxi_amp.c
new file mode 100644
index 0000000..09ce08d
--- /dev/null
+++ b/xnu/fuxi-adsp/fuxi_amp.c
@@ -0,0 +1,335 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* FUXI speaker amplifiers: two Cirrus CS35L41 on QUP2 SE0 I2C (live DT i2c@880000: cs35l41@40 "B", reset GPIO 183; cs35l41@42
+ * "T", reset GPIO 182, both active low; pins gpio0 SDA / gpio1 SCL, function 2 = qup2_se0_l0/l1_mirb, 2 mA, pull-up; engine SPI
+ * 373, level). Boot argument fuxiamp, or ADT /chosen u32 "fuxi,amp" (the command line is full):
+ *   1  survey, reads only: the GCC votes 0x52008 / 0x52010 / 0x52018, the five QUP2 branches (core 0x233d4, s_ahb 0x233d0, m_ahb
+ *      0x233cc, core_2x 0x23004, s0 0x1e004; gcc-sm8550.c), the SE0 clock source 0x1e010 (DFS state, which level is 19.2 MHz) and
+ *      the four pins; only when all five branches run, also the engine: protocol, FIFO lock (GENI_IF_DISABLE bit 0 set means the
+ *      engine is GSI only, as touch's QUP1 SE4 is), clock configuration, SCL counters and FIFO depths.
+ *   2  brings the bus up as UniXNU-sheng AudioProbe.cpp setupClocks / setupPins / setupBus do for this same engine on sheng
+ *      (6880068): GPLL0 and the five QUP2 votes, the I2C pins, the engine at 400 kHz from the 19.2 MHz DFS level if the boot stages
+ *      left it unconfigured, FIFO mode (GeniI2c.c, sheng's, unchanged); SPI 373 is masked in the distributor first (no handler
+ *      here, every transfer is polled). Then each amplifier comes out of reset (its eGPIO taken from the LPASS island, low 2 ms,
+ *      high, 10 ms for its OTP boot; the pad's input is logged low and high) and DEVID
+ *      0x0 (0x35a40 expected), REVID 0x4, IRQ1_STATUS3 0x10018 and IRQ1_STATUS4 0x1001c (OTP boot error / done) are read. Nothing
+ *      is written to the amplifiers. At the end both are held in reset again and the pins and votes go back to what they were.
+ * Facts: QUP2 SE0 window 0x880000 + 0x4000, GCC 0x100000, TLMM 0xf100000 (0x1000 per pin: ctl, io at +4), GICD 0x17100000.
+ * Windows are mapped with kernel_map VA and pmap entries (never ml_io_map), as fuxi_adsp.c does. */
+#include <pexpert/arm64/board_config.h>
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include "GeniI2c.h"
+
+extern kern_return_t pmap_enter_options_addr(pmap_t, vm_map_offset_t, uint64_t, vm_prot_t, vm_prot_t, unsigned, boolean_t,
+    unsigned, void *);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern kern_return_t thread_terminate(thread_t);
+extern void thread_deallocate(thread_t);
+extern void IOSleep(unsigned milliseconds);
+void fuxi_amp_init(void);
+
+#define FM_GCC 0x100000ull
+#define FM_TLMM 0xf100000ull
+#define FM_SE 0x880000ull
+#define FM_GICD 0x17100000ull
+#define FM_INTID_SE (32u + 373u)
+#define FM_VOTE1 0x52008u
+#define FM_VOTE2 0x52010u
+#define FM_VOTE2_BITS 0x1fu        /* wrap2 core 0, s_ahb 1, m_ahb 2, core_2x 3, s0 4 */
+#define FM_GPLL0_VOTE 0x52018u     /* bit 0 */
+#define FM_GPLL0_MODE 0x0u         /* bit 31 lock detect */
+#define FM_RCG 0x1e010u            /* gcc_qupv3_wrap2_s0_clk_src */
+#define FM_CLK_OFF (1u << 31)
+#define FM_SCL_COUNTERS (5u << 20 | 11u << 10 | 22u) /* 400 kHz from 19.2 MHz (i2c-qcom-geni.c): high 5, low 11, cycle 22 */
+#define FM_CLK_CFG (2u << 4 | 1u)                     /* divider 2, enable */
+#define FM_DEVID 0x35a40u
+/* GPIO 182/183 are eGPIOs (pinctrl-sm8550.c: egpio_present bit 11, egpio_enable bit 12, egpio_func 9). The boot stages leave them
+ * at 0x801: present, enable clear = the LPASS island TLMM owns the pad, so the APPS io register drives nothing. pinctrl-msm sets
+ * enable whenever it muxes a non-egpio function (the DT's cirrus_reset_default: gpio, output-high, 16 mA, no bias). amp2 (ksrc
+ * 417dcf3) wrote 1 << 9 alone, kept the island as owner, and both amplifiers stayed in reset: NACK at 0x40 and 0x42. */
+#define FM_EGPIO_PRESENT (1u << 11)
+#define FM_EGPIO_ENABLE (1u << 12)
+#define FM_RESET_CTL (1u << 9 | 7u << 6)  /* GPIO, output enabled, 16 mA, no pull */
+
+static const uint32_t kHalts[5] = {0x233d4u, 0x233d0u, 0x233ccu, 0x23004u, 0x1e004u};
+static const unsigned kPins[4] = {0, 1, 183, 182};    /* SDA, SCL, reset B, reset T */
+static const uint8_t kAddr[2] = {0x40, 0x42};
+static const unsigned kReset[2] = {183, 182};
+static const char kName[2] = {'B', 'T'};
+
+/* ---- MMIO windows (16 KiB pages) ---- */
+struct fm_window { uint64_t pa; vm_size_t size; vm_offset_t va; };
+static struct fm_window gGcc0 = {FM_GCC, 0x4000, 0}, gGcc1c = {FM_GCC + 0x1c000, 0x4000, 0}, gGcc20 = {FM_GCC + 0x20000, 0x4000, 0},
+    gGcc50 = {FM_GCC + 0x50000, 0x4000, 0}, gSe = {FM_SE, 0x4000, 0}, gGicd = {FM_GICD, 0x4000, 0};
+static struct fm_window gPin[4];
+
+static kern_return_t fm_map(struct fm_window *w)
+{
+    vm_offset_t va = 0;
+    if (w->va) return KERN_SUCCESS;
+    if (!w->size || (w->pa & PAGE_MASK) || (w->size & PAGE_MASK)) return KERN_INVALID_ARGUMENT;
+    kern_return_t kr = kmem_alloc(kernel_map, &va, w->size, KMA_VAONLY | KMA_KOBJECT | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+    if (kr != KERN_SUCCESS) return kr;
+    for (vm_size_t off = 0; off < w->size; off += PAGE_SIZE) {
+        kr = pmap_enter_options_addr(kernel_pmap, va + off, w->pa + off, VM_PROT_READ | VM_PROT_WRITE, VM_PROT_NONE, VM_WIMG_IO, TRUE,
+            PMAP_OPTIONS_NOWAIT, NULL);
+        if (kr != KERN_SUCCESS) {
+            pmap_remove(kernel_pmap, va, va + w->size);
+            return kr; /* VA kept reserved, as in fuxi_adsp.c */
+        }
+    }
+    w->va = va;
+    return KERN_SUCCESS;
+}
+static uint32_t rd(const struct fm_window *w, uint64_t pa) { return *(volatile uint32_t *)(w->va + (pa - w->pa)); }
+static void wr(const struct fm_window *w, uint64_t pa, uint32_t value)
+{
+    *(volatile uint32_t *)(w->va + (pa - w->pa)) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+/* A GCC register by its offset from the GCC base. */
+static const struct fm_window *gccWin(uint32_t off)
+{
+    const uint64_t pa = FM_GCC + off;
+    const struct fm_window *w[4] = {&gGcc0, &gGcc1c, &gGcc20, &gGcc50};
+    for (unsigned i = 0; i < 4; ++i) if (pa >= w[i]->pa && pa + 4 <= w[i]->pa + w[i]->size) return w[i];
+    return NULL;
+}
+static uint32_t gcc(uint32_t off) { return rd(gccWin(off), FM_GCC + off); }
+static void gccWr(uint32_t off, uint32_t value) { wr(gccWin(off), FM_GCC + off, value); }
+static uint64_t pinPa(unsigned gpio) { return FM_TLMM + (uint64_t)gpio * 0x1000u; }
+static uint32_t pinCtl(unsigned i) { return rd(&gPin[i], pinPa(kPins[i])); }
+static uint32_t pinIo(unsigned i) { return rd(&gPin[i], pinPa(kPins[i]) + 4); }
+static unsigned pinIndex(unsigned gpio) { for (unsigned i = 0; i < 4; ++i) if (kPins[i] == gpio) return i; return 0; }
+
+/* ---- clocks ---- */
+/* sheng's test: a branch is running unless it reports CLK_OFF without being under hardware control (bit 1). */
+static int branchesRun(uint32_t *mask)
+{
+    int ok = 1;
+    uint32_t off = 0;
+    for (unsigned i = 0; i < 5; ++i) {
+        const uint32_t v = gcc(kHalts[i]);
+        if ((v & FM_CLK_OFF) && !(v & 2u)) { ok = 0; off |= 1u << i; }
+    }
+    if (mask) *mask = off;
+    return ok;
+}
+/* The DFS level of the SE0 clock source that runs at 19.2 MHz (TCXO, no divider, no M/N), or -1. */
+static int level19m2(void)
+{
+    for (unsigned l = 0; l < 8; ++l) {
+        const uint32_t cfg = gcc(FM_RCG + 0x1c + 4 * l);
+        const unsigned src = (cfg >> 8) & 7, mode = (cfg >> 12) & 3, hid = cfg & 0x1f;
+        if (src == 0 && mode == 0 && hid <= 1) return (int)l; /* hid 0 or 1: divide by 1 */
+    }
+    return -1;
+}
+
+/* ---- the GIC: SPI 373 masked (polled engine, no handler in this kernel owns the line) ---- */
+static void gicMask(unsigned intid)
+{
+    wr(&gGicd, FM_GICD + 0x180 + (intid / 32) * 4, 1u << (intid % 32));
+    for (unsigned n = 0; (rd(&gGicd, FM_GICD) & 0x80000000u) && n < 100000; n++) delay(1); /* GICD_CTLR.RWP */
+}
+static int gicEnabled(unsigned intid) { return (rd(&gGicd, FM_GICD + 0x100 + (intid / 32) * 4) >> (intid % 32)) & 1; }
+
+/* ---- the engine ---- */
+static uint32_t ioRd(void *ctx, uint32_t reg) { (void)ctx; return rd(&gSe, FM_SE + reg); }
+static void ioWr(void *ctx, uint32_t reg, uint32_t value) { (void)ctx; wr(&gSe, FM_SE + reg, value); }
+static GeniI2c gBus;
+
+/* One register read on the bus (32-bit address, 32-bit data, both big-endian on the wire): 1 and *value, or 0. Polled in 20 us steps,
+ * 20 ms per stage of GeniI2c's cancel/abort ladder, as sheng's transfer(). */
+static int ampRead(uint8_t address, uint32_t reg, uint32_t *value)
+{
+    const uint8_t bytes[4] = {(uint8_t)(reg >> 24), (uint8_t)(reg >> 16), (uint8_t)(reg >> 8), (uint8_t)reg};
+    gBus.address = address;
+    if (geni_i2c_start_read_bytes(&gBus, bytes, 4, 4)) return 0;
+    for (int stages = 3; stages > 0;) {
+        for (unsigned i = 0; i < 1000; ++i) {
+            const int r = geni_i2c_poll(&gBus);
+            if (r == GeniDone) { *value = __builtin_bswap32(gBus.rx); return 1; }
+            if (r == GeniFailed) return 0;
+            delay(20);
+        }
+        if (geni_i2c_timeout(&gBus) != GeniPending) return 0;
+        --stages;
+    }
+    return 0;
+}
+
+/* The survey reads the engine only with every branch plainly on (CLK_OFF clear, hardware control or not): a read of an unclocked
+ * block stalls the bus. */
+static int branchesOn(void)
+{
+    for (unsigned i = 0; i < 5; ++i) if (gcc(kHalts[i]) & FM_CLK_OFF) return 0;
+    return 1;
+}
+
+static void survey(int *running)
+{
+    uint32_t off = 0;
+    const int run = branchesRun(&off) && branchesOn();
+    const int level = level19m2();
+    printf("FUXI AMP: survey vote 0x52008=%#x 0x52010=%#x gpll0=%#x/%#x branches core=%#x s_ahb=%#x m_ahb=%#x core2x=%#x s0=%#x "
+        "(off mask %#x) rcg cmd=%#x dfsr=%#x level19.2=%d gic_se_en=%d\n", gcc(FM_VOTE1), gcc(FM_VOTE2), gcc(FM_GPLL0_VOTE),
+        gcc(FM_GPLL0_MODE), gcc(kHalts[0]), gcc(kHalts[1]), gcc(kHalts[2]), gcc(kHalts[3]), gcc(kHalts[4]), off, gcc(FM_RCG),
+        gcc(FM_RCG + 0x14), level, gicEnabled(FM_INTID_SE));
+    printf("FUXI AMP: pins gpio0 %#x/%#x gpio1 %#x/%#x gpio183 %#x/%#x gpio182 %#x/%#x (ctl/io)\n", pinCtl(0), pinIo(0), pinCtl(1),
+        pinIo(1), pinCtl(2), pinIo(2), pinCtl(3), pinIo(3));
+    if (run) {
+        printf("FUXI AMP: engine fw=%#x proto=%u if_disable=%#x (%s) clk_cfg=%#x clk_sel=%#x scl=%#x hw0=%#x hw1=%#x m_irq=%#x/%#x\n",
+            ioRd(NULL, GENI_FW_REVISION), (ioRd(NULL, GENI_FW_REVISION) >> 8) & 0xff, ioRd(NULL, GENI_IF_DISABLE),
+            (ioRd(NULL, GENI_IF_DISABLE) & 1u) ? "FIFO locked: GSI only" : "FIFO usable", ioRd(NULL, GENI_CLK_CFG), ioRd(NULL, 0x7c),
+            ioRd(NULL, GENI_SCL_COUNTERS), ioRd(NULL, GENI_HW_PARAM_0), ioRd(NULL, GENI_HW_PARAM_1), ioRd(NULL, GENI_M_IRQ_STATUS),
+            ioRd(NULL, GENI_M_IRQ_EN));
+    } else {
+        printf("FUXI AMP: engine not read: QUP2 clocks off\n");
+    }
+    *running = run;
+}
+
+/* Mode 2. Saved state is put back on every exit path. */
+static void bringUp(int wasRunning)
+{
+    uint32_t savedCtl[4], savedIo[4];
+    for (unsigned i = 0; i < 4; ++i) { savedCtl[i] = pinCtl(i); savedIo[i] = pinIo(i); }
+    const uint32_t savedVote2 = gcc(FM_VOTE2), savedGpll0 = gcc(FM_GPLL0_VOTE);
+    int bus = 0, step = 0;
+    uint32_t config = 0;
+
+    /* clocks */
+    gccWr(FM_GPLL0_VOTE, savedGpll0 | 1u);
+    for (unsigned i = 0; i < 10000 && !(gcc(FM_GPLL0_MODE) & FM_CLK_OFF); ++i) delay(10); /* bit 31: lock detect */
+    gccWr(FM_VOTE2, savedVote2 | FM_VOTE2_BITS);
+    int run = 0;
+    for (unsigned i = 0; i < 2000 && !(run = branchesRun(NULL)); ++i) delay(10);
+    step = 1;
+    if (!run) goto out; /* never touch an engine without running clocks */
+
+    /* pins: I2C function 2, 2 mA, pull-up (DT active state) */
+    for (unsigned i = 0; i < 2; ++i) wr(&gPin[i], pinPa(kPins[i]), 2u << 2 | 0u << 6 | 3u);
+    step = 2;
+
+    /* the engine */
+    const uint32_t proto = (ioRd(NULL, GENI_FW_REVISION) >> 8) & 0xff;
+    if (proto != GENI_PROTO_I2C) goto out;
+    step = 3;
+    if (!(ioRd(NULL, GENI_CLK_CFG) & 1u) || !ioRd(NULL, GENI_SCL_COUNTERS)) {
+        const int level = level19m2();
+        if (level < 0) goto out;
+        ioWr(NULL, 0x28, ioRd(NULL, 0x28) | 0x7fu);   /* clock gating controls on */
+        ioWr(NULL, 0xe30, ioRd(NULL, 0xe30) | 0xfu);  /* DMA clock gating controls on */
+        ioWr(NULL, 0x24, 0x7fu);                      /* default output control */
+        ioWr(NULL, 0x20, 1u);                         /* force default */
+        ioWr(NULL, 0xe18, 0);                         /* no GSI events */
+        ioWr(NULL, 0x7c, (uint32_t)level);
+        ioWr(NULL, GENI_CLK_CFG, FM_CLK_CFG);
+        ioWr(NULL, GENI_SCL_COUNTERS, FM_SCL_COUNTERS);
+    }
+    step = 4;
+    gicMask(FM_INTID_SE);
+    if (gicEnabled(FM_INTID_SE)) goto out;
+    const GeniIo io = {ioRd, ioWr, NULL};
+    if (geni_i2c_prepare(&gBus, &io, kAddr[0], &config)) goto out; /* also refuses a GSI-only engine */
+    bus = 1;
+    step = 5;
+
+    /* the amplifiers, one at a time */
+    for (unsigned a = 0; a < 2; ++a) {
+        const unsigned p = pinIndex(kReset[a]);
+        const uint32_t egpio = (savedCtl[p] & FM_EGPIO_PRESENT) ? FM_EGPIO_ENABLE : 0;
+        wr(&gPin[p], pinPa(kReset[a]) + 4, 0);           /* output low */
+        wr(&gPin[p], pinPa(kReset[a]), egpio | FM_RESET_CTL); /* APPS takes the pad (eGPIO), GPIO out, 16 mA */
+        IOSleep(2);
+        const uint32_t ctlNow = pinCtl(p), lowIn = pinIo(p) & 1u;
+        wr(&gPin[p], pinPa(kReset[a]) + 4, 1u << 1);     /* release */
+        IOSleep(10);
+        const uint32_t highIn = pinIo(p) & 1u;
+        uint32_t devid = 0, revid = 0, st3 = 0, st4 = 0;
+        const int ok = ampRead(kAddr[a], 0x0, &devid);
+        const int ok2 = ok && ampRead(kAddr[a], 0x4, &revid) && ampRead(kAddr[a], 0x10018, &st3) && ampRead(kAddr[a], 0x1001c, &st4);
+        printf("FUXI AMP: amp %c@%#x %s devid=%#x%s revid=%#x irq1_status3=%#x irq1_status4=%#x (geni error %u status %#x done %u "
+            "failed %u timeouts %u; reset gpio%u ctl %#x in low/high %u/%u)\n", kName[a], kAddr[a], ok2 ? "answers" : ok ? "partly" :
+            "no answer", devid, devid == FM_DEVID ? " (CS35L41)" : "", revid, st3, st4, gBus.error, gBus.error_status, gBus.done,
+            gBus.failed, gBus.timeouts, kReset[a], ctlNow, lowIn, highIn);
+        wr(&gPin[p], pinPa(kReset[a]) + 4, 0);           /* back into reset */
+    }
+    step = 6;
+out:
+    /* Put back what the boot stages left: reset pins first (still low while their old configuration returns), then the I2C pins and
+     * the votes. A clock the boot stages had running stays running. */
+    for (unsigned i = 0; i < 4; ++i) {
+        wr(&gPin[i], pinPa(kPins[i]) + 4, savedIo[i] & ~1u);
+        wr(&gPin[i], pinPa(kPins[i]), savedCtl[i]);
+    }
+    if (!wasRunning) {
+        gccWr(FM_VOTE2, savedVote2);
+        gccWr(FM_GPLL0_VOTE, savedGpll0);
+    }
+    printf("FUXI AMP: bring-up stopped at step %d (6 = both read; bus %s, config %#x); pins%s restored\n", step,
+        bus ? "prepared" : "not prepared", config, wasRunning ? "" : " and votes");
+}
+
+/* Boot argument fuxiamp, else ADT /chosen u32 "fuxi,amp". */
+static unsigned fm_mode(void)
+{
+    unsigned mode = 0;
+    DTEntry chosen;
+    const void *prop;
+    unsigned bytes;
+    if (PE_parse_boot_argn("fuxiamp", &mode, sizeof(mode))) return mode;
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess &&
+        SecureDTGetProperty(chosen, "fuxi,amp", &prop, &bytes) == kSuccess && bytes == sizeof(uint32_t))
+        memcpy(&mode, prop, sizeof(mode));
+    return mode;
+}
+
+static void ampThread(void *arg, wait_result_t result)
+{
+    (void)result;
+    const unsigned mode = (unsigned)(uintptr_t)arg;
+    int ok = fm_map(&gGcc0) == KERN_SUCCESS && fm_map(&gGcc1c) == KERN_SUCCESS && fm_map(&gGcc20) == KERN_SUCCESS &&
+        fm_map(&gGcc50) == KERN_SUCCESS && fm_map(&gSe) == KERN_SUCCESS && fm_map(&gGicd) == KERN_SUCCESS;
+    for (unsigned i = 0; ok && i < 4; ++i) {
+        gPin[i].pa = pinPa(kPins[i]) & ~(uint64_t)0x3fffu;
+        gPin[i].size = 0x4000;
+        for (unsigned j = 0; j < i; ++j) if (gPin[j].pa == gPin[i].pa) gPin[i].va = gPin[j].va; /* gpio0 and gpio1 share a page */
+        ok = fm_map(&gPin[i]) == KERN_SUCCESS;
+    }
+    if (!ok) {
+        printf("FUXI AMP: mapping failed\n");
+    } else {
+        int running = 0;
+        survey(&running);
+        if (mode >= 2) bringUp(running);
+    }
+    thread_terminate(current_thread());
+}
+
+/* Called from fuxi_adsp_init (sweet_ufs.c, after the UFS driver is ready). */
+void fuxi_amp_init(void)
+{
+    static int started;
+    thread_t thread = NULL;
+    const unsigned mode = fm_mode();
+    if (!mode || started) return;
+    started = 1;
+    if (kernel_thread_start(ampThread, (void *)(uintptr_t)(mode > 2 ? 2 : mode), &thread) != KERN_SUCCESS) {
+        printf("FUXI AMP: no thread\n");
+        return;
+    }
+    thread_deallocate(thread);
+    printf("FUXI AMP: started mode %u\n", mode > 2 ? 2 : mode);
+}
+#endif /* FUXI */
