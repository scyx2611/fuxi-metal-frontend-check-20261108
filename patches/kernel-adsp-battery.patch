++                case 3:
++                    parser->header_need = 4;
++                    break;
++                case 4:
++                    parser->header_need = 3;
++                    break;
++                case 0xfc:
++                case 0xfd:
++                case 0xfe:
++                    return FUXI_BT_IBS;
++                default:
++                    return FUXI_BT_PROTOCOL;
++            }
++        }
