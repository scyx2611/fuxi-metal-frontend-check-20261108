+    if (state->stop_read_error && state->pulses && address == 0xf04c &&
+        !(state->registers[0x4c] & 0x80)) return -1;
+    if (state->mutate_staged && state->writes == 32 && address == 0xf046) {
+        state->registers[0x13b] ^= 1;
