++    case 1: return 0xe0004000u;
++    case 2: return 0xe0004004u;
++    case 3: return 0xe0004005u;
++    case 5: return 0xe0004009u;
++    case 6: case 7: case 8: return 0xe000400au;
++    default: return 0xe0004007u;
++    }
++}
