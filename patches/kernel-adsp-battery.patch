+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include <arm/caches_internal.h>
+#include "QcomGlink.h"
+#include "QcomMdt.h"
+#include "QcomQmp.h"
+#include "QcomRpmh.h"
+#include "QcomScm.h"
+#include "QcomSmem.h"
