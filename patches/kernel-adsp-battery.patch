+    assert(address >= 0xf000 && address <= 0xf2ff);
+    return address - 0xf000;
+}
+
+static int active(const struct model *state)
+{
+    return !state->expired && (state->registers[0x46] & 0x80) &&
+        (state->registers[0x4c] & 0x80);
+}
