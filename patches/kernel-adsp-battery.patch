diff --git a/xnu/fuxi-adsp/fuxi_torch_audit.h b/xnu/fuxi-adsp/fuxi_torch_audit.h
new file mode 100644
index 0000000..7558fa9
--- /dev/null
+++ b/xnu/fuxi-adsp/fuxi_torch_audit.h
@@ -0,0 +1,45 @@
+#ifndef FUXI_TORCH_AUDIT_H
+#define FUXI_TORCH_AUDIT_H
+#include <stdint.h>
+
+#define FUXI_TORCH_AUDIT_CAPACITY 64u
+
+typedef struct {
+    unsigned operation;
+    unsigned offset;
+    uint8_t value;
+    int result;
+    uint64_t elapsed_us;
+} FuxiTorchAuditEvent;
+
+typedef struct {
+    uint64_t started;
+    unsigned count;
+    unsigned dropped;
+    FuxiTorchAuditEvent events[FUXI_TORCH_AUDIT_CAPACITY];
+} FuxiTorchAudit;
+
+static inline void fuxi_torch_audit_begin(FuxiTorchAudit *audit, uint64_t now)
+{
+    if (!audit) return;
+    audit->started = now;
+    audit->count = 0;
+    audit->dropped = 0;
+}
+
+static inline void fuxi_torch_audit_record(FuxiTorchAudit *audit, unsigned operation,
+    unsigned offset, uint8_t value, int result, uint64_t now)
+{
+    if (!audit) return;
+    if (audit->count >= FUXI_TORCH_AUDIT_CAPACITY) {
+        if (audit->dropped != UINT32_MAX) audit->dropped++;
+        return;
+    }
+    FuxiTorchAuditEvent *event = &audit->events[audit->count++];
+    event->operation = operation;
+    event->offset = offset;
+    event->value = value;
+    event->result = result;
+    event->elapsed_us = now >= audit->started ? (now - audit->started) / 1000 : UINT64_MAX;
+}
+#endif
diff --git a/xnu/fuxi-adsp/fuxi_torch_pulse.h b/xnu/fuxi-adsp/fuxi_torch_pulse.h
new file mode 100644
index 0000000..df93326
--- /dev/null
+++ b/xnu/fuxi-adsp/fuxi_torch_pulse.h
@@ -0,0 +1,76 @@
+#ifndef FUXI_TORCH_PULSE_H
+#define FUXI_TORCH_PULSE_H
+#include <stdint.h>
+
+typedef struct {
+    void *context;
+    int (*read)(void *, unsigned, uint8_t *);
+    int (*write)(void *, unsigned, uint8_t);
+    void (*wait_us)(void *, unsigned);
+} FuxiTorchIo;
+
+static inline int fuxi_torch_pulse_level(const FuxiTorchIo *io, unsigned level)
+{
+    static const unsigned registers[] = {0x3e, 0x42, 0x49, 0x4a, 0x46, 0x4e};
+    uint8_t saved[6], value = 0, type = 0, subtype = 0;
+    int result = -1, enabled = 0, restored = 1, disabled = 1;
+    if (!io || !io->read || !io->write || !io->wait_us || level < 1 || level > 4) return -1;
+    if (io->read(io->context, 4, &type) || io->read(io->context, 5, &subtype) ||
+        type != 0x18 || subtype != 7) return -1;
+    for (unsigned index = 0; index < 6; index++) {
+        if (io->read(io->context, registers[index], &saved[index])) return -1;
+    }
+    if ((saved[4] & 0x80) || saved[5]) return -2;
+    for (unsigned index = 0; index < 3; index++) {
+        const unsigned status[] = {6, 7, 9};
+        if (io->read(io->context, status[index], &value) || value) return -2;
+    }
+    const uint8_t setup[] = {0x8a, (uint8_t)(level * 4 - 1),
+        (uint8_t)(saved[2] | 1), (uint8_t)((saved[3] & ~7u) | 1)};
+    for (unsigned index = 0; index < 4; index++) {
+        if (io->write(io->context, registers[index], setup[index]) ||
+            io->read(io->context, registers[index], &value) || value != setup[index]) {
+            result = -3;
+            goto cleanup;
+        }
+    }
+    if (io->write(io->context, 0x46, saved[4] | 0x80) ||
+        io->read(io->context, 0x46, &value) || value != (uint8_t)(saved[4] | 0x80)) {
+        result = -4;
+        goto cleanup;
+    }
+    enabled = 1;
+    if (io->write(io->context, 0x4e, 1) ||
+        io->read(io->context, 0x4e, &value) || value != 1) {
+        result = -4;
+        goto cleanup;
+    }
+    io->wait_us(io->context, 80000);
+    result = 0;
+    for (unsigned index = 0; index < 3; index++) {
+        const unsigned status[] = {6, 7, 9};
+        if (io->read(io->context, status[index], &value) || value) result = -5;
+    }
+cleanup:
+    if (io->write(io->context, 0x4e, 0)) restored = 0;
+    if (io->write(io->context, 0x46, saved[4])) restored = 0;
+    if (io->read(io->context, 0x4e, &value) || value) disabled = 0;
+    if (io->read(io->context, 0x46, &value) || value != saved[4]) disabled = 0;
+    if (!disabled) {
+        if (enabled) io->wait_us(io->context, 110000);
+        return -6;
+    }
+    for (unsigned index = 0; index < 4; index++) {
+        if (io->write(io->context, registers[index], saved[index])) restored = 0;
+    }
+    for (unsigned index = 0; index < 6; index++) {
+        if (io->read(io->context, registers[index], &value) || value != saved[index]) restored = 0;
+    }
+    return restored ? result : -6;
+}
+
+static inline int fuxi_torch_pulse(const FuxiTorchIo *io)
+{
+    return fuxi_torch_pulse_level(io, 2);
+}
+#endif
diff --git a/xnu/fuxi-adsp/fuxi_torch_runtime.h b/xnu/fuxi-adsp/fuxi_torch_runtime.h
new file mode 100644
index 0000000..6bd480a
--- /dev/null
+++ b/xnu/fuxi-adsp/fuxi_torch_runtime.h
@@ -0,0 +1,37 @@
+#ifndef FUXI_TORCH_RUNTIME_H
+#define FUXI_TORCH_RUNTIME_H
+#include <stdint.h>
+
+typedef struct {
+    unsigned level;
+    unsigned failed;
+    uint64_t pulses;
+    uint64_t deadline;
+} FuxiTorchRuntime;
+
+static inline int fuxi_torch_caller_allowed(unsigned root, unsigned platform, const char *name)
+{
+    if (root) return 1;
+    if (!platform || !name) return 0;
+    const char expected[] = "SpringBoard";
+    unsigned index = 0;
+    for (; expected[index]; index++) {
+        if (name[index] != expected[index]) return 0;
+    }
+    return name[index] == 0;
+}
+
+static inline int fuxi_torch_request(FuxiTorchRuntime *state, unsigned level, uint64_t now)
+{
+    if (!state || level > 4 || (level && (state->failed || now > UINT64_MAX - 2000000000ull))) return -1;
+    state->level = level;
+    state->deadline = level ? now + 2000000000ull : 0;
+    return 0;
+}
+
+static inline unsigned fuxi_torch_requested(FuxiTorchRuntime *state, uint64_t now)
+{
+    if (state->failed || (state->level && now >= state->deadline)) state->level = 0;
+    return state->level;
+}
+#endif
diff --git a/xnu/fuxi-audio-prep/fuxi_audio_prep_gpr.c b/xnu/fuxi-audio-prep/fuxi_audio_prep_gpr.c
new file mode 100644
index 0000000..6a6ef61
--- /dev/null
+++ b/xnu/fuxi-audio-prep/fuxi_audio_prep_gpr.c
@@ -0,0 +1,151 @@
+#include "fuxi_audio_prep_gpr.h"
+
+#include <string.h>
+
+static uint32_t read_le32(const uint8_t *input)
+{
+    return (uint32_t)input[0] | ((uint32_t)input[1] << 8) |
+        ((uint32_t)input[2] << 16) | ((uint32_t)input[3] << 24);
+}
+
+static void write_le32(uint8_t *output, uint32_t value)
+{
+    output[0] = (uint8_t)value;
+    output[1] = (uint8_t)(value >> 8);
+    output[2] = (uint8_t)(value >> 16);
+    output[3] = (uint8_t)(value >> 24);
+}
+
+int fuxi_audio_prep_gpr_encode(uint8_t *output, size_t capacity,
+    const FuxiAudioPrepGprFields *fields, const void *payload,
+    size_t payload_bytes, size_t *written)
+{
+    FuxiAudioPrepGprFields header;
+    size_t packet_bytes;
+
+    if (!output || !fields || !written || (payload_bytes && !payload)) {
+        return FuxiAudioPrepArgument;
+    }
+    if (fields->dst_domain > UINT8_MAX || fields->src_domain > UINT8_MAX ||
+        payload_bytes > FUXI_AUDIO_PREP_GPR_MAX_BYTES - FUXI_AUDIO_PREP_GPR_HEADER_BYTES) {
+        return FuxiAudioPrepRange;
+    }
+    packet_bytes = FUXI_AUDIO_PREP_GPR_HEADER_BYTES + payload_bytes;
+    if (packet_bytes > capacity) {
+        return FuxiAudioPrepCapacity;
+    }
+
+    header = *fields;
+    if (payload_bytes) {
+        memmove(output + FUXI_AUDIO_PREP_GPR_HEADER_BYTES, payload, payload_bytes);
+    }
+    write_le32(output, ((uint32_t)packet_bytes << 8) | 0x60u);
+    write_le32(output + 4, header.dst_domain | (header.src_domain << 8));
+    write_le32(output + 8, header.src_port);
+    write_le32(output + 12, header.dst_port);
+    write_le32(output + 16, header.token);
+    write_le32(output + 20, header.opcode);
+    *written = packet_bytes;
+    return FuxiAudioPrepOk;
+}
+
+int fuxi_audio_prep_gpr_decode(const uint8_t *input, size_t length,
+    FuxiAudioPrepGprView *view)
+{
+    FuxiAudioPrepGprView decoded;
+    uint32_t size_word;
+    uint32_t domain_word;
+
+    if (!input || !view) {
+        return FuxiAudioPrepArgument;
+    }
+    if (length < FUXI_AUDIO_PREP_GPR_HEADER_BYTES) {
+        return FuxiAudioPrepShort;
+    }
+    if (length > FUXI_AUDIO_PREP_GPR_MAX_BYTES) {
+        return FuxiAudioPrepLength;
+    }
+    size_word = read_le32(input);
+    domain_word = read_le32(input + 4);
+    if ((size_word & 0xfu) != 0) {
+        return FuxiAudioPrepVersion;
+    }
+    decoded.header_bytes = ((size_word >> 4) & 0xfu) * 4u;
+    decoded.packet_bytes = size_word >> 8;
+    if (decoded.header_bytes < FUXI_AUDIO_PREP_GPR_HEADER_BYTES) {
+        return FuxiAudioPrepHeader;
+    }
+    if (decoded.packet_bytes != length || decoded.header_bytes > length) {
+        return FuxiAudioPrepLength;
+    }
+    if (domain_word >> 16) {
+        return FuxiAudioPrepReserved;
+    }
+    decoded.fields.dst_domain = domain_word & 0xffu;
+    decoded.fields.src_domain = (domain_word >> 8) & 0xffu;
+    decoded.fields.src_port = read_le32(input + 8);
+    decoded.fields.dst_port = read_le32(input + 12);
+    decoded.fields.token = read_le32(input + 16);
+    decoded.fields.opcode = read_le32(input + 20);
+    decoded.payload = input + decoded.header_bytes;
+    decoded.payload_bytes = length - decoded.header_bytes;
+    *view = decoded;
+    return FuxiAudioPrepOk;
+}
+
+int fuxi_audio_prep_spf_query(uint8_t *output, size_t capacity,
+    uint32_t local_port, uint32_t token, size_t *written)
+{
+    const uint8_t command_header[FUXI_AUDIO_PREP_APM_HEADER_BYTES] = {0};
+    const FuxiAudioPrepGprFields fields = {
+        FUXI_AUDIO_PREP_DOMAIN_ADSP, FUXI_AUDIO_PREP_DOMAIN_APPS,
+        local_port, FUXI_AUDIO_PREP_APM_PORT, token, FUXI_AUDIO_PREP_GET_SPF_STATE
+    };
+
+    return fuxi_audio_prep_gpr_encode(output, capacity, &fields,
+        command_header, sizeof(command_header), written);
+}
+
+int fuxi_audio_prep_spf_reply(const uint8_t *input, size_t length,
+    uint32_t local_port, uint32_t token, FuxiAudioPrepSpfReply *reply)
+{
+    FuxiAudioPrepGprView view;
+    FuxiAudioPrepSpfReply decoded = {FuxiAudioPrepSpfState, 0, 0};
+    int result;
+
+    if (!reply) {
+        return FuxiAudioPrepArgument;
+    }
+    result = fuxi_audio_prep_gpr_decode(input, length, &view);
+    if (result != FuxiAudioPrepOk) {
+        return result;
+    }
+    if (view.fields.src_domain != FUXI_AUDIO_PREP_DOMAIN_ADSP ||
+        view.fields.dst_domain != FUXI_AUDIO_PREP_DOMAIN_APPS ||
+        view.fields.src_port != FUXI_AUDIO_PREP_APM_PORT ||
+        view.fields.dst_port != local_port || view.fields.token != token) {
+        return FuxiAudioPrepRoute;
+    }
+    switch (view.fields.opcode) {
+    case FUXI_AUDIO_PREP_SPF_STATE_REPLY:
+        if (view.payload_bytes != 4) {
+            return FuxiAudioPrepPayload;
+        }
+        decoded.state = read_le32(view.payload);
+        break;
+    case FUXI_AUDIO_PREP_BASIC_RESULT:
+        if (view.payload_bytes != 8) {
+            return FuxiAudioPrepPayload;
+        }
+        if (read_le32(view.payload) != FUXI_AUDIO_PREP_GET_SPF_STATE) {
+            return FuxiAudioPrepOpcode;
+        }
+        decoded.status = read_le32(view.payload + 4);
+        decoded.kind = decoded.status ? FuxiAudioPrepSpfRemoteError : FuxiAudioPrepSpfAccepted;
+        break;
+    default:
+        return FuxiAudioPrepOpcode;
+    }
+    *reply = decoded;
+    return FuxiAudioPrepOk;
+}
diff --git a/xnu/fuxi-audio-prep/fuxi_audio_prep_gpr.h b/xnu/fuxi-audio-prep/fuxi_audio_prep_gpr.h
new file mode 100644
index 0000000..b92edaf
--- /dev/null
+++ b/xnu/fuxi-audio-prep/fuxi_audio_prep_gpr.h
@@ -0,0 +1,79 @@
+#ifndef FUXI_AUDIO_PREP_GPR_H
+#define FUXI_AUDIO_PREP_GPR_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define FUXI_AUDIO_PREP_GPR_HEADER_BYTES 24u
+#define FUXI_AUDIO_PREP_GPR_MAX_BYTES 560u
+#define FUXI_AUDIO_PREP_APM_HEADER_BYTES 16u
+#define FUXI_AUDIO_PREP_DOMAIN_ADSP 2u
+#define FUXI_AUDIO_PREP_DOMAIN_APPS 3u
+#define FUXI_AUDIO_PREP_APM_PORT 1u
+#define FUXI_AUDIO_PREP_GET_SPF_STATE 0x01001021u
+#define FUXI_AUDIO_PREP_SPF_STATE_REPLY 0x02001007u
+#define FUXI_AUDIO_PREP_BASIC_RESULT 0x02001005u
+
+enum FuxiAudioPrepResult {
+    FuxiAudioPrepOk = 0,
+    FuxiAudioPrepArgument = -1,
+    FuxiAudioPrepShort = -2,
+    FuxiAudioPrepVersion = -3,
+    FuxiAudioPrepHeader = -4,
+    FuxiAudioPrepLength = -5,
+    FuxiAudioPrepReserved = -6,
+    FuxiAudioPrepRoute = -7,
+    FuxiAudioPrepOpcode = -8,
+    FuxiAudioPrepPayload = -9,
+    FuxiAudioPrepCapacity = -10,
+    FuxiAudioPrepRange = -11
+};
+
+typedef struct {
+    uint32_t dst_domain;
+    uint32_t src_domain;
+    uint32_t src_port;
+    uint32_t dst_port;
+    uint32_t token;
+    uint32_t opcode;
+} FuxiAudioPrepGprFields;
+
+typedef struct {
+    FuxiAudioPrepGprFields fields;
+    size_t header_bytes;
+    size_t packet_bytes;
+    const uint8_t *payload;
+    size_t payload_bytes;
+} FuxiAudioPrepGprView;
+
+enum FuxiAudioPrepSpfReplyKind {
+    FuxiAudioPrepSpfState,
+    FuxiAudioPrepSpfAccepted,
+    FuxiAudioPrepSpfRemoteError
+};
+
+typedef struct {
+    enum FuxiAudioPrepSpfReplyKind kind;
+    uint32_t state;
+    uint32_t status;
+} FuxiAudioPrepSpfReply;
+
+int fuxi_audio_prep_gpr_encode(uint8_t *output, size_t capacity,
+    const FuxiAudioPrepGprFields *fields, const void *payload,
+    size_t payload_bytes, size_t *written);
+int fuxi_audio_prep_gpr_decode(const uint8_t *input, size_t length,
+    FuxiAudioPrepGprView *view);
+int fuxi_audio_prep_spf_query(uint8_t *output, size_t capacity,
+    uint32_t local_port, uint32_t token, size_t *written);
+int fuxi_audio_prep_spf_reply(const uint8_t *input, size_t length,
+    uint32_t local_port, uint32_t token, FuxiAudioPrepSpfReply *reply);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/xnu/fuxi-audio-prep/test_gpr.c b/xnu/fuxi-audio-prep/test_gpr.c
new file mode 100644
index 0000000..3f7cdbd
--- /dev/null
+++ b/xnu/fuxi-audio-prep/test_gpr.c
@@ -0,0 +1,302 @@
+#include "fuxi_audio_prep_gpr.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static unsigned checks;
+
+#define CHECK(condition) do { \
+    checks++; \
+    if (!(condition)) { \
+        fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); \
+        exit(1); \
+    } \
+} while (0)
+
+static const uint8_t golden_query[40] = {
+    0x60, 0x28, 0x00, 0x00, 0x02, 0x03, 0x00, 0x00,
+    0x78, 0x56, 0x34, 0x12, 0x01, 0x00, 0x00, 0x00,
+    0xef, 0xcd, 0xab, 0x89, 0x21, 0x10, 0x00, 0x01,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
+};
+
+static const uint8_t golden_state[28] = {
+    0x60, 0x1c, 0x00, 0x00, 0x03, 0x02, 0x00, 0x00,
+    0x01, 0x00, 0x00, 0x00, 0x78, 0x56, 0x34, 0x12,
+    0xef, 0xcd, 0xab, 0x89, 0x07, 0x10, 0x00, 0x02,
+    0x01, 0x00, 0x00, 0x00
+};
+
+static void set_word(uint8_t *output, uint32_t value)
+{
+    output[0] = (uint8_t)value;
+    output[1] = (uint8_t)(value >> 8);
+    output[2] = (uint8_t)(value >> 16);
+    output[3] = (uint8_t)(value >> 24);
+}
+
+static void test_golden_and_roundtrip(void)
+{
+    uint8_t storage[FUXI_AUDIO_PREP_GPR_MAX_BYTES + 2];
+    uint8_t payload[FUXI_AUDIO_PREP_GPR_MAX_BYTES];
+    FuxiAudioPrepGprView view;
+    FuxiAudioPrepGprFields fields = {2, 3, 0x12345678, 1, 0x89abcdef, 0x01001021};
+    size_t written = 0;
+
+    memset(storage, 0xa5, sizeof(storage));
+    CHECK(fuxi_audio_prep_spf_query(storage + 1, 40, fields.src_port,
+        fields.token, &written) == FuxiAudioPrepOk);
+    CHECK(written == sizeof(golden_query));
+    CHECK(memcmp(storage + 1, golden_query, written) == 0);
+    CHECK(storage[0] == 0xa5 && storage[41] == 0xa5);
+    CHECK(fuxi_audio_prep_gpr_decode(storage + 1, written, &view) == FuxiAudioPrepOk);
+    CHECK(view.payload_bytes == 16 && view.header_bytes == 24);
+    CHECK(view.fields.opcode == FUXI_AUDIO_PREP_GET_SPF_STATE);
+    CHECK(view.fields.src_port == fields.src_port && view.fields.token == fields.token);
+
+    for (size_t index = 0; index < sizeof(payload); index++) {
+        payload[index] = (uint8_t)(index * 13u);
+    }
+    for (size_t length = 0; length <= FUXI_AUDIO_PREP_GPR_MAX_BYTES - 24; length++) {
+        CHECK(fuxi_audio_prep_gpr_encode(storage + 1, sizeof(storage) - 2,
+            &fields, payload, length, &written) == FuxiAudioPrepOk);
+        CHECK(fuxi_audio_prep_gpr_decode(storage + 1, written, &view) == FuxiAudioPrepOk);
+        CHECK(view.payload_bytes == length && written == length + 24);
+        CHECK(memcmp(view.payload, payload, length) == 0);
+        CHECK(memcmp(&view.fields, &fields, sizeof(fields)) == 0);
+        CHECK(storage[0] == 0xa5 && storage[sizeof(storage) - 1] == 0xa5);
+    }
+    for (uint32_t domain = 0; domain <= UINT8_MAX; domain++) {
+        fields.src_domain = domain;
+        fields.dst_domain = UINT8_MAX - domain;
+        fields.src_port = UINT32_MAX;
+        fields.token = UINT32_MAX;
+        CHECK(fuxi_audio_prep_gpr_encode(storage, sizeof(storage), &fields,
+            NULL, 0, &written) == FuxiAudioPrepOk);
+        CHECK(fuxi_audio_prep_gpr_decode(storage, written, &view) == FuxiAudioPrepOk);
+        CHECK(memcmp(&view.fields, &fields, sizeof(fields)) == 0);
+    }
+
+    memcpy(storage, golden_query, sizeof(golden_query));
+    memcpy(payload, storage, 32);
+    CHECK(fuxi_audio_prep_gpr_encode(storage, sizeof(storage), &fields,
+        storage, 32, &written) == FuxiAudioPrepOk);
+    CHECK(memcmp(storage + 24, payload, 32) == 0);
+    memcpy(payload, storage + 28, 32);
+    CHECK(fuxi_audio_prep_gpr_encode(storage, sizeof(storage), &fields,
+        storage + 28, 32, &written) == FuxiAudioPrepOk);
+    CHECK(memcmp(storage + 24, payload, 32) == 0);
+}
+
+static void test_encode_failures(void)
+{
+    uint8_t output[64];
+    uint8_t before[64];
+    FuxiAudioPrepGprFields fields = {2, 3, 1, 1, 0, 0x01001021};
+    size_t written = 123;
+
+    memset(output, 0xa5, sizeof(output));
+    memcpy(before, output, sizeof(output));
+    CHECK(fuxi_audio_prep_gpr_encode(NULL, 64, &fields, NULL, 0, &written) == FuxiAudioPrepArgument);
+    CHECK(fuxi_audio_prep_gpr_encode(output, 64, NULL, NULL, 0, &written) == FuxiAudioPrepArgument);
+    CHECK(fuxi_audio_prep_gpr_encode(output, 64, &fields, NULL, 1, &written) == FuxiAudioPrepArgument);
+    CHECK(fuxi_audio_prep_gpr_encode(output, 64, &fields, NULL, 0, NULL) == FuxiAudioPrepArgument);
+    CHECK(fuxi_audio_prep_gpr_encode(output, 23, &fields, NULL, 0, &written) == FuxiAudioPrepCapacity);
+    CHECK(fuxi_audio_prep_spf_query(output, 39, 1, 0, &written) == FuxiAudioPrepCapacity);
+    CHECK(fuxi_audio_prep_gpr_encode(output, SIZE_MAX, &fields, output,
+        SIZE_MAX, &written) == FuxiAudioPrepRange);
+    CHECK(fuxi_audio_prep_gpr_encode(output, SIZE_MAX, &fields, output,
+        537, &written) == FuxiAudioPrepRange);
+    fields.src_domain = 256;
+    CHECK(fuxi_audio_prep_gpr_encode(output, 64, &fields, NULL, 0, &written) == FuxiAudioPrepRange);
+    fields.src_domain = 3;
+    fields.dst_domain = UINT32_MAX;
+    CHECK(fuxi_audio_prep_gpr_encode(output, 64, &fields, NULL, 0, &written) == FuxiAudioPrepRange);
+    CHECK(written == 123 && memcmp(output, before, sizeof(output)) == 0);
+}
+
+static void expect_decode_failure(const uint8_t *input, size_t length, int expected)
+{
+    FuxiAudioPrepGprView view;
+    unsigned char before[sizeof(view)];
+
+    memset(&view, 0xa5, sizeof(view));
+    memcpy(before, &view, sizeof(view));
+    CHECK(fuxi_audio_prep_gpr_decode(input, length, &view) == expected);
+    CHECK(memcmp(&view, before, sizeof(view)) == 0);
+}
+
+static void test_decode_boundaries(void)
+{
+    uint8_t input[64];
+    FuxiAudioPrepGprView view;
+
+    expect_decode_failure(NULL, 0, FuxiAudioPrepArgument);
+    CHECK(fuxi_audio_prep_gpr_decode(golden_query, 40, NULL) == FuxiAudioPrepArgument);
+    expect_decode_failure(golden_query, SIZE_MAX, FuxiAudioPrepLength);
+    for (size_t length = 0; length < sizeof(golden_query); length++) {
+        uint8_t *exact = malloc(length ? length : 1);
+        CHECK(exact != NULL);
+        memcpy(exact, golden_query, length);
+        expect_decode_failure(exact, length,
+            length < 24 ? FuxiAudioPrepShort : FuxiAudioPrepLength);
+        free(exact);
+    }
+    memcpy(input, golden_query, 40);
+    input[40] = 0;
+    expect_decode_failure(input, 41, FuxiAudioPrepLength);
+    for (uint32_t version = 1; version < 16; version++) {
+        input[0] = (uint8_t)(0x60u | version);
+        expect_decode_failure(input, 40, FuxiAudioPrepVersion);
+    }
+    input[0] = 0x60;
+    input[6] = 1;
+    expect_decode_failure(input, 40, FuxiAudioPrepReserved);
+    input[6] = 0;
+    input[7] = 0x80;
+    expect_decode_failure(input, 40, FuxiAudioPrepReserved);
+    input[7] = 0;
+    for (uint32_t words = 0; words < 16; words++) {
+        set_word(input, (40u << 8) | (words << 4));
+        if (words < 6) {
+            expect_decode_failure(input, 40, FuxiAudioPrepHeader);
+        } else if (words > 10) {
+            expect_decode_failure(input, 40, FuxiAudioPrepLength);
+        } else {
+            CHECK(fuxi_audio_prep_gpr_decode(input, 40, &view) == FuxiAudioPrepOk);
+            CHECK(view.header_bytes == words * 4u && view.payload_bytes == 40u - words * 4u);
+        }
+    }
+    set_word(input, (0xffffffu << 8) | 0x60u);
+    expect_decode_failure(input, 40, FuxiAudioPrepLength);
+    for (uint32_t bytes = 0; bytes < 64; bytes++) {
+        set_word(input, (bytes << 8) | 0x60u);
+        if (bytes != 40) {
+            expect_decode_failure(input, 40, FuxiAudioPrepLength);
+        }
+    }
+    for (uint32_t words = 6; words < 16; words++) {
+        memset(input, 0, sizeof(input));
+        set_word(input, ((words * 4u) << 8) | (words << 4));
+        CHECK(fuxi_audio_prep_gpr_decode(input, words * 4u, &view) == FuxiAudioPrepOk);
+        CHECK(view.payload_bytes == 0 && view.payload == input + words * 4u);
+    }
+}
+
+static void expect_reply_failure(const uint8_t *input, size_t length, int expected)
+{
+    FuxiAudioPrepSpfReply reply = {FuxiAudioPrepSpfRemoteError, 44, 55};
+
+    CHECK(fuxi_audio_prep_spf_reply(input, length, 0x12345678, 0x89abcdef, &reply) == expected);
+    CHECK(reply.kind == FuxiAudioPrepSpfRemoteError && reply.state == 44 && reply.status == 55);
+}
+
+static void test_spf_replies(void)
+{
+    uint8_t input[64];
+    uint8_t payload[12] = {0x21, 0x10, 0x00, 0x01};
+    FuxiAudioPrepGprFields fields = {3, 2, 1, 0x12345678, 0x89abcdef, FUXI_AUDIO_PREP_BASIC_RESULT};
+    FuxiAudioPrepSpfReply reply;
+    size_t written;
+    const size_t route_offsets[] = {4, 5, 8, 12, 16};
+
+    CHECK(fuxi_audio_prep_spf_reply(golden_state, sizeof(golden_state),
+        fields.dst_port, fields.token, &reply) == FuxiAudioPrepOk);
+    CHECK(reply.kind == FuxiAudioPrepSpfState && reply.state == 1 && reply.status == 0);
+    memcpy(input, golden_state, sizeof(golden_state));
+    input[24] = 0;
+    CHECK(fuxi_audio_prep_spf_reply(input, 28, fields.dst_port,
+        fields.token, &reply) == FuxiAudioPrepOk);
+    CHECK(reply.kind == FuxiAudioPrepSpfState && reply.state == 0);
+    input[24] = 2;
+    CHECK(fuxi_audio_prep_spf_reply(input, 28, fields.dst_port,
+        fields.token, &reply) == FuxiAudioPrepOk);
+    CHECK(reply.state == 2);
+    for (size_t index = 0; index < sizeof(route_offsets) / sizeof(route_offsets[0]); index++) {
+        memcpy(input, golden_state, sizeof(golden_state));
+        input[route_offsets[index]] ^= 1;
+        expect_reply_failure(input, 28, FuxiAudioPrepRoute);
+    }
+    memcpy(input, golden_state, sizeof(golden_state));
+    input[20] ^= 1;
+    expect_reply_failure(input, 28, FuxiAudioPrepOpcode);
+    expect_reply_failure(golden_state, 27, FuxiAudioPrepLength);
+    CHECK(fuxi_audio_prep_spf_reply(golden_state, 28, fields.dst_port,
+        fields.token, NULL) == FuxiAudioPrepArgument);
+
+    for (size_t length = 0; length <= sizeof(payload); length++) {
+        CHECK(fuxi_audio_prep_gpr_encode(input, sizeof(input), &fields,
+            payload, length, &written) == FuxiAudioPrepOk);
+        if (length != 8) {
+            expect_reply_failure(input, written, FuxiAudioPrepPayload);
+        } else {
+            CHECK(fuxi_audio_prep_spf_reply(input, written, fields.dst_port,
+                fields.token, &reply) == FuxiAudioPrepOk);
+            CHECK(reply.kind == FuxiAudioPrepSpfAccepted && reply.state == 0 && reply.status == 0);
+        }
+    }
+    payload[4] = 7;
+    CHECK(fuxi_audio_prep_gpr_encode(input, sizeof(input), &fields,
+        payload, 8, &written) == FuxiAudioPrepOk);
+    CHECK(fuxi_audio_prep_spf_reply(input, written, fields.dst_port,
+        fields.token, &reply) == FuxiAudioPrepOk);
+    CHECK(reply.kind == FuxiAudioPrepSpfRemoteError && reply.status == 7);
+    payload[0] ^= 1;
+    CHECK(fuxi_audio_prep_gpr_encode(input, sizeof(input), &fields,
+        payload, 8, &written) == FuxiAudioPrepOk);
+    expect_reply_failure(input, written, FuxiAudioPrepOpcode);
+    fields.opcode = FUXI_AUDIO_PREP_SPF_STATE_REPLY;
+    for (size_t length = 0; length <= sizeof(payload); length++) {
+        CHECK(fuxi_audio_prep_gpr_encode(input, sizeof(input), &fields,
+            payload, length, &written) == FuxiAudioPrepOk);
+        if (length != 4) {
+            expect_reply_failure(input, written, FuxiAudioPrepPayload);
+        }
+    }
+}
+
+static void test_header_mutations(void)
+{
+    uint8_t input[40];
+    FuxiAudioPrepGprView view;
+    FuxiAudioPrepSpfReply reply;
+
+    for (size_t offset = 0; offset < 24; offset++) {
+        for (unsigned value = 0; value <= UINT8_MAX; value++) {
+            int result;
+            memcpy(input, golden_query, sizeof(input));
+            input[offset] = (uint8_t)value;
+            result = fuxi_audio_prep_gpr_decode(input, sizeof(input), &view);
+            if (result == FuxiAudioPrepOk) {
+                CHECK(view.header_bytes >= 24 && view.header_bytes <= sizeof(input));
+                CHECK(view.payload == input + view.header_bytes);
+                CHECK(view.payload_bytes == sizeof(input) - view.header_bytes);
+            } else {
+                CHECK(result >= FuxiAudioPrepReserved && result <= FuxiAudioPrepShort);
+            }
+            memcpy(input, golden_state, sizeof(golden_state));
+            input[offset] = (uint8_t)value;
+            result = fuxi_audio_prep_spf_reply(input, sizeof(golden_state),
+                0x12345678, 0x89abcdef, &reply);
+            if (result == FuxiAudioPrepOk) {
+                CHECK(reply.kind == FuxiAudioPrepSpfState && reply.state == 1);
+                CHECK(memcmp(input, golden_state, sizeof(golden_state)) == 0);
+            } else {
+                CHECK(result < 0);
+            }
+        }
+    }
+}
+
+int main(void)
+{
+    test_golden_and_roundtrip();
+    test_encode_failures();
+    test_decode_boundaries();
+    test_spf_replies();
+    test_header_mutations();
+    printf("PASS fuxi-audio-prep GPR: %u checks\n", checks);
+    return 0;
+}
diff --git a/xnu/fuxi-battery-prep/fuxi_battery_freshness.c b/xnu/fuxi-battery-prep/fuxi_battery_freshness.c
new file mode 100644
index 0000000..8628d4c
--- /dev/null
+++ b/xnu/fuxi-battery-prep/fuxi_battery_freshness.c
@@ -0,0 +1,168 @@
+#include "fuxi_battery_freshness.h"
+
+_Static_assert(BmFields <= 32, "Battery freshness mask supports at most 32 fields");
+
+int fuxi_battery_prep_init(FuxiBatteryFreshness *state)
+{
+    if (!state) {
+        return FuxiBatteryPrepArgument;
+    }
+    const FuxiBatteryFreshness initial = {0};
+    *state = initial;
+    return FuxiBatteryPrepOk;
+}
+
+int fuxi_battery_prep_channel(FuxiBatteryFreshness *state, int up)
+{
+    if (!state) {
+        return FuxiBatteryPrepArgument;
+    }
+    up = up != 0;
+    if (state->channel_up == up) {
+        return FuxiBatteryPrepOk;
+    }
+    state->channel_up = 0;
+    state->observed_fields = 0;
+    if (state->generation == UINT64_MAX) {
+        return FuxiBatteryPrepGeneration;
+    }
+    state->generation++;
+    state->channel_up = up;
+    return FuxiBatteryPrepOk;
+}
+
+int fuxi_battery_prep_observe(FuxiBatteryFreshness *state,
+    uint64_t generation, unsigned field, uint64_t now_ms, int success)
+{
+    uint32_t bit;
+
+    if (!state || field >= BmFields) {
+        return FuxiBatteryPrepArgument;
+    }
+    if (!state->channel_up) {
+        return FuxiBatteryPrepDisconnected;
+    }
+    if (generation != state->generation) {
+        return FuxiBatteryPrepGeneration;
+    }
+    if (!success) {
+        return FuxiBatteryPrepOk;
+    }
+    bit = UINT32_C(1) << field;
+    if ((state->observed_fields & bit) && now_ms < state->successful_at_ms[field]) {
+        return FuxiBatteryPrepTime;
+    }
+    state->successful_at_ms[field] = now_ms;
+    state->observed_fields |= bit;
+    return FuxiBatteryPrepOk;
+}
+
+int fuxi_battery_prep_decide(const FuxiBatteryFreshness *state,
+    uint64_t now_ms, uint64_t max_age_ms, FuxiBatteryPublishDecision *decision)
+{
+    FuxiBatteryPublishDecision result = {0, 0, 0, 0};
+
+    if (!state || !decision || !max_age_ms) {
+        return FuxiBatteryPrepArgument;
+    }
+    if (state->channel_up) {
+        for (unsigned field = 0; field < BmFields; field++) {
+            const uint32_t bit = UINT32_C(1) << field;
+            const uint64_t sampled_at = state->successful_at_ms[field];
+            if ((state->observed_fields & bit) && now_ms >= sampled_at &&
+                now_ms - sampled_at < max_age_ms) {
+                result.fresh_fields |= bit;
+            }
+        }
+    }
+    result.update_capacity = (result.fresh_fields & (UINT32_C(1) << BmCapacity)) != 0;
+    result.update_external = (result.fresh_fields & (UINT32_C(1) << BmUsbOnline)) != 0;
+    result.update_charging = result.update_external &&
+        (result.fresh_fields & (UINT32_C(1) << BmStatus)) != 0;
+    *decision = result;
+    return FuxiBatteryPrepOk;
+}
+
+void fuxi_battery_prep_merge(FuxiAdspBattery *shown, const FuxiAdspBattery *incoming)
+{
+    if (!shown || !incoming) {
+        return;
+    }
+    if (incoming->soc_known) {
+        shown->percent = incoming->percent;
+    }
+    if (incoming->fresh_fields & (UINT32_C(1) << BmPresent)) {
+        shown->present = incoming->present;
+    }
+    if (incoming->voltage_valid) {
+        shown->voltage_mv = incoming->voltage_mv;
+    }
+    if (incoming->current_valid) {
+        shown->current_ma = incoming->current_ma;
+    }
+    if (incoming->temperature_valid) {
+        shown->temperature = incoming->temperature;
+    }
+    if (incoming->fresh_fields & (UINT32_C(1) << BmGauge1Remaining)) {
+        shown->raw_mah = incoming->raw_mah;
+    }
+    if (incoming->fresh_fields & (UINT32_C(1) << BmFull)) {
+        shown->full_mah = incoming->full_mah;
+    }
+    if (incoming->fresh_fields & (UINT32_C(1) << BmDesign)) {
+        shown->design_mah = incoming->design_mah;
+    }
+    if (incoming->fresh_fields & (UINT32_C(1) << BmCycles)) {
+        shown->cycles = incoming->cycles;
+    }
+    if (incoming->fresh_fields & (UINT32_C(1) << BmTimeToEmpty)) {
+        shown->minutes_to_empty = incoming->minutes_to_empty;
+    }
+    if (incoming->fresh_fields & (UINT32_C(1) << BmTimeToFull)) {
+        shown->minutes_to_full = incoming->minutes_to_full;
+    }
+    if (incoming->external_known) {
+        shown->external = incoming->external;
+        if (!incoming->external) {
+            shown->charging = 0;
+            shown->fully_charged = 0;
+            shown->adapter_family = 0;
+            shown->adapter_mv = 0;
+            shown->adapter_ma = 0;
+            shown->adapter_watts = 0;
+        } else {
+            if (incoming->fresh_fields & (UINT32_C(1) << BmUsbAdapter)) {
+                shown->adapter_family = incoming->adapter_family;
+            }
+            if (incoming->fresh_fields & (UINT32_C(1) << BmUsbVoltage)) {
+                shown->adapter_mv = incoming->adapter_mv;
+            }
+            if (incoming->fresh_fields & (UINT32_C(1) << BmUsbCurrent)) {
+                shown->adapter_ma = incoming->adapter_ma;
+            }
+            if ((incoming->fresh_fields & (UINT32_C(1) << BmUsbVoltage)) &&
+                (incoming->fresh_fields & (UINT32_C(1) << BmUsbCurrent))) {
+                shown->adapter_watts = incoming->adapter_watts;
+            }
+        }
+    }
+    if (incoming->status_known) {
+        shown->charging = incoming->charging;
+        shown->fully_charged = incoming->fully_charged;
+    }
+    shown->sequence = incoming->sequence;
+    shown->generation = incoming->generation;
+    shown->fresh_fields = incoming->fresh_fields;
+    shown->max_age_ms = incoming->max_age_ms;
+    shown->soc_age_ms = incoming->soc_age_ms;
+    shown->external_age_ms = incoming->external_age_ms;
+    shown->status_age_ms = incoming->status_age_ms;
+    shown->soc_known = incoming->soc_known;
+    shown->external_known = incoming->external_known;
+    shown->status_known = incoming->status_known;
+    shown->voltage_valid = incoming->voltage_valid;
+    shown->current_valid = incoming->current_valid;
+    shown->temperature_valid = incoming->temperature_valid;
+    shown->channel_up = incoming->channel_up;
+    shown->stale = incoming->stale;
+}
diff --git a/xnu/fuxi-battery-prep/fuxi_battery_freshness.h b/xnu/fuxi-battery-prep/fuxi_battery_freshness.h
new file mode 100644
index 0000000..e063377
--- /dev/null
+++ b/xnu/fuxi-battery-prep/fuxi_battery_freshness.h
@@ -0,0 +1,46 @@
+#ifndef FUXI_BATTERY_FRESHNESS_H
+#define FUXI_BATTERY_FRESHNESS_H
+
+#include <stdint.h>
+#include "ShengBattmgr.h"
+#include "fuxi_adsp_battery.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum FuxiBatteryPrepResult {
+    FuxiBatteryPrepOk = 0,
+    FuxiBatteryPrepArgument = -1,
+    FuxiBatteryPrepGeneration = -2,
+    FuxiBatteryPrepDisconnected = -3,
+    FuxiBatteryPrepTime = -4
+};
+
+typedef struct {
+    uint64_t generation;
+    uint64_t successful_at_ms[BmFields];
+    uint32_t observed_fields;
+    int channel_up;
+} FuxiBatteryFreshness;
+
+typedef struct {
+    uint32_t fresh_fields;
+    int update_capacity;
+    int update_external;
+    int update_charging;
+} FuxiBatteryPublishDecision;
+
+int fuxi_battery_prep_init(FuxiBatteryFreshness *state);
+int fuxi_battery_prep_channel(FuxiBatteryFreshness *state, int up);
+int fuxi_battery_prep_observe(FuxiBatteryFreshness *state,
+    uint64_t generation, unsigned field, uint64_t now_ms, int success);
+int fuxi_battery_prep_decide(const FuxiBatteryFreshness *state,
+    uint64_t now_ms, uint64_t max_age_ms, FuxiBatteryPublishDecision *decision);
+void fuxi_battery_prep_merge(FuxiAdspBattery *shown, const FuxiAdspBattery *incoming);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/xnu/fuxi-battery-prep/test_freshness.c b/xnu/fuxi-battery-prep/test_freshness.c
new file mode 100644
index 0000000..e298226
--- /dev/null
+++ b/xnu/fuxi-battery-prep/test_freshness.c
@@ -0,0 +1,300 @@
+#include "fuxi_battery_freshness.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static unsigned checks;
+
+#define CHECK(condition) do { \
+    checks++; \
+    if (!(condition)) { \
+        fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #condition); \
+        exit(1); \
+    } \
+} while (0)
+
+static void test_disconnect_and_generation(void)
+{
+    FuxiBatteryFreshness state;
+    FuxiBatteryPublishDecision decision;
+    uint64_t old_generation;
+
+    CHECK(fuxi_battery_prep_init(&state) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_decide(&state, 0, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(decision.fresh_fields == 0);
+    CHECK(fuxi_battery_prep_channel(&state, 1) == FuxiBatteryPrepOk);
+    old_generation = state.generation;
+    CHECK(fuxi_battery_prep_observe(&state, old_generation, BmCapacity, 0, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_observe(&state, old_generation, BmUsbOnline, 0, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_observe(&state, old_generation, BmStatus, 0, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_decide(&state, 1, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(decision.update_capacity && decision.update_external && decision.update_charging);
+    CHECK(fuxi_battery_prep_channel(&state, 0) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_decide(&state, 2, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(decision.fresh_fields == 0 && !decision.update_external && !decision.update_charging);
+    CHECK(fuxi_battery_prep_observe(&state, old_generation, BmUsbOnline, 2, 1) == FuxiBatteryPrepDisconnected);
+    CHECK(fuxi_battery_prep_channel(&state, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_observe(&state, old_generation, BmUsbOnline, 3, 1) == FuxiBatteryPrepGeneration);
+    CHECK(fuxi_battery_prep_decide(&state, 3, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(decision.fresh_fields == 0);
+    CHECK(fuxi_battery_prep_observe(&state, state.generation, BmUsbOnline, 3, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_decide(&state, 3, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(!decision.update_capacity && decision.update_external && !decision.update_charging);
+}
+
+static void test_independent_ages(void)
+{
+    FuxiBatteryFreshness state;
+    FuxiBatteryPublishDecision decision;
+
+    CHECK(fuxi_battery_prep_init(&state) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_channel(&state, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_observe(&state, state.generation, BmUsbOnline, 0, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_observe(&state, state.generation, BmStatus, 0, 1) == FuxiBatteryPrepOk);
+    for (uint64_t now = 1; now <= 200000; now += 1000) {
+        CHECK(fuxi_battery_prep_observe(&state, state.generation, BmCapacity, now, 1) == FuxiBatteryPrepOk);
+        CHECK(fuxi_battery_prep_observe(&state, state.generation, BmUsbOnline, now, 0) == FuxiBatteryPrepOk);
+        CHECK(fuxi_battery_prep_observe(&state, state.generation, BmStatus, now, 0) == FuxiBatteryPrepOk);
+        CHECK(fuxi_battery_prep_decide(&state, now, 90000, &decision) == FuxiBatteryPrepOk);
+        CHECK(decision.update_capacity);
+        CHECK(decision.update_external == (now < 90000));
+        CHECK(decision.update_charging == (now < 90000));
+    }
+    CHECK(fuxi_battery_prep_decide(&state, 90000, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(!decision.update_external && !decision.update_charging);
+}
+
+static void test_real_unplug_policy(void)
+{
+    FuxiBatteryFreshness state;
+    FuxiBatteryPublishDecision decision;
+    int shown_percent = 100;
+    int shown_external = 1;
+    int shown_charging = 1;
+    const int measured_external = 0;
+
+    CHECK(fuxi_battery_prep_init(&state) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_channel(&state, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_observe(&state, state.generation, BmUsbOnline, 100, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_decide(&state, 100, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(decision.update_external && !decision.update_capacity && !decision.update_charging);
+    if (decision.update_external) {
+        shown_external = measured_external;
+        if (!measured_external) {
+            shown_charging = 0;
+        }
+    }
+    CHECK(shown_external == 0 && shown_percent == 100 && shown_charging == 0);
+    CHECK(fuxi_battery_prep_channel(&state, 0) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_decide(&state, 101, 90000, &decision) == FuxiBatteryPrepOk);
+    CHECK(!decision.update_capacity && !decision.update_external && !decision.update_charging);
+    CHECK(shown_external == 0 && shown_percent == 100);
+}
+
+static void test_every_field_and_boundaries(void)
+{
+    FuxiBatteryFreshness state;
+    FuxiBatteryPublishDecision decision;
+    FuxiBatteryPublishDecision before;
+
+    CHECK(fuxi_battery_prep_init(NULL) == FuxiBatteryPrepArgument);
+    CHECK(fuxi_battery_prep_channel(NULL, 1) == FuxiBatteryPrepArgument);
+    CHECK(fuxi_battery_prep_init(&state) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_observe(NULL, 0, 0, 0, 1) == FuxiBatteryPrepArgument);
+    CHECK(fuxi_battery_prep_observe(&state, 0, BmFields, 0, 1) == FuxiBatteryPrepArgument);
+    CHECK(fuxi_battery_prep_decide(&state, 0, 1, NULL) == FuxiBatteryPrepArgument);
+    memset(&decision, 0xa5, sizeof(decision));
+    memcpy(&before, &decision, sizeof(before));
+    CHECK(fuxi_battery_prep_decide(&state, 0, 0, &decision) == FuxiBatteryPrepArgument);
+    CHECK(memcmp(&before, &decision, sizeof(decision)) == 0);
+    for (unsigned field = 0; field < BmFields; field++) {
+        CHECK(fuxi_battery_prep_channel(&state, 0) == FuxiBatteryPrepOk);
+        CHECK(fuxi_battery_prep_channel(&state, 1) == FuxiBatteryPrepOk);
+        CHECK(fuxi_battery_prep_observe(&state, state.generation, field, 100, 1) == FuxiBatteryPrepOk);
+        CHECK(fuxi_battery_prep_decide(&state, 99, 10, &decision) == FuxiBatteryPrepOk);
+        CHECK(decision.fresh_fields == 0);
+        CHECK(fuxi_battery_prep_decide(&state, 109, 10, &decision) == FuxiBatteryPrepOk);
+        CHECK(decision.fresh_fields == (UINT32_C(1) << field));
+        CHECK(fuxi_battery_prep_decide(&state, 110, 10, &decision) == FuxiBatteryPrepOk);
+        CHECK(decision.fresh_fields == 0);
+        CHECK(fuxi_battery_prep_observe(&state, state.generation, field, 99, 1) == FuxiBatteryPrepTime);
+        CHECK(state.successful_at_ms[field] == 100);
+    }
+    CHECK(fuxi_battery_prep_observe(&state, state.generation, BmUsbOnline,
+        UINT64_MAX - 1, 1) == FuxiBatteryPrepOk);
+    CHECK(fuxi_battery_prep_decide(&state, UINT64_MAX, 2, &decision) == FuxiBatteryPrepOk);
+    CHECK(decision.update_external);
+    CHECK(fuxi_battery_prep_decide(&state, 0, UINT64_MAX, &decision) == FuxiBatteryPrepOk);
+    CHECK(decision.fresh_fields == 0);
+    state.generation = UINT64_MAX;
+    CHECK(fuxi_battery_prep_channel(&state, 0) == FuxiBatteryPrepGeneration);
+    CHECK(!state.channel_up && state.observed_fields == 0);
+    CHECK(fuxi_battery_prep_channel(&state, 1) == FuxiBatteryPrepGeneration);
+    CHECK(!state.channel_up);
+}
+
+static void test_production_merge(void)
+{
+    FuxiAdspBattery shown = {0};
+    FuxiAdspBattery incoming = {0};
+
+    shown.percent = 100;
+    shown.voltage_mv = 4200;
+    shown.temperature = 2500;
+    shown.full_mah = shown.design_mah = 5020;
+    shown.present = shown.external = shown.fully_charged = 1;
+    shown.minutes_to_empty = shown.minutes_to_full = -1;
+    incoming.stale = 1;
+    incoming.max_age_ms = FUXI_BATTERY_DEFAULT_MAX_AGE_MS;
+    incoming.soc_age_ms = incoming.external_age_ms = incoming.status_age_ms = ~(uint32_t)0;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.sequence == 0 && shown.stale && !shown.channel_up);
+    CHECK(shown.percent == 100 && shown.voltage_mv == 4200 && shown.temperature == 2500);
+    CHECK(shown.present && shown.external && shown.fully_charged && !shown.charging);
+    CHECK(!shown.soc_known && !shown.external_known && !shown.status_known);
+    CHECK(!shown.voltage_valid && !shown.current_valid && !shown.temperature_valid);
+    CHECK(shown.max_age_ms == 90000 && shown.soc_age_ms == ~(uint32_t)0);
+
+    incoming.sequence = 1;
+    incoming.generation = 1;
+    incoming.channel_up = incoming.soc_known = incoming.external_known = incoming.status_known = 1;
+    incoming.voltage_valid = incoming.current_valid = incoming.temperature_valid = 1;
+    incoming.stale = 0;
+    incoming.fresh_fields = ~(uint32_t)0;
+    incoming.percent = 97;
+    incoming.present = incoming.external = incoming.charging = 1;
+    incoming.voltage_mv = 4300;
+    incoming.current_ma = 100;
+    incoming.temperature = 2800;
+    incoming.raw_mah = 4200;
+    incoming.full_mah = 4500;
+    incoming.design_mah = 4500;
+    incoming.cycles = 83;
+    incoming.minutes_to_empty = 360;
+    incoming.minutes_to_full = 40;
+    incoming.adapter_family = 0xe000400au;
+    incoming.adapter_mv = 9000;
+    incoming.adapter_ma = 2000;
+    incoming.adapter_watts = 18;
+    incoming.soc_age_ms = incoming.external_age_ms = incoming.status_age_ms = 0;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.sequence == 1 && shown.generation == 1 && !shown.stale);
+    CHECK(shown.percent == 97 && shown.external && shown.charging && !shown.fully_charged);
+    CHECK(shown.voltage_mv == 4300 && shown.current_ma == 100 && shown.temperature == 2800);
+    CHECK(shown.raw_mah == 4200 && shown.full_mah == 4500 && shown.design_mah == 4500);
+    CHECK(shown.cycles == 83 && shown.minutes_to_empty == 360 && shown.minutes_to_full == 40);
+    CHECK(shown.adapter_family == 0xe000400au && shown.adapter_watts == 18);
+
+    incoming.sequence++;
+    incoming.percent = 96;
+    incoming.fresh_fields = UINT32_C(1) << BmCapacity;
+    incoming.external_known = incoming.status_known = 0;
+    incoming.voltage_valid = incoming.current_valid = incoming.temperature_valid = 0;
+    incoming.external = incoming.charging = incoming.fully_charged = 0;
+    incoming.present = 0;
+    incoming.voltage_mv = incoming.current_ma = incoming.temperature = 0;
+    incoming.raw_mah = incoming.full_mah = incoming.design_mah = incoming.cycles = 0;
+    incoming.adapter_family = 0;
+    incoming.adapter_mv = incoming.adapter_ma = incoming.adapter_watts = 0;
+    incoming.minutes_to_empty = incoming.minutes_to_full = -1;
+    incoming.external_age_ms = incoming.status_age_ms = 90000;
+    incoming.stale = 1;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.percent == 96 && shown.soc_known && shown.stale);
+    CHECK(shown.present && shown.external && shown.charging && !shown.fully_charged);
+    CHECK(!shown.external_known && !shown.status_known);
+    CHECK(!shown.voltage_valid && !shown.current_valid && !shown.temperature_valid);
+    CHECK(shown.voltage_mv == 4300 && shown.current_ma == 100 && shown.temperature == 2800);
+    CHECK(shown.raw_mah == 4200 && shown.full_mah == 4500 && shown.design_mah == 4500);
+    CHECK(shown.cycles == 83 && shown.minutes_to_empty == 360 && shown.minutes_to_full == 40);
+    CHECK(shown.adapter_family == 0xe000400au && shown.adapter_mv == 9000);
+    CHECK(shown.adapter_ma == 2000 && shown.adapter_watts == 18);
+    CHECK(shown.external_age_ms == 90000 && shown.status_age_ms == 90000);
+
+    incoming.sequence++;
+    incoming.soc_known = 0;
+    incoming.percent = 0;
+    incoming.external_known = incoming.status_known = 1;
+    incoming.fresh_fields = UINT32_C(1) << BmUsbOnline;
+    incoming.external_age_ms = 0;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.percent == 96 && !shown.soc_known && shown.stale);
+    CHECK(shown.external_known && shown.status_known && !shown.external);
+    CHECK(!shown.charging && !shown.fully_charged && shown.present);
+    CHECK(!shown.adapter_family && !shown.adapter_mv && !shown.adapter_ma && !shown.adapter_watts);
+    CHECK(shown.status_age_ms == 90000 && shown.external_age_ms == 0);
+
+    incoming.generation = 2;
+    incoming.channel_up = incoming.external_known = incoming.status_known = 0;
+    incoming.fresh_fields = 0;
+    incoming.external = incoming.charging = incoming.fully_charged = 1;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.generation == 2 && !shown.channel_up && shown.stale);
+    CHECK(!shown.external && !shown.charging && !shown.fully_charged);
+    CHECK(shown.percent == 96 && shown.voltage_mv == 4300 && !shown.voltage_valid);
+    incoming.generation = 3;
+    incoming.channel_up = 1;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.channel_up && shown.generation == 3 && shown.fresh_fields == 0);
+    CHECK(!shown.external_known && !shown.status_known && !shown.external);
+
+    incoming.sequence++;
+    incoming.external_known = 1;
+    incoming.fresh_fields = (UINT32_C(1) << BmUsbOnline) | (UINT32_C(1) << BmUsbVoltage);
+    incoming.adapter_mv = 5000;
+    incoming.adapter_ma = 3000;
+    incoming.adapter_watts = 15;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.external && !shown.status_known && !shown.charging && !shown.fully_charged);
+    CHECK(shown.adapter_mv == 5000 && !shown.adapter_ma && !shown.adapter_watts);
+    incoming.fresh_fields |= UINT32_C(1) << BmUsbCurrent;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.adapter_mv == 5000 && shown.adapter_ma == 3000 && shown.adapter_watts == 15);
+
+    incoming.sequence++;
+    incoming.soc_known = incoming.status_known = incoming.voltage_valid = 1;
+    incoming.current_valid = incoming.temperature_valid = 1;
+    incoming.fresh_fields = ~(uint32_t)0;
+    incoming.percent = 92;
+    incoming.present = 1;
+    incoming.voltage_mv = 4100;
+    incoming.current_ma = 75;
+    incoming.temperature = 2700;
+    incoming.charging = 1;
+    incoming.fully_charged = 0;
+    incoming.stale = 0;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.percent == 92 && !shown.stale && shown.soc_known && shown.voltage_valid);
+    CHECK(shown.external && shown.charging && shown.status_known && !shown.fully_charged);
+    CHECK(shown.current_ma == 75 && shown.current_valid && shown.temperature == 2700);
+    CHECK(shown.temperature_valid && shown.cycles == 0);
+
+    incoming.sequence++;
+    incoming.stale = 1;
+    incoming.soc_known = incoming.external_known = incoming.status_known = 0;
+    incoming.voltage_valid = incoming.current_valid = incoming.temperature_valid = 0;
+    incoming.fresh_fields = 0;
+    incoming.percent = 100;
+    incoming.voltage_mv = 4200;
+    incoming.charging = 0;
+    incoming.fully_charged = 1;
+    fuxi_battery_prep_merge(&shown, &incoming);
+    CHECK(shown.percent == 92 && shown.voltage_mv == 4100 && shown.stale);
+    CHECK(shown.external && shown.charging && !shown.fully_charged);
+    CHECK(!shown.soc_known && !shown.external_known && !shown.status_known);
+    fuxi_battery_prep_merge(NULL, &incoming);
+    fuxi_battery_prep_merge(&shown, NULL);
+    CHECK(shown.percent == 92 && shown.voltage_mv == 4100);
+}
+
+int main(void)
+{
+    test_disconnect_and_generation();
+    test_independent_ages();
+    test_real_unplug_policy();
+    test_every_field_and_boundaries();
+    test_production_merge();
+    printf("PASS fuxi-battery-prep freshness: %u checks\n", checks);
+    return 0;
+}
diff --git a/xnu/fuxi-bluetooth/fuxi_bt.c b/xnu/fuxi-bluetooth/fuxi_bt.c
new file mode 100644
index 0000000..7a549b7
--- /dev/null
+++ b/xnu/fuxi-bluetooth/fuxi_bt.c
@@ -0,0 +1,392 @@
+#include "fuxi_bt.h"
+#include <string.h>
+
+struct fuxi_bt_parser {
+    uint8_t header[5];
+    uint8_t event[258];
+    unsigned header_size;
+    unsigned header_need;
+    unsigned body_size;
+    unsigned body_need;
+};
+
+static uint16_t fuxi_bt_le16(const uint8_t *bytes)
+{
+    return (uint16_t)((uint16_t)bytes[0] | (uint16_t)bytes[1] << 8);
+}
+
+static uint32_t fuxi_bt_le32(const uint8_t *bytes)
+{
+    return (uint32_t)bytes[0] | (uint32_t)bytes[1] << 8 |
+        (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+const char *fuxi_bt_status_name(enum fuxi_bt_status status)
+{
+    static const char *const names[] = {
+        "ok", "off", "argument", "no-uart", "busy", "again", "io",
+        "timeout", "budget", "protocol", "controller", "legacy",
+        "ibs", "version", "cleanup"
+    };
+    if ((unsigned)status >= sizeof(names) / sizeof(names[0])) {
+        return "unknown";
+    }
+    return names[status];
+}
+
+bool fuxi_bt_uart_ops_valid(const struct fuxi_bt_uart_ops *ops)
+{
+    return ops && ops->acquire && ops->write && ops->read &&
+        ops->release && ops->now_us && ops->wait_us;
+}
+
+static enum fuxi_bt_status fuxi_bt_event(const uint8_t *event,
+    unsigned size, struct fuxi_bt_result *result)
+{
+    const uint8_t code = event[1];
+    const unsigned payload = event[2];
+    if (code == 0xff && payload >= 2 && event[3] == 0 && event[4] == 2) {
+        return FUXI_BT_LEGACY;
+    }
+    if (code == 0x0f) {
+        if (payload != 4) {
+            return FUXI_BT_PROTOCOL;
+        }
+        if (fuxi_bt_le16(event + 5) == 0xfc00) {
+            result->controller_status = event[3];
+            if (event[3]) {
+                return FUXI_BT_CONTROLLER;
+            }
+        }
+    }
+    if (code == 0x0e) {
+        if (payload < 3) {
+            return FUXI_BT_PROTOCOL;
+        }
+        if (fuxi_bt_le16(event + 4) == 0xfc00) {
+            if (payload == 4 && event[6]) {
+                result->controller_status = event[6];
+                return FUXI_BT_CONTROLLER;
+            }
+            if (payload != 18 || size != sizeof(result->reply)) {
+                return FUXI_BT_PROTOCOL;
+            }
+            memcpy(result->reply, event, size);
+            result->reply_size = size;
+            if (event[6] != 0 || event[7] != 0x19) {
+                return FUXI_BT_PROTOCOL;
+            }
+            result->controller_status = event[8];
+            if (event[8]) {
+                return FUXI_BT_CONTROLLER;
+            }
+            result->version.product = fuxi_bt_le32(event + 9);
+            result->version.patch = fuxi_bt_le16(event + 13);
+            result->version.rom = fuxi_bt_le16(event + 15);
+            result->version.soc = fuxi_bt_le32(event + 17);
+            if (!result->version.soc || !result->version.rom) {
+                return FUXI_BT_VERSION;
+            }
+            result->version_valid = true;
+            return FUXI_BT_OK;
+        }
+    }
+    result->ignored_frames++;
+    return FUXI_BT_AGAIN;
+}
+
+static enum fuxi_bt_status fuxi_bt_receive(struct fuxi_bt_parser *parser,
+    const uint8_t *bytes, size_t size, struct fuxi_bt_result *result)
+{
+    for (size_t index = 0; index < size; index++) {
+        const uint8_t byte = bytes[index];
+        if (!parser->header_size) {
+            switch (byte) {
+                case 2:
+                case 5:
+                    parser->header_need = 5;
+                    break;
+                case 3:
+                    parser->header_need = 4;
+                    break;
+                case 4:
+                    parser->header_need = 3;
+                    break;
+                case 0xfc:
+                case 0xfd:
+                case 0xfe:
+                    return FUXI_BT_IBS;
+                default:
+                    return FUXI_BT_PROTOCOL;
+            }
+        }
+        if (parser->header_size < parser->header_need) {
+            parser->header[parser->header_size++] = byte;
+            if (parser->header_size != parser->header_need) {
+                continue;
+            }
+            if (parser->header[0] == 4) {
+                parser->body_need = parser->header[2];
+                memcpy(parser->event, parser->header, parser->header_need);
+            } else if (parser->header[0] == 3) {
+                parser->body_need = parser->header[3];
+            } else {
+                parser->body_need = fuxi_bt_le16(parser->header + 3);
+                if (parser->header[0] == 5) {
+                    parser->body_need &= 0x3fffu;
+                }
+            }
+            if (parser->body_need > FUXI_BT_MAX_RX) {
+                return FUXI_BT_BUDGET;
+            }
+        } else {
+            if (parser->header[0] == 4) {
+                parser->event[parser->header_need + parser->body_size] = byte;
+            }
+            parser->body_size++;
+        }
+        if (parser->body_size == parser->body_need) {
+            enum fuxi_bt_status status = FUXI_BT_AGAIN;
+            if (++result->frames > FUXI_BT_MAX_FRAMES) {
+                return FUXI_BT_BUDGET;
+            }
+            if (parser->header[0] == 4) {
+                status = fuxi_bt_event(parser->event,
+                    parser->header_need + parser->body_need, result);
+            } else {
+                result->ignored_frames++;
+            }
+            memset(parser, 0, sizeof(*parser));
+            if (status != FUXI_BT_AGAIN) {
+                return status;
+            }
+        }
+    }
+    return FUXI_BT_AGAIN;
+}
+
+static enum fuxi_bt_status fuxi_bt_time_check(
+    const struct fuxi_bt_uart_ops *ops, uint64_t start,
+    struct fuxi_bt_result *result)
+{
+    const uint64_t now = ops->now_us(ops->context);
+    if (now < start || now - start < result->elapsed_us) {
+        return FUXI_BT_IO;
+    }
+    result->elapsed_us = now - start;
+    if (result->elapsed_us >= FUXI_BT_TIMEOUT_US) {
+        return FUXI_BT_TIMEOUT;
+    }
+    return FUXI_BT_OK;
+}
+
+static enum fuxi_bt_status fuxi_bt_drain(
+    const struct fuxi_bt_uart_ops *ops, uint64_t start,
+    struct fuxi_bt_result *result)
+{
+    uint8_t bytes[64];
+    for (unsigned attempt = 0; attempt < FUXI_BT_MAX_DRAIN; attempt++) {
+        size_t count = 0;
+        const unsigned remaining = FUXI_BT_MAX_DRAIN - result->drained_bytes;
+        const size_t capacity = remaining < sizeof(bytes) ? remaining : sizeof(bytes);
+        enum fuxi_bt_status status = fuxi_bt_time_check(ops, start, result);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        if (!capacity) {
+            return FUXI_BT_BUDGET;
+        }
+        status = ops->read(ops->context, bytes, capacity, &count);
+        if (count > capacity || (status != FUXI_BT_OK && count)) {
+            return FUXI_BT_IO;
+        }
+        if (status == FUXI_BT_AGAIN || (status == FUXI_BT_OK && !count)) {
+            return FUXI_BT_OK;
+        }
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        if (count > FUXI_BT_MAX_DRAIN - result->drained_bytes) {
+            return FUXI_BT_BUDGET;
+        }
+        result->drained_bytes += (unsigned)count;
+    }
+    return FUXI_BT_BUDGET;
+}
+
+enum fuxi_bt_status fuxi_bt_probe_run(unsigned opt_in,
+    const struct fuxi_bt_uart_ops *ops, struct fuxi_bt_result *result)
+{
+    static const uint8_t command[] = {1, 0, 0xfc, 1, 0x19};
+    struct fuxi_bt_parser parser = {0};
+    uint8_t bytes[64];
+    uint64_t start;
+    enum fuxi_bt_status status;
+    if (!result) {
+        return FUXI_BT_ARGUMENT;
+    }
+    memset(result, 0, sizeof(*result));
+    result->status = FUXI_BT_OFF;
+    if (!opt_in) {
+        return result->status;
+    }
+    if (opt_in != 1) {
+        result->status = FUXI_BT_ARGUMENT;
+        return result->status;
+    }
+    if (!fuxi_bt_uart_ops_valid(ops)) {
+        result->status = FUXI_BT_NO_UART;
+        return result->status;
+    }
+    start = ops->now_us(ops->context);
+    status = ops->acquire(ops->context, FUXI_BT_BOOT_BAUD);
+    if (status != FUXI_BT_OK) {
+        goto finish;
+    }
+    status = fuxi_bt_drain(ops, start, result);
+    if (status != FUXI_BT_OK) {
+        goto finish;
+    }
+    for (unsigned attempt = 0; attempt < FUXI_BT_MAX_POLLS; attempt++) {
+        size_t count = 0;
+        result->polls++;
+        status = fuxi_bt_time_check(ops, start, result);
+        if (status != FUXI_BT_OK) {
+            goto finish;
+        }
+        if (result->tx_bytes < sizeof(command)) {
+            const size_t remaining = sizeof(command) - result->tx_bytes;
+            status = ops->write(ops->context, command + result->tx_bytes,
+                remaining, &count);
+            if (count > remaining || (status != FUXI_BT_OK && count)) {
+                status = FUXI_BT_IO;
+                goto finish;
+            }
+            if (status != FUXI_BT_OK && status != FUXI_BT_AGAIN) {
+                goto finish;
+            }
+            result->tx_bytes += (unsigned)count;
+        }
+        if (result->tx_bytes == sizeof(command)) {
+            const unsigned remaining = FUXI_BT_MAX_RX - result->rx_bytes;
+            const size_t capacity = remaining < sizeof(bytes) ? remaining : sizeof(bytes);
+            status = fuxi_bt_time_check(ops, start, result);
+            if (status != FUXI_BT_OK) {
+                goto finish;
+            }
+            if (!capacity) {
+                status = FUXI_BT_BUDGET;
+                goto finish;
+            }
+            count = 0;
+            status = ops->read(ops->context, bytes, capacity, &count);
+            if (count > capacity || (status != FUXI_BT_OK && count)) {
+                status = FUXI_BT_IO;
+                goto finish;
+            }
+            if (status != FUXI_BT_OK && status != FUXI_BT_AGAIN) {
+                goto finish;
+            }
+            if (count > FUXI_BT_MAX_RX - result->rx_bytes) {
+                status = FUXI_BT_BUDGET;
+                goto finish;
+            }
+            result->rx_bytes += (unsigned)count;
+            status = fuxi_bt_time_check(ops, start, result);
+            if (status != FUXI_BT_OK) {
+                goto finish;
+            }
+            status = fuxi_bt_receive(&parser, bytes, count, result);
+            if (status != FUXI_BT_AGAIN) {
+                goto finish;
+            }
+        }
+        ops->wait_us(ops->context, 1000);
+    }
+    status = FUXI_BT_TIMEOUT;
+
+finish:
+    if (status == FUXI_BT_AGAIN) {
+        status = FUXI_BT_IO;
+    }
+    {
+        const enum fuxi_bt_status timing = fuxi_bt_time_check(ops, start, result);
+        if (status == FUXI_BT_OK && timing != FUXI_BT_OK) {
+            status = timing;
+        }
+    }
+    result->status = status;
+    result->cleanup = ops->release(ops->context);
+    if (result->status == FUXI_BT_OK && result->cleanup != FUXI_BT_OK) {
+        result->status = FUXI_BT_CLEANUP;
+    }
+    return result->status;
+}
+
+enum fuxi_bt_status fuxi_bt_snapshot_read(fuxi_bt_read32_fn read32,
+    void *context, struct fuxi_bt_snapshot *snapshot)
+{
+    static const uint32_t branches[] = {0x233d4, 0x233d0, 0x233cc, 0x23004, 0x1e754};
+    static const uint32_t rcg[] = {0x1e760, 0x1e764, 0x1e768, 0x1e76c, 0x1e770, 0x1e774};
+    static const uint32_t engine[] = {0x68, 0x64, 0x40, 0x610, 0x640};
+    uint32_t *engine_values[5];
+    enum fuxi_bt_status status;
+    if (!read32 || !snapshot) {
+        return FUXI_BT_ARGUMENT;
+    }
+    memset(snapshot, 0, sizeof(*snapshot));
+    status = read32(context, FUXI_BT_GCC_BASE + 0x52010, &snapshot->vote);
+    if (status != FUXI_BT_OK) {
+        return status;
+    }
+    status = read32(context, FUXI_BT_GCC_BASE + 0x52018, &snapshot->gpll0_vote);
+    if (status != FUXI_BT_OK) {
+        return status;
+    }
+    for (unsigned index = 0; index < 5; index++) {
+        status = read32(context, FUXI_BT_GCC_BASE + branches[index], &snapshot->branches[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        if (snapshot->branches[index] & (1u << 31)) {
+            snapshot->off_mask |= 1u << index;
+        }
+    }
+    for (unsigned index = 0; index < 6; index++) {
+        status = read32(context, FUXI_BT_GCC_BASE + rcg[index], &snapshot->rcg[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+    }
+    for (unsigned index = 0; index < 8; index++) {
+        const uint64_t pin = FUXI_BT_TLMM_BASE + (uint64_t)(76 + index) * 0x1000;
+        status = read32(context, pin, &snapshot->pin_ctl[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+        status = read32(context, pin + 4, &snapshot->pin_io[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+    }
+    if (snapshot->off_mask) {
+        return FUXI_BT_OK;
+    }
+    status = read32(context, FUXI_BT_WRAPPER_BASE + 4, &snapshot->wrapper_version);
+    if (status != FUXI_BT_OK) {
+        return status;
+    }
+    engine_values[0] = &snapshot->firmware;
+    engine_values[1] = &snapshot->interface_disable;
+    engine_values[2] = &snapshot->engine_status;
+    engine_values[3] = &snapshot->master_irq;
+    engine_values[4] = &snapshot->secondary_irq;
+    for (unsigned index = 0; index < 5; index++) {
+        status = read32(context, FUXI_BT_UART_BASE + engine[index], engine_values[index]);
+        if (status != FUXI_BT_OK) {
+            return status;
+        }
+    }
+    snapshot->engine_read = true;
+    return FUXI_BT_OK;
+}
diff --git a/xnu/fuxi-bluetooth/fuxi_bt.h b/xnu/fuxi-bluetooth/fuxi_bt.h
new file mode 100644
index 0000000..0e23c8a
--- /dev/null
+++ b/xnu/fuxi-bluetooth/fuxi_bt.h
@@ -0,0 +1,100 @@
+#ifndef FUXI_BT_H
+#define FUXI_BT_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define FUXI_BT_UART_BASE UINT64_C(0x898000)
+#define FUXI_BT_WRAPPER_BASE UINT64_C(0x8c0000)
+#define FUXI_BT_GCC_BASE UINT64_C(0x100000)
+#define FUXI_BT_TLMM_BASE UINT64_C(0xf100000)
+#define FUXI_BT_UART_INTID 493u
+#define FUXI_BT_BOOT_BAUD 115200u
+#define FUXI_BT_TIMEOUT_US 2000000u
+#define FUXI_BT_MAX_POLLS 2000u
+#define FUXI_BT_MAX_RX 4096u
+#define FUXI_BT_MAX_FRAMES 64u
+#define FUXI_BT_MAX_DRAIN 1024u
+
+enum fuxi_bt_status {
+    FUXI_BT_OK = 0,
+    FUXI_BT_OFF,
+    FUXI_BT_ARGUMENT,
+    FUXI_BT_NO_UART,
+    FUXI_BT_BUSY,
+    FUXI_BT_AGAIN,
+    FUXI_BT_IO,
+    FUXI_BT_TIMEOUT,
+    FUXI_BT_BUDGET,
+    FUXI_BT_PROTOCOL,
+    FUXI_BT_CONTROLLER,
+    FUXI_BT_LEGACY,
+    FUXI_BT_IBS,
+    FUXI_BT_VERSION,
+    FUXI_BT_CLEANUP
+};
+
+struct fuxi_bt_version {
+    uint32_t product;
+    uint32_t soc;
+    uint16_t patch;
+    uint16_t rom;
+};
+
+struct fuxi_bt_result {
+    enum fuxi_bt_status status;
+    enum fuxi_bt_status cleanup;
+    struct fuxi_bt_version version;
+    bool version_valid;
+    uint8_t controller_status;
+    uint8_t reply[21];
+    unsigned reply_size;
+    unsigned tx_bytes;
+    unsigned rx_bytes;
+    unsigned drained_bytes;
+    unsigned frames;
+    unsigned ignored_frames;
+    unsigned polls;
+    uint64_t elapsed_us;
+};
+
+struct fuxi_bt_uart_ops {
+    void *context;
+    enum fuxi_bt_status (*acquire)(void *, unsigned);
+    enum fuxi_bt_status (*write)(void *, const uint8_t *, size_t, size_t *);
+    enum fuxi_bt_status (*read)(void *, uint8_t *, size_t, size_t *);
+    enum fuxi_bt_status (*release)(void *);
+    uint64_t (*now_us)(void *);
+    void (*wait_us)(void *, unsigned);
+};
+
+struct fuxi_bt_snapshot {
+    uint32_t vote;
+    uint32_t gpll0_vote;
+    uint32_t branches[5];
+    uint32_t rcg[6];
+    uint32_t pin_ctl[8];
+    uint32_t pin_io[8];
+    uint32_t off_mask;
+    bool engine_read;
+    uint32_t wrapper_version;
+    uint32_t firmware;
+    uint32_t interface_disable;
+    uint32_t engine_status;
+    uint32_t master_irq;
+    uint32_t secondary_irq;
+};
+
+typedef enum fuxi_bt_status (*fuxi_bt_read32_fn)(void *, uint64_t, uint32_t *);
+
+const char *fuxi_bt_status_name(enum fuxi_bt_status status);
+bool fuxi_bt_uart_ops_valid(const struct fuxi_bt_uart_ops *ops);
+enum fuxi_bt_status fuxi_bt_probe_run(unsigned opt_in,
+    const struct fuxi_bt_uart_ops *ops, struct fuxi_bt_result *result);
+enum fuxi_bt_status fuxi_bt_snapshot_read(fuxi_bt_read32_fn read32,
+    void *context, struct fuxi_bt_snapshot *snapshot);
+enum fuxi_bt_status fuxi_bt_register_uart(const struct fuxi_bt_uart_ops *ops);
+void fuxi_bt_init(void);
+
+#endif
diff --git a/xnu/fuxi-bluetooth/fuxi_bt_xnu.c b/xnu/fuxi-bluetooth/fuxi_bt_xnu.c
new file mode 100644
index 0000000..d5578d4
--- /dev/null
+++ b/xnu/fuxi-bluetooth/fuxi_bt_xnu.c
@@ -0,0 +1,192 @@
+#include <pexpert/arm64/board_config.h>
+#if defined(FUXI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <vm/pmap.h>
+#include "fuxi_bt.h"
+
+extern kern_return_t pmap_enter_options_addr(pmap_t, vm_map_offset_t,
+    uint64_t, vm_prot_t, vm_prot_t, unsigned, boolean_t, unsigned, void *);
+extern unsigned fuxi_gpu_access(uintptr_t, uint64_t *, unsigned, unsigned);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern kern_return_t thread_terminate(thread_t);
+extern void thread_deallocate(thread_t);
+
+struct fuxi_bt_window {
+    uint64_t pa;
+    vm_size_t size;
+    vm_offset_t va;
+};
+
+static struct fuxi_bt_window fuxi_bt_windows[] = {
+    {0x11c000, 0x4000, 0},
+    {0x120000, 0x4000, 0},
+    {0x150000, 0x4000, 0},
+    {0xf14c000, 0x8000, 0},
+    {FUXI_BT_UART_BASE, 0x4000, 0},
+    {FUXI_BT_WRAPPER_BASE, 0x4000, 0}
+};
+static struct fuxi_bt_uart_ops fuxi_bt_uart;
+static unsigned fuxi_bt_registration;
+static unsigned fuxi_bt_started;
+static unsigned fuxi_bt_mode;
+
+enum fuxi_bt_status fuxi_bt_register_uart(const struct fuxi_bt_uart_ops *ops)
+{
+    unsigned expected = 0;
+    if (!fuxi_bt_uart_ops_valid(ops)) {
+        return FUXI_BT_ARGUMENT;
+    }
+    if (!__atomic_compare_exchange_n(&fuxi_bt_registration, &expected, 1,
+        false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        return FUXI_BT_BUSY;
+    }
+    fuxi_bt_uart = *ops;
+    __atomic_store_n(&fuxi_bt_registration, 2, __ATOMIC_RELEASE);
+    return FUXI_BT_OK;
+}
+
+static enum fuxi_bt_status fuxi_bt_map(struct fuxi_bt_window *window)
+{
+    vm_offset_t address = 0;
+    kern_return_t status;
+    if (window->va) {
+        return FUXI_BT_OK;
+    }
+    if ((window->pa & PAGE_MASK) || (window->size & PAGE_MASK)) {
+        return FUXI_BT_ARGUMENT;
+    }
+    status = kmem_alloc(kernel_map, &address, window->size,
+        KMA_VAONLY | KMA_KOBJECT | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT);
+    if (status != KERN_SUCCESS) {
+        return FUXI_BT_IO;
+    }
+    for (vm_size_t offset = 0; offset < window->size; offset += PAGE_SIZE) {
+        status = pmap_enter_options_addr(kernel_pmap, address + offset,
+            window->pa + offset, VM_PROT_READ | VM_PROT_WRITE, VM_PROT_NONE,
+            VM_WIMG_IO, TRUE, PMAP_OPTIONS_NOWAIT, NULL);
+        if (status != KERN_SUCCESS) {
+            pmap_remove(kernel_pmap, address, address + window->size);
+            kmem_free(kernel_map, address, window->size);
+            return FUXI_BT_IO;
+        }
+    }
+    window->va = address;
+    return FUXI_BT_OK;
+}
+
+static void fuxi_bt_unmap(void)
+{
+    for (unsigned index = 0; index < sizeof(fuxi_bt_windows) / sizeof(fuxi_bt_windows[0]); index++) {
+        struct fuxi_bt_window *window = &fuxi_bt_windows[index];
+        if (window->va) {
+            pmap_remove(kernel_pmap, window->va, window->va + window->size);
+            kmem_free(kernel_map, window->va, window->size);
+            window->va = 0;
+        }
+    }
+}
+
+static enum fuxi_bt_status fuxi_bt_read32(void *context,
+    uint64_t pa, uint32_t *value)
+{
+    (void)context;
+    if (pa & 3) {
+        return FUXI_BT_ARGUMENT;
+    }
+    for (unsigned index = 0; index < sizeof(fuxi_bt_windows) / sizeof(fuxi_bt_windows[0]); index++) {
+        struct fuxi_bt_window *window = &fuxi_bt_windows[index];
+        if (pa >= window->pa && pa - window->pa <= window->size - 4) {
+            uint64_t raw = 0;
+            enum fuxi_bt_status status = fuxi_bt_map(window);
+            if (status != FUXI_BT_OK) {
+                return status;
+            }
+            if (fuxi_gpu_access(window->va + (uintptr_t)(pa - window->pa), &raw, 0, 0)) {
+                printf("FUXI BT: read fault pa=%#llx\n", pa);
+                return FUXI_BT_IO;
+            }
+            *value = (uint32_t)raw;
+            return FUXI_BT_OK;
+        }
+    }
+    return FUXI_BT_ARGUMENT;
+}
+
+static void fuxi_bt_worker(void *argument, wait_result_t wait_result)
+{
+    struct fuxi_bt_snapshot snapshot;
+    enum fuxi_bt_status status;
+    (void)argument;
+    (void)wait_result;
+    status = fuxi_bt_snapshot_read(fuxi_bt_read32, NULL, &snapshot);
+    printf("FUXI BT: survey status=%s vote=%#x gpll0_vote=%#x off_mask=%#x engine_read=%u\n",
+        fuxi_bt_status_name(status), snapshot.vote, snapshot.gpll0_vote,
+        snapshot.off_mask, (unsigned)snapshot.engine_read);
+    if (status == FUXI_BT_OK) {
+        printf("FUXI BT: branches core=%#x s_ahb=%#x m_ahb=%#x core2x=%#x se6=%#x\n",
+            snapshot.branches[0], snapshot.branches[1], snapshot.branches[2],
