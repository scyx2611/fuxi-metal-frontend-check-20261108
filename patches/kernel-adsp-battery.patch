++/* WRITE(10) of n blocks from the bounce buffer to area block blk; sweet_ufs_lock held. */
++static int
++fx_log_put(uint64_t blk, uint32_t n)
++{
++	uint64_t lba = fx_log_first + blk;
++	uint8_t cdb[10] = {
++		0x2a, 0,
++		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
