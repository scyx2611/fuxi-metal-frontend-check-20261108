+		sweet_log_secs = SWEET_LOG_SECS;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	uint8_t saved = su.lun;
+	for (unsigned i = 0; i < sizeof(luns) && !found && !su.poisoned; i++) {
