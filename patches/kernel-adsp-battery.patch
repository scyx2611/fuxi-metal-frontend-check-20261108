+                   (b'type: 4', b'type: 7'), (b'size: 88', b'size: 4294967295'),
+                   (b'kiwi/bd_m3.elf', b'kiwi/../bd_m3.elf'),
+                   (b'[   18.000001]', b'[    1.000001]'),
+                   (b'[    8.000001]', b'[    1.000001]'),
+                   (b'pa: 0x00000000a2a00000', b'pa: 0xffffffffffffffff'))
