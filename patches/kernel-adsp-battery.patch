+def memory_contains(ranges, start, length):
+    if start < 0 or length <= 0 or start + length > 1 << 64:
+        return False
+    cursor = start
+    end = start + length
+    for base, size in sorted(ranges):
+        if base < 0 or size < 0 or base + size > 1 << 64:
+            return False
+        if base > cursor:
+            break
+        if base + size > cursor:
+            cursor = base + size
+        if cursor >= end:
+            return True
+    return False
 
 
