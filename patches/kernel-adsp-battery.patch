new file mode 100644
index 0000000..e9344e6
--- /dev/null
+++ b/tools/test-fuxi-torch-pulse.py
@@ -0,0 +1,106 @@
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = r'''
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "fuxi_torch_pulse.h"
+struct model {
+    uint8_t registers[256], original[256];
+    unsigned reads, writes, fail_read, fail_write, drop_write, quarantine, dead, fault;
+    unsigned now, start, pulses, peak_current, expired;
+    uint64_t drop_mask;
+};
+static int active(struct model *state) {
+    return (state->registers[0x46]&0x80) && (state->registers[0x4e]&1) && !state->expired;
+}
+static int read_register(void *context, unsigned offset, uint8_t *value) {
+    struct model *state=context;
+    assert(offset<256);
+    if(++state->reads==state->fail_read) return -1;
+    if(state->fault && state->pulses && offset==6) {*value=1; return 0;}
+    *value=state->registers[offset];
+    return 0;
+}
+static int write_register(void *context, unsigned offset, uint8_t value) {
+    struct model *state=context;
+    assert(offset==0x3e || offset==0x42 || offset==0x49 || offset==0x4a || offset==0x46 || offset==0x4e);
+    state->writes++;
+    if(state->dead) return -1;
+    if(state->writes==state->fail_write && !state->quarantine) return -1;
+    if(state->writes!=state->drop_write && !(state->drop_mask&(1ull<<state->writes))) {
+        if(active(state) && offset!=0x46 && offset!=0x4e) assert(0);
+        if(offset==0x4e && value) {
+            assert(value==1 && state->registers[0x3e]==0x8a && (state->registers[0x49]&1));
+            assert((state->registers[0x4a]&7)==1 && state->registers[0x42]==7);
+            assert(state->registers[0x46]&0x80);
+            state->start=state->now; state->pulses++; state->expired=0; state->peak_current=40;
+        }
+        state->registers[offset]=value;
+    }
+    if(state->writes==state->fail_write) {state->dead=1; return -1;}
+    return 0;
+}
+static void wait_us(void *context, unsigned microseconds) {
+    struct model *state=context;
+    state->now+=microseconds;
+    if(state->pulses && (state->registers[0x3e]&0x80) &&
+       state->now-state->start>=(state->registers[0x3e]&0x7f)*10000u) state->expired=1;
+}
+static void fixture(struct model *state) {
+    memset(state,0,sizeof(*state));
+    state->registers[4]=0x18; state->registers[5]=7;
+    state->registers[0x3e]=11; state->registers[0x42]=23;
+    state->registers[0x49]=0x0a; state->registers[0x4a]=1; state->registers[0x46]=0x20;
+    memcpy(state->original,state->registers,256);
+}
+static int run(struct model *state) {
+    FuxiTorchIo io={state,read_register,write_register,wait_us};
+    int result=fuxi_torch_pulse(&io);
+    assert(!active(state) && state->pulses<=1 && state->peak_current<=40);
+    return result;
+}
+int main(void) {
+    struct model state;
+    fixture(&state); assert(!run(&state));
+    assert(state.pulses==1 && state.now==80000 && state.writes==12);
+    assert(!memcmp(state.registers,state.original,256));
+    unsigned reads=state.reads;
+    fixture(&state); state.registers[4]=0; assert(run(&state)<0 && !state.writes);
+    fixture(&state); state.registers[5]=4; assert(run(&state)<0 && !state.writes);
+    fixture(&state); state.registers[0x46]|=0x80;
+    FuxiTorchIo busy={&state,read_register,write_register,wait_us};
+    assert(fuxi_torch_pulse(&busy)==-2 && !state.writes);
+    fixture(&state); state.registers[0x4e]=2; assert(run(&state)==-2 && !state.writes);
+    fixture(&state); state.registers[6]=1; assert(run(&state)==-2 && !state.writes);
+    for(unsigned index=1;index<=reads;index++) {
+        fixture(&state); state.fail_read=index; assert(run(&state)<0);
+    }
+    for(unsigned index=1;index<=12;index++) {
+        fixture(&state); state.fail_write=index; assert(run(&state)<0);
+    }
+    for(unsigned index=1;index<=12;index++) {
+        fixture(&state); state.drop_write=index; run(&state);
+        fixture(&state); state.fail_write=index; state.quarantine=1; assert(run(&state)<0);
+    }
+    fixture(&state); state.drop_mask=(1ull<<7)|(1ull<<8);
+    assert(run(&state)==-6 && state.expired && state.now==190000);
+    assert(state.registers[0x3e]==0x8a && state.writes==8);
+    fixture(&state); state.fault=1; assert(run(&state)==-5);
+    assert(!memcmp(state.registers,state.original,256));
+    puts("PASS: real torch pulse, 40mA limit, 80ms duration, timer-before-enable, busy/fault checks, failure cleanup and register restore");
+    return 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='fuxi-torch-pulse-') as temporary:
+    directory = Path(temporary)
+    cfile, binary = directory / 'pulse.c', directory / 'pulse'
+    cfile.write_text(source)
+    subprocess.run([os.environ.get('CC', 'cc'), '-std=c11', '-g', '-Wall', '-Wextra', '-Werror',
+                    '-fsanitize=address,undefined', '-fno-omit-frame-pointer',
+                    '-I' + str(root / 'xnu/fuxi-adsp'), str(cfile), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
