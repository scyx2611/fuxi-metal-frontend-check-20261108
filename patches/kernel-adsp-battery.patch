diff --git a/xnu/fuxi-adsp/FatVolume.c b/xnu/fuxi-adsp/FatVolume.c
new file mode 100644
index 0000000..2afa75f
--- /dev/null
+++ b/xnu/fuxi-adsp/FatVolume.c
@@ -0,0 +1,225 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "FatVolume.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+
+static int vread(FatVolume *v, uint64_t offset, void *to, size_t length)
+{
+    if (!fits(offset, length, v->size)) return FatDamaged;
+    return v->read(v->context, offset, to, length) ? FatReadError : FatOk;
+}
+
+int fat_mount(FatVolume *v, uint64_t size, FatRead read, void *context)
+{
+    uint8_t b[512];
+    if (!v || !read) return FatReadError;
+    *v = (FatVolume){0};
+    v->read = read; v->context = context; v->size = size;
+    v->cached_sector = UINT64_MAX;
+    if (size < sizeof b) return FatNotFat;
+    if (vread(v, 0, b, sizeof b)) return FatReadError;
+    const uint32_t bps = le16(b + 11), spc = b[13], reserved = le16(b + 14), fats = b[16], root = le16(b + 17);
+    const uint32_t total = le16(b + 19) ? le16(b + 19) : le32(b + 32);
+    const uint32_t fat_sectors = le16(b + 22) ? le16(b + 22) : le32(b + 36);
+    if (b[510] != 0x55 || b[511] != 0xaa) return FatNotFat;
+    if (bps < 512 || bps > sizeof v->sector || (bps & (bps - 1)) || !spc || (spc & (spc - 1)) || !reserved || !fats || !fat_sectors)
+        return FatNotFat;
+    const uint64_t root_sectors = ((uint64_t)root * 32 + bps - 1) / bps;
+    const uint64_t data_sector = reserved + (uint64_t)fats * fat_sectors + root_sectors;
+    if (total <= data_sector || (uint64_t)total * bps > size) return FatNotFat;
+    const uint64_t clusters = (total - data_sector) / spc;
+    if (clusters < 4085) return FatNotFat;  /* FAT12 */
+    v->fat32 = clusters >= 65525;
+    if (v->fat32 ? root != 0 : root == 0) return FatNotFat;
+    /* the table must hold an entry for every cluster */
+    if ((uint64_t)fat_sectors * bps / (v->fat32 ? 4 : 2) < clusters + 2 || clusters > 0x0ffffff0) return FatNotFat;
+    v->sector_bytes = bps;
+    v->cluster_bytes = bps * spc;
+    v->clusters = (uint32_t)clusters;
+    v->fat_offset = (uint64_t)reserved * bps;
+    v->root_offset = (reserved + (uint64_t)fats * fat_sectors) * bps;
+    v->data_offset = data_sector * bps;
+    v->root_entries = root;
+    v->root_cluster = v->fat32 ? le32(b + 44) & 0x0fffffff : 0;
+    return FatOk;
+}
+
+static int valid(const FatVolume *v, uint32_t cluster) {return cluster >= 2 && cluster - 2 < v->clusters;}
+static uint64_t cluster_offset(const FatVolume *v, uint32_t cluster) {return v->data_offset + (uint64_t)(cluster - 2) * v->cluster_bytes;}
+
+/* The table entry of cluster (valid), through the one-sector cache. */
+static int next_cluster(FatVolume *v, uint32_t cluster, uint32_t *next)
+{
+    const uint64_t at = v->fat_offset + (uint64_t)cluster * (v->fat32 ? 4 : 2);
+    const uint64_t sector = at / v->sector_bytes;
+    if (sector != v->cached_sector) {
+        v->cached_sector = UINT64_MAX;
+        const int rc = vread(v, sector * v->sector_bytes, v->sector, v->sector_bytes);
+        if (rc) return rc;
+        v->cached_sector = sector;
+    }
+    const uint8_t *e = v->sector + at % v->sector_bytes;
+    *next = v->fat32 ? le32(e) & 0x0fffffff : le16(e);
+    return FatOk;
+}
+
+static uint8_t upper(char c) {return (uint8_t)(c >= 'a' && c <= 'z' ? c - 32 : c);}
+
+/* The 11-byte directory form of one path component; 0 when it is no 8.3 name. */
+static int short_name(const char *name, size_t length, uint8_t out[11])
+{
+    size_t dot = length;
+    for (size_t i = 0; i < length; ++i) if (name[i] == '.') {if (dot != length) return 0; dot = i;}
+    const size_t ext = dot < length ? length - dot - 1 : 0;
+    if (!dot || dot > 8 || ext > 3 || (dot < length && !ext)) return 0;
+    for (unsigned i = 0; i < 11; ++i) out[i] = ' ';
+    for (size_t i = 0; i < dot; ++i) out[i] = upper(name[i]);
+    for (size_t i = 0; i < ext; ++i) out[8 + i] = upper(name[dot + 1 + i]);
+    return 1;
+}
+
+/* Long names: up to 20 entries of 13 UCS-2 characters each, before the short entry they belong to (checked by its checksum). */
+#define LFN_ENTRIES 20u
+static const uint8_t lfn_slots[13] = {1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
+typedef struct {uint16_t text[LFN_ENTRIES * 13]; uint8_t valid, next, sum, count;} LongName;
+
+static uint8_t short_sum(const uint8_t *d)
+{
+    uint8_t sum = 0;
+    for (unsigned i = 0; i < 11; ++i) sum = (uint8_t)(((sum & 1) << 7) + (sum >> 1) + d[i]);
+    return sum;
+}
+
+static void long_part(LongName *l, const uint8_t *d)
+{
+    const unsigned seq = d[0] & 0x1f;
+    if (d[0] & 0x40) {  /* the last part comes first */
+        l->valid = seq >= 1 && seq <= LFN_ENTRIES;
+        l->count = (uint8_t)seq;
+        l->sum = d[13];
+    } else if (!l->valid || seq != l->next - 1u || d[13] != l->sum) {
+        l->valid = 0;
+    }
+    if (!l->valid) return;
+    l->next = (uint8_t)seq;
+    for (unsigned k = 0; k < 13; ++k) l->text[(seq - 1) * 13 + k] = le16(d + lfn_slots[k]);
+}
+
+static int long_matches(const LongName *l, const uint8_t *d, const char *name, size_t length)
+{
+    if (!l->valid || l->next != 1 || short_sum(d) != l->sum) return 0;
+    size_t n = 0;
+    while (n < (size_t)l->count * 13 && l->text[n]) ++n;
+    if (n != length) return 0;
+    for (size_t i = 0; i < n; ++i) if (l->text[i] > 0x7f || upper((char)l->text[i]) != upper(name[i])) return 0;
+    return 1;
+}
+
+/* Looks for a name in a directory (the FAT16 fixed root for cluster 0, else a cluster chain): its long name, or its short name. */
+static int find(FatVolume *v, uint32_t cluster, const char *name, size_t length, FatFile *file)
+{
+    uint8_t chunk[512], want[11];
+    LongName l;
+    l.valid = 0;
+    const int has_short = short_name(name, length, want);
+    const int fixed = cluster == 0;
+    if (fixed && v->fat32) cluster = v->root_cluster;
+    uint64_t at = fixed && !v->fat32 ? v->root_offset : 0;
+    uint64_t left = fixed && !v->fat32 ? (uint64_t)v->root_entries * 32 : 0;
+    for (uint32_t walked = 0;;) {
+        if (!(fixed && !v->fat32)) {
+            if (!valid(v, cluster) || walked++ > v->clusters) return FatDamaged;
+            at = cluster_offset(v, cluster);
+            left = v->cluster_bytes;
+        }
+        while (left) {
+            const size_t n = left < sizeof chunk ? (size_t)left : sizeof chunk;
+            const int rc = vread(v, at, chunk, n);
+            if (rc) return rc;
+            for (size_t e = 0; e + 32 <= n; e += 32) {
+                const uint8_t *d = chunk + e;
+                if (!d[0]) return FatNotFound;
+                if (d[0] == 0xe5) {l.valid = 0; continue;}
+                if ((d[11] & 0x3f) == 0x0f) {long_part(&l, d); continue;}
+                int same = long_matches(&l, d, name, length);
+                l.valid = 0;
+                if (d[11] & 0x08) continue;  /* the volume label */
+                for (unsigned i = 0; i < 11 && has_short && !same; ++i) {
+                    if (upper((char)d[i]) != want[i]) break;
+                    if (i == 10) same = 1;
+                }
+                if (!same) continue;
+                file->first_cluster = (uint32_t)le16(d + 26) | (v->fat32 ? (uint32_t)le16(d + 20) << 16 : 0);
+                file->size = le32(d + 28);
+                file->directory = (d[11] & 0x10) != 0;
+                return FatOk;
+            }
+            at += n;
+            left -= n;
+        }
+        if (fixed && !v->fat32) return FatNotFound;
+        uint32_t next;
+        const int rc = next_cluster(v, cluster, &next);
+        if (rc) return rc;
+        if (!valid(v, next)) return FatNotFound;  /* the end of the directory */
+        cluster = next;
+    }
+}
+
+int fat_open(FatVolume *v, const char *path, FatFile *file)
+{
+    FatFile at = {0, 0, 1};  /* the root */
+    if (!v || !path || !file) return FatNotFound;
+    while (*path) {
+        while (*path == '/') ++path;
+        size_t n = 0;
+        while (path[n] && path[n] != '/') ++n;
+        if (!n) break;
+        if (!at.directory) return FatNotDirectory;
+        const int rc = find(v, at.first_cluster, path, n, &at);
+        if (rc) return rc;
+        path += n;
+    }
+    *file = at;
+    return FatOk;
+}
+
+int fat_read(FatVolume *v, const FatFile *file, uint64_t offset, void *to, size_t length)
+{
+    uint8_t *out = to;
+    if (!v || !file || !to) return FatReadError;
+    if (file->directory) return FatIsDirectory;
+    if (!fits(offset, length, file->size)) return FatRange;
+    if (!length) return FatOk;
+    uint32_t cluster = file->first_cluster, walked = 0;
+    for (uint64_t skip = offset / v->cluster_bytes; skip; --skip) {
+        if (!valid(v, cluster) || ++walked > v->clusters) return FatDamaged;
+        const int rc = next_cluster(v, cluster, &cluster);
+        if (rc) return rc;
+    }
+    uint64_t within = offset % v->cluster_bytes;
+    while (length) {
+        if (!valid(v, cluster)) return FatDamaged;
+        /* a run of consecutive clusters is one read */
+        uint32_t last = cluster, next = 0;
+        uint64_t span = v->cluster_bytes - within;
+        for (;;) {
+            if (++walked > v->clusters) return FatDamaged;
+            const int rc = next_cluster(v, last, &next);
+            if (rc) return rc;
+            if (span >= length || next != last + 1 || !valid(v, next)) break;
+            last = next;
+            span += v->cluster_bytes;
+        }
+        const size_t take = span < length ? (size_t)span : length;
+        const int rc = vread(v, cluster_offset(v, cluster) + within, out, take);
+        if (rc) return rc;
+        out += take;
+        length -= take;
+        within = 0;
+        cluster = next;
+    }
+    return FatOk;
+}
diff --git a/xnu/fuxi-adsp/FatVolume.h b/xnu/fuxi-adsp/FatVolume.h
new file mode 100644
index 0000000..4308316
--- /dev/null
+++ b/xnu/fuxi-adsp/FatVolume.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* A read-only FAT16/FAT32 volume over a byte read callback: enough to find a file by its long or short (8.3) name in a directory path and read
+ * any range of it. Used to take the device's own firmware files from its firmware partition in place. No allocation: the one sector of
+ * the allocation table in use is cached in the volume. The volume's metadata is untrusted: every cluster number and chain is bounds
+ * checked and every chain walk is bounded, so a damaged volume gives an error, never a loop or a read outside the partition. */
+#ifndef FAT_VOLUME_H
+#define FAT_VOLUME_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Reads length bytes at offset (from the partition start) into to; returns 0 on success. */
+typedef int (*FatRead)(void *context, uint64_t offset, void *to, size_t length);
+
+enum {
+    FatOk = 0,
+    FatReadError = -1,
+    FatNotFat = -2,     /* no boot sector of a FAT16 or FAT32 volume */
+    FatNotFound = -3,
+    FatNotDirectory = -4,
+    FatIsDirectory = -5,
+    FatDamaged = -6,    /* a cluster chain leaves the volume, loops or is shorter than the file */
+    FatRange = -7,      /* the read goes past the end of the file */
+};
+
+typedef struct {
+    FatRead read;
+    void *context;
+    uint64_t size;                                    /* partition bytes */
+    uint8_t fat32;
+    uint32_t sector_bytes, cluster_bytes, clusters;   /* clusters: data clusters, numbered 2 .. clusters + 1 */
+    uint64_t fat_offset, root_offset, data_offset;    /* bytes from the partition start; root_offset is FAT16 only */
+    uint32_t root_entries, root_cluster;              /* root_entries: FAT16 fixed root; root_cluster: FAT32 */
+    uint64_t cached_sector;                           /* UINT64_MAX: nothing cached */
+    uint8_t sector[4096];
+} FatVolume;
+
+typedef struct {
+    uint32_t first_cluster, size;
+    uint8_t directory;
+} FatFile;
+
+int fat_mount(FatVolume *v, uint64_t size, FatRead read, void *context);
+/* path: names separated by '/', each matched in any case against the long name, else the 8.3 name ("image/adsp.b00"). */
+int fat_open(FatVolume *v, const char *path, FatFile *file);
+int fat_read(FatVolume *v, const FatFile *file, uint64_t offset, void *to, size_t length);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/GeniI2c.c b/xnu/fuxi-adsp/GeniI2c.c
new file mode 100644
index 0000000..cad36d0
--- /dev/null
+++ b/xnu/fuxi-adsp/GeniI2c.c
@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "GeniI2c.h"
+
+static uint32_t rd(GeniI2c *g, uint32_t reg) {return g->io.read(g->io.ctx, reg);}
+static void wr(GeniI2c *g, uint32_t reg, uint32_t value) {g->io.write(g->io.ctx, reg, value);}
+
+/* A FIFO depth field (bits 21:16); a field that reads zero takes the smallest depth these engines have. */
+static uint32_t fifo_words(uint32_t param)
+{
+    const uint32_t words = (param >> 16) & 0x3fu;
+    return words ? words : 16u;
+}
+
+int geni_i2c_prepare(GeniI2c *g, const GeniIo *io, uint8_t address, uint32_t *config)
+{
+    for (unsigned i = 0; i < sizeof *g; ++i) ((uint8_t *)g)[i] = 0;
+    g->io = *io;
+    g->address = address;
+    const uint32_t proto = (rd(g, GENI_FW_REVISION) >> 8) & 0xffu, clock = rd(g, GENI_CLK_CFG);
+    if (config) *config = (proto << 24) | (clock & 0xffffffu);
+    if (proto != GENI_PROTO_I2C || (rd(g, GENI_IF_DISABLE) & 1u) || !(clock & 1u) || !rd(g, GENI_SCL_COUNTERS)) return -1;
+    wr(g, GENI_DMA_MODE, 0);
+    /* 8-bit words, 4 per FIFO word, least significant byte first on the wire. */
+    wr(g, GENI_TX_PACK0, 0x7f8fe); wr(g, GENI_TX_PACK1, 0xffefe);
+    wr(g, GENI_RX_PACK0, 0x7f8fe); wr(g, GENI_RX_PACK1, 0xffefe);
+    wr(g, GENI_BYTE_GRAN, 0);
+    wr(g, GENI_TX_WATERMARK, 0);
+    g->tx_fifo_words = fifo_words(rd(g, GENI_HW_PARAM_0));
+    g->rx_fifo_words = fifo_words(rd(g, GENI_HW_PARAM_1));
+    wr(g, GENI_M_IRQ_CLEAR, 0xffffffffu);
+    /* Exactly the bits this core handles: one the boot loader left enabled (RX watermark, RX last) would hold the level line up. */
+    wr(g, GENI_M_IRQ_EN, GENI_M_IRQ_WANTED);
+    wr(g, GENI_SE_IRQ_EN, rd(g, GENI_SE_IRQ_EN) | GENI_SE_M_IRQ_EN);
+    return 0;
+}
+
+/* Starts one write command of length bytes (at most 8); the data goes in when the engine asks for it (TX watermark). */
+static void write_command(GeniI2c *g, const uint8_t *bytes, uint32_t length, int hold)
+{
+    g->tx[0] = g->tx[1] = 0;
+    for (uint32_t i = 0; i < length; ++i) g->tx[i / 4] |= (uint32_t)bytes[i] << (8 * (i % 4));
+    g->tx_words = (uint8_t)((length + 3) / 4);
+    g->length = length;
+    g->hold = (uint8_t)hold;
+    wr(g, GENI_TX_LEN, length);
+    wr(g, GENI_M_CMD0, (GENI_OP_WRITE << 27) | ((uint32_t)g->address << 9) | (hold ? GENI_STOP_STRETCH : 0));
+    wr(g, GENI_TX_WATERMARK, 1);
+    g->phase = GeniTxWait;
+}
+
+int geni_i2c_start_write(GeniI2c *g, uint8_t reg, uint8_t value)
+{
+    if (g->phase != GeniIdle) return -1;
+    g->reading = 0; g->reg = reg; g->value = value; g->error = GeniOk;
+    const uint8_t bytes[2] = {reg, value};
+    write_command(g, bytes, 2, 0);
+    return 0;
+}
+
+int geni_i2c_start_read(GeniI2c *g, uint8_t reg)
+{
+    if (g->phase != GeniIdle) return -1;
+    g->reading = 1; g->rx_length = 1; g->reg = reg; g->error = GeniOk;
+    write_command(g, &reg, 1, 1);
+    return 0;
+}
+
+int geni_i2c_start_write_bytes(GeniI2c *g, const uint8_t *bytes, uint32_t length)
+{
+    if (g->phase != GeniIdle || !length || length > 8) return -1;
+    g->reading = 0; g->error = GeniOk;
+    write_command(g, bytes, length, 0);
+    return 0;
+}
+
+int geni_i2c_start_read_bytes(GeniI2c *g, const uint8_t *bytes, uint32_t length, uint32_t read_length)
+{
+    if (g->phase != GeniIdle || !length || length > 4 || !read_length || read_length > 4) return -1;
+    g->reading = 1; g->rx_length = (uint8_t)read_length; g->error = GeniOk;
+    write_command(g, bytes, length, 1);
+    return 0;
+}
+
+int geni_i2c_start_write_buffer(GeniI2c *g, const uint8_t *bytes, uint32_t length)
+{
+    if (g->phase != GeniIdle || !bytes || !length) return -1;
+    g->reading = 0; g->error = GeniOk;
+    g->tx_buffer = bytes; g->tx_done = 0;
+    g->tx_words = 0;
+    g->length = length;
+    g->hold = 0;
+    wr(g, GENI_TX_LEN, length);
+    wr(g, GENI_M_CMD0, (GENI_OP_WRITE << 27) | ((uint32_t)g->address << 9));
+    wr(g, GENI_TX_WATERMARK, 1);
+    g->phase = GeniTxWait;
+    return 0;
+}
+
+int geni_i2c_start_read_buffer(GeniI2c *g, const uint8_t *command, uint32_t command_length, uint8_t *buffer, uint32_t length)
+{
+    if (g->phase != GeniIdle || !command || !command_length || command_length > 8 || !buffer || !length) return -1;
+    g->reading = 1; g->error = GeniOk;
+    g->rx_buffer = buffer; g->rx_done = 0; g->rx_total = length;
+    write_command(g, command, command_length, 1);
+    return 0;
+}
+
+/* Fills the free TX FIFO words (a watermark event that finds the FIFO full writes nothing); the last word in ends the TX wait. */
+static void feed(GeniI2c *g)
+{
+    const uint32_t used = GENI_TX_FIFO_WORDS(rd(g, GENI_TX_FIFO_STATUS));
+    uint32_t room = used < g->tx_fifo_words ? g->tx_fifo_words - used : 0;
+    while (room && g->tx_done < g->length) {
+        uint32_t word = 0;
+        for (unsigned k = 0; k < 4 && g->tx_done < g->length; ++k) word |= (uint32_t)g->tx_buffer[g->tx_done++] << (8 * k);
+        wr(g, GENI_TX_FIFO, word);
+        --room;
+    }
+    if (g->tx_done == g->length) {
+        wr(g, GENI_TX_WATERMARK, 0);
+        g->phase = GeniWriteDone;
+    }
+}
+
+/* Empties the RX FIFO into the read buffer; words past the requested length are dropped. */
+static void drain(GeniI2c *g)
+{
+    for (uint32_t words = GENI_RX_FIFO_WORDS(rd(g, GENI_RX_FIFO_STATUS)); words; --words) {
+        const uint32_t word = rd(g, GENI_RX_FIFO);
+        for (unsigned k = 0; k < 4 && g->rx_buffer && g->rx_done < g->rx_total; ++k) g->rx_buffer[g->rx_done++] = (uint8_t)(word >> (8 * k));
+    }
+}
+
+static int finish(GeniI2c *g, int error, uint32_t status)
+{
+    g->phase = GeniIdle;
+    wr(g, GENI_TX_WATERMARK, 0);
+    if (g->rx_buffer) {
+        /* A failed or cancelled read can leave words behind; the next transfer must not take them. */
+        if (error) {uint8_t *keep = g->rx_buffer; g->rx_buffer = 0; drain(g); g->rx_buffer = keep;}
+        wr(g, GENI_M_IRQ_EN, GENI_M_IRQ_WANTED);
+    }
+    g->tx_buffer = 0; g->rx_buffer = 0;
+    if (!error) {g->done++; return GeniDone;}
+    g->error = (uint8_t)error;
+    g->error_status = status;
+    g->failed++;
+    return GeniFailed;
+}
+
+int geni_i2c_event(GeniI2c *g, uint32_t status)
+{
+    if (!status) return GeniPending;
+    switch (g->phase) {
+    case GeniIdle:
+        g->stray++;
+        return GeniPending;
+    case GeniCancelling:
+        if (status & GENI_M_CMD_CANCEL) return finish(g, GeniErrTimeout, g->error_status);
+        return GeniPending;
+    case GeniAborting:
+        if (status & GENI_M_CMD_ABORT) return finish(g, GeniErrTimeout, g->error_status);
+        return GeniPending;
+    default:
+        break;
+    }
+    /* A failed command also ends with CMD_DONE; the error bits decide. */
+    if (status & GENI_M_ERRORS) return finish(g, GeniErrBus, status);
+    if (g->phase == GeniTxWait) {
+        if ((status & GENI_M_TX_WATERMARK) && g->tx_buffer) feed(g);
+        else if (status & GENI_M_TX_WATERMARK) {
+            for (unsigned i = 0; i < g->tx_words; ++i) wr(g, GENI_TX_FIFO, g->tx[i]);
+            wr(g, GENI_TX_WATERMARK, 0);
+            g->phase = GeniWriteDone;
+        }
+        if (!(status & GENI_M_CMD_DONE)) return GeniPending;
+        if (g->phase == GeniTxWait) return finish(g, GeniErrState, status);  /* done before the data went in */
+    }
+    if (g->phase == GeniReadDone && g->rx_buffer) {
+        drain(g);
+        if (!(status & GENI_M_CMD_DONE)) return GeniPending;
+        drain(g);   /* the last words can land after the status was read */
+        return g->rx_done == g->rx_total ? finish(g, GeniOk, 0) : finish(g, GeniErrNoData, status);
+    }
+    if (!(status & GENI_M_CMD_DONE)) return GeniPending;
+    if (g->phase == GeniWriteDone) {
+        if (!g->reading) return finish(g, GeniOk, 0);
+        if (g->rx_buffer) {
+            const uint32_t mark = g->rx_fifo_words > 1 ? g->rx_fifo_words - 1 : 1;
+            wr(g, GENI_RX_WATERMARK, mark);
+            wr(g, GENI_RX_RFR_WATERMARK, g->rx_fifo_words);
+            wr(g, GENI_M_IRQ_EN, GENI_M_IRQ_WANTED | GENI_M_RX_WATERMARK | GENI_M_RX_LAST);
+            wr(g, GENI_RX_LEN, g->rx_total);
+        } else wr(g, GENI_RX_LEN, g->rx_length);
+        wr(g, GENI_M_CMD0, (GENI_OP_READ << 27) | ((uint32_t)g->address << 9));
+        g->phase = GeniReadDone;
+        return GeniPending;
+    }
+    /* GeniReadDone */
+    if (!(rd(g, GENI_RX_FIFO_STATUS) & 0x1ffffffu)) return finish(g, GeniErrNoData, status);
+    g->rx = rd(g, GENI_RX_FIFO);
+    g->data = (uint8_t)g->rx;
+    return finish(g, GeniOk, 0);
+}
+
+int geni_i2c_poll(GeniI2c *g)
+{
+    const uint32_t status = rd(g, GENI_M_IRQ_STATUS);
+    if (status) wr(g, GENI_M_IRQ_CLEAR, status);
+    return g->phase == GeniIdle ? GeniPending : geni_i2c_event(g, status);
+}
+
+int geni_i2c_timeout(GeniI2c *g)
+{
+    switch (g->phase) {
+    case GeniIdle:
+        return GeniPending;
+    case GeniCancelling:
+        wr(g, GENI_M_CMD_CTRL, GENI_CMD_CTRL_ABORT);
+        g->phase = GeniAborting;
+        return GeniPending;
+    case GeniAborting:
+        return finish(g, GeniErrTimeout, g->error_status);
+    default:
+        g->timeouts++;
+        g->error_status = rd(g, GENI_M_IRQ_STATUS);
+        wr(g, GENI_TX_WATERMARK, 0);
+        wr(g, GENI_M_CMD_CTRL, GENI_CMD_CTRL_CANCEL);
+        g->phase = GeniCancelling;
+        return GeniPending;
+    }
+}
diff --git a/xnu/fuxi-adsp/GeniI2c.h b/xnu/fuxi-adsp/GeniI2c.h
new file mode 100644
index 0000000..118dc7c
--- /dev/null
+++ b/xnu/fuxi-adsp/GeniI2c.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* One register transfer at a time on a Qualcomm GENI serial engine running the I2C firmware, as an event-driven state machine: the owner
+ * starts a transfer, then feeds the engine's M_IRQ status (from its interrupt handler or a timer poll) until the transfer is done or
+ * failed, and calls the timeout step when its deadline passes. Nothing here waits or spins: every call does a few register accesses and
+ * returns. A register write is one 2-byte write {register, value}; a register read is a 1-byte write {register} that holds the stop
+ * condition, then a 1-byte read. A transfer that stops answering is cancelled, then aborted, as the engine documents. Buffered transfers
+ * move any length through the FIFO: each TX watermark event fills the free FIFO words, each RX watermark or last event empties it. */
+#ifndef GENI_I2C_H
+#define GENI_I2C_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Serial engine registers (offsets in the engine's 16 KiB window). */
+#define GENI_FW_REVISION 0x68u
+#define GENI_IF_DISABLE 0x64u
+#define GENI_CLK_CFG 0x48u
+#define GENI_BYTE_GRAN 0x254u
+#define GENI_DMA_MODE 0x258u
+#define GENI_TX_PACK0 0x260u
+#define GENI_TX_PACK1 0x264u
+#define GENI_TX_LEN 0x26cu
+#define GENI_RX_LEN 0x270u
+#define GENI_SCL_COUNTERS 0x278u
+#define GENI_RX_PACK0 0x284u
+#define GENI_RX_PACK1 0x288u
+#define GENI_M_CMD0 0x600u
+#define GENI_M_CMD_CTRL 0x604u
+#define GENI_M_IRQ_STATUS 0x610u
+#define GENI_M_IRQ_EN 0x614u
+#define GENI_M_IRQ_CLEAR 0x618u
+#define GENI_TX_FIFO 0x700u
+#define GENI_RX_FIFO 0x780u
+#define GENI_TX_FIFO_STATUS 0x800u
+#define GENI_RX_FIFO_STATUS 0x804u
+#define GENI_TX_WATERMARK 0x80cu
+#define GENI_RX_WATERMARK 0x810u
+#define GENI_RX_RFR_WATERMARK 0x814u
+#define GENI_SE_IRQ_EN 0xe1cu
+#define GENI_HW_PARAM_0 0xe24u          /* bits 21:16 TX FIFO depth in words */
+#define GENI_HW_PARAM_1 0xe28u          /* bits 21:16 RX FIFO depth in words */
+#define GENI_TX_FIFO_WORDS(status) ((status) & 0x0fffffffu)
+#define GENI_RX_FIFO_WORDS(status) ((status) & 0x01ffffffu)
+
+/* M_IRQ bits. */
+#define GENI_M_CMD_DONE (1u << 0)
+#define GENI_M_CMD_OVERRUN (1u << 1)
+#define GENI_M_ILLEGAL_CMD (1u << 2)
+#define GENI_M_CMD_FAILURE (1u << 3)
+#define GENI_M_CMD_CANCEL (1u << 4)
+#define GENI_M_CMD_ABORT (1u << 5)
+#define GENI_M_GP_IRQ (0x3fu << 9)      /* I2C: NACK, bus error, arbitration lost and the like */
+#define GENI_M_RX_WATERMARK (1u << 26)
+#define GENI_M_RX_LAST (1u << 27)
+#define GENI_M_TX_WATERMARK (1u << 30)
+#define GENI_M_ERRORS (GENI_M_CMD_OVERRUN | GENI_M_ILLEGAL_CMD | GENI_M_CMD_FAILURE | GENI_M_GP_IRQ)
+/* What the engine is set to raise its line for. */
+#define GENI_M_IRQ_WANTED (GENI_M_CMD_DONE | GENI_M_ERRORS | GENI_M_CMD_CANCEL | GENI_M_CMD_ABORT | GENI_M_TX_WATERMARK)
+#define GENI_SE_M_IRQ_EN (1u << 2)
+#define GENI_CMD_CTRL_ABORT (1u << 1)
+#define GENI_CMD_CTRL_CANCEL (1u << 2)
+#define GENI_PROTO_I2C 3u
+#define GENI_OP_WRITE 1u
+#define GENI_OP_READ 2u
+#define GENI_STOP_STRETCH (1u << 2)
+
+typedef struct {
+    uint32_t (*read)(void *ctx, uint32_t reg);
+    void (*write)(void *ctx, uint32_t reg, uint32_t value);
+    void *ctx;
+} GeniIo;
+
+enum {GeniIdle, GeniTxWait, GeniWriteDone, GeniReadDone, GeniCancelling, GeniAborting};
+enum {GeniPending = 0, GeniDone = 1, GeniFailed = 2};
+/* Why the last transfer failed. */
+enum {GeniOk = 0, GeniErrBusy = 1, GeniErrBus = 2, GeniErrTimeout = 3, GeniErrNoData = 4, GeniErrState = 5};
+
+typedef struct {
+    GeniIo io;
+    uint8_t address, phase, reading, hold;
+    uint8_t reg, value, error, data;
+    uint8_t tx_words, rx_length;
+    uint32_t tx[2], length;
+    uint32_t rx;                     /* the bytes read, first byte in bits 7:0 */
+    uint32_t error_status;           /* the M_IRQ status of the last failure */
+    uint32_t done, failed, timeouts, stray;
+    /* Buffered transfers: the owner's buffers (its own until the transfer ends), the bytes moved so far, the FIFO depths in words. */
+    const uint8_t *tx_buffer;
+    uint8_t *rx_buffer;
+    uint32_t tx_done, rx_done, rx_total;
+    uint32_t tx_fifo_words, rx_fifo_words;
+} GeniI2c;
+
+/* Checks the engine runs the I2C firmware with its clock and timing set (the boot loader's), selects FIFO mode with 8-bit packing and
+ * enables the interrupts this core needs. Returns 0, or -1 when the engine is not usable. *config: proto << 24 | M_CLK_CFG bits 23:0. */
+int geni_i2c_prepare(GeniI2c *g, const GeniIo *io, uint8_t address, uint32_t *config);
+int geni_i2c_start_write(GeniI2c *g, uint8_t reg, uint8_t value);
+int geni_i2c_start_read(GeniI2c *g, uint8_t reg);
+/* Multi-byte forms for devices with wider registers: write 1..8 bytes; or write 1..4 bytes (holding the stop condition), then read 1..4
+ * bytes into g->rx. */
+int geni_i2c_start_write_bytes(GeniI2c *g, const uint8_t *bytes, uint32_t length);
+int geni_i2c_start_read_bytes(GeniI2c *g, const uint8_t *bytes, uint32_t length, uint32_t read_length);
+/* Buffered forms of any length: write length bytes from bytes; or write command_length (1..8) bytes holding the stop condition, then
+ * read length bytes into buffer. RX watermark and last interrupts are enabled for the read only. */
+int geni_i2c_start_write_buffer(GeniI2c *g, const uint8_t *bytes, uint32_t length);
+int geni_i2c_start_read_buffer(GeniI2c *g, const uint8_t *command, uint32_t command_length, uint8_t *buffer, uint32_t length);
+/* Feeds M_IRQ status bits (already cleared by whoever read them). Returns GeniPending, GeniDone (read value in g->data) or GeniFailed. */
+int geni_i2c_event(GeniI2c *g, uint32_t status);
+/* Reads and clears the status itself, then as geni_i2c_event (for a timer poll; the interrupt handler does the same in its context). */
+int geni_i2c_poll(GeniI2c *g);
+/* The owner's deadline for the current step passed: a pending transfer is cancelled, a cancel that is not acknowledged is aborted and an
+ * abort that is not acknowledged ends the transfer anyway. Returns as geni_i2c_event. */
+int geni_i2c_timeout(GeniI2c *g);
+static inline int geni_i2c_busy(const GeniI2c *g) {return g->phase != GeniIdle;}
+
+#ifdef __cplusplus
+}
+#endif
+#endif
