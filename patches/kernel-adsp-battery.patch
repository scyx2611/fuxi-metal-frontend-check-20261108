++		const char *library = mode != 0 ? fuxi_inject_library(mode, imgp->ip_ndp->ni_cnd.cn_pnbuf,
++		    imgp->ip_ndp->ni_cnd.cn_nameptr) : NULL;
++		char inject_env[FUXI_INJECT_ENV_MAX];
++
++		if (fuxi_inject_env(library, inject_env, sizeof(inject_env))) {
++			error = exec_add_user_string(imgp, CAST_USER_ADDR_T(inject_env), UIO_SYSSPACE, TRUE);
++			if (error) {
++				goto bad;
++			}
++			if (imgp->ip_argspace < new_ptr_size) {
++				error = E2BIG;
++				goto bad;
++			}
++			imgp->ip_argspace -= new_ptr_size;
++			imgp->ip_envc++;
++			fuxi_inject_said(mode, imgp->ip_ndp->ni_cnd.cn_nameptr, library);
