+		error = ufs_read_blocks(lba, blocks);
+		su.lun = saved;
+		if (!error) memcpy(dst, (const void *)(su.dma + DMA_BOUNCE), (size_t)blocks * UFS_BLOCK);
+	}
+	su.lun = saved;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return !error;
+}
