++        const uint32_t wait_ms = remaining > FUXI_BATTERY_POLL_PAUSE_MAX_DURATION_MS ?
++            FUXI_BATTERY_POLL_PAUSE_MAX_DURATION_MS : (uint32_t)remaining;
