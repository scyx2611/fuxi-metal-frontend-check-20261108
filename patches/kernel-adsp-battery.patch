diff --git a/xnu/fuxi-adsp/QcomGlink.c b/xnu/fuxi-adsp/QcomGlink.c
new file mode 100644
index 0000000..fee7b1f
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomGlink.c
@@ -0,0 +1,453 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomGlink.h"
+
+/* The sender keeps 8 bytes so a full FIFO never looks empty, and 16 more for a READ_NOTIF when it runs out of room. */
+#define FULL_RESERVE 8u
+#define BLOCKED_RESERVE 16u
+#define GLINK_VERSION_1 1u
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb osh" ::: "memory");
+#endif
+}
+static uint32_t align8(uint32_t v) {return (v + 7u) & ~7u;}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;}
+static void put32(uint8_t *p, uint32_t v) {p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);}
+static size_t name_length(const char *s) {size_t n = 0; while (n < QCOM_GLINK_NAME - 1 && s[n]) ++n; return n;}
+
+uint32_t qcom_glink_rx_avail(const QcomGlinkFifo *f)
+{
+    if (!f->data || !f->length) return 0;
+    const uint32_t head = *f->head, tail = *f->tail;
+    if (head >= f->length || tail >= f->length) return 0;
+    return head >= tail ? head - tail : f->length - tail + head;
+}
+
+uint32_t qcom_glink_tx_avail(const QcomGlinkFifo *f)
+{
+    const uint32_t head = *f->head, tail = *f->tail;
+    if (head >= f->length || tail >= f->length) return 0;
+    const uint32_t avail = tail <= head ? f->length - head + tail : tail - head;
+    return avail < FULL_RESERVE + BLOCKED_RESERVE ? 0 : avail - FULL_RESERVE - BLOCKED_RESERVE;
+}
+
+static void rx_peek(const QcomGlinkFifo *f, uint32_t offset, uint8_t *to, uint32_t count)
+{
+    uint32_t at = *f->tail + offset;
+    if (at >= f->length) at -= f->length;
+    for (uint32_t i = 0; i < count; ++i) {
+        to[i] = f->data[at];
+        if (++at == f->length) at = 0;
+    }
+}
+
+static void rx_advance(QcomGlinkFifo *f, uint32_t count)
+{
+    uint32_t tail = *f->tail + count;
+    if (tail >= f->length) tail -= f->length;
+    barrier();
+    *f->tail = tail;
+}
+
+/* Writes header and payload as one message (padded to 8 bytes); the caller checked the room. */
+static void tx_write(QcomGlink *g, const uint8_t *header, uint32_t header_length, const uint8_t *data, uint32_t data_length)
+{
+    QcomGlinkFifo *f = &g->tx;
+    uint32_t head = *f->head;
+    for (uint32_t i = 0; i < header_length; ++i) {f->data[head] = header[i]; if (++head == f->length) head = 0;}
+    for (uint32_t i = 0; i < data_length; ++i) {f->data[head] = data[i]; if (++head == f->length) head = 0;}
+    head = align8(head);
+    if (head >= f->length) head -= f->length;
+    barrier();
+    *f->head = head;
+    g->tx_messages++;
+    g->kick_pending = 1;
+}
+
+static int tx(QcomGlink *g, const uint8_t *header, uint32_t header_length, const uint8_t *data, uint32_t data_length)
+{
+    if (align8(header_length + data_length) > qcom_glink_tx_avail(&g->tx)) return QcomGlinkAgain;
+    tx_write(g, header, header_length, data, data_length);
+    return QcomGlinkOk;
+}
+
+static int command(QcomGlink *g, uint16_t cmd, uint16_t param1, uint32_t param2)
+{
+    uint8_t m[8];
+    m[0] = (uint8_t)cmd; m[1] = (uint8_t)(cmd >> 8); m[2] = (uint8_t)param1; m[3] = (uint8_t)(param1 >> 8);
+    put32(m + 4, param2);
+    return tx(g, m, 8, 0, 0);
+}
+
+void qcom_glink_init(QcomGlink *g, QcomGlinkFifo txf, QcomGlinkFifo rxf, void (*kick)(void *), void *kick_context)
+{
+    for (size_t i = 0; i < sizeof *g; ++i) ((uint8_t *)g)[i] = 0;
+    g->tx = txf;
+    g->rx = rxf;
+    g->kick = kick;
+    g->kick_context = kick_context;
+    g->features = QCOM_GLINK_FEATURE_INTENT_REUSE;
+    g->next_lcid = 1;
+    *g->tx.head = 0;
+    *g->rx.tail = 0;
+    barrier();
+}
+
+void qcom_glink_set_rx(QcomGlink *g, volatile uint8_t *data, uint32_t length)
+{
+    g->rx.data = data;
+    g->rx.length = length;
+}
+
+QcomGlinkChannel *qcom_glink_channel(QcomGlink *g, const char *name, uint32_t intent_size, uint32_t intent_count, uint8_t *storage,
+                                     const QcomGlinkClient *client, void *context, int open_now)
+{
+    if (!name || !client || intent_count > QCOM_GLINK_MAX_LOCAL_INTENTS || (intent_count && (!storage || !intent_size))) return 0;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i) {
+        QcomGlinkChannel *c = &g->channel[i];
+        if (c->used) continue;
+        for (size_t b = 0; b < sizeof *c; ++b) ((uint8_t *)c)[b] = 0;
+        const size_t n = name_length(name);
+        for (size_t b = 0; b < n; ++b) c->name[b] = name[b];
+        c->used = 1;
+        c->lcid = g->next_lcid++;
+        c->client = *client;
+        c->context = context;
+        c->storage = storage;
+        c->intent_size = intent_size;
+        c->intent_count = intent_count;
+        c->initiator = open_now != 0;
+        c->open_sent = open_now ? 0 : 2;  /* 2: wait for the remote's OPEN before sending ours */
+        return c;
+    }
+    return 0;
+}
+
+static QcomGlinkChannel *by_lcid(QcomGlink *g, uint32_t lcid)
+{
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i)
+        if (g->channel[i].used && g->channel[i].lcid == lcid) return &g->channel[i];
+    return 0;
+}
+static QcomGlinkChannel *by_rcid(QcomGlink *g, uint32_t rcid)
+{
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i)
+        if (g->channel[i].used && g->channel[i].remote_open && g->channel[i].rcid == rcid) return &g->channel[i];
+    return 0;
+}
+
+static int send_open(QcomGlink *g, QcomGlinkChannel *c)
+{
+    uint8_t m[8];
+    const uint32_t n = (uint32_t)name_length(c->name) + 1;
+    m[0] = QCOM_GLINK_OPEN; m[1] = 0; m[2] = (uint8_t)c->lcid; m[3] = (uint8_t)(c->lcid >> 8);
+    put32(m + 4, n);
+    if (align8(8 + n) > qcom_glink_tx_avail(&g->tx)) return QcomGlinkAgain;
+    tx_write(g, m, 8, (const uint8_t *)c->name, n);
+    c->open_sent = 1;
+    return QcomGlinkOk;
+}
+
+static int advertise(QcomGlink *g, QcomGlinkChannel *c, unsigned index)
+{
+    uint8_t m[16];
+    m[0] = QCOM_GLINK_INTENT; m[1] = 0; m[2] = (uint8_t)c->lcid; m[3] = (uint8_t)(c->lcid >> 8);
+    put32(m + 4, 1);
+    put32(m + 8, c->intent_size);
+    put32(m + 12, index + 1);
+    const int rc = tx(g, m, 16, 0, 0);
+    if (!rc) {c->local[index].advertised = 1; c->local[index].fill = 0;}
+    return rc;
+}
+
+static void reset_channel(QcomGlinkChannel *c)
+{
+    c->open_acked = c->remote_open = c->up = c->intent_asked = 0;
+    c->open_sent = c->initiator ? 0 : 2;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_LOCAL_INTENTS; ++i) c->local[i].advertised = c->local[i].busy = 0, c->local[i].fill = 0;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_REMOTE_INTENTS; ++i) c->remote[i].valid = 0;
+}
+
+/* Channel bring-up and our intents: whatever is due and fits in the FIFO now. */
+static void progress(QcomGlink *g)
+{
+    if (!g->version_sent) {
+        if (command(g, QCOM_GLINK_VERSION, GLINK_VERSION_1, g->features)) return;
+        g->version_sent = 1;
+    }
+    if (!g->version_agreed) return;
+    for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS; ++i) {
+        QcomGlinkChannel *c = &g->channel[i];
+        if (!c->used) continue;
+        if (c->open_sent == 0 || (c->open_sent == 2 && c->remote_open)) {
+            if (send_open(g, c)) return;
+        }
+        if (c->open_sent == 1 && c->open_acked && c->remote_open && !c->up) {
+            for (unsigned k = 0; k < c->intent_count; ++k)
+                if (!c->local[k].advertised && advertise(g, c, k)) return;
+            c->up = 1;
+            if (c->client.state) c->client.state(c->context, c, 1);
+        }
+        if (c->up)
+            for (unsigned k = 0; k < c->intent_count; ++k)
+                if (!c->local[k].advertised && !c->local[k].busy && advertise(g, c, k)) return;
+    }
+}
+
+static int handle_data(QcomGlink *g, uint16_t cmd, uint32_t rcid, uint32_t liid, uint32_t avail)
+{
+    uint8_t h[16];
+    if (avail < 16) return 0;
+    rx_peek(&g->rx, 0, h, 16);
+    const uint32_t chunk = le32(h + 8), left = le32(h + 12);
+    if (chunk > g->rx.length || align8(16 + chunk) < chunk) return QcomGlinkCorrupt;
+    if (avail < 16 + chunk) return 0;  /* not all there yet */
+    QcomGlinkChannel *c = by_rcid(g, rcid);
+    const unsigned index = liid - 1;
+    if (!c || !liid || index >= c->intent_count || !c->local[index].advertised) {
+        g->dropped++;
+    } else {
+        uint32_t fill = cmd == QCOM_GLINK_TX_DATA ? 0 : c->local[index].fill;
+        if ((uint64_t)fill + chunk + left > c->intent_size) {
+            g->dropped++;
+            fill = 0;
+        } else {
+            rx_peek(&g->rx, 16, c->storage + (size_t)index * c->intent_size + fill, chunk);
+            fill += chunk;
+            if (!left) {
+                c->local[index].busy = 1;
+                g->rx_data++;
+                if (c->client.receive) c->client.receive(c->context, c, c->storage + (size_t)index * c->intent_size, fill);
+                c->local[index].busy = 0;
+                fill = 0;
+                /* The intent is ours again once the remote knows it is done; with reuse it stays advertised. */
+                const int reuse = (g->features & QCOM_GLINK_FEATURE_INTENT_REUSE) != 0;
+                if (command(g, reuse ? QCOM_GLINK_RX_DONE_W_REUSE : QCOM_GLINK_RX_DONE, c->lcid, liid) == QcomGlinkOk && !reuse)
+                    c->local[index].advertised = 0;
+            }
+        }
+        c->local[index].fill = fill;
+    }
+    rx_advance(&g->rx, align8(16 + chunk));
+    return 1;
+}
+
+/* One message at the FIFO tail: 1 handled, 0 incomplete (wait for more), negative on a broken stream. */
+
+/* Adds name to the list of opens nobody serves unless it is there already or does not fit. */
+static void note_unknown(QcomGlink *g, const char *name)
+{
+    char *list = g->unknown_names;
+    const unsigned cap = sizeof g->unknown_names;
+    unsigned n = 0, used = 0;
+    while (n < QCOM_GLINK_NAME && name[n]) ++n;
+    while (used < cap && list[used]) ++used;
+    for (unsigned at = 0; at < used;) {
+        unsigned end = at;
+        while (end < used && list[end] != ' ') ++end;
+        unsigned same = end - at == n;
+        for (unsigned b = 0; same && b < n; ++b) same = list[at + b] == name[b];
+        if (same) return;
+        at = end + 1;
+    }
+    if (!n || used + (used ? 1 : 0) + n + 1 > cap) return;
+    if (used) list[used++] = ' ';
+    for (unsigned b = 0; b < n; ++b) list[used++] = name[b];
+    list[used] = 0;
+}
+static int receive_one(QcomGlink *g)
+{
+    const uint32_t avail = qcom_glink_rx_avail(&g->rx);
+    uint8_t m[8];
+    if (avail < 8) return 0;
+    rx_peek(&g->rx, 0, m, 8);
+    const uint16_t cmd = (uint16_t)(m[0] | m[1] << 8), param1 = (uint16_t)(m[2] | m[3] << 8);
+    const uint32_t param2 = le32(m + 4);
+    QcomGlinkChannel *c;
+    switch (cmd) {
+    case QCOM_GLINK_VERSION:
+        if (param1 == GLINK_VERSION_1) g->features &= param2;
+        if (param1 && command(g, QCOM_GLINK_VERSION_ACK, GLINK_VERSION_1, g->features)) return 0;
+        g->version_agreed = param1 != 0;
+        break;
+    case QCOM_GLINK_VERSION_ACK:
+        if (param1 == GLINK_VERSION_1 && param2 != g->features) {
+            g->features &= param2;
+            if (command(g, QCOM_GLINK_VERSION, GLINK_VERSION_1, g->features)) return 0;
+        }
+        g->version_agreed = param1 != 0;
+        break;
+    case QCOM_GLINK_OPEN: {
+        const uint32_t n = param2 & 0xffff;
+        if (n > g->rx.length || n == 0) return QcomGlinkCorrupt;
+        if (avail < 8 + n) return 0;
+        char name[QCOM_GLINK_NAME] = {0};
+        rx_peek(&g->rx, 8, (uint8_t *)name, n < QCOM_GLINK_NAME ? n : QCOM_GLINK_NAME - 1);
+        name[QCOM_GLINK_NAME - 1] = 0;
+        c = 0;
+        for (unsigned i = 0; i < QCOM_GLINK_MAX_CHANNELS && !c; ++i) {
+            QcomGlinkChannel *k = &g->channel[i];
+            unsigned same = k->used;
+            for (unsigned b = 0; same && b < QCOM_GLINK_NAME; ++b) {
+                if (k->name[b] != name[b]) same = 0;
+                if (!name[b]) break;
+            }
+            if (same) c = k;
+        }
+        if (!c) {
+            g->unknown_opens++;
+            for (unsigned b = 0; b < QCOM_GLINK_NAME; ++b) g->last_unknown[b] = name[b];
+            note_unknown(g, name);
+        } else {
+            if (c->remote_open && c->up && c->client.state) c->client.state(c->context, c, 0);
+            if (c->remote_open) reset_channel(c);
+            if (command(g, QCOM_GLINK_OPEN_ACK, param1, 0)) return 0;
+            c->rcid = param1;
+            c->remote_open = 1;
+        }
+        rx_advance(&g->rx, align8(8 + n));
+        g->rx_messages++;
+        return 1;
+    }
+    case QCOM_GLINK_OPEN_ACK:
+        if ((c = by_lcid(g, param1)) && c->open_sent == 1) c->open_acked = 1;
+        break;
+    case QCOM_GLINK_CLOSE:
+        if (command(g, QCOM_GLINK_CLOSE_ACK, param1, 0)) return 0;
+        if ((c = by_rcid(g, param1))) {
+            const int was = c->up;
+            if (c->open_sent == 1 && command(g, QCOM_GLINK_CLOSE, c->lcid, 0)) return 0;
+            reset_channel(c);
+            if (was && c->client.state) c->client.state(c->context, c, 0);
+        }
+        break;
+    case QCOM_GLINK_CLOSE_ACK:
+        break;
+    case QCOM_GLINK_INTENT: {
+        if (param2 > (g->rx.length - 8) / 8) return QcomGlinkCorrupt;
+        const uint32_t bytes = 8 + 8 * param2;
+        if (avail < bytes) return 0;
+        c = by_rcid(g, param1);
+        for (uint32_t i = 0; i < param2; ++i) {
+            uint8_t pair[8];
+            rx_peek(&g->rx, 8 + 8 * i, pair, 8);
+            if (!c) continue;
+            unsigned slot = QCOM_GLINK_MAX_REMOTE_INTENTS;
+            for (unsigned k = 0; k < QCOM_GLINK_MAX_REMOTE_INTENTS; ++k)
+                if (!c->remote[k].valid) {slot = k; break;}
+            /* Full: a larger intent (the one a send asked for) replaces the smallest idle one, so it is never lost. */
+            if (slot == QCOM_GLINK_MAX_REMOTE_INTENTS)
+                for (unsigned k = 0; k < QCOM_GLINK_MAX_REMOTE_INTENTS; ++k)
+                    if (!c->remote[k].busy && c->remote[k].size < le32(pair) &&
+                        (slot == QCOM_GLINK_MAX_REMOTE_INTENTS || c->remote[k].size < c->remote[slot].size)) slot = k;
+            if (slot == QCOM_GLINK_MAX_REMOTE_INTENTS) {g->dropped++; continue;}
+            c->remote[slot].size = le32(pair);
+            c->remote[slot].id = le32(pair + 4);
+            c->remote[slot].valid = 1;
+            c->remote[slot].busy = 0;
+        }
+        if (c) c->intent_asked = 0;
+        rx_advance(&g->rx, align8(bytes));
+        g->rx_messages++;
+        return 1;
+    }
+    case QCOM_GLINK_RX_DONE:
+    case QCOM_GLINK_RX_DONE_W_REUSE:
+        if ((c = by_rcid(g, param1)))
+            for (unsigned k = 0; k < QCOM_GLINK_MAX_REMOTE_INTENTS; ++k)
+                if (c->remote[k].valid && c->remote[k].id == param2) {
+                    c->remote[k].busy = 0;
+                    if (cmd == QCOM_GLINK_RX_DONE) c->remote[k].valid = 0;
+                    break;
+                }
+        break;
+    case QCOM_GLINK_RX_INTENT_REQ: {
+        /* Grant it if a buffer of ours that is big enough is not advertised (all are, normally: then refuse). */
+        int granted = 0;
+        if ((c = by_rcid(g, param1)) && c->up && param2 <= c->intent_size)
+            for (unsigned k = 0; k < c->intent_count; ++k)
+                if (!c->local[k].advertised && !c->local[k].busy) {
+                    if (advertise(g, c, k)) return 0;
+                    granted = 1;
+                    break;
+                }
+        if (command(g, QCOM_GLINK_RX_INTENT_REQ_ACK, c ? c->lcid : param1, (uint32_t)granted)) return 0;
+        break;
+    }
+    case QCOM_GLINK_RX_INTENT_REQ_ACK:
+        if ((c = by_rcid(g, param1)) && !param2) c->intent_asked = 0;
+        break;
+    case QCOM_GLINK_TX_DATA:
+    case QCOM_GLINK_TX_DATA_CONT: {
+        const int rc = handle_data(g, cmd, param1, param2, avail);
+        if (rc == 1) g->rx_messages++;
+        return rc;
+    }
+    case QCOM_GLINK_READ_NOTIF:
+        g->kick_pending = 1;
+        break;
+    case QCOM_GLINK_SIGNALS:
+        break;
+    default:
+        return QcomGlinkCorrupt;
+    }
+    rx_advance(&g->rx, 8);
+    g->rx_messages++;
+    return 1;
+}
+
+int qcom_glink_poll(QcomGlink *g)
+{
+    if (g->broken) return QcomGlinkCorrupt;
+    int handled = 0;
+    g->notify_sent = 0;
+    progress(g);
+    /* Bounded: at most one FIFO's worth of minimal messages per call. */
+    for (uint32_t budget = g->rx.length / 8 + 1; g->rx.data && budget; --budget) {
+        const int rc = receive_one(g);
+        if (rc < 0) {g->broken = 1; handled = rc; break;}
+        if (!rc) break;
+        ++handled;
+    }
+    if (!g->broken) progress(g);
+    if (g->kick_pending && g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+    return handled;
+}
+
+int qcom_glink_send(QcomGlink *g, QcomGlinkChannel *c, const void *data, uint32_t length)
+{
+    if (!g || !c || (!data && length)) return QcomGlinkArgument;
+    if (g->broken || !c->up) return QcomGlinkNotOpen;
+    if (align8(16 + length) > g->tx.length / 2) return QcomGlinkTooBig;
+    unsigned best = QCOM_GLINK_MAX_REMOTE_INTENTS;
+    for (unsigned k = 0; k < QCOM_GLINK_MAX_REMOTE_INTENTS; ++k)
+        if (c->remote[k].valid && !c->remote[k].busy && c->remote[k].size >= length &&
+            (best == QCOM_GLINK_MAX_REMOTE_INTENTS || c->remote[k].size < c->remote[best].size))
+            best = k;
+    if (best == QCOM_GLINK_MAX_REMOTE_INTENTS) {
+        if (!c->intent_asked && command(g, QCOM_GLINK_RX_INTENT_REQ, c->lcid, length) == QcomGlinkOk) c->intent_asked = 1;
+        if (g->kick_pending && g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+        return QcomGlinkAgain;
+    }
+    uint8_t h[16];
+    h[0] = QCOM_GLINK_TX_DATA; h[1] = 0; h[2] = (uint8_t)c->lcid; h[3] = (uint8_t)(c->lcid >> 8);
+    put32(h + 4, c->remote[best].id);
+    put32(h + 8, length);
+    put32(h + 12, 0);
+    if (tx(g, h, 16, (const uint8_t *)data, length)) {
+        /* Ask the remote to ring us once it has read, so the owner retries then. */
+        const uint32_t head = *g->tx.head, tail = *g->tx.tail;
+        if (!g->notify_sent && head < g->tx.length && tail < g->tx.length) {
+            uint8_t m[8] = {QCOM_GLINK_READ_NOTIF, 0, 0, 0, 0, 0, 0, 0};
+            const uint32_t raw = tail <= head ? g->tx.length - head + tail : tail - head;
+            if (raw >= FULL_RESERVE + 8) {tx_write(g, m, 8, 0, 0); g->notify_sent = 1;}
+        }
+        if (g->kick_pending && g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+        return QcomGlinkAgain;
+    }
+    c->remote[best].busy = 1;
+    if (g->kick) {g->kick_pending = 0; g->kick(g->kick_context);}
+    return QcomGlinkOk;
+}
diff --git a/xnu/fuxi-adsp/QcomGlink.h b/xnu/fuxi-adsp/QcomGlink.h
new file mode 100644
index 0000000..1fb845c
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomGlink.h
@@ -0,0 +1,100 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* GLINK over shared memory: the native GLINK protocol (version handshake, channel open/close, receive intents, data, done) on a pair of
+ * SMEM FIFOs. Event driven and allocation free: the owner calls qcom_glink_poll whenever the remote rings the GLINK doorbell (and after
+ * sending), every call does a bounded amount of work, and nothing here waits. A send that cannot go out yet (no remote intent, no FIFO
+ * room) returns QcomGlinkAgain and the owner tries again on the next event; an intent is asked for once per pending send. */
+#ifndef QCOM_GLINK_H
+#define QCOM_GLINK_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_GLINK_MAX_CHANNELS 6u
+#define QCOM_GLINK_MAX_REMOTE_INTENTS 48u   /* the audio DSP offers 24 small intents on adsp_apps before granting a larger one */
+#define QCOM_GLINK_MAX_LOCAL_INTENTS 24u
+#define QCOM_GLINK_NAME 32u
+#define QCOM_GLINK_FEATURE_INTENT_REUSE 1u
+
+enum {
+    QCOM_GLINK_VERSION = 0, QCOM_GLINK_VERSION_ACK = 1, QCOM_GLINK_OPEN = 2, QCOM_GLINK_CLOSE = 3, QCOM_GLINK_OPEN_ACK = 4,
+    QCOM_GLINK_INTENT = 5, QCOM_GLINK_RX_DONE = 6, QCOM_GLINK_RX_INTENT_REQ = 7, QCOM_GLINK_RX_INTENT_REQ_ACK = 8,
+    QCOM_GLINK_TX_DATA = 9, QCOM_GLINK_CLOSE_ACK = 11, QCOM_GLINK_TX_DATA_CONT = 12, QCOM_GLINK_READ_NOTIF = 13,
+    QCOM_GLINK_RX_DONE_W_REUSE = 14, QCOM_GLINK_SIGNALS = 15,
+};
+
+enum {
+    QcomGlinkOk = 0,
+    QcomGlinkAgain = -1,    /* not now: no intent or no FIFO room yet */
+    QcomGlinkNotOpen = -2,
+    QcomGlinkTooBig = -3,
+    QcomGlinkFull = -4,     /* no channel slot */
+    QcomGlinkCorrupt = -5,  /* the receive FIFO holds something that cannot be a message: the link is stopped */
+    QcomGlinkArgument = -6,
+};
+
+/* One direction's FIFO in SMEM: indices are byte offsets into data. */
+typedef struct {
+    volatile uint32_t *head, *tail;
+    volatile uint8_t *data;
+    uint32_t length;
+} QcomGlinkFifo;
+
+typedef struct QcomGlinkChannel QcomGlinkChannel;
+typedef struct {
+    void (*state)(void *context, QcomGlinkChannel *channel, int up);
+    /* A complete message; data stays valid for the duration of the call only. */
+    void (*receive)(void *context, QcomGlinkChannel *channel, const uint8_t *data, uint32_t length);
+} QcomGlinkClient;
+
+struct QcomGlinkChannel {
+    char name[QCOM_GLINK_NAME];
+    uint16_t lcid, rcid;
+    uint8_t used, initiator, open_sent, open_acked, remote_open, up, intent_asked;
+    QcomGlinkClient client;
+    void *context;
+    /* Our receive intents: count buffers of size bytes in storage (count * size). */
+    uint8_t *storage;
+    uint32_t intent_size, intent_count;
+    struct {uint32_t fill; uint8_t advertised, busy;} local[QCOM_GLINK_MAX_LOCAL_INTENTS];
+    /* The remote's intents we may send into. */
+    struct {uint32_t id, size; uint8_t valid, busy;} remote[QCOM_GLINK_MAX_REMOTE_INTENTS];
+};
+
+typedef struct {
+    QcomGlinkFifo tx, rx;
+    void (*kick)(void *context);
+    void *kick_context;
+    uint32_t features;
+    uint8_t version_sent, version_agreed, broken, kick_pending, notify_sent;
+    uint16_t next_lcid;
+    QcomGlinkChannel channel[QCOM_GLINK_MAX_CHANNELS];
+    /* Counters for the log. */
+    uint32_t rx_messages, tx_messages, rx_data, unknown_opens, dropped;
+    char last_unknown[QCOM_GLINK_NAME];
+    char unknown_names[96];  /* the distinct names of those opens, space separated, as many as fit */
+} QcomGlink;
+
+/* Sets up the link on its FIFOs (rx may have no data yet: the remote makes its FIFO later) and resets the indices we own. */
+void qcom_glink_init(QcomGlink *g, QcomGlinkFifo tx, QcomGlinkFifo rx, void (*kick)(void *), void *kick_context);
+/* The remote's FIFO once it exists. */
+void qcom_glink_set_rx(QcomGlink *g, volatile uint8_t *data, uint32_t length);
+/* Registers a channel by name with intent_count receive buffers of intent_size bytes in storage. open_now: we send OPEN ourselves;
+ * otherwise we answer when the remote opens it. */
+QcomGlinkChannel *qcom_glink_channel(QcomGlink *g, const char *name, uint32_t intent_size, uint32_t intent_count, uint8_t *storage,
+                                     const QcomGlinkClient *client, void *context, int open_now);
+/* Sends VERSION (once) and any channel OPEN that is due, then handles every complete message in the receive FIFO. Returns the number of
+ * messages handled or QcomGlinkCorrupt. Rings the remote when anything was written. */
+int qcom_glink_poll(QcomGlink *g);
+/* Queues one message on an open channel (single chunk, up to the remote intent size). */
+int qcom_glink_send(QcomGlink *g, QcomGlinkChannel *channel, const void *data, uint32_t length);
+
+/* FIFO primitives, exposed for the tests. */
+uint32_t qcom_glink_rx_avail(const QcomGlinkFifo *f);
+uint32_t qcom_glink_tx_avail(const QcomGlinkFifo *f);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/QcomMdt.c b/xnu/fuxi-adsp/QcomMdt.c
new file mode 100644
index 0000000..8688b0f
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomMdt.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomMdt.h"
+
+#define PT_LOAD_ 1u
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static uint64_t le64(const uint8_t *p) {return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+
+int qcom_mdt_parse(QcomMdtImage *image, uint64_t file_size, QcomMdtRead read, void *context)
+{
+    uint8_t e[64];
+    if (!image || !read) return QcomMdtReadError;
+    *image = (QcomMdtImage){0};
+    image->hash = -1;
+    image->file_size = file_size;
+    if (file_size < 52 || read(context, 0, e, file_size < 64 ? 52 : 64)) return file_size < 52 ? QcomMdtTooSmall : QcomMdtReadError;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 /* little endian */) return QcomMdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (!elf64 && e[4] != 1) return QcomMdtNotElf;
+    if (elf64 && file_size < 64) return QcomMdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return QcomMdtBadHeaders;
+    if (phnum > QCOM_MDT_MAX_SEGMENTS) return QcomMdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, file_size)) return QcomMdtBadHeaders;
+    image->elf64 = (uint8_t)elf64;
+    image->count = phnum;
+    uint64_t lo = UINT64_MAX, hi = 0;
+    for (unsigned i = 0; i < phnum; ++i) {
+        uint8_t p[56];
+        if (read(context, phoff + (uint64_t)i * phentsize, p, phentsize)) return QcomMdtReadError;
+        QcomMdtSegment *s = &image->segment[i];
+        const uint32_t type = le32(p);
+        if (elf64) {
+            s->flags = le32(p + 4); s->file_offset = le64(p + 8); s->address = le64(p + 24);
+            s->file_size = le64(p + 32); s->memory_size = le64(p + 40);
+        } else {
+            s->file_offset = le32(p + 4); s->address = le32(p + 12); s->file_size = le32(p + 16);
+            s->memory_size = le32(p + 20); s->flags = le32(p + 24);
+        }
+        if ((s->flags & QCOM_MDT_TYPE_MASK) == QCOM_MDT_TYPE_HASH) {
+            if (image->hash < 0) image->hash = (int)i;
+            continue;
+        }
+        if (type != PT_LOAD_ || !s->memory_size) continue;
+        if (s->file_size > s->memory_size) return QcomMdtBadHeaders;
+        if (s->address + s->memory_size < s->address) return QcomMdtBadHeaders;
+        s->load = 1;
+        if (s->flags & QCOM_MDT_RELOCATABLE) image->relocatable = 1;
+        if (s->address < lo) lo = s->address;
+        if (s->address + s->memory_size > hi) hi = s->address + s->memory_size;
+    }
+    if (image->hash < 0) return QcomMdtNoHash;
+    if (hi == 0) return QcomMdtNoSegments;
+    image->header_size = image->segment[0].file_size;
+    /* The first program header (PT_NULL) covers the ELF header and the program headers themselves. */
+    if (!image->header_size || !fits(0, image->header_size, file_size) || image->header_size < phoff + (uint64_t)phentsize * phnum)
+        return QcomMdtBadHeaders;
+    image->min_address = lo;
+    image->max_address = hi;
+    return QcomMdtOk;
+}
+
+uint64_t qcom_mdt_metadata_size(const QcomMdtImage *image)
+{
+    return image->header_size + image->segment[image->hash].file_size;
+}
+
+int qcom_mdt_metadata(const QcomMdtImage *image, QcomMdtRead read, void *context, uint8_t *to, uint64_t capacity)
+{
+    const QcomMdtSegment *hash = &image->segment[image->hash];
+    if (capacity < qcom_mdt_metadata_size(image)) return QcomMdtTooSmall;
+    uint64_t hash_offset;
+    /* A hash packed right behind the headers (the split .mdt form) or a hash segment inside the file. */
+    if (image->header_size + hash->file_size == image->file_size) hash_offset = image->header_size;
+    else if (fits(hash->file_offset, hash->file_size, image->file_size)) hash_offset = hash->file_offset;
+    else return QcomMdtOutside;
+    if (read(context, 0, to, (size_t)image->header_size)) return QcomMdtReadError;
+    if (read(context, hash_offset, to + image->header_size, (size_t)hash->file_size)) return QcomMdtReadError;
+    return QcomMdtOk;
+}
+
+/* The secure world takes the span with its end rounded up to a 4 KiB page and refuses an unaligned one. */
+uint64_t qcom_mdt_span(const QcomMdtImage *image) {return ((image->max_address + 0xfff) & ~0xfffull) - image->min_address;}
+
+int qcom_mdt_place(const QcomMdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset)
+{
+    if (index >= image->count || !image->segment[index].load) return QcomMdtOutside;
+    const QcomMdtSegment *s = &image->segment[index];
+    uint64_t at;
+    if (image->relocatable) at = s->address - image->min_address;
+    else if (s->address >= region_base) at = s->address - region_base;
+    else return QcomMdtOutside;
+    if (!fits(at, s->memory_size, region_size)) return QcomMdtOutside;
+    if (s->file_size && !fits(s->file_offset, s->file_size, image->file_size)) return QcomMdtOutside;
+    *offset = at;
+    return QcomMdtOk;
+}
+
+int qcom_mdt_split(QcomMdtSplit *split, const uint8_t *headers, size_t length)
+{
+    if (!split || !headers) return QcomMdtReadError;
+    *split = (QcomMdtSplit){0};
+    if (length < 52) return QcomMdtTooSmall;
+    const uint8_t *e = headers;
+    if (e[0] != 0x7f || e[1] != 'E' || e[2] != 'L' || e[3] != 'F' || e[5] != 1 || (e[4] != 1 && e[4] != 2)) return QcomMdtNotElf;
+    const int elf64 = e[4] == 2;
+    if (elf64 && length < 64) return QcomMdtTooSmall;
+    const uint64_t phoff = elf64 ? le64(e + 32) : le32(e + 28);
+    const unsigned phentsize = elf64 ? le16(e + 54) : le16(e + 42), phnum = elf64 ? le16(e + 56) : le16(e + 44);
+    if (phentsize != (elf64 ? 56u : 32u) || !phnum) return QcomMdtBadHeaders;
+    if (phnum > QCOM_MDT_MAX_SEGMENTS) return QcomMdtTooMany;
+    if (!fits(phoff, (uint64_t)phentsize * phnum, length)) return QcomMdtBadHeaders;
+    split->count = phnum;
+    for (unsigned i = 0; i < phnum; ++i) {
+        const uint8_t *p = e + phoff + (uint64_t)i * phentsize;
+        const uint64_t offset = elf64 ? le64(p + 8) : le32(p + 4), size = elf64 ? le64(p + 32) : le32(p + 16);
+        if (offset + size < offset) return QcomMdtBadHeaders;
+        split->piece[i].offset = offset;
+        split->piece[i].size = size;
+        if (size && offset + size > split->size) split->size = offset + size;
+    }
+    /* piece 0 must be the headers themselves */
+    if (split->piece[0].offset || split->piece[0].size < phoff + (uint64_t)phentsize * phnum) return QcomMdtBadHeaders;
+    return QcomMdtOk;
+}
+
+int qcom_mdt_split_read(const QcomMdtSplit *split, QcomMdtPieceRead read, void *context, uint64_t offset, void *to, size_t length)
+{
+    uint8_t *out = to;
+    if (!split || !read || !to || !fits(offset, length, split->size)) return QcomMdtOutside;
+    while (length) {
+        /* the piece holding offset, or else the distance to the next piece */
+        uint64_t take = length, gap_end = split->size;
+        int hit = -1;
+        for (unsigned i = 0; i < split->count; ++i) {
+            const uint64_t at = split->piece[i].offset, size = split->piece[i].size;
+            if (!size) continue;
+            if (offset >= at && offset - at < size) {hit = (int)i; break;}
+            if (at > offset && at < gap_end) gap_end = at;
+        }
+        if (hit >= 0) {
+            const uint64_t left = split->piece[hit].offset + split->piece[hit].size - offset;
+            if (take > left) take = left;
+            if (read(context, (unsigned)hit, offset - split->piece[hit].offset, out, (size_t)take)) return QcomMdtReadError;
+        } else {
+            if (take > gap_end - offset) take = gap_end - offset;
+            for (uint64_t i = 0; i < take; ++i) out[i] = 0;
+        }
+        out += take;
+        offset += take;
+        length -= (size_t)take;
+    }
+    return QcomMdtOk;
+}
diff --git a/xnu/fuxi-adsp/QcomMdt.h b/xnu/fuxi-adsp/QcomMdt.h
new file mode 100644
index 0000000..5728297
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomMdt.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Qualcomm signed firmware images (.mbn, an ELF32 or ELF64 whose program headers carry the segment types in p_flags) as the peripheral
+ * authentication service takes them: the metadata handed to the secure world (the ELF and program headers followed by the hash
+ * segment), the extent of the loadable segments and where each one goes in the carveout. Pure parsing over a read callback: no
+ * allocation, no hardware, so the same code runs in the kernel and in the host tests. */
+#ifndef QCOM_MDT_H
+#define QCOM_MDT_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_MDT_MAX_SEGMENTS 64u
+#define QCOM_MDT_TYPE_MASK (7u << 24)
+#define QCOM_MDT_TYPE_HASH (2u << 24)
+#define QCOM_MDT_RELOCATABLE (1u << 27)
+
+/* Reads length bytes at offset of the image file into to; returns 0 on success. */
+typedef int (*QcomMdtRead)(void *context, uint64_t offset, void *to, size_t length);
+
+typedef struct {
+    uint64_t file_offset, file_size, memory_size, address;  /* address: p_paddr */
+    uint32_t flags;
+    uint8_t load;  /* a loadable segment (PT_LOAD, not the hash, memory size not zero) */
+} QcomMdtSegment;
+
+typedef struct {
+    uint8_t elf64;
+    uint32_t count;
+    QcomMdtSegment segment[QCOM_MDT_MAX_SEGMENTS];
+    int hash;                        /* index of the hash segment */
+    uint64_t header_size;            /* p_filesz of the first program header: ELF header plus program headers */
+    uint64_t min_address, max_address;  /* of the loadable segments */
+    uint8_t relocatable;
+    uint64_t file_size;
+} QcomMdtImage;
+
+enum {
+    QcomMdtOk = 0,
+    QcomMdtReadError = -1,
+    QcomMdtNotElf = -2,
+    QcomMdtBadHeaders = -3,
+    QcomMdtNoHash = -4,
+    QcomMdtTooMany = -5,
+    QcomMdtNoSegments = -6,
+    QcomMdtOutside = -7,
+    QcomMdtTooSmall = -8,
+};
+
+/* Parses the ELF and program headers of an image of file_size bytes. */
+int qcom_mdt_parse(QcomMdtImage *image, uint64_t file_size, QcomMdtRead read, void *context);
+
+/* Bytes of the metadata blob for the authentication service: the header part and the hash segment. */
+uint64_t qcom_mdt_metadata_size(const QcomMdtImage *image);
+
+/* Writes the metadata blob (qcom_mdt_metadata_size bytes) to to. The hash segment must lie inside the file: images split into .bNN
+ * files are joined into one .mbn on the host before they are installed. */
+int qcom_mdt_metadata(const QcomMdtImage *image, QcomMdtRead read, void *context, uint8_t *to, uint64_t capacity);
+
+/* Bytes the loadable segments span (the end rounded up to 4 KiB, minus the lowest address): the size to hand to the memory setup call
+ * of a relocatable image. */
+uint64_t qcom_mdt_span(const QcomMdtImage *image);
+
+/* Offset of a loadable segment inside a carveout of region_size bytes at region_base: relocatable images are placed by their offset from
+ * the lowest segment, fixed ones by their address. Returns QcomMdtOutside if the segment does not fit. */
+int qcom_mdt_place(const QcomMdtImage *image, unsigned index, uint64_t region_base, uint64_t region_size, uint64_t *offset);
+
+/* A split image (NAME.b00, NAME.b01, ... as found on the device's firmware partition) read as the joined image: the bytes of program
+ * header i's segment come from piece i (NAME.bNN) at the segment's file offset, piece 0 being the ELF and program headers; whatever
+ * lies between the pieces reads as zero. The pieces are the caller's files. */
+typedef int (*QcomMdtPieceRead)(void *context, unsigned piece, uint64_t offset, void *to, size_t length);
+typedef struct {
+    uint32_t count;
+    struct {uint64_t offset, size;} piece[QCOM_MDT_MAX_SEGMENTS];  /* size 0: no piece file for this header */
+    uint64_t size;                                                  /* bytes of the joined image */
+} QcomMdtSplit;
+
+/* Lays out the pieces from the headers (the bytes of NAME.b00, or the start of NAME.mdt). */
+int qcom_mdt_split(QcomMdtSplit *split, const uint8_t *headers, size_t length);
+/* Reads a range of the joined image. */
+int qcom_mdt_split_read(const QcomMdtSplit *split, QcomMdtPieceRead read, void *context, uint64_t offset, void *to, size_t length);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/QcomQmp.c b/xnu/fuxi-adsp/QcomQmp.c
new file mode 100644
index 0000000..da04166
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomQmp.c
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomQmp.h"
+
+/* Descriptor words (byte offset / 4): magic, version, features; the AOP's link state, its ack, channel state, its ack, mailbox size and
+ * offset; then the same six for our side. */
+#define MAGIC 0x4d41494cu
+#define D_MAGIC 0
+#define D_VERSION 1
+#define D_UCORE_LINK 3
+#define D_UCORE_LINK_ACK 4
+#define D_UCORE_CH 5
+#define D_UCORE_CH_ACK 6
+#define D_MCORE_LINK 9
+#define D_MCORE_LINK_ACK 10
+#define D_MCORE_CH 11
+#define D_MCORE_CH_ACK 12
+#define D_MCORE_SIZE 13
+#define D_MCORE_OFFSET 14
+#define UP 0x0000ffffu
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+static void kick(QcomQmp *q) {barrier(); if (q->kick) q->kick(q->context);}
+
+void qcom_qmp_init(QcomQmp *q, volatile uint32_t *ram, uint32_t ram_bytes, void (*k)(void *), void *context)
+{
+    *q = (QcomQmp){ram, ram_bytes, 0, 0, QcomQmpIdle, k, context};
+}
+
+int qcom_qmp_step(QcomQmp *q)
+{
+    volatile uint32_t *r = q->ram;
+    switch (q->state) {
+    case QcomQmpIdle: {
+        if (r[D_MAGIC] != MAGIC || r[D_VERSION] != 1) return q->state = QcomQmpBadDescriptor;
+        const uint32_t box = r[D_MCORE_OFFSET], size = r[D_MCORE_SIZE];
+        if ((box & 3) || size < QCOM_QMP_MESSAGE + 4 || box < 0x3c || box > q->ram_bytes || size > q->ram_bytes - box)
+            return q->state = QcomQmpBadDescriptor;
+        q->box = box;
+        q->box_size = size;
+        /* A channel a boot stage left open is used as it is. */
+        if (r[D_MCORE_LINK] == UP && r[D_MCORE_LINK_ACK] == UP && r[D_MCORE_CH] == UP && r[D_UCORE_CH] == UP && r[D_MCORE_CH_ACK] == UP)
+            return q->state = QcomQmpOpen;
+        r[D_UCORE_LINK_ACK] = r[D_UCORE_LINK];
+        r[D_MCORE_LINK] = UP;
+        kick(q);
+        q->state = QcomQmpLinkWait;
+    }
+        /* fall through: the ack may already be there */
+    case QcomQmpLinkWait:
+        if (r[D_MCORE_LINK_ACK] != UP) return q->state;
+        r[D_MCORE_CH] = UP;
+        kick(q);
+        q->state = QcomQmpChannelWait;
+        /* fall through */
+    case QcomQmpChannelWait:
+        if (r[D_UCORE_CH] != UP) return q->state;
+        r[D_UCORE_CH_ACK] = UP;
+        kick(q);
+        q->state = QcomQmpAckWait;
+        /* fall through */
+    case QcomQmpAckWait:
+        if (r[D_MCORE_CH_ACK] != UP) return q->state;
+        return q->state = QcomQmpOpen;
+    case QcomQmpSending:
+        if (r[q->box / 4] != 0) return q->state;
+        return q->state = QcomQmpOpen;
+    default:
+        return q->state;
+    }
+}
+
+int qcom_qmp_send(QcomQmp *q, const char *text)
+{
+    if (q->state != QcomQmpOpen) return QcomQmpBusy;
+    uint32_t words[QCOM_QMP_MESSAGE / 4] = {0};
+    unsigned n = 0;
+    while (text[n]) {
+        if (n >= QCOM_QMP_MESSAGE - 1) return QcomQmpTooLong;
+        words[n / 4] |= (uint32_t)(uint8_t)text[n] << (8 * (n % 4));
+        ++n;
+    }
+    volatile uint32_t *r = q->ram;
+    if (r[q->box / 4] != 0) return QcomQmpBusy;
+    for (unsigned i = 0; i < QCOM_QMP_MESSAGE / 4; ++i) r[q->box / 4 + 1 + i] = words[i];
+    barrier();
+    r[q->box / 4] = QCOM_QMP_MESSAGE;
+    kick(q);
+    return q->state = QcomQmpSending;
+}
+
+void qcom_qmp_abandon(QcomQmp *q)
+{
+    if (q->state != QcomQmpSending) return;
+    q->ram[q->box / 4] = 0;
+    barrier();
+    q->state = QcomQmpOpen;
+}
diff --git a/xnu/fuxi-adsp/QcomQmp.h b/xnu/fuxi-adsp/QcomQmp.h
new file mode 100644
index 0000000..e411345
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomQmp.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The AOSS QMP mailbox: a message RAM shared with the always-on processor, a link and channel handshake, then one text message at a
+ * time ("{class: image, res: load_state, name: adsp, val: on}"). Written as a state machine stepped on each doorbell from the AOP (or a
+ * timer): qcom_qmp_step never waits, it returns what it is waiting for and the owner calls it again when the AOP rings or the deadline
+ * passes. Ringing the AOP is the owner's kick callback. */
+#ifndef QCOM_QMP_H
+#define QCOM_QMP_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_QMP_MESSAGE 0x64u  /* message length the AOP takes (padded with zeroes) */
+
+enum {
+    QcomQmpIdle = 0,         /* closed, nothing started */
+    QcomQmpLinkWait = 1,     /* our link is up, waiting for the AOP's ack */
+    QcomQmpChannelWait = 2,  /* our channel is up, waiting for the AOP's channel */
+    QcomQmpAckWait = 3,      /* the AOP's channel acked, waiting for its ack of ours */
+    QcomQmpOpen = 4,
+    QcomQmpSending = 5,      /* a message is in the mailbox, waiting for the AOP to take it */
+    QcomQmpBadDescriptor = -1,
+    QcomQmpBusy = -2,
+    QcomQmpTooLong = -3,
+};
+
+typedef struct {
+    volatile uint32_t *ram;  /* the message RAM (0x400 bytes on SM8550) */
+    uint32_t ram_bytes;
+    uint32_t box, box_size;  /* our mailbox inside it */
+    int state;
+    void (*kick)(void *context);
+    void *context;
+} QcomQmp;
+
+void qcom_qmp_init(QcomQmp *q, volatile uint32_t *ram, uint32_t ram_bytes, void (*kick)(void *), void *context);
+/* Advances the handshake or the pending send; returns the state reached. */
+int qcom_qmp_step(QcomQmp *q);
+/* Puts a message in the mailbox once the channel is open (QcomQmpSending), QcomQmpBusy otherwise. */
+int qcom_qmp_send(QcomQmp *q, const char *text);
+/* Gives up a send the AOP did not take before the owner's deadline: the mailbox is cleared. */
+void qcom_qmp_abandon(QcomQmp *q);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/QcomQrtr.c b/xnu/fuxi-adsp/QcomQrtr.c
new file mode 100644
index 0000000..f0e8021
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomQrtr.c
@@ -0,0 +1,226 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomQrtr.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static void put16(uint8_t *p, uint32_t v) {p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);}
+static void put32(uint8_t *p, uint32_t v) {put16(p, v); put16(p + 2, v >> 16);}
+
+#define CTRL_BYTES 20u  /* command and four words */
+#define MAX_PACKET 512u
+
+void qcom_qrtr_init(QcomQrtr *q, uint32_t local_node, QcomQrtrSend send, void *send_context)
+{
+    *q = (QcomQrtr){0};
+    q->local_node = local_node;
+    q->remote_node = QCOM_QRTR_NODE_BROADCAST;
+    q->send = send;
+    q->send_context = send_context;
+}
+
+static int emit(QcomQrtr *q, uint32_t type, uint32_t from_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length)
+{
+    uint8_t packet[MAX_PACKET];
+    const uint32_t padded = (length + 3) & ~3u;
+    if (QCOM_QRTR_HEADER + padded > sizeof packet) return -1;
+    put32(packet, 1);
+    put32(packet + 4, type);
+    put32(packet + 8, q->local_node);
+    put32(packet + 12, from_port);
+    put32(packet + 16, 0);  /* confirm_rx: we never ask for flow control acks */
+    put32(packet + 20, length);
+    put32(packet + 24, node);
+    put32(packet + 28, port);
+    for (uint32_t i = 0; i < padded; ++i) packet[QCOM_QRTR_HEADER + i] = i < length ? data[i] : 0;
+    if (q->send(q->send_context, packet, QCOM_QRTR_HEADER + padded)) {q->tx_refused++; return -1;}
+    q->tx_packets++;
+    return 0;
+}
+
+static int control(QcomQrtr *q, uint32_t command, const uint32_t words[4])
+{
+    uint8_t pkt[CTRL_BYTES] = {0};
+    put32(pkt, command);
+    for (unsigned i = 0; words && i < 4; ++i) put32(pkt + 4 + 4 * i, words[i]);
+    return emit(q, command, QCOM_QRTR_PORT_CTRL, q->remote_node, QCOM_QRTR_PORT_CTRL, pkt, sizeof pkt);
+}
+
+static void announce(QcomQrtr *q, unsigned i)
+{
+    const uint32_t words[4] = {q->local[i].service, q->local[i].instance, q->local_node, q->local[i].port};
+    control(q, QCOM_QRTR_NEW_SERVER, words);
+}
+
+int qcom_qrtr_add_service(QcomQrtr *q, uint32_t service, uint32_t instance, uint32_t port, QcomQrtrReceive receive, void *context)
+{
+    if (q->local_count == QCOM_QRTR_MAX_LOCAL || port == QCOM_QRTR_PORT_CTRL) return -1;
+    const unsigned i = q->local_count++;
+    q->local[i].service = service; q->local[i].instance = instance; q->local[i].port = port;
+    q->local[i].receive = receive; q->local[i].context = context;
+    if (q->hello_received) announce(q, i);
+    return 0;
+}
+
+void qcom_qrtr_start(QcomQrtr *q)
+{
+    if (!control(q, QCOM_QRTR_HELLO, 0)) q->hello_sent = 1;
+}
+
+int qcom_qrtr_find_remote(const QcomQrtr *q, uint32_t service)
+{
+    for (uint32_t i = 0; i < q->remote_count; ++i) if (q->remote[i].service == service) return (int)i;
+    return -1;
+}
+
+static void remote_server(QcomQrtr *q, const uint8_t *w, int add)
+{
+    const uint32_t service = le32(w), instance = le32(w + 4), node = le32(w + 8), port = le32(w + 12);
+    if (!service && !instance && !node && !port) return;  /* the end of a listing */
+    for (uint32_t i = 0; i < q->remote_count; ++i) {
+        if (q->remote[i].node != node || q->remote[i].port != port) continue;
+        if (add) {q->remote[i].service = service; q->remote[i].instance = instance; return;}
+        q->remote[i] = q->remote[--q->remote_count];
+        return;
+    }
+    if (!add || q->remote_count == QCOM_QRTR_MAX_REMOTE) return;
+    q->remote[q->remote_count].service = service; q->remote[q->remote_count].instance = instance;
+    q->remote[q->remote_count].node = node; q->remote[q->remote_count].port = port;
+    q->remote_count++;
+}
+
+int qcom_qrtr_receive(QcomQrtr *q, const uint8_t *packet, uint32_t length)
+{
+    if (length < QCOM_QRTR_HEADER || le32(packet) != 1) {q->rx_bad++; return -1;}
+    const uint32_t type = le32(packet + 4), src_node = le32(packet + 8), src_port = le32(packet + 12);
+    const uint32_t confirm = le32(packet + 16), size = le32(packet + 20), dst_port = le32(packet + 28);
+    if (size > length - QCOM_QRTR_HEADER) {q->rx_bad++; return -1;}
+    const uint8_t *data = packet + QCOM_QRTR_HEADER;
+    q->rx_packets++;
+    if (type == QCOM_QRTR_DATA) {
+        q->rx_data++;
+        unsigned i = 0;
+        while (i < q->local_count && q->local[i].port != dst_port) ++i;
+        if (i < q->local_count) q->local[i].receive(q->local[i].context, q, dst_port, src_node, src_port, data, size);
+        else q->rx_unrouted++;
+        if (confirm) {  /* the sender waits for this before it sends more to the port */
+            const uint32_t words[4] = {src_node, src_port, 0, 0};
+            if (!control(q, QCOM_QRTR_RESUME_TX, words)) q->resumes_sent++;
+        }
+        return 0;
+    }
+    /* control packets carry their command again in the payload */
+    if (size < 4) {q->rx_bad++; return -1;}
+    switch (type) {
+    case QCOM_QRTR_HELLO:
+        q->remote_node = src_node;
+        if (!q->hello_sent) qcom_qrtr_start(q);
+        q->hello_received = 1;
+        for (unsigned i = 0; i < q->local_count; ++i) announce(q, i);
+        break;
+    case QCOM_QRTR_NEW_SERVER:
+    case QCOM_QRTR_DEL_SERVER:
+        if (size >= CTRL_BYTES) remote_server(q, data + 4, type == QCOM_QRTR_NEW_SERVER);
+        break;
+    case QCOM_QRTR_BYE:
+        q->remote_count = 0;
+        q->hello_received = 0;
+        break;
+    default:  /* DEL_CLIENT, RESUME_TX (we never ask), PING, lookups (the remote keeps its own name service) */
+        break;
+    }
+    return 0;
+}
+
+int qcom_qrtr_send_data(QcomQrtr *q, uint32_t from_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length)
+{
+    return emit(q, QCOM_QRTR_DATA, from_port, node, port, data, length);
+}
+
+/* ---- QMI ---- */
+int qcom_qmi_parse(const uint8_t *data, uint32_t length, QcomQmiMessage *m)
+{
+    if (length < QCOM_QMI_HEADER) return -1;
+    m->type = data[0];
+    m->transaction = le16(data + 1);
+    m->message = le16(data + 3);
+    m->length = le16(data + 5);
+    if (m->length > length - QCOM_QMI_HEADER) return -1;
+    m->tlvs = data + QCOM_QMI_HEADER;
+    return 0;
+}
+
+const uint8_t *qcom_qmi_tlv(const QcomQmiMessage *m, uint8_t type, uint32_t *size)
+{
+    for (uint32_t at = 0; at + 3 <= m->length;) {
+        const uint32_t n = le16(m->tlvs + at + 1);
+        if (n > m->length - at - 3) return 0;
+        if (m->tlvs[at] == type) {*size = n; return m->tlvs + at + 3;}
+        at += 3 + n;
+    }
+    return 0;
+}
+
+/* ---- the service locator ---- */
+#define NAME_MAX_ 64u
+#define LIST_MAX 32u
+
+static int same(const char *a, const uint8_t *b, uint32_t n)
+{
+    uint32_t i = 0;
+    for (; i < n && a[i]; ++i) if ((uint8_t)a[i] != b[i]) return 0;
+    return i == n && !a[i];
+}
+
+static int provides(const QcomPdDomain *d, const uint8_t *name, uint32_t n)
+{
+    if (same("tms/servreg", name, n)) return 1;
+    for (unsigned i = 0; d->services && d->services[i]; ++i) if (same(d->services[i], name, n)) return 1;
+    return 0;
+}
+
+uint32_t qcom_servloc_answer(const QcomPdDomain *domains, unsigned count, const uint8_t *request, uint32_t length, uint8_t *out,
+                             uint32_t capacity)
+{
+    QcomQmiMessage m;
+    uint32_t name_size = 0, offset_size = 0;
+    if (qcom_qmi_parse(request, length, &m) || m.type != QCOM_QMI_REQUEST || m.message != QCOM_SERVLOC_GET_DOMAIN_LIST) return 0;
+    const uint8_t *name = qcom_qmi_tlv(&m, 0x01, &name_size);
+    const uint8_t *skip = qcom_qmi_tlv(&m, 0x10, &offset_size);
+    if (!name || name_size > NAME_MAX_ || (skip && offset_size != 4)) return 0;
+    while (name_size && !name[name_size - 1]) --name_size;  /* a sender may count the terminating zero */
+    const uint32_t first = skip ? le32(skip) : 0;
+    if (capacity < QCOM_QMI_HEADER + 7 + 5 + 5 + 4) return 0;
+    uint8_t *p = out + QCOM_QMI_HEADER;
+    /* result: success, no error */
+    p[0] = 0x02; put16(p + 1, 4); put32(p + 3, 0); p += 7;
+    uint32_t total = 0, listed = 0;
+    uint8_t *list = p + 5 + 5, *entry = list + 4;
+    for (unsigned i = 0; i < count; ++i) {
+        if (!provides(&domains[i], name, name_size)) continue;
+        const uint32_t index = total++;
+        if (index < first || listed == LIST_MAX) continue;
+        uint32_t n = 0;
+        while (domains[i].domain[n] && n < NAME_MAX_) ++n;
+        if ((uint32_t)(entry - out) + 1 + n + 9 > capacity) return 0;
+        entry[0] = (uint8_t)n;
+        for (uint32_t b = 0; b < n; ++b) entry[1 + b] = (uint8_t)domains[i].domain[b];
+        entry += 1 + n;
+        put32(entry, domains[i].instance);  /* instance, then service data valid (no) and service data */
+        entry[4] = 0;
+        put32(entry + 5, 0);
+        entry += 9;
+        listed++;
+    }
+    /* total domains, the database revision, then the list (a one-byte count before its entries) */
+    p[0] = 0x10; put16(p + 1, 2); put16(p + 3, total); p += 5;
+    p[0] = 0x11; put16(p + 1, 2); put16(p + 3, 1); p += 5;
+    if (listed) {
+        p[0] = 0x12; put16(p + 1, (uint32_t)(entry - p - 3)); p[3] = (uint8_t)listed;
+        p = entry;
+    }
+    out[0] = QCOM_QMI_RESPONSE;
+    put16(out + 1, m.transaction);
+    put16(out + 3, m.message);
+    put16(out + 5, (uint32_t)(p - out - QCOM_QMI_HEADER));
+    return (uint32_t)(p - out);
+}
diff --git a/xnu/fuxi-adsp/QcomQrtr.h b/xnu/fuxi-adsp/QcomQrtr.h
new file mode 100644
index 0000000..132ee1e
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomQrtr.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The IPC router (QRTR, version 1 headers) on one link to one remote node, with the name service duties of this side: say hello, announce
+ * our services to the remote once it has said hello, answer flow control, and keep the list of the services the remote announces. Our
+ * services are ports with a receive callback. No allocation and no waiting: the owner feeds every received packet in and gives a send
+ * callback that queues one packet (it may refuse; the counters show it). */
+#ifndef QCOM_QRTR_H
+#define QCOM_QRTR_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_QRTR_HEADER 32u
+#define QCOM_QRTR_PORT_CTRL 0xfffffffeu
+#define QCOM_QRTR_NODE_BROADCAST 0xffffffffu
+#define QCOM_QRTR_MAX_LOCAL 4u
+#define QCOM_QRTR_MAX_REMOTE 32u
+
+enum {
+    QCOM_QRTR_DATA = 1, QCOM_QRTR_HELLO = 2, QCOM_QRTR_BYE = 3, QCOM_QRTR_NEW_SERVER = 4, QCOM_QRTR_DEL_SERVER = 5,
+    QCOM_QRTR_DEL_CLIENT = 6, QCOM_QRTR_RESUME_TX = 7, QCOM_QRTR_EXIT = 8, QCOM_QRTR_PING = 9, QCOM_QRTR_NEW_LOOKUP = 10,
+    QCOM_QRTR_DEL_LOOKUP = 11,
+};
+
+typedef struct QcomQrtr QcomQrtr;
+/* One packet of length bytes (header included); returns 0 when queued. */
+typedef int (*QcomQrtrSend)(void *context, const uint8_t *packet, uint32_t length);
+/* A data packet for one of our ports from node:port. */
+typedef void (*QcomQrtrReceive)(void *context, QcomQrtr *q, uint32_t port, uint32_t node, uint32_t from_port, const uint8_t *data,
+                                uint32_t length);
+
+struct QcomQrtr {
+    uint32_t local_node, remote_node;  /* remote_node: QCOM_QRTR_NODE_BROADCAST until the remote's hello */
+    uint8_t hello_sent, hello_received;
+    QcomQrtrSend send;
+    void *send_context;
+    struct {uint32_t service, instance, port; QcomQrtrReceive receive; void *context;} local[QCOM_QRTR_MAX_LOCAL];
+    uint32_t local_count;
+    struct {uint32_t service, instance, node, port;} remote[QCOM_QRTR_MAX_REMOTE];
+    uint32_t remote_count;
+    /* counters for the log */
+    uint32_t rx_packets, rx_data, rx_bad, rx_unrouted, tx_packets, tx_refused, resumes_sent;
+};
+
+void qcom_qrtr_init(QcomQrtr *q, uint32_t local_node, QcomQrtrSend send, void *send_context);
+/* Adds one of our services (instance as announced: version | instance << 8) on port; announced to the remote after its hello, or at
+ * once when that has been. Returns 0, or -1 when full. */
+int qcom_qrtr_add_service(QcomQrtr *q, uint32_t service, uint32_t instance, uint32_t port, QcomQrtrReceive receive, void *context);
+/* The link is up: says hello. */
+void qcom_qrtr_start(QcomQrtr *q);
+/* One received packet. Returns 0, or -1 when it was not a valid packet. */
+int qcom_qrtr_receive(QcomQrtr *q, const uint8_t *packet, uint32_t length);
+/* A data packet from our port to the remote's node:port. capacity bounds the packet built on the stack. Returns 0 when queued. */
+int qcom_qrtr_send_data(QcomQrtr *q, uint32_t from_port, uint32_t node, uint32_t port, const uint8_t *data, uint32_t length);
+/* Index of a remote service in the list, -1 when not announced. */
+int qcom_qrtr_find_remote(const QcomQrtr *q, uint32_t service);
+
+/* ---- QMI messages carried in data packets: a 7-byte header (type, transaction, message id, length) and TLVs ---- */
+#define QCOM_QMI_HEADER 7u
+enum {QCOM_QMI_REQUEST = 0, QCOM_QMI_RESPONSE = 2, QCOM_QMI_INDICATION = 4};
+typedef struct {uint8_t type; uint16_t transaction, message; const uint8_t *tlvs; uint32_t length;} QcomQmiMessage;
+int qcom_qmi_parse(const uint8_t *data, uint32_t length, QcomQmiMessage *m);
+/* The value of TLV type in m (length in *size), or null. */
+const uint8_t *qcom_qmi_tlv(const QcomQmiMessage *m, uint8_t type, uint32_t *size);
+
+/* ---- the service locator (service 64): which protection domains provide a service ---- */
+#define QCOM_SERVLOC_SERVICE 0x40u
+#define QCOM_SERVLOC_INSTANCE 0x101u  /* as announced: version 0x101, instance 0 */
+#define QCOM_SERVLOC_GET_DOMAIN_LIST 0x21u
+typedef struct {const char *domain; uint32_t instance; const char *const *services;} QcomPdDomain;
+/* Answers a locator request (a whole QMI message) into out; returns the answer's length, 0 when the request is not one to answer. Every
+ * domain provides "tms/servreg"; services lists the others. */
+uint32_t qcom_servloc_answer(const QcomPdDomain *domains, unsigned count, const uint8_t *request, uint32_t length, uint8_t *out,
+                             uint32_t capacity);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/QcomRpmh.c b/xnu/fuxi-adsp/QcomRpmh.c
new file mode 100644
index 0000000..5af655d
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomRpmh.c
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomRpmh.h"
+
+static uint16_t le16(const uint8_t *p) {return (uint16_t)(p[0] | (uint16_t)p[1] << 8);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)le16(p) | (uint32_t)le16(p + 2) << 16;}
+static int fits(size_t at, size_t length, size_t size) {return at <= size && length <= size - at;}
+
+/* Header: u32 version, u32 magic, 8 slave records of 16 bytes (u16 id, header offset, data offset, entry count, version, reserved[3]),
+ * u32 checksum, u32 reserved, then the data area the offsets count from (byte 144). Entries are 24 bytes: an 8-byte id, two u32
+ * priorities, u32 address, u16 aux length, u16 aux offset. */
+int qcom_cmd_db_find(const uint8_t *db, size_t bytes, const char *name, QcomRpmhResource *out)
+{
+    if (!db || !name || !out) return QcomRpmhArgument;
+    if (bytes < 144 || le32(db + 4) != QCOM_CMD_DB_MAGIC) return QcomRpmhNoDb;
+    char id[8] = {0};
+    for (unsigned i = 0; i < 8 && name[i]; ++i) id[i] = name[i];
+    for (unsigned s = 0; s < 8; ++s) {
+        const uint8_t *slave = db + 8 + 16 * s;
+        if (!le16(slave)) break;
+        const size_t heads = 144u + le16(slave + 2), data = 144u + le16(slave + 4), count = le16(slave + 6);
+        if (!fits(heads, count * 24, bytes)) return QcomRpmhCorrupt;
+        for (size_t e = 0; e < count; ++e) {
+            const uint8_t *entry = db + heads + 24 * e;
+            unsigned same = 1;
+            for (unsigned i = 0; i < 8 && same; ++i) same = entry[i] == (uint8_t)id[i];
+            if (!same) continue;
+            QcomRpmhResource r = {0};
+            r.address = le32(entry + 16);
+            const size_t length = le16(entry + 20), at = data + le16(entry + 22);
+            if (!r.address || !fits(at, length, bytes)) return QcomRpmhCorrupt;
+            for (size_t l = 0; l + 1 < length && r.level_count < QCOM_RPMH_MAX_LEVELS; l += 2) {
+                const uint16_t level = le16(db + at + l);
+                if (r.level_count && !level) break;  /* the list is zero padded */
+                r.levels[r.level_count++] = level;
+            }
+            *out = r;
+            return QcomRpmhOk;
+        }
+    }
+    return QcomRpmhMissing;
+}
+
+int qcom_rpmh_level_index(const QcomRpmhResource *r, uint32_t level, uint32_t *index)
+{
+    if (!r->level_count) return QcomRpmhNoLevel;
+    if (!level) {*index = 0; return QcomRpmhOk;}
+    for (unsigned i = 0; i < r->level_count; ++i)
+        if (r->levels[i] >= level) {*index = i; return QcomRpmhOk;}
+    *index = r->level_count - 1;
+    return QcomRpmhOk;
+}
+
+QcomRscLayout qcom_rsc_layout(uint32_t drv_id)
+{
+    if (((drv_id >> 16) & 0xff) >= 3) return (QcomRscLayout){672, 24, 0x04, 0x08, 0x20, 0x24, 0x28, 0x2c, 0x34, 0x38, 0x3c};
+    return (QcomRscLayout){672, 20, 0x04, 0x08, 0x10, 0x14, 0x18, 0x1c, 0x30, 0x34, 0x38};
+}
+
+#define MSGID_WRITE_RESPONSE (8u | 1u << 8 | 1u << 16)  /* 4-byte payload code, response requested, write */
+#define CONTROL_ACTIVE_MODE (1u << 16)
+#define CONTROL_TRIGGER (1u << 24)
+
+unsigned qcom_rpmh_active_request(const QcomRscLayout *l, unsigned tcs, const uint32_t *addresses, const uint32_t *values, unsigned count,
+                                  QcomRpmhWrite *w, unsigned capacity)
+{
+    if (!count || count > 4 || capacity < 3 * count + 6) return 0;
+    const uint32_t base = l->tcs_stride * tcs;
+    unsigned n = 0;
+    /* The control register is cleared before the TCS is reprogrammed, then set to active mode and only after that triggered. */
+    w[n++] = (QcomRpmhWrite){base + l->control, 0};
+    w[n++] = (QcomRpmhWrite){l->irq_clear, 1u << tcs};
+    for (unsigned c = 0; c < count; ++c) {
+        const uint32_t cmd = base + l->cmd_stride * c;
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_msgid, MSGID_WRITE_RESPONSE};
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_addr, addresses[c]};
+        w[n++] = (QcomRpmhWrite){cmd + l->cmd_data, values[c]};
+    }
+    const uint32_t mask = (1u << count) - 1;
+    w[n++] = (QcomRpmhWrite){base + l->wait_for_cmpl, mask};
+    w[n++] = (QcomRpmhWrite){base + l->cmd_enable, mask};
+    w[n++] = (QcomRpmhWrite){base + l->control, CONTROL_ACTIVE_MODE};
+    w[n++] = (QcomRpmhWrite){base + l->control, CONTROL_ACTIVE_MODE | CONTROL_TRIGGER};
+    return n;
+}
+
+unsigned qcom_rpmh_finish(const QcomRscLayout *l, unsigned tcs, QcomRpmhWrite *w, unsigned capacity)
+{
+    if (capacity < 3) return 0;
+    const uint32_t base = l->tcs_stride * tcs;
+    w[0] = (QcomRpmhWrite){l->irq_clear, 1u << tcs};
+    w[1] = (QcomRpmhWrite){base + l->control, 0};
+    w[2] = (QcomRpmhWrite){base + l->cmd_enable, 0};
+    return 3;
+}
diff --git a/xnu/fuxi-adsp/QcomRpmh.h b/xnu/fuxi-adsp/QcomRpmh.h
new file mode 100644
index 0000000..c5fc59b
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomRpmh.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* RPMh for a remote processor's proxy votes: find a resource in the AOP command database (cmd-db) and turn a level into the index the
+ * ARC resource takes, and describe the register writes of one active-only request in a TCS of the application processor's RSC, for
+ * both register layouts (the RSC's major version 3 moved the TCS registers). Nothing here touches hardware: the owner applies the
+ * writes and waits for the TCS done interrupt. */
+#ifndef QCOM_RPMH_H
+#define QCOM_RPMH_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_CMD_DB_MAGIC 0x0c0330dbu
+#define QCOM_RPMH_MAX_LEVELS 16u
+
+typedef struct {
+    uint32_t address;
+    uint16_t levels[QCOM_RPMH_MAX_LEVELS];
+    unsigned level_count;
+} QcomRpmhResource;
+
+enum {QcomRpmhOk = 0, QcomRpmhNoDb = -1, QcomRpmhMissing = -2, QcomRpmhCorrupt = -3, QcomRpmhNoLevel = -4, QcomRpmhArgument = -5};
+
+/* Looks name (up to 8 characters) up in a copy of the command database; levels are the ARC's voltage levels (aux data) when it has
+ * them. */
+int qcom_cmd_db_find(const uint8_t *db, size_t bytes, const char *name, QcomRpmhResource *out);
+/* The ARC level index for a request of at least level (the highest index when level is above all of them; 0 turns the vote off). */
+int qcom_rpmh_level_index(const QcomRpmhResource *r, uint32_t level, uint32_t *index);
+
+typedef struct {uint32_t offset, value;} QcomRpmhWrite;
+
+/* The register layout of an RSC DRV; offsets are relative to the TCS block (DRV base + tcs-offset). */
+typedef struct {
+    uint32_t tcs_stride, cmd_stride, irq_status, irq_clear, wait_for_cmpl, control, status, cmd_enable, cmd_msgid, cmd_addr, cmd_data;
+} QcomRscLayout;
+
+/* The layout for a DRV whose id register reads drv_id (major version in bits 23:16). */
+QcomRscLayout qcom_rsc_layout(uint32_t drv_id);
+/* The writes of an active request of count (<= 4) data commands in TCS tcs, in order, ending with the trigger. Returns the number of
+ * writes, 0 on bad arguments. */
+unsigned qcom_rpmh_active_request(const QcomRscLayout *l, unsigned tcs, const uint32_t *addresses, const uint32_t *values, unsigned count,
+                                  QcomRpmhWrite *writes, unsigned capacity);
+/* The writes that return the TCS to idle after its done interrupt. */
+unsigned qcom_rpmh_finish(const QcomRscLayout *l, unsigned tcs, QcomRpmhWrite *writes, unsigned capacity);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/QcomScm.h b/xnu/fuxi-adsp/QcomScm.h
new file mode 100644
index 0000000..53f7eff
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomScm.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Secure channel manager calls of the peripheral authentication service (PAS) in the SMCCC convention: the function id (standard call,
+ * SMC64, SiP owner, service 2) and the argument-type word in x1. The SMC itself lives in the kernel glue; these encoders are what the
+ * host tests check. */
+#ifndef QCOM_SCM_H
+#define QCOM_SCM_H
+#include <stdint.h>
+
+#define QCOM_SCM_SVC_PIL 0x02u
+#define QCOM_SCM_PAS_INIT_IMAGE 0x01u
+#define QCOM_SCM_PAS_MEM_SETUP 0x02u
+#define QCOM_SCM_PAS_AUTH_AND_RESET 0x05u
+#define QCOM_SCM_PAS_SHUTDOWN 0x06u
+#define QCOM_SCM_PAS_IS_SUPPORTED 0x07u
+#define QCOM_SCM_VAL 0u
+#define QCOM_SCM_RO 1u
+#define QCOM_SCM_RW 2u
+#define QCOM_SCM_INTERRUPTED 1    /* x0 of a call the secure world wants resumed (x6 carries its session) */
+#define QCOM_SCM_V2_EBUSY (-12)   /* busy: retry after a pause */
+
+static inline uint32_t qcom_scm_fn(uint32_t svc, uint32_t cmd)
+{
+    return (1u << 30) /* SMC64 */ | (2u << 24) /* SiP */ | ((svc & 0xff) << 8) | (cmd & 0xff);
+}
+/* Argument count in bits 3:0, the type of argument i in bits 5+2i:4+2i. */
+static inline uint32_t qcom_scm_args(unsigned count, unsigned t0, unsigned t1, unsigned t2)
+{
+    return (count & 0xf) | (t0 & 3) << 4 | (t1 & 3) << 6 | (t2 & 3) << 8;
+}
+
+/* IPCC (the inter-processor doorbells): a doorbell id is client << 16 | signal. */
+#define QCOM_IPCC_SEND 0x0cu
+#define QCOM_IPCC_RECV_ID 0x10u
+#define QCOM_IPCC_RECV_ENABLE 0x14u
+#define QCOM_IPCC_RECV_DISABLE 0x18u
+#define QCOM_IPCC_RECV_CLEAR 0x1cu
+#define QCOM_IPCC_NONE 0xffffffffu
+#define QCOM_IPCC_CLIENT_AOP 0u
+#define QCOM_IPCC_CLIENT_LPASS 3u
+#define QCOM_IPCC_SIGNAL_GLINK_QMP 0u
+#define QCOM_IPCC_SIGNAL_SMP2P 2u
+static inline uint32_t qcom_ipcc_id(uint32_t client, uint32_t signal) {return client << 16 | (signal & 0xffff);}
+
+#endif
diff --git a/xnu/fuxi-adsp/QcomSmem.c b/xnu/fuxi-adsp/QcomSmem.c
new file mode 100644
index 0000000..515c63f
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomSmem.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomSmem.h"
+
+#define TOC_MAGIC 0x434f5424u   /* "$TOC" */
+#define PART_MAGIC 0x54525024u  /* "$PRT" */
+#define CANARY 0xa5a5u
+#define TOC_HEADER 32u
+#define TOC_ENTRY 48u
+#define PART_HEADER 32u
+#define ENTRY 16u
+
+uint32_t qcom_smem_read32(const QcomSmem *smem, uint32_t offset) {return *(volatile uint32_t *)(smem->base + offset);}
+void qcom_smem_write32(const QcomSmem *smem, uint32_t offset, uint32_t value)
+{
+    *(volatile uint32_t *)(smem->base + offset) = value;
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+}
+static uint32_t rd(const QcomSmem *s, uint32_t at) {return qcom_smem_read32(s, at);}
+static int fits(uint64_t at, uint64_t length, uint64_t size) {return at <= size && length <= size - at;}
+static uint32_t align_up(uint32_t value, uint32_t to) {return (value + to - 1) & ~(to - 1);}
+
+int qcom_smem_partition(const QcomSmem *smem, uint16_t host, uint16_t remote, QcomSmemPartition *out)
+{
+    if (!smem || !smem->base || smem->size < 0x2000 || (smem->size & 0xfff)) return QcomSmemNoTable;
+    const uint32_t toc = smem->size - 0x1000;
+    if (rd(smem, toc) != TOC_MAGIC || rd(smem, toc + 4) != 1) return QcomSmemNoTable;
+    const uint32_t count = rd(smem, toc + 8);
+    if (count > (0x1000 - TOC_HEADER) / TOC_ENTRY) return QcomSmemNoTable;
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t e = toc + TOC_HEADER + i * TOC_ENTRY;
+        const uint32_t offset = rd(smem, e), size = rd(smem, e + 4), hosts = rd(smem, e + 12), cacheline = rd(smem, e + 16);
+        const uint16_t h0 = (uint16_t)hosts, h1 = (uint16_t)(hosts >> 16);
+        if (!offset || !size) continue;
+        if (!((h0 == host && h1 == remote) || (h0 == remote && h1 == host))) continue;
+        if (!fits(offset, size, toc) || size < PART_HEADER + 2 * ENTRY || (offset & 7)) return QcomSmemBadPartition;
+        if (cacheline & (cacheline - 1)) return QcomSmemBadPartition;
+        if (rd(smem, offset) != PART_MAGIC || rd(smem, offset + 4) != hosts || rd(smem, offset + 8) != size) return QcomSmemBadPartition;
+        const uint32_t free_uncached = rd(smem, offset + 12), free_cached = rd(smem, offset + 16);
+        if (free_uncached < PART_HEADER || free_uncached > free_cached || free_cached > size) return QcomSmemBadPartition;
+        *out = (QcomSmemPartition){offset, size, cacheline ? cacheline : 8u, h0, h1};
+        return QcomSmemOk;
+    }
+    return QcomSmemNoPartition;
+}
+
+/* Walks the uncached list; returns the offset (relative to the partition) where it ends, or the item's entry when found. */
+static int walk_uncached(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t *at_out, int *found)
+{
+    const uint32_t end = rd(smem, p->offset + 12);
+    uint32_t at = PART_HEADER;
+    *found = 0;
+    while (at < end) {
+        if (!fits(at, ENTRY, end)) return QcomSmemCorrupt;
+        const uint32_t w0 = rd(smem, p->offset + at), size = rd(smem, p->offset + at + 4), pads = rd(smem, p->offset + at + 8);
+        if ((w0 & 0xffff) != CANARY) return QcomSmemCorrupt;
+        const uint32_t padding_header = pads >> 16;
+        if ((uint64_t)at + ENTRY + padding_header + size > end) return QcomSmemCorrupt;
+        if ((w0 >> 16) == item) {*found = 1; *at_out = at; return QcomSmemOk;}
+        at += ENTRY + padding_header + size;
+    }
+    if (at != end) return QcomSmemCorrupt;
+    *at_out = at;
+    return QcomSmemOk;
+}
+
+int qcom_smem_find(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t *offset, uint32_t *size)
+{
+    uint32_t at;
+    int found, rc = walk_uncached(smem, p, item, &at, &found);
+    if (rc) return rc;
+    if (found) {
+        const uint32_t bytes = rd(smem, p->offset + at + 4), pads = rd(smem, p->offset + at + 8);
+        if ((pads & 0xffff) > bytes) return QcomSmemCorrupt;
+        *offset = p->offset + at + ENTRY + (pads >> 16);
+        *size = bytes - (pads & 0xffff);
+        return QcomSmemOk;
+    }
+    /* Cached items: each entry sits at the end of its cache line slot, its data right below it. */
+    const uint32_t header = align_up(ENTRY, p->cacheline), last = rd(smem, p->offset + 16);
+    if (p->size < header) return QcomSmemCorrupt;
+    uint32_t e = p->size - header;
+    while (e > last) {
+        const uint32_t w0 = rd(smem, p->offset + e), bytes = rd(smem, p->offset + e + 4), pads = rd(smem, p->offset + e + 8);
+        if ((w0 & 0xffff) != CANARY || bytes > e || (pads & 0xffff) > bytes) return QcomSmemCorrupt;
+        if ((w0 >> 16) == item) {*offset = p->offset + e - bytes; *size = bytes - (pads & 0xffff); return QcomSmemOk;}
+        if (e < bytes + header) return QcomSmemCorrupt;
+        e -= bytes + header;
+    }
+    return QcomSmemMissing;
+}
+
+int qcom_smem_alloc(const QcomSmem *smem, const QcomSmemPartition *p, uint16_t item, uint32_t size)
+{
+    uint32_t at;
+    int found, rc = walk_uncached(smem, p, item, &at, &found);
+    if (rc) return rc;
+    if (found) return QcomSmemExists;
+    uint32_t offset, bytes;
+    if (qcom_smem_find(smem, p, item, &offset, &bytes) == QcomSmemOk) return QcomSmemExists;
+    const uint32_t aligned = align_up(size, 8), need = ENTRY + aligned;
+    if (!size || aligned < size || (uint64_t)at + need > rd(smem, p->offset + 16)) return QcomSmemNoSpace;
+    qcom_smem_write32(smem, p->offset + at, CANARY | (uint32_t)item << 16);
+    qcom_smem_write32(smem, p->offset + at + 4, aligned);
+    qcom_smem_write32(smem, p->offset + at + 8, aligned - size);  /* padding_data, padding_header 0 */
+    qcom_smem_write32(smem, p->offset + at + 12, 0);
+    for (uint32_t i = 0; i < aligned; i += 4) qcom_smem_write32(smem, p->offset + at + ENTRY + i, 0);
+    /* The entry is complete before the free mark moves over it. */
+    qcom_smem_write32(smem, p->offset + 12, at + need);
+    return QcomSmemOk;
+}
diff --git a/xnu/fuxi-adsp/QcomSmem.h b/xnu/fuxi-adsp/QcomSmem.h
new file mode 100644
index 0000000..facab04
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomSmem.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Qualcomm shared memory (SMEM): the partition table at the end of the region, the private partitions two processors share, and the
+ * items in them (uncached ones growing up from the partition header, cached ones down from its end). Every access is an aligned 32-bit
+ * one, so the code works on a device mapping. Allocation must run with the hardware mutex held (the caller takes it); nothing here
+ * waits. */
+#ifndef QCOM_SMEM_H
+#define QCOM_SMEM_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_SMEM_HOST_APPS 0u
+#define QCOM_SMEM_HOST_GLOBAL 0xfffeu
+
+typedef struct {
+    volatile uint8_t *base;
+    uint32_t size;
+} QcomSmem;
+
+typedef struct {
+    uint32_t offset, size, cacheline;  /* offset of the partition header from the SMEM base */
+    uint16_t host0, host1;
+} QcomSmemPartition;
+
+enum {
+    QcomSmemOk = 0,
+    QcomSmemNoTable = -1,
+    QcomSmemNoPartition = -2,
+    QcomSmemBadPartition = -3,
+    QcomSmemCorrupt = -4,
+    QcomSmemExists = -5,
+    QcomSmemNoSpace = -6,
+    QcomSmemMissing = -7,
+};
+
+/* The partition shared by the two hosts (QCOM_SMEM_HOST_GLOBAL twice for the global one). */
+int qcom_smem_partition(const QcomSmem *smem, uint16_t host, uint16_t remote, QcomSmemPartition *out);
+/* Offset of the item's data from the SMEM base and its size; QcomSmemMissing when the item is not there. */
+int qcom_smem_find(const QcomSmem *smem, const QcomSmemPartition *part, uint16_t item, uint32_t *offset, uint32_t *size);
+/* Allocates an uncached item of size bytes (rounded up to 8). QcomSmemExists if it is there already (not an error for callers that
+ * only need it to exist). Hardware mutex held by the caller. */
+int qcom_smem_alloc(const QcomSmem *smem, const QcomSmemPartition *part, uint16_t item, uint32_t size);
+
+uint32_t qcom_smem_read32(const QcomSmem *smem, uint32_t offset);
+void qcom_smem_write32(const QcomSmem *smem, uint32_t offset, uint32_t value);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/QcomSmp2p.c b/xnu/fuxi-adsp/QcomSmp2p.c
new file mode 100644
index 0000000..7ba701b
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomSmp2p.c
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "QcomSmp2p.h"
+
+/* Word offsets: 0 magic, 1 version (bits 7:0) and features (31:8), 2 local pid (15:0) and remote pid (31:16), 3 total entries (15:0)
+ * and valid entries (31:16), 4 flags, then 5 words per entry: a 16-byte name and the value. */
+#define W_VERSION 1
+#define W_PIDS 2
+#define W_COUNTS 3
+#define W_FLAGS 4
+#define W_ENTRY(i) (5 + 5 * (i))
+
+static void barrier(void)
+{
+#if defined(__aarch64__) && defined(KERNEL)
+    __asm__ volatile("dmb oshst" ::: "memory");
+#endif
+}
+static int same_name(const volatile uint32_t *entry, const char *name)
+{
+    for (unsigned i = 0; i < 16; ++i) {
+        const char c = (char)(entry[i / 4] >> (8 * (i % 4)));
+        if (c != name[i]) return 0;
+        if (!c) return 1;
+    }
+    return name[16] == 0;
+}
+
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid)
+{
+    *s = (QcomSmp2p){0};
+    s->out = out;
+    s->local_pid = local_pid;
+    s->remote_pid = remote_pid;
+    for (unsigned i = 0; i < QCOM_SMP2P_ITEM_BYTES / 4; ++i) out[i] = 0;
+    barrier();
+    out[0] = QCOM_SMP2P_MAGIC;
+    out[W_PIDS] = local_pid | (uint32_t)remote_pid << 16;
+    out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES;
+    barrier();
+    out[W_VERSION] = QCOM_SMP2P_VERSION | QCOM_SMP2P_FEATURE_SSR_ACK << 8;
+    barrier();
+}
+
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name)
+{
+    const uint32_t valid = s->out[W_COUNTS] >> 16;
+    if (valid >= QCOM_SMP2P_MAX_ENTRIES) return -1;
+    uint32_t words[4] = {0};
+    for (unsigned i = 0; i < 16 && name[i]; ++i) words[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+    for (unsigned i = 0; i < 4; ++i) s->out[W_ENTRY(valid) + i] = words[i];
+    s->out[W_ENTRY(valid) + 4] = 0;
+    barrier();
+    s->out[W_COUNTS] = QCOM_SMP2P_MAX_ENTRIES | (valid + 1) << 16;
+    barrier();
+    return (int)valid;
+}
+
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value)
+{
+    volatile uint32_t *v = &s->out[W_ENTRY(index) + 4];
+    const uint32_t old = *v, next = (old & ~mask) | (value & mask);
+    if (next == old) return 0;
+    *v = next;
+    barrier();
+    return 1;
+}
+
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index) {return s->out[W_ENTRY(index) + 4];}
+
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid)
+{
+    if (!in || in[0] != QCOM_SMP2P_MAGIC) return -1;
+    if ((in[W_VERSION] & 0xff) != QCOM_SMP2P_VERSION) return -2;
+    /* The remote writes its own pid as local. */
+    if (in[W_PIDS] != (remote_pid | (uint32_t)local_pid << 16)) return -3;
+    const uint32_t counts = in[W_COUNTS];
+    if ((counts & 0xffff) > QCOM_SMP2P_MAX_ENTRIES || (counts >> 16) > (counts & 0xffff)) return -4;
+    return 0;
+}
+
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name)
+{
+    if (!s->in) return -1;
+    const uint32_t valid = s->in[W_COUNTS] >> 16;
+    for (uint32_t i = 0; i < valid && i < QCOM_SMP2P_MAX_ENTRIES; ++i)
+        if (same_name(&s->in[W_ENTRY(i)], name)) return (int)i;
+    return -1;
+}
+
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index) {return s->in[W_ENTRY(index) + 4];}
+
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed)
+{
+    int ring = 0;
+    *value = 0;
+    *changed = 0;
+    if (qcom_smp2p_check_in(s->in, s->local_pid, s->remote_pid)) return 0;
+    if (!s->negotiated) {
+        const uint32_t ours = s->out[W_VERSION], theirs = s->in[W_VERSION];
+        if ((ours & 0xff) == (theirs & 0xff)) {
+            const uint32_t features = (ours >> 8) & (theirs >> 8);
+            if (features != ours >> 8) {s->out[W_VERSION] = (ours & 0xff) | features << 8; barrier(); ring = 1;}
+            s->ssr_ack_enabled = (features & QCOM_SMP2P_FEATURE_SSR_ACK) != 0;
+            s->negotiated = 1;
+        }
+    }
+    if (s->ssr_ack_enabled) {
+        const uint8_t done = (s->in[W_FLAGS] & QCOM_SMP2P_FLAG_RESTART_DONE) != 0;
+        if (done != s->ssr_acked) {
+            s->ssr_acked = done;
+            const uint32_t flags = s->out[W_FLAGS];
+            s->out[W_FLAGS] = done ? flags | QCOM_SMP2P_FLAG_RESTART_ACK : flags & ~QCOM_SMP2P_FLAG_RESTART_ACK;
+            barrier();
+            ring = 1;
+        }
+    }
+    const int index = qcom_smp2p_find_in(s, entry);
+    if (index >= 0) {
+        const uint32_t now = qcom_smp2p_in_value(s, index);
+        *value = now;
+        *changed = now ^ s->last[index];
+        s->last[index] = now;
+    }
+    return ring;
+}
diff --git a/xnu/fuxi-adsp/QcomSmp2p.h b/xnu/fuxi-adsp/QcomSmp2p.h
new file mode 100644
index 0000000..947a7d7
--- /dev/null
+++ b/xnu/fuxi-adsp/QcomSmp2p.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Shared memory point-to-point state (SMP2P): each side owns one SMEM item holding named 32-bit entries the other side watches; a change
+ * is signalled with a doorbell. This is the item layout and the bookkeeping for both directions: our outbound item (entries we set bits
+ * in) and the remote's inbound item (entries whose bit changes become events). Doorbells and SMEM placement belong to the caller. */
+#ifndef QCOM_SMP2P_H
+#define QCOM_SMP2P_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define QCOM_SMP2P_MAGIC 0x504d5324u  /* "$SMP" */
+#define QCOM_SMP2P_VERSION 1u
+#define QCOM_SMP2P_FEATURE_SSR_ACK 1u
+#define QCOM_SMP2P_FLAG_RESTART_DONE 1u
+#define QCOM_SMP2P_FLAG_RESTART_ACK 2u
+#define QCOM_SMP2P_MAX_ENTRIES 16u
+#define QCOM_SMP2P_ITEM_BYTES (20u + 20u * QCOM_SMP2P_MAX_ENTRIES)
+
+/* The two items' storage: 32-bit aligned, possibly device memory. */
+typedef struct {
+    volatile uint32_t *out, *in;  /* in may be null until the remote has made it */
+    uint16_t local_pid, remote_pid;
+    uint8_t negotiated, ssr_ack_enabled, ssr_acked;
+    uint32_t last[QCOM_SMP2P_MAX_ENTRIES];  /* inbound values last seen, by inbound entry index */
+    uint32_t seen_entries;
+} QcomSmp2p;
+
+/* Writes a fresh outbound item (zeroes, header, then the version word last so the remote never sees a half-made item). */
+void qcom_smp2p_init_out(QcomSmp2p *s, volatile uint32_t *out, uint16_t local_pid, uint16_t remote_pid);
+/* Adds a named outbound entry and returns its index, or -1 when full. */
+int qcom_smp2p_add_entry(QcomSmp2p *s, const char *name);
+/* Sets the bits in mask of outbound entry index to value; returns 1 when the value changed (ring the doorbell). */
+int qcom_smp2p_update(QcomSmp2p *s, int index, uint32_t mask, uint32_t value);
+uint32_t qcom_smp2p_out_value(const QcomSmp2p *s, int index);
+
+/* Validates an inbound item (magic, version, the pids seen from the other side); 0 when usable. */
+int qcom_smp2p_check_in(const volatile uint32_t *in, uint16_t local_pid, uint16_t remote_pid);
+/* Index of the named inbound entry, -1 when the remote has not added it. */
+int qcom_smp2p_find_in(const QcomSmp2p *s, const char *name);
+uint32_t qcom_smp2p_in_value(const QcomSmp2p *s, int index);
+
+/* Called on every doorbell from the remote. Agrees on the features once, answers a restart with the restart ack flag, and reports the
+ * bits of the named inbound entry that changed since the last call (changed) and its current value (value). Returns 1 when our item
+ * changed so the remote has to be rung. */
+int qcom_smp2p_service(QcomSmp2p *s, const char *entry, uint32_t *value, uint32_t *changed);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/ShengAdsp.h b/xnu/fuxi-adsp/ShengAdsp.h
new file mode 100644
index 0000000..87daa37
--- /dev/null
+++ b/xnu/fuxi-adsp/ShengAdsp.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Clients of the audio DSP (AdspProbe.cpp): a client registers a GLINK channel by name at any time (before or after the DSP is up) and
+ * gets its state and messages through callbacks that run on the DSP thread; they must not block (copy what they need and wake their own
+ * thread). Sends are queued and go out from the DSP thread, so a caller never waits for the DSP. */
+#ifndef SHENG_ADSP_H
+#define SHENG_ADSP_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SHENG_ADSP_MAX_MESSAGE 560u
+
+typedef struct ShengAdspChannel ShengAdspChannel;
+typedef struct {
+    void (*state)(void *context, int up);
+    void (*receive)(void *context, const uint8_t *data, uint32_t length);
+} ShengAdspClient;
+
+/* Registers the channel; intent_size/intent_count are the receive buffers offered to the DSP. initiator: we open it (otherwise we answer
+ * the DSP's open). Returns null when out of slots or memory. Weak-imported by clients: the DSP code may be absent from a build. */
+ShengAdspChannel *sheng_adsp_channel(const char *name, uint32_t intent_size, uint32_t intent_count, int initiator,
+                                     const ShengAdspClient *client, void *context);
+/* Queues one message (at most SHENG_ADSP_MAX_MESSAGE bytes): 0 queued, -1 queue full or too big, -2 bad arguments. */
+int sheng_adsp_send(ShengAdspChannel *channel, const void *data, uint32_t length);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/ShengBattmgr.c b/xnu/fuxi-adsp/ShengBattmgr.c
new file mode 100644
index 0000000..676a7a5
--- /dev/null
+++ b/xnu/fuxi-adsp/ShengBattmgr.c
@@ -0,0 +1,290 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#include "ShengBattmgr.h"
+
+/* Battery properties as this board's firmware numbers them (one more after charge control limit max than the common list): status 0,
+ * health 1, present 2, charge type 3, capacity 4 (hundredths of a percent), SOH 5, OCV 6, voltage now 7 (uV), voltage max 8, current
+ * now 9 (uA), thermal level 10, its max 11, charge current 12 (uA), temperature 13 (hundredths of a degree), technology 14, charge
+ * counter 15 (uAh), cycle count 16, full design 17 (uAh), full 18 (uAh), model 19 (a string), time to full 20 (s), time to empty 21 (s).
+ * USB: online 0, voltage now 1 (uV), voltage max 2, current now 3 (uA), current max 4, input current limit 5, type 6, adapter type 7.
+ * Board: battery authenticated 3, adapter type 7, PD adapter authenticated 0x18, input suspended 0x2a, adapter watts 0x33, the fuel
+ * gauges 0x8a/0x8b and 0xa6/0xa7, second cell authenticated 0xa5. */
+static const struct {uint8_t opcode, property, slow;} kFields[BmFields] = {
+    [BmStatus] = {SHENG_BATTMGR_OP_BATTERY_GET, 0, 0},
+    [BmPresent] = {SHENG_BATTMGR_OP_BATTERY_GET, 2, 0},
+    [BmCapacity] = {SHENG_BATTMGR_OP_BATTERY_GET, 4, 0},
+    [BmVoltage] = {SHENG_BATTMGR_OP_BATTERY_GET, 7, 0},
+    [BmCurrent] = {SHENG_BATTMGR_OP_BATTERY_GET, 9, 0},
+    [BmTemperature] = {SHENG_BATTMGR_OP_BATTERY_GET, 13, 0},
+    [BmCharge] = {SHENG_BATTMGR_OP_BATTERY_GET, 15, 0},
+    [BmUsbOnline] = {SHENG_BATTMGR_OP_USB_GET, 0, 0},
+    [BmUsbType] = {SHENG_BATTMGR_OP_USB_GET, 6, 0},
+    [BmUsbVoltage] = {SHENG_BATTMGR_OP_USB_GET, 1, 0},
+    [BmUsbCurrent] = {SHENG_BATTMGR_OP_USB_GET, 3, 0},
+    [BmTimeToEmpty] = {SHENG_BATTMGR_OP_BATTERY_GET, 21, 0},
+    [BmTimeToFull] = {SHENG_BATTMGR_OP_BATTERY_GET, 20, 0},
+    /* the fuel gauges: remaining and full charge of each (mAh) */
+    [BmGauge1Remaining] = {SHENG_BATTMGR_OP_BOARD_GET, 0x8a, 0},
+    [BmGauge1Full] = {SHENG_BATTMGR_OP_BOARD_GET, 0x8b, 0},
+    [BmGauge2Remaining] = {SHENG_BATTMGR_OP_BOARD_GET, 0xa6, 0},
+    [BmGauge2Full] = {SHENG_BATTMGR_OP_BOARD_GET, 0xa7, 0},
+    [BmFull] = {SHENG_BATTMGR_OP_BATTERY_GET, 18, 1},
+    [BmDesign] = {SHENG_BATTMGR_OP_BATTERY_GET, 17, 1},
+    [BmCycles] = {SHENG_BATTMGR_OP_BATTERY_GET, 16, 1},
+    [BmUsbAdapter] = {SHENG_BATTMGR_OP_USB_GET, 7, 0},
+    [BmUsbLimit] = {SHENG_BATTMGR_OP_USB_GET, 5, 0},
+    [BmUsbMax] = {SHENG_BATTMGR_OP_USB_GET, 4, 0},
+    [BmChargeType] = {SHENG_BATTMGR_OP_BATTERY_GET, 3, 0},
+    [BmThermalLevel] = {SHENG_BATTMGR_OP_BATTERY_GET, 10, 0},
+    [BmChargeCurrent] = {SHENG_BATTMGR_OP_BATTERY_GET, 12, 0},
+    [BmRealType] = {SHENG_BATTMGR_OP_BOARD_GET, 0x07, 0},
+    [BmPowerMax] = {SHENG_BATTMGR_OP_BOARD_GET, 0x33, 0},
+    [BmPdVerified] = {SHENG_BATTMGR_OP_BOARD_GET, 0x18, 0},
+    [BmAuthentic] = {SHENG_BATTMGR_OP_BOARD_GET, 0x03, 1},
+    [BmSlaveAuthentic] = {SHENG_BATTMGR_OP_BOARD_GET, 0xa5, 1},
+    [BmInputSuspend] = {SHENG_BATTMGR_OP_BOARD_GET, 0x2a, 0},
+};
+#define NO_CYCLE 0xff
+
+static void put32(uint8_t *p, uint32_t v) {p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);}
+static uint32_t le32(const uint8_t *p) {return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;}
+static void header(uint8_t *out, uint32_t opcode)
+{
+    put32(out, SHENG_BATTMGR_OWNER);
+    put32(out + 4, SHENG_BATTMGR_TYPE_REQUEST);
+    put32(out + 8, opcode);
+}
+
+void sheng_battmgr_init(ShengBattmgr *b)
+{
+    for (unsigned i = 0; i < sizeof *b; ++i) ((uint8_t *)b)[i] = 0;
+    b->cursor = NO_CYCLE;
+    b->last_timeout = -1;
+    b->sdp_limit_ua = 900000;  /* a configured USB 3 port's 900 mA; the firmware's current limiting backs off if the port sags */
+    b->limit_port = -1;
+    b->keyboard_wanted = b->keyboard_acked = b->keyboard_in_flight = -1;
+}
+
+void sheng_battmgr_keyboard(ShengBattmgr *b, int attached)
+{
+    attached = attached != 0;
+    if (b->keyboard_wanted == attached) return;
+    b->keyboard_wanted = (int8_t)attached;
+    b->keyboard_tries = 0;
+    sheng_battmgr_refresh(b, 0);
+}
+
+uint32_t sheng_battmgr_enable_request(uint8_t out[SHENG_BATTMGR_ENABLE_BYTES])
+{
+    header(out, SHENG_BATTMGR_OP_REQUEST_NOTIFICATION);
+    put32(out + 12, 0);    /* battery 0 */
+    put32(out + 16, 0);    /* power state */
+    put32(out + 20, 1);    /* low capacity notification threshold, percent */
+    put32(out + 24, 100);  /* high */
+    return SHENG_BATTMGR_ENABLE_BYTES;
+}
+
+static void skip_to_wanted(ShengBattmgr *b)
+{
+    while (b->cursor < BmFields && kFields[b->cursor].slow && !b->slow_due) b->cursor++;
+}
+
+static void advance(ShengBattmgr *b)
+{
+    b->in_flight = 0;
+    b->cursor++;
+    skip_to_wanted(b);
+}
+
+void sheng_battmgr_refresh(ShengBattmgr *b, int slow)
+{
+    if (b->cursor != NO_CYCLE) {b->refresh_wanted = 1 + (slow != 0); return;}
+    b->keyboard_tries = 0;  /* periodic cycles retry an unacknowledged state, at most three sends per cycle */
+    b->slow_due = slow || !(b->valid & (1u << BmFull));
+    b->cursor = 0;
+    b->in_flight = 0;
+    skip_to_wanted(b);
+}
+
+uint32_t sheng_battmgr_next(ShengBattmgr *b, uint8_t out[SHENG_BATTMGR_REQUEST_BYTES])
+{
+    if (b->in_flight || b->limit_in_flight || b->keyboard_in_flight >= 0) return 0;
+    if (b->keyboard_wanted >= 0 && b->keyboard_wanted != b->keyboard_acked && b->keyboard_tries < 3) {
+        header(out, SHENG_BATTMGR_OP_BOARD_SET);
+        put32(out + 12, 0);
+        put32(out + 16, SHENG_BATTMGR_KEYBOARD_PLUGIN);
+        put32(out + 20, (uint32_t)b->keyboard_wanted);
+        b->keyboard_in_flight = b->keyboard_wanted;
+        b->keyboard_acked = -1;  /* after a timeout the firmware may still have applied this write */
+        b->keyboard_tries++;
+        return SHENG_BATTMGR_REQUEST_BYTES;
+    }
+    if (b->limit_due) {
+        header(out, SHENG_BATTMGR_OP_USB_SET);
+        put32(out + 12, 0);
+        put32(out + 16, 5);  /* input current limit */
+        put32(out + 20, b->limit_due);
+        b->limit_in_flight = b->limit_due;
+        b->limit_due = 0;
+        b->limit_tries++;
+        return SHENG_BATTMGR_REQUEST_BYTES;
+    }
+    if (b->cursor == NO_CYCLE || b->cursor >= BmFields) return 0;
+    header(out, kFields[b->cursor].opcode);
+    put32(out + 12, 0);
+    put32(out + 16, kFields[b->cursor].property);
+    put32(out + 20, 0);
+    b->in_flight = 1;
+    return SHENG_BATTMGR_REQUEST_BYTES;
+}
+
+/* The input current limit a port type gets from the host side: a standard port (SDP 1) the configured value, a charging downstream port
+ * (CDP 3) its 1.5 A; others (dedicated chargers, Type-C current, PD contracts) are the firmware's own. */
+static uint32_t wanted_limit(const ShengBattmgr *b, int port)
+{
+    return port == 1 ? b->sdp_limit_ua : port == 3 ? 1500000u : 0u;
+}
+
+/* After a cycle: a set is due when the port wants a higher limit than the firmware reports, at most three tries per port type. */
+static void check_limit(ShengBattmgr *b)
+{
+    const int port = (b->valid >> BmUsbAdapter) & 1 ? b->value[BmUsbAdapter] : (b->valid >> BmUsbType) & 1 ? b->value[BmUsbType] : 0;
+    if (port != b->limit_port) {b->limit_port = port; b->limit_tries = 0;}
+    const uint32_t want = wanted_limit(b, port);
+    if (!want || b->limit_tries >= 3) return;
+    if ((b->valid >> BmUsbLimit) & 1 && b->value[BmUsbLimit] >= (int32_t)want - 100000) return;  /* 100 mA under it: input limiting */
+    b->limit_due = want;
+}
+
+/* Ends the cycle when the cursor ran past the last field; starts the remembered one. Returns 1 when a cycle ended. */
+static int finish(ShengBattmgr *b)
+{
+    if (b->cursor == NO_CYCLE || b->cursor < BmFields) return 0;
+    b->cursor = NO_CYCLE;
+    b->cycles_done++;
+    check_limit(b);
+    if (b->refresh_wanted) {
+        const int slow = b->refresh_wanted == 2;
+        b->refresh_wanted = 0;
+        sheng_battmgr_refresh(b, slow);
+    }
+    return 1;
+}
+
+void sheng_battmgr_timeout(ShengBattmgr *b)
+{
+    if (b->keyboard_in_flight >= 0) {b->keyboard_in_flight = -1; b->keyboard_result = -60; b->timeouts++; return;}
+    if (b->limit_in_flight) {b->limit_in_flight = 0; b->limit_result = -60; b->timeouts++; return;}
+    if (b->cursor == NO_CYCLE || !b->in_flight) return;
+    b->timeouts++;
+    b->last_timeout = b->cursor;
+    b->valid &= ~(1u << b->cursor);
+    advance(b);
+    finish(b);
+}
+
+int sheng_battmgr_receive(ShengBattmgr *b, const uint8_t *data, uint32_t length)
+{
+    if (length < 12 || le32(data) != SHENG_BATTMGR_OWNER) {b->ignored++; return BmIgnored;}
+    const uint32_t type = le32(data + 4), opcode = le32(data + 8);
+    if (opcode == SHENG_BATTMGR_OP_NOTIFICATION) {
+        b->notifications++;
+        sheng_battmgr_refresh(b, 0);
+        return BmNotified;
+    }
+    if (type != SHENG_BATTMGR_TYPE_REQUEST) {b->ignored++; return BmIgnored;}
+    if (opcode == SHENG_BATTMGR_OP_REQUEST_NOTIFICATION) {b->enabled = 1; return BmEnabled;}
+    if (opcode == SHENG_BATTMGR_OP_BOARD_SET) {
+        if (b->keyboard_in_flight < 0 || length < 24 || le32(data + 12) != SHENG_BATTMGR_KEYBOARD_PLUGIN) {
+            b->ignored++; return BmIgnored;
+        }
+        b->keyboard_result = (int32_t)le32(data + 20);
+        if (!b->keyboard_result) {
+            b->keyboard_acked = b->keyboard_in_flight;
+            b->keyboard_sets++;
+            sheng_battmgr_refresh(b, 0);
+        } else b->errors++;
+        b->keyboard_in_flight = -1;
+        return BmAnswer;
+    }
+    if (opcode == SHENG_BATTMGR_OP_USB_SET) {
+        if (!b->limit_in_flight || length < 24 || le32(data + 12) != 5) {b->ignored++; return BmIgnored;}
+        b->limit_result = (int32_t)le32(data + 20);
+        if (!b->limit_result) b->limit_sets++;
+        b->limit_in_flight = 0;
+        sheng_battmgr_refresh(b, 0);  /* read the limit back */
+        return BmAnswer;
+    }
+    if (b->cursor == NO_CYCLE || b->cursor >= BmFields || !b->in_flight || length < 24) {b->ignored++; return BmIgnored;}
+    const uint32_t property = le32(data + 12), value = le32(data + 16), result = le32(data + 20);
+    if (opcode != kFields[b->cursor].opcode || property != kFields[b->cursor].property) {b->ignored++; return BmIgnored;}
+    b->responses++;
+    if (result) {
+        b->errors++;
+        b->valid &= ~(1u << b->cursor);
+    } else {
+        b->value[b->cursor] = (int32_t)value;
+        b->valid |= 1u << b->cursor;
+        b->charge_known |= (1u << b->cursor) & ((1u << BmStatus) | (1u << BmUsbOnline));
+    }
+    advance(b);
+    return finish(b) ? BmCycleDone : BmAnswer;
+}
+
+/* POWER_SUPPLY_USB_TYPE (unknown 0, SDP 1, DCP 2, CDP 3, ACA 4, C 5, PD 6, PD_DRP 7, PD_PPS 8) to the kIOPSFamilyCode values (the
+ * USB family's error space, 0xe0004000 + n: host 0, dedicated charging port 4, downstream charging port 5, unknown 7, Type-C 9, PD 10). */
+static uint32_t family(int type)
+{
+    switch (type) {
+    case 1: return 0xe0004000u;
+    case 2: return 0xe0004004u;
+    case 3: return 0xe0004005u;
+    case 5: return 0xe0004009u;
+    case 6: case 7: case 8: return 0xe000400au;
+    default: return 0xe0004007u;
+    }
+}
+
+void sheng_battmgr_snapshot(const ShengBattmgr *b, ShengBatterySnapshot *s)
+{
+#define HAS(f) (((b->valid | b->charge_known) >> (f)) & 1u)
+#define V(f) (b->value[(f)])
+    const int status = HAS(BmStatus) ? V(BmStatus) : 0;  /* POWER_SUPPLY_STATUS: 1 charging, 2 discharging, 3 not charging, 4 full */
+    s->present = HAS(BmPresent) ? V(BmPresent) != 0 : HAS(BmCapacity);
+    s->external_known = HAS(BmUsbOnline);
+    s->status_known = HAS(BmStatus);
+    s->external = HAS(BmUsbOnline) && V(BmUsbOnline) != 0;
+    const int gauges = HAS(BmGauge1Remaining) && HAS(BmGauge1Full) && HAS(BmGauge2Remaining) && HAS(BmGauge2Full);
+    const int64_t remaining = gauges ? (int64_t)(uint32_t)V(BmGauge1Remaining) + (uint32_t)V(BmGauge2Remaining) : 0;
+    const int64_t full = gauges ? (int64_t)(uint32_t)V(BmGauge1Full) + (uint32_t)V(BmGauge2Full) : 0;
+    int percent = full > 0 ? (int)((remaining * 100 + full / 2) / full) : HAS(BmCapacity) ? (V(BmCapacity) + 50) / 100 : 0;
+    s->percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+    s->charge_known = full > 0 || HAS(BmCapacity);
+    s->charging = s->external && status == 1;
+    s->fully_charged = s->external && (status == 4 || s->percent == 100);
+    s->critical = s->present && s->external_known && !s->external && s->percent <= 2;
+    s->voltage_mv = HAS(BmVoltage) ? V(BmVoltage) / 1000 : 0;
+    s->current_ma = HAS(BmCurrent) ? -V(BmCurrent) / 1000 : 0;
+    /* -40 to 90 C; the firmware answers a fixed out-of-range value when it has no reading */
+    s->temperature_valid = HAS(BmTemperature) && V(BmTemperature) >= -4000 && V(BmTemperature) <= 9000;
+    s->temperature = s->temperature_valid ? V(BmTemperature) : 0;
+    s->raw_mah = HAS(BmCharge) ? V(BmCharge) / 1000 : 0;
+    s->full_mah = HAS(BmFull) ? V(BmFull) / 1000 : 0;
+    s->design_mah = HAS(BmDesign) ? V(BmDesign) / 1000 : 0;
+    s->cycles = HAS(BmCycles) ? V(BmCycles) : 0;
+    /* The gauge reports times in seconds, and a negative or huge value when it has none. */
+    s->time_to_empty_min = HAS(BmTimeToEmpty) && V(BmTimeToEmpty) > 0 && V(BmTimeToEmpty) < 100 * 3600 ? V(BmTimeToEmpty) / 60 : -1;
+    s->time_to_full_min = HAS(BmTimeToFull) && V(BmTimeToFull) > 0 && V(BmTimeToFull) < 100 * 3600 ? V(BmTimeToFull) / 60 : -1;
+    if (s->external) {
+        s->adapter_family = family(HAS(BmUsbType) ? V(BmUsbType) : 0);
+        s->adapter_mv = HAS(BmUsbVoltage) ? V(BmUsbVoltage) / 1000 : 0;
+        s->adapter_ma = HAS(BmUsbCurrent) ? V(BmUsbCurrent) / 1000 : 0;
+        if (s->adapter_mv < 0) s->adapter_mv = 0;
+        if (s->adapter_ma < 0) s->adapter_ma = -s->adapter_ma;
+        s->adapter_watts = (int)(((int64_t)s->adapter_mv * s->adapter_ma + 500000) / 1000000);
+    } else {
+        s->adapter_family = 0;
+        s->adapter_mv = s->adapter_ma = s->adapter_watts = 0;
+    }
+#undef HAS
+#undef V
+}
diff --git a/xnu/fuxi-adsp/ShengBattmgr.h b/xnu/fuxi-adsp/ShengBattmgr.h
new file mode 100644
index 0000000..fa9d370
--- /dev/null
+++ b/xnu/fuxi-adsp/ShengBattmgr.h
@@ -0,0 +1,101 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The battery manager the audio DSP runs (PMIC GLINK, channel "PMIC_RTR_ADSP_APPS"): messages start with a 12-byte header (owner, type,
+ * opcode); a property read is a request {battery 0, property, 0} answered by {property, value, result}; the DSP also sends notifications
+ * when something changed. This is the message codec, the refresh cycle (one request in flight, the next one only when it is answered
+ * or the owner's timer gives up on it) and the mapping to what iOS reads from a power source. No I/O, no waits: the owner sends the
+ * bytes and feeds back what arrives. Charging itself stays with the DSP firmware; settings written here are keyboard attachment and the USB input current
+ * limit on a computer's port, which the firmware keeps low until the host side asks for more (as a USB device stack does once the
+ * port configured it). */
+#ifndef SHENG_BATTMGR_H
+#define SHENG_BATTMGR_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SHENG_BATTMGR_OWNER 32778u  /* the battery manager; 32779 is the USB-C port manager on the same channel */
+#define SHENG_BATTMGR_TYPE_REQUEST 1u
+#define SHENG_BATTMGR_TYPE_NOTIFY 2u
+#define SHENG_BATTMGR_OP_REQUEST_NOTIFICATION 0x04u
+#define SHENG_BATTMGR_OP_NOTIFICATION 0x07u
+#define SHENG_BATTMGR_OP_BATTERY_GET 0x30u
+#define SHENG_BATTMGR_OP_USB_GET 0x32u
+#define SHENG_BATTMGR_OP_USB_SET 0x33u
+#define SHENG_BATTMGR_OP_BOARD_GET 0x50u  /* the board's own properties, same request and answer shape: fuel gauges, charger state */
+#define SHENG_BATTMGR_OP_BOARD_SET 0x51u
+#define SHENG_BATTMGR_KEYBOARD_PLUGIN 0xe4u
+#define SHENG_BATTMGR_REQUEST_BYTES 24u
+#define SHENG_BATTMGR_ENABLE_BYTES 28u
+
+/* The fields one refresh reads, in order (at most 32: valid has a bit per field). */
+enum {
+    BmStatus, BmPresent, BmCapacity, BmVoltage, BmCurrent, BmTemperature, BmCharge, BmUsbOnline, BmUsbType, BmUsbVoltage,
+    BmUsbCurrent, BmTimeToEmpty, BmTimeToFull, BmGauge1Remaining, BmGauge1Full, BmGauge2Remaining, BmGauge2Full, BmFull, BmDesign,
+    BmCycles,
+    /* the charger's state: port type as charger detection saw it, input current limit and the most the port offers (uA), charge type,
+     * thermal level, the charge current the charger runs, the board's view of the adapter (type, watts, PD authenticated), battery
+     * authentication of both cells, input suspended */
+    BmUsbAdapter, BmUsbLimit, BmUsbMax, BmChargeType, BmThermalLevel, BmChargeCurrent, BmRealType, BmPowerMax, BmPdVerified,
+    BmAuthentic, BmSlaveAuthentic, BmInputSuspend, BmFields
+};
+
+typedef struct {
+    int32_t value[BmFields];
+    uint32_t valid;               /* bit per field in the latest refresh */
+    uint32_t charge_known;        /* last successful status/USB-online readings survive transient errors */
+    uint8_t cursor, in_flight, enabled, slow_due;
+    uint32_t cycles_done, responses, notifications, errors, timeouts, ignored;
+    uint32_t refresh_wanted;      /* a notification asked for a new cycle while one ran */
+    int last_timeout;             /* the field the last timeout skipped, -1 none */
+    /* the input current limit on a computer's port: what a standard port (SDP) gets, 0 to leave the firmware's; the port type the
+     * tries count for; the value due to be sent, the one in flight, tries for this port type, sets the firmware took, the last result
+     * (the firmware's, or -60 timed out) */
+    uint32_t sdp_limit_ua;
+    int32_t limit_port;
+    uint32_t limit_due, limit_in_flight, limit_tries, limit_sets;
+    int32_t limit_result;
+    int8_t keyboard_wanted, keyboard_acked, keyboard_in_flight; /* -1 unknown/none, 0 detached, 1 attached */
+    uint8_t keyboard_tries;
+    uint32_t keyboard_sets;
+    int32_t keyboard_result;
+} ShengBattmgr;
+
+/* What a power source shows. Temperatures are hundredths of a degree Celsius, as the firmware reports them. The charge comes from the
+ * board's two fuel gauges (remaining over full, both summed) when they answer, else from the battery's capacity property; the board
+ * reports the current with discharge positive, the power source with charge positive. */
+typedef struct {
+    int present, external, charging, fully_charged, critical;
+    int percent;                  /* 0..100 */
+    int charge_known;             /* percent comes from a reading, not a default */
+    int external_known, status_known; /* unknown charger state must not publish a disconnect */
+    int voltage_mv, current_ma;   /* current: positive while the battery takes charge */
+    int temperature, temperature_valid;  /* valid: a reading in the range a battery can have */
+    int raw_mah, full_mah, design_mah, cycles;
+    int time_to_empty_min, time_to_full_min;  /* -1 unknown */
+    uint32_t adapter_family;      /* kIOPSFamilyCode value, 0 when no adapter */
+    int adapter_mv, adapter_ma, adapter_watts;
+} ShengBatterySnapshot;
+
+enum {BmIgnored = 0, BmAnswer = 1, BmCycleDone = 2, BmNotified = 3, BmEnabled = 4};
+
+void sheng_battmgr_init(ShengBattmgr *b);
+/* Queue the latest cover state. Calls are serialized by the battery work loop. */
+void sheng_battmgr_keyboard(ShengBattmgr *b, int attached);
+/* The notification enable request (sent once the channel is up). */
+uint32_t sheng_battmgr_enable_request(uint8_t out[SHENG_BATTMGR_ENABLE_BYTES]);
+/* Starts a refresh cycle (no effect while one runs: it is remembered and runs after). slow: also the fields that hardly change. */
+void sheng_battmgr_refresh(ShengBattmgr *b, int slow);
+/* The next request: the latest keyboard state, a due input current limit, or the running cycle's next field; 0 when nothing is to be
+ * sent now (one in flight, or nothing due). */
+uint32_t sheng_battmgr_next(ShengBattmgr *b, uint8_t out[SHENG_BATTMGR_REQUEST_BYTES]);
+/* The owner's request timer ran out: the field is skipped (a limit set counts as tried). */
+void sheng_battmgr_timeout(ShengBattmgr *b);
+/* A message from the channel; returns one of the Bm* results. */
+int sheng_battmgr_receive(ShengBattmgr *b, const uint8_t *data, uint32_t length);
+/* The power source values from the fields read so far. */
+void sheng_battmgr_snapshot(const ShengBattmgr *b, ShengBatterySnapshot *s);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/xnu/fuxi-adsp/ShengQrtr.c b/xnu/fuxi-adsp/ShengQrtr.c
new file mode 100644
index 0000000..5633228
--- /dev/null
+++ b/xnu/fuxi-adsp/ShengQrtr.c
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* The IPC router link to the audio DSP (GLINK channel "IPCRTR", which the DSP opens) and the service locator on it. The DSP's protection
+ * domains (audio, charger, sensors) ask the application processor's locator which domains provide a service before they start; the
+ * battery manager runs in the charger domain. Started with adsp=2. Everything runs in the DSP thread's callbacks: each packet is
+ * handled at once and any answer is queued with sheng_adsp_send, so nothing here waits. */
+#include <stddef.h>
+#include <stdint.h>
+#include "QcomQrtr.h"
+#include "ShengAdsp.h"
+
+/* [0] stage (1 channel registered, 2 link up, 3 the DSP's hello, negative: registration failed), [1] packets in, [2] data packets in,
+ * [3] bad packets, [4] packets out, [5] sends refused, [6] locator requests, [7] locator answers, [8] the DSP's node, [9] services the
+ * DSP announced, [10] link ups, [11] link downs, [12] data for ports we do not have, [13] the last locator request's service name
+ * length | its first byte << 8 */
+volatile int32_t native_qrtr_stats[16];
+/* the services the DSP announced, as service:instance in hex */
+char native_qrtr_text[96];
+
+enum {kLocalNode = 1, kLocatorPort = 1};
+
+static const char *const kAudio[] = {"avs/audio", NULL};
+static const char *const kGps[] = {"gps/gps_service", NULL};
+static const QcomPdDomain kDomains[] = {
+    {"msm/adsp/audio_pd", 74, kAudio},   {"msm/adsp/root_pd", 74, NULL}, {"msm/adsp/charger_pd", 74, NULL},
+    {"msm/adsp/sensor_pd", 74, NULL},    {"msm/cdsp/root_pd", 76, NULL}, {"msm/modem/root_pd", 180, kGps},
+};
+
+static QcomQrtr gQrtr;
+static ShengAdspChannel *gChannel;
+
+static int send(void *context, const uint8_t *packet, uint32_t length)
+{
+    (void)context;
+    return sheng_adsp_send(gChannel, packet, length) ? -1 : 0;
+}
+
+static void hex(char *out, unsigned *at, unsigned cap, uint32_t value)
+{
+    char digits[8];
+    unsigned n = 0;
+    do {digits[n++] = "0123456789abcdef"[value & 15]; value >>= 4;} while (value && n < 8);
+    while (n && *at + 1 < cap) out[(*at)++] = digits[--n];
+}
+
+static void counters(void)
+{
+    native_qrtr_stats[1] = (int32_t)gQrtr.rx_packets;
+    native_qrtr_stats[2] = (int32_t)gQrtr.rx_data;
+    native_qrtr_stats[3] = (int32_t)gQrtr.rx_bad;
+    native_qrtr_stats[4] = (int32_t)gQrtr.tx_packets;
+    native_qrtr_stats[5] = (int32_t)gQrtr.tx_refused;
+    native_qrtr_stats[8] = gQrtr.hello_received ? (int32_t)gQrtr.remote_node : -1;
+    native_qrtr_stats[9] = (int32_t)gQrtr.remote_count;
+    native_qrtr_stats[12] = (int32_t)gQrtr.rx_unrouted;
+    if (gQrtr.hello_received && native_qrtr_stats[0] == 2) native_qrtr_stats[0] = 3;
+    unsigned at = 0;
+    const unsigned cap = sizeof native_qrtr_text;
+    for (uint32_t i = 0; i < gQrtr.remote_count && at + 4 < cap; ++i) {
+        if (at) native_qrtr_text[at++] = ' ';
+        hex(native_qrtr_text, &at, cap, gQrtr.remote[i].service);
+        if (at + 1 < cap) native_qrtr_text[at++] = ':';
+        hex(native_qrtr_text, &at, cap, gQrtr.remote[i].instance);
+    }
+    native_qrtr_text[at] = 0;
+}
+
+static void locator(void *context, QcomQrtr *q, uint32_t port, uint32_t node, uint32_t from, const uint8_t *data, uint32_t length)
+{
+    (void)context;
+    uint8_t answer[480];
+    QcomQmiMessage m;
+    uint32_t size = 0;
+    native_qrtr_stats[6]++;
+    if (!qcom_qmi_parse(data, length, &m)) {
+        const uint8_t *name = qcom_qmi_tlv(&m, 0x01, &size);
+        if (name) native_qrtr_stats[13] = (int32_t)(size | (size ? (uint32_t)name[0] << 8 : 0));
+    }
+    const uint32_t n = qcom_servloc_answer(kDomains, sizeof kDomains / sizeof kDomains[0], data, length, answer, sizeof answer);
+    if (n && !qcom_qrtr_send_data(q, port, node, from, answer, n)) native_qrtr_stats[7]++;
+}
+
+static void linkState(void *context, int up)
+{
+    (void)context;
+    if (up) {
+        native_qrtr_stats[10]++;
+        /* a fresh link: forget the old one's hello and services, keep ours */
+        gQrtr.hello_sent = gQrtr.hello_received = 0;
+        gQrtr.remote_count = 0;
+        gQrtr.remote_node = QCOM_QRTR_NODE_BROADCAST;
+        native_qrtr_stats[0] = 2;
+        qcom_qrtr_start(&gQrtr);
+    } else {
+        native_qrtr_stats[11]++;
+        native_qrtr_stats[0] = 1;
+    }
+    counters();
+}
+
+static void linkReceive(void *context, const uint8_t *data, uint32_t length)
+{
+    (void)context;
+    qcom_qrtr_receive(&gQrtr, data, length);
+    counters();
+}
+
+void sheng_qrtr_start(void)
+{
+    static const ShengAdspClient client = {linkState, linkReceive};
+    qcom_qrtr_init(&gQrtr, kLocalNode, send, NULL);
+    qcom_qrtr_add_service(&gQrtr, QCOM_SERVLOC_SERVICE, QCOM_SERVLOC_INSTANCE, kLocatorPort, locator, NULL);
+    gChannel = sheng_adsp_channel("IPCRTR", 1024, 8, 0, &client, NULL);
+    native_qrtr_stats[0] = gChannel ? 1 : -1;
+}
diff --git a/xnu/fuxi-adsp/SweetBattery.cpp b/xnu/fuxi-adsp/SweetBattery.cpp
new file mode 100644
index 0000000..4be20a9
--- /dev/null
+++ b/xnu/fuxi-adsp/SweetBattery.cpp
@@ -0,0 +1,478 @@
+/*
+ * Built-in iOS battery bring-up service. Default: 100%, AC, not charging.
+ * sweetbattery=1: read-only PM6150 polling every 30 seconds; voltage-derived
+ * SOC is an UNCALIBRATED estimate, not a replacement for the Linux QG algo.
+ * See report.md for binary evidence, register provenance and integration.
+ * FUXI fuxiadsp=3 (ADT /chosen fuxi,adsp=3): the battery manager on the audio DSP
+ * (bsd/dev/fuxi_adsp_battery.c) feeds this source once it has a plausible
+ * reading; until then, and if the DSP never answers, the fallback stays.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <device/device_types.h> /* io_buf_ptr_t for private OSKext headers */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <IOKit/pwr_mgt/IOPM.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <pexpert/pexpert.h>
+/* bsd/dev/sweet_spmi.c */
+extern "C" int sweet_spmi_init(void);
+extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* bsd/kern/proc.c */
+extern "C" void proc_selfname(char *buf, int size);
+#if defined(FUXI)
+#include "../../../bsd/dev/fuxi_adsp_battery.h"
+#endif
+
+class SweetBattery : public IOPMPowerSource {
+	OSDeclareDefaultStructors(SweetBattery);
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	bool serializeProperties(OSSerialize *s) const APPLE_KEXT_OVERRIDE;
+private:
+	IOWorkLoop *fLoop;
+	IOTimerEventSource *fTimer;
+	bool fTimerAdded, fRunning, fReal, fAdsp, fAdspShown;
+	int fLastMode;
+	unsigned fShown, fShownLogs;
+	void putNumber(const char *key, UInt32 value);
+	void putBool(const char *key, bool value);
+	void publish(unsigned percent, unsigned mv, int ma, bool external,
+	    bool capable, bool charging, bool full, bool measured, bool currentValid);
+	void poll(void);
+#if defined(FUXI)
+	void publishAdsp(const FuxiAdspBattery &b);
+#endif
+	static void timerFired(OSObject *owner, IOTimerEventSource *sender);
+	static IOReturn stopPolling(OSObject *owner, void *, void *, void *, void *);
+	static bool readWord(unsigned address, uint16_t *value);
+	static unsigned estimatePercent(unsigned mv);
+};
+OSDefineMetaClassAndStructors(SweetBattery, IOPMPowerSource);
+
+/* Who reads the battery from user space (IORegistryEntryCreateCFProperties) and what it then
+ * sees, bounded: the first 16 reads, then the first 4 after each change of what is published. */
+static uint32_t gSbReads, gSbReadLogs, gSbReadKey = ~0u, gSbReadsSinceChange;
+
+bool
+SweetBattery::serializeProperties(OSSerialize *s) const
+{
+	const uint32_t n = __atomic_add_fetch(&gSbReads, 1u, __ATOMIC_RELAXED);
+	const unsigned key = fShown;
+	if (key != gSbReadKey) {
+		gSbReadKey = key;
+		gSbReadsSinceChange = 0;
+	}
+	if ((n <= 16 || gSbReadsSinceChange++ < 4) && gSbReadLogs < 96) {
+		char name[32];
+		gSbReadLogs++;
+		proc_selfname(name, (int)sizeof(name));
+		if (key == ~0u)
+			IOLog("SWEET BATTERY: read #%u by %s (still the fallback)\n", n, name);
+		else
+			IOLog("SWEET BATTERY: read #%u by %s (published #%u: %u%% external=%u charging=%u)\n", n, name,
+			    fShownLogs, key & 0xffu, (key >> 8) & 0xfu ? ((key >> 8) & 0xfu) - 1u : 9u,
+			    (key >> 12) & 0xfu ? ((key >> 12) & 0xfu) - 1u : 9u);
+	}
+	return IOPMPowerSource::serializeProperties(s);
+}
+
+bool
+SweetBattery::init(OSDictionary *dictionary)
+{
+	/* IOCatalogue calls init(dictionary). This XNU's IOPMPowerSource only
+	 * overrides init(void): explicitly run it to allocate its PS dictionary
+	 * and symbols, then copy the matching personality into the registry. */
+	if (!IOPMPowerSource::init()) {
+		return false;
+	}
+	fLoop = NULL;
+	fTimer = NULL;
+	fTimerAdded = fRunning = fReal = fAdsp = fAdspShown = false;
+	if (dictionary) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
+		if (!it) {
+			return false;
+		}
+		OSObject *object;
+		bool ok = true;
+		while ((object = it->getNextObject())) {
+			const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+			if (!key || !setProperty(key, dictionary->getObject(key))) {
+				ok = false;
+				break;
+			}
+		}
+		it->release();
+		if (!ok) {
+			return false;
+		}
+	}
+	fLastMode = -1;
+	fShown = ~0u;
+	fShownLogs = 0;
+	return true;
+}
+
+void
+SweetBattery::putNumber(const char *key, UInt32 value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSNumber *number = OSNumber::withNumber(value, 32);
+	if (symbol && number) {
+		setPSProperty(symbol, number);
+	}
+	OSSafeReleaseNULL(number);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+SweetBattery::putBool(const char *key, bool value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	if (symbol) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+		symbol->release();
+	}
+}
+
+void
+SweetBattery::publish(unsigned percent, unsigned mv, int ma, bool external,
+    bool capable, bool charging, bool full, bool measured, bool currentValid)
+{
+	/* Use consistent mAh units (DT nominal=5020). powerd computes C*100/M. */
+	const unsigned capacity = (5020u * percent + 50u) / 100u;
+	setBatteryInstalled(true);
+	setCurrentCapacity(capacity);
+	setMaxCapacity(5020);
+	setExternalConnected(external);
+	setExternalChargeCapable(capable);
+	setIsCharging(charging);
+	setAtWarnLevel(false);
+	/* An uncalibrated voltage curve must not assert a critical shutdown. */
+	setAtCriticalLevel(false);
+	setVoltage(mv);
+	setAmperage(ma);
+	setTimeRemaining(-1); /* Unknown; never publish zero minutes on error. */
+	setCycleCount(0);     /* Placeholder: cycle learning is not implemented. */
+	putBool("FullyCharged", full);
+	putBool("AppleRawExternalConnected", external);
+	putNumber("AppleRawCurrentCapacity", capacity);
+	putNumber("AppleRawMaxCapacity", 5020);
+	putNumber("DesignCapacity", 5020);
+	putNumber("InstantAmperage", (UInt32)ma);
+	/* iOS battery convention: centidegrees C; fixed 25 C, NOT measured. */
+	putNumber("Temperature", 2500);
+	putBool("SweetBatteryHardwareSampleValid", measured);
+	putBool("SweetBatteryCurrentValid", currentValid);
+	putBool("SweetBatterySOCEstimated", measured);
+	putBool("SweetBatteryTemperatureEstimated", true);
+	putBool("SweetBatteryFallback", !measured);
+	putNumber("SweetBatteryPercent", percent);
+
+	/* IOPMCopyBatteryInfo's per-source compatibility dictionary. */
+	OSDictionary *legacy = OSDictionary::withCapacity(7);
+	if (legacy) {
+		const char *keys[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+		    kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		    kIOBatteryFlagsKey};
+		UInt32 values[] = {capacity, 5020, mv, (UInt32)ma, 0,
+		    (UInt32)(kIOBatteryInstalled | (external ? kIOBatteryChargerConnect : 0) |
+		    (charging ? kIOBatteryCharge : 0))};
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus(); /* Flush PS properties and send 0xe0024100 on change. */
+	int mode = measured ? 1 : 0;
+	if (mode != fLastMode) {
+		IOLog("SWEET BATTERY: %s, %u%% %umV external=%d charging=%d\n",
+		    measured ? "PM6150 / estimated SOC" : "static fallback",
+		    percent, mv, external, charging);
+		fLastMode = mode;
+	}
+}
+
+/* Keep the proven single-byte observer command. Read two matching whole
+ * words to reject most torn ADC samples without writing the QG HOLD bit.
+ * This is a bounded consistency check, not a hardware snapshot guarantee. */
+bool
+SweetBattery::readWord(unsigned address, uint16_t *value)
+{
+	uint16_t previous = 0;
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t lo, hi;
+		if (sweet_spmi_read(0, address, &lo) ||
+		    sweet_spmi_read(0, address + 1, &hi)) {
+			return false;
+		}
+		uint16_t next = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+		if (attempt && next == previous) {
+			*value = next;
+			return true;
+		}
+		previous = next;
+	}
+	return false;
+}
+
+unsigned
+SweetBattery::estimatePercent(unsigned mv)
+{
+	/* Generic single-cell curve, intentionally NOT advertised as QG SOC.
+	 * Load sag, temperature, aging and charging introduce large errors. */
+	static const unsigned volts[] = {3400, 3500, 3600, 3700, 3800, 3900,
+	    4000, 4100, 4200, 4350};
+	static const unsigned soc[] = {1, 5, 10, 20, 40, 60, 75, 85, 93, 100};
+	if (mv <= volts[0]) {
+		return soc[0];
+	}
+	for (unsigned i = 1; i < sizeof(volts) / sizeof(volts[0]); ++i) {
+		if (mv < volts[i]) {
+			return soc[i - 1] + (mv - volts[i - 1]) * (soc[i] - soc[i - 1]) /
+			       (volts[i] - volts[i - 1]);
+		}
+	}
+	return 100;
+}
+
+#if defined(FUXI)
+void
+SweetBattery::publishAdsp(const FuxiAdspBattery &b)
+{
+	/* mAh as publish() uses them (powerd computes C*100/M); Xiaomi 13: 4500 mAh. */
+	const unsigned design = b.design_mah > 0 ? (unsigned)b.design_mah : 4500u;
+	const unsigned full = b.full_mah > 0 ? (unsigned)b.full_mah : design;
+	const unsigned capacity = (full * (unsigned)b.percent + 50u) / 100u;
+	setBatteryInstalled(b.present != 0);
+	setCurrentCapacity(capacity);
+	setMaxCapacity(full);
+	/* An unknown charger state must not publish a disconnect. */
+	if (b.external_known) {
+		setExternalConnected(b.external != 0);
+		setExternalChargeCapable(b.external != 0);
+		putBool("AppleRawExternalConnected", b.external != 0);
+	}
+	if (b.external_known && b.status_known) {
+		setIsCharging(b.charging != 0);
+		putBool("FullyCharged", b.fully_charged != 0);
+	}
+	if (b.external_known) {
+		OSDictionary *adapter = OSDictionary::withCapacity(4);
+		if (adapter) {
+			const char *keys[] = {kIOPMPSAdapterDetailsFamilyKey, kIOPMPSAdapterDetailsVoltage,
+			    kIOPMPSAdapterDetailsAmperageKey, kIOPMPSAdapterDetailsWattsKey};
+			const UInt32 values[] = {b.external ? b.adapter_family : 0,
+			    b.external && b.adapter_mv > 0 ? (UInt32)b.adapter_mv : 0,
+			    b.external && b.adapter_ma > 0 ? (UInt32)b.adapter_ma : 0,
+			    b.external && b.adapter_watts > 0 ? (UInt32)b.adapter_watts : 0};
+			for (unsigned index = 0; index < sizeof(values) / sizeof(values[0]); index++) {
+				OSNumber *number = OSNumber::withNumber(values[index], 32);
+				if (number) {
+					adapter->setObject(keys[index], number);
+					number->release();
+				}
+			}
+			const OSSymbol *key = OSSymbol::withCString(kIOPMPSAdapterDetailsKey);
+			if (key) setPSProperty(key, adapter);
+			OSSafeReleaseNULL(key);
+			adapter->release();
+		}
+	}
+	setAtWarnLevel(false);
+	/* Never a critical shutdown from this path: the PMIC cuts off an empty cell. */
+	setAtCriticalLevel(false);
+	setVoltage(b.voltage_mv > 0 ? (unsigned)b.voltage_mv : 0);
+	setAmperage(b.current_ma);
+	const int minutes = b.charging ? b.minutes_to_full : b.minutes_to_empty;
+	setTimeRemaining(minutes >= 0 ? minutes : -1);
+	if (b.cycles > 0) {
+		setCycleCount((unsigned)b.cycles);
+	}
+	putNumber("AppleRawCurrentCapacity", b.raw_mah > 0 ? (UInt32)b.raw_mah : capacity);
+	putNumber("AppleRawMaxCapacity", full);
+	putNumber("NominalChargeCapacity", full);
+	putNumber("DesignCapacity", design);
+	putNumber("InstantAmperage", (UInt32)b.current_ma);
+	putNumber("Temperature", b.temperature_valid ? (UInt32)b.temperature : 2500u);
+	putBool("SweetBatteryHardwareSampleValid", true);
+	putBool("SweetBatteryCurrentValid", true);
+	putBool("SweetBatterySOCEstimated", false);
+	putBool("SweetBatteryTemperatureEstimated", !b.temperature_valid);
+	putBool("SweetBatteryFallback", false);
+	putBool("FuxiAdspBattery", true);
+	putNumber("SweetBatteryPercent", (UInt32)b.percent);
+	OSDictionary *legacy = OSDictionary::withCapacity(7);
+	if (legacy) {
+		const char *keys[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+		    kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		    kIOBatteryFlagsKey};
+		UInt32 values[] = {capacity, full, (UInt32)(b.voltage_mv > 0 ? b.voltage_mv : 0), (UInt32)b.current_ma,
+		    (UInt32)(b.cycles > 0 ? b.cycles : 0),
+		    (UInt32)((b.present ? kIOBatteryInstalled : 0) | (b.external ? kIOBatteryChargerConnect : 0) |
+		    (b.charging ? kIOBatteryCharge : 0))};
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus();
+	fAdspShown = true;
+	if (fLastMode != 2) {
+		IOLog("SWEET BATTERY: ADSP battery manager, %d%% %dmV %dmA external=%d charging=%d\n",
+		    b.percent, b.voltage_mv, b.current_ma, b.external, b.charging);
+		fLastMode = 2;
+	}
+	/* What iOS is shown, each time it changes (bounded): percent, charger, charging, full. */
+	const unsigned shown = ((unsigned)b.percent & 0xffu) | ((b.external_known ? 1u + b.external : 0u) << 8) |
+	    ((b.status_known ? 1u + b.charging : 0u) << 12) | ((unsigned)b.fully_charged << 16);
+	if (shown != fShown) {
+		fShown = shown;
+		if (fShownLogs++ < 48)
+			IOLog("SWEET BATTERY: published #%u %d%% external=%d%s charging=%d%s full=%d %dmA\n", fShownLogs, b.percent,
+			    b.external, b.external_known ? "" : "(unknown)", b.charging, b.status_known ? "" : "(unknown)",
+			    b.fully_charged, b.current_ma);
+	}
+}
+#endif
+
+void
+SweetBattery::poll(void)
+{
+#if defined(FUXI)
+	FuxiAdspBattery adsp;
+	if (fAdsp && fuxi_adsp_battery_reading(&adsp)) {
+		publishAdsp(adsp);
+		return;
+	}
+#endif
+	uint8_t type, present, usb, path, charger, error, temperature;
+	uint16_t rawVoltage;
+	bool valid = fReal &&
+	    !sweet_spmi_read(0, 0x4804, &type) && type == 0x0d &&
+	    !sweet_spmi_read(0, 0x4808, &present) && (present & 1u) &&
+	    readWord(0x48c0, &rawVoltage) && rawVoltage != 0x8000 &&
+	    !sweet_spmi_read(0, 0x1310, &usb) &&
+	    !sweet_spmi_read(0, 0x110b, &path) &&
+	    !sweet_spmi_read(0, 0x1006, &charger) &&
+	    !sweet_spmi_read(0, 0x1007, &error) &&
+	    !sweet_spmi_read(0, 0x100d, &temperature);
+	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 194637u) / 1000000u) : 0;
+	/* Zero, reset, floating, or implausible data cannot become 0% battery. */
+	valid = valid && mv >= 2800 && mv <= 4600;
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(error & 2u) && !(temperature & 0x0cu);
+	/* Inhibit (0) does not by itself establish full capacity. */
+	bool full = external && state == 5 && !(error & 2u);
+	int ma = 0;
+	uint8_t subtype;
+	uint16_t rawCurrent;
+	bool currentValid = !sweet_spmi_read(0, 0x4805, &subtype) &&
+	    (subtype == 3 || subtype == 4) && readWord(0x48c2, &rawCurrent) &&
+	    rawCurrent != 0x8000;
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* Linux: negative=charging; IOPMPowerSource: positive=charging, mA. */
+		ma = (int)(-((int64_t)signedRaw * (subtype == 3 ? 152588 : 305176)) / 1000000);
+	}
+	publish(full ? 100 : estimatePercent(mv), mv, ma, external, capable,
+	    charging, full, true, currentValid);
+}
+
+void
+SweetBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
+	if (self && self->fRunning) {
+		self->poll();
+		/* Every 10 s until the DSP's first reading arrives, then every 30 s. */
+		sender->setTimeoutMS(self->fAdsp && !self->fAdspShown ? 10000 : 30000);
+	}
+}
+
+bool
+SweetBattery::start(IOService *provider)
+{
+	if (!IOPMPowerSource::start(provider)) {
+		return false;
+	}
+	int real = 0;
+	(void)PE_parse_boot_argn("sweetbattery", &real, sizeof(real));
+	fReal = real == 1 && sweet_spmi_init() == 0;
+#if defined(FUXI)
+	fAdsp = fuxi_adsp_battery_wanted() != 0;
+#endif
+	/* Publish a complete source BEFORE registerService wakes powerd. */
+	poll();
+	if (fReal || fAdsp) {
+		fLoop = IOWorkLoop::workLoop();
+		fTimer = IOTimerEventSource::timerEventSource(this, &SweetBattery::timerFired);
+		if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
+			fTimerAdded = true;
+			fRunning = true;
+			fTimer->setTimeoutMS(fAdsp ? 10000 : 30000);
+		} else {
+			fReal = fAdsp = false;
+			poll();
+			IOLog("SWEET BATTERY: timer unavailable; static fallback\n");
+		}
+	}
+	registerService();
+	return true;
+}
+
+void
+SweetBattery::stop(IOService *provider)
+{
+	if (fLoop && fTimerAdded) {
+		/* Serialize against a running timer callback, including rearming. */
+		(void)fLoop->runAction(&SweetBattery::stopPolling, this);
+		fLoop->removeEventSource(fTimer);
+		fTimerAdded = false;
+	}
+	IOPMPowerSource::stop(provider);
+}
+
+IOReturn
+SweetBattery::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+	SweetBattery *self = OSDynamicCast(SweetBattery, owner);
+	if (!self) {
+		return kIOReturnBadArgument;
+	}
+	self->fRunning = false;
+	self->fTimer->cancelTimeout();
+	self->fTimer->disable();
+	return kIOReturnSuccess;
+}
+
+void
+SweetBattery::free(void)
+{
+	OSSafeReleaseNULL(fTimer);
+	OSSafeReleaseNULL(fLoop);
+	IOPMPowerSource::free();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
