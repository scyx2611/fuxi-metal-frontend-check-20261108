++        /* 之後只輪詢：最近有動靜時 2 ms，否則 50 ms（GLINK 開著）或 200 ms */
++        uint64_t next_report;
++        clock_interval_to_deadline(30000, NSEC_PER_MSEC, &next_report);
++        unsigned reports = 0;
++        for (;;) {
++            serviceSmp2p();
++            serviceGlink();
++            serviceIpa();
++            if (gBbMode) coachz_baseband_poll();
