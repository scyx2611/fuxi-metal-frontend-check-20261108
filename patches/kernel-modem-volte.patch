+    printf("FUXI MODEM: cmd-db bcm IP0=%#x SN8=%#x SH0=%#x MC0=%#x ACV=%#x\n",
+        gBcmIp0, gBcmSn8, gBcmSh0, gBcmMc0, gBcmAcv);
