++static inline void fm_put_be16(uint8_t *ptr, uint32_t val)
++{
++    ptr[0] = (uint8_t)(val >> 8);
++    ptr[1] = (uint8_t)val;
++}
++static inline void fm_put_be32(uint8_t *ptr, uint32_t val)
++{
++    ptr[0] = (uint8_t)(val >> 24);
++    ptr[1] = (uint8_t)(val >> 16);
++    ptr[2] = (uint8_t)(val >> 8);
