++    if (size < 12 || size > length - FM_QRTR_HEADER) return -1;
++    *node = fm_le32(packet + 8);
++    *port = fm_le32(packet + 12);
++    *service = fm_le32(packet + FM_QRTR_HEADER + 4);
++    *instance = fm_le32(packet + FM_QRTR_HEADER + 8);
