++    for (unsigned idx = 0; idx < slots; ++idx) {
++        if (fm_smmu_overlap(smrs[idx], sid, mask)) return -2;
++    }
++    for (unsigned rev = slots; rev > 0u; --rev) {
++        const unsigned slot = rev - 1u;
