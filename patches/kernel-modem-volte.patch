+static int pasSupported(uint32_t pas)
+{
+    const struct scm_result r = pil(QCOM_SCM_PAS_IS_SUPPORTED, qcom_scm_args(1, 0, 0, 0), pas, 0, 0);
+    return r.x0 == 0 ? (int)(r.x1 != 0) : -1;
