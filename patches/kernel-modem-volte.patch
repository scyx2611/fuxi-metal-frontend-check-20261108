++    bb_diag_lines++;
++    printf("COACHZ voice: %s tlv [%s] calls=%u t=%u\n", ind ? "status" : "info", ids, count, bb_now_ms());
++    for (uint32_t i = 0; i < count && i < 4u && bb_diag_lines < BB_DIAG_LINES; i++) {
++      const uint8_t *c = v + 1u + 7u * i;
