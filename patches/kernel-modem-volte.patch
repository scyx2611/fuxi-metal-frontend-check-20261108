++    fm_put32(packet + 4, FM_QRTR_DATA);
++    fm_put32(packet + 8, local_node);
++    fm_put32(packet + 12, from_port);
++    fm_put32(packet + 16, 0u);
++    fm_put32(packet + 20, length);
++    fm_put32(packet + 24, dst_node);
++    fm_put32(packet + 28, dst_port);
