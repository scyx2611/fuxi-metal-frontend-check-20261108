++#define FM_WDS_BIND_MUX_DATA_PORT 0x00a2u
++#define FM_WMS_SET_EVENT_REPORT 0x0001u
++#define FM_WMS_EVENT_REPORT_IND 0x0001u
++#define FM_WMS_RAW_SEND 0x0020u
